# The base dotenv: env-NEUTRAL non-secret app config only — values identical in
# dev and every cloud env. bin/common sources this file first, then layers a
# delta (.env.dev by default for local scripts; .env.<env> on the deploy/infra
# path; .env.test/.env.fuzz for the test harnesses). See CONFIGURATION.md and
# .env.template for the five-role model.
#
# Holds NO dev-dangerous value (dev password, `trust`, `localhost`, …) and NO
# deploy-control value (AWS account/region): those live in .env.dev and
# .env.deploy.<env> respectively, so a key omitted from a cloud .env.<env> is
# UNSET (a laptop-time fatal) rather than silently inheriting a dev default.

PORT=8080

# Public-web / admin-web daemon bind ports. Needed by both the JVM (public-web.conf
# / admin-web.conf ${?PUBLIC_WEB_PORT}/${?ADMIN_WEB_PORT} bind config; service.conf
# builds its ONE local public-web origin (publicWeb.urlBase, RFC 155 D-J) from
# required ${PUBLIC_WEB_PORT}, and every public-web link default derives from
# that one origin — today the email-verification link
# (emailVerification.verifyUrlBase) and the Family Cost Report share link
# (costReport.shareUrlBase). A deployed env replaces the origin wholesale with
# PUBLIC_WEB_URL_BASE)
# and Terraform (each service's ALB target-group / security-group port, read via
# TF_VAR_public_web_port / TF_VAR_admin_web_port). Per CONFIGURATION.md's prime
# directive a value both the JVM and another consumer need lives in the shell
# environment, not a Terraform-owned default. Same value in every env, so the base
# is the only home.
PUBLIC_WEB_PORT=8082
ADMIN_WEB_PORT=8081

POSTGRES_DB=unicoach
POSTGRES_PORT=5432

# --- Application Configuration ---
DATABASE_MAXIMUM_POOL_SIZE=10
SERVER_PORT=$PORT
