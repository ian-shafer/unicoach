PORT=8080

# Public-web / admin-web daemon bind ports. Needed by both the JVM (public-web.conf
# / admin-web.conf ${?PUBLIC_WEB_PORT}/${?ADMIN_WEB_PORT} bind config; service.conf
# also derives the email-verification link default from required ${PUBLIC_WEB_PORT})
# and Terraform (each service's ALB target-group / security-group port, read via
# TF_VAR_public_web_port / TF_VAR_admin_web_port). Per CONFIGURATION.md's prime
# directive a value both the JVM and another consumer need lives in the shell
# environment, not a Terraform-owned default. Same value in every env, so the base
# is the only home.
PUBLIC_WEB_PORT=8082
ADMIN_WEB_PORT=8081

POSTGRES_USER=postgres
POSTGRES_DB=unicoach
POSTGRES_HOST_AUTH_METHOD=trust
# Shared absolute path so every git worktree uses the SAME cluster (one postgres
# on POSTGRES_PORT); isolation is per-database. Do NOT use a $PROJECT_ROOT path.
POSTGRES_DATA_DIR=$HOME/var/unicoach/postgres
POSTGRES_ADMIN_DB=postgres
PGHOST=localhost
POSTGRES_PORT=5432

# --- Application Configuration ---
DATABASE_USER=unicoach
DATABASE_PASSWORD=password
DATABASE_MAXIMUM_POOL_SIZE=10
SERVER_PORT=$PORT

# Single source of the LOCAL/dev deploy host. The server derives
# session.cookieDomain from it (rest-server.conf), and bin/build-ios derives the
# iOS backend URL (http://$APP_DOMAIN:${SERVER_PORT:-8080}) from the same value.
# Override once for on-device use (a DNS hostname; a bare IP is rejected at
# build). The PRODUCTION domain lives separately in .env.prod (the APP_DOMAIN
# apex, e.g. uni.coach); this value is local-only. See ios-app/DEPLOY.md.
APP_DOMAIN=localhost

# AWS region. REGION is the single knob (feeds TF_VAR_region); AWS_REGION is
# derived from it here so the aws CLI (--region on every call in bin/deploy and
# bin/remote) and OpenTofu target one region, sourced once. An externally
# exported AWS_REGION still wins. Because .env is the base and a cloud env's
# .env.<env> delta is sourced AFTER it, AWS_REGION derives from the BASE REGION:
# a cloud env whose REGION differs from this base MUST also set AWS_REGION in its
# own .env.<env> delta. (prod uses us-east-1, same as base, so .env.prod needs
# no AWS_REGION line.)
REGION=us-east-1
AWS_REGION="${AWS_REGION:-$REGION}"
