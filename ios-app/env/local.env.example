# Per-developer on-device dev environment (template).
#
# Copy to ios-app/env/local.env (gitignored) and fill in. `local` is the default
# env for both bin/build-ios and bin/install-ios, so on a fresh clone they fail
# fast until you create this file.
#
# This file carries the build destination. The backend host is derived, not set
# here: bin/build-ios derives UNICOACH_BACKEND_URL from APP_DOMAIN / SERVER_PORT
# in the repo .env / .env.dev (the single sources the server also reads). Set the
# host once via APP_DOMAIN in .env.dev — see ios-app/DEPLOY.md.
#
# The port half is per-worktree since RFC 156: SERVER_PORT is derived in .env.dev
# from this checkout's port block (bin/checkout-port), not a flat 8080. So the
# URL baked into a build belongs to the checkout that built it, and installing a
# build from another checkout is REFUSED by bin/install-ios (exit 3) rather than
# left to point the phone at the wrong server. Rebuild with bin/build-ios.

# Generic device destination: xcodebuild selects the connected iPhone.
UNICOACH_DESTINATION="generic/platform=iOS"

# Optional; defaults to Debug.
# UNICOACH_CONFIGURATION="Debug"

# A target MAY set UNICOACH_BACKEND_URL explicitly to skip the derivation and
# have bin/build-ios forward that URL verbatim — for an externally-terminated
# HTTPS URL (no port) the derived http://host:port form cannot express. The
# checked-in deploy targets instead set UNICOACH_DEPLOY=1, deriving the URL from
# .env.prod as https://api.$APP_DOMAIN (today https://api.uni.coach); see
# ios-app/env/prod.env. Leave it unset here to keep the derived local-dev URL.
# UNICOACH_BACKEND_URL="https://api.uni.coach"
