.gradle/
.kotlin/
build/
var/
!gradle/wrapper/gradle-wrapper.jar
*.swp
ios-app/UnicoachiOS.xcodeproj/project.xcworkspace/xcuserdata/ian.xcuserdatad/UserInterfaceState.xcuserstate

# Transient RFC-pipeline output (RFC backups, diff artifacts, build/test logs).
# Non-anchored so .scratch/ under any subdirectory (e.g. ios-app/.scratch/) is ignored.
.scratch/

# Deno lockfile regenerated on every deno run/eval (OpenAPI spec validation)
/deno.lock

# Per-developer iOS env files (signing.env, local.env, future personal envs,
# and per-target <target>.local.env secret overlays) carry personal
# hosts/credentials and are ignored by default. The shared simulator env, the
# checked-in deploy targets, and the *.env.example templates stay tracked.
ios-app/env/*.env
!ios-app/env/*.env.example
!ios-app/env/simulator.env
!ios-app/env/prod.env
!ios-app/env/prod-simulator.env

# OpenTofu/Terraform local state, provider caches, plans, and operator tfvars.
# Remote state lives in S3 (infra/backend.tf); the bootstrap config and any
# accidental local state must never be committed.
.terraform/
.terraform-*/
*.tfstate
*.tfstate.*
*.tfplan
terraform.tfvars

# The IPEDS survey data files fetched by bin/fetch-ipeds (RFC 144). The
# extracted CSVs are far too large to commit -- bin/fetch-ipeds states the
# figure -- so only the record lands: PROVENANCE.json is the committed record of
# the real fetch and the baseline the fetcher's shrink guard reads, and
# FETCH-NOTES.md says how it was made.
db/seed/ipeds/*
!db/seed/ipeds/PROVENANCE.json
!db/seed/ipeds/FETCH-NOTES.md
