# Copy to terraform.tfvars (gitignored) and adjust as needed. Every value below
# except app_domain is the variables.tf default; uncomment a line only to
# override it.
#
# app_domain has NO default: bin/infra-plan / bin/infra-apply supply it as
# TF_VAR_app_domain from .env.prod (APP_DOMAIN), keeping the value set in
# exactly one place. Set it there, not here. Uncomment below only to override
# that single source for a one-off raw `tofu` run.
# app_domain        = "uni.coach"
# region            = "us-east-1"
# instance_type     = "t4g.small"
# db_instance_class = "db.t4g.micro"
# db_engine_version = "18"
# app_db_user       = "unicoach"
