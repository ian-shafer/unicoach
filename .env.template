# Schema reference for the dotenv layer. NOT sourced at runtime — copy the keys
# you need into the role file below. bin/common layers a base plus one or more
# deltas; the five roles (RFC 95) are:
#
#   .env                 committed base — env-NEUTRAL non-secret app config only,
#                        identical in dev and every cloud env. No dev-dangerous
#                        value, no deploy-control value.
#   .env.dev             local-dev delta — dev-dangerous / env-specific values
#                        (dev DB password, `trust`, localhost, the required
#                        toggles' dev values). Layered by bin/common's ambient
#                        default (base -> .env.dev) and by the test harnesses
#                        (ENV_FILES=".env.dev:.env.test|.env.fuzz"). The
#                        deploy/infra path NEVER layers it.
#   .env.<env>           a cloud env's non-secret app config (e.g. .env.prod) —
#                        the full DEPLOY_VAR_NAMES set. Read only by
#                        bin/gen-deployed-env (to flatten into deploy-env) and
#                        bin/infra-* (to export TF_VAR_*), always as
#                        `.env -> .env.<env>` with .env.dev EXCLUDED. A key
#                        omitted here is UNSET (a laptop-time fatal), never
#                        inherited from .env.dev.
#   .env.deploy.<env>    deploy-control only (AWS_ACCOUNT_ID, REGION, and the
#                        AWS_REGION derivation). Sourced by bin/deploy /
#                        bin/remote / bin/infra-* to reach the right AWS account
#                        and region. NEVER shipped to the instance.
#   SSM /unicoach/<env>  the only two Terraform-owned classes: secrets
#                        (SecureStrings) and RDS identity (PGHOST/DATABASE_HOST/
#                        POSTGRES_USER/DATABASE_USER). Everything else is committed
#                        to the dotenv roles above.
#
# ── Base (.env) ───────────────────────────────────────────────────────────────
# Env-neutral non-secret values only.

# The three service ports are unconditional here, as a base key must be. Local
# dev overrides all three per worktree in .env.dev (RFC 156) and the test/fuzz
# harnesses override them from BASE_TEST_PORT.
PORT=8080
PUBLIC_WEB_PORT=8082
ADMIN_WEB_PORT=8081
POSTGRES_PORT=5432
DATABASE_MAXIMUM_POOL_SIZE=10
SERVER_PORT=$PORT

# ── Local-dev delta (.env.dev) ────────────────────────────────────────────────
# Dev-dangerous / env-specific values. Layered under the local default only.

POSTGRES_USER=postgres
POSTGRES_HOST_AUTH_METHOD=trust
POSTGRES_DATA_DIR=$HOME/var/unicoach/postgres
POSTGRES_ADMIN_DB=postgres
# Per-worktree dev database (RFC 156): one shared cluster, isolation per
# database, so one checkout's bin/db-reset cannot destroy another's dev data.
# NOT a base key -- the value is no longer identical in dev and every cloud env.
# Two checkouts with the same directory BASENAME share one dev database, with no
# bind failure to reveal it; the remedy is to rename one worktree directory.
POSTGRES_DB=unicoach-dev-$(checkout_name "$PROJECT_ROOT")
# Per-worktree dev ports: the +10/+11/+12 offsets of this checkout's 16-port
# block (bin/checkout-port's help text is the offset registry). The dev half
# never advances -- the port is baked into iOS bundles. SERVER_PORT MUST be
# re-derived after PORT: the base assigns it before this delta is read.
# CHECKOUT_BLOCK_BASE and CHECKOUT_DEV_OFFSET_* are set by bin/functions, which
# must be sourced with PROJECT_ROOT set before this file; `:?` makes that
# precondition fail closed rather than yielding PORT=10 (RFC 156).
PORT=$(( ${CHECKOUT_BLOCK_BASE:?bin/functions must be sourced, with PROJECT_ROOT set, before .env.dev (RFC 156)} + ${CHECKOUT_DEV_OFFSET_REST_SERVER:?bin/functions must be sourced before .env.dev (RFC 156)} ))
ADMIN_WEB_PORT=$(( ${CHECKOUT_BLOCK_BASE:?bin/functions must be sourced, with PROJECT_ROOT set, before .env.dev (RFC 156)} + ${CHECKOUT_DEV_OFFSET_ADMIN_WEB:?bin/functions must be sourced before .env.dev (RFC 156)} ))
PUBLIC_WEB_PORT=$(( ${CHECKOUT_BLOCK_BASE:?bin/functions must be sourced, with PROJECT_ROOT set, before .env.dev (RFC 156)} + ${CHECKOUT_DEV_OFFSET_PUBLIC_WEB:?bin/functions must be sourced before .env.dev (RFC 156)} ))
SERVER_PORT=$PORT
PGHOST=localhost
DATABASE_USER=unicoach
DATABASE_PASSWORD=password
APP_DOMAIN=localhost
# Bind hosts (new dotenv keys): dev overrides the .conf defaults to loopback.
SERVER_HOST=127.0.0.1
PUBLIC_WEB_HOST=127.0.0.1
ADMIN_WEB_HOST=127.0.0.1
# Required toggles — dev values (permissive/offline modes).
GOOGLE_AUTH_PROVIDER=stub
APPLE_AUTH_PROVIDER=stub
SESSION_COOKIE_SECURE=false
ADMIN_COOKIE_SECURE=false
EMAIL_PROVIDER=log
CHAT_PROVIDER=log
# App Store verify path (RFC 110): dev/test/fuzz target the sandbox store; the
# credential trio stays unset locally (verify answers 503).
APP_STORE_ENVIRONMENT=sandbox
# Request-log verbosity (RFC 103, shared across services by RFC 105). web-common's
# `reference.conf` (shared by all three web services) carries careful defaults
# (allowlist headers, enrich-on-failure) that are safe by default, so a cloud env
# that OMITS these inherits them — never verbose. Dev alone widens to every header
# on every request; secretHeaders (Cookie/Authorization, plus rest-server's
# X-Unicoach-Client-Key) are never logged even under "*". REQUEST_LOG_SECRET_HEADERS
# also overrides the secret set if ever needed.
REQUEST_LOG_HEADERS=*
REQUEST_LOG_DETAIL=always

# Server-side client-key gate (rest-server.conf clientKeyGate.keys). Blank
# locally (gate fails open on an empty set). Never commit a real value.
UNICOACH_CLIENT_KEYS=
# iOS build-time client key baked into the app bundle. Blank locally. Never
# commit a real value.
UNICOACH_CLIENT_KEY=

# ── Cloud env delta (.env.<env>, e.g. .env.prod) ──────────────────────────────
# A cloud env's full non-secret app config — the DEPLOY_VAR_NAMES set. UNICOACH_ENV
# is the invocation argument to bin/infra-*/bin/deploy (not a file key). Secrets and
# RDS identity are NEVER here — they are the SSM-owned classes.

# APP_DOMAIN=uni.coach       # the env's web host / apex; -> TF_VAR_app_domain
# POSTGRES_DB=unicoach       # the env's database name. NOT inherited from the base
#                            #   since RFC 156 (dev derives it per worktree), so every
#                            #   cloud env must set it; for prod it must match
#                            #   infra/rds.tf's db_name literal.
# GOOGLE_CLIENT_IDS=...      # accepted OAuth audiences; -> TF_VAR_google_client_ids
# APPLE_CLIENT_IDS=...       # accepted Apple audiences (app bundle IDs), comma-separated
# HOSTED_ZONE_NAME=uni.coach # OMIT for an apex env (coalesces to APP_DOMAIN); set to the
#                            #   parent zone for a subdomain-per-env; -> TF_VAR_hosted_zone_name
# SERVER_HOST=0.0.0.0        # bind all interfaces so the ALB reaches each service
# PUBLIC_WEB_HOST=0.0.0.0
# ADMIN_WEB_HOST=0.0.0.0
# SESSION_COOKIE_SECURE=true # required toggle — prod value
# ADMIN_COOKIE_SECURE=true
# EMAIL_PROVIDER=ses
# CHAT_PROVIDER=anthropic
# GOOGLE_AUTH_PROVIDER=google
# APPLE_AUTH_PROVIDER=apple
# APP_STORE_ENVIRONMENT=production # required toggle — which App Store this env verifies
#                            #   against (sandbox | production). The credential trio
#                            #   (APP_STORE_ISSUER_ID / APP_STORE_KEY_ID /
#                            #   APP_STORE_PRIVATE_KEY) is SSM out-of-band, never dotenv;
#                            #   the private key is seeded as one-line base64 PKCS#8:
#                            #   grep -v 'PRIVATE KEY' AuthKey_<KEYID>.p8 | tr -d '\n'
# EMAIL_DEFAULT_FROM=noreply@$APP_DOMAIN                       # derived from APP_DOMAIN
# PUBLIC_WEB_URL_BASE=https://app.$APP_DOMAIN # the ONE public-web origin (RFC 155 D-J);
#                            #   service.conf appends each page's path to it —
#                            #   /verify-email and /report today. The per-link hatches
#                            #   EMAIL_VERIFICATION_VERIFY_URL_BASE and
#                            #   COST_REPORT_SHARE_URL_BASE still override one page each,
#                            #   and are NOT in DEPLOY_VAR_NAMES: using one on the deploy
#                            #   path means adding it there too.
#                            #   The Family Cost Report SIGNING KEY
#                            #   (COST_REPORT_SHARE_TOKEN_SECRET) is SSM out-of-band,
#                            #   never dotenv — .env.dev alone carries a local value

# ── Deploy-control delta (.env.deploy.<env>, e.g. .env.deploy.prod) ────────────
# AWS account/region only. Sourced by bin/deploy / bin/remote / bin/infra-*.
# NEVER shipped to the instance.

# AWS_ACCOUNT_ID=4641...     # the env's 12-digit AWS account. bin/infra-plan|apply and
#                            #   bin/deploy assert the active credentials resolve to it
#                            #   before any tofu/aws action.
# REGION=us-east-1           # AWS region; -> TF_VAR_region. AWS_REGION derives from it
#                            #   here (AWS_REGION="${AWS_REGION:-$REGION}") so the aws CLI
#                            #   (--region) and OpenTofu target one region. An externally
#                            #   exported AWS_REGION still wins.
# AWS_REGION="${AWS_REGION:-$REGION}"
