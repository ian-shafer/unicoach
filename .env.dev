# Local-dev delta, layered over .env by bin/common's ambient default
# (base -> .env.dev). Holds local dev's env-specific and dev-dangerous values —
# the ones that MUST NOT reach a cloud env. The deploy/infra path NEVER layers
# this file (it pins ENV_FILE=.env.<env>), so a key present here but omitted from
# a cloud .env.<env> is unset there, and require_env_vars fatals on the laptop
# rather than shipping a dev value. See CONFIGURATION.md.

# --- Postgres cluster / DB connection (dev-dangerous: trust auth, dev password) ---
POSTGRES_USER=postgres
POSTGRES_HOST_AUTH_METHOD=trust
# Shared absolute path so every git worktree uses the SAME cluster (one postgres
# on POSTGRES_PORT); isolation is per-database. Do NOT use a $PROJECT_ROOT path.
POSTGRES_DATA_DIR=$HOME/var/unicoach/postgres
POSTGRES_ADMIN_DB=postgres
# Per-worktree dev database (RFC 156), the same derivation .env.test and
# .env.fuzz already use: one shared cluster (POSTGRES_DATA_DIR above), isolation
# at the DATABASE level. Before this, every worktree pointed at one database
# literally named `unicoach`, so a routine bin/db-reset in any checkout dropped
# every other checkout's dev data. PROJECT_ROOT is set by bin/common before this
# file is sourced, and the whole load runs under `set -a`, so the command
# substitution expands at source time into a flat exported literal that flows to
# the JVM via db.conf's ${POSTGRES_DB}.
#
# The key is deliberately absent from the base .env: dev's value is now
# per-worktree, so it is no longer "identical in dev and every cloud env", which
# is the only thing the base may hold. Each cloud .env.<env> therefore sets it
# explicitly (.env.prod: unicoach).
#
# COLLISION, and it is the quieter half of the two: the derivation keys on the
# directory BASENAME, so two checkouts named the same thing in different parent
# directories share ONE dev database and silently overwrite each other's data.
# The port half announces its collision -- bin/daemon-up refuses to bind and
# names the port -- but this half has no bind to fail, so nothing reveals it.
# Same remedy as the port half: rename one of the two worktree directories,
# which moves both the database and the block.
# No `:?` guard here, unlike the ports below: this line fails closed a
# different way. checkout_name is a FUNCTION from bin/functions, so if
# bin/functions was not sourced the call is "command not found" and, because
# bin/common runs under `set -e`, the whole source of this file aborts -- no
# half-configured environment reaches a caller. A wrong dev database name
# cannot be produced silently.
POSTGRES_DB=unicoach-dev-$(checkout_name "$PROJECT_ROOT")
PGHOST=localhost
DATABASE_USER=unicoach
DATABASE_PASSWORD=password

# --- Per-worktree dev ports (RFC 156) ---
# Dev takes the +10/+11/+12 offsets of this checkout's 16-port block, so two
# worktrees can run dev servers at the same time and neither can steal the
# other's 8080. checkout_block_base (bin/functions) is the PURE derivation --
# 18000 + (cksum of the checkout directory name % 1900) * 16 -- and
# bin/checkout-port's help text is the offset registry that owns the +10/+11/+12
# assignment. Ports are ASSIGNED from that registry, never scanned for and never
# defined relative to each other, which is why each line repeats the base rather
# than saying `$(( PORT + 1 ))`.
#
# The DEV half never advances. bin/checkout-port advances a whole block when the
# EPHEMERAL half (+0..+9) is contended, which is right for a test run that just
# needs some free block; it is wrong here, because bin/build-ios BAKES this port
# into the app bundle's Info.plist (UnicoachBackendURL). A dev port that moved
# would leave every previously-built app on the simulator and the phone pointing
# somewhere wrong, silently. So a hash collision (1 in 1900) surfaces instead as
# bin/daemon-up refusing to bind, naming the held port; the remedy is to rename
# one of the two worktree directories, which moves the block.
#
# The base arrives as a VALUE, CHECKOUT_BLOCK_BASE, and the three offsets as
# CHECKOUT_DEV_OFFSET_REST_SERVER/_ADMIN_WEB/_PUBLIC_WEB -- all set by
# bin/functions, which is where the "+10 is where dev begins" fact lives. This file ADDS them rather than
# restating 10/11/12, so bin/checkout-port's ephemeral/dev boundary and these
# three ports cannot drift apart. It cannot be a call to
# bin/checkout-port or bin/check-port: those source bin/common, bin/common
# sources this file, and the re-entry would fork without bound. bin/functions is
# sourced -- and PROJECT_ROOT set -- before the dotenvs on BOTH the bin/common
# path and the bin/build-ios path, which is what makes the value present here.
#
# `:?` and not `:-`: it FAILS CLOSED. The earlier form, `$(( $(checkout_block_base)
# + 10 ))`, evaluated to PORT=10 with exit status 0 when bin/functions had not
# been sourced -- a silently wrong, privileged port that bin/build-ios then BAKES
# into an app bundle's Info.plist. A dev port that is wrong must stop the load,
# not be discovered months later on a phone.
PORT=$(( ${CHECKOUT_BLOCK_BASE:?bin/functions must be sourced, with PROJECT_ROOT set, before .env.dev (RFC 156)} + ${CHECKOUT_DEV_OFFSET_REST_SERVER:?bin/functions must be sourced before .env.dev (RFC 156)} ))
ADMIN_WEB_PORT=$(( ${CHECKOUT_BLOCK_BASE:?bin/functions must be sourced, with PROJECT_ROOT set, before .env.dev (RFC 156)} + ${CHECKOUT_DEV_OFFSET_ADMIN_WEB:?bin/functions must be sourced before .env.dev (RFC 156)} ))
PUBLIC_WEB_PORT=$(( ${CHECKOUT_BLOCK_BASE:?bin/functions must be sourced, with PROJECT_ROOT set, before .env.dev (RFC 156)} + ${CHECKOUT_DEV_OFFSET_PUBLIC_WEB:?bin/functions must be sourced before .env.dev (RFC 156)} ))
# Re-derived after PORT, and NOT optional: `.env` -- the base layer, sourced
# first -- assigns SERVER_PORT=$PORT before any delta is read, so a delta that
# overrides PORT without this line leaves SERVER_PORT at the base 8080 while the
# server binds base+10. Same trap, same fix, as .env.test:37-38.
SERVER_PORT=$PORT

# Single source of the LOCAL/dev deploy host. The server derives
# session.cookieDomain from it (rest-server.conf), and bin/build-ios derives the
# iOS backend URL (http://$APP_DOMAIN:$SERVER_PORT) from the same value. Since
# RFC 156 that port is this worktree's derived dev port (above), not 8080, so an
# app built here talks to THIS checkout's server and no other.
# The PRODUCTION domain lives separately in .env.<env> (e.g. .env.prod's apex
# uni.coach); this value is local-only. See ios-app/DEPLOY.md.
APP_DOMAIN=localhost

# Service bind hosts. New dotenv keys (absent from the .conf-default world before
# RFC 95): dev overrides SERVER_HOST to loopback (the .conf default is 0.0.0.0),
# and pins public-web/admin-web to their .conf loopback defaults explicitly. In a
# cloud .env.<env> all three become 0.0.0.0 so the box binds all interfaces.
SERVER_HOST=127.0.0.1
PUBLIC_WEB_HOST=127.0.0.1
ADMIN_WEB_HOST=127.0.0.1

# --- Required HOCON toggles: dev values (RFC 95) ---
# Each of these is a REQUIRED substitution (${VAR}, no .conf default line), so a
# forgotten cloud override fails the JVM at boot instead of silently running the
# permissive dev mode. Dev runs the offline / non-erroring mode.
GOOGLE_AUTH_PROVIDER=stub
APPLE_AUTH_PROVIDER=stub
SESSION_COOKIE_SECURE=false
ADMIN_COOKIE_SECURE=false
EMAIL_PROVIDER=log
CHAT_PROVIDER=log
# App Store environment (RFC 110): dev verifies against the sandbox store. The
# test harness layers .env.dev under .env.test/.env.fuzz, so this value covers
# dev, test, and fuzz. The credential trio (APP_STORE_ISSUER_ID / KEY_ID /
# PRIVATE_KEY) stays unset locally — verify answers 503, all tests fake at the
# transport seam.
APP_STORE_ENVIRONMENT=sandbox

# RFC 155: the HMAC key the Family Cost Report share links are derived from. A
# secret in a deployed environment (SSM, infra/ssm.tf) but a dev-dangerous local
# value here, exactly like DATABASE_PASSWORD above -- so a fresh checkout can
# share a report with zero setup. The test harness layers .env.dev under
# .env.test/.env.fuzz, so this value covers dev, test and fuzz.
COST_REPORT_SHARE_TOKEN_SECRET=dev-cost-report-share-secret-not-for-production

# --- Verbose request log (dev only): every header, every request (RFC 103) ---
# The rest-server.conf careful defaults (allowlist headers, enrich-on-failure)
# are safe by default, so a cloud env that omits these inherits them. This delta
# is NEVER layered onto a deploy (bin/functions pins .env.<env>), so no cloud env
# sees the verbose values. secretHeaders is subtracted even under "*".
REQUEST_LOG_HEADERS=*
REQUEST_LOG_DETAIL=always
