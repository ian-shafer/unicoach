# Deploy-control delta for the `prod` env: AWS account/region only. Sourced by
# bin/deploy / bin/remote / bin/infra-* to reach the right AWS account and region.
# NEVER shipped to the instance and NEVER layered into app config — it carries no
# JVM value. See CONFIGURATION.md.

# The AWS account this environment targets (a 12-digit id; not a secret — it
# appears in every ARN). bin/infra-plan, bin/infra-apply, and bin/deploy assert
# the active AWS credentials resolve to this account (via `aws sts
# get-caller-identity`) before any tofu/aws action, so a stray ambient AWS
# profile can never silently deploy to the wrong account.
AWS_ACCOUNT_ID=464190673722

# AWS region. REGION is the single knob (feeds TF_VAR_region); AWS_REGION is
# derived from it here so the aws CLI (--region on every call in bin/deploy /
# bin/remote / bin/infra-*) and OpenTofu target one region, sourced once. An
# externally exported AWS_REGION still wins. Both REGION and its AWS_REGION
# derivation moved here together out of the .env base (they are deploy-control),
# so this file is the source-once home the --region callers read.
REGION=us-east-1
AWS_REGION="${AWS_REGION:-$REGION}"
