#!/usr/bin/env bash
set -euo pipefail
source "$(dirname "$0")/rfc-pipeline-lib"

help() {
  local exit_code=0
  if [ "$#" -gt 0 ]; then
    log-info "$1"
    exit_code=1
  fi
  cat << 'EOF'
rfc-pipeline-land -s run-scratch

Phase 3 teardown, run AFTER the Architect has committed the two final commits on
the pipeline branch. Fast-forwards the base branch onto the pipeline branch,
removes the worktree, and deletes the now-merged branch — all from the original
checkout, never from inside the worktree.

`git worktree remove` refuses if the worktree has uncommitted changes; that is a
safety check, not an obstacle to force past. If the fast-forward is not possible
(the base advanced), this stops before touching anything so you can open a PR or
rebase instead.

Options:
  -s run-scratch   The run-scratch dir holding this run's state (required).
  -h               Help.
EOF
  exit "$exit_code"
}

RUN_SCRATCH=""
while getopts ":s:h" opt; do
  case "$opt" in
  s) RUN_SCRATCH="$OPTARG" ;;
  h) help ;;
  \?) help "unknown option [-$OPTARG]" ;;
  :) help "option -$OPTARG requires an argument" ;;
  esac
done
shift $((OPTIND - 1))

[ -n "$RUN_SCRATCH" ] || help "Missing required -s run-scratch."
[ "$#" -eq 0 ] || help "rfc-pipeline-land takes no positional arguments."

pl_load_state "$RUN_SCRATCH"

if ! git -C "$CODEBASE_ROOT" diff --quiet HEAD || ! git -C "$CODEBASE_ROOT" diff --cached --quiet; then
  fatal "Worktree [$CODEBASE_ROOT] has uncommitted changes; commit the final two commits before landing."
fi

# Fast-forward BASE_BRANCH to the pipeline tip, wherever it lives. Never rely on
# the original checkout's *current* branch: concurrent work may have switched it
# off BASE_BRANCH, and `merge --ff-only` would then silently advance the wrong
# branch. Verify the fast-forward, then target BASE_BRANCH explicitly.
if ! git -C "$ORIGINAL_CHECKOUT" merge-base --is-ancestor "$BASE_BRANCH" "$PIPELINE_BRANCH"; then
  fatal "Cannot fast-forward [$BASE_BRANCH] onto [$PIPELINE_BRANCH] — base has advanced. Open a PR or rebase the branch instead; worktree left intact."
fi

# Which worktree, if any, has BASE_BRANCH checked out?
base_worktree="$(git -C "$ORIGINAL_CHECKOUT" worktree list --porcelain |
  awk -v b="refs/heads/$BASE_BRANCH" '/^worktree /{wt=$2} /^branch /{if ($2==b) print wt}')"

if [ -n "$base_worktree" ]; then
  # Checked out somewhere: fast-forward it in place (must be clean, or we would
  # clobber uncommitted work / leave a dirty index).
  if ! git -C "$base_worktree" diff --quiet HEAD || ! git -C "$base_worktree" diff --cached --quiet; then
    fatal "[$BASE_BRANCH] is checked out with uncommitted changes in [$base_worktree]; cannot land. Resolve there, or switch it off [$BASE_BRANCH]."
  fi
  git -C "$base_worktree" merge --ff-only "$PIPELINE_BRANCH" >/dev/null
else
  # Not checked out anywhere: move the ref directly (fast-forward verified above).
  git -C "$ORIGINAL_CHECKOUT" branch -f "$BASE_BRANCH" "$PIPELINE_BRANCH"
fi
log-info "Fast-forwarded [$BASE_BRANCH] to [$(git -C "$ORIGINAL_CHECKOUT" rev-parse --short "$PIPELINE_BRANCH")]."

# Archive /manual-review-fix's evaluation output (ledger, findings, worktree
# manifest) before the worktree that holds it is removed below. It lives under
# gitignored `.scratch/`, so nothing else preserves it once the worktree is
# gone — and it's the whole reason that process exists. Only present on a run
# that actually used /manual-review-fix; absent otherwise.
mrf_scratch="$CODEBASE_ROOT/.scratch/manual-review-fix"
if [ -d "$mrf_scratch" ]; then
  archive_dir="$ORIGINAL_CHECKOUT/.scratch/manual-review-fix-archive/rfc-${RFC_NUM}"
  mkdir -p "$archive_dir"
  cp -R "$mrf_scratch/." "$archive_dir/"
  log-info "Archived [$mrf_scratch] to [$archive_dir]."
fi

git -C "$ORIGINAL_CHECKOUT" worktree remove "$CODEBASE_ROOT"
log-info "Removed worktree [$CODEBASE_ROOT]."

# BASE_BRANCH now contains the pipeline tip, so the branch is fully merged. Use
# -D (not -d): -d's merged check is relative to the current HEAD, which is no
# longer guaranteed to be BASE_BRANCH; the merge into BASE_BRANCH was just done.
git -C "$ORIGINAL_CHECKOUT" branch -D "$PIPELINE_BRANCH"
log-info "Deleted merged branch [$PIPELINE_BRANCH]. Run wound down."
