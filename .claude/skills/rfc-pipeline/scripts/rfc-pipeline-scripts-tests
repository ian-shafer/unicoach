#!/usr/bin/env bash
# Tests for the rfc-pipeline git-plumbing scripts. These exercise the REAL
# scripts against REAL throwaway git repos under a temp dir — no mocks, no
# parsing of the scripts' source. Each scenario builds an isolated repo so a
# failure cannot leak into the developer's checkout.
#
# Self-contained: depends on nothing outside the scripts/ directory. Run inside
# the dev shell for a modern git:
#   nix develop -c .claude/skills/rfc-pipeline/scripts/rfc-pipeline-scripts-tests
set -euo pipefail

SCRIPTS="$(cd "$(dirname "$0")" && pwd)"

# Minimal inline assertion harness (no dependency on the repo's bin/tests-common).
TOTAL_TESTS=0
pass_test() {
  TOTAL_TESTS=$((TOTAL_TESTS + 1))
  echo -e " \033[0;32m✅ $1\033[0m"
}
fail_test() {
  echo -e " \033[0;31m❌ Fail: $1\033[0m" >&2
  exit 1
}
assert_success() {
  local msg="$1"
  shift
  "$@" || fail_test "$msg"
  pass_test "$msg"
}
assert_failure() {
  local msg="$1"
  shift
  if "$@"; then fail_test "$msg (expected to fail)"; fi
  pass_test "$msg"
}
end_tests() {
  echo ""
  echo -e " 🎉 \033[0;32m${TOTAL_TESTS} tests passed successfully.\033[0m"
}

WORK="$(mktemp -d)"
trap 'rm -rf "$WORK"' EXIT INT TERM

# Create a fresh isolated repo on `main`. Args: any rfc/NN-name.md basenames to
# pre-commit. Echoes the repo path. Each repo gets a unique mktemp dir — this
# runs in a command substitution (subshell), so a shared counter would not
# persist; mktemp guarantees uniqueness without shared state.
fresh_repo() {
  local dir
  dir="$(mktemp -d "$WORK/proj.XXXXXX")"
  mkdir -p "$dir/rfc"
  git -C "$dir" init -q -b main
  git -C "$dir" config user.email test@example.com
  git -C "$dir" config user.name "Test"
  # Keep rfc/ present in worktree checkouts (git won't track an empty dir).
  : > "$dir/rfc/.gitkeep"
  # Mirror the real repo: .scratch/ is gitignored, so the run state/ledger the
  # scripts write there never enter a checkpoint commit.
  echo ".scratch/" > "$dir/.gitignore"
  local f
  for f in "$@"; do
    echo "rfc body" > "$dir/rfc/$f"
  done
  echo "seed" > "$dir/README.md"
  git -C "$dir" add -A
  git -C "$dir" commit -qm "seed"
  echo "$dir"
}

# Pull a single KEY's value out of captured `rfc-pipeline-claim` state output.
state_val() { grep -E "^$2=" <<< "$1" | head -1 | cut -d= -f2-; }

echo "==== rfc-pipeline-claim ===="

repo="$(fresh_repo)"
state="$(cd "$repo" && "$SCRIPTS/rfc-pipeline-claim")"
n="$(state_val "$state" RFC_NUM)"
root="$(state_val "$state" CODEBASE_ROOT)"
scratch="$(state_val "$state" RUN_SCRATCH)"
[ "$n" = "1" ] || fail_test "empty rfc dir should claim n=1, got [$n]"
pass_test "claim picks n=1 with no prior RFCs"
[ -d "$root" ] || fail_test "worktree dir [$root] not created"
pass_test "claim creates the worktree directory"
assert_success "claim creates pipeline branch" \
  git -C "$repo" rev-parse --verify pipeline/rfc-1
[ -f "$scratch/state" ] || fail_test "state file not written under run-scratch"
pass_test "claim writes the run-scratch state file"
[ -f "$scratch/checkpoints.log" ] || fail_test "ledger not initialized"
pass_test "claim initializes an empty ledger"
[ -d "$scratch/phase2/impl-review" ] || fail_test "scratch layout not scaffolded"
pass_test "claim scaffolds the run-scratch layout"

repo="$(fresh_repo 03-alpha.md 01-beta.md)"
state="$(cd "$repo" && "$SCRIPTS/rfc-pipeline-claim")"
[ "$(state_val "$state" RFC_NUM)" = "4" ] || fail_test "with rfc/03 committed, expected n=4"
pass_test "claim picks one past the highest committed RFC"

# A branch claiming a higher number must be honoured even with no committed file.
repo="$(fresh_repo 02-x.md)"
git -C "$repo" branch pipeline/rfc-09
state="$(cd "$repo" && "$SCRIPTS/rfc-pipeline-claim")"
[ "$(state_val "$state" RFC_NUM)" = "10" ] || fail_test "branch claim ignored; expected n=10"
pass_test "claim respects a pipeline/rfc-NN branch claim"

# Collision bump: pre-create the branch for the number we'd compute.
repo="$(fresh_repo)"
git -C "$repo" branch pipeline/rfc-1
state="$(cd "$repo" && "$SCRIPTS/rfc-pipeline-claim")"
[ "$(state_val "$state" RFC_NUM)" = "2" ] || fail_test "expected bump to n=2 on branch collision"
pass_test "claim bumps past a colliding branch"

echo ""
echo "==== rfc-pipeline-checkpoint ===="

repo="$(fresh_repo)"
state="$(cd "$repo" && "$SCRIPTS/rfc-pipeline-claim")"
root="$(state_val "$state" CODEBASE_ROOT)"
scratch="$(state_val "$state" RUN_SCRATCH)"
before="$(git -C "$root" rev-list --count HEAD)"
echo "change" > "$root/rfc/draft.md"
sha="$("$SCRIPTS/rfc-pipeline-checkpoint" -s "$scratch" design-review 1)"
after="$(git -C "$root" rev-list --count HEAD)"
[ "$after" -eq "$((before + 1))" ] || fail_test "checkpoint did not add a commit"
pass_test "checkpoint commits the worktree"
[ "$sha" = "$(git -C "$root" rev-parse HEAD)" ] || fail_test "printed SHA != HEAD"
pass_test "checkpoint prints the new commit SHA"
grep -q "$sha" "$scratch/checkpoints.log" || fail_test "checkpoint not appended to ledger"
pass_test "checkpoint appends to the ledger"
git -C "$root" log -1 --pretty=%s | grep -q 'pipeline(rfc-1): design-review \[1\]' ||
  fail_test "checkpoint message format wrong"
pass_test "checkpoint uses the pipeline(rfc-n): step [i] message"

# Untracked NEW files must be captured (the `git add -A` vs `-a` gotcha).
echo "new" > "$root/newfile.txt"
"$SCRIPTS/rfc-pipeline-checkpoint" -s "$scratch" impl >/dev/null
git -C "$root" ls-files --error-unmatch newfile.txt >/dev/null 2>&1 ||
  fail_test "checkpoint omitted a new untracked file"
pass_test "checkpoint captures untracked new files (add -A)"

# The run state/ledger live under .scratch/ and must never be committed.
if git -C "$root" ls-files --error-unmatch .scratch/rfc-1/state >/dev/null 2>&1; then
  fail_test "checkpoint committed the run state under .scratch/"
fi
pass_test "checkpoint never commits .scratch/ (gitignored)"

# No-op checkpoint: clean tree records HEAD without a new commit.
count_before="$(git -C "$root" rev-list --count HEAD)"
lines_before="$(wc -l < "$scratch/checkpoints.log")"
noop_sha="$("$SCRIPTS/rfc-pipeline-checkpoint" -s "$scratch" impl-review 1)"
[ "$(git -C "$root" rev-list --count HEAD)" -eq "$count_before" ] ||
  fail_test "no-op checkpoint created a commit"
[ "$noop_sha" = "$(git -C "$root" rev-parse HEAD)" ] || fail_test "no-op SHA != HEAD"
[ "$(wc -l < "$scratch/checkpoints.log")" -eq "$((lines_before + 1))" ] ||
  fail_test "no-op checkpoint not recorded in ledger"
pass_test "no-op checkpoint records HEAD without committing"

echo ""
echo "==== rfc-pipeline-verify-scope ===="

repo="$(fresh_repo)"
state="$(cd "$repo" && "$SCRIPTS/rfc-pipeline-claim")"
root="$(state_val "$state" CODEBASE_ROOT)"
scratch="$(state_val "$state" RUN_SCRATCH)"

assert_success "clean tree passes empty-scope check" \
  "$SCRIPTS/rfc-pipeline-verify-scope" -s "$scratch"

echo "x" > "$root/rfc/10-x.md"
assert_failure "dirty tree fails empty-scope check" \
  "$SCRIPTS/rfc-pipeline-verify-scope" -s "$scratch"
assert_success "change within allowlist passes" \
  "$SCRIPTS/rfc-pipeline-verify-scope" -s "$scratch" 'rfc/*.md'
assert_failure "change outside allowlist fails" \
  "$SCRIPTS/rfc-pipeline-verify-scope" -s "$scratch" 'src/*'

# Deny mode: a SPEC.md write is denied even though other code is allowed.
git -C "$root" stash -u >/dev/null 2>&1 || true
git -C "$root" checkout -- . 2>/dev/null || true
rm -f "$root/rfc/10-x.md"
mkdir -p "$root/service"
echo "code" > "$root/service/Foo.kt"
assert_success "code-only change passes deny check for SPEC/INVARIANTS" \
  "$SCRIPTS/rfc-pipeline-verify-scope" -s "$scratch" -d '*/SPEC.md' -d '*/INVARIANTS.md'
echo "spec" > "$root/service/SPEC.md"
assert_failure "SPEC.md write trips the deny check" \
  "$SCRIPTS/rfc-pipeline-verify-scope" -s "$scratch" -d '*/SPEC.md' -d '*/INVARIANTS.md'

echo ""
echo "==== rfc-pipeline-recover ===="

repo="$(fresh_repo)"
state="$(cd "$repo" && "$SCRIPTS/rfc-pipeline-claim")"
root="$(state_val "$state" CODEBASE_ROOT)"
scratch="$(state_val "$state" RUN_SCRATCH)"
echo "a" > "$root/rfc/a.md"
"$SCRIPTS/rfc-pipeline-checkpoint" -s "$scratch" design-review 1 >/dev/null
echo "b" > "$root/rfc/b.md"
"$SCRIPTS/rfc-pipeline-checkpoint" -s "$scratch" design-review 2 >/dev/null
echo "scratch survives" > "$scratch/marker.txt"
"$SCRIPTS/rfc-pipeline-recover" -s "$scratch" design-review 1 >/dev/null
[ -f "$root/rfc/a.md" ] || fail_test "recover lost the checkpointed file a.md"
[ ! -f "$root/rfc/b.md" ] || fail_test "recover did not roll back b.md"
pass_test "recover resets to a named checkpoint"
[ -f "$scratch/marker.txt" ] || fail_test "recover clobbered .scratch/ (used -x?)"
pass_test "recover preserves .scratch/"

echo ""
echo "==== rfc-pipeline-squash ===="

repo="$(fresh_repo)"
state="$(cd "$repo" && "$SCRIPTS/rfc-pipeline-claim")"
root="$(state_val "$state" CODEBASE_ROOT)"
scratch="$(state_val "$state" RUN_SCRATCH)"
base="$(state_val "$state" BASE_SHA)"
echo "1" > "$root/rfc/one.md"
"$SCRIPTS/rfc-pipeline-checkpoint" -s "$scratch" design-review 1 >/dev/null
echo "2" > "$root/rfc/two.md"
"$SCRIPTS/rfc-pipeline-checkpoint" -s "$scratch" impl >/dev/null
"$SCRIPTS/rfc-pipeline-squash" -s "$scratch"
[ "$(git -C "$root" rev-parse HEAD)" = "$base" ] || fail_test "squash did not reset HEAD to base"
pass_test "squash resets HEAD to the base SHA"
git -C "$root" diff --cached --quiet && fail_test "squash lost the staged changes"
pass_test "squash preserves the working changes (staged)"

echo ""
echo "==== rfc-pipeline-adopt ===="

repo="$(fresh_repo)"
state="$(cd "$repo" && "$SCRIPTS/rfc-pipeline-claim")"
root="$(state_val "$state" CODEBASE_ROOT)"
scratch="$(state_val "$state" RUN_SCRATCH)"

echo "1" > "$root/rfc/one.md"
"$SCRIPTS/rfc-pipeline-checkpoint" -s "$scratch" impl > /dev/null
pipeline_sha="$(git -C "$root" rev-parse HEAD)"

# Build a target branch that is a linear descendant of the pipeline tip — the
# shape /manual-review-fix's integration/<run-id> branch is in.
git -C "$root" checkout -q -b adopt-target
echo "2" > "$root/rfc/two.md"
git -C "$root" add -A
git -C "$root" commit -qm "integration commit"
target_sha="$(git -C "$root" rev-parse HEAD)"
git -C "$root" checkout -q pipeline/rfc-1

assert_success "adopt fast-forwards the pipeline branch onto the target" \
  "$SCRIPTS/rfc-pipeline-adopt" -s "$scratch" adopt-target
[ "$(git -C "$root" rev-parse HEAD)" = "$target_sha" ] || fail_test "adopt did not fast-forward to the target's tip"
pass_test "adopt lands on the target branch's tip"
git -C "$root" rev-parse --verify adopt-target > /dev/null 2>&1 && fail_test "adopt left the merged branch behind"
pass_test "adopt deletes the merged branch"

# Dirty tree refuses, untouched.
git -C "$root" branch some-branch
echo "dirty" > "$root/dirty.txt"
assert_failure "adopt refuses when the pipeline worktree is dirty" \
  "$SCRIPTS/rfc-pipeline-adopt" -s "$scratch" some-branch
rm -f "$root/dirty.txt"

# Nonexistent branch refuses.
assert_failure "adopt refuses a nonexistent branch" \
  "$SCRIPTS/rfc-pipeline-adopt" -s "$scratch" no-such-branch

# A target that is BEHIND the pipeline tip (the pipeline advanced past it, or
# it names the wrong run) is not a fast-forward — refuse, touch nothing.
repo="$(fresh_repo)"
state="$(cd "$repo" && "$SCRIPTS/rfc-pipeline-claim")"
root="$(state_val "$state" CODEBASE_ROOT)"
scratch="$(state_val "$state" RUN_SCRATCH)"

echo "1" > "$root/rfc/one.md"
"$SCRIPTS/rfc-pipeline-checkpoint" -s "$scratch" impl > /dev/null
git -C "$root" branch stale-target
echo "2" > "$root/rfc/two.md"
"$SCRIPTS/rfc-pipeline-checkpoint" -s "$scratch" impl-review 1 > /dev/null

assert_failure "adopt refuses a target that is not ahead of the pipeline tip" \
  "$SCRIPTS/rfc-pipeline-adopt" -s "$scratch" stale-target
[ "$(git -C "$root" rev-parse HEAD)" = "$(git -C "$root" rev-parse pipeline/rfc-1)" ] ||
  fail_test "a failed adopt should never move HEAD"
pass_test "failed adopt leaves the pipeline branch untouched"
git -C "$root" rev-parse --verify stale-target > /dev/null 2>&1 ||
  fail_test "failed adopt deleted the target branch"
pass_test "failed adopt leaves the target branch untouched"

echo ""
echo "==== rfc-pipeline-land ===="

repo="$(fresh_repo)"
state="$(cd "$repo" && "$SCRIPTS/rfc-pipeline-claim")"
root="$(state_val "$state" CODEBASE_ROOT)"
scratch="$(state_val "$state" RUN_SCRATCH)"
orig="$(state_val "$state" ORIGINAL_CHECKOUT)"

echo "landed" > "$root/rfc/landed.md"
"$SCRIPTS/rfc-pipeline-checkpoint" -s "$scratch" impl > /dev/null
pipeline_sha="$(git -C "$root" rev-parse HEAD)"

# Seed a /manual-review-fix scratch dir so the archive step has something to
# preserve — this is the evaluation data the whole handover exists to protect.
mkdir -p "$root/.scratch/manual-review-fix/testrun-abc123"
echo '{"id":"t.1"}' > "$root/.scratch/manual-review-fix/testrun-abc123/ledger.jsonl"

assert_success "land fast-forwards main and tears down the worktree" \
  "$SCRIPTS/rfc-pipeline-land" -s "$scratch"

[ "$(git -C "$orig" rev-parse main)" = "$pipeline_sha" ] ||
  fail_test "land did not fast-forward main to the pipeline tip"
pass_test "land fast-forwards main to the pipeline tip"
[ -d "$root" ] && fail_test "land left the worktree directory behind"
pass_test "land removes the worktree"
git -C "$orig" rev-parse --verify pipeline/rfc-1 > /dev/null 2>&1 &&
  fail_test "land left the merged pipeline branch behind"
pass_test "land deletes the merged pipeline branch"

archived="$orig/.scratch/manual-review-fix-archive/rfc-1/testrun-abc123/ledger.jsonl"
[ -f "$archived" ] || fail_test "land did not archive the manual-review-fix scratch dir"
grep -q 't.1' "$archived" || fail_test "archived manual-review-fix scratch is missing its content"
pass_test "land archives /manual-review-fix's scratch dir before deleting the worktree"

# A run that never used /manual-review-fix has nothing to archive — land must
# neither fail nor fabricate an empty archive dir.
repo2="$(fresh_repo)"
state2="$(cd "$repo2" && "$SCRIPTS/rfc-pipeline-claim")"
scratch2="$(state_val "$state2" RUN_SCRATCH)"
orig2="$(state_val "$state2" ORIGINAL_CHECKOUT)"
assert_success "land succeeds with no manual-review-fix scratch to archive" \
  "$SCRIPTS/rfc-pipeline-land" -s "$scratch2"
[ -d "$orig2/.scratch/manual-review-fix-archive" ] &&
  fail_test "land fabricated an archive dir when there was nothing to archive"
pass_test "land creates no archive dir when there is nothing to archive"

echo ""
echo "==== rfc-pipeline-record ===="

repo="$(fresh_repo)"
state="$(cd "$repo" && "$SCRIPTS/rfc-pipeline-claim")"
scratch="$(state_val "$state" RUN_SCRATCH)"

assert_success "record writes a new key" \
  "$SCRIPTS/rfc-pipeline-record" -s "$scratch" RFC_NAME "Email verification"
grep -q "^RFC_NAME=" "$scratch/state" || fail_test "RFC_NAME not written to the state file"
pass_test "record persists the key in the state file"

# The state file is `source`d by pl_load_state — a value with spaces must
# survive that round-trip, and must not break the scripts that load state.
loaded="$(source "$scratch/state" && echo "$RFC_NAME")"
[ "$loaded" = "Email verification" ] || fail_test "sourced RFC_NAME mismatch: [$loaded]"
pass_test "a spaced value round-trips through source"
assert_success "scripts still load state after a spaced record (checkpoint smoke)" \
  "$SCRIPTS/rfc-pipeline-checkpoint" -s "$scratch" smoke

"$SCRIPTS/rfc-pipeline-record" -s "$scratch" RFC_NAME "Renamed title"
[ "$(grep -c '^RFC_NAME=' "$scratch/state")" -eq 1 ] || fail_test "re-record duplicated the key"
loaded="$(source "$scratch/state" && echo "$RFC_NAME")"
[ "$loaded" = "Renamed title" ] || fail_test "re-record did not replace the value: [$loaded]"
pass_test "re-recording a key replaces its value without duplication"

assert_failure "record refuses a claim-owned key" \
  "$SCRIPTS/rfc-pipeline-record" -s "$scratch" BASE_SHA deadbeef
assert_failure "record refuses a malformed (non-UPPER_SNAKE_CASE) key" \
  "$SCRIPTS/rfc-pipeline-record" -s "$scratch" rfc_name x

echo ""
echo "==== rfc-pipeline-status ===="

repo="$(fresh_repo)"
out="$(cd "$repo" && "$SCRIPTS/rfc-pipeline-status")"
grep -q "^RUNS=0$" <<< "$out" || fail_test "expected RUNS=0 with no live runs"
pass_test "status reports zero runs on a repo with no pipelines"

state="$(cd "$repo" && "$SCRIPTS/rfc-pipeline-claim")"
root="$(state_val "$state" CODEBASE_ROOT)"
scratch="$(state_val "$state" RUN_SCRATCH)"

out="$(cd "$repo" && "$SCRIPTS/rfc-pipeline-status")"
grep -q "^RUNS=1$" <<< "$out" || fail_test "expected RUNS=1 after claim"
grep -q "^RFC_NUM=1$" <<< "$out" || fail_test "status did not include the run state"
grep -q "^WORKTREE_DIRTY=false$" <<< "$out" || fail_test "fresh worktree reported dirty"
grep -q "^LAST_CHECKPOINT_STEP=NONE$" <<< "$out" || fail_test "empty ledger not reported as NONE"
grep -q "^RFC_FILE_DETECTED=NONE$" <<< "$out" || fail_test "expected no RFC file detected yet"
pass_test "status reports a fresh claim's baseline facts"

# Status runs from inside a pipeline worktree too (resolves the main checkout).
out="$(cd "$root" && "$SCRIPTS/rfc-pipeline-status")"
grep -q "^RUNS=1$" <<< "$out" || fail_test "status from inside a worktree missed the run"
pass_test "status works from inside a pipeline worktree"

echo "draft" > "$root/rfc/1-thing.md"
out="$(cd "$repo" && "$SCRIPTS/rfc-pipeline-status")"
grep -q "^RFC_FILE_DETECTED=rfc/1-thing.md$" <<< "$out" || fail_test "drafted RFC file not detected"
grep -q "^WORKTREE_DIRTY=true$" <<< "$out" || fail_test "dirty worktree not detected"
pass_test "status detects the drafted RFC file and a dirty tree"

"$SCRIPTS/rfc-pipeline-checkpoint" -s "$scratch" design-review 1 >/dev/null
out="$(cd "$repo" && "$SCRIPTS/rfc-pipeline-status")"
grep -q "^LAST_CHECKPOINT_STEP=design-review$" <<< "$out" || fail_test "last checkpoint step wrong"
grep -q "^LAST_CHECKPOINT_I=1$" <<< "$out" || fail_test "last checkpoint counter wrong"
grep -q "^LAST_CHECKPOINT_REACHABLE=true$" <<< "$out" || fail_test "live checkpoint reported unreachable"
grep -q "^COMMITS_AHEAD_OF_BASE=1$" <<< "$out" || fail_test "commits-ahead count wrong"
grep -q "^NON_CHECKPOINT_COMMITS=0$" <<< "$out" || fail_test "a checkpoint counted as non-checkpoint"
pass_test "status reports the last checkpoint and the branch's commit shape"

git -C "$root" branch "integration/$(basename "$root")-abc1234"
out="$(cd "$repo" && "$SCRIPTS/rfc-pipeline-status")"
grep -q "^INTEGRATION_BRANCHES=integration/$(basename "$root")-abc1234$" <<< "$out" ||
  fail_test "integration branch not surfaced"
pass_test "status surfaces a waiting integration branch"
git -C "$root" branch -D "integration/$(basename "$root")-abc1234" >/dev/null

"$SCRIPTS/rfc-pipeline-squash" -s "$scratch"
out="$(cd "$repo" && "$SCRIPTS/rfc-pipeline-status")"
grep -q "^HEAD_AT_BASE=true$" <<< "$out" || fail_test "post-squash HEAD_AT_BASE wrong"
grep -q "^LAST_CHECKPOINT_REACHABLE=false$" <<< "$out" ||
  fail_test "squashed-away checkpoint still reported reachable"
pass_test "status flags the post-squash shape"

git -C "$root" commit -qm "Real final commit"
out="$(cd "$repo" && "$SCRIPTS/rfc-pipeline-status")"
grep -q "^NON_CHECKPOINT_COMMITS=1$" <<< "$out" || fail_test "final commit not counted"
grep -q "^HEAD_AT_BASE=false$" <<< "$out" || fail_test "HEAD_AT_BASE stuck after the final commit"
pass_test "status counts the Architect's final (non-checkpoint) commits"

state2="$(cd "$repo" && "$SCRIPTS/rfc-pipeline-claim")"
[ "$(state_val "$state2" RFC_NUM)" = "2" ] || fail_test "second claim expected n=2"
out="$(cd "$repo" && "$SCRIPTS/rfc-pipeline-status")"
grep -q "^RUNS=2$" <<< "$out" || fail_test "expected two live runs"
out="$(cd "$repo" && "$SCRIPTS/rfc-pipeline-status" -n 1)"
grep -q "^RUNS=1$" <<< "$out" || fail_test "-n filter reported the wrong count"
grep -q "^RFC_NUM=1$" <<< "$out" || fail_test "-n 1 did not select run 1"
if grep -q "^RFC_NUM=2$" <<< "$out"; then fail_test "-n 1 leaked run 2's block"; fi
pass_test "status -n filters to a single run"

# A stale run whose recorded base commit no longer exists (history rewritten
# since the claim) must be reported, not crash the range facts.
scratch2="$(state_val "$state2" RUN_SCRATCH)"
awk -F= 'BEGIN{OFS="="} $1=="BASE_SHA"{$2="0123456789abcdef0123456789abcdef01234567"} 1' \
  "$scratch2/state" > "$scratch2/state.tmp" && mv "$scratch2/state.tmp" "$scratch2/state"
out="$(cd "$repo" && "$SCRIPTS/rfc-pipeline-status" -n 2)"
grep -q "^BASE_SHA_RESOLVES=false$" <<< "$out" || fail_test "unresolvable base SHA not flagged"
grep -q "^COMMITS_AHEAD_OF_BASE=NONE$" <<< "$out" || fail_test "range fact not NONE on a stale base"
grep -q "^NON_CHECKPOINT_COMMITS=NONE$" <<< "$out" || fail_test "range fact not NONE on a stale base"
pass_test "status flags a stale run whose base commit is gone"

end_tests
