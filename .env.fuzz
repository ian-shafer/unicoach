# Fuzz delta, the last layer of `.env -> .env.dev -> .env.fuzz` (the harness sets
# ENV_FILES=".env.dev:.env.fuzz"). It carries ONLY the keys whose values differ
# from the layers beneath it; the Postgres-cluster block, DATABASE_PASSWORD,
# APP_DOMAIN, and the required-toggle dev values (e.g. GOOGLE_AUTH_PROVIDER=stub)
# are inherited from .env.dev.

# bin/test-fuzz claims a currently-free port via bin/find-free-port at runtime
# and exports it as FUZZ_PORT, so a foreign listener on the default port (e.g. a
# running dev server) never blocks a fuzz run. Deriving PORT from FUZZ_PORT here
# — rather than pinning it — is what makes the override survive: bin/common
# re-sources this delta in every child (rest-server-up, daemon-up, …), and a
# plain PORT= would reset each child back to the default, clobbering the
# parent's export. FUZZ_PORT is read straight from the environment, so the
# claimed port flows through unchanged. Unset (an ordinary non-fuzz run that
# somehow selected this file) falls back to 8082.
PORT=${FUZZ_PORT:-8082}

# Per-worktree fuzz DB so concurrent fuzz runs across worktrees never collide.
# PROJECT_ROOT is set by bin/common before this file is sourced; the value is
# exported and flows to the JVM via db.conf's ${POSTGRES_DB}.
POSTGRES_DB=unicoach-fuzz-$(basename "$PROJECT_ROOT")

# --- Application Configuration (deltas vs .env) ---
DATABASE_USER=postgres
DATABASE_MAXIMUM_POOL_SIZE=2
# Re-derived after PORT.
SERVER_PORT=$PORT
