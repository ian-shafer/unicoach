# Production non-secret app config — the SINGLE authored source of prod's
# non-secret runtime env. Layered as `.env -> .env.prod` (NEVER .env.dev) by
# bin/gen-deployed-env (which flattens it into the deploy-env artifact shipped to
# the instance) and bin/infra-* (which exports its values as TF_VAR_*). Deploy-
# control (AWS account/region) lives in .env.deploy.prod, NOT here.
#
# This file is NOT read directly by the running services. bin/gen-deployed-env
# resolves it on the laptop into a flat deploy-env; on the instance render-env
# merges that under the SSM secrets+RDS-identity prefix into the complete
# /etc/unicoach/env that systemd and bin/common both read. It is also the dotenv
# bin/build-ios sources for the `prod` / `prod-simulator` iOS targets (APP_DOMAIN
# only). Set each value ONCE here.
#
# APP_DOMAIN (the Route53 zone / apex / session-cookie root) drives, by
# derivation:
#   infra  -> hosted_zone_name = $APP_DOMAIN, api_domain = api.$APP_DOMAIN,
#            web hosts app.$APP_DOMAIN (public-web) / admin.$APP_DOMAIN (admin-web)
#   Kotlin -> session.cookieDomain = $APP_DOMAIN,
#            email from = noreply@$APP_DOMAIN,
#            verify base = https://app.$APP_DOMAIN/verify-email
#   iOS    -> UNICOACH_BACKEND_URL = https://api.$APP_DOMAIN (build-ios deploy)
#
# These are public values, not secrets, so this file is committed. Real secrets
# never live here — they are seeded out-of-band into SSM (infra/ssm.tf).

# prod is the apex: app_domain IS its own Route53 zone (uni.coach), so
# HOSTED_ZONE_NAME is omitted and infra coalesces it to APP_DOMAIN. A
# subdomain-per-env (e.g. staging) instead sets HOSTED_ZONE_NAME=uni.coach.
# Declared before the email interpolations below so bin/common's source-time
# expansion resolves them against this value.
APP_DOMAIN=uni.coach

# Accepted Google OAuth client IDs (comma-separated token audiences). The backend
# verifies each Google ID token's `aud` is one of these (auth.google.clientIds /
# GOOGLE_CLIENT_IDS). Today: the iOS OAuth client. Add a Web client id here too
# if you adopt the serverClientID sign-in flow.
GOOGLE_CLIENT_IDS=681996899529-dmtovdf2r2ptf0mcajic3squcrkhsip6.apps.googleusercontent.com

# Bind all interfaces so the ALB reaches each service over the instance's private
# IP (the .conf loopback defaults would keep /healthz targets from turning
# healthy). These override .env.dev's 127.0.0.1 on the deploy path.
SERVER_HOST=0.0.0.0
PUBLIC_WEB_HOST=0.0.0.0
ADMIN_WEB_HOST=0.0.0.0

# Required HOCON toggles: prod values (RFC 95). Each is a required ${VAR}
# substitution with no .conf default, so a forgotten override fails the JVM at
# boot instead of silently running the dev mode.
SESSION_COOKIE_SECURE=true
ADMIN_COOKIE_SECURE=true
EMAIL_PROVIDER=ses
CHAT_PROVIDER=anthropic
GOOGLE_AUTH_PROVIDER=google
# App Store environment (RFC 110): prod verifies against the production store.
# The credential trio (APP_STORE_ISSUER_ID / KEY_ID / PRIVATE_KEY) is SSM
# out-of-band (infra/ssm.tf), never here.
APP_STORE_ENVIRONMENT=production

# Email values derived from APP_DOMAIN. bin/common sources this file under
# `set -a`, so these interpolate at source time into flat literals safe for
# systemd's expansion-free EnvironmentFile on the instance.
EMAIL_DEFAULT_FROM=noreply@$APP_DOMAIN
EMAIL_VERIFICATION_VERIFY_URL_BASE=https://app.$APP_DOMAIN/verify-email
