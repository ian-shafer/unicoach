#!/usr/bin/env bash
# ship-checkpoint — WIP checkpoint commit + ledger row. Prints the SHA.
#
# Checkpoints are throwaway: they exist so a stalled or rogue phase costs one
# unit of work rather than the run, and they are squashed away before anything
# lands. They commit with --no-verify deliberately (a full bin/test check per
# checkpoint would dominate the run's wall-clock and buys nothing for a commit
# that will not survive). The flag lives HERE, not in an agent's command string.
#
# Nothing checkpointed can reach main: ship-land refuses a tip whose tree was
# never recorded by the pre-commit hook (see references/verification.md).
set -euo pipefail

fatal() { echo "[FATAL] $*" >&2; exit 1; }

help() {
  cat << 'EOF'
ship-checkpoint -s <run-scratch> <phase> [i] [-m message]

Stages everything in the worktree and records a WIP checkpoint.
Prints the new commit SHA on stdout. A no-op tree prints the existing HEAD.
EOF
  exit "${1:-0}"
}

RUN_SCRATCH="" MSG=""
while getopts ":s:m:h" opt; do
  case "$opt" in
    s) RUN_SCRATCH="$OPTARG" ;;
    m) MSG="$OPTARG" ;;
    h) help 0 ;;
    \?) fatal "unknown option [-$OPTARG]" ;;
    :) fatal "option [-$OPTARG] requires an argument" ;;
  esac
done
shift $((OPTIND - 1))
[ -n "$RUN_SCRATCH" ] || fatal "-s <run-scratch> is required"

# CP_PHASE, not PHASE: the state file sourced below defines PHASE, and a bare
# `PHASE=` here was silently overwritten by it — every ledger row recorded the
# run's current phase instead of the checkpoint's name.
CP_PHASE="${1:-}"; [ -n "$CP_PHASE" ] || fatal "phase name is required"
shift
I=0
if [ -n "${1:-}" ] && [[ "${1}" =~ ^[0-9]+$ ]]; then I="$1"; shift; fi

# getopts stops at the first non-option, so the documented form
# `ship-checkpoint -s <rs> impl 1 -m "msg"` never reached the -m above and every
# such message was dropped. Parse what follows the positionals too.
if [ "$#" -gt 0 ]; then
  OPTIND=1
  while getopts ":m:" opt; do
    case "$opt" in
      m) MSG="$OPTARG" ;;
      \?) fatal "unknown option [-$OPTARG]" ;;
      :) fatal "option [-$OPTARG] requires an argument" ;;
    esac
  done
  shift $((OPTIND - 1))
  [ "$#" -eq 0 ] || fatal "unexpected arguments: $*"
fi

# shellcheck disable=SC1090
. "$RUN_SCRATCH/state"
[ -n "${CODEBASE_ROOT:-}" ] || fatal "state has no CODEBASE_ROOT"

cd "$CODEBASE_ROOT"
git add -A

if git diff --cached --quiet; then
  sha="$(git rev-parse HEAD)"
else
  git commit --no-verify -q -m "wip($CP_PHASE/$I): ${MSG:-checkpoint}"
  sha="$(git rev-parse HEAD)"
fi

printf '%s\t%s\t%s\t%s\n' "$sha" "$CP_PHASE" "$I" "${MSG:-checkpoint}" >> "$RUN_SCRATCH/checkpoints.log"
echo "$sha"
