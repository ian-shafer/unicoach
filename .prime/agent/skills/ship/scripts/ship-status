#!/usr/bin/env bash
# ship-status — find the live ship runs. Takes no -s, and that is the point.
#
# WHY THIS EXISTS. Compaction is silent and it takes the COORDINATOR: the one
# session holding RUN_SCRATCH in its head is the one that loses it. Every other
# script in this directory starts from `-s <run-scratch>`, so after a compaction
# there is no entry point back into the run — the state file is on disk, intact,
# and unaddressable. This script is that entry point. It asks git for the
# worktrees and the filesystem for the runs inside them, so a session that knows
# nothing but the repo can recover everything.
#
# Runs are discovered, never registered: `git worktree list --porcelain` lists
# ALL worktrees from any one of them, and each run's state lives at a fixed
# path inside its own worktree (<wt>/.scratch/ship/<run-id>/state). Nothing to
# keep in sync, and a run whose worktree is gone is a run that is gone.
set -euo pipefail

fatal() { echo "[FATAL] $*" >&2; exit 1; }

help() {
  cat << 'EOF'
ship-status [-p]

Lists every live ship run found in this repo's worktrees: run id, lane, phase,
branch, paths, HEAD, working-tree cleanliness, last ledger row, and the age of
the state file. Takes no run-scratch — a compacted session has none.

  -p   porcelain: print bare RUN_SCRATCH paths, one per line, nothing else.

Exits 1 when no runs are found.
EOF
  exit "${1:-0}"
}

PORCELAIN=0
while getopts ":ph" opt; do
  case "$opt" in
    p) PORCELAIN=1 ;;
    h) help 0 ;;
    \?) fatal "unknown option [-$OPTARG]" ;;
    :) fatal "option [-$OPTARG] requires an argument" ;;
  esac
done
shift $((OPTIND - 1))
[ "$#" -eq 0 ] || fatal "ship-status takes no positional arguments: $*"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Anchor on the script's own checkout, not the caller's cwd: this script may be
# invoked by absolute path from anywhere, and any one worktree lists them all.
git -C "$SCRIPT_DIR" rev-parse --git-dir > /dev/null 2>&1 ||
  fatal "not inside a git repository [$SCRIPT_DIR]"

worktrees="$(git -C "$SCRIPT_DIR" worktree list --porcelain | sed -n 's/^worktree //p')"

age_of() {
  local file="$1" mtime now delta
  mtime="$(date -r "$file" +%s 2>/dev/null || stat -c %Y "$file" 2>/dev/null || echo 0)"
  now="$(date +%s)"
  delta=$((now - mtime))
  if [ "$delta" -lt 60 ]; then echo "${delta}s ago"
  elif [ "$delta" -lt 3600 ]; then echo "$((delta / 60))m ago"
  elif [ "$delta" -lt 86400 ]; then echo "$((delta / 3600))h ago"
  else echo "$((delta / 86400))d ago"
  fi
}

found=0
while read -r wt; do
  [ -n "$wt" ] || continue
  for state in "$wt"/.scratch/ship/*/state; do
    [ -f "$state" ] || continue
    found=$((found + 1))

    # SUBSHELL, deliberately. The state file is sourced, so its keys would
    # otherwise persist into the NEXT run's block and print stale values for
    # any key that run happens not to set (RFC_NUM, SLUG, RECOVERED_FROM).
    (
      # shellcheck disable=SC1090
      . "$state"

      if [ "$PORCELAIN" -eq 1 ]; then
        echo "${RUN_SCRATCH:-$(dirname "$state")}"
        exit 0
      fi

      head_sha="?" dirty="?"
      if [ -n "${CODEBASE_ROOT:-}" ] && [ -d "$CODEBASE_ROOT" ]; then
        head_sha="$(git -C "$CODEBASE_ROOT" rev-parse --short HEAD 2>/dev/null || echo '?')"
        if [ -n "$(git -C "$CODEBASE_ROOT" status --porcelain 2>/dev/null)" ]; then
          dirty="dirty"
        else
          dirty="clean"
        fi
      fi

      rs="${RUN_SCRATCH:-$(dirname "$state")}"
      last_row="(no checkpoints)"
      if [ -s "$rs/checkpoints.log" ]; then
        last_row="$(tail -1 "$rs/checkpoints.log" | tr '\t' ' ')"
      fi

      echo "=== ${RUN_ID:-?}"
      echo "  LANE           ${LANE:-?}"
      echo "  PHASE          ${PHASE:-?}"
      echo "  BRANCH         ${BRANCH:-?}"
      echo "  CODEBASE_ROOT  ${CODEBASE_ROOT:-?}"
      echo "  RUN_SCRATCH    $rs"
      echo "  HEAD           $head_sha ($dirty)"
      echo "  last ledger    $last_row"
      echo "  state touched  $(age_of "$state")"
      [ -n "${RECOVERED_FROM:-}" ] && echo "  RECOVERED_FROM ${RECOVERED_FROM}"
      echo
    )
  done
done <<< "$worktrees"

if [ "$found" -eq 0 ]; then
  echo "[FATAL] no live ship runs found under this repo's worktrees" >&2
  exit 1
fi
