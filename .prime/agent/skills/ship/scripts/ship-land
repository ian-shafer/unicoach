#!/usr/bin/env bash
# ship-land — squash, assert, fast-forward, tear down.
#
# The ONLY path by which a ship run reaches the base branch. It refuses a tip
# whose tree was never recorded by bin/pre-commit (ship-verified assert), which
# is what makes the throwaway --no-verify checkpoints safe.
#
# It is also the backstop for the land lock (RFC 167): it refuses a lock held by
# another run, takes a free one itself, and releases one this run holds. Phase 6
# brackets itself with ship-lock to SAVE a gate run; ship-land does it again so
# that not doing it can never LOSE one.
set -euo pipefail

log-info() { echo "$@" >&2; }
log-error() { echo "[ERROR] $*" >&2; }
fatal() { echo "[FATAL] $*" >&2; exit 1; }

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

help() {
  cat << 'EOF'
ship-land -s <run-scratch> [-d doc-glob]...

Asserts HEAD is hook-verified (modulo doc-only commits), fast-forwards the base
branch onto the run branch from the original checkout, removes the worktree, and
deletes the merged branch. Refuses on uncommitted changes or a non-fast-forward.

Also refuses a db/schema/ORDER that is not in land order — `ship-order -n` — so
a run that skipped ship-order in phase 6 cannot land a mis-ordered manifest, and
a coach prompt seed that is not what this base plus prompts/coach-system-prompt.md
generates — `bin/prompt-seed -n`, when that script exists in the checkout.

Refuses a land lock (see ship-lock) held by another run, acquires a free one for
the fast-forward, and releases a lock it holds — including on any failure AFTER
it has taken or confirmed it. A fatal before that point (a dirty worktree) leaves
a lock phase 6 took still held, which is phase 6's to release.
EOF
  exit "${1:-0}"
}

RUN_SCRATCH=""; DOC_ARGS=()
while getopts ":s:d:h" opt; do
  case "$opt" in
    s) RUN_SCRATCH="$OPTARG" ;;
    d) DOC_ARGS+=(-d "$OPTARG") ;;
    h) help 0 ;;
    \?) fatal "unknown option [-$OPTARG]" ;;
    :) fatal "option [-$OPTARG] requires an argument" ;;
  esac
done
shift $((OPTIND - 1))
[ -n "$RUN_SCRATCH" ] || fatal "-s <run-scratch> is required"

# shellcheck disable=SC1090
. "$RUN_SCRATCH/state"

cd "$CODEBASE_ROOT"

# 1. Clean tree. A safety check, not an obstacle to force past.
git diff --quiet && git diff --cached --quiet ||
  fatal "worktree [$CODEBASE_ROOT] has uncommitted changes"

# 2. The land lock (RFC 167). BEFORE the assert, so a run that has no business
# landing is stopped before any git write. (Not "before the expensive part" —
# the expensive part is the hook, and phase 6 already paid it.)
#
# A foreign holder is a REFUSAL, not a queue: another run is inside its gate on
# a base it is about to move, so this run's hook result is already invalid and
# waiting 30m for the lock would only delay that news. A free lock is taken
# here, with a short 60s timeout — the gate is already spent by this point, so a
# long wait buys nothing — which is what makes correctness independent of phase
# 6 remembering to bracket itself. A lock this run ALREADY holds is the normal
# case: phase 6 acquired it before ship-rebase.
#
# ship-lock is invoked from SCRIPT_DIR — the ORIGINAL checkout, which outlives
# the `git worktree remove` below — never from CODEBASE_ROOT.
LOCK_HELD=0
release_lock() {
  # Only ever a lock whose op is this RUN_ID: ship-lock release refuses a
  # foreign holder, and this must not become the thing that breaks one.
  [ "$LOCK_HELD" -eq 1 ] || return 0
  LOCK_HELD=0
  "$SCRIPT_DIR/ship-lock" -s "$RUN_SCRATCH" release || true
}

LOCK_STATUS="$("$SCRIPT_DIR/ship-lock" -s "$RUN_SCRATCH" status)" ||
  fatal "could not read the land lock — ship-lock status failed"
LOCK_HOLDER="$(printf '%s\n' "$LOCK_STATUS" | sed -n 's/^lock held by \[\([^]]*\)\].*/\1/p')"
if [ -n "$LOCK_HOLDER" ] && [ "$LOCK_HOLDER" != "$RUN_ID" ]; then
  fatal "the land lock is held by [$LOCK_HOLDER] — that run is landing on a base this one was not tested against; wait for it, then rebase and re-run the gate"
fi
# Unconditionally, even when this run already holds it: ship-lock's self-held
# branch is idempotent and REFRESHES the hold to a full 15m. Phase 6 is
# acquire -> rebase -> squash -> format -> hook -> commit -> here, driven by an
# agent, so the elapsed time includes turnaround and not only the measured 440s
# gate — arriving with seconds left on the hold is reachable, and a hold that
# lapses during the assert and the fast-forward lets another run in. Acquiring
# here also removes the status-then-acquire window above.
"$SCRIPT_DIR/ship-lock" -s "$RUN_SCRATCH" -t 60s acquire
LOCK_HELD=1
# EXIT, so every fatal after this point drops the lock rather than parking it
# for 15m. The happy path releases explicitly at the fast-forward and clears
# LOCK_HELD, so this is a no-op there.
trap release_lock EXIT

# 3. The gate. Nothing lands that the hook never saw.
#
# This runs BEFORE step 3a's rebase, and the order is load-bearing: the verified
# tree is the PRE-REBASE tip's tree, and a replay does not preserve it.
"$SCRIPT_DIR/ship-verified" assert "${DOC_ARGS[@]+"${DOC_ARGS[@]}"}"

# 3a. The docs-only fast path (RFC 193).
#
# RFC 167 serialises phase 6 so two runs cannot spend the gate on the same base.
# It cannot serialise what never takes the lock, and a plain `docs:` commit on
# the base branch is exactly that — an ordinary commit from a session that is not
# in phase 6 at all. It moves the base while this run is inside its 2-4 minute
# gate, step 4 then refuses the fast-forward, and the run pays the whole gate
# again. Measured 2026-09-11: one run lost that race four times in a row, to
# three `product/**` commits. `slice` makes that commit MANDATORY after every
# landed slice, so the traffic scales with parallelism rather than with sloppiness.
#
# So: when the base advanced ONLY by commits that touch nothing but product/,
# replay this run onto it and land WITHOUT re-running the gate. This is not a
# weakened gate, it is a REPEAT exemption — declining to re-run a check whose
# result is already proven for these paths. Be precise about what is true, since
# the landed tree is this run's verified code plus their docs and was never
# hook-verified AS A WHOLE: the landed tree differs from the verified tree ONLY
# by paths under product/, which are not Gradle inputs and cannot change a test
# result; and bin/format -c, the only Markdown gate, has already passed
# independently on both halves — on the verified tree here, and on those doc
# commits' own way in.
#
# FAIL SAFE IS THE WHOLE DESIGN. Every path not POSITIVELY recognised as
# docs-only falls through to the behaviour this script had before: refuse at step
# 4, rebase, re-run the gate. When in doubt, run the gate.
#
# Note what is NOT in the predicate: rfc/**. The ship skill commits the RFC
# markdown immediately after its own code commit, so a range containing an RFC
# almost always contains code too and falls back anyway — while the day a test
# reads an RFC as a fixture, a wider predicate is silently wrong. A narrower
# predicate that is provably safe beats a wider one that needs a guard test.

# The contract is a PREFIX on the path string, not a glob. Real doc traffic is
# nested several levels deep (product/0009-say-it-once/research/_parts/x.md), and
# a single-level `product/*` glob matches product/STATUS.md while silently
# missing those — safe, but useless for the commonest case. `"$LAND_DOCS_PREFIX"?*`
# is "the literal prefix, then at least one more character", which no glob
# dialect can reinterpret.
LAND_DOCS_PREFIX="product/"

# land_classify_advance <from> <to>
#
# Fills LAND_ADVANCE_ROWS (one "<short-sha>\t<verdict>\t<subject>" per commit,
# oldest first) and LAND_ADVANCE_SHAS, and returns 0 ONLY when every commit in
# the range qualifies. EVERY commit, not the tip: a docs -> code -> docs advance
# has a docs-only tip and is not docs-only — the same shape as the stale-BASE_SHA
# trap this skill already documents, where a check on one end sleeps through
# exactly the case it exists to catch.
land_classify_advance() {
  local from="$1" to="$2"
  local list sha parents nparents paths path verdict ok=1
  LAND_ADVANCE_ROWS=()
  LAND_ADVANCE_SHAS=()

  list="$(git rev-list --reverse "$from..$to" 2> /dev/null)" || return 1
  # An empty range is not "vacuously docs-only": it means the caller asked about
  # an advance that is not there, and the caller is what decides that, not this.
  [ -n "$list" ] || return 1

  while IFS= read -r sha; do
    [ -n "$sha" ] || continue
    verdict="docs-only"

    # Exactly one parent. A merge is not a replay of somebody's docs commit and
    # a root commit has no diff to read; neither is classified.
    if parents="$(git show -s --format=%P "$sha" 2> /dev/null)"; then
      nparents="$(printf '%s\n' $parents | grep -c . || true)"
      [ "$nparents" = "1" ] || verdict="not-docs (parents: $nparents)"
    else
      # Said explicitly rather than left to the no-paths test below: a commit git
      # cannot read is a different state from a commit that changed nothing, and
      # a verdict line is the only place anybody will ever see which it was.
      verdict="not-docs (unreadable)"
    fi

    if [ "$verdict" = "docs-only" ]; then
      # core.quotePath=false so a real product path with an accent in it
      # (product/café.md) arrives as itself rather than as "product/caf\303\251.md",
      # which begins with a quote and would fail the prefix test — fail-safe, but
      # failing safe on exactly the traffic this path exists for is a dead
      # feature. A path containing a newline or a control character is STILL
      # quoted by git, still fails the prefix test, and still falls back.
      paths="$(git -c core.quotePath=false diff-tree --no-commit-id --name-only -r "$sha" 2> /dev/null)" || paths=""
      # A commit that changes NO path satisfies "every path is under product/"
      # vacuously. An empty set passing a universal test is the classic silent
      # pass, so it is refused explicitly rather than left to the loop below.
      if [ -z "$paths" ]; then
        verdict="not-docs (no paths)"
      else
        # IFS= : without it `read` strips leading and trailing whitespace, so a
        # path in a directory literally named " product" arrives as
        # "product/x.txt" and is classified docs-only. Demonstrated, not
        # theorised — it skipped the gate and landed.
        while IFS= read -r path; do
          [ -n "$path" ] || continue
          case "$path" in
            "$LAND_DOCS_PREFIX"?*) ;;
            *)
              verdict="not-docs ($path)"
              break
              ;;
          esac
        done <<< "$paths"
      fi
    fi

    [ "$verdict" = "docs-only" ] || ok=0
    LAND_ADVANCE_ROWS+=("$(git rev-parse --short "$sha")	$verdict	$(git show -s --format=%s "$sha" 2> /dev/null || echo '?')")
    LAND_ADVANCE_SHAS+=("$(git rev-parse --short "$sha")")
  done <<< "$list"

  [ "$ok" -eq 1 ]
}

# A land that skipped the gate and a land that ran it must be distinguishable
# afterwards — the same argument RFC 183 makes for its withholding counters. So
# EVERY invocation that reaches this step records a verdict, and the archived run
# scratch carries the classification that produced it.
#
# The state file is SOURCED by every ship script, so both values are single
# tokens with no spaces: `KEY=two words` would execute `words` on the next load.
# The prose belongs in the note file, which nobody sources.
land_record_fast_path() { # land_record_fast_path <verdict> <headline>
  local verdict="$1" headline="$2" note="$RUN_SCRATCH/land-fast-path.md" shas="" row
  local report="$RUN_SCRATCH/report.md"

  if [ "${#LAND_ADVANCE_SHAS[@]}" -gt 0 ]; then
    shas="$(printf '%s,' "${LAND_ADVANCE_SHAS[@]}")"
    shas="${shas%,}"
  fi
  "$SCRIPT_DIR/ship-state" -s "$RUN_SCRATCH" set LAND_FAST_PATH "$verdict"
  "$SCRIPT_DIR/ship-state" -s "$RUN_SCRATCH" set LAND_FAST_PATH_COMMITS "${shas:-none}"

  {
    echo "## Land fast path (RFC 193): $verdict"
    echo
    echo "$headline"
    echo
    if [ "${#LAND_ADVANCE_ROWS[@]}" -gt 0 ]; then
      echo '```'
      for row in "${LAND_ADVANCE_ROWS[@]+"${LAND_ADVANCE_ROWS[@]}"}"; do echo "$row"; done
      echo '```'
    else
      echo "The base branch did not advance while this run held the gate."
    fi
  } > "$note"
  # Phase 7 writes report.md BEFORE ship-land runs, so it cannot have predicted
  # this outcome: append rather than expect.
  [ -f "$report" ] || return 0
  {
    echo
    cat "$note"
  } >> "$report"
}

LAND_ADVANCE_ROWS=()
LAND_ADVANCE_SHAS=()
BASE_TIP="$(git -C "$ORIGINAL_CHECKOUT" rev-parse "$BASE_BRANCH" 2> /dev/null)" || BASE_TIP=""
if [ -z "$BASE_TIP" ]; then
  log-info "[fast path] could not read [$BASE_BRANCH] in [$ORIGINAL_CHECKOUT] — taking the normal path"
  land_record_fast_path none "The base branch tip could not be read, so no advance was classified."
elif git merge-base --is-ancestor "$BASE_TIP" HEAD; then
  land_record_fast_path none "The base branch did not advance; the gate was not re-run because it did not need to be."
elif land_classify_advance HEAD "$BASE_TIP"; then
  log-info "[fast path] [$BASE_BRANCH] advanced by ${#LAND_ADVANCE_SHAS[@]} commit(s), every one of them under [$LAND_DOCS_PREFIX]:"
  for _row in "${LAND_ADVANCE_ROWS[@]+"${LAND_ADVANCE_ROWS[@]}"}"; do log-info "          $_row"; done
  # Rebase onto the tip that was CLASSIFIED, not onto whatever the base branch
  # says now. ship-rebase resolves the tip itself, and this traffic takes no
  # lock, so between the classification and the replay the branch can gain a
  # commit nobody looked at — landing on it is precisely the hole this step
  # closes. Hence plain git here, and the state written by hand below.
  LAND_PRE_FAST_PATH_HEAD="$(git rev-parse HEAD)"
  # A worktree already mid-surgery is NOT this step's to touch. ship-rebase
  # refuses one for its own reasons; here the stake is higher, because the
  # failure branch below aborts — and aborting an operator's paused rebase,
  # while reporting it as a conflict of our own, destroys work the old code
  # would have left untouched while refusing cleanly at step 4.
  LAND_REBASE_BUSY=0
  for _op in rebase-merge rebase-apply MERGE_HEAD; do
    [ -e "$(git rev-parse --git-path "$_op")" ] && LAND_REBASE_BUSY=1
  done
  LAND_REBASE_ERR="$RUN_SCRATCH/land-fast-path-rebase.err"
  if [ "$LAND_REBASE_BUSY" -eq 1 ]; then
    log-info "[fast path] not taken: an operation is already in progress in [$CODEBASE_ROOT] — finish or abort it, then re-run ship-land"
    land_record_fast_path none "A docs-only advance was found, but a rebase or merge was already in progress in the worktree, so nothing was replayed."
  elif git rebase "$BASE_TIP" > /dev/null 2> "$LAND_REBASE_ERR"; then
    "$SCRIPT_DIR/ship-state" -s "$RUN_SCRATCH" set BASE_SHA "$BASE_TIP"
    "$SCRIPT_DIR/ship-state" -s "$RUN_SCRATCH" set PRE_REBASE_HEAD "$LAND_PRE_FAST_PATH_HEAD"
    BASE_SHA="$BASE_TIP"
    # Rotate the ledger exactly as ship-rebase does, and for its reason: every
    # pre-rebase checkpoint now names abandoned history, so ship-recover's
    # "target must be an ancestor of HEAD" invariant would be a lie if this run
    # stops at step 4 and a later session tries to recover.
    LAND_LEDGER="$RUN_SCRATCH/checkpoints.log"
    if [ -f "$LAND_LEDGER" ]; then
      _n=1
      while [ -e "$LAND_LEDGER.pre-rebase-$_n" ]; do _n=$((_n + 1)); done
      mv "$LAND_LEDGER" "$LAND_LEDGER.pre-rebase-$_n"
    fi
    printf '%s\t%s\t%s\t%s\n' "$(git rev-parse HEAD)" "land-fast-path" "0" "rebased onto $BASE_TIP (docs-only advance)" > "$RUN_SCRATCH/checkpoints.log"
    land_record_fast_path docs-only "Replayed onto [$BASE_TIP] WITHOUT re-running bin/pre-commit: the landed tree differs from the hook-verified tree only by paths under [$LAND_DOCS_PREFIX], which are not Gradle inputs, and bin/format -c has already passed on both halves."
    log-info "[fast path] replayed onto $BASE_TIP without re-running the gate (RFC 193)"
  else
    # Abort, do not leave the rebase in progress. The worktree goes back
    # byte-for-byte and the run takes the path it would have taken before this
    # step existed. A conflict between this run and a product/** commit is two
    # sessions disagreeing about the same file — a human's to read, not this
    # script's to resolve mechanically inside the one path that reaches the base
    # branch.
    # Abort only a rebase THIS step started: the guard above proved there was
    # none before, so anything in progress now is ours. A failure that started
    # nothing (a refused rebase, a hook, a signing prompt) leaves no state to
    # abort, and calling --abort on it would be the same overreach the guard
    # exists to prevent.
    for _op in rebase-merge rebase-apply; do
      if [ -e "$(git rev-parse --git-path "$_op")" ]; then
        git rebase --abort > /dev/null 2>&1 || true
        break
      fi
    done
    # git's own words, or the operator is told "CONFLICTED" about a failure that
    # was nothing of the kind — a dirty index, a hook, a signing failure.
    log-info "[fast path] the docs-only replay FAILED and was aborted — this run rebases and re-runs the gate as usual. git said:"
    [ -s "$LAND_REBASE_ERR" ] && sed 's/^/          /' "$LAND_REBASE_ERR" >&2
    land_record_fast_path none "A docs-only advance was found, but replaying this run onto it failed (usually a conflict); the rebase was aborted and the gate was not skipped."
  fi
elif [ "${#LAND_ADVANCE_ROWS[@]}" -eq 0 ]; then
  # An empty table means the classification itself failed — git could not walk
  # the range. Naming "commits outside product/" here would report a cause that
  # may not exist, for an advance nobody managed to read.
  log-info "[fast path] not taken: the advance from HEAD to [$BASE_TIP] could not be classified — the gate must be re-run on the moved base"
  land_record_fast_path none "The advance could not be classified (git could not walk the range), so this run re-runs the gate."
else
  log-info "[fast path] not taken: [$BASE_BRANCH] advanced by commits outside [$LAND_DOCS_PREFIX] — the gate must be re-run on the moved base:"
  for _row in "${LAND_ADVANCE_ROWS[@]+"${LAND_ADVANCE_ROWS[@]}"}"; do log-info "          $_row"; done
  land_record_fast_path none "The advance contains at least one commit that is not docs-only, so this run re-runs the gate."
fi

# 3b. db/schema/ORDER is in land order (RFC 180). Phase 6 calling ship-order is
# prose, and a run that skipped it lands CLEANLY — its ORDER line exists, only
# its POSITION is wrong, which is precisely the silent mis-ordering RFC 180
# exists to remove. So the check is here, in the only path to the base branch.
#
# `-n` writes nothing: SHIP_ORDER_WOULD_CHANGE means ORDER would change, and
# any other non-zero is ship-order's own refusal (a deleted line, a duplicate,
# an unordered *.sql, an illegal line), already reported on stderr. Either way
# this run does not land.
#
# ship-order's status is PASSED THROUGH rather than collapsed into fatal's flat
# 1, so a scripted caller can tell "ORDER is stale, re-run ship-order" from
# "ORDER is corrupt" and from a dirty worktree. Both exits below run under the
# EXIT trap installed in step 2, so they release the land lock exactly as every
# other post-acquire refusal does.
#
# Copied from ship-order WITH THE SAME VALUE rather than sourced — the same
# note ship-lock carries about bin/functions' reserved band. ship-order spells
# it EXIT_ORDER_WOULD_CHANGE, because there the 3 is that script's OWN exit
# code; here it names a foreign script's, so the name carries the owner. One
# value now serves BOTH land gates below, because both read it the same way.
LAND_GATE_WOULD_CHANGE=3

# ONE land gate, run twice. Step 3c was step 3b with the names swapped — the
# same eleven lines, the same status-passing rule implemented twice and
# explained twice — and a third gate would have been a third copy.
#
# The rule: run <tool>, and let ITS status decide. LAND_GATE_WOULD_CHANGE means
# "regenerate and re-commit"; anything else non-zero is the tool's own refusal.
# Either way this run does not land. The status is PASSED THROUGH rather than
# collapsed into fatal's flat 1, so a scripted caller can tell "stale, re-run
# the generator" from "the corpus is corrupt" and from a dirty worktree. Both
# exits run under the EXIT trap installed in step 2, so they release the land
# lock exactly as every other post-acquire refusal does.
#
# ONE [FATAL] header per cause: the tool has already printed its own, naming the
# file and the exact remedy, and a second header here would report one event as
# two faults. So this states what happens NEXT and nothing else — through
# log-error, because the one message that STOPS a land must carry a severity
# marker a log scan can find, and a second [FATAL] is what we are avoiding, not
# a severity. <remedy> stays on log-info and unbracketed on purpose: brackets
# corrupt a command meant to be pasted, and an [ERROR] prefix does too.
run_land_gate() { # run_land_gate <tool label> <remedy command> <command> [args...]
  local label="$1" remedy="$2"
  shift 2
  local status=0
  "$@" || status=$?
  if [ "$status" -eq "$LAND_GATE_WOULD_CHANGE" ]; then
    log-error "This run does not land. Re-run the generator, re-commit through the hook, and re-run ship-land:"
    log-info "          $remedy"
    exit "$status"
  elif [ "$status" -ne 0 ]; then
    log-error "[$label] refused this run's corpus (status [$status], reported above). This run does not land: fix it, re-commit through the hook, and re-run ship-land."
    exit "$status"
  fi
}

run_land_gate "ship-order" "scripts/ship-order -s $RUN_SCRATCH" \
  "$SCRIPT_DIR/ship-order" -s "$RUN_SCRATCH" -n

# 3c. The coach prompt seed is generated, not written (RFC 181), and the same
# argument as 3b applies with one difference that makes it worse: a run that
# skipped bin/prompt-seed lands a seed whose CONTENT is fine and whose VERSION
# LABEL belongs to a base that has moved. Nothing downstream notices — the file
# exists, ORDER names it — until db-migrate meets two rows claiming one version,
# or the pin resolves to a body nobody authored. `-n` recomputes from $BASE_SHA,
# which is the tree this run is actually landing on, and writes nothing.
#
# GUARDED on the script being PRESENT, deliberately: these scripts are copied
# into checkouts that predate RFC 181, and a land that failed because a repo has
# no bin/prompt-seed would be this check inventing a requirement.
#
# Presence and executability are asked SEPARATELY. A single `[ -x ]` conflates
# "this checkout predates RFC 181" with "the file is right there and lost its
# exec bit" — and answers the second with the first, so a `chmod -x`, a bad
# archive extraction or a copy through a filesystem with no permission bits
# DELETES the land gate and every other check stays green. The two states have
# nothing in common: one is a checkout that never had the gate, the other is a
# checkout whose gate is broken, and only the second is worth stopping for.
#
# The path is built from $CODEBASE_ROOT and NOT from $SCRIPT_DIR: bin/prompt-seed
# lives in the repository being landed, not beside these scripts. It is also run
# WITHOUT the Nix dev shell, because ship-land itself has none — which is why
# bin/prompt-seed is written to parse and run under macOS system bash 3.2, and
# why bin/prompt-seed-scripts-tests asserts exactly that.
#
# Presence is probed with `-e` OR `-L`, not `-e` alone: `-e` FOLLOWS the link, so
# a DANGLING symlink answers "absent" and takes the "this checkout predates RFC
# 181" branch — which is precisely the conflation the paragraph above refuses,
# reintroduced by the test that implements it. `-L` sees the link itself, and
# `-f` then separates "present but not a runnable file" (a broken link, a
# directory) from "never had the gate".
PROMPT_SEED="$CODEBASE_ROOT/bin/prompt-seed"
if [ -e "$PROMPT_SEED" ] || [ -L "$PROMPT_SEED" ]; then
  [ -f "$PROMPT_SEED" ] ||
    fatal "[$PROMPT_SEED] exists but is not a regular file (a dangling symlink, or a directory), so the coach prompt seed gate cannot run. Restore it and re-run ship-land; do not land around it."
  [ -x "$PROMPT_SEED" ] ||
    fatal "[$PROMPT_SEED] exists but is not executable, so the coach prompt seed gate cannot run. Restore the mode (chmod +x) and re-run ship-land; do not land around it."
  run_land_gate "bin/prompt-seed" "nix develop -c bin/prompt-seed -b $BASE_SHA" \
    "$PROMPT_SEED" -b "$BASE_SHA" -d "$CODEBASE_ROOT/db/schema" -n
fi

TIP="$(git rev-parse HEAD)"

# 4. Fast-forward the base branch from the original checkout.
cd "$ORIGINAL_CHECKOUT"
git merge-base --is-ancestor "$BASE_BRANCH" "$BRANCH" ||
  fatal "[$BASE_BRANCH] advanced past this run's base — rebase [$BRANCH] and retry"

current="$(git rev-parse --abbrev-ref HEAD)"
[ "$current" = "$BASE_BRANCH" ] ||
  fatal "original checkout is on [$current], expected [$BASE_BRANCH]"

git merge --ff-only "$BRANCH"

landed="$(git rev-parse "$BASE_BRANCH")"
[ "$landed" = "$TIP" ] || fatal "post-land verify failed: [$BASE_BRANCH] is $landed, expected $TIP"

# The critical section ends at the fast-forward: everything below is this run's
# own teardown and moves nothing another run reads. Released HERE, not in the
# trap, because the run scratch ship-lock reads lives INSIDE the worktree that
# step 6 removes.
release_lock

# 5. Archive the run scratch out of the worktree before it is removed.
archive="$ORIGINAL_CHECKOUT/.scratch/ship-archive/$RUN_ID"
mkdir -p "$(dirname "$archive")"
rm -rf "$archive"
cp -R "$RUN_SCRATCH" "$archive"

# 6. Tear down.
#
# The worktree's own simulator device first, while the worktree still exists to
# name it. Per-checkout devices (RFC 126) are machine-global CoreSimulator
# objects, so `git worktree remove` alone orphans one per run — and nothing ever
# reaps it, because the checkout it was named for is what identified it.
#
# Both names are tried because this one runs against the RUN'S worktree, not the
# original checkout: a branch cut before the bin/ios-sim → bin/ios-device rename
# still carries the old name, and its device is just as real. ship-claim needs
# no such fallback — it sweeps from the original checkout, which is current.
#
# Best-effort by design, and never a reason to fail a land: the run's work is
# already on the base branch by this point. It no-ops when the branch predates
# the script entirely, when the run never created a device, and when ship-land
# is itself invoked inside the Nix dev shell (it refuses there, by design).
# Anything this misses is swept by `bin/ios-device -G -f` at the next ship-claim.
for _ios_device in "$CODEBASE_ROOT/bin/ios-device" "$CODEBASE_ROOT/bin/ios-sim"; do
  if [ -x "$_ios_device" ]; then
    "$_ios_device" -D simulator > /dev/null 2>&1 || true
    break
  fi
done

git worktree remove "$CODEBASE_ROOT"
git branch -d "$BRANCH"

log-info "Landed [$RUN_ID] onto [$BASE_BRANCH] at $TIP"
log-info "Run artifacts archived at $archive"
echo "$TIP"
