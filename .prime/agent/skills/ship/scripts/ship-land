#!/usr/bin/env bash
# ship-land — squash, assert, fast-forward, tear down.
#
# The ONLY path by which a ship run reaches the base branch. It refuses a tip
# whose tree was never recorded by bin/pre-commit (ship-verified assert), which
# is what makes the throwaway --no-verify checkpoints safe.
#
# It is also the backstop for the land lock (RFC 167): it refuses a lock held by
# another run, takes a free one itself, and releases one this run holds. Phase 6
# brackets itself with ship-lock to SAVE a gate run; ship-land does it again so
# that not doing it can never LOSE one.
set -euo pipefail

log-info() { echo "$@" >&2; }
log-error() { echo "[ERROR] $*" >&2; }
fatal() { echo "[FATAL] $*" >&2; exit 1; }

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

help() {
  cat << 'EOF'
ship-land -s <run-scratch> [-d doc-glob]...

Asserts HEAD is hook-verified (modulo doc-only commits), fast-forwards the base
branch onto the run branch from the original checkout, removes the worktree, and
deletes the merged branch. Refuses on uncommitted changes or a non-fast-forward.

Also refuses a db/schema/ORDER that is not in land order — `ship-order -n` — so
a run that skipped ship-order in phase 6 cannot land a mis-ordered manifest, and
a coach prompt seed that is not what this base plus prompts/coach-system-prompt.md
generates — `bin/prompt-seed -n`, when that script exists in the checkout.

Refuses a land lock (see ship-lock) held by another run, acquires a free one for
the fast-forward, and releases a lock it holds — including on any failure AFTER
it has taken or confirmed it. A fatal before that point (a dirty worktree) leaves
a lock phase 6 took still held, which is phase 6's to release.
EOF
  exit "${1:-0}"
}

RUN_SCRATCH=""; DOC_ARGS=()
while getopts ":s:d:h" opt; do
  case "$opt" in
    s) RUN_SCRATCH="$OPTARG" ;;
    d) DOC_ARGS+=(-d "$OPTARG") ;;
    h) help 0 ;;
    \?) fatal "unknown option [-$OPTARG]" ;;
    :) fatal "option [-$OPTARG] requires an argument" ;;
  esac
done
shift $((OPTIND - 1))
[ -n "$RUN_SCRATCH" ] || fatal "-s <run-scratch> is required"

# shellcheck disable=SC1090
. "$RUN_SCRATCH/state"

cd "$CODEBASE_ROOT"

# 1. Clean tree. A safety check, not an obstacle to force past.
git diff --quiet && git diff --cached --quiet ||
  fatal "worktree [$CODEBASE_ROOT] has uncommitted changes"

# 2. The land lock (RFC 167). BEFORE the assert, so a run that has no business
# landing is stopped before any git write. (Not "before the expensive part" —
# the expensive part is the hook, and phase 6 already paid it.)
#
# A foreign holder is a REFUSAL, not a queue: another run is inside its gate on
# a base it is about to move, so this run's hook result is already invalid and
# waiting 30m for the lock would only delay that news. A free lock is taken
# here, with a short 60s timeout — the gate is already spent by this point, so a
# long wait buys nothing — which is what makes correctness independent of phase
# 6 remembering to bracket itself. A lock this run ALREADY holds is the normal
# case: phase 6 acquired it before ship-rebase.
#
# ship-lock is invoked from SCRIPT_DIR — the ORIGINAL checkout, which outlives
# the `git worktree remove` below — never from CODEBASE_ROOT.
LOCK_HELD=0
release_lock() {
  # Only ever a lock whose op is this RUN_ID: ship-lock release refuses a
  # foreign holder, and this must not become the thing that breaks one.
  [ "$LOCK_HELD" -eq 1 ] || return 0
  LOCK_HELD=0
  "$SCRIPT_DIR/ship-lock" -s "$RUN_SCRATCH" release || true
}

LOCK_STATUS="$("$SCRIPT_DIR/ship-lock" -s "$RUN_SCRATCH" status)" ||
  fatal "could not read the land lock — ship-lock status failed"
LOCK_HOLDER="$(printf '%s\n' "$LOCK_STATUS" | sed -n 's/^lock held by \[\([^]]*\)\].*/\1/p')"
if [ -n "$LOCK_HOLDER" ] && [ "$LOCK_HOLDER" != "$RUN_ID" ]; then
  fatal "the land lock is held by [$LOCK_HOLDER] — that run is landing on a base this one was not tested against; wait for it, then rebase and re-run the gate"
fi
# Unconditionally, even when this run already holds it: ship-lock's self-held
# branch is idempotent and REFRESHES the hold to a full 15m. Phase 6 is
# acquire -> rebase -> squash -> format -> hook -> commit -> here, driven by an
# agent, so the elapsed time includes turnaround and not only the measured 440s
# gate — arriving with seconds left on the hold is reachable, and a hold that
# lapses during the assert and the fast-forward lets another run in. Acquiring
# here also removes the status-then-acquire window above.
"$SCRIPT_DIR/ship-lock" -s "$RUN_SCRATCH" -t 60s acquire
LOCK_HELD=1
# EXIT, so every fatal after this point drops the lock rather than parking it
# for 15m. The happy path releases explicitly at the fast-forward and clears
# LOCK_HELD, so this is a no-op there.
trap release_lock EXIT

# 3. The gate. Nothing lands that the hook never saw.
"$SCRIPT_DIR/ship-verified" assert "${DOC_ARGS[@]+"${DOC_ARGS[@]}"}"

# 3b. db/schema/ORDER is in land order (RFC 180). Phase 6 calling ship-order is
# prose, and a run that skipped it lands CLEANLY — its ORDER line exists, only
# its POSITION is wrong, which is precisely the silent mis-ordering RFC 180
# exists to remove. So the check is here, in the only path to the base branch.
#
# `-n` writes nothing: SHIP_ORDER_WOULD_CHANGE means ORDER would change, and
# any other non-zero is ship-order's own refusal (a deleted line, a duplicate,
# an unordered *.sql, an illegal line), already reported on stderr. Either way
# this run does not land.
#
# ship-order's status is PASSED THROUGH rather than collapsed into fatal's flat
# 1, so a scripted caller can tell "ORDER is stale, re-run ship-order" from
# "ORDER is corrupt" and from a dirty worktree. Both exits below run under the
# EXIT trap installed in step 2, so they release the land lock exactly as every
# other post-acquire refusal does.
#
# Copied from ship-order WITH THE SAME VALUE rather than sourced — the same
# note ship-lock carries about bin/functions' reserved band. ship-order spells
# it EXIT_ORDER_WOULD_CHANGE, because there the 3 is that script's OWN exit
# code; here it names a foreign script's, so the name carries the owner. One
# value now serves BOTH land gates below, because both read it the same way.
LAND_GATE_WOULD_CHANGE=3

# ONE land gate, run twice. Step 3c was step 3b with the names swapped — the
# same eleven lines, the same status-passing rule implemented twice and
# explained twice — and a third gate would have been a third copy.
#
# The rule: run <tool>, and let ITS status decide. LAND_GATE_WOULD_CHANGE means
# "regenerate and re-commit"; anything else non-zero is the tool's own refusal.
# Either way this run does not land. The status is PASSED THROUGH rather than
# collapsed into fatal's flat 1, so a scripted caller can tell "stale, re-run
# the generator" from "the corpus is corrupt" and from a dirty worktree. Both
# exits run under the EXIT trap installed in step 2, so they release the land
# lock exactly as every other post-acquire refusal does.
#
# ONE [FATAL] header per cause: the tool has already printed its own, naming the
# file and the exact remedy, and a second header here would report one event as
# two faults. So this states what happens NEXT and nothing else — through
# log-error, because the one message that STOPS a land must carry a severity
# marker a log scan can find, and a second [FATAL] is what we are avoiding, not
# a severity. <remedy> stays on log-info and unbracketed on purpose: brackets
# corrupt a command meant to be pasted, and an [ERROR] prefix does too.
run_land_gate() { # run_land_gate <tool label> <remedy command> <command> [args...]
  local label="$1" remedy="$2"
  shift 2
  local status=0
  "$@" || status=$?
  if [ "$status" -eq "$LAND_GATE_WOULD_CHANGE" ]; then
    log-error "This run does not land. Re-run the generator, re-commit through the hook, and re-run ship-land:"
    log-info "          $remedy"
    exit "$status"
  elif [ "$status" -ne 0 ]; then
    log-error "[$label] refused this run's corpus (status [$status], reported above). This run does not land: fix it, re-commit through the hook, and re-run ship-land."
    exit "$status"
  fi
}

run_land_gate "ship-order" "scripts/ship-order -s $RUN_SCRATCH" \
  "$SCRIPT_DIR/ship-order" -s "$RUN_SCRATCH" -n

# 3c. The coach prompt seed is generated, not written (RFC 181), and the same
# argument as 3b applies with one difference that makes it worse: a run that
# skipped bin/prompt-seed lands a seed whose CONTENT is fine and whose VERSION
# LABEL belongs to a base that has moved. Nothing downstream notices — the file
# exists, ORDER names it — until db-migrate meets two rows claiming one version,
# or the pin resolves to a body nobody authored. `-n` recomputes from $BASE_SHA,
# which is the tree this run is actually landing on, and writes nothing.
#
# GUARDED on the script being PRESENT, deliberately: these scripts are copied
# into checkouts that predate RFC 181, and a land that failed because a repo has
# no bin/prompt-seed would be this check inventing a requirement.
#
# Presence and executability are asked SEPARATELY. A single `[ -x ]` conflates
# "this checkout predates RFC 181" with "the file is right there and lost its
# exec bit" — and answers the second with the first, so a `chmod -x`, a bad
# archive extraction or a copy through a filesystem with no permission bits
# DELETES the land gate and every other check stays green. The two states have
# nothing in common: one is a checkout that never had the gate, the other is a
# checkout whose gate is broken, and only the second is worth stopping for.
#
# The path is built from $CODEBASE_ROOT and NOT from $SCRIPT_DIR: bin/prompt-seed
# lives in the repository being landed, not beside these scripts. It is also run
# WITHOUT the Nix dev shell, because ship-land itself has none — which is why
# bin/prompt-seed is written to parse and run under macOS system bash 3.2, and
# why bin/prompt-seed-scripts-tests asserts exactly that.
#
# Presence is probed with `-e` OR `-L`, not `-e` alone: `-e` FOLLOWS the link, so
# a DANGLING symlink answers "absent" and takes the "this checkout predates RFC
# 181" branch — which is precisely the conflation the paragraph above refuses,
# reintroduced by the test that implements it. `-L` sees the link itself, and
# `-f` then separates "present but not a runnable file" (a broken link, a
# directory) from "never had the gate".
PROMPT_SEED="$CODEBASE_ROOT/bin/prompt-seed"
if [ -e "$PROMPT_SEED" ] || [ -L "$PROMPT_SEED" ]; then
  [ -f "$PROMPT_SEED" ] ||
    fatal "[$PROMPT_SEED] exists but is not a regular file (a dangling symlink, or a directory), so the coach prompt seed gate cannot run. Restore it and re-run ship-land; do not land around it."
  [ -x "$PROMPT_SEED" ] ||
    fatal "[$PROMPT_SEED] exists but is not executable, so the coach prompt seed gate cannot run. Restore the mode (chmod +x) and re-run ship-land; do not land around it."
  run_land_gate "bin/prompt-seed" "nix develop -c bin/prompt-seed -b $BASE_SHA" \
    "$PROMPT_SEED" -b "$BASE_SHA" -d "$CODEBASE_ROOT/db/schema" -n
fi

TIP="$(git rev-parse HEAD)"

# 4. Fast-forward the base branch from the original checkout.
cd "$ORIGINAL_CHECKOUT"
git merge-base --is-ancestor "$BASE_BRANCH" "$BRANCH" ||
  fatal "[$BASE_BRANCH] advanced past this run's base — rebase [$BRANCH] and retry"

current="$(git rev-parse --abbrev-ref HEAD)"
[ "$current" = "$BASE_BRANCH" ] ||
  fatal "original checkout is on [$current], expected [$BASE_BRANCH]"

git merge --ff-only "$BRANCH"

landed="$(git rev-parse "$BASE_BRANCH")"
[ "$landed" = "$TIP" ] || fatal "post-land verify failed: [$BASE_BRANCH] is $landed, expected $TIP"

# The critical section ends at the fast-forward: everything below is this run's
# own teardown and moves nothing another run reads. Released HERE, not in the
# trap, because the run scratch ship-lock reads lives INSIDE the worktree that
# step 6 removes.
release_lock

# 5. Archive the run scratch out of the worktree before it is removed.
archive="$ORIGINAL_CHECKOUT/.scratch/ship-archive/$RUN_ID"
mkdir -p "$(dirname "$archive")"
rm -rf "$archive"
cp -R "$RUN_SCRATCH" "$archive"

# 6. Tear down.
#
# The worktree's own simulator device first, while the worktree still exists to
# name it. Per-checkout devices (RFC 126) are machine-global CoreSimulator
# objects, so `git worktree remove` alone orphans one per run — and nothing ever
# reaps it, because the checkout it was named for is what identified it.
#
# Both names are tried because this one runs against the RUN'S worktree, not the
# original checkout: a branch cut before the bin/ios-sim → bin/ios-device rename
# still carries the old name, and its device is just as real. ship-claim needs
# no such fallback — it sweeps from the original checkout, which is current.
#
# Best-effort by design, and never a reason to fail a land: the run's work is
# already on the base branch by this point. It no-ops when the branch predates
# the script entirely, when the run never created a device, and when ship-land
# is itself invoked inside the Nix dev shell (it refuses there, by design).
# Anything this misses is swept by `bin/ios-device -G -f` at the next ship-claim.
for _ios_device in "$CODEBASE_ROOT/bin/ios-device" "$CODEBASE_ROOT/bin/ios-sim"; do
  if [ -x "$_ios_device" ]; then
    "$_ios_device" -D simulator > /dev/null 2>&1 || true
    break
  fi
done

git worktree remove "$CODEBASE_ROOT"
git branch -d "$BRANCH"

log-info "Landed [$RUN_ID] onto [$BASE_BRANCH] at $TIP"
log-info "Run artifacts archived at $archive"
echo "$TIP"
