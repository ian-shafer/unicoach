#!/usr/bin/env bash
# ship-lens — the per-lens dispatch ledger for a /ship review (RFC 234).
#
# WHY THIS EXISTS. The lens plan used to be written AFTER the review, from
# memory, as a document. Across the archive that is why plans claim a lens ran
# where no report exists, and why the plan files themselves spread across many
# filename spellings; RFC 234 carries the counts, and they are not copied here,
# because a figure restated in a file edited this often goes stale silently.
# Nothing was lying; the coordinator was reconstructing. So the plan
# stops being a document: <run-scratch>/findings/lens-ledger.tsv is append-only,
# one tab-separated record per line, and every line is written by the act it
# records — `start` at the moment the child is SPAWNED, before it does any work.
# After that, "claimed, and no report on disk" can only mean the child really
# failed, which is a fact worth acting on rather than a claim to distrust.
#
# WHAT `missing` DOES NOT DO. It never opens a report's CONTENTS. No grade-line
# check, no counting of tagged headings, no validation of the outcome records
# AGAINST THE FINDINGS — the phrase matters, because a record checked against
# its own declared shape is a different thing and RFC 234 does not forbid it: a
# bash script matching `###` in LLM-written Markdown is a heuristic dressed as a
# specification, and it would fail a tier over a `###` inside a fenced block.
# RFC 233 already makes a malformed report the coordinator's job. This script
# compares NAMES to FILENAMES — existence and non-emptiness only — and that is
# all it does.
#
# ONE RECORD PER LINE IS THE FILE'S ONLY STRUCTURAL PROMISE, which is why a
# field carrying a tab or a newline is refused at append time rather than
# written and parsed back wrongly later.
#
# THE HONEST LIMIT. A coordinator that appends one `start` line per lens while
# dispatching a single child for five of them defeats the child-id check,
# exactly as `--no-verify` defeats the pre-commit hook. The old failure becomes
# impossible by DEFAULT, not impossible.
set -euo pipefail

# The diagnostic band, copied from bin/functions WITH THE SAME WORDING rather
# than sourced — see the note on the exit codes below. ALL logging goes to
# stderr; stdout carries only what the caller asked for, which here is the fault
# lines of `missing` and the help text.
log-info() { echo "$@" >&2; }
log-warning() { echo "[WARNING] $*" >&2; }
log-error() { echo "[ERROR] $*" >&2; }
fatal() {
  local status_code=1
  local OPTIND OPTARG opt
  # The two getopts failures are DIFFERENT faults and are reported separately: a
  # `*)` catch-all answers "bad option to fatal: -s" when -s was a perfectly good
  # option that simply arrived without its value.
  while getopts ":s:" opt; do
    case "$opt" in
      s) status_code="$OPTARG" ;;
      \?) echo "[FATAL] Unknown option to fatal function: -$OPTARG" >&2; exit 1 ;;
      :) echo "[FATAL] Option to fatal function requires a value: -$OPTARG" >&2; exit 1 ;;
    esac
  done
  shift $((OPTIND - 1))
  echo "[FATAL] $*" >&2
  exit "$status_code"
}

# The reserved usage-error exit codes, copied from bin/functions WITH THE SAME
# VALUES rather than sourced — see the same note in ship-lock and ship-order.
# The ship-* scripts source nothing from bin/: they run outside the dev shell,
# against a checkout they merely point AT, and bin/common would fail them on an
# env problem they have no stake in. The values must not drift — a caller that
# invoked ship-lens wrongly is reported exactly as any bin/ script would.
EXIT_UNKNOWN_OPTION=10
EXIT_OPTION_REQUIRES_VALUE=11
EXIT_UNEXPECTED_ARG=20
EXIT_MISSING_REQUIRED_ARG=21
EXIT_INVALID_ARG_VALUE=22

# The system band, below the usage band and outside it. 0 and 1 are `missing`'s
# two DOMAIN answers — nothing missing, and the faults listed on stdout — so a
# run that could not do the job asked of it must borrow neither: it prints
# nothing on stdout, which is exactly what a clean tier looks like to a caller
# reading the lists. A measurement that found faults and a failure to measure
# are opposite outcomes and they get different exit codes.
#
# It covers the WRITERS as well as the check, which is why it is not named for
# the corpus. `start` IS the mechanism — RFC 234's guarantee holds only because
# the line is on disk before the child works — so an append that failed must
# not leak the redirection's own status, and must not land on 1, which for the
# sibling verb `missing` means "faults found": one script, one published band,
# two meanings.
EXIT_CANNOT_RUN=2

TAB=$'\t'
NL=$'\n'

help() {
  cat << 'EOF'
ship-lens -s <run-scratch> start   -t <tier> -l <lens> -c <child-id>
ship-lens -s <run-scratch> done    -t <tier> -l <lens>
ship-lens -s <run-scratch> skip    -t <tier> -l <lens> -r <reason>
ship-lens -s <run-scratch> missing -t <tier>

The append-only per-lens dispatch ledger of a /ship review, at
<run-scratch>/findings/lens-ledger.tsv — one tab-separated record per line:

  start   <tier>  <lens>  <child-id>
  done    <tier>  <lens>
  skip    <tier>  <lens>  <reason>

  start     Record a lens dispatched to a child. Append it when the child is
            SPAWNED, not when it replies. Silent on stdout.
  done      Record that the child reported. Silent on stdout.
  skip      Record a lens deliberately not dispatched, with the real reason.
            The skip IS the override; there is no override flag. Silent.
  missing   Compare the ledger's NAMES with the findings directory's FILENAMES
            and print, to stdout, one line per fault:

              STALLED       a `start` with no tier<N>-<lens>.md, or an empty one
              UNDISPATCHED  a lens this tier assigns that has neither start nor skip
              UNDECLARED    a tier<N>-*.md that no `start` line names
              SHARED-CHILD  two lenses claiming one child id
              MALFORMED     a ledger record that is not one this script wrote

            A `start` naming a lens the tier manifest does not assign to this
            tier declares NO report: it is warned about on stderr, and the file
            it would have declared is UNDECLARED like any other.

            It never reads a report's contents. The same lines are written to
            <run-scratch>/findings/tier<N>-missing.txt, so the archive holds the
            answer rather than the coordinator's memory of it. A clean tier
            leaves that file EMPTY; a check that did not finish leaves one
            INCOMPLETE line carrying the reason, so the file NEVER shows a clean
            verdict for a check that did not run. The tier does not close until
            this EXITS 0: re-dispatch the lens, or append a `skip` with the real
            reason. Both are honest; neither is silent.

  -s   run-scratch directory; its state file supplies CODEBASE_ROOT
  -t   tier number
  -l   lens name (the review skill's directory name)
  -c   start only: the child id the lens was dispatched to
  -r   skip only: why it was not dispatched
  -h   this help

Files `missing` reads, both derived from -s:
  <run-scratch>/findings/            the ledger and the tier's report filenames
  <CODEBASE_ROOT>/.claude/skills/    the lens directories and review-fix/tiers.md

Exit codes:
  0    recorded / nothing missing
  1    missing found faults, and listed them on stdout
  2    the script could not do what it was asked: a record that could not be
       WRITTEN, or a check that could not RUN — the run state or the lens
       corpus could not be read, or the corpus contradicts itself. NEVER a
       clean tier: an empty stdout is what 0 and 2 have in common, which is why
       the close condition is the exit status and not the output, and why
       tier<N>-missing.txt carries an INCOMPLETE line whenever the check did
       not finish
  10, 11, 20, 21, 22   usage errors (bin/functions' reserved band)
EOF
  exit "${1:-0}"
}

# ── Step 1: what the caller asked for ────────────────────────────────────────
RUN_SCRATCH="" TIER="" LENS="" CHILD_ID="" REASON=""
# Which options were actually GIVEN, so "-l with an empty value" (a malformed
# value, 22) stays distinguishable from "-l absent" (a missing argument, 21),
# and so an option a verb does not take can be refused rather than ignored.
SEEN=""

# getopts is the arbiter of the grammar, and it runs TWICE: once before the verb
# and once after it. getopts stops at the first non-option, so a single pass
# would make `ship-lens -s <rs> start -t 1 …` — the order RFC 234 writes — a
# surplus-positional error. Two passes accept either order while the option set,
# the value checks and the reserved exit codes stay in one place. OPTIND must be
# reset between them; it is a global.
parse_options() {
  local opt
  while getopts ":s:t:l:c:r:h" opt; do
    case "$opt" in
      s) seen_once s; RUN_SCRATCH="$OPTARG" ;;
      t) seen_once t; TIER="$OPTARG" ;;
      l) seen_once l; LENS="$OPTARG" ;;
      c) seen_once c; CHILD_ID="$OPTARG" ;;
      r) seen_once r; REASON="$OPTARG" ;;
      h) help 0 ;;
      \?) fatal -s "$EXIT_UNKNOWN_OPTION" "unknown option [-$OPTARG]" ;;
      :) fatal -s "$EXIT_OPTION_REQUIRES_VALUE" "option [-$OPTARG] requires an argument" ;;
    esac
  done
}

given() { case " $SEEN " in *" $1 "*) return 0 ;; *) return 1 ;; esac; }

# A repeated option is surplus, not a correction: `-t 1 start -t 2` names two
# tiers and the ledger can record one, so last-wins writes the record nobody
# asked for. It is refused across BOTH getopts passes, because SEEN spans them
# — the same argument the verb-option check below already makes, that a caller
# who names a value believes it was used.
seen_once() {
  ! given "$1" || fatal -s "$EXIT_UNEXPECTED_ARG" "option [-$1] was given more than once; it takes one value"
  SEEN="$SEEN $1"
}

OPTIND=1
parse_options "$@"
shift $((OPTIND - 1))

[ "$#" -ge 1 ] || fatal -s "$EXIT_MISSING_REQUIRED_ARG" "a verb is required: start|done|skip|missing"
VERB="$1"
shift

OPTIND=1
parse_options "$@"
shift $((OPTIND - 1))
[ "$#" -eq 0 ] || fatal -s "$EXIT_UNEXPECTED_ARG" "ship-lens takes one verb: surplus arguments [$*]"

# The verb is checked FIRST: `ship-lens -s <rs> grab` is a malformed value, not
# a missing argument, whatever else is or is not on the line.
case "$VERB" in
  start | done | skip | missing) ;;
  *) fatal -s "$EXIT_INVALID_ARG_VALUE" "unknown verb [$VERB]: expected start|done|skip|missing" ;;
esac

# What each verb takes. An option the verb does not take is a caller error and
# not silently ignored: `skip -c <child>` means the caller believes it recorded
# a dispatch, and it did not.
case "$VERB" in
  start) REQUIRED="s t l c" ;;
  done) REQUIRED="s t l" ;;
  skip) REQUIRED="s t l r" ;;
  missing) REQUIRED="s t" ;;
esac
for opt in s t l c r; do
  case " $REQUIRED " in
    *" $opt "*)
      given "$opt" || fatal -s "$EXIT_MISSING_REQUIRED_ARG" "[$VERB] requires -$opt"
      ;;
    *)
      ! given "$opt" || fatal -s "$EXIT_UNKNOWN_OPTION" "option [-$opt] is not taken by [$VERB]"
      ;;
  esac
done

[ -n "$RUN_SCRATCH" ] || fatal -s "$EXIT_INVALID_ARG_VALUE" "the run-scratch (-s) is empty"
[ -d "$RUN_SCRATCH" ] || fatal -s "$EXIT_INVALID_ARG_VALUE" "run-scratch [$RUN_SCRATCH] is not a directory"
[ -f "$RUN_SCRATCH/state" ] || fatal -s "$EXIT_INVALID_ARG_VALUE" "no state file at [$RUN_SCRATCH/state] — not a run scratch"
[[ "$TIER" =~ ^[0-9]+$ ]] || fatal -s "$EXIT_INVALID_ARG_VALUE" "tier [-t $TIER] is not a tier number"

# A lens name is used as a FILENAME — tier<N>-<lens>.md — by `missing`, so it is
# held to a filename's shape. Without this, `-l ../../x` makes a start line that
# no report can ever satisfy, and the prefix-stripping in the UNDECLARED check
# would be comparing paths with names.
# One arm per refusal, each naming the rule it applied. A single arm stating
# the whole class misdirects: ".hidden" IS letters and a dot, so a caller told
# "letters, digits, dot, dash, underscore" cannot build an accepted value from
# the message, and the empty name rendered as "lens [-l ]" where -c and -r both
# say "is empty" by name.
reject_non_name() {
  case "$1" in
    "")
      fatal -s "$EXIT_INVALID_ARG_VALUE" "the lens name (-l) is empty"
      ;;
    .*)
      fatal -s "$EXIT_INVALID_ARG_VALUE" "lens [-l $1] begins with a dot; the name is used verbatim as the report filename tier<N>-<lens>.md, so [.] and [..] must not be able to name a lens"
      ;;
    *[!A-Za-z0-9._-]*)
      fatal -s "$EXIT_INVALID_ARG_VALUE" "lens [-l $1] holds a character outside [A-Za-z0-9._-]; the name is used verbatim as the report filename tier<N>-<lens>.md"
      ;;
  esac
}

# The file's one structural promise is one record per line, so a field that
# could break it never reaches the file. Checked for EVERY field, not just the
# free-text reason: a lens name or a child id is no less able to carry a tab.
# The refused VALUE is shown, rendered with %q: a value refused for carrying a
# tab cannot be printed raw — the tab would be invisible and a newline would
# break the diagnostic into two lines — and a caller who built the reason from
# a child's failure text otherwise learns only that "something" in it held one.
reject_separators() {
  local option="$1" value="$2" shown
  printf -v shown '%q' "$value"
  case "$value" in
    *"$TAB"*) fatal -s "$EXIT_INVALID_ARG_VALUE" "[-$option $shown] contains a tab; the ledger is one tab-separated record per line" ;;
    *"$NL"*) fatal -s "$EXIT_INVALID_ARG_VALUE" "[-$option $shown] contains a newline; the ledger is one record per line" ;;
  esac
}

FINDINGS="$RUN_SCRATCH/findings"
LEDGER="$FINDINGS/lens-ledger.tsv"
# The verdict artifact is named ONCE, here, and both the exempt-name list and
# the write below derive from it: typed at two sites, a rename keeps the old
# spelling at one of them and the file's name has no home.
MISSING_REPORT_NAME="tier$TIER-missing.txt"
MISSING_REPORT="$FINDINGS/$MISSING_REPORT_NAME"

# ── The three writers ────────────────────────────────────────────────────────
# They validate, append ONE line and say nothing on stdout. They deliberately do
# NOT consult the corpus: a dispatch must be recordable at the instant the child
# is spawned, offline and without reading 40 skill directories. Whether the lens
# belongs to the tier it claims is `missing`'s question, asked later.
append_record() {
  mkdir -p "$FINDINGS" ||
    fatal -s "$EXIT_CANNOT_RUN" "cannot create the findings directory [$FINDINGS] — the dispatch is unrecorded"
  printf '%s\n' "$1" >> "$LEDGER" ||
    fatal -s "$EXIT_CANNOT_RUN" "cannot append to the ledger at [$LEDGER] — the dispatch is unrecorded"
}

case "$VERB" in
  start)
    reject_separators l "$LENS"
    reject_separators c "$CHILD_ID"
    reject_non_name "$LENS"
    [ -n "$CHILD_ID" ] || fatal -s "$EXIT_INVALID_ARG_VALUE" "the child id (-c) is empty"
    append_record "start$TAB$TIER$TAB$LENS$TAB$CHILD_ID"
    log-info "tier $TIER: dispatched [$LENS] to [$CHILD_ID]"
    exit 0
    ;;
  done)
    reject_separators l "$LENS"
    reject_non_name "$LENS"
    append_record "done$TAB$TIER$TAB$LENS"
    log-info "tier $TIER: [$LENS] reported"
    exit 0
    ;;
  skip)
    reject_separators l "$LENS"
    reject_separators r "$REASON"
    reject_non_name "$LENS"
    [ -n "$REASON" ] || fatal -s "$EXIT_INVALID_ARG_VALUE" "the reason (-r) is empty"
    append_record "skip$TAB$TIER$TAB$LENS$TAB$REASON"
    log-info "tier $TIER: skipped [$LENS] — [$REASON]"
    exit 0
    ;;
  # `missing` is the one verb that continues past here, and it says so: a verb
  # added to the two lists above lands on the arm below rather than silently
  # running the whole check under its name.
  missing) ;;
  *) fatal -s "$EXIT_INVALID_ARG_VALUE" "verb [$VERB] has no writer and is not [missing]" ;;
esac

# ── missing: NAMES against FILENAMES ─────────────────────────────────────────

# THE ARTIFACT MUST NEVER READ CLEAN FOR A CHECK THAT DID NOT HAPPEN, and that
# is this script's own defect class: a refusal reported as a success. The
# verdict file is what phase 7 and the workflow audit read — the exit status
# lives only in the coordinator's shell — and an EMPTY file was the answer for
# three different things: a clean tier, a tier whose check halted before the
# write, and a tier that was never checked at all. Worse, a halt left the
# PREVIOUS invocation's fault lines standing to be archived as this close's
# verdict.
#
# So the file carries all three of `missing`'s answers, in the currency it
# already prints: the fault lines when there are faults, nothing at all when
# there are none, and INCOMPLETE lines when the check could not finish.
#
# The INCOMPLETE marker is claimed FIRST, before anything is read, so the file
# belongs to THIS invocation from the outset and no exit — a halt below, or a
# kill — can leave the previous one's verdict to be archived as this close's
# answer. A halt then APPENDS its reason to that marker, and the real verdict
# REPLACES it, which is why the two lines never appear together with faults.
begin_verdict() {
  mkdir -p "$FINDINGS" || return 1
  printf 'INCOMPLETE%sthe check did not complete\n' "$TAB" > "$MISSING_REPORT"
}

# Every halt in `missing` goes through here, so the reason reaches the ARCHIVE
# and not only the terminal. It APPENDS: before the verdict is written it lands
# under the marker above, and the one halt that is raised AFTER the verdict —
# the untiered lens — lands under this tier's own fault lines, which it must not
# erase. `fatal` stays the callee; a halt that called itself would recurse.
halt_check() {
  printf 'INCOMPLETE%s%s\n' "$TAB" "$1" >> "$MISSING_REPORT" ||
    log-error "could not record the halt reason in [$MISSING_REPORT]"
  fatal -s "$EXIT_CANNOT_RUN" "$1"
}

# Exact membership of a NAME in a newline-delimited list. The empty-list guard
# is not a micro-optimisation: `printf '%s\n' ""` prints ONE EMPTY LINE and
# `grep -qxF -- ""` matches it, so an empty list would answer "yes" to a query
# it has never seen.
list_has() {
  [ -n "$1" ] || return 1
  printf '%s\n' "$1" | grep -qxF -- "$2"
}

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# The verdict marker is claimed BEFORE any corpus read, so every exit from here
# on — a halt, or a kill — leaves a file belonging to THIS invocation and never
# the previous one's verdict. The reasoning is at begin_verdict above.
begin_verdict ||
  fatal -s "$EXIT_CANNOT_RUN" "cannot write the tier verdict to [$MISSING_REPORT] — the check's answer would exist only in the terminal"

# ship-state OWNS the state format, and this is a CALLER of it rather than a
# fourth dialect. It greps the key out instead of evaluating the file, which
# removes two hazards rather than containing them: a resumed or hand-edited run
# cannot define a TIER, LENS or REASON that outranks this command line, and —
# the live one — an INHERITED CODEBASE_ROOT cannot stand in for a state file
# that does not name the root. SKILL.md phase 1 tells every coordinator to hold
# CODEBASE_ROOT in its shell for the whole run, so a sourced read answers with
# the environment's value and `missing` judges whichever worktree that names:
# the halt below was unreachable for exactly the caller the skill describes.
# Same lesson as ship-lock's GIT_DIR strip — the argument is the answer.
# Nothing else in this script needs the state.
CODEBASE_ROOT="$("$SCRIPT_DIR/ship-state" -s "$RUN_SCRATCH" get CODEBASE_ROOT)" ||
  halt_check "cannot read the run state at [$RUN_SCRATCH/state]"
[ -n "$CODEBASE_ROOT" ] ||
  halt_check "state at [$RUN_SCRATCH/state] has no CODEBASE_ROOT"
[ -d "$CODEBASE_ROOT" ] ||
  halt_check "CODEBASE_ROOT [$CODEBASE_ROOT] is not a directory"

SKILLS_DIR="$CODEBASE_ROOT/.claude/skills"
TIERS_FILE="$SKILLS_DIR/review-fix/tiers.md"

# The live lens set is the DIRECTORY NAMES on disk, not a list in a file: a
# review that quietly runs with fewer lenses looks exactly like a clean one, so
# both halves of the discovery halt loudly rather than answering "nothing".
# The two -chain skills are the orchestrators that RUN the lenses, not lenses.
discover_lenses() {
  local skill name
  DISCOVERED=""
  shopt -s nullglob
  for skill in "$SKILLS_DIR"/{code,design,impl}-review-*/SKILL.md; do
    name="$(basename "$(dirname "$skill")")"
    case "$name" in
      code-review-chain | design-review-chain) continue ;;
    esac
    DISCOVERED="$DISCOVERED$name$NL"
  done
  shopt -u nullglob
  [ -n "$DISCOVERED" ] ||
    halt_check "no review lenses under [$SKILLS_DIR] — a review with no lenses looks exactly like a clean one"
}

# THE SHAPE THIS RELIES ON, and nothing else: tiers.md is a `## Tier <N> — …`
# heading followed by a Markdown table whose every data row opens with the skill
# name in backticks (`| \`code-review-srp\` |`). So a line starting `## Tier`
# sets the current tier and a line starting `|` with a backticked first cell is
# a lens in it. Header and separator rows carry no backticks, and the prose that
# names skills in backticks does not start with `|`, so both fall out for free.
read_tier_assignment() {
  [ -r "$TIERS_FILE" ] ||
    halt_check "cannot read the tier manifest at [$TIERS_FILE] — the tier of every lens is unknown"
  ASSIGNMENT="$(awk '
    /^## Tier [0-9]+/ { tier = $3; next }
    tier != "" && /^\|[[:space:]]*`[^`]+`/ {
      name = $0
      sub(/^\|[[:space:]]*`/, "", name)
      sub(/`.*$/, "", name)
      print tier "\t" name
    }
  ' "$TIERS_FILE")"
  [ -n "$ASSIGNMENT" ] ||
    halt_check "the tier manifest [$TIERS_FILE] assigns no lens to any tier"
}

discover_lenses
read_tier_assignment

ASSIGNED_NAMES="$(printf '%s\n' "$ASSIGNMENT" | cut -f2)"
# The lenses this tier owns: assigned to it AND present on disk. A row naming a
# retired skill is a warning, not a halt — it would otherwise list a lens that
# cannot be dispatched and hold the tier open forever.
#
# TIER_ROW_NAMES is the wider set — every name the manifest gives this tier,
# retired ones included. It is what the LEDGER is read against: a lens retired
# mid-run must keep declaring the report its child already wrote, while a name
# the manifest never gave this tier declares nothing at all.
TIER_LENSES="" TIER_ROW_NAMES="" RETIRED_IN_TIER=""
while IFS="$TAB" read -r row_tier row_name; do
  [ -n "$row_tier" ] || continue
  [ "$row_tier" = "$TIER" ] || continue
  TIER_ROW_NAMES="$TIER_ROW_NAMES$row_name$NL"
  if list_has "$DISCOVERED" "$row_name"; then
    TIER_LENSES="$TIER_LENSES$row_name$NL"
  elif [ -f "$SKILLS_DIR/$row_name/SKILL.md" ]; then
    # The row's skill EXISTS and discovery did not match it, so the drop below
    # would be a lie: the lens is not retired, this script's glob and the
    # patterns references/review.md owns have drifted apart. Dropping it is
    # precisely the silent-shrinkage failure the discovery exists to prevent, so
    # it halts by name instead.
    halt_check "the tier manifest lists [$row_name] in tier $TIER and [$SKILLS_DIR/$row_name/SKILL.md] exists, but discovery did not match it — reconcile the glob with references/review.md"
  else
    RETIRED_IN_TIER="$RETIRED_IN_TIER$row_name "
    log-warning "the tier manifest lists [$row_name] in tier $TIER, but no skill directory exists for it — retired, so it is dropped"
  fi
done <<< "$ASSIGNMENT"

# A discovered lens with no row is the silent-shrinkage case from the other
# side: it belongs to no tier, so no tier would ever ask for it. RFC 234 D5
# makes it fatal by name, and it stays fatal by name — but it is RAISED at the
# END of the run, after this tier's own faults have been printed. Raised here it
# pre-empts the payload, so adding one lens directory blanks the list the
# coordinator is told to read: the state in which the most is unknown would be
# the one that reads cleanest on the documented channel.
UNASSIGNED=""
while read -r name; do
  [ -n "$name" ] || continue
  list_has "$ASSIGNED_NAMES" "$name" || UNASSIGNED="$UNASSIGNED$name "
done <<< "$DISCOVERED"

# Two opposite corpus faults wore one message, and their repairs differ: add a
# row, or restore a skill. Neither answer costs a lookup — the whole assignment
# is in hand here — and "no lens is assigned to tier [9]" named neither the
# manifest nor the tiers it does assign, which is the one thing a caller who
# mistyped -t needs.
if [ -z "$TIER_LENSES" ]; then
  [ -z "$RETIRED_IN_TIER" ] ||
    halt_check "every lens [$TIERS_FILE] assigns to tier [$TIER] is retired — [${RETIRED_IN_TIER% }] — so the tier can dispatch nothing"
  MANIFEST_TIERS="$(printf '%s\n' "$ASSIGNMENT" | cut -f1 | sort -un | tr '\n' ' ')"
  halt_check "the tier manifest [$TIERS_FILE] has no row for tier [$TIER]; it assigns lenses to tiers [${MANIFEST_TIERS% }]"
fi

# ── The ledger, filtered to this tier ────────────────────────────────────────
#
# Every other fault here is scoped to the tier being asked about, because the
# tiers are separate dispatch rounds. MALFORMED is the one deliberate exception:
# it is collected BEFORE the tier filter, so a corrupt record is reported by
# whichever tier closes next. A malformed record is a fact about the FILE, not
# about a tier, and only a hand edit produces one — scoping it would hide the
# corruption until the owning tier happened to close, which for a tier already
# closed is never.

# The record is split by FIELD rather than read into positionals, because TAB is
# IFS WHITESPACE: `IFS=$'\t' read -r kind tier lens extra` COLLAPSES adjacent
# tabs, so `start<TAB>1<TAB><TAB>sub-c1` arrives as a three-field record whose
# LENS is the child id — mis-parsed, not reported. FIELDS holds every field the
# line really has, empty ones included, and FIELD_COUNT is what a truncated
# record fails.
split_record() {
  local rest="$1"
  FIELDS=()
  while :; do
    FIELDS+=("${rest%%"$TAB"*}")
    [ "$rest" = "${rest#*"$TAB"}" ] && break
    rest="${rest#*"$TAB"}"
  done
  FIELD_COUNT="${#FIELDS[@]}"
}

# A record is one this script wrote only if its verb, its field COUNT and the
# non-emptiness of every field all agree. Every part of that is a fact about the
# FILE and not about a tier, so all of it is judged BEFORE the tier filter: a
# corrupt record stamped with another tier would otherwise be dropped in
# silence, and for a tier that has already closed that is forever.
# WHICH of the three failed is carried out with the record rather than
# collapsed into a boolean. Only a hand edit produces a malformed record, so the
# reader is a human repairing a file, the three faults have three different
# repairs, and an empty field cannot be seen by eye in a line of tabs.
well_formed_record() {
  local expected i
  RECORD_FAULT=""
  case "${FIELDS[0]}" in
    start | skip) expected=4 ;;
    done) expected=3 ;;
    *)
      RECORD_FAULT="first field [${FIELDS[0]}] is not start, done or skip"
      return 1
      ;;
  esac
  if [ "$FIELD_COUNT" -ne "$expected" ]; then
    RECORD_FAULT="a [${FIELDS[0]}] record is $expected fields, this one has $FIELD_COUNT"
    return 1
  fi
  for ((i = 0; i < FIELD_COUNT; i++)); do
    if [ -z "${FIELDS[i]}" ]; then
      RECORD_FAULT="field $((i + 1)) of $FIELD_COUNT is empty"
      return 1
    fi
  done
}

STARTED="" SKIPPED="" START_PAIRS="" MALFORMED="" LEDGER_LINE=0
if [ -f "$LEDGER" ]; then
  # THE OPEN IS THE TEST. `[ -f ]` then `done < "$LEDGER"` is two different
  # questions: bash does not fail a compound command whose redirection could not
  # be opened, it skips the body — so an unreadable ledger became "the ledger
  # records nothing", the one state this script treats as legitimate, and every
  # lens was reported UNDISPATCHED with a confident exit 1. An IO failure and
  # "no ledger yet" are opposite facts.
  exec 3< "$LEDGER" ||
    halt_check "the ledger at [$LEDGER] exists but cannot be opened — an unreadable ledger is not an empty one, and every lens would read as UNDISPATCHED"
  # `read` returns false at a final line with no newline, HAVING ALREADY
  # ASSIGNED it: without the second clause the last record of a hand-edited or
  # interrupted ledger — the one input MALFORMED exists for, and the most recent
  # dispatch — is dropped in silence.
  while IFS= read -r record <&3 || [ -n "$record" ]; do
    LEDGER_LINE=$((LEDGER_LINE + 1))
    # An EMPTY line is not a malformed record; it is a blank line.
    [ -n "$record" ] || continue
    split_record "$record"
    well_formed_record ||
      { MALFORMED="$MALFORMED$LEDGER_LINE$TAB$RECORD_FAULT$TAB$record$NL"; continue; }
    kind="${FIELDS[0]}" line_tier="${FIELDS[1]}" lens="${FIELDS[2]}" extra="${FIELDS[3]:-}"
    [ "$line_tier" = "$TIER" ] || continue
    case "$kind" in
      start)
        # A NAME IS NOT A LENS UNLESS THE MANIFEST GAVE IT TO THIS TIER. Without
        # this, UNDECLARED — the check this script exists for — is satisfied by
        # inventing one: `start 1 structural` plus a batched tier1-structural.md
        # closes the tier clean, which is the rfc-232 review exactly. A name the
        # manifest does not assign here declares nothing, so the file it was
        # meant to legitimise is UNDECLARED and the real lens is UNDISPATCHED.
        # It is a warning and not a sixth fault kind: the ledger is append-only,
        # so a fault line for a record that cannot be withdrawn would hold the
        # tier open with no honest repair, and the two lines it already produces
        # hold it open on the evidence a reader can act on.
        if ! list_has "$TIER_ROW_NAMES" "$lens"; then
          log-warning "tier $TIER: the ledger starts [$lens], which [$TIERS_FILE] does not assign to tier $TIER — it declares no report"
        else
          # A lens re-dispatched after a stall has TWO start lines and ONE
          # report, so the started set is by NAME, deduplicated.
          list_has "$STARTED" "$lens" || STARTED="$STARTED$lens$NL"
        fi
        # A well-formed start always carries its child id, so the pair is
        # unconditional: a start without one is MALFORMED above, not a start
        # that quietly opts out of the SHARED-CHILD check. The surplus name
        # keeps its pair too — a batch that fanned one child across a real lens
        # and an invented one is exactly what SHARED-CHILD is for.
        START_PAIRS="$START_PAIRS$extra$TAB$lens$NL"
        ;;
      skip) list_has "$SKIPPED" "$lens" || SKIPPED="$SKIPPED$lens$NL" ;;
      # `done` adds no fault `missing` can check: the report on disk is the
      # evidence, and a `done` with no report is already the stalled case. But a
      # `done` with no START is a ledger that contradicts itself — the reply was
      # recorded and the dispatch was lost — so it is said out loud.
      done)
        if ! list_has "$TIER_ROW_NAMES" "$lens"; then
          log-warning "tier $TIER: the ledger reports [$lens] done, and [$TIERS_FILE] does not assign it to tier $TIER"
        elif ! list_has "$STARTED" "$lens"; then
          log-warning "tier $TIER: the ledger reports [$lens] done with no start line — the dispatch record was lost"
        fi
        ;;
    esac
  done
  exec 3<&-
fi

# ── The three lists ──────────────────────────────────────────────────────────
FAULTS=""

# 1. STALLED — claimed, and no report on disk. Existence and non-emptiness only:
# this script never opens the file. A lens that ALSO carries a skip is not
# stalled: the skip IS the override, exactly as it is for UNDISPATCHED below,
# and it is one of the two repairs this very line names. Without it the
# documented repair for a child that stalled twice clears nothing, and the only
# way to close the tier is to fabricate a report — the behaviour this script
# exists to catch.
while read -r lens; do
  [ -n "$lens" ] || continue
  list_has "$SKIPPED" "$lens" && continue
  report="$FINDINGS/tier$TIER-$lens.md"
  # -s alone is true for a DIRECTORY of that name, which is present without
  # being a report and would clear the stall; existence and non-emptiness are
  # still all that is read, and the file is still never opened.
  { [ -f "$report" ] && [ -s "$report" ]; } ||
    FAULTS="${FAULTS}STALLED$TAB$lens${TAB}tier$TIER-$lens.md$NL"
done <<< "$STARTED"

# 2. UNDISPATCHED — the silent skip: a lens this tier assigns that was neither
# started nor skipped. The skip IS the override, which is why a skipped lens is
# not reported here.
while read -r lens; do
  [ -n "$lens" ] || continue
  list_has "$STARTED" "$lens" && continue
  list_has "$SKIPPED" "$lens" && continue
  FAULTS="${FAULTS}UNDISPATCHED$TAB$lens$NL"
done <<< "$TIER_LENSES"

# 3. UNDECLARED — a report file no `start` line names: the batched review.
#
# The names the RUN ITSELF writes are not lens reports, and they are held HERE,
# once, as data — the four names references/review.md defines and no others.
# Two of the four cannot match the *.md glob above; they are enumerated anyway,
# so that adding a run-written artifact is one edit here and one in review.md,
# and never a silent dependence on the glob staying narrow.
# The .jsonl name is unreachable under today's glob and is enumerated anyway,
# because that is what stops the exempt set depending on the glob's shape: a
# filename SHAPE nothing writes would be a hole in the one check this script
# exists for, since a batched tier<N>-review.<shape>.md would walk past it.
# Adding a run-written artifact means adding it to review.md AND to this list.
RUN_WRITTEN="tier$TIER-fix-plan.md${NL}tier$TIER-fix-report.md${NL}tier$TIER-outcomes.jsonl${NL}$MISSING_REPORT_NAME"

shopt -s nullglob
for file in "$FINDINGS"/tier"$TIER"-*.md; do
  base="$(basename "$file")"
  list_has "$RUN_WRITTEN" "$base" && continue
  lens="${base#tier$TIER-}"
  lens="${lens%.md}"
  list_has "$STARTED" "$lens" ||
    FAULTS="${FAULTS}UNDECLARED$TAB$base$NL"
done
shopt -u nullglob

# 4. SHARED-CHILD — two lenses claiming one child id. Free, because the ids are
# already in the ledger, and it is the one check that catches a fan-out that was
# really a batch.
#
# The (child, lens) PAIR is deduplicated because a RE-DISPATCH is honest: a lens
# started twice against the same child — the documented repair for a STALLED
# line — writes that pair twice, and counting the lines would report it as a
# shared child and hold the tier open on a fault nobody can repair. Only a
# SECOND LENS on one id is the batch this looks for. `NF == 2` drops nothing a
# well-formed record produces; a start reaches here only after
# well_formed_record.
if [ -n "$START_PAIRS" ]; then
  shared="$(printf '%s' "$START_PAIRS" | awk -F"$TAB" '
    NF == 2 && !seen[$1 SUBSEP $2]++ {
      lenses[$1] = ($1 in count ? lenses[$1] " " : "") $2
      count[$1]++
    }
    END { for (child in count) if (count[child] > 1) print child "\t" lenses[child] }
  ')"
  while read -r child lenses; do
    [ -n "$child" ] || continue
    FAULTS="${FAULTS}SHARED-CHILD$TAB$child$TAB$lenses$NL"
  done <<< "$shared"
fi

# A record this script did not write is reported rather than skipped: it is the
# one thing a hand-edited ledger can do that nothing else would ever notice.
# Each entry already carries its 1-based LEDGER LINE and the rule it broke, in
# that order, with the record itself LAST because it is the field that holds
# tabs: repairing a 200-line ledger otherwise starts with a hunt, and four
# different hand-edit mistakes produced one undifferentiated line.
if [ -n "$MALFORMED" ]; then
  # IFS= , because the record carries the tabs that made it a record: the
  # default IFS would trim the very field boundaries a human needs to repair it.
  while IFS= read -r record; do
    [ -n "$record" ] || continue
    FAULTS="${FAULTS}MALFORMED$TAB$record$NL"
  done <<< "$MALFORMED"
fi

# The answer is written down as well as printed, because phase 7 is required to
# report what `missing` said at each tier close and a verdict held only in the
# coordinator's head is the reconstruction this whole ledger exists to remove.
# The write REPLACES the INCOMPLETE line put there before the corpus was read,
# so the file now says one of three things and never the wrong one: the faults,
# nothing at all (clean), or INCOMPLETE with the reason (halted). The name ends
# `.txt`, so the UNDECLARED glob above never sees it. It is still NOT the close
# condition — the exit status is — but it can no longer contradict it.
#
# The ANSWER goes out first: a failure to archive it must not destroy it, and
# the write is infrastructure, so its failure takes the system code rather than
# returning a redirection's status as though it were the measurement's.
[ -z "$FAULTS" ] || printf '%s' "$FAULTS"
printf '%s' "$FAULTS" > "$MISSING_REPORT" ||
  fatal -s "$EXIT_CANNOT_RUN" "cannot write the tier verdict to [$MISSING_REPORT] — the faults above were found but could not be recorded"

if [ -n "$FAULTS" ]; then
  # STDOUT carries the lists — they are what the caller asked for — and stderr
  # the count, which names the artifact rather than saying "above": the moment a
  # caller redirects stdout, "above" points at nothing. Each line names its own
  # repair: re-dispatch that lens, or append a `skip` with the real reason.
  # The severity is [ERROR], not a bare line: the clean summary six lines below
  # is typographically identical without it, so a reader grepping a captured log
  # for [ERROR] finds nothing and reads a tier that did not close as green. The
  # EXIT CODE still carries the domain/system split — 1 here, 2 for a halt — and
  # the prefix is about the TRANSCRIPT, not about which band the answer is in.
  log-error "tier $TIER is not accounted for: $(printf '%s' "$FAULTS" | grep -c '' ) fault line(s) on stdout, also written to [$MISSING_REPORT]"
fi

# The corpus fault is raised LAST, after this tier's own faults have been
# printed and recorded: RFC 234 D5 makes an untiered lens fatal by name, and a
# fatal prints nothing on stdout, so raising it early would blank the list the
# coordinator is told to read. It is a fault of the CORPUS, not of this run, and
# carries the system exit code for that reason.
[ -z "$UNASSIGNED" ] ||
  halt_check "the tier manifest [$TIERS_FILE] gives no tier to [${UNASSIGNED% }] — add a row, or those lenses run in no tier at all"

if [ -z "$FAULTS" ]; then
  log-info "tier $TIER: every lens accounted for"
  exit 0
fi
exit 1
