# Usage-error exit-code band (10-29), reserved for "the caller invoked the
# script wrongly" and kept clear of the 1-9 range used for operational/runtime
# outcomes. Each is assigned only if unset, so an .env entry sourced after this
# file overrides it (bin/common sources functions first, then .env).
: "${EXIT_UNKNOWN_OPTION:=10}"          # getopts '?'  -- an option the script does not define
: "${EXIT_OPTION_REQUIRES_VALUE:=11}"   # getopts ':'  -- a defined option given without its value
: "${EXIT_UNEXPECTED_ARG:=20}"          # a positional beyond the declared grammar (surplus / stray)
: "${EXIT_MISSING_REQUIRED_ARG:=21}"    # a required positional absent
: "${EXIT_INVALID_ARG_VALUE:=22}"       # a present value that is malformed (bad port, bad mode)
: "${EXIT_EXCLUSIVE_OPTIONS:=23}"       # two options that cannot combine (e.g. -r with -x)

# The conventional dump artifact's FILENAME, owned here because it is the one
# name bin/db-dump -D writes and bin/db-restore (no argument) reads: a constant
# with no owner is one a typo can silently split in two, so the pair would
# disagree with nothing able to detect it. The DIRECTORY half is a dev-only
# dotenv key (POSTGRES_DUMP_DIR, .env.dev); only the name is shared code.
: "${DUMP_DEFAULT_FILENAME:=dev.dump}"

# The one shape check for POSTGRES_DUMP_DIR, shared so bin/db-dump -D and
# bin/db-restore's no-argument default cannot drift apart. PRESENCE and VALUE are
# separate answers: `[ -z ]` alone would report a set-but-EMPTY key as "not set",
# and it would ACCEPT "/", which makes the conventional artifact "/dev.dump" --
# the filesystem-root path both scripts exist to refuse. Callers map the three
# outcomes onto their own exit codes; this function only classifies.
#   0: usable
#   1: the key is not set at all
#   2: the key is set to a malformed value (empty, or the filesystem root)
dump_dir_status() {
  if [ -z "${POSTGRES_DUMP_DIR+set}" ]; then
    return 1
  fi
  case "$POSTGRES_DUMP_DIR" in
  "" | /) return 2 ;;
  esac
  return 0
}

# The conventional artifact's full path. Only meaningful after dump_dir_status
# returns 0.
conventional_dump_path() {
  printf '%s/%s' "$POSTGRES_DUMP_DIR" "$DUMP_DEFAULT_FILENAME"
}

# Operational exit codes (1-9) that mean the same thing repo-wide. Postgres being
# unreachable is one outcome with one number, so every script that attaches to a
# running cluster reports it identically (bin/db-run, bin/db-repl, bin/db-dump).
: "${EXIT_POSTGRES_UNREACHABLE:=2}"     # the cluster is not answering; run bin/postgres-up

log-info() {
  echo "$@" >&2
}

log-warning() {
  echo "[WARNING] $@" >&2
}

log-error() {
  echo "[ERROR] $@" >&2
}

fatal() {
  local status_code=1
  local OPTIND OPTARG opt
  while getopts ":s:" opt; do
    case "$opt" in
    s) status_code="$OPTARG" ;;
    \?) echo "[FATAL] Unknown option to fatal function: -$OPTARG" >&2; exit 1 ;;
    :)  echo "[FATAL] Unknown option to fatal function: -$OPTARG" >&2; exit 1 ;;
    esac
  done
  shift $((OPTIND-1))

  echo "[FATAL] $*" >&2
  exit "$status_code"
}

parse-duration-to-seconds() {
  local input="$1"
  if [[ ! "$input" =~ ^[0-9]+[smhd]?$ ]]; then
      return 1
  fi
  local seconds="${input%%[a-zA-Z]*}"
  case "$input" in
      *m*) seconds=$((seconds * 60)) ;;
      *h*) seconds=$((seconds * 3600)) ;;
      *d*) seconds=$((seconds * 86400)) ;;
      *s*|*) ;; # seconds is the default unit
  esac
  echo "$seconds"
}

read-file-or-die() {
  local target_file="$1"
  local status_code="${2:-1}"

  if ! cat "$target_file" 2>/dev/null; then
  fatal -s "$status_code" "Failed to read [$target_file]"
  fi
}

require_dangerous_confirmation() {
  local description="$1"
  
  while true; do
    echo -n "WARNING: Destructive action! $description. Type \"Yes, I really want to do this\" to confirm: " >&2
    local input=""
    if ! read -r input; then
      echo >&2
      return 1
    fi
    
    if [ -z "$input" ]; then
      exit 0
    fi
    
    local normalized
    normalized=$(echo "$input" | sed 's/[^a-zA-Z ]//g' | tr -s ' ' | tr '[:upper:]' '[:lower:]')
    
    if [ "$normalized" = "yes i really want to do this" ]; then
      return 0
    else
      log-warning "Input did not match."
    fi
  done
}

validate_duration() {
  local input="$1"
  if [[ "$input" =~ ^[0-9]+[smhd]$ ]]; then
    return 0
  fi
  return 1
}

# Returns 0 if $1 is a valid TCP port (an integer in 1..65535), non-zero
# otherwise. The single owner of the port-range rule, so check-port, daemon-up,
# daemon-check, daemon-http-check, and find-free-port validate identically.
validate_port() {
  local port="$1"
  [[ "$port" =~ ^[0-9]+$ ]] && [ "$port" -ge 1 ] && [ "$port" -le 65535 ]
}

# Geometry of the per-checkout 16-port block (RFC 132). It lives here, beside the
# derivation that uses it, so the numbers have ONE home: bin/checkout-port and
# .env.dev both reach this file, and a second copy of the constants would be a
# second place for them to drift. CHECKOUT_BLOCK_COUNT * CHECKOUT_BLOCK_SIZE
# spans 18000..48399, entirely below macOS's 49152 ephemeral floor, so the
# derivation itself can never land above it. EPHEMERAL_FLOOR stays in
# bin/checkout-port: it bounds that script's advance loop, and is a property of
# the advance, not of the derivation.
#
# The CHECKOUT_ prefix is not decoration. This file is sourced by EVERY bin/
# script, and the dotenvs are sourced AFTER it, so a bare `BLOCK_SIZE=` anywhere
# in the repo or in an operator's environment would silently re-scale every dev
# port. These are library globals and they are namespaced as such.
CHECKOUT_BLOCK_FLOOR=18000
CHECKOUT_BLOCK_SIZE=16
CHECKOUT_BLOCK_COUNT=1900

# Where the DEV half of the block starts, and the offset each dev service takes.
# bin/checkout-port derives its EPHEMERAL_SPAN from
# CHECKOUT_DEV_OFFSET_REST_SERVER, and .env.dev derives its three ports from these same three numbers, so the
# "+10 is where dev begins" fact has ONE home. The two MUST agree: if the
# free-check probed into the dev half, a checkout's own dev daemon would push its
# bin/test onto a block it does not own (RFC 156). bin/checkout-port's help text
# remains the offset REGISTRY -- the authority for who owns which offset; these
# constants are that registry's machine-readable half.
CHECKOUT_DEV_OFFSET_REST_SERVER=10
CHECKOUT_DEV_OFFSET_ADMIN_WEB=11
CHECKOUT_DEV_OFFSET_PUBLIC_WEB=12

# The longest checkout basename .env.dev's `unicoach-dev-<name>` can carry.
# PostgreSQL's `name` type truncates SILENTLY at 63 bytes (NAMEDATALEN-1), and
# the prefix is 13 of them. Two worktrees agreeing in their first 50 characters
# would therefore land on ONE dev database while cksum -- which sees the full
# name -- hands them DIFFERENT port blocks: nothing fails to bind, nothing
# reveals it, and the documented "rename a worktree" remedy does not apply
# because the names ALREADY DIFFER. That is the exact data-loss bug RFC 156
# exists to remove, re-entering through truncation, so the derivation refuses the
# input instead of producing a name the server will quietly shorten.
CHECKOUT_NAME_MAX_BYTES=50

# Echoes the checkout's IDENTITY -- the basename of its root -- which is the sole
# input to both per-worktree derivations: the port block below, and .env.dev's
# POSTGRES_DB. $1 is the checkout root, defaulting to $PROJECT_ROOT.
#
# `${1-...}` and NOT `${1:-...}`: an EXPLICIT EMPTY argument must reach the guard
# below rather than falling back to the ambient PROJECT_ROOT, which is precisely
# what taking the root by argument was meant to prevent.
checkout_name() {
  [ "$#" -le 1 ] || fatal "checkout_name takes at most one argument (the checkout root), got [$#]"
  local project_root="${1-${PROJECT_ROOT:-}}" name
  [ -n "$project_root" ] || fatal "checkout_name requires a checkout root (PROJECT_ROOT unset)"
  name="$(basename "$project_root")"
  # Counted in BYTES, not characters: the 63 the server truncates at are bytes,
  # and `${#name}` counts characters in a UTF-8 locale, which would let a
  # multi-byte name through.
  local name_bytes
  name_bytes="$(printf '%s' "$name" | LC_ALL=C wc -c | tr -d '[:space:]')"
  if [ "$name_bytes" -gt "$CHECKOUT_NAME_MAX_BYTES" ]; then
    fatal "checkout directory name [$name] is [$name_bytes] bytes; the per-worktree dev database is unicoach-dev-<name> and PostgreSQL truncates a name at 63 bytes, so two checkouts agreeing in their first [$CHECKOUT_NAME_MAX_BYTES] bytes would SHARE one dev database while getting different port blocks. Rename this worktree directory to at most [$CHECKOUT_NAME_MAX_BYTES] bytes (RFC 156)."
  fi
  printf '%s\n' "$name"
}

# Echoes the BASE of this checkout's 16-port block — the PURE derivation, with no
# port probing and no advance:
#
#   18000 + (cksum of "$(basename "$PROJECT_ROOT")" % 1900) * 16
#
# It is a pure function of the checkout DIRECTORY NAME, so it is stable across
# runs and reboots, and because the blocks are 16-aligned two checkouts get either
# entirely disjoint blocks or the identical one — never a partial overlap.
#
# It lives in this file — not in bin/checkout-port, and not in bin/common —
# because .env.dev must call it and neither of those is reachable from there
# (RFC 156):
#
#   - bin/checkout-port sources bin/common, and bin/common sources .env.dev, so a
#     command substitution in .env.dev that called it would re-enter bin/common,
#     re-source .env.dev, and fork again. That is an unbounded fork bomb, not a
#     slow path. The same applies to bin/check-port.
#   - bin/build-ios does not source bin/common AT ALL — it runs under system
#     Xcode, outside the Nix dev shell, and sources .env and .env.dev directly.
#     Dev-port logic held in bin/common would be invisible to the one consumer
#     that BAKES the port into a shipped bundle (Info.plist UnicoachBackendURL).
#
# bin/functions is already sourced, and PROJECT_ROOT already set, before the
# dotenvs are read on BOTH paths (bin/common:3,5 then 99; bin/build-ios:7,8 then
# its dotenv loop), which is what makes this the one location both consumers can
# reach. It therefore sources nothing itself (sourcing bin/common here would be
# the same recursion) and forks nothing but cksum.
#
# bin/checkout-port layers its block-advance loop on top of this for the
# EPHEMERAL half of the block. The DEV half (+10..+12, .env.dev) uses this value
# as-is and never advances: a dev port that moves is not a dev port, because a
# previously-built iOS bundle still points at the old one.
#
# Takes the checkout root as $1, defaulting to $PROJECT_ROOT, and REFUSES an
# empty one. Taking it by argument matters: an ambient PROJECT_ROOT is silently
# satisfiable by the WRONG value (an exported one from a parent script, or a test
# fixture root), which yields a valid-LOOKING block for another checkout with
# nothing visible at the call site. An EMPTY one used to produce
# `basename "" -> "" -> a real cksum -> 21120`: a plausible number for no
# checkout at all. Both now fail loudly instead (RFC 156).
checkout_block_base() {
  [ "$#" -le 1 ] || fatal "checkout_block_base takes at most one argument (the checkout root), got [$#]"
  # `${1-...}`, NOT `${1:-...}`: an explicit EMPTY root must reach the guard
  # below instead of silently falling back to the ambient PROJECT_ROOT.
  local project_root="${1-${PROJECT_ROOT:-}}" checksum
  [ -n "$project_root" ] || fatal "checkout_block_base requires a checkout root (PROJECT_ROOT unset)"
  checksum="$(printf '%s' "$(checkout_name "$project_root")" | cksum | cut -d' ' -f1)"
  echo $((CHECKOUT_BLOCK_FLOOR + (checksum % CHECKOUT_BLOCK_COUNT) * CHECKOUT_BLOCK_SIZE))
}

# Publish the VALUE, not the function, for the dotenv layer to read: .env.dev
# reads `${CHECKOUT_BLOCK_BASE:?...}` and fails CLOSED when this file was not
# sourced first, instead of the old `$(( $(checkout_block_base) + 10 ))`, which
# evaluated to PORT=10 with rc=0 when the function was missing -- a silently
# wrong port that bin/build-ios then BAKES into an iOS bundle.
#
# A PLAIN SHELL VARIABLE, deliberately NOT exported. The only reader is .env.dev,
# sourced by the SAME shell on both paths (bin/common sources this file, then the
# dotenvs; bin/build-ios does the same), so an export would reach nothing that
# needs it -- only gradle, the JVM, xcodebuild and psql. Worse, it would BREAK the
# fail-closed guard: a child that sources bin/functions WITHOUT PROJECT_ROOT
# (bin/gen-deployed-env is exactly such a site) would INHERIT this value, so
# .env.dev's `:?` could never fire and the child would silently use the PARENT
# CHECKOUT'S block. (.env.test's BASE_TEST_PORT is exported because that contract
# genuinely crosses a process boundary; this one does not.)
#
# The PROJECT_ROOT guard is not optional: bin/functions is sourced by scripts that
# never set it, and an unconditional call to a now-fataling checkout_block_base
# would kill every one of them.
#
# Assigned and status-checked SEPARATELY. `export VAR="$(f)"` -- like
# `local x="$(f)"` -- returns the STATUS OF EXPORT, not of the command
# substitution, so a fataling derivation would print its message while the caller
# carried on.
if [ -n "${PROJECT_ROOT:-}" ]; then
  CHECKOUT_BLOCK_BASE="$(checkout_block_base "$PROJECT_ROOT")" || exit $?
fi

# Exits EXIT_POSTGRES_UNREACHABLE unless the cluster answers. For scripts that
# ATTACH to a running cluster and never provision one (bin/INVARIANTS.md: DDL
# scripts attach, they do not start postgres) — so a stopped cluster is an error
# with a remedy the operator runs, not something the script fixes. The health
# check's own logging is suppressed; this message names host and port instead.
#
# Only NEW callers use this. bin/db-create, bin/db-run, bin/db-repl and
# bin/admin-grant keep their own inline copies deliberately: they are in
# bin/deploy's REPO_PATHS allow-list and run ON THE INSTANCE, and rewriting a
# deployed script for a style rule is how a config change becomes an outage.
# The health check's STDOUT is suppressed (it is a progress line, and a caller
# such as bin/db-dump puts a dump on stdout); its STDERR is deliberately NOT --
# it carries the reason the cluster did not answer, and this message can only
# name the address it tried.
require_postgres_reachable() {
  if ! "$PROJECT_ROOT/bin/postgres-check" >/dev/null; then
    log-info "PostgreSQL is offline [host=${PGHOST:-localhost} port=${PGPORT:-${POSTGRES_PORT:-unset}}]"
    exit "$EXIT_POSTGRES_UNREACHABLE"
  fi
}

# Returns 0 if a database named $1 exists, 1 if it does not, and 2 if the PROBE
# ITSELF failed (the cluster died after the health check, auth was refused, the
# admin database is absent). Three outcomes, because collapsing the third into
# "does not exist" states a FALSE FACT with the WRONG REMEDY — the operator goes
# and recreates a database that was there all along. Asked in POSTGRES_ADMIN_DB,
# since the subject may be the database we cannot connect to.
#
# The name NEVER enters the SQL. The query lists pg_database and the comparison
# happens in the shell, with `grep -qxF` -- exact, whole-line, fixed-string. A
# hand-rolled SQL literal would have had to quote the name (correct only while
# standard_conforming_strings is on), and since RFC 156 the name is derived from
# an OPERATOR-CHOSEN worktree basename. The earlier `grep -q 1` was also an
# UNANCHORED substring match, so any database whose name merely contained a `1`
# read as "exists".
#
# db-query's stderr is NOT suppressed: it is silent on success, so on failure the
# cause ("role does not exist", "database does not exist", "connection refused")
# flows to the caller's stderr, which is the only evidence status 2 could carry.
# The caller's STDOUT is unaffected -- this is stderr.
database_exists() {
  local db_name="$1" out status=0
  out="$(printf 'SELECT datname FROM pg_database' \
    | "$PROJECT_ROOT/bin/db-query" -d "${POSTGRES_ADMIN_DB:-postgres}" -r)" || status=$?
  if [ "$status" -ne 0 ]; then
    return 2
  fi
  printf '%s\n' "$out" | grep -qxF "$db_name"
}

# Echoes the value of the `<key>=` component of an xcodebuild -destination
# string, or nothing when the destination carries none. $1 is the destination,
# $2 the bare key (e.g. `name`, `id`). The match is anchored to a component
# BOUNDARY (start of string, or a comma) so a key that merely ENDS in the one
# asked for — `devicename=` for `name=`, `udid=` for `id=` — can never be
# mistaken for it, and the value runs to the next comma or the end of the
# string. The single owner of the destination-parsing rule shared by
# bin/ios-device and bin/screenshot-ios. Depends on nothing else in this file.
destination_component() {
  local destination="$1" key="$2"
  printf '%s' "$destination" | sed -nE "s/^.*(^|,)$key=([^,]*).*/\2/p"
}

# Splits "$@" at the FIRST literal `--` into two globals: SCRIPT_ARGS
# (everything before it) and PASSTHROUGH_ARGS (everything after, for a script
# that forwards a tail verbatim to an underlying tool). Must be called BEFORE
# getopts: getopts consumes a `--` terminator itself, which would make
# `<script> -- <args>` indistinguishable from `<script> <target>`.
#
# Globals rather than a return value because bash 3.2 — the macOS system shell
# the -ios scripts run under, being barred from the Nix dev shell — has no
# namerefs and cannot return an array. For the same reason callers must expand
# both arrays as `${ARR[@]+"${ARR[@]}"}`, never the obvious `"${ARR[@]}"`:
# under `set -u` on 3.2, expanding an EMPTY array is an unbound-variable error,
# and the ordinary no-`--` invocation leaves PASSTHROUGH_ARGS empty.
# Depends on nothing else in this file.
split_argv_at_dashdash() {
  SCRIPT_ARGS=()
  PASSTHROUGH_ARGS=()
  local seen_dashdash=0 arg
  for arg in "$@"; do
    if [ "$seen_dashdash" -eq 0 ] && [ "$arg" = "--" ]; then
      seen_dashdash=1
      continue
    fi
    if [ "$seen_dashdash" -eq 1 ]; then
      PASSTHROUGH_ARGS+=("$arg")
    else
      SCRIPT_ARGS+=("$arg")
    fi
  done
}

# Echoes the dotenv file path for a cloud-env selector (UNICOACH_ENV): `local`
# maps to .env (the base, no delta), every other value to .env.<env>. Empty arg
# is a missing-required-arg usage error; a named-but-absent file is fatal. The
# single owner of the env-file naming rule shared by bin/infra-*/bin/deploy.
# Depends only on PROJECT_ROOT (set by bin/common) and fatal (this file).
unicoach_env_file() {
  local env="$1"
  if [ -z "$env" ]; then
    fatal -s "$EXIT_MISSING_REQUIRED_ARG" "environment required (e.g. prod); pass it as the first argument"
  fi

  local path
  if [ "$env" = "local" ]; then
    path="$PROJECT_ROOT/.env"
  else
    path="$PROJECT_ROOT/.env.$env"
  fi

  if [ ! -f "$path" ]; then
    fatal -s "$EXIT_INVALID_ARG_VALUE" "environment file not found for [$env]: [$path]"
  fi

  echo "$path"
}

# Fatals naming the first of VAR… that is unset or empty. Used after sourcing a
# selected .env.<env> to assert the cloud-deploy inputs are all present before
# any tofu/aws call. Depends only on fatal (this file).
require_env_vars() {
  local var
  for var in "$@"; do
    if [ -z "${!var:-}" ]; then
      fatal -s "$EXIT_INVALID_ARG_VALUE" "required environment variable [$var] is unset or empty"
    fi
  done
}

# Fatals unless the effective APP_DOMAIN is a real cloud domain. Since RFC 95 the
# deploy/infra path layers `.env -> .env.<env>` and NEVER .env.dev, so APP_DOMAIN
# (which lives in .env.dev, not the base) is UNSET when a cloud .env.<env> omits
# it — the omitted-key fatal is now require_env_vars APP_DOMAIN's job. This guard's
# remaining, still-needed job is to reject a target whose resolved APP_DOMAIN is
# `localhost`: that value now arrives only from an operator mistargeting `local`/dev
# on the deploy/infra path (where the SSM/OpenTofu action has no meaning), never
# from a base default. Body unchanged: fatal unless APP_DOMAIN is set and non-
# localhost. Takes the env name for the message. Depends only on fatal (this file).
require_cloud_domain() {
  local env="$1"
  if [ -z "${APP_DOMAIN:-}" ] || [ "$APP_DOMAIN" = "localhost" ]; then
    fatal -s "$EXIT_INVALID_ARG_VALUE" \
      "cloud environment [$env] has APP_DOMAIN=[${APP_DOMAIN:-<unset>}]; its .env.$env must set APP_DOMAIN to a real domain (not localhost)"
  fi
}

# Resolves a file argument to an absolute local path: a local path via
# realpath, or an `s3://` URI downloaded into the caller-supplied `scratch_dir`
# (ignored otherwise). Always called via `VAR="$(resolve_file_arg ...)"`, a
# subshell — so scratch_dir's creation and cleanup belong to the caller, not
# this function, which would lose them the moment the subshell exits.
# Shared by any ops-tool script that takes file arguments (bin/ingest-colleges).
# Depends on fatal (this file); the s3:// branch also on `aws`.
# Single source of truth for the college installDist location, repo-relative.
# bin/deploy tars THIS exact path PRESERVED (unstripped), so it resolves
# identically in the local dev tree and under /opt/unicoach/current; and
# bin/ingest-colleges execs $PROJECT_ROOT/$COLLEGE_DIST/bin/college. bin/functions
# ships in the deploy bundle and is sourced in both trees, so the constant is
# available on the instance too. Defined once here so the two consumers can never
# drift on the path.
COLLEGE_DIST="college/build/install/college"

resolve_file_arg() {
  local arg="$1" scratch_dir="${2:-}"
  if [ -z "$arg" ]; then
    fatal -s "$EXIT_MISSING_REQUIRED_ARG" "resolve_file_arg requires a path or s3:// URI"
  fi

  case "$arg" in
  s3://*)
    if [ -z "$scratch_dir" ]; then
      fatal "resolve_file_arg requires a scratch_dir to download [$arg] into"
    fi
    # A fresh subdirectory per download: two s3:// args sharing one scratch_dir
    # would otherwise collide if their objects share a basename.
    local dest_dir
    dest_dir="$(mktemp -d -p "$scratch_dir")"
    local dest="$dest_dir/$(basename "$arg")"
    aws s3 cp "$arg" "$dest" >&2 || fatal "failed to download s3 object [$arg]"
    echo "$dest"
    ;;
  *)
    # Capture realpath's own stderr and fold it into the fatal rather than
    # collapsing every failure into a fixed "file not found": permission-denied,
    # ELOOP (symlink cycle), and name-too-long all reach here, and discarding the
    # real cause would misreport them (mirrors the poll loop's stderr capture in
    # bin/remote). On success stdout carries the resolved absolute path; on
    # failure `err` carries realpath's diagnostic.
    local resolved err
    err="$(mktemp)"
    if ! resolved="$(realpath "$arg" 2>"$err")"; then
      local msg
      msg="$(cat "$err")"
      rm -f "$err"
      fatal "could not resolve [$arg]: [$msg]"
    fi
    rm -f "$err"
    echo "$resolved"
    ;;
  esac
}

transform_duration_to_postgres() {
  local input="$1"
  validate_duration "$input" || return 1
  local unit="${input: -1}"
  local value="${input%?}"
  case "$unit" in
    s) echo "$value seconds" ;;
    m) echo "$value minutes" ;;
    h) echo "$value hours" ;;
    d) echo "$value days" ;;
    *) return 1 ;;
  esac
}

# Returns 0 iff $1 is a syntactically valid AWS account id (exactly 12 digits),
# non-zero otherwise. The single owner of the account-id-format rule, mirroring
# validate_port. Pure: no network, no AWS call.
validate_aws_account_id() {
  local account_id="$1"
  [[ "$account_id" =~ ^[0-9]{12}$ ]]
}

# Fail-fast deploy guard: assert the AWS account the active credentials resolve
# to matches the one this deployment expects, before any tofu/aws action can
# target it. $1 is the expected 12-digit account id (AWS_ACCOUNT_ID from the
# deploy-control file, .env.deploy.<env>). Fatals — naming expected vs actual — when the
# expected id is missing/malformed, when the live identity cannot be resolved, or
# when the two differ, so a stray ambient AWS profile can never silently deploy
# to the wrong account. Resolves the live identity via `aws sts
# get-caller-identity`.
assert_aws_account() {
  local expected="$1"
  if ! validate_aws_account_id "$expected"; then
    fatal "AWS_ACCOUNT_ID must be the target account's 12-digit id; got [$expected]. Set it in .env.deploy.<env>."
  fi
  local actual
  if ! actual="$(aws sts get-caller-identity --query Account --output text 2>/dev/null)"; then
    fatal "Could not resolve the active AWS account ('aws sts get-caller-identity' failed). Is an AWS session active?"
  fi
  if [ "$actual" != "$expected" ]; then
    fatal "Wrong AWS account: active credentials target [$actual] but this deploy expects [$expected]. Fix AWS_PROFILE / your credentials before retrying."
  fi
}

# Load a cloud env's deploy-control config and assert the AWS account, in one
# step. $1 is the cloud-env selector (UNICOACH_ENV, e.g. prod). Resolves
# $PROJECT_ROOT/.env.deploy.<env> (deploy-control only: AWS_ACCOUNT_ID / REGION /
# the AWS_REGION derivation), fatals (bracketed path) if it is absent, sources it
# under `set -a` so its keys export, then calls assert_aws_account with the sourced
# AWS_ACCOUNT_ID so a stray ambient profile fails loudly before any tofu/aws action.
# The single owner of the deploy-control bootstrap shared by bin/deploy,
# bin/remote, bin/infra-plan, and bin/infra-apply. Depends on PROJECT_ROOT (set by
# bin/common), fatal, and assert_aws_account (this file).
load_deploy_control_env() {
  local env="$1"
  local deploy_env_file="$PROJECT_ROOT/.env.deploy.$env"
  [ -f "$deploy_env_file" ] || fatal "Deploy-control file not found [$deploy_env_file]."
  set -a
  # shellcheck source=/dev/null
  source "$deploy_env_file"
  set +a

  assert_aws_account "${AWS_ACCOUNT_ID:-}"
}

# Encode a string as a complete JSON string literal (surrounding quotes included),
# reusing Python's json.dumps — a correct, tested JSON encoder that escapes every
# case, control characters and non-ASCII included. A hand-rolled encoder that
# escaped only \ and " would emit invalid JSON the moment the string held a literal
# newline or tab — which the multi-line install script bin/deploy composes always
# does. No jq is needed (the dev shell ships awscli2, not jq); python3 is already
# used across bin/ (test-fuzz, test-tcp-listener). Callers wrap this via
# ssm_shell_command_parameters below; not used raw.
json_string() {
  python3 -c 'import json, sys; sys.stdout.write(json.dumps(sys.argv[1]))' "$1"
}

# Build the full `aws ssm send-command --parameters` value for AWS-RunShellScript
# as a JSON OBJECT — {"commands":["<script>"]} — NOT the `commands=[...]` shorthand.
# The shorthand parser does NOT JSON-decode escapes, so a `\n` in a multi-line
# script has its backslash stripped and the whole script collapses onto line 1
# (the instance then runs `set -euo pipefailn...` and dies). The JSON-object form
# is decoded by the CLI, so newlines survive. json_string JSON-encodes the script
# (quotes + escapes); this wraps it as the single `commands` element. Shared by
# bin/deploy (multi-line install script) and bin/remote (single-line tool command).
ssm_shell_command_parameters() {
  printf '{"commands":[%s]}' "$(json_string "$1")"
}

# Build the remote install-then-deploy script that bin/deploy transmits via SSM
# Run Command (AWS-RunShellScript); the instance runs it under bash. Named to match
# its sibling build_remote_command (bin/remote), which assembles bin/remote's SSM
# command the same way. Emitted as a
# multi-line script on stdout; the caller JSON-encodes it as the single `commands`
# element (json_string). It is transmitted fresh every deploy so it can update its
# OWN on-instance bootstrap: download and unpack the bundle, install this release's
# render-env / deploy-on-instance (0755) and the five systemd units (0644),
# `systemctl daemon-reload`, then `systemctl enable` those units (idempotent, and
# `enable` only — never `--now` — so it registers them for reboot persistence
# without starting anything; deploy-on-instance's `restart` is what (re)starts
# them), then invoke the now-current deploy-on-instance with the extracted release
# dir. Enabling here (not just at cloud-init first boot) is what lets a unit added
# to an already-running instance survive a reboot. The install MUST live in this
# transmitted script, never a pre-installed on-instance one: an old
# deploy-on-instance carrying no install logic would run first and never install
# its replacement. Because the script is sent
# anew each deploy, it works against the current old box with zero manual
# bootstrapping — closing the gap that previously forced a manual SSM live-write
# when these files changed. $1 bundle_id (names the release dir, correlating it with
# the S3 bundle), $2 AWS region, $3 the bundle's s3:// URI — all laptop-side, baked
# in; every other `$` is escaped so it resolves on the instance. Pure string
# assembly (no AWS call), so scripts-tests drives it directly.
build_deploy_command() {
  local bundle_id="$1" region="$2" s3_uri="$3"
  cat << EOF
set -euo pipefail
RELEASE_DIR="/opt/unicoach/releases/$bundle_id"
mkdir -p "\$RELEASE_DIR"
BUNDLE_TMP="\$(mktemp)"
trap 'rm -f "\$BUNDLE_TMP"' EXIT
aws s3 cp --region $region $s3_uri "\$BUNDLE_TMP"
tar -xzf "\$BUNDLE_TMP" -C "\$RELEASE_DIR"
chown -R unicoach:unicoach "\$RELEASE_DIR"
install -m 0755 "\$RELEASE_DIR/infra/files/render-env.sh" /opt/unicoach/bin/render-env
install -m 0755 "\$RELEASE_DIR/infra/files/deploy-on-instance.sh" /opt/unicoach/bin/deploy-on-instance
install -m 0644 \\
  "\$RELEASE_DIR/infra/files/unicoach-rest-server.service" \\
  "\$RELEASE_DIR/infra/files/unicoach-queue-worker.service" \\
  "\$RELEASE_DIR/infra/files/unicoach-cron.service" \\
  "\$RELEASE_DIR/infra/files/unicoach-public-web.service" \\
  "\$RELEASE_DIR/infra/files/unicoach-admin-web.service" \\
  /etc/systemd/system/
systemctl daemon-reload
systemctl enable \\
  unicoach-rest-server.service unicoach-queue-worker.service unicoach-cron.service \\
  unicoach-public-web.service unicoach-admin-web.service
/opt/unicoach/bin/deploy-on-instance "\$RELEASE_DIR"
EOF
}

