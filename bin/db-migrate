#!/usr/bin/env bash
source "$(dirname "$0")/common"

help() {
  cat << 'EOF'
db-migrate [options]

Executes all pending database migrations in the order declared by
$DB_SCHEMA_DIR/ORDER, skipping the ones schema_migrations already records.
Refuses, before applying anything, when ORDER and the schema directory disagree.
Halts immediately upon any query execution failure.
Automatically provisions the database and tracking tables if missing (via
db-create; assumes db-bootstrap has already created the cluster and role).

Options:
  -h:    Help
EOF
  exit 0
}

while getopts ":h" opt; do
  case "$opt" in
  h) help ;;
  \?) fatal -s "$EXIT_UNKNOWN_OPTION" "unknown option [-$OPTARG]" ;;
  :)  fatal -s "$EXIT_OPTION_REQUIRES_VALUE" "option [-$OPTARG] requires an argument" ;;
  esac
done
shift $((OPTIND-1))

if [ "$#" -gt 0 ]; then
  fatal -s "$EXIT_UNEXPECTED_ARG" "db-migrate does not accept positional arguments: [$*]"
fi

# The database has to exist before it can be asked what it has applied. db-status
# used to do this on db-migrate's behalf; the ORDER walk reads the corpus itself,
# so the provisioning step is explicit here. Its chatter is a diagnostic, and the
# line below names the DATABASE it is about to provision, because db-create's own
# output is the only other place that name appears in a deploy log.
log-info "Provisioning database [$POSTGRES_DB] if it is not already provisioned."
"$PROJECT_ROOT/bin/db-create" 1>&2

# What is still pending, in the declared order (RFC 180), computed by bin/common
# so that db-migrate and db-status cannot disagree about it. schema_pending_files
# fatals — naming EVERY offending file, one section per kind of disagreement —
# when ORDER and $DB_SCHEMA_DIR disagree, and it does so BEFORE the first BEGIN
# below, so a corpus that disagrees with itself never half-applies. The filename
# grammars are part of that pre-flight check, so an illegal name at pending #12
# can no longer abort a run that has already committed eleven migrations.
# `|| exit $?` is not decoration: `set -e` does not reliably abort on a command
# substitution whose subshell died inside a function, and a swallowed refusal here
# would read as "nothing pending" — a silent no-op on a corpus that should have
# stopped the run. The status it carries is not only the corpus refusal
# (EXIT_SCHEMA_ORDER_DRIFT): schema_pending_files also queries the database
# through bin/db-query and PASSES THAT STATUS THROUGH, so an unreachable cluster
# arrives here as EXIT_POSTGRES_UNREACHABLE. Both are re-raised verbatim, which
# is why this is `exit $?` and not `exit 1`.
pending_lines=$(schema_pending_files "$DB_SCHEMA_DIR") || exit $?

pending_files=()
while IFS= read -r base; do
  [ -n "$base" ] || continue
  pending_files+=("$base")
done <<< "$pending_lines"

if [ "${#pending_files[@]}" -eq 0 ]; then
  log-info "Database is fully migrated."
  exit 0
fi

# One migration as a block of the session's script: its SQL and the row that
# records it commit together or not at all, exactly as when each migration had a
# psql of its own. Extracted so the walk below reads as the ORDER walk it is.
#
# DISCARD ALL after the COMMIT is what a fresh connection per migration used to
# give for free: a SET, a temp table or a prepared statement in one migration
# cannot leak into the next. It must follow the COMMIT — it refuses to run inside
# a transaction block.
#
# \warn writes the progress line to psql's stderr, so it appears as the file
# STARTS, the same moment and stream as the log-info it replaces.
migration_block() {
  local base="${1:?migration_block requires a migration filename as an argument}"
  local file="$DB_SCHEMA_DIR/$base"

  # A cheap assertion, not the check: the corpus validator above already refused
  # every illegal name. It stays because the lines below interpolate $base into
  # SQL and a psql meta-command, and an interpolation site should not have to
  # trust a caller three functions away.
  schema_filename_is_valid "$base" \
    || fatal "Invalid migration filename [$base] reached the apply loop; the corpus check in bin/common should have refused it."

  echo "\\warn 'Migrating: [$base]'"
  echo "BEGIN;"
  cat "$file"
  echo ""
  echo "INSERT INTO schema_migrations (filename) VALUES ('$base');"
  echo "COMMIT;"
  echo "DISCARD ALL;"
}

# The whole pending set is ONE psql session. A process chain per
# migration -- db-write and db-run each sourcing bin/common, then a psql and a
# fresh connection -- cost ~0.2s, which over 162 migrations was 35s of a 35.4s
# db-reset; the SQL itself applies in under half a second. db-run's ON_ERROR_STOP
# stops the session at the first error, so nothing after a failing migration
# runs, and the failing one's open transaction dies with the connection.
#
# Every block is validated BEFORE any SQL is sent: the script is built in full
# first, so a refusal from migration_block never leaves a half-sent session.
total="${#pending_files[@]}"
script=""
for base in "${pending_files[@]}"; do
  script+="$(migration_block "$base")"$'\n' || exit $?
done

status=0
printf '%s' "$script" | "$PROJECT_ROOT/bin/db-write" || status=$?

# What the session committed is read back from schema_migrations on BOTH paths,
# never inferred from psql's exit status or parsed out of its output. On failure
# that is the only place the answer lives: one session does not know which block
# it died in. On success it is the check that the status told the truth: a
# migration containing `\q` ends the session with status 0 and skips every block
# after it. A session per migration confined that to one file; one session for
# the whole set would otherwise report it as a clean run.
#
# When the database cannot be asked, the counts are unknown, and the message says
# that instead of guessing. db-write's status is carried throughout: collapsing it
# to fatal's flat 1 made an unreachable cluster (EXIT_POSTGRES_UNREACHABLE)
# indistinguishable from bad SQL in a migration.
applied_status=0
applied="$(schema_applied_files)" || applied_status=$?
if [ "$applied_status" -ne 0 ]; then
  fatal -s "$(( status != 0 ? status : applied_status ))" "Migration run ended with status [$status], and schema_migrations could not be read afterwards (status [$applied_status]), so which migrations committed is UNKNOWN. Run bin/db-status once the database is reachable; re-running bin/db-migrate resumes from the first unrecorded migration."
fi

committed=0
for base in "${pending_files[@]}"; do
  schema_file_is_applied "$base" "$applied" || break
  committed=$(( committed + 1 ))
done

if [ "$status" -eq 0 ] && [ "$committed" -eq "$total" ]; then
  log-info "All [$total] migration(s) applied successfully."
  exit 0
fi

if [ "$committed" -eq "$total" ]; then
  fatal -s "$status" "Migration run failed (status [$status]) after all [$total] pending migration(s) COMMITTED; the failure was outside any migration. bin/db-status shows the recorded state."
fi

# Each migration is its OWN transaction, so a failure at pending #5 of 12 leaves
# four COMMITTED and seven unattempted, and the halt message has to say so. The
# failing migration is the FIRST pending one the database does not record. That
# holds even when a migration's own text swallows the ones after it (an unclosed
# $$ quote): nothing past it can commit.
failed="${pending_files[$committed]}"
if [ "$status" -eq 0 ]; then
  fatal "Migration run ended early: psql reported success, but [$failed] and every migration after it are NOT recorded in schema_migrations ([$committed] of [$total] pending migration(s) COMMITTED). A meta-command such as \\q in [$failed] ends the session; remove it and re-run bin/db-migrate, which resumes from [$failed]."
fi
fatal -s "$status" "Migration failed: [$failed]. Halting. [$committed] of [$total] pending migration(s) already COMMITTED; [$(( total - committed - 1 ))] not attempted. The committed ones are recorded in schema_migrations, so re-running bin/db-migrate after fixing [$failed] resumes from it."
