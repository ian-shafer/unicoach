#!/usr/bin/env bash

source "$(dirname "$0")/common"

help() {
  cat << 'EOF'
pre-commit [options]

Native validation script run before committing. Runs two gates concurrently:
the Gradle test suite (bin/test check) and the format/lint check (bin/format -c,
the repo's single ktlint + deno fmt avenue).

When EVERY staged path is under product/ the test half is skipped and only
bin/format -c runs: nothing under product/ is a build input, so bin/test check
cannot change its answer. Anything else -- a mixed set, an empty index, a rename
crossing the product/ boundary -- runs the full gate. The classification is
logged to stderr by name.

Options:
  -h: Help
EOF
  exit 0
}

while getopts ":h" opt; do
  case "$opt" in
  h) help ;;
  \?) fatal -s "$EXIT_UNKNOWN_OPTION" "unknown option [-$OPTARG]" ;;
  :)  fatal -s "$EXIT_OPTION_REQUIRES_VALUE" "option [-$OPTARG] requires an argument" ;;
  esac
done
shift $((OPTIND-1))

if [ "$#" -ne 0 ]; then
  fatal -s "$EXIT_UNEXPECTED_ARG" "Error: pre-commit accepts no positional arguments."
fi

# The gate below needs deno, the JVM, and Postgres — all dev-shell tools. Refuse
# early with a clear message rather than failing deep in the gate with
# "deno: command not found" / "Unable to locate a Java Runtime". This is the
# is-nix guard the iOS scripts use, in the opposite direction: they refuse inside
# the dev shell, pre-commit refuses outside it.
# Deliberately NOT -q: is-nix's status line names which of the three states it
# found, and the confusing one — a different flake's shell, none of this
# toolchain in it (RFC 114) — is invisible under -q, which is what left an
# operator staring at "not in the dev shell" from inside an active Nix shell.
# Called once and branched on directly, so no outcome is discarded; the cost is
# one confirming line on the happy path.
if ! "$PROJECT_ROOT/bin/is-nix"; then
  fatal "pre-commit must run inside the unicoach Nix dev shell. Commit via 'nix develop -c git commit ...' or from a 'nix develop' shell."
fi

# Classify the staged set BEFORE anything starts, and log which gate this run is
# (RFC 194). A commit that skipped the test half and one that ran it must be
# distinguishable from the hook output alone -- the same reason RFC 183 logs its
# withholding rather than withholding silently.
DOCS_ONLY=0
if staged_changes_are_product_docs_only "$PROJECT_ROOT"; then
  DOCS_ONLY=1
  log-info "gate scope: product-docs-only -- every staged path is under product/; running bin/format -c only, skipping bin/test check (product/ is not a build input)."
else
  log-info "gate scope: full -- running bin/format -c and bin/test check concurrently."
fi

# Two concurrent gates: the test suite, and the format/lint check. ktlint lives
# only in bin/format (no Gradle ktlint plugin), so `bin/format -c` is the single
# Kotlin+Markdown lint gate; `bin/test check` runs the Gradle tests.
#
# bin/format -c runs on BOTH paths. It is the only Markdown gate in the repo and
# costs ~8s, which is why the product-docs exemption skips the test half and not
# the hook: a blanket --no-verify would take the one check those commits need.
TEST_STATUS=0
LINT_STATUS=0

if [ "$DOCS_ONLY" -eq 0 ]; then
  "$PROJECT_ROOT/bin/test" check &
  TEST_PID=$!
fi

"$PROJECT_ROOT/bin/format" -c &
LINT_PID=$!

if [ "$DOCS_ONLY" -eq 0 ]; then
  wait $TEST_PID || TEST_STATUS=$?
fi
wait $LINT_PID || LINT_STATUS=$?

FAILED=0

if [ "$TEST_STATUS" -ne 0 ]; then
  log-info "Test suite failed (Status: $TEST_STATUS)"
  FAILED=1
fi

if [ "$LINT_STATUS" -ne 0 ]; then
  log-info "Format/lint check failed (Status: $LINT_STATUS)"
  FAILED=1
fi

if [ "$FAILED" -ne 0 ]; then
  log-info "Pre-commit checks failed."
  exit 2
fi

# Fuzz the committed REST contract only when this commit changes it. test-fuzz
# boots a freshly-built rest-server and runs Schemathesis against
# api-specs/openapi.yaml — too heavy to run on every commit, so it is gated on
# the spec being staged. It runs sequentially, after the concurrent checks pass,
# so a commit already destined to fail does not pay the multi-minute fuzz cost
# and so two gradle builds (bin/test check, build-rest-server) never contend.
SPEC_REL_PATH="api-specs/openapi.yaml"
if git -C "$PROJECT_ROOT" diff --cached --name-only --diff-filter=ACMR -- "$SPEC_REL_PATH" | grep -q .; then
  log-info "[$SPEC_REL_PATH] is staged; running bin/test-fuzz against the REST contract..."
  if ! "$PROJECT_ROOT/bin/test-fuzz"; then
    log-info "Contract fuzzing failed. Pre-commit checks failed."
    exit 2
  fi
else
  log-info "[$SPEC_REL_PATH] unchanged; skipping contract fuzzing."
fi

# Record the tree this run validated, as the local stand-in for CI (there is
# none: one engineer). The marker is what lets the `ship` workflow refuse to
# land a tip that never passed this hook — throwaway `--no-verify` checkpoints
# are safe precisely because landing checks for this. Recording the TREE, not
# the commit sha, means an amend or a rebase that preserves content stays
# verified while any content change does not. Inert for anything that does not
# ask: the marker lives inside .git and nothing else reads it.
# NOT recorded on the product-docs-only path. The marker means "the full
# pre-commit gate passed on this tree"; recording it after skipping the tests
# would put a lie in the one file that stops unverified code landing, and a
# marker that can lie is worse than no marker. The failure this accepts is the
# safe direction: a /ship run whose branch TIP were a product-only commit is
# refused at land, and one re-commit fixes it.
SHIP_VERIFIED="$PROJECT_ROOT/.prime/agent/skills/ship/scripts/ship-verified"
if [ "$DOCS_ONLY" -eq 1 ]; then
  log-info "product-docs-only run: not recording a verified tree (the full gate did not run)."
elif [ -x "$SHIP_VERIFIED" ]; then
  "$SHIP_VERIFIED" record || log-info "warning: could not record verified tree (continuing)"
fi

log-info "Pre-commit checks passed."
