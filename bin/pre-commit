#!/usr/bin/env bash

source "$(dirname "$0")/common"

help() {
  cat << 'EOF'
pre-commit [options]

Native validation script run before committing. Runs two gates concurrently:
the test suite and the format/lint check (bin/format -c, the repo's single
ktlint + deno fmt avenue).

WHAT the test half runs is decided by bin/gate-scope, which classifies the
staged set as a whole and says whether Gradle is needed and which shell
harnesses can observe those paths (RFC 214). A Markdown-only commit runs
bin/format -c alone; a .prime/ script commit runs the three harnesses that
observe .prime/; a commit inside a Gradle module's src/ tree runs Gradle and
bin/scripts-tests; anything unrecognised, mixed, or an empty index runs
everything. bin/format -c runs on EVERY path -- it is the only Markdown gate in
the repo.

The chosen scope is logged to stderr by name, so two commits that ran different
gates are distinguishable from the hook output alone. A commit that did not run
the FULL gate records no ship-verified marker.

Options:
  -h: Help
EOF
  exit 0
}

while getopts ":h" opt; do
  case "$opt" in
  h) help ;;
  \?) fatal -s "$EXIT_UNKNOWN_OPTION" "unknown option [-$OPTARG]" ;;
  :)  fatal -s "$EXIT_OPTION_REQUIRES_VALUE" "option [-$OPTARG] requires an argument" ;;
  esac
done
shift $((OPTIND-1))

if [ "$#" -ne 0 ]; then
  fatal -s "$EXIT_UNEXPECTED_ARG" "Error: pre-commit accepts no positional arguments."
fi

# The gate below needs deno, the JVM, and Postgres — all dev-shell tools. Refuse
# early with a clear message rather than failing deep in the gate with
# "deno: command not found" / "Unable to locate a Java Runtime". This is the
# is-nix guard the iOS scripts use, in the opposite direction: they refuse inside
# the dev shell, pre-commit refuses outside it.
# Deliberately NOT -q: is-nix's status line names which of the three states it
# found, and the confusing one — a different flake's shell, none of this
# toolchain in it (RFC 114) — is invisible under -q, which is what left an
# operator staring at "not in the dev shell" from inside an active Nix shell.
# Called once and branched on directly, so no outcome is discarded; the cost is
# one confirming line on the happy path.
# Never develop on main, and never commit in the root checkout (RFC 201).
#
# FIRST, ahead of the dev-shell refusal above all else, because this one needs no
# toolchain to answer and refusing twice in a row -- once for the shell, then
# once for the branch -- would spend a second round trip on news we already had.
#
# The two hazards this closes were measured on 2026-09-11, an hour apart, with
# two sessions sharing this one checkout: the hook validates the whole WORKING
# TREE rather than the commit, so one session's unstaged file failed another
# session's 4m17s gate run; and `git add <path>` is silent about whose path it
# is, so a docs commit swept up 63 lines of another session's in-progress spec.
# Both have one root cause -- two writers in one tree -- and /ship had already
# solved it for code by giving every run its own worktree. This makes that the
# rule for documentation too, and the enforcement is here rather than in a skill
# file because an instruction an agent can forget is not an enforcement.
#
# The refusal MESSAGE is the migration. An in-flight session adopts this by being
# refused mid-close-out, so the text below has to carry the whole recipe: what was
# refused, the exact command with this session's own staged product/ paths filled
# in, and the fact that no work is lost. An error that makes the reader go and
# find an RFC is a worse error.
if COMMIT_REFUSAL="$(protected_commit_target "$PROJECT_ROOT")"; then
  log-error "refusing this commit: $COMMIT_REFUSAL."
  log-info ""
  log-info "  Nothing is lost. Your files are still here, exactly as you left them;"
  log-info "  only the commit was refused. Move them to a worktree and commit there."
  log-info ""

  # The staged set, and ONLY the staged set. Other dirty paths under product/ may
  # belong to another live session, and a recipe that swept them in would be the
  # very hazard 4 this rule exists to close -- printed by the thing that closes
  # it. Enumerate what you are about to act on, then act.
  DOCS_PATHS=()
  while IFS= read -r -d '' staged_path; do
    DOCS_PATHS+=("$staged_path")
  done < <(git -C "$PROJECT_ROOT" diff --cached --name-only -z --no-renames -- product/)

  if [ "${#DOCS_PATHS[@]}" -gt 0 ]; then
    # A slug from the first staged path's own directory, so the common case
    # (one brief) needs no thought: product/0011-beyond-money/spec.md -> 0011-beyond-money.
    DOCS_SLUG="$(printf '%s' "${DOCS_PATHS[0]}" | sed -n 's|^product/\([^/]*\)/.*|\1|p')"
    [ -n "$DOCS_SLUG" ] || DOCS_SLUG="status"
    DOCS_CMD=".prime/agent/skills/chart/scripts/docs-claim -s $DOCS_SLUG"
    for staged_path in "${DOCS_PATHS[@]}"; do
      DOCS_CMD="$DOCS_CMD -a $(printf '%q' "$staged_path")"
    done
    log-info "  Your staged product/ paths, and the command that moves them:"
    log-info ""
    log-info "    $DOCS_CMD"
    log-info ""
    log-info "  Then commit in the worktree it prints, and:"
    log-info ""
    log-info "    .prime/agent/skills/chart/scripts/docs-land -s <run-scratch>"
    log-info ""
    log-info "  -a takes only the paths NAMED above. This checkout is shared: do not"
    log-info "  add a path you did not write."
  else
    log-info "  For product/ documentation:"
    log-info ""
    log-info "    .prime/agent/skills/chart/scripts/docs-claim -s <slug> -a <your-path>..."
    log-info "    .prime/agent/skills/chart/scripts/docs-land  -s <run-scratch>"
    log-info ""
    log-info "  For code: .prime/agent/skills/ship/scripts/ship-claim -l rfc|quick,"
    log-info "  which is the /ship run that already works this way."
  fi
  exit 2
fi

if ! "$PROJECT_ROOT/bin/is-nix"; then
  fatal "pre-commit must run inside the unicoach Nix dev shell. Commit via 'nix develop -c git commit ...' or from a 'nix develop' shell."
fi

# Classify the staged set BEFORE anything starts, and log which gate this run is
# (RFC 194, RFC 214). A commit that skipped part of the gate and one that ran all
# of it must be distinguishable from the hook output alone -- the same reason
# RFC 183 logs its withholding rather than withholding silently.
#
# ONE QUESTION, ONE SCRIPT. bin/gate-scope owns the whole path-to-what-runs map
# and this is its only caller today; /ship phase 5 may call the SAME script later.
# The hook must never grow its own copy of the table: a wrong map here does not
# fail silently (nothing downstream catches it), which is exactly why the map
# lives in one tested place with its own harness.
#
# gate-scope fatals on a bin/*scripts-tests it does not know, so a failure here
# stops the commit rather than quietly running a smaller set.
GATE_SCOPE_OUT="$("$PROJECT_ROOT/bin/gate-scope")" || {
  log-error "bin/gate-scope could not classify the staged set; refusing to guess what to run."
  exit 2
}
SCOPE=""
GRADLE=""
HARNESSES=""
while IFS='=' read -r key value; do
  case "$key" in
  scope) SCOPE="$value" ;;
  gradle) GRADLE="$value" ;;
  harnesses) HARNESSES="$value" ;;
  # A line gate-scope grew that this reader does not know is a contract change
  # between two files that must agree. Refusing beats ignoring: ignoring would
  # run the old gate shape against a new answer and say nothing.
  *) fatal "bin/gate-scope emitted an unrecognised line [$key=$value]" ;;
  esac
done <<< "$GATE_SCOPE_OUT"

if [ -z "$SCOPE" ] || [ -z "$GRADLE" ]; then
  fatal "bin/gate-scope did not report a scope and a gradle decision"
fi

# Two concurrent gates: the test half, and the format/lint check. ktlint lives
# only in bin/format (no Gradle ktlint plugin), so `bin/format -c` is the single
# Kotlin+Markdown lint gate.
#
# bin/format -c runs on EVERY path. It is the only Markdown gate in the repo and
# costs ~8s, which is why a narrow scope skips the test half and not the hook: a
# blanket --no-verify would take the one check those commits need.
#
# Three shapes, and which one runs is gate-scope's answer, not this script's
# judgement:
#
#   gradle=yes  -> bin/test check, narrowed with -n when the harness set is not
#                  ALL. This is the unchanged full gate when scope=full.
#   gradle=no + harnesses -> bin/shell-tests directly. No Gradle task graph, no
#                  installDist, no db-reset: a diff that cannot move any of them
#                  should not pay for them.
#   gradle=no, no harnesses -> bin/format -c alone.
TEST_STATUS=0
LINT_STATUS=0
TEST_PID=""

TEST_CMD=()
if [ "$GRADLE" = "yes" ]; then
  TEST_CMD=("$PROJECT_ROOT/bin/test" check)
  if [ -n "$HARNESSES" ] && [ "$HARNESSES" != "ALL" ]; then
    for harness in $HARNESSES; do
      TEST_CMD+=(-n "$harness")
    done
  fi
elif [ -n "$HARNESSES" ] && [ "$HARNESSES" != "ALL" ]; then
  TEST_CMD=("$PROJECT_ROOT/bin/shell-tests")
  for harness in $HARNESSES; do
    TEST_CMD+=(-n "$harness")
  done
elif [ "$HARNESSES" = "ALL" ]; then
  # gradle=no with harnesses=ALL is not a shape any row produces, and guessing
  # which half to skip is exactly the silent-wrong-answer this script must not
  # produce. Refuse.
  fatal "bin/gate-scope reported gradle=no with harnesses=ALL, which is not a gate shape this hook knows"
fi

if [ "${#TEST_CMD[@]}" -gt 0 ]; then
  log-info "test half: ${TEST_CMD[*]}"
  "${TEST_CMD[@]}" &
  TEST_PID=$!
else
  log-info "test half: nothing to run for scope [$SCOPE]; bin/format -c is the whole gate."
fi

"$PROJECT_ROOT/bin/format" -c &
LINT_PID=$!

if [ -n "$TEST_PID" ]; then
  wait $TEST_PID || TEST_STATUS=$?
fi
wait $LINT_PID || LINT_STATUS=$?

FAILED=0

if [ "$TEST_STATUS" -ne 0 ]; then
  log-info "Test suite failed (Status: $TEST_STATUS)"
  FAILED=1
fi

if [ "$LINT_STATUS" -ne 0 ]; then
  log-info "Format/lint check failed (Status: $LINT_STATUS)"
  FAILED=1
fi

if [ "$FAILED" -ne 0 ]; then
  log-info "Pre-commit checks failed."
  exit 2
fi

# Fuzz the committed REST contract only when this commit changes it. test-fuzz
# boots a freshly-built rest-server and runs Schemathesis against
# api-specs/openapi.yaml — too heavy to run on every commit, so it is gated on
# the spec being staged. It runs sequentially, after the concurrent checks pass,
# so a commit already destined to fail does not pay the multi-minute fuzz cost
# and so two gradle builds (bin/test check, build-rest-server) never contend.
SPEC_REL_PATH="api-specs/openapi.yaml"
if git -C "$PROJECT_ROOT" diff --cached --name-only --diff-filter=ACMR -- "$SPEC_REL_PATH" | grep -q .; then
  log-info "[$SPEC_REL_PATH] is staged; running bin/test-fuzz against the REST contract..."
  if ! "$PROJECT_ROOT/bin/test-fuzz"; then
    log-info "Contract fuzzing failed. Pre-commit checks failed."
    exit 2
  fi
else
  log-info "[$SPEC_REL_PATH] unchanged; skipping contract fuzzing."
fi

# Record the tree this run validated, as the local stand-in for CI (there is
# none: one engineer). The marker is what lets the `ship` workflow refuse to
# land a tip that never passed this hook — throwaway `--no-verify` checkpoints
# are safe precisely because landing checks for this. Recording the TREE, not
# the commit sha, means an amend or a rebase that preserves content stays
# verified while any content change does not. Inert for anything that does not
# ask: the marker lives inside .git and nothing else reads it.
# NOT recorded on ANY narrow scope -- only on `full` (RFC 194, widened by
# RFC 214). The marker means "the full pre-commit gate passed on this tree";
# recording it after skipping any part of the gate would put a lie in the one
# file that stops unverified code landing, and a marker that can lie is worse
# than no marker. The failure this accepts is the safe direction: a /ship run
# whose branch TIP is a narrow-scope commit is refused at land, and one
# re-commit fixes it. In practice a /ship run lands its code commit first and
# its RFC Markdown second, and the second is already --no-verify.
#
# Keyed on scope=full, NOT on "did the test half run at all". A module-source
# commit runs Gradle in full and one harness of nine; that is a real gate and a
# useful one, and it is still not THE gate, so it records nothing.
SHIP_VERIFIED="$PROJECT_ROOT/.prime/agent/skills/ship/scripts/ship-verified"
if [ "$SCOPE" != "full" ]; then
  log-info "scope [$SCOPE]: not recording a verified tree (the full gate did not run)."
elif [ -x "$SHIP_VERIFIED" ]; then
  "$SHIP_VERIFIED" record || log-info "warning: could not record verified tree (continuing)"
fi

log-info "Pre-commit checks passed."
