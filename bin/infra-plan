#!/usr/bin/env bash
# Thin wrapper over `tofu -chdir=infra plan` for one environment. Carries no
# resource logic — the HCL under infra/ is the sole source of resource
# definitions. The first positional is the cloud-env selector (UNICOACH_ENV, e.g.
# `prod`); it selects .env.<env> (the single source of that env's non-secrets),
# the per-env state dir (TF_DATA_DIR), and the TF_VAR_* inputs the HCL reads.
# Remaining args pass through to `tofu plan`.
source "$(dirname "$0")/common"

UNICOACH_ENV="${1:-}"
shift || true

# Pin ENV_FILE=.env.<env> and re-source bin/common so it layers exactly
# `.env -> .env.<env>` (never .env.dev — the chain rule; a dev value must not mask
# a missing TF_VAR_* source). unicoach_env_file needs PROJECT_ROOT (set by the
# top-of-file bin/common source); any inherited ENV_FILES is cleared first, since
# ENV_FILE and ENV_FILES are mutually exclusive.
ENV_FILE="$(unicoach_env_file "$UNICOACH_ENV")"
export ENV_FILE
unset ENV_FILES
# shellcheck source=/dev/null
source "$PROJECT_ROOT/bin/common"

# Assert the cloud-env app config first (from the already-loaded .env.<env>), so a
# missing key or a local/dev target is rejected before touching deploy-control/AWS.
require_env_vars APP_DOMAIN
require_cloud_domain "$UNICOACH_ENV"

# Deploy-control config (AWS_ACCOUNT_ID / REGION) from .env.deploy.<env>.
# load_deploy_control_env sources it and, fail-fast, refuses to run tofu against the
# wrong AWS account: a stray ambient profile can otherwise silently target the wrong
# account, so it asserts the active credentials resolve to the account this env
# declares (.env.deploy.<env>'s AWS_ACCOUNT_ID) before any tofu action.
load_deploy_control_env "$UNICOACH_ENV"

# TF_VAR_environment derives from the <env> argument (ENVIRONMENT is removed by
# RFC 95); the other TF_VAR_* come from .env.<env> / .env.deploy.<env>.
export TF_VAR_environment="$UNICOACH_ENV"
export TF_VAR_app_domain="$APP_DOMAIN"
export TF_VAR_public_web_port="$PUBLIC_WEB_PORT"
export TF_VAR_admin_web_port="$ADMIN_WEB_PORT"
[ -n "${HOSTED_ZONE_NAME:-}" ] && export TF_VAR_hosted_zone_name="$HOSTED_ZONE_NAME"
[ -n "${REGION:-}" ] && export TF_VAR_region="$REGION"

export TF_DATA_DIR="$PROJECT_ROOT/infra/.terraform-$UNICOACH_ENV"

# The S3 backend is partial (infra/backend.tf has no `key`): init supplies the
# per-env state key, so each env's state is disjoint and prod is never the silent
# default. TF_DATA_DIR keeps the local working dir per-env too.
tofu -chdir="$PROJECT_ROOT/infra" init \
  -backend-config="key=unicoach/$UNICOACH_ENV/terraform.tfstate"

exec tofu -chdir="$PROJECT_ROOT/infra" plan "$@"
