#!/usr/bin/env bash
# Schema-test harness for RFC 32 coaching conversations (convos,
# convo_requests) and the RFC 106 provider-agnostic LLM call log (llm_requests,
# llm_responses, llm_responses_raw). Since RFC 106 the response tables
# (convo_responses / convo_responses_raw) are dropped; a convo's response lives
# in llm_responses, reached via convo_requests.llm_request_id.
#
# Modeled on bin/db-users-tests, but this harness OWNS NO POSTGRES LIFECYCLE: it
# sets no EXIT/INT/TERM trap and runs no db-bootstrap/db-reset/db-migrate. It
# assumes a live, already-migrated database supplied by the caller (bin/test, or
# a developer who has run db-bootstrap then db-reset). Managing the shared
# cluster here would interfere with bin/test's subsequent Gradle phase.
# Layer `.env -> .env.dev -> .env.test` (RFC 95): the DB block lives in .env.dev.
# ENV_FILES is a PATH-like ':'-separated string, exported so the db-query/db-run
# child processes inherit the same stack and target the per-worktree test DB.
# bin/common resolves each entry against PROJECT_ROOT.
export ENV_FILES="${ENV_FILES:-.env.dev:.env.test}"
source "$(dirname "$0")/common"
source "$(dirname "$0")/tests-common"

# --- helpers --------------------------------------------------------------

# Run SQL inside a BEGIN/ROLLBACK so per-assertion writes never persist.
run_test_sql() {
  (
    echo "BEGIN;"
    cat
    echo "ROLLBACK;"
  ) | bin/db-run rw 2>&1
}

# Same, but tuples-only / unaligned for clean machine-readable output.
run_test_sql_ta() {
  (
    echo "BEGIN;"
    cat
    echo "ROLLBACK;"
  ) | bin/db-run -r rw 2>&1
}

# --- fixture --------------------------------------------------------------
# A committed users row, then a committed students row referencing it. The
# returned students.id is the student_id every convos case reuses. The fixture
# is committed (not rolled back) so the distinct psql processes spawned per
# assertion all observe it.

echo "==== Coaching Conversations: fixture setup ===="

# Insert the fixture user (committed), then read its id back.
echo "INSERT INTO users (email, name, password_hash)
      VALUES ('convos-fixture@example.com', 'Convos Fixture', 'hash');" \
  | bin/db-run rw >/dev/null

USER_ID=$(echo "SELECT id FROM users WHERE email = 'convos-fixture@example.com';" \
  | bin/db-query -r | grep -E '^[0-9a-f-]{36}$')

STUDENT_ID=$(
  echo "INSERT INTO students (user_id, expected_high_school_graduation_year)
        VALUES ('$USER_ID', 2030)
        RETURNING id;" | bin/db-run -r rw | grep -E '^[0-9a-f-]{36}$'
)

if [ -z "$STUDENT_ID" ]; then
  fail_test "fixture: could not create student row"
fi
pass_test "fixture user + student created (student_id=$STUDENT_ID)"

# A committed convo owned by the fixture student, reused by log cases that need
# a real convo_id. Likewise a committed request/response for response/raw cases.
CONVO_ID=$(
  echo "INSERT INTO convos (student_id, name) VALUES ('$STUDENT_ID', 'Fixture convo') RETURNING id;" \
    | bin/db-run -r rw | grep -E '^[0-9a-f-]{36}$'
)
if [ -z "$CONVO_ID" ]; then
  fail_test "fixture: could not create convo row"
fi
pass_test "fixture convo created (convo_id=$CONVO_ID)"

# A committed system_prompts row, FK-referenced by every committed and
# per-assertion convo_requests insert below. MUST precede the first
# convo_requests insert (REQUEST_ID and the CASCADE_* subtree), which now
# require a non-NULL system_prompt_id. Like the users/students/convos fixtures,
# its fixed (name, version) collides if the harness runs twice without a DB
# recreate; it relies on bin/test's db-reset (db-drop -> db-create -> db-migrate).
SYSTEM_PROMPT_ID=$(
  echo "INSERT INTO system_prompts (name, version, body)
        VALUES ('convos-fixture-prompt', 'v1', 'You are a helpful coach.')
        RETURNING id;" | bin/db-run -r rw | grep -E '^[0-9a-f-]{36}$'
)
if [ -z "$SYSTEM_PROMPT_ID" ]; then
  fail_test "fixture: could not create system_prompts row"
fi
pass_test "fixture system_prompt created (system_prompt_id=$SYSTEM_PROMPT_ID)"

# A committed llm_requests row every convo_requests insert references (RFC 106:
# the request I/O envelope lives in the generic call log; convo_requests carries
# only the coaching columns + llm_request_id). One fixture row is reused by the
# fixture request and every per-assertion convo_requests insert.
FIXTURE_LLM_REQUEST_ID=$(
  echo "INSERT INTO llm_requests (provider, model_requested, content, max_tokens)
        VALUES ('anthropic', 'claude-opus-4-8', '[]'::jsonb, 1024)
        RETURNING id;" | bin/db-run -r rw | grep -E '^[0-9]+$'
)
if [ -z "$FIXTURE_LLM_REQUEST_ID" ]; then
  fail_test "fixture: could not create llm_requests row"
fi
pass_test "fixture llm_request created (llm_request_id=$FIXTURE_LLM_REQUEST_ID)"

REQUEST_ID=$(
  echo "INSERT INTO convo_requests (turn_id, convo_id, system_prompt_id, llm_request_id)
        VALUES (nextval('convo_turn_id_seq'), '$CONVO_ID', '$SYSTEM_PROMPT_ID', $FIXTURE_LLM_REQUEST_ID)
        RETURNING id;" | bin/db-run -r rw | grep -E '^[0-9]+$'
)
if [ -z "$REQUEST_ID" ]; then
  fail_test "fixture: could not create convo_requests row"
fi
pass_test "fixture convo_request created (request_id=$REQUEST_ID)"

# A second, committed convo->request subtree used solely by the cascade-inert
# test. Committed (not rolled back) so the physical-delete attempt and the
# post-attempt survival check can run in separate connections — ON_ERROR_STOP
# aborts the raising statement's whole script, so the reject and the survival
# check cannot share one psql invocation.
CASCADE_CONVO_ID=$(
  echo "INSERT INTO convos (student_id, name) VALUES ('$STUDENT_ID', 'Cascade convo') RETURNING id;" \
    | bin/db-run -r rw | grep -E '^[0-9a-f-]{36}$'
)
CASCADE_REQUEST_ID=$(
  echo "INSERT INTO convo_requests (turn_id, convo_id, system_prompt_id, llm_request_id)
        VALUES (nextval('convo_turn_id_seq'), '$CASCADE_CONVO_ID', '$SYSTEM_PROMPT_ID', $FIXTURE_LLM_REQUEST_ID)
        RETURNING id;" | bin/db-run -r rw | grep -E '^[0-9]+$'
)
if [ -z "$CASCADE_CONVO_ID" ] || [ -z "$CASCADE_REQUEST_ID" ]; then
  fail_test "fixture: could not create cascade subtree"
fi
pass_test "fixture cascade subtree created (convo_id=$CASCADE_CONVO_ID)"

# ==========================================================================
echo "==== convos (entity) ===="
# ==========================================================================

test_convos_minimal_insert_no_name_rejected() {
  local out
  out=$(run_test_sql << EOF
    INSERT INTO convos (student_id) VALUES ('$STUDENT_ID');
EOF
  )
  echo "$out" | grep -qi 'null value in column "name"' || { echo "output was: $out"; return 1; }
}
assert_success "convos: insert with only student_id (no name) rejected (NOT NULL, 23502)" test_convos_minimal_insert_no_name_rejected

test_convos_minimal_insert_with_name() {
  local out
  out=$(run_test_sql_ta << EOF
    INSERT INTO convos (student_id, name) VALUES ('$STUDENT_ID', 'Calc help')
    RETURNING (id IS NOT NULL)
      || '|' || (created_at IS NOT NULL)
      || '|' || (row_created_at IS NOT NULL)
      || '|' || (updated_at IS NOT NULL)
      || '|' || (row_updated_at IS NOT NULL)
      || '|' || (deleted_at IS NULL);
EOF
  )
  echo "$out" | grep -q '^true|true|true|true|true|true$' || { echo "output was: $out"; return 1; }
}
assert_success "convos: minimal insert with student_id + name takes defaults" test_convos_minimal_insert_with_name

test_convos_bad_student_fk() {
  local out
  out=$(run_test_sql << 'EOF'
    INSERT INTO convos (student_id, name) VALUES ('00000000-0000-0000-0000-000000000000', 'Orphan');
EOF
  )
  echo "$out" | grep -q 'violates foreign key constraint' || { echo "output was: $out"; return 1; }
}
assert_success "convos: non-existent student_id rejected (FK)" test_convos_bad_student_fk

test_convos_name_null_rejected() {
  local out
  out=$(run_test_sql << EOF
    INSERT INTO convos (student_id, name) VALUES ('$STUDENT_ID', NULL);
EOF
  )
  echo "$out" | grep -qi 'null value in column "name"' || { echo "output was: $out"; return 1; }
}
assert_success "convos: NULL name rejected (NOT NULL, 23502)" test_convos_name_null_rejected

test_convos_name_too_long() {
  local out
  out=$(run_test_sql << EOF
    INSERT INTO convos (student_id, name)
    VALUES ('$STUDENT_ID', repeat('a', 256));
EOF
  )
  echo "$out" | grep -q 'convos_name_length_check' || { echo "output was: $out"; return 1; }
}
assert_success "convos: 256-char name rejected (length check)" test_convos_name_too_long

test_convos_name_blank() {
  local out
  out=$(run_test_sql << EOF
    INSERT INTO convos (student_id, name) VALUES ('$STUDENT_ID', '   ');
EOF
  )
  echo "$out" | grep -q 'convos_name_not_empty_check' || { echo "output was: $out"; return 1; }
}
assert_success "convos: whitespace-only name rejected (not-empty check)" test_convos_name_blank

test_convos_name_untrimmed() {
  local out
  out=$(run_test_sql << EOF
    INSERT INTO convos (student_id, name) VALUES ('$STUDENT_ID', ' Calc ');
EOF
  )
  echo "$out" | grep -q 'convos_name_trimmed_check' || { echo "output was: $out"; return 1; }
}
assert_success "convos: leading/trailing-whitespace name rejected (trimmed check)" test_convos_name_untrimmed

test_convos_name_valid() {
  local out
  out=$(run_test_sql << EOF
    INSERT INTO convos (student_id, name) VALUES ('$STUDENT_ID', 'My College Plan');
EOF
  )
  echo "$out" | grep -q 'ERROR' && { echo "output was: $out"; return 1; }
  return 0
}
assert_success "convos: valid name accepted" test_convos_name_valid

test_convos_update_name_bumps_timestamps() {
  local out
  out=$(run_test_sql_ta << EOF
    INSERT INTO convos (id, student_id, name, created_at, updated_at, row_updated_at)
    VALUES (uuidv7(), '$STUDENT_ID', 'Original',
            '2020-01-01T00:00:00Z'::timestamptz,
            '2020-01-01T00:00:00Z'::timestamptz,
            '2020-01-01T00:00:00Z'::timestamptz)
    RETURNING id \\gset
    UPDATE convos SET name = 'Renamed' WHERE id = :'id';
    SELECT (updated_at > '2020-01-01T00:00:00Z'::timestamptz)
      || '|' || (row_updated_at > '2020-01-01T00:00:00Z'::timestamptz)
    FROM convos WHERE id = :'id';
EOF
  )
  echo "$out" | grep -q '^true|true$' || { echo "output was: $out"; return 1; }
}
assert_success "convos: UPDATE name advances updated_at and row_updated_at" test_convos_update_name_bumps_timestamps

test_convos_immutable_id() {
  local out
  out=$(run_test_sql << EOF
    INSERT INTO convos (id, student_id, name) VALUES (uuidv7(), '$STUDENT_ID', 'Immutable id') RETURNING id \\gset
    UPDATE convos SET id = uuidv7() WHERE id = :'id';
EOF
  )
  echo "$out" | grep -q 'The id field is immutable' || { echo "output was: $out"; return 1; }
}
assert_success "convos: UPDATE of id rejected (prevent_immutable_updates)" test_convos_immutable_id

test_convos_immutable_created_at() {
  local out
  out=$(run_test_sql << EOF
    INSERT INTO convos (id, student_id, name) VALUES (uuidv7(), '$STUDENT_ID', 'Immutable created_at') RETURNING id \\gset
    UPDATE convos SET created_at = '2020-01-01T00:00:00Z'::timestamptz WHERE id = :'id';
EOF
  )
  echo "$out" | grep -q 'The created_at field is immutable' || { echo "output was: $out"; return 1; }
}
assert_success "convos: UPDATE of created_at rejected (prevent_immutable_updates)" test_convos_immutable_created_at

test_convos_immutable_row_created_at() {
  local out
  out=$(run_test_sql << EOF
    INSERT INTO convos (id, student_id, name) VALUES (uuidv7(), '$STUDENT_ID', 'Immutable row_created_at') RETURNING id \\gset
    UPDATE convos SET row_created_at = '2020-01-01T00:00:00Z'::timestamptz WHERE id = :'id';
EOF
  )
  echo "$out" | grep -q 'The row_created_at field is immutable' || { echo "output was: $out"; return 1; }
}
assert_success "convos: UPDATE of row_created_at rejected (prevent_immutable_updates)" test_convos_immutable_row_created_at

test_convos_physical_delete_blocked() {
  local out
  out=$(run_test_sql << EOF
    INSERT INTO convos (id, student_id, name) VALUES (uuidv7(), '$STUDENT_ID', 'Delete blocked') RETURNING id \\gset
    DELETE FROM convos WHERE id = :'id';
EOF
  )
  echo "$out" | grep -q 'Physical deletions are strictly blocked' || { echo "output was: $out"; return 1; }
}
assert_success "convos: physical DELETE rejected (prevent_physical_delete)" test_convos_physical_delete_blocked

test_convos_soft_delete_excluded_by_partial_index() {
  local out
  out=$(run_test_sql_ta << EOF
    INSERT INTO convos (id, student_id, name) VALUES (uuidv7(), '$STUDENT_ID', 'Soft delete') RETURNING id \\gset
    UPDATE convos SET deleted_at = NOW() WHERE id = :'id';
    SELECT count(*) FROM convos WHERE id = :'id' AND deleted_at IS NULL;
EOF
  )
  echo "$out" | grep -q '^0$' || { echo "output was: $out"; return 1; }
}
assert_success "convos: soft-deleted row excluded by active predicate" test_convos_soft_delete_excluded_by_partial_index

test_convos_timestamp_bypass() {
  local out
  out=$(run_test_sql_ta << EOF
    INSERT INTO convos (id, student_id, name, created_at, updated_at, row_updated_at)
    VALUES (uuidv7(), '$STUDENT_ID', 'Bypass',
            '2020-01-01T00:00:00Z'::timestamptz,
            '2020-01-01T00:00:00Z'::timestamptz,
            '2020-01-01T00:00:00Z'::timestamptz)
    RETURNING id \\gset
    SET LOCAL unicoach.bypass_logical_timestamp = 'true';
    UPDATE convos SET name = 'Bypassed' WHERE id = :'id';
    SELECT (updated_at = '2020-01-01T00:00:00Z'::timestamptz)
      || '|' || (row_updated_at > '2020-01-01T00:00:00Z'::timestamptz)
    FROM convos WHERE id = :'id';
EOF
  )
  echo "$out" | grep -q '^true|true$' || { echo "output was: $out"; return 1; }
}
assert_success "convos: bypass keeps updated_at but advances row_updated_at" test_convos_timestamp_bypass

# ==========================================================================
echo "==== convo_requests (coaching-extension log) ===="
# ==========================================================================
# Since RFC 106 (migration 0039) convo_requests carries only the coaching
# columns (convo_id / turn_id / kind / system_prompt_id) plus llm_request_id,
# the FK into the generic llm_requests call log. The request I/O envelope
# (provider / model / params / content) and its allowlist/size CHECKs moved to
# llm_requests (asserted in the RFC-106 log section below). Every insert here
# references the committed FIXTURE_LLM_REQUEST_ID.

test_convo_requests_monotonic_ids() {
  local out
  out=$(run_test_sql_ta << EOF
    INSERT INTO convo_requests (turn_id, convo_id, system_prompt_id, llm_request_id)
    VALUES (nextval('convo_turn_id_seq'), '$CONVO_ID', '$SYSTEM_PROMPT_ID', $FIXTURE_LLM_REQUEST_ID) RETURNING id AS id_a \\gset
    INSERT INTO convo_requests (turn_id, convo_id, system_prompt_id, llm_request_id)
    VALUES (nextval('convo_turn_id_seq'), '$CONVO_ID', '$SYSTEM_PROMPT_ID', $FIXTURE_LLM_REQUEST_ID) RETURNING id AS id_b \\gset
    SELECT (:id_b > :id_a);
EOF
  )
  echo "$out" | grep -q '^t$' || { echo "output was: $out"; return 1; }
}
assert_success "convo_requests: ids monotonically increase" test_convo_requests_monotonic_ids

test_convo_requests_null_llm_request_id() {
  local out
  out=$(run_test_sql << EOF
    INSERT INTO convo_requests (turn_id, convo_id, system_prompt_id)
    VALUES (nextval('convo_turn_id_seq'), '$CONVO_ID', '$SYSTEM_PROMPT_ID');
EOF
  )
  echo "$out" | grep -qi 'null value in column "llm_request_id"' || { echo "output was: $out"; return 1; }
}
assert_success "convo_requests: NULL llm_request_id rejected (NOT NULL)" test_convo_requests_null_llm_request_id

test_convo_requests_bad_llm_request_fk() {
  local out
  out=$(run_test_sql << EOF
    INSERT INTO convo_requests (turn_id, convo_id, system_prompt_id, llm_request_id)
    VALUES (nextval('convo_turn_id_seq'), '$CONVO_ID', '$SYSTEM_PROMPT_ID', 999999999);
EOF
  )
  echo "$out" | grep -q 'violates foreign key constraint' || { echo "output was: $out"; return 1; }
}
assert_success "convo_requests: non-existent llm_request_id rejected (FK)" test_convo_requests_bad_llm_request_fk

test_convo_requests_dropped_io_columns_gone() {
  # 0039 dropped provider / model_requested / request_params / content; naming
  # provider now is an undefined-column error (42703), proving the column is gone.
  local out
  out=$(run_test_sql << EOF
    INSERT INTO convo_requests (turn_id, convo_id, system_prompt_id, llm_request_id, provider)
    VALUES (nextval('convo_turn_id_seq'), '$CONVO_ID', '$SYSTEM_PROMPT_ID', $FIXTURE_LLM_REQUEST_ID, 'anthropic');
EOF
  )
  echo "$out" | grep -qi 'column "provider" .* does not exist' || { echo "output was: $out"; return 1; }
}
assert_success "convo_requests: referencing dropped provider column rejected (42703)" test_convo_requests_dropped_io_columns_gone

