test_convo_requests_update_rejected() {
  local out
  out=$(run_test_sql << EOF
    UPDATE convo_requests SET kind = 'tool_result' WHERE id = $REQUEST_ID;
EOF
  )
  echo "$out" | grep -q 'Log rows are append-only and cannot be updated.' || { echo "output was: $out"; return 1; }
}
assert_success "convo_requests: UPDATE rejected (prevent_log_update)" test_convo_requests_update_rejected

test_convo_requests_delete_rejected() {
  local out
  out=$(run_test_sql << EOF
    DELETE FROM convo_requests WHERE id = $REQUEST_ID;
EOF
  )
  echo "$out" | grep -q 'Log rows cannot be deleted; prune by partition/retention.' || { echo "output was: $out"; return 1; }
}
assert_success "convo_requests: DELETE rejected (prevent_log_delete)" test_convo_requests_delete_rejected

# ==========================================================================
echo "==== Ordered replay ===="
# ==========================================================================

test_replay_insertion_order() {
  local out
  out=$(run_test_sql_ta << EOF
    INSERT INTO convos (student_id, name) VALUES ('$STUDENT_ID', 'Replay order') RETURNING id AS cid \\gset
    INSERT INTO convo_requests (turn_id, convo_id, system_prompt_id, llm_request_id)
    VALUES (1001, :'cid', '$SYSTEM_PROMPT_ID', $FIXTURE_LLM_REQUEST_ID);
    INSERT INTO convo_requests (turn_id, convo_id, system_prompt_id, llm_request_id)
    VALUES (1002, :'cid', '$SYSTEM_PROMPT_ID', $FIXTURE_LLM_REQUEST_ID);
    INSERT INTO convo_requests (turn_id, convo_id, system_prompt_id, llm_request_id)
    VALUES (1003, :'cid', '$SYSTEM_PROMPT_ID', $FIXTURE_LLM_REQUEST_ID);
    SELECT string_agg(turn_id::text, ',' ORDER BY created_at, id)
    FROM convo_requests WHERE convo_id = :'cid';
EOF
  )
  echo "$out" | grep -q '^1001,1002,1003$' || { echo "output was: $out"; return 1; }
}
assert_success "replay: three separate-statement requests read back in insertion order" test_replay_insertion_order

test_replay_full_turn_join() {
  # A convo_requests row joins its logged call (llm_requests -> llm_responses ->
  # llm_responses_raw), reconstructing the full turn from the generic call log.
  local out
  out=$(run_test_sql_ta << EOF
    INSERT INTO convos (student_id, name) VALUES ('$STUDENT_ID', 'Replay join') RETURNING id AS cid \\gset
    INSERT INTO llm_requests (provider, model_requested, content, max_tokens)
    VALUES ('anthropic', 'claude-opus-4-8', '[{"q":"hi"}]'::jsonb, 100) RETURNING id AS lrid \\gset
    INSERT INTO convo_requests (turn_id, convo_id, system_prompt_id, llm_request_id)
    VALUES (nextval('convo_turn_id_seq'), :'cid', '$SYSTEM_PROMPT_ID', :lrid) RETURNING id AS rid \\gset
    INSERT INTO llm_responses (request_id, outcome, content, model_resolved, stop_reason, latency_ms)
    VALUES (:lrid, 'completed', '[{"a":"yo"}]'::jsonb, 'claude-opus-4-8', 'end_turn', 10) RETURNING id AS lrespid \\gset
    INSERT INTO llm_responses_raw (response_id, payload) VALUES (:lrespid, '{"raw":"verbatim"}'::jsonb);
    SELECT (lreq.content->0->>'q') || '|' || (lresp.content->0->>'a') || '|' || (lraw.payload->>'raw')
    FROM convo_requests req
    JOIN llm_requests lreq ON lreq.id = req.llm_request_id
    JOIN llm_responses lresp ON lresp.request_id = lreq.id
    JOIN llm_responses_raw lraw ON lraw.response_id = lresp.id
    WHERE req.id = :rid;
EOF
  )
  echo "$out" | grep -q '^hi|yo|verbatim$' || { echo "output was: $out"; return 1; }
}
assert_success "replay: convo_request joins its logged call to reconstruct the full turn" test_replay_full_turn_join
# ==========================================================================
echo "==== Function existence ===="
# ==========================================================================

test_prevent_log_update_exists() {
  local out
  out=$(echo "SELECT count(*) FROM pg_proc WHERE proname = 'prevent_log_update';" | bin/db-query -r 2>&1)
  echo "$out" | grep -q '^1$' || { echo "output was: $out"; return 1; }
}
assert_success "function: prevent_log_update() exists after migration" test_prevent_log_update_exists

test_prevent_log_delete_exists() {
  local out
  out=$(echo "SELECT count(*) FROM pg_proc WHERE proname = 'prevent_log_delete';" | bin/db-query -r 2>&1)
  echo "$out" | grep -q '^1$' || { echo "output was: $out"; return 1; }
}
assert_success "function: prevent_log_delete() exists after migration" test_prevent_log_delete_exists

# ==========================================================================
echo "==== Cascade topology (declared but inert) ===="
# ==========================================================================

test_cascade_inert_on_convos_delete() {
  # A physical DELETE over a convos->convo_requests subtree is rejected by the
  # BEFORE DELETE guard, which aborts the would-be cascade before any child is
  # removed. The reject and the survival check run in SEPARATE connections:
  # ON_ERROR_STOP aborts the raising statement's whole psql script, so a single
  # transaction cannot both raise and then read back. The committed fixture
  # subtree (CASCADE_*) survives the rolled-back delete attempt.
  local reject_out survive_out
  reject_out=$(run_test_sql << EOF
    DELETE FROM convos WHERE id = '$CASCADE_CONVO_ID';
EOF
  )
  echo "$reject_out" | grep -q 'Physical deletions are strictly blocked' || { echo "output was: $reject_out"; return 1; }

  survive_out=$(echo "
    SELECT (SELECT count(*) FROM convos WHERE id = '$CASCADE_CONVO_ID')::text || '|' ||
           (SELECT count(*) FROM convo_requests WHERE id = $CASCADE_REQUEST_ID)::text;" \
    | bin/db-query -r 2>&1)
  echo "$survive_out" | grep -q '^1|1$' || { echo "output was: $survive_out"; return 1; }
}
assert_success "cascade: physical DELETE FROM convos rejected, subtree intact (inert)" test_cascade_inert_on_convos_delete

# ==========================================================================
echo "==== archived_at (RFC 45) ===="
# ==========================================================================

test_convos_archived_at_exists_nullable_default_null() {
  # Inserting without the column reads back NULL: the column exists, is
  # nullable, and defaults NULL.
  local out
  out=$(run_test_sql_ta << EOF
    INSERT INTO convos (student_id, name) VALUES ('$STUDENT_ID', 'Archive default')
    RETURNING (archived_at IS NULL);
EOF
  )
  echo "$out" | grep -q '^t$' || { echo "output was: $out"; return 1; }
}
assert_success "convos: archived_at exists, nullable, defaults NULL" test_convos_archived_at_exists_nullable_default_null

test_convos_archive_round_trip() {
  # SET archived_at = NOW() then back to NULL both succeed: a mutable column on
  # a guarded entity (prevent_immutable_updates does not cover it).
  local out
  out=$(run_test_sql_ta << EOF
    INSERT INTO convos (id, student_id, name) VALUES (uuidv7(), '$STUDENT_ID', 'Archive trip')
    RETURNING id \\gset
    UPDATE convos SET archived_at = NOW() WHERE id = :'id';
    UPDATE convos SET archived_at = NULL WHERE id = :'id';
    SELECT (archived_at IS NULL) FROM convos WHERE id = :'id';
EOF
  )
  echo "$out" | grep -q '^t$' || { echo "output was: $out"; return 1; }
}
assert_success "convos: archive round-trip (set NOW() then NULL) succeeds" test_convos_archive_round_trip

# ==========================================================================
echo "==== llm_requests / llm_responses / llm_responses_raw (RFC 106 log) ===="
# ==========================================================================

# A committed llm_requests + llm_responses + raw subtree reused by the
# append-only guard cases (which insert then attempt an UPDATE/DELETE in a
# separate connection). Committed so the guard rejects run against durable rows.
LLM_REQUEST_ID=$(
  echo "INSERT INTO llm_requests (provider, model_requested, content, max_tokens)
        VALUES ('anthropic', 'claude-opus-4-8', '[]'::jsonb, 1024)
        RETURNING id;" | bin/db-run -r rw | grep -E '^[0-9]+$'
)
if [ -z "$LLM_REQUEST_ID" ]; then
  fail_test "fixture: could not create llm_requests row"
fi
pass_test "fixture llm_request created (llm_request_id=$LLM_REQUEST_ID)"

LLM_RESPONSE_ID=$(
  echo "INSERT INTO llm_responses (request_id, outcome, content, model_resolved, stop_reason, latency_ms)
        VALUES ($LLM_REQUEST_ID, 'completed', '[]'::jsonb, 'claude-opus-4-8', 'end_turn', 100)
        RETURNING id;" | bin/db-run -r rw | grep -E '^[0-9]+$'
)
if [ -z "$LLM_RESPONSE_ID" ]; then
  fail_test "fixture: could not create llm_responses row"
fi
pass_test "fixture llm_response created (llm_response_id=$LLM_RESPONSE_ID)"

echo "INSERT INTO llm_responses_raw (response_id, payload) VALUES ($LLM_RESPONSE_ID, '{\"raw\":1}'::jsonb);" \
  | bin/db-run rw >/dev/null

test_llm_requests_provider_allowlist() {
  local out
  out=$(run_test_sql << EOF
    INSERT INTO llm_requests (provider, model_requested, content, max_tokens)
    VALUES ('openai', 'gpt-4', '[]'::jsonb, 10);
EOF
  )
  echo "$out" | grep -q 'llm_requests_provider_valid_check' || { echo "output was: $out"; return 1; }
}
assert_success "llm_requests: provider 'openai' rejected (allowlist)" test_llm_requests_provider_allowlist

test_llm_requests_provider_anthropic_and_log_ok() {
  local out
  out=$(run_test_sql << EOF
    INSERT INTO llm_requests (provider, model_requested, content, max_tokens)
    VALUES ('anthropic', 'claude-opus-4-8', '[]'::jsonb, 10);
    INSERT INTO llm_requests (provider, model_requested, content, max_tokens)
    VALUES ('log', 'claude-opus-4-8', '[]'::jsonb, 10);
EOF
  )
  echo "$out" | grep -q 'ERROR' && { echo "output was: $out"; return 1; }
  return 0
}
assert_success "llm_requests: providers 'anthropic' and 'log' accepted" test_llm_requests_provider_anthropic_and_log_ok

