test_llm_responses_unique_request() {
  local out
  out=$(run_test_sql << EOF
    INSERT INTO llm_requests (provider, model_requested, content, max_tokens)
    VALUES ('anthropic', 'm', '[]'::jsonb, 10) RETURNING id AS rid \\gset
    INSERT INTO llm_responses (request_id, outcome, reason, latency_ms) VALUES (:rid, 'rejected', 'r', 5);
    INSERT INTO llm_responses (request_id, outcome, reason, latency_ms) VALUES (:rid, 'rejected', 'r', 5);
EOF
  )
  echo "$out" | grep -q 'duplicate key value violates unique constraint' || { echo "output was: $out"; return 1; }
}
assert_success "llm_responses: second response for a request_id rejected (UNIQUE 1:1)" test_llm_responses_unique_request

