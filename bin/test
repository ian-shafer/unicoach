#!/usr/bin/env bash

# Layer `.env -> .env.dev -> .env.test`: the DB-connection block and the
# required-toggle dev values live in .env.dev (RFC 95), so a harness that only
# layered .env.test would lose them. ENV_FILES is a PATH-like ':'-separated string;
# it is exported so the child postgres-up/db-reset/db-tests invocations below
# inherit the full stack and target the per-worktree test DB. bin/common resolves
# each relative entry against PROJECT_ROOT.
export ENV_FILES=".env.dev:.env.test"
source "$(dirname "$0")/common"

# Add new Gradle modules here, in sync with settings.gradle.kts.
MODULES=(common web-common db net auth queue queue-worker cron rest-server service email chat appstore admin-web public-web college fixture)

help() {
  cat << 'EOF'
test [options] [module ...]

Runs Gradle tests on the nix-provided host JVM. Resets this worktree's test
database first (postgres-up -> db-reset -> db-tests), then copies it once per
selected module (unicoach-tNN-<checkout>, CREATE DATABASE ... TEMPLATE) and
runs the modules' test tasks in parallel, each against its own copy (RFC 259).
The copies are dropped on exit. With no modules, runs every module.

Runs no shell script-test harnesses. bin/check -- what the pre-commit hook
runs -- runs them first and then calls this script; `bin/shell-tests -h` lists
them.

Modules:
  common web-common db net auth queue queue-worker cron rest-server service email chat appstore admin-web public-web college fixture

Options:
  -t GLOB   Gradle test filter (requires exactly one module)
  -f        Force re-run, bypass the build cache (--rerun-tasks)
  -v        Verbose Gradle output (--info)
  -c        Run all selected test tasks, report every failure
  -h        Help
EOF
  exit 0
}

# Returns 0 if $1 is a member of MODULES.
is-module() {
  local candidate="$1" module
  for module in "${MODULES[@]}"; do
    [ "$module" = "$candidate" ] && return 0
  done
  return 1
}

SELECTED=()
TESTS_GLOB=""
HAS_TESTS=false
FORCE=false
VERBOSE=false
CONTINUE=false

# Options and module names may be intermixed in any order. getopts alone stops
# at the first non-option, so wrap it in an outer loop that consumes one non-option per round, resetting OPTIND=1
# before each inner getopts run (OPTIND is not auto-reset within one shell).
while [ "$#" -gt 0 ]; do
  OPTIND=1
  while getopts ":ht:fvc" opt; do
    case "$opt" in
    h) help ;;
    t) TESTS_GLOB="$OPTARG"; HAS_TESTS=true ;;
    f) FORCE=true ;;
    v) VERBOSE=true ;;
    c) CONTINUE=true ;;
    \?) fatal -s "$EXIT_UNKNOWN_OPTION" "unknown option [-$OPTARG]" ;;
    :)  fatal -s "$EXIT_OPTION_REQUIRES_VALUE" -- "--tests requires a GLOB" ;;
    esac
  done
  shift $((OPTIND-1))
  if [ "$#" -gt 0 ]; then
    if is-module "$1"; then
      # De-duplicate repeated modules.
      if ! printf '%s\n' "${SELECTED[@]}" | grep -qxF "$1"; then
        SELECTED+=("$1")
      fi
    else
      fatal -s "$EXIT_INVALID_ARG_VALUE" "unknown module [$1]"
    fi
    shift
  fi
done

# --tests filters a single test task; it is meaningless across multiple tasks.
if [ "$HAS_TESTS" = true ] && [ "${#SELECTED[@]}" -ne 1 ]; then
  fatal -s "$EXIT_MISSING_REQUIRED_ARG" -- "--tests requires exactly one module"
fi

# Core invariant: emit at least one :module:test task. No modules named => all.
if [ "${#SELECTED[@]}" -eq 0 ]; then
  SELECTED=("${MODULES[@]}")
fi

GRADLE_ARGS=()
for module in "${SELECTED[@]}"; do
  GRADLE_ARGS+=(":$module:test")
done
[ "$FORCE" = true ] && GRADLE_ARGS+=("--rerun-tasks")
[ "$VERBOSE" = true ] && GRADLE_ARGS+=("--info")
[ "$CONTINUE" = true ] && GRADLE_ARGS+=("--continue")
[ "$HAS_TESTS" = true ] && GRADLE_ARGS+=("--tests" "$TESTS_GLOB")

# Assumes db-bootstrap was already run once by hand (shared cluster + role).
# Reset only this worktree's test DB to a clean, fully-migrated state; never
# touch the shared cluster itself.
"$PROJECT_ROOT/bin/postgres-up"

"$PROJECT_ROOT/bin/db-reset"

# Run the shell DB schema harnesses against the freshly migrated DB, sequentially
# (never backgrounded). Under set -e a non-zero exit aborts the run; Postgres
# stays up so the copies below are taken of the same DB.
"$PROJECT_ROOT/bin/db-tests"

# One database per selected module, so the modules' test tasks can run at once
# (RFC 259). Each is a copy of this checkout's test DB AS db-tests LEFT IT -- the
# exact state the serial suite used to start from -- so a module sees no
# difference except that no other module is writing beside it.
#
# The copies are temporary. The shared cluster already carries hundreds of
# per-checkout databases and nothing reaps them, so the trap drops these on every
# exit, pass or fail; test_module_databases_create also drops a leftover first.
MODULE_DATABASES=()
MODULE_DATABASE_MAP=""
for module in "${SELECTED[@]}"; do
  for index in "${!MODULES[@]}"; do
    [ "${MODULES[$index]}" = "$module" ] || continue
    database="$(test_module_database_name "$index")"
    MODULE_DATABASES+=("$database")
    MODULE_DATABASE_MAP+="${MODULE_DATABASE_MAP:+,}$module=$database"
  done
done
trap 'test_module_databases_drop "${MODULE_DATABASES[@]}" || log-warning "could not drop the per-module test databases: ${MODULE_DATABASES[*]}"' EXIT
test_module_databases_create "$POSTGRES_DB" "${MODULE_DATABASES[@]}" ||
  fatal "could not copy [$POSTGRES_DB] into the per-module test databases; if CREATE DATABASE said the template is being accessed, something is connected to this checkout's test DB"
log-info "per-module test databases: $MODULE_DATABASE_MAP"

# build.gradle.kts points each module's test JVM at its copy from this map, and
# refuses to run a module the map does not name. A plain ./gradlew, with no map,
# stays serial against the one shared test DB, as before: --parallel is only
# ever passed here, beside the copies that make it safe.
#
# The worker cap bounds the test JVMs open at once. Every checkout on the
# machine shares the cluster's max_connections (100), and each test JVM holds
# connections for its whole run, so the cap is set from the MEASURED peak per JVM
# (RFC 259), not from the core count.
TEST_MAX_WORKERS=4
export UNICOACH_TEST_DATABASES="$MODULE_DATABASE_MAP"
"$PROJECT_ROOT/gradlew" --parallel --max-workers="$TEST_MAX_WORKERS" "${GRADLE_ARGS[@]}"
