#!/usr/bin/env bash
# build-ios runs under SYSTEM Xcode (xcodebuild), NOT the Nix dev shell. It
# therefore deliberately does NOT source bin/common (which requires .env /
# Postgres / the Nix shell) — only bin/functions for log-info/fatal.
set -euo pipefail

PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$PROJECT_ROOT/bin/functions"
# The backend-URL derivation — which dotenvs to layer, and what URL they mean —
# is ONE library, shared with bin/release-ios and with the install-time
# staleness check in bin/ios-functions / bin/install-ios (RFC 156). Why it is
# safe to source outside the Nix dev shell is stated once, in that file's
# header; do not restate it here, where the copy would drift.
source "$PROJECT_ROOT/bin/ios-url-functions"

help() {
  cat << 'EOF'
build-ios [target]

Builds the UnicoachiOS app for a named target defined under ios-app/env/, and
(for device targets) signs it via Xcode automatic signing. Runs under system
Xcode, not the Nix dev shell.

  target  Target name (default: local). Sources ios-app/env/<target>.env, which
          must define UNICOACH_DESTINATION (UNICOACH_CONFIGURATION optional,
          defaults to Debug). The checked-in deploy targets are `prod` (device)
          and `prod-simulator`, both pointing at the live deployment.

The backend URL is honor-if-set, else derived from a dotenv's APP_DOMAIN:
  - HONOR: if the target file (or the environment) sets a non-empty
    UNICOACH_BACKEND_URL, it is forwarded to xcodebuild verbatim — no
    derivation, no validation.
  - DERIVE (deploy): a target that sets UNICOACH_DEPLOY sources .env.prod (the
    single source of the prod domain) and bakes
    UNICOACH_BACKEND_URL=https://api.$APP_DOMAIN — HTTPS, TLS terminated at the
    ALB, no port. The checked-in `prod` / `prod-simulator` targets use this, so
    the api host is never restated in the target file.
  - DERIVE (local): otherwise the repo .env and .env.dev supply APP_DOMAIN and
    SERVER_PORT (the same single sources the local server reads), and the build
    bakes UNICOACH_BACKEND_URL=http://$APP_DOMAIN:$SERVER_PORT. SERVER_PORT is
    REQUIRED and must be a port (1-65535); there is no default. APP_DOMAIN
    defaults to localhost and must be a DNS hostname — a bare IP literal in any
    spelling is rejected (invalid cookie Domain). This is the local-dev path that keeps app and server in sync. (Since
    RFC 95 APP_DOMAIN lives in .env.dev, not the base — override it there for
    on-device use. Since RFC 156 SERVER_PORT is per-worktree, derived in .env.dev,
    so the baked URL names THIS checkout's dev server and no other's.)

The derivation itself — which dotenvs are layered and what URL they mean — is
bin/ios-url-functions, shared with bin/release-ios and with the install-time
check that refuses a bundle built for a different backend (RFC 156).

A target is a simulator build iff its UNICOACH_DESTINATION contains "Simulator";
otherwise it is a device build, which additionally sources ios-app/env/signing.env
for UNICOACH_DEVELOPMENT_TEAM (required) and UNICOACH_DEVICE (optional).

Options:
  -h           Help
EOF
  exit 0
}

while getopts ":h" opt; do
  case "$opt" in
  h) help ;;
  \?) fatal -s "$EXIT_UNKNOWN_OPTION" "unknown option [-$OPTARG]" ;;
  :)  fatal -s "$EXIT_OPTION_REQUIRES_VALUE" "option [-$OPTARG] requires an argument" ;;
  esac
done
shift $((OPTIND-1))

# Dev-shell guard. This must run under SYSTEM Xcode: inside the Nix dev shell
# xcrun is shadowed by a stub and DEVELOPER_DIR/SDKROOT point into the Nix store,
# so the build would silently target the wrong toolchain. Detection lives in
# bin/is-nix; the refusal is here. Placed before any env/signing/tool logic so
# this message wins even when an env file is also missing.
if "$PROJECT_ROOT/bin/is-nix" -q; then
  fatal "${0##*/} must run under system Xcode, not the Nix dev shell. Run it directly (e.g. bin/build-ios local), not via 'nix develop -c'."
fi

ENV_NAME="${1:-local}"
if [ "$#" -gt 1 ]; then
  fatal -s "$EXIT_UNEXPECTED_ARG" "build-ios accepts at most one positional argument (target): $*"
fi

# ENV_DIR defaults to the in-repo env directory; UNICOACH_ENV_DIR overrides it
# (used by bin/ios-scripts-tests to point at a temp fixture dir).
ENV_DIR="${UNICOACH_ENV_DIR:-$PROJECT_ROOT/ios-app/env}"
ENV_FILE="$ENV_DIR/$ENV_NAME.env"
if [ ! -f "$ENV_FILE" ]; then
  fatal "Environment file not found [$ENV_FILE]. Available envs: copy ios-app/env/local.env.example to ios-app/env/local.env, or pass an existing env (e.g. simulator)."
fi

set -a
# shellcheck source=/dev/null
source "$ENV_FILE"
set +a

: "${UNICOACH_DESTINATION:?UNICOACH_DESTINATION must be set in $ENV_FILE}"
UNICOACH_CONFIGURATION="${UNICOACH_CONFIGURATION:-Debug}"

# A dotenv is loaded UNCONDITIONALLY on both the honor and derive paths: it is
# the source of UNICOACH_CLIENT_KEY (forwarded to xcodebuild below) and, on the
# derive path, of APP_DOMAIN and SERVER_PORT. WHICH files those are — a deploy
# target's .env.prod, a UNICOACH_DOTENV fixture, or the `.env -> .env.dev` stack
# the local server reads — is ios_dotenv_files in bin/ios-url-functions, beside
# the derivation that consumes them, so the two cannot disagree about where the
# domain comes from. ios_load_dotenvs sources them into THIS shell — that is how
# UNICOACH_CLIENT_KEY arrives.
ios_load_dotenvs

# The BUILD-time policy, run HERE in this script's own shell rather than inside
# the derivation: a bare-IP APP_DOMAIN is an invalid cookie Domain, so nothing
# may be BUILT against one. It is a rule about what a build BAKES, which is why
# it belongs to the two scripts that bake and not to the install-time staleness
# check that consumes the same derivation. Calling it out here also means its
# fatal exits THIS script, instead of exiting a command substitution and
# depending on the assignment's syntax to be noticed.
ios_require_valid_app_domain

# Backend URL: honor-if-set, else derived — ONE copy of the rule, in
# bin/ios-url-functions, shared with bin/release-ios (which bakes the same URL
# into a release) and with the install-time staleness check that compares a
# built bundle against it. `|| exit $?` because the derivation can still fail to
# produce a value (no SERVER_PORT on the local path), and a fatal inside a
# command substitution exits only that subshell.
UNICOACH_BACKEND_URL="$(ios_derive_backend_url)" || exit $?

# Signing args accumulate only for device builds. A simulator build (destination
# containing "Simulator") does not sign and needs no Apple team.
SIGNING_ARGS=()
if [[ "$UNICOACH_DESTINATION" != *Simulator* ]]; then
  SIGNING_ENV="$ENV_DIR/signing.env"
  if [ ! -f "$SIGNING_ENV" ]; then
    fatal "Device build requires signing credentials, but [$SIGNING_ENV] is missing. Copy ios-app/env/signing.env.example to ios-app/env/signing.env and fill in UNICOACH_DEVELOPMENT_TEAM."
  fi
  set -a
  # shellcheck source=/dev/null
  source "$SIGNING_ENV"
  set +a
  if [ -z "${UNICOACH_DEVELOPMENT_TEAM:-}" ]; then
    fatal "UNICOACH_DEVELOPMENT_TEAM is not set in [$SIGNING_ENV]; a device build cannot be signed without an Apple Developer team id."
  fi
  SIGNING_ARGS=(
    "DEVELOPMENT_TEAM=$UNICOACH_DEVELOPMENT_TEAM"
    "CODE_SIGN_STYLE=Automatic"
    -allowProvisioningUpdates
  )
fi

# Insertion point for the unimplemented <target>.local.env secret seam. A
# gitignored ios-app/env/<target>.local.env would be sourced HERE — LAST, after
# the target file, .env, and signing.env — so it overrides everything for that
# one target. It is the intended home for a per-target UNICOACH_CLIENT_KEY once a
# gated deployment exists. Not implemented in this RFC: no code, no staging
# target, no overlay. The ios-app/env/*.env gitignore rule already covers it.

log-info "Building UnicoachiOS [env=$ENV_NAME] [configuration=$UNICOACH_CONFIGURATION] [destination=$UNICOACH_DESTINATION] [backend=$UNICOACH_BACKEND_URL]..."

xcodebuild \
  -project "$PROJECT_ROOT/ios-app/UnicoachiOS.xcodeproj" \
  -scheme UnicoachiOS \
  -configuration "$UNICOACH_CONFIGURATION" \
  -destination "$UNICOACH_DESTINATION" \
  -derivedDataPath "$PROJECT_ROOT/ios-app/build/DerivedData" \
  "UNICOACH_BACKEND_URL=$UNICOACH_BACKEND_URL" \
  "UNICOACH_CLIENT_KEY=${UNICOACH_CLIENT_KEY:-}" \
  ${SIGNING_ARGS[@]+"${SIGNING_ARGS[@]}"} \
  build
