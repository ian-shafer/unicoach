#!/usr/bin/env python3
"""fetch-cds-seed: build the CDS admissions seed from the collegedata.fyi corpus.

RFC 140. Pulls the open collegedata.fyi Common Data Set corpus over its public
PostgREST API, selects per school and per fact group the newest document that
actually reports that group, normalises the four fact groups the coach cites
(H2A merit aid, the C7 admissions factor grid, application deadlines, and the
H2/H8 need-and-forms facts), and
writes the reviewable, diffable seed:

    db/seed/cds/merit-aid.csv
    db/seed/cds/admission-factors.csv
    db/seed/cds/deadlines.csv
    db/seed/cds/aid_policy.csv    (RFC 170: the H2 need figures and the H8
                                   forms, each row carrying its own status;
                                   RFC 175: the H4/H5 borrowing block, one fact
                                   per loan type)
    db/seed/cds/PROVENANCE.json   (fetched_at, corpus row counts, sha256 per csv)

ALL interpretation lives here (the Kotlin loader is a dumb typed CSV reader
with a header assertion): the C7 rating whitelist, the per-schema_version
deadline field mapping (the 2024-25 and 2025-26 CDS templates NUMBER the
C21/C22 date fields differently, and a template this script has not been taught
is refused rather than guessed), free-text date parsing, and the per-fact-group
document selection. Junk that fails normalisation is dropped as "unreported",
never guessed; every drop is counted in PROVENANCE.json, with a bounded sample
of the offending documents so a count is traceable without re-fetching.

Stdlib-only (dev-shell python3), no dependencies. Usage:

    fetch-cds-seed [-o <outdir>] [-F <fixtures-dir>] [-K <jwt>]

    -o DIR    output directory (default: db/seed/cds under the repo root)
    -F DIR    offline mode for tests: read <dir>/manifest.json and
              <dir>/fields.json (recorded API responses), no network
    -K JWT    the corpus's public read-only Supabase anon key to use.
              Falls back to $COLLEGEDATA_ANON_KEY, then to scraping the
              corpus's own API page. PROVENANCE.json records which route
              a run used, so the credential is auditable.
    -h        help

Options are parsed by the stdlib getopt module, the same short-option grammar
every bash script in bin/ uses; there are no long options and no positionals. A
usage mistake exits in the band bin/functions reserves: 10 unknown option, 11
option without its value, 20 an unexpected positional, 22 a malformed value.

LOGGING GOES TO STDERR, all of it, including the closing summary: this script's
product is files on disk, so a normal run writes NOTHING to stdout. The help
answering -h is the one thing that does.

The run REFUSES to write a seed that is empty or that collapsed against the
committed PROVENANCE.json row counts: this tool overwrites a reviewed seed, and
a successful-looking read that produced nothing is a broken read, never a
corpus that suddenly reports nothing.

Etiquette per the corpus's docs/api-usage-attribution.md: every request sends
`X-CollegeData-Client: unicoach`.
"""

import csv
import enum
import getopt
import hashlib
import io
import json
import os
import re
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from collections import Counter, defaultdict
from datetime import date, datetime, timezone
from pathlib import Path

# The shared python half of bin/functions (bin/pyfunctions.py): the EXIT_* band,
# the log-* family, fatal, and the post-getopt guard suite every fetcher
# needs. Resolved against THIS script's own directory rather than the caller's
# cwd, because these scripts are run from anywhere.
# ...and no bytecode cache beside it: importing a module normally writes
# bin/__pycache__/, and bin/ is a reviewed directory of scripts, not a package
# build tree. The import cost is microseconds; an untracked directory appearing
# in the working tree every time an operator runs a fetcher is a real cost.
sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parent))
from pyfunctions import (  # noqa: E402  (import after the sys.path bootstrap above)
    EXIT_INVALID_ARG_VALUE,
    fatal as shared_fatal,
    log_info,
    HTTP_ERROR_BODY_PREVIEW_BYTES,
    HTTP_MAX_ATTEMPTS,
    HTTP_RETRY_BACKOFF_SECONDS,
    HTTP_TIMEOUT_SECONDS,
    RETRYABLE_STATUS,
    log_warning,
    parse_short_options,
    write_atomically,
)


# Every refusal this script makes names the script. The fetchers all run under
# one orchestrator (bin/fetch-external-data), so a bare "[FATAL] fixtures
# directory does not exist" costs the reader a lookup to find out WHICH fetcher
# said it. pyfunctions' own refusals already carry the name; this gives the
# script-local ones the same prefix through one wrapper rather than 40 edited
# f-strings.
def fatal(message, status=1):
    shared_fatal(f"{SCRIPT_NAME}: {message}", status=status)

from typing import NamedTuple

REPO_ROOT = Path(__file__).resolve().parent.parent
DEFAULT_OUTDIR = REPO_ROOT / "db" / "seed" / "cds"

API_PAGE_URL = "https://www.collegedata.fyi/api"
REST_BASE = "https://api.collegedata.fyi/rest/v1"
CLIENT_HEADER = {"X-CollegeData-Client": "unicoach"}
PAGE_SIZE = 1000
ANON_KEY_ENV = "COLLEGEDATA_ANON_KEY"

# The network bounds (attempts, timeout, backoff), the retryable statuses and the
# error-body preview bound come from bin/pyfunctions.py, shared with the other
# two fetchers. A retry covers throttling and server-side faults only; every
# other 4xx here is the REQUEST being wrong (rotated anon key, renamed table) and
# retrying it only delays the diagnosis.

# How many offending subjects to keep per drop reason. A count alone forces a
# re-fetch to find the rows behind it; an unbounded list would make
# PROVENANCE.json a second copy of the corpus.
DROP_SAMPLE_LIMIT = 20

# A regenerated fact group smaller than this fraction of the committed one is
# treated as a failed read rather than a real corpus change.
SEED_SHRINK_FLOOR = 0.5

# CDS dates are cycle-relative and carry no year, so month/day pairs are
# validated against a LEAP year: Feb 29 is a real reported deadline, Feb 30 is
# extraction junk.
CALENDAR_VALIDATION_YEAR = 2024

# The H4/H5 borrowing ids, spelled ONCE: this tuple is what the fetch asks for
# AND the set AID_POLICY_BORROWING_FIGURES reads, tied together by the guard
# beside that table -- the graduating class (H.401), the borrower headcount per
# loan type (H.501-H.505: any / federal / institutional / state / private) and
# the average cumulative principal borrowed per loan type (H.511-H.515).
#
# H.506-H.510 -- the published "percent who borrowed" cells -- are absent by NOT
# BEING LISTED, never by a loop bound that stops short of them (RFC 175 D2): the
# corpus publishes them text-typed, 0..100 for most documents and 0..1 for
# dozens of others, so a stored share would be a coin flip on whose scale a
# school used. The share is derived at read time from the borrower count over
# H.401, and only when both exist.
BORROWING_FIELD_IDS = (
    "H.401",
    "H.501", "H.502", "H.503", "H.504", "H.505",
    "H.511", "H.512", "H.513", "H.514", "H.515",
)

# Every cds_fields field_id we interpret. The 2024-25-schema-only ED count
# fields (C.2106/C.2107 there) are fetched by these same ids but ignored by the
# free-text mapping below.
FIELD_IDS = (
    ["H.201", "H.2A01", "H.2A02"]
    # The H2 first-time full-time freshmen block (RFC 170): line d (awarded any
    # aid, the denominator lines h/i/k are reported against), line h (need fully
    # met), line i (average percentage of need met) and line k (average
    # need-based grant). The corpus repeats the same thirteen lines THREE times
    # -- freshmen, full-time undergraduates, less-than-full-time -- and labels
    # none of them; block 1 is the one H.201 above already reads, so the whole
    # seed stays on one cohort.
    + ["H.204", "H.208", "H.209", "H.211"]
    # The H4/H5 borrowing block, spelled once in BORROWING_FIELD_IDS above.
    + list(BORROWING_FIELD_IDS)
    # The H8 forms block: required of DOMESTIC first-year aid applicants. The
    # H7 block (nonresident applicants) is the other applicant group the
    # schema admits and is not read yet.
    + [f"H.80{i}" for i in range(1, 8)]
    + [f"C.7{i:02d}" for i in range(1, 19)]
    + ["C.1401", "C.1402", "C.1403", "C.1404", "C.1405"]
    + ["C.1601", "C.1604", "C.1605", "C.1606"]
    + [f"C.21{i:02d}" for i in range(1, 10)]
    + [f"C.22{i:02d}" for i in range(1, 6)]
)

# CDS C7: the published rating vocabulary, whitelisted case-insensitively.
# Anything else ('x', 'VI', stray numbers -- ~5% of the corpus) is extraction
# junk: dropped, not guessed.
RATING_WHITELIST = {
    "very important": "very_important",
    "important": "important",
    "considered": "considered",
    "not considered": "not_considered",
}

FACTOR_COLUMNS = [
    ("rigor", "C.701"),
    ("class_rank", "C.702"),
    ("gpa", "C.703"),
    ("test_scores", "C.704"),
    ("essay", "C.705"),
    ("recommendations", "C.706"),
    ("interview", "C.707"),
    ("extracurriculars", "C.708"),
    ("talent", "C.709"),
    ("character_qualities", "C.710"),
    ("first_generation", "C.711"),
    ("alumni_relation", "C.712"),
    ("geography", "C.713"),
    ("state_residency", "C.714"),
    ("religious_affiliation", "C.715"),
    ("volunteer_work", "C.716"),
    ("work_experience", "C.717"),
    ("applicant_interest", "C.718"),
]

MERIT_HEADER = [
    "unit_id", "source_year", "freshmen_ft_total", "no_need_merit_count",
    "no_need_merit_avg", "source_url", "archive_url",
]
FACTORS_HEADER = (
    ["unit_id", "source_year"] + [c for c, _ in FACTOR_COLUMNS] + ["source_url", "archive_url"]
)
DEADLINES_HEADER = [
    "unit_id", "source_year", "round", "offered", "closing_month", "closing_day",
    "notification_month", "notification_day", "source_url", "archive_url",
]
# One row per (college, cycle, fact). Unlike the three tables above, this one
# carries a per-cell STATUS: the CDS need figures are the first place a cell the
# corpus HAS but could not extract must survive as a fact about OUR gap
# (RFC 170, D7) rather than as a drop counter. `value` is empty exactly when the
# status bears no value.
AID_POLICY_HEADER = [
    "unit_id", "source_year", "fact", "value", "status", "source_variable",
    "source_url", "archive_url",
]

# The figure_statuses slugs this seed writes; the vocabulary is unicoach's
# (db/data/money-vocabulary.json), and these three are the only readings the
# corpus can justify.
STATUS_REPORTED = "reported"
# The corpus HAS the cell and failed to extract it: our gap, not the school's
# silence (RFC 170, D7). A cell no source carries gets no row at all.
STATUS_NOT_COLLECTED = "not_collected_by_us"
# The corpus itself says the question does not apply here.
STATUS_NOT_APPLICABLE = "not_applicable"

# The CDS `value_status` values this seed can read, mapped to the unicoach
# reading of them. Anything else is an unmapped corpus status: counted, never
# guessed at.
AID_POLICY_STATUS_BY_CORPUS_STATUS = {
    "reported": STATUS_REPORTED,
    "parse_error": STATUS_NOT_COLLECTED,
    "not_applicable": STATUS_NOT_APPLICABLE,
}

# The three cell readers the figure table below holds. Defined here, above the
# table that names them, because the table is built at import time -- a reader
# named before it exists is a NameError at startup, which is a worse way to
# learn the ordering than a comment.
def read_int_cell(row):
    """A headcount cell as the seed spells it, or None: whole, non-negative."""
    number = get_int(row)
    return None if number is None else str(number)


def read_percent_cell(row):
    """A percent cell as the PUBLISHED percentage, or None; see get_percent for
    why the number comes from value_num and never from value_text."""
    number = get_percent(row)
    return None if number is None else format_decimal(number)


def read_money_cell(row):
    """A dollar cell, cents included, or None. Not get_int: the corpus publishes
    averages like 18006.5357, and get_int rejects every one of them."""
    number = get_decimal(row)
    return None if number is None else format_decimal(number)


# The H2 freshmen figures, each with the READER its cell is read by -- the
# reader itself, not a word naming one: a shape word needs a dispatch, the
# dispatch needs a fallback, and a misspelled word then reads a percentage as
# money with nothing to say so. "percent" is
# the trap the whole reader exists for: `value_num` on a percent cell is the
# 0..1 FRACTION (0.943) while `value_text` is sometimes "94.3" and sometimes
# "0.5691", so the number is taken from value_num and multiplied, and the text
# is never trusted. The seed carries the PUBLISHED percent; the canonical store
# holds the 0-1 share, and that conversion belongs to the loader that knows the
# measure's unit.
AID_POLICY_NEED_FIGURES = [
    ("aid_awarded_freshmen_count", "H.204", read_int_cell),
    ("need_fully_met_count", "H.208", read_int_cell),
    ("avg_need_met_percent", "H.209", read_percent_cell),
    ("avg_need_based_grant_usd", "H.211", read_money_cell),
]

# The H4/H5 borrowing block (RFC 175): a graduating class, five borrower
# headcounts and five average cumulative principals, one per loan type. A loan
# type is never summed with another and never dropped into a nameless total
# (D3), so each type keeps its own fact name all the way through the seed.
#
# The averages read through read_money_cell (get_decimal), never read_int_cell:
# the corpus publishes them as text like '38217.2331', and get_int's
# `\d+(\.0+)?` would silently reject every fractional one -- an integer reader
# that rejects 28,193.50 is the same silent gap in a different costume.
AID_POLICY_BORROWING_FIGURES = [
    ("graduating_class_count", "H.401", read_int_cell),
    ("any_loan_borrower_count", "H.501", read_int_cell),
    ("federal_loan_borrower_count", "H.502", read_int_cell),
    ("institutional_loan_borrower_count", "H.503", read_int_cell),
    ("state_loan_borrower_count", "H.504", read_int_cell),
    ("private_loan_borrower_count", "H.505", read_int_cell),
    ("any_loan_debt_avg_usd", "H.511", read_money_cell),
    ("federal_loan_debt_avg_usd", "H.512", read_money_cell),
    ("institutional_loan_debt_avg_usd", "H.513", read_money_cell),
    ("state_loan_debt_avg_usd", "H.514", read_money_cell),
    ("private_loan_debt_avg_usd", "H.515", read_money_cell),
]

# The read table and the fetch list are the same eleven ids. Checked at import,
# because the failure it prevents is invisible at run time: an id read but never
# fetched yields an empty cell at every document, which is indistinguishable
# from a school that did not report it.
if {field_id for _, field_id, _ in AID_POLICY_BORROWING_FIGURES} != set(BORROWING_FIELD_IDS):
    fatal(
        "the borrowing figures and BORROWING_FIELD_IDS name different fields: "
        f"figures=[{sorted(field_id for _, field_id, _ in AID_POLICY_BORROWING_FIGURES)}] "
        f"fetched=[{sorted(BORROWING_FIELD_IDS)}]"
    )

# One table for every reader of "the figures" -- the row builder, the fact list
# the coverage guard is derived from, the CSV. The two halves are named
# separately only because the borrowing block is dropped as a BLOCK (see
# h5_is_contradictory) while the rest of the filing's aid-policy facts stand.
AID_POLICY_FIGURES = AID_POLICY_NEED_FIGURES + AID_POLICY_BORROWING_FIGURES

# The facts h5_is_contradictory takes away when it fires: the borrowing block
# and nothing else.
AID_POLICY_BORROWING_FACTS = frozenset(fact for fact, _, _ in AID_POLICY_BORROWING_FIGURES)

# Each per-borrower average against the headcount it is an average OVER. A mean
# is a mean over a population, so the two cells of one loan type are read
# together (see drop_averages_over_no_borrowers below) and never as two
# unrelated numbers.
AID_POLICY_AVERAGE_BORROWER_COUNTS = {
    fact: fact.replace("_debt_avg_usd", "_borrower_count")
    for fact, _, _ in AID_POLICY_BORROWING_FIGURES
    if fact.endswith("_debt_avg_usd")
}

# The pairing above is derived from the fact NAMES, so it is checked at import
# rather than trusted: a renamed average or a sixth loan type whose two facts
# do not follow the convention would otherwise pair with nothing and silently
# stop being guarded.
if not AID_POLICY_AVERAGE_BORROWER_COUNTS or not set(
    AID_POLICY_AVERAGE_BORROWER_COUNTS.values()
) <= set(AID_POLICY_BORROWING_FACTS):
    fatal(
        "a per-borrower average does not pair with a borrower count: "
        f"pairs=[{sorted(AID_POLICY_AVERAGE_BORROWER_COUNTS.items())}] "
        f"borrowing_facts=[{sorted(AID_POLICY_BORROWING_FACTS)}]"
    )

# The H4/H5 headcount facts the self-consistency rule compares, named once.
GRADUATING_CLASS_FACT = "graduating_class_count"
ANY_LOAN_BORROWER_FACT = "any_loan_borrower_count"
PER_TYPE_BORROWER_FACTS = (
    "federal_loan_borrower_count",
    "institutional_loan_borrower_count",
    "state_loan_borrower_count",
    "private_loan_borrower_count",
)
# The six headcounts, i.e. the whole-number facts the rule may compare. The
# averages are not in it: a dollar figure is never a count of people, and
# comparing one with a headcount is the confusion this seed exists to prevent.
BORROWER_COUNT_FACTS = (GRADUATING_CLASS_FACT, ANY_LOAN_BORROWER_FACT) + PER_TYPE_BORROWER_FACTS

# The H8 forms, named as a family names them rather than as the CDS numbers
# them. The slugs are the aid_forms vocabulary's (db/data/money-vocabulary.json).
AID_POLICY_FORMS = [
    ("fafsa_required", "H.801"),
    ("institutional_form_required", "H.802"),
    ("css_profile_required", "H.803"),
    ("state_aid_form_required", "H.804"),
    ("noncustodial_css_profile_required", "H.805"),
    ("business_farm_supplement_required", "H.806"),
    ("other_institutional_form_required", "H.807"),
]

# The floor under each fact's coverage, as distinct colleges, set well below
# what the live corpus reports. EVERY fact the seed writes has one: the shrink
# guard below compares whole FILES against the committed PROVENANCE.json, so a
# single fact disappearing -- a renamed field id, an extractor that stops
# ticking one checkbox -- leaves the file's row count almost unchanged and
# passes. A fact with no floor is a fact that failure still hides behind, and
# the minority forms are exactly the ones with no other guard.
#
# The floors differ because the facts do: the need figures are reported by
# hundreds of schools and the business/farm supplement by a dozen. The measured
# numbers are deliberately NOT restated here -- they move with every fetch, and
# PROVENANCE.json records what a run actually saw.
AID_POLICY_COVERAGE_FLOOR = {
    "aid_awarded_freshmen_count": 250,
    "need_fully_met_count": 250,
    "avg_need_met_percent": 240,
    "avg_need_based_grant_usd": 250,
    "fafsa_required": 200,
    "institutional_form_required": 12,
    "css_profile_required": 55,
    "state_aid_form_required": 30,
    "noncustodial_css_profile_required": 30,
    "business_farm_supplement_required": 8,
    "other_institutional_form_required": 25,
    # RFC 175's H4/H5 block. Measured against our seeded college set: class 283,
    # any 213, federal 210, institutional 149, state 142, private 207 for the
    # counts and 212/211/65/46/208 for the averages. The floors sit below those,
    # and differ per loan type because reporting genuinely does: institutional
    # and state loans are reported by far fewer schools than federal ones, and a
    # single floor would either be useless or false.
    #
    # The two average floors are an order of magnitude below their counts
    # because most of what used to be "coverage" was placeholder: 91 of the 138
    # state-loan averages and 81 of the 148 institutional ones were a zero
    # standing beside a zero borrower count, and
    # drop_averages_over_no_borrowers now refuses them. A floor measuring
    # placeholders guards nothing.
    "graduating_class_count": 250,
    "any_loan_borrower_count": 190,
    "federal_loan_borrower_count": 190,
    "institutional_loan_borrower_count": 130,
    "state_loan_borrower_count": 120,
    "private_loan_borrower_count": 190,
    "any_loan_debt_avg_usd": 190,
    "federal_loan_debt_avg_usd": 190,
    "institutional_loan_debt_avg_usd": 50,
    "state_loan_debt_avg_usd": 35,
    "private_loan_debt_avg_usd": 190,
}

MONTH_NAMES = {
    name: i
    for i, names in enumerate(
        [
            ("jan", "january"), ("feb", "february"), ("mar", "march"),
            ("apr", "april"), ("may",), ("jun", "june"), ("jul", "july"),
            ("aug", "august"), ("sep", "sept", "september"), ("oct", "october"),
            ("nov", "november"), ("dec", "december"),
        ],
        start=1,
    )
    for name in names
}


# The CDS template -> C21/C22 date numbering, declared explicitly. "split"
# numbers every date as a month cell + a day cell (the 2025-26 template);
# "free" uses one free-text date cell per date (the 2024-25 template). The two
# numberings are INCOMPATIBLE -- 2025-26's C.2104/05 is the ED1 notification
# month/day, 2024-25's C.2104/05 is the ED2 closing/notification date -- so a
# schema_version this table does not name is a template whose numbering is
# unknown: its deadlines are refused and counted, never guessed under whichever
# mapping happens to be first. PROVENANCE.json shows the day a new one appears.
DEADLINE_SCHEMA_STYLES = {
    "2025-26": "split",
    "2024-25": "free",
}

# Drop reasons that describe the DOCUMENT rather than the row finally chosen,
# so they are reported even for a document the per-group fallback skipped over.
# An unmapped template must be visible whether or not an older document
# happened to cover for it.
STICKY_DROPS = frozenset(
    {
        "deadline_schema_unmapped",
        "deadline_schema_inconsistent",
        "merit_h2a_contradictory",
        "aid_policy_h2_contradictory",
        # RFC 175 D6: a filing whose H4/H5 borrowing block contradicts itself.
        # Sticky for the same reason as its H2 sibling -- it describes the
        # DOCUMENT, so it stays visible even when an older filing covered for it.
        "aid_policy_h5_contradictory",
        # The CORPUS's own status vocabulary drifting -- the same kind of fact
        # deadline_schema_unmapped is sticky for. Without this, a document that
        # yields no aid-policy rows takes the count and the sample with it, and
        # the one signal that the upstream vocabulary moved is lost.
        "aid_policy_status_unmapped",
    }
)


# ---------------------------------------------------------------------------
# The drop ledger
# ---------------------------------------------------------------------------


class Drops:
    """Every value the seed refused: a count per reason, a BOUNDED sample of the
    subjects behind each reason (unit_id/document_id, plus the offending value
    where that is the actionable datum), and the per-fact-group counters kept as
    their own dimension rather than welded into the reason string.

    `subject` is the document context a nested ledger was opened with, so a
    low-level normaliser can record a reason without threading identity through
    every call."""

    def __init__(self, subject=""):
        self.subject = subject
        self.counts = Counter()
        self.samples = defaultdict(list)
        self.group_counts = defaultdict(Counter)
        self.group_samples = defaultdict(lambda: defaultdict(list))

    def record(self, reason, detail=None, count=1):
        self.counts[reason] += count
        self._sample(self.samples[reason], detail)

    def record_group(self, group, reason, detail=None, count=1):
        self.group_counts[group][reason] += count
        self._sample(self.group_samples[group][reason], detail)

    def merge(self, other, reasons=None):
        """Folds a per-document ledger in, optionally restricted to `reasons`
        (the sticky, document-level ones)."""
        for reason, count in other.counts.items():
            if reasons is not None and reason not in reasons:
                continue
            self.counts[reason] += count
            bucket = self.samples[reason]
            room = DROP_SAMPLE_LIMIT - len(bucket)
            if room > 0:
                bucket.extend(other.samples[reason][:room])

    def reasons(self):
        return sorted(self.counts)

    def _sample(self, bucket, detail):
        if len(bucket) >= DROP_SAMPLE_LIMIT:
            return
        entry = " ".join(part for part in (self.subject, detail) if part)
        if entry:
            bucket.append(entry)

    def as_json(self):
        """The provenance shape: counts, samples, and the per-group counters
        nested under their group."""
        return {
            "by_reason": dict(sorted(self.counts.items())),
            "samples": {
                reason: values for reason, values in sorted(self.samples.items()) if values
            },
            "by_group": {
                group: {
                    "by_reason": dict(sorted(counts.items())),
                    "samples": {
                        reason: values
                        for reason, values in sorted(self.group_samples[group].items())
                        if values
                    },
                }
                for group, counts in sorted(self.group_counts.items())
            },
        }

    def summary(self):
        """The one-line run summary: counts only."""
        return dict(sorted(self.counts.items()))


# ---------------------------------------------------------------------------
# Fetching
# ---------------------------------------------------------------------------


def http_get(url, headers):
    """The response body, retrying only TRANSIENT faults. A permanent fault
    (401/403/404 and every other non-retryable status) is reported immediately
    through this script's own fatal channel -- retrying a rotated key or a
    renamed table only delays the diagnosis -- and the swallowed causes of the
    earlier attempts are logged rather than discarded."""
    request = urllib.request.Request(url, headers=headers)
    for attempt in range(HTTP_MAX_ATTEMPTS):
        try:
            with urllib.request.urlopen(request, timeout=HTTP_TIMEOUT_SECONDS) as response:
                return response.read()
        except urllib.error.HTTPError as error:
            body = error.read()[:HTTP_ERROR_BODY_PREVIEW_BYTES].decode("utf-8", errors="replace")
            cause = f"HTTP [{error.code}] [{error.reason}] body [{body}]"
            if error.code not in RETRYABLE_STATUS:
                fatal(f"GET [{url}] failed permanently on attempt [{attempt + 1}]: {cause}")
        except (urllib.error.URLError, TimeoutError) as error:
            cause = f"[{type(error).__name__}] [{error}]"
        if attempt == HTTP_MAX_ATTEMPTS - 1:
            fatal(f"GET [{url}] failed after [{HTTP_MAX_ATTEMPTS}] attempts: {cause}")
        log_warning(
            f"GET [{url}] attempt [{attempt + 1}]/[{HTTP_MAX_ATTEMPTS}] failed: {cause}; retrying"
        )
        time.sleep(HTTP_RETRY_BACKOFF_SECONDS * (attempt + 1))
    raise AssertionError("unreachable")


def resolve_anon_key(argument):
    """(key, source) for the corpus's public read-only Supabase anon key, from
    the most explicit route available: the -K argument, then
    $COLLEGEDATA_ANON_KEY, then a scrape of the corpus's own API page (where
    the key is published for exactly this use). The source is recorded in
    PROVENANCE.json so an operator can see which credential a run used, and can
    pin it when the published one rotates."""
    if argument:
        return argument, "argument"
    from_env = os.environ.get(ANON_KEY_ENV, "").strip()
    if from_env:
        return from_env, "environment"
    page = http_get(API_PAGE_URL, CLIENT_HEADER).decode("utf-8", errors="replace")
    match = re.search(r"eyJ[A-Za-z0-9_\-]+\.[A-Za-z0-9_\-]+\.[A-Za-z0-9_\-]+", page)
    if not match:
        fatal(
            f"no Supabase anon key (JWT) found on [{API_PAGE_URL}]; "
            f"pass -K or set [${ANON_KEY_ENV}]"
        )
    return match.group(0), "scraped"


def rest_get_all(path, params, anon_key):
    """Full-table read via limit/offset pages in a stable order (PostgREST caps
    unbounded reads at its default page size). Only the two page shapes a
    bounded read can legitimately return are accepted: exactly PAGE_SIZE rows
    (read on) or fewer (done). A LARGER page would desynchronise the fixed
    offset cursor and re-read rows already taken, and a JSON object is
    PostgREST's error envelope, not a page -- both are fatal here, where the
    URL can still be named."""
    headers = {
        **CLIENT_HEADER,
        "apikey": anon_key,
        "Authorization": f"Bearer {anon_key}",
    }
    rows = []
    offset = 0
    while True:
        page_params = dict(params)
        page_params["limit"] = str(PAGE_SIZE)
        page_params["offset"] = str(offset)
        url = f"{REST_BASE}/{path}?{urllib.parse.urlencode(page_params)}"
        page = json.loads(http_get(url, headers))
        if not isinstance(page, list):
            fatal(
                f"GET [{url}] returned a JSON [{type(page).__name__}], expected an array: "
                f"[{str(page)[:HTTP_ERROR_BODY_PREVIEW_BYTES]}]"
            )
        if len(page) > PAGE_SIZE:
            fatal(f"GET [{url}] returned [{len(page)}] rows for a limit of [{PAGE_SIZE}]")
        rows.extend(page)
        if len(page) != PAGE_SIZE:
            return rows
        offset += PAGE_SIZE


def fetch_corpus(anon_key):
    """The (manifest, fields) corpus rows for a caller-supplied anon key."""
    manifest = rest_get_all(
        "cds_manifest",
        {
            "extraction_status": "eq.extracted",
            "removed_at": "is.null",
            "order": "document_id.asc",
        },
        anon_key,
    )
    field_list = ",".join(f'"{f}"' for f in FIELD_IDS)
    fields = rest_get_all(
        "cds_fields",
        {
            "field_id": f"in.({field_list})",
            "order": "document_id.asc,field_id.asc",
        },
        anon_key,
    )
    return manifest, fields


def load_corpus(fixtures, anon_key_argument):
    """(manifest, fields, anon_key_source) from recorded fixtures or the live
    API."""
    if fixtures is not None:
        manifest = json.loads((fixtures / "manifest.json").read_text())
        fields = json.loads((fixtures / "fields.json").read_text())
        return manifest, fields, "fixtures"
    anon_key, source = resolve_anon_key(anon_key_argument)
    manifest, fields = fetch_corpus(anon_key)
    return manifest, fields, source


# ---------------------------------------------------------------------------
# Document selection
# ---------------------------------------------------------------------------


def document_unusable_reason(doc):
    """Why this manifest document cannot seed a row, or None when it can. Every
    field the downstream code depends on is checked HERE, in the one place
    unusable documents are dropped: `school_id` and `document_id` are
    subscripted by doc_archive_url and the per-document field lookup, so an
    absent one is an unusable document rather than a KeyError three functions
    later -- or, worse, a ".../schools/None/..." citation shipped in the seed."""
    if doc.get("sub_institutional"):
        return "manifest_docs_unusable_sub_institutional"
    if not str(doc.get("ipeds_id") or "").strip().isdigit():
        return "manifest_docs_unusable_no_ipeds_id"
    if not re.fullmatch(r"\d{4}-\d{2}", str(doc.get("canonical_year") or "")):
        return "manifest_docs_unusable_no_canonical_year"
    if not doc.get("source_url"):
        return "manifest_docs_unusable_no_source_url"
    if not doc.get("school_id"):
        return "manifest_docs_unusable_no_school_id"
    if not doc.get("document_id"):
        return "manifest_docs_unusable_no_document_id"
    return None


def select_documents(manifest, drops):
    """Every usable extracted, non-removed, whole-institution document per
    school, newest first (canonical_year -- the 'YYYY-YY' strings order
    correctly -- then document_id as the deterministic tiebreak). Fact groups
    are chosen from this list PER GROUP, so a school whose newest CDS omits H2A
    still seeds merit aid from the newest document that does report it."""
    by_school = {}
    for doc in manifest:
        reason = document_unusable_reason(doc)
        if reason is not None:
            drops.record(reason, f"document_id=[{doc.get('document_id')}]")
            continue
        by_school.setdefault(int(str(doc["ipeds_id"]).strip()), []).append(doc)
    for docs in by_school.values():
        docs.sort(key=lambda d: (d["canonical_year"], d["document_id"]), reverse=True)
    return by_school


def doc_source_year(doc):
    return int(doc["canonical_year"].split("-")[0])


def doc_archive_url(doc):
    return f"https://www.collegedata.fyi/schools/{doc['school_id']}/{doc['canonical_year']}"


def doc_subject(unit_id, doc):
    """The identity carried on every drop a document causes."""
    return f"unit_id=[{unit_id}] document_id=[{doc['document_id']}]"


def group_fields(fields, drops):
    """(reported, unreported): cds_fields rows by document_id -> field_id ->
    row for the 'reported' ones, and document_id -> field_id -> corpus status
    for every other one.

    A non-reported cell stays UNREADABLE -- it is never merged into the first
    map, because a parse_error row can still carry junk text that `get_int`
    would happily read as a number. It is counted PER STATUS as before
    (parse_error is extraction failure, which an operator judging corpus health
    needs a number for), and the aid-policy group additionally turns it into a
    row that states OUR gap (RFC 170, D7); the three older groups ignore it, as
    they always have.

    The first row wins on the rare duplicate, matching the stable fetch order;
    the loser is counted, because a corpus disagreeing with itself must not look
    clean."""
    by_doc = {}
    unreported_by_doc = {}
    for row in fields:
        status = row.get("value_status")
        if status != "reported":
            drops.record(
                f"field_status_{status or 'unknown'}",
                f"document_id=[{row.get('document_id')}] field_id=[{row.get('field_id')}]",
            )
            unreported_by_doc.setdefault(row.get("document_id"), {}).setdefault(
                row.get("field_id"), status
            )
            continue
        doc_fields = by_doc.setdefault(row["document_id"], {})
        if row["field_id"] in doc_fields:
            drops.record(
                "field_duplicate_ignored",
                f"document_id=[{row['document_id']}] field_id=[{row['field_id']}]",
            )
            continue
        doc_fields[row["field_id"]] = row
    return by_doc, unreported_by_doc


# ---------------------------------------------------------------------------
# Cell normalisation
# ---------------------------------------------------------------------------


def cell_evidence(row):
    """Everything a drop needs to name WHICH part of a cell failed.

    A junk drop used to record `value_text` alone, while the rules that refuse a
    cell test `value_num` (the percent range) and `value_bool` -- so the ledger
    named a column that had not failed, and a `value_bool` cell with no text
    recorded `value=[None]`, losing the cause entirely."""
    if row is None:
        return "kind=[None] num=[None] bool=[None] text=[None]"
    return (
        f"kind=[{row.get('value_kind')}] num=[{row.get('value_num')}] "
        f"bool=[{row.get('value_bool')}] text=[{get_cell_text(row)}]"
    )


def get_cell_text(row):
    """The row's reported text with whitespace collapsed, or None when the cell
    carries no value at all. None is ABSENCE; a value that merely looks falsy (a
    numeric 0) is a reported value and stays one."""
    if row is None:
        return None
    value = row.get("value_text")
    return None if value is None else " ".join(str(value).split())


def get_int(row):
    """A non-negative integer from a numeric cds_fields row: value_num when
    typed, else value_text with currency/grouping stripped. Anything else
    (including negatives -- counts and dollar averages cannot be negative) is
    junk -> None."""
    if row is None:
        return None
    value = row.get("value_num")
    if value is None:
        text = get_cell_text(row)
        if text is None:
            return None
        raw = re.sub(r"[$,\s]", "", text)
        if not re.fullmatch(r"\d+(\.0+)?", raw):
            return None
        value = float(raw)
    # `bool` is a subclass of `int` in Python, so a JSON `true` left in value_num
    # would survive every check below and seed the integer 1 -- a fabricated
    # freshman count, or a "$1 average award". Reject it before the numeric tests.
    if isinstance(value, bool) or not isinstance(value, (int, float)):
        return None
    if value != int(value) or value < 0:
        return None
    return int(value)


def get_decimal(row, minimum=0.0, maximum=None):
    """A decimal from a numeric cds_fields cell: `value_num` when the corpus
    typed one, else `value_text` with currency and grouping stripped. Outside
    [minimum, maximum] -> None, as is anything that is not a number at all.

    Beside `get_int` rather than inside it, deliberately. `get_int` refuses
    every fractional value, which is right for a HEADCOUNT (there is no such
    thing as 4.5 students) and wrong for the money and percentage cells this
    slice reads: measured against the live corpus it rejects 80% of the
    "percentage of need met" cells and every dollar average published with
    cents. Widening it would have quietly changed what the three existing fact
    groups accept."""
    if row is None:
        return None
    value = row.get("value_num")
    if value is None:
        text = get_cell_text(row)
        if text is None:
            return None
        raw = re.sub(r"[$,\s]", "", text)
        if not re.fullmatch(r"\d+(\.\d+)?", raw):
            return None
        value = float(raw)
    # `bool` is a subclass of `int` in Python: a JSON `true` left in value_num
    # would otherwise seed the number 1 -- a fabricated "$1 average award".
    if isinstance(value, bool) or not isinstance(value, (int, float)):
        return None
    value = float(value)
    if value < minimum or (maximum is not None and value > maximum):
        return None
    return value


# The percent scale and its two ceilings, named once and derived from each
# other: a fraction may not exceed 1 and a percent may not exceed 100, and the
# two bounds drifting apart is exactly how a 0.943 becomes a 94.3% ceiling
# violation nobody notices.
PERCENT_PER_UNIT = 100.0
MAX_FRACTION = 1.0
MAX_PERCENT = MAX_FRACTION * PERCENT_PER_UNIT

# How many decimal places a seed value keeps. The corpus publishes averages like
# 18006.5357 and percentages like 94.3; four places keeps both without inventing
# precision the source did not state.
SEED_DECIMAL_PLACES = 4


def get_percent(row):
    """A 0..100 percentage from a percent cell.

    The corpus types these cells `percent` and stores the 0..1 FRACTION in
    `value_num` (0.943), while `value_text` is the percent for most rows
    ("94.3") and the same fraction for others ("0.5691"). So the number comes
    from `value_num` x 100 and the text is ignored -- reading the text would
    publish 0.5691% of need met for 44 schools. A cell the corpus did NOT type
    as a percent is read as a plain number, because then there is no scale to
    undo."""
    if row is None:
        return None
    if row.get("value_kind") == "percent" and row.get("value_num") is not None:
        fraction = get_decimal(row, maximum=MAX_FRACTION)
        return None if fraction is None else fraction * PERCENT_PER_UNIT
    return get_decimal(row, maximum=MAX_PERCENT)


def format_decimal(value):
    """A decimal as the seed spells it: no exponent, no trailing zeros, and no
    locale. `%` formatting and `str()` are both locale-independent in Python,
    but the trailing-zero strip is written out rather than left to a format
    string so "62393.00" and "62393" cannot land as two different seed rows for
    the same reported figure."""
    text = f"{value:.{SEED_DECIMAL_PLACES}f}".rstrip("0").rstrip(".")
    return text if text else "0"


def get_bool(row):
    """A yes/no or checkbox cds_fields row -> bool, else None. Only a real JSON
    boolean is taken from value_bool ("false"/"f"/[] are not booleans and must
    not coerce to True); checkbox marks otherwise arrive as literal 'X'/check
    glyphs in the allowlisted text vocabulary below."""
    if row is None:
        return None
    value_bool = row.get("value_bool")
    if isinstance(value_bool, bool):
        return value_bool
    raw = (get_cell_text(row) or "").lower()
    if raw in ("yes", "y", "true", "x", "\u2713", "\u2714"):
        return True
    if raw in ("no", "n", "false"):
        return False
    return None


def get_rating(row):
    if row is None:
        return None
    return RATING_WHITELIST.get((get_cell_text(row) or "").lower())


def get_int_field(doc_fields, field_id, drops, reason):
    """get_int for one field, counting a REPORTED-but-unparseable cell so the
    ledger names every value the seed lost, not only the ones the C7 grid
    happens to check."""
    field = doc_fields.get(field_id)
    value = get_int(field)
    if field is not None and value is None:
        drops.record(reason, f"field_id=[{field_id}] value=[{get_cell_text(field)}]")
    return value


def get_bool_field(doc_fields, field_id, drops):
    """get_bool for one field, counting a reported-but-unrecognised flag.
    Uncounted, such a cell is indistinguishable from an unasked question -- and
    is then defaulted to offered=True."""
    field = doc_fields.get(field_id)
    value = get_bool(field)
    if field is not None and value is None:
        drops.record("deadline_flag_junk", f"field_id=[{field_id}] value=[{get_cell_text(field)}]")
    return value


# ---------------------------------------------------------------------------
# Dates
# ---------------------------------------------------------------------------


class MonthDay(NamedTuple):
    """A cycle-relative CDS month/day, the fetcher-side `CdsMonthDay`: the month
    is always present and `day` is the sparse best-effort part ("closes in
    March"). "Not reported" is a null MonthDay, never a pair of nulls, so a day
    without a month is unconstructible here exactly as it is in Kotlin and in
    `college_deadlines_day_requires_month_check`."""

    month: int
    day: int | None


class DateComponent(enum.Enum):
    """Which half of a date a split cell is meant to carry; the MonthDay field
    it selects is named once, here, instead of a tuple position at each call."""

    MONTH = "month"
    DAY = "day"


def month_day(month, day):
    """A MonthDay when the pair names a REAL calendar date, else None. The
    calendar is the stdlib's, not a 1-12/1-31 range check: Feb 30, Apr 31 and
    Sep 31 are extraction junk and must never be seeded and then cited. The CDS
    cycle carries no year, so validation is against a leap year -- Feb 29 is a
    real reported deadline."""
    if month is None:
        return None
    try:
        date(CALENDAR_VALIDATION_YEAR, month, 1 if day is None else day)
    except (ValueError, TypeError):
        return None
    return MonthDay(month, day)


def parse_free_date(raw):
    """A MonthDay from the 2024-25 template's free-text date cells, which the
    extractors emit in several shapes: ISO timestamps ('2025-11-15 00:00:00'),
    'M/D' or 'M/D/YYYY', Excel-mangled 'D-Mon' ('1-Jan'), and 'Month D'
    ('January 6'). The month-name forms are attempted BEFORE giving up, per the
    corpus's known '1-Jan' mangling; anything else ('Mid-December', or a pair
    that is not a real date) is unparseable -> None, never interpolated."""
    text = " ".join(str(raw or "").split())
    if not text:
        return None
    match = re.fullmatch(r"(\d{4})-(\d{2})-(\d{2})(?:[ T].*)?", text)
    if match:
        return month_day(int(match.group(2)), int(match.group(3)))
    match = re.fullmatch(r"(\d{1,2})/(\d{1,2})(?:/\d{2,4})?", text)
    if match:
        return month_day(int(match.group(1)), int(match.group(2)))
    match = re.fullmatch(r"(\d{1,2})[-. ]([A-Za-z]+)\.?", text)
    if match and match.group(2).lower() in MONTH_NAMES:
        return month_day(MONTH_NAMES[match.group(2).lower()], int(match.group(1)))
    match = re.fullmatch(r"([A-Za-z]+)\.?,? (\d{1,2})(?:,? \d{4})?", text)
    if match and match.group(1).lower() in MONTH_NAMES:
        return month_day(MONTH_NAMES[match.group(1).lower()], int(match.group(2)))
    return None


def month_day_cells(month_row, day_row, drops):
    """A MonthDay from the split month/day cell pair, or None when no usable
    month was reported. Each cell should be a bare number, but legacy
    extractions sometimes leave a full date string in one -- in that case the
    respective component of the parsed date is used.

    A month with no day is real CDS reporting ("applications close in March")
    and is kept; a DAY with no month is not a date at all, and neither is a day
    that does not exist in its month, so the orphan component is dropped as
    unreported. Every discard is counted under the same keys the free-text path
    uses -- a drop total that depends on which template a school filed is not a
    drop total."""
    month = date_cell(month_row, DateComponent.MONTH, drops)
    day = date_cell(day_row, DateComponent.DAY, drops)
    if month is not None and month_day(month, None) is None:
        drops.record("deadline_date_out_of_range", f"month=[{month}]")
        month = None
    if month is None:
        if day is not None:
            drops.record("deadline_day_without_month", f"day=[{day}]")
        return None
    if day is not None and month_day(month, day) is None:
        drops.record("deadline_impossible_month_day", f"month=[{month}] day=[{day}]")
        day = None
    return MonthDay(month, day)


def date_cell(row, component, drops):
    """The month or the day a split cell carries: a bare number, or that
    component of a full date a legacy extraction left in it. A present cell that
    parses as neither is counted, not silently blank."""
    text = get_cell_text(row)
    if not text:
        return None
    if re.fullmatch(r"\d{1,2}", text):
        return int(text)
    parsed = parse_free_date(text)
    if parsed is None:
        drops.record("deadline_date_unparseable", f"value=[{text}]")
        return None
    return getattr(parsed, component.value)


# ---------------------------------------------------------------------------
# Fact groups
# ---------------------------------------------------------------------------


def map_merit_rows(unit_id, doc, doc_fields, unreported, drops):
    """The H2A merit-aid row for one document, as a 0-or-1 element list."""
    total = get_int_field(doc_fields, "H.201", drops, "merit_int_junk")
    count = get_int_field(doc_fields, "H.2A01", drops, "merit_int_junk")
    avg = get_int_field(doc_fields, "H.2A02", drops, "merit_int_junk")
    if total is not None and count is not None and count > total:
        # Contradictory extraction (more no-need merit awards than freshmen):
        # the whole H2A block is untrustworthy, INCLUDING the average award it
        # reports -- a citable "average merit award $X" with no recipients and
        # no denominator is worse than no row -- so the document is unreported
        # for this group and an older one may cover for it.
        drops.record("merit_h2a_contradictory", f"freshmen=[{total}] merit_count=[{count}]")
        return []
    if total is None and count is None and avg is None:
        return []
    return [
        {
            "unit_id": unit_id,
            "source_year": doc_source_year(doc),
            "freshmen_ft_total": total,
            "no_need_merit_count": count,
            "no_need_merit_avg": avg,
            "source_url": doc["source_url"],
            "archive_url": doc_archive_url(doc),
        }
    ]


def map_factors_rows(unit_id, doc, doc_fields, unreported, drops):
    """The C7 factor-grid row for one document, as a 0-or-1 element list."""
    row = {
        "unit_id": unit_id,
        "source_year": doc_source_year(doc),
        "source_url": doc["source_url"],
        "archive_url": doc_archive_url(doc),
    }
    any_rating = False
    for column, field_id in FACTOR_COLUMNS:
        field = doc_fields.get(field_id)
        rating = get_rating(field)
        if field is not None and rating is None:
            # The offending string, not just a total: this counter exists to
            # grow RATING_WHITELIST, and a bare count names nothing to add.
            drops.record(
                "factor_rating_junk",
                f"column=[{column}] value=[{get_cell_text(field) or ''}]",
            )
        row[column] = rating
        any_rating = any_rating or rating is not None
    return [row] if any_rating else []


def get_schema_style(doc_fields, drops):
    """The document's C21/C22 numbering per DEADLINE_SCHEMA_STYLES, or None when
    its schema_version is inconsistent across rows or names a template this
    script has not been taught. Either way the document's deadlines are refused
    rather than read under a guessed numbering -- and the OFFENDING VERSION is
    recorded, because it is the one datum needed to extend the table."""
    versions = {row.get("schema_version") for row in doc_fields.values()}
    if len(versions) != 1:
        seen = ",".join(sorted(str(version) for version in versions))
        drops.record("deadline_schema_inconsistent", f"schema_versions=[{seen}]")
        return None
    version = versions.pop()
    style = DEADLINE_SCHEMA_STYLES.get(version)
    if style is None:
        drops.record("deadline_schema_unmapped", f"schema_version=[{version}]")
    return style


def get_free_date(doc_fields, field_id, drops):
    """A MonthDay from one free-text date cell (the 2024-25 numbering)."""
    row = doc_fields.get(field_id)
    if row is None:
        return None
    parsed = parse_free_date(get_cell_text(row))
    if parsed is None:
        drops.record(
            "deadline_date_unparseable", f"field_id=[{field_id}] value=[{get_cell_text(row)}]"
        )
    return parsed


def get_split_date(doc_fields, month_id, day_id, drops):
    """A MonthDay from a month cell + day cell pair (the 2025-26 numbering, and
    C14/C16 under both templates)."""
    if month_id not in doc_fields and day_id not in doc_fields:
        return None
    return month_day_cells(doc_fields.get(month_id), doc_fields.get(day_id), drops)


# The C21/C22 (ED1, ED2, EA) closing/notification date fields per numbering.
# "split" names a (month, day) cell pair per date; "free" names one free-text
# date cell. Note C.2104/05: ED1 NOTIFICATION under the split template, the ED2
# dates under the free-text one -- the reason get_schema_style refuses a template
# it does not know. Under the free-text template C.2106/07 are the ED
# application/admit COUNTS and C.2204 is the restrictive-EA flag, so neither is
# read there.
SPLIT_ROUND_DATE_FIELDS = {
    "early_decision_1": (("C.2102", "C.2103"), ("C.2104", "C.2105")),
    "early_decision_2": (("C.2106", "C.2107"), ("C.2108", "C.2109")),
    "early_action": (("C.2202", "C.2203"), ("C.2204", "C.2205")),
}
FREE_ROUND_DATE_FIELDS = {
    "early_decision_1": ("C.2102", "C.2103"),
    "early_decision_2": ("C.2104", "C.2105"),
    "early_action": ("C.2202", "C.2203"),
}


def map_round_dates(doc_fields, style, drops):
    """{round -> (closing, notification)} for the ED/EA rounds, extracted under
    the document's own numbering. The dispatch is closed: a style mapped to
    neither numbering is a programming error here, never the free-text
    numbering by default."""
    if style == "split":
        return {
            round_name: (
                get_split_date(doc_fields, *closing, drops=drops),
                get_split_date(doc_fields, *notify, drops=drops),
            )
            for round_name, (closing, notify) in SPLIT_ROUND_DATE_FIELDS.items()
        }
    if style == "free":
        return {
            round_name: (
                get_free_date(doc_fields, closing, drops),
                get_free_date(doc_fields, notify, drops),
            )
            for round_name, (closing, notify) in FREE_ROUND_DATE_FIELDS.items()
        }
    raise AssertionError(f"no date extraction for deadline style [{style}]")


def round_if_evidenced(name, offered, closing, notification):
    """The shared emit rule: a round exists when its flag was reported or a date
    for it parsed, and `offered` defaults True for a round that is described but
    never asked about."""
    if offered is None and closing is None and notification is None:
        return None
    return (name, True if offered is None else offered, closing, notification)


def map_regular_round(doc_fields, drops):
    """C14 regular: closing month/day, plus the C16 notify-by date.

    The C.1604 notify-by checkbox is a TRI-STATE like every other flag, and only
    an explicit "no" suppresses the date: an UNREPORTED checkbox beside a
    reported C.1605/06 date is common in the corpus, and the date is the fact a
    coach cites. Hence `is not False`, not `is True` -- tightening it would
    silently drop real reporting from every document that gave the date but not
    the tickbox."""
    offered = get_bool_field(doc_fields, "C.1401", drops)
    closing = get_split_date(doc_fields, "C.1402", "C.1403", drops)
    notify_by = get_bool_field(doc_fields, "C.1604", drops)
    notification = (
        get_split_date(doc_fields, "C.1605", "C.1606", drops) if notify_by is not False else None
    )
    return round_if_evidenced("regular", offered, closing, notification)


def map_priority_round(doc_fields, drops):
    """C14 priority: a flagless round, evidenced only by its closing date."""
    return round_if_evidenced(
        "priority", None, get_split_date(doc_fields, "C.1404", "C.1405", drops), None
    )


def map_rolling_round(doc_fields, drops):
    """C16 rolling: a checkbox, never a date -- and a TRI-STATE like every other
    round's flag. A school that explicitly reports "no rolling admission" lands
    as offered=false; only an unreported C.1601 emits no row at all."""
    offered = get_bool_field(doc_fields, "C.1601", drops)
    if offered is None:
        return None
    return ("rolling", offered, None, None)


def map_early_round(name, flag_id, dates, doc_fields, drops):
    """One C21/C22 early round. ED2 has no flag question in either template, so
    flag_id is None there and the round rests on its dates alone."""
    offered = get_bool_field(doc_fields, flag_id, drops) if flag_id else None
    closing, notification = dates
    return round_if_evidenced(name, offered, closing, notification)


def list_rounds(doc_fields, dates, drops):
    """[(round, offered, closing, notification)] -- every round the document
    gives evidence for, in output order. C14 (regular closing month/day
    C.1402/03, priority C.1404/05) and C16 (rolling checkbox C.1601; notify-by
    checkbox C.1604 + month/day C.1605/06) are numbered the same in both
    templates (verified live against 2024-25 and 2025-26 rows)."""
    candidates = [
        map_regular_round(doc_fields, drops),
        map_priority_round(doc_fields, drops),
        map_rolling_round(doc_fields, drops),
        map_early_round("early_decision_1", "C.2101", dates["early_decision_1"], doc_fields, drops),
        map_early_round("early_decision_2", None, dates["early_decision_2"], doc_fields, drops),
        map_early_round("early_action", "C.2201", dates["early_action"], doc_fields, drops),
    ]
    return [candidate for candidate in candidates if candidate is not None]


def render_deadline_row(unit_id, doc, round_name, offered, closing, notification):
    return {
        "unit_id": unit_id,
        "source_year": doc_source_year(doc),
        "round": round_name,
        "offered": "true" if offered else "false",
        "closing_month": closing.month if closing else None,
        "closing_day": closing.day if closing else None,
        "notification_month": notification.month if notification else None,
        "notification_day": notification.day if notification else None,
        "source_url": doc["source_url"],
        "archive_url": doc_archive_url(doc),
    }


def map_deadline_rows(unit_id, doc, doc_fields, unreported, drops):
    """The per-round rows for one document: schema -> extraction -> per-round
    policy -> rendering."""
    style = get_schema_style(doc_fields, drops)
    if style is None:
        return []
    dates = map_round_dates(doc_fields, style, drops)
    return [
        render_deadline_row(unit_id, doc, *round_tuple)
        for round_tuple in list_rounds(doc_fields, dates, drops)
    ]



def aid_policy_status(field, unreported_status, drops, fact):
    """The unicoach reading of one cell's corpus status, or None when the cell
    is not there at all. A cell no source carries gets NO row (RFC 158 P7); an
    unmapped corpus status is counted rather than guessed at."""
    if field is not None:
        return STATUS_REPORTED
    if unreported_status is None:
        return None
    mapped = AID_POLICY_STATUS_BY_CORPUS_STATUS.get(unreported_status)
    if mapped is None:
        drops.record("aid_policy_status_unmapped", f"fact=[{fact}] value_status=[{unreported_status}]")
    return mapped


def aid_policy_row(unit_id, doc, fact, field_id, value, status):
    return {
        "unit_id": unit_id,
        "source_year": doc_source_year(doc),
        "fact": fact,
        "value": value,
        "status": status,
        "source_variable": field_id,
        "source_url": doc["source_url"],
        "archive_url": doc_archive_url(doc),
    }


def map_aid_policy_figure(unit_id, doc, doc_fields, unreported, drops, fact, field_id, read_cell):
    """One H2 need figure as a 0-or-1 element list: the value when the cell was
    reported AND parses, a valueless row when the corpus has the cell but could
    not extract it (D7), and nothing at all when the school published nothing.

    A REPORTED cell that does not parse ('All', 'Response Text', 'Nearest $1' --
    real values in this corpus) is dropped and counted, exactly as the three
    older groups drop junk: the school did publish something, and inventing a
    reading of it is the guess this whole tool refuses to make."""
    field = doc_fields.get(field_id)
    status = aid_policy_status(field, unreported.get(field_id), drops, fact)
    if status is None:
        return []
    if status != STATUS_REPORTED:
        return [aid_policy_row(unit_id, doc, fact, field_id, None, status)]
    value = read_cell(field)
    if value is None:
        drops.record(
            "aid_policy_value_junk",
            f"fact=[{fact}] field_id=[{field_id}] {cell_evidence(field)}",
        )
        # OUR gap, not the school's silence (RFC 170, D7): the corpus HAS the
        # cell and we could not read it, which is the same statement its own
        # parse_error makes. Emitting nothing would have made the row absent,
        # and absence downstream reads as "the school did not report it".
        return [aid_policy_row(unit_id, doc, fact, field_id, None, STATUS_NOT_COLLECTED)]
    return [aid_policy_row(unit_id, doc, fact, field_id, value, STATUS_REPORTED)]


def map_aid_policy_form(unit_id, doc, doc_fields, unreported, drops, fact, field_id):
    """One H8 form checkbox as a 0-or-1 element list.

    REQUIRED or UNKNOWN, never "not required" (RFC 170, D5). Across the whole
    corpus these seven checkboxes carry 765 ticks and not one `false`: an
    unticked box simply produces no row, so a missing H.803 means "the CSS
    Profile was not extracted as ticked", which is not the same claim as "the
    CSS Profile is not required". A `false` that some future corpus does
    publish is counted here rather than seeded, because the read layer says
    "not listed in this school's CDS" for everything absent and a stored FALSE
    would quietly turn that into a promise."""
    field = doc_fields.get(field_id)
    status = aid_policy_status(field, unreported.get(field_id), drops, fact)
    if status is None:
        return []
    if status != STATUS_REPORTED:
        return [aid_policy_row(unit_id, doc, fact, field_id, None, status)]
    flag = get_bool(field)
    if flag is None:
        drops.record(
            "aid_policy_flag_junk",
            f"fact=[{fact}] field_id=[{field_id}] {cell_evidence(field)}",
        )
        return [aid_policy_row(unit_id, doc, fact, field_id, None, STATUS_NOT_COLLECTED)]
    if flag is False:
        drops.record("aid_policy_form_not_required_ignored", f"fact=[{fact}] field_id=[{field_id}]")
        return []
    return [aid_policy_row(unit_id, doc, fact, field_id, "true", STATUS_REPORTED)]


def h2_is_contradictory(rows, drops):
    """True when this document's H2 block contradicts itself.

    A fully-met headcount (line h) cannot exceed the line-d denominator it is
    reported against; a document that says otherwise has mis-extracted at least
    one of the two, so the WHOLE block goes and an older document may cover for
    it -- the same all-or-nothing rule map_merit_rows applies to H2A. A
    judgement, separate from the collection above it: what the document says,
    then whether we believe it."""
    counts = {row["fact"]: row["value"] for row in rows if row["status"] == STATUS_REPORTED}
    fully_met = counts.get("need_fully_met_count")
    awarded = counts.get("aid_awarded_freshmen_count")
    if fully_met is None or awarded is None or int(fully_met) <= int(awarded):
        return False
    drops.record(
        "aid_policy_h2_contradictory",
        f"need_fully_met=[{fully_met}] aid_awarded=[{awarded}]",
    )
    return True


def get_borrowing_headcounts(rows):
    """The H4/H5 headcounts this document REPORTS, as whole numbers.

    Headcounts only: a dollar average is never a count of people, and comparing
    one with a headcount is the confusion this seed exists to prevent."""
    return {
        row["fact"]: int(row["value"])
        for row in rows
        if row["status"] == STATUS_REPORTED and row["fact"] in BORROWER_COUNT_FACTS
    }


def borrower_count_is_contradictory(fact, counts, drops):
    """True when this borrower count cannot be true beside the sets that contain
    it: the H.401 graduating class, and -- for a typed loan -- the any-loan
    count. The offending pair is recorded as it is judged, so the ledger names
    the two cells that disagreed rather than the block they were in."""
    borrowers = counts.get(fact)
    if borrowers is None:
        return False
    graduating_class = counts.get(GRADUATING_CLASS_FACT)
    if graduating_class is not None and borrowers > graduating_class:
        drops.record(
            "aid_policy_h5_contradictory",
            f"fact=[{fact}] borrowers=[{borrowers}] "
            f"graduating_class=[{graduating_class}]",
        )
        return True
    any_loan = counts.get(ANY_LOAN_BORROWER_FACT)
    if fact != ANY_LOAN_BORROWER_FACT and any_loan is not None and borrowers > any_loan:
        drops.record(
            "aid_policy_h5_contradictory",
            f"fact=[{fact}] borrowers=[{borrowers}] any_loan_borrowers=[{any_loan}]",
        )
        return True
    return False


def h5_is_contradictory(rows, drops):
    """True when this document's H4/H5 borrowing block contradicts itself.

    Two ways it can, both seen in the live corpus: a borrower headcount above
    the H.401 graduating class it is reported over (ipeds 166629 files a class
    of 39 and 2,588 borrowers), and a per-type count above the any-loan count
    that contains it (ipeds 145637 carries a dollar amount in H.503, a count
    cell). Either says at least one of the two cells was mis-extracted, so the
    WHOLE borrowing block goes -- a share derived at read time must never divide
    by a mis-extracted denominator (RFC 175 D6).

    The borrowing block, and only it. h2_is_contradictory refuses the whole
    group because its subject IS the denominator the other H2 figures are
    reported against; this rule says nothing about the filing's forms or need
    figures, so those stand. A judgement, separate from the collection above it:
    what the document says, then whether we believe it.

    `any()` short-circuits, so the first count that cannot be true ends the
    document: one drop is recorded, naming the pair that decided it."""
    counts = get_borrowing_headcounts(rows)
    return any(
        borrower_count_is_contradictory(fact, counts, drops)
        for fact in (ANY_LOAN_BORROWER_FACT,) + PER_TYPE_BORROWER_FACTS
    )


def drop_averages_over_no_borrowers(rows, drops):
    """This document's rows minus every per-borrower average whose own loan type
    reports NOBODY borrowing (RFC 175 D6).

    A `0` in an average cell is the source's placeholder, not a figure: an
    average cumulative principal is a mean over the borrowers of ITS OWN loan
    type, and a mean over nobody does not exist. Seeded as a number it is spoken
    to a family as "owed $0 on average by the time they graduated", which is a
    claim this corpus never made.

    Conditioned on the PAIR, per cell: a zero average is refused only where that
    loan type's borrower count is zero or missing entirely, so a school that
    genuinely rounded a tiny average to zero against real borrowers keeps it,
    and a zero state-loan average says nothing about the federal average beside
    it. The COUNT's own zero stands -- "no student here borrowed a state loan"
    is the school's own fact and worth saying."""
    counts = get_borrowing_headcounts(rows)
    kept = []
    for row in rows:
        count_fact = AID_POLICY_AVERAGE_BORROWER_COUNTS.get(row["fact"])
        if (
            count_fact is not None
            and row["status"] == STATUS_REPORTED
            and float(row["value"]) == 0
            and not counts.get(count_fact)
        ):
            drops.record(
                "aid_policy_h5_average_over_no_borrowers",
                f"fact=[{row['fact']}] source_variable=[{row['source_variable']}] "
                f"count_fact=[{count_fact}] borrowers=[{counts.get(count_fact)}]",
            )
            continue
        kept.append(row)
    return kept


def map_aid_policy_rows(unit_id, doc, doc_fields, unreported, drops):
    """Every H2 need figure, H4/H5 borrowing figure and H8 form this document
    carries, one row each -- unless the H2 block contradicts itself, in which
    case the document reports nothing for this group, or the borrowing block
    does, in which case that block alone is withheld (RFC 175 D6). Whatever
    survives that, one last per-CELL refusal: an average over a loan type
    nobody borrowed is a placeholder, not a figure."""
    rows = []
    for fact, field_id, read_cell in AID_POLICY_FIGURES:
        rows.extend(
            map_aid_policy_figure(unit_id, doc, doc_fields, unreported, drops, fact, field_id, read_cell)
        )
    for fact, field_id in AID_POLICY_FORMS:
        rows.extend(map_aid_policy_form(unit_id, doc, doc_fields, unreported, drops, fact, field_id))
    if h2_is_contradictory(rows, drops):
        return []
    if h5_is_contradictory(rows, drops):
        return [row for row in rows if row["fact"] not in AID_POLICY_BORROWING_FACTS]
    return drop_averages_over_no_borrowers(rows, drops)


# The four fact groups, in output order: (name, seed filename, CSV header, row
# builder). One table drives selection, the CSV writes and PROVENANCE. Every
# builder takes the same (unit_id, doc, doc_fields, unreported, drops): the
# `unreported` map is the corpus's own non-reported statuses, which only the
# aid-policy group reads (RFC 170, D7).
FACT_GROUPS = [
    ("merit_aid", "merit-aid.csv", MERIT_HEADER, map_merit_rows),
    ("admission_factors", "admission-factors.csv", FACTORS_HEADER, map_factors_rows),
    ("deadlines", "deadlines.csv", DEADLINES_HEADER, map_deadline_rows),
    ("aid_policy", "aid_policy.csv", AID_POLICY_HEADER, map_aid_policy_rows),
]


def has_reported_value(rows):
    """True when `rows` carry at least one VALUE.

    A row whose status bears no value -- our own extraction gap, or the corpus's
    own not_applicable -- records why we have nothing; it is not the group being
    reported. Treating it as reporting stopped the per-group fallback dead: a
    newest filing whose H2 cells all failed extraction kept the group, and an
    older filing with real numbers was never tried. The same tool already falls
    back when a reported cell is junk, so this is one behaviour for one kind of
    failure rather than two."""
    return any(row.get("status", STATUS_REPORTED) == STATUS_REPORTED for row in rows)


def find_newest_reporting(group, build, unit_id, candidates, drops):
    """The rows from the newest of `candidates` (newest first) that actually
    reports this fact group, and empty when none does. Only the winning
    document's drop counters are folded into `drops` -- a document the fallback
    skipped over says nothing about the row that was kept -- except for the
    STICKY_DROPS, which describe the document itself. Each passed-over document
    is recorded under the group with the reasons it yielded nothing, so "why did
    we fall back?" is answerable from PROVENANCE.json alone.

    "Reports" means a VALUE (see has_reported_value); a document that only states
    why it has none is passed over, and its rows are kept only when no older
    filing does better -- with its own ledger folded in at that point, because
    it is then the winning document."""
    valueless = None
    for skipped, (doc, doc_fields, unreported) in enumerate(candidates):
        attempt = Drops(doc_subject(unit_id, doc))
        rows = build(unit_id, doc, doc_fields, unreported, attempt)
        if rows and has_reported_value(rows):
            drops.merge(attempt)
            if skipped:
                drops.record_group(group, "fell_back_to_older_doc", doc_subject(unit_id, doc))
                drops.record_group(group, "documents_skipped", count=skipped)
            return rows
        if rows and valueless is None:
            # Keep the NEWEST valueless answer, ledger and all: if no older
            # filing reports a value, "we could not read this school's newest
            # filing" is still the honest thing to seed, and the document that
            # produced it is then the winning document -- so its drops are
            # merged below rather than reduced to the sticky ones.
            valueless = (rows, attempt, doc)
            drops.record_group(group, "no_value_reported", doc_subject(unit_id, doc))
            continue
        drops.merge(attempt, STICKY_DROPS)
        reasons = ",".join(attempt.reasons()) or "nothing_reported"
        drops.record_group(group, "passed_over", f"{doc_subject(unit_id, doc)} reasons=[{reasons}]")
    if valueless is not None:
        rows, attempt, doc = valueless
        drops.merge(attempt)
        return rows
    if candidates:
        drops.record_group(group, "unreported_in_every_doc", f"unit_id=[{unit_id}]")
    return []


def build_seed(manifest, fields):
    """The four seed tables (keyed by group name) + the drop ledger from raw
    corpus rows. Each group is taken from the newest document that reports it,
    independently of the other two: each table's natural key carries its own
    source_year, so a 2024 merit row beside a 2025 factors row is a first-class
    outcome rather than a compromise."""
    drops = Drops()
    documents = select_documents(manifest, drops)
    fields_by_doc, unreported_by_doc = group_fields(fields, drops)

    seed = {group: [] for group, _, _, _ in FACT_GROUPS}
    for unit_id in sorted(documents):
        candidates = [
            (doc, fields_by_doc[doc["document_id"]], unreported_by_doc.get(doc["document_id"], {}))
            for doc in documents[unit_id]
            if fields_by_doc.get(doc["document_id"])
        ]
        for group, _, _, build in FACT_GROUPS:
            seed[group].extend(find_newest_reporting(group, build, unit_id, candidates, drops))
    seed["deadlines"].sort(key=lambda r: (r["unit_id"], r["source_year"], r["round"]))
    seed["aid_policy"].sort(key=lambda r: (r["unit_id"], r["source_year"], r["fact"]))
    return seed, drops


# ---------------------------------------------------------------------------
# Output
# ---------------------------------------------------------------------------


def build_csv(header, rows):
    """One seed CSV as the bytes that will land on disk.

    Rendered rather than written, because every file this run produces is
    written as ONE set (see main): the digest PROVENANCE.json records is taken
    from these bytes, not by reading a file back after writing it. newline=""
    is the csv module's contract, and the buffer is encoded UTF-8 exactly as
    Path.write_text would."""
    buffer = io.StringIO(newline="")
    writer = csv.DictWriter(buffer, fieldnames=header)
    writer.writeheader()
    for row in rows:
        writer.writerow({k: ("" if v is None else v) for k, v in row.items()})
    return buffer.getvalue().encode("utf-8")


def sha256_of(body):
    return hashlib.sha256(body).hexdigest()


def require_plausible_seed(outdir, seed, manifest, fields):
    """Refuses to overwrite the committed seed with a failed read. The corpus
    reports all three fact groups for hundreds of schools, so an EMPTY group is
    a renamed table, a filter that matched nothing or a rotated key -- never a
    real result -- and a group that collapsed against the row counts the
    committed PROVENANCE.json recorded is the same failure arriving quietly. A
    successful-looking load is not evidence; this is where that is enforced.

    The per-fact aid-policy floors are NOT here: they describe the real
    corpus's size, so main calls require_aid_policy_coverage only for a network
    run. The guards here describe the seed's own shape and apply to every
    run."""
    empty = [name for group, name, _, _ in FACT_GROUPS if not seed[group]]
    if empty:
        fatal(
            f"corpus produced no rows for [{', '.join(empty)}]; "
            f"refusing to overwrite the seed in [{outdir}] "
            f"(manifest_rows=[{len(manifest)}] cds_fields_rows=[{len(fields)}])"
        )

    previous_path = outdir / "PROVENANCE.json"
    if not previous_path.exists():
        return
    try:
        previous = json.loads(previous_path.read_text()).get("rows", {})
    except (OSError, ValueError) as error:
        fatal(f"[{previous_path}] is unreadable [{error}]; move it aside to regenerate from scratch")
    shrunk = [
        f"[{name}]: [{len(seed[group])}] now, [{previous[name]}] committed"
        for group, name, _, _ in FACT_GROUPS
        if isinstance(previous.get(name), int)
        and len(seed[group]) < SEED_SHRINK_FLOOR * previous[name]
    ]
    if shrunk:
        fatal(
            f"row counts collapsed against [{previous_path}] [{'; '.join(shrunk)}]; "
            f"refusing to overwrite the seed in [{outdir}]"
        )


def aid_policy_facts():
    """Every fact name the seed can write -- the figures and the forms, in one
    list, so a guard cannot silently cover a subset of them."""
    return [fact for fact, _, _ in AID_POLICY_FIGURES] + [fact for fact, _ in AID_POLICY_FORMS]


def require_aid_policy_coverage(outdir, rows):
    """Refuses an aid-policy seed in which a single FACT has quietly collapsed.

    The file-level guards above cannot see this: every fact shares one file, so
    a renamed H.209 or an H8 block the extractor stopped ticking would leave the
    row count almost unchanged while the answer to "does this school meet full
    need?" silently became "not reported" for every school. The floors are per
    fact, in distinct colleges, and set well below what the corpus reports."""
    # The floor table and the fact table are kept in step HERE rather than by
    # eye: a fact added without a floor is a fact this guard would pass over.
    unfloored = [fact for fact in aid_policy_facts() if fact not in AID_POLICY_COVERAGE_FLOOR]
    if unfloored:
        fatal(
            f"aid-policy facts have no coverage floor [{', '.join(sorted(unfloored))}]; "
            f"add one to AID_POLICY_COVERAGE_FLOOR rather than leaving the fact unguarded"
        )
    colleges = defaultdict(set)
    for row in rows:
        if row["status"] == STATUS_REPORTED:
            colleges[row["fact"]].add(row["unit_id"])
    thin = [
        f"[{fact}]: [{len(colleges[fact])}] colleges, floor [{floor}]"
        for fact, floor in sorted(AID_POLICY_COVERAGE_FLOOR.items())
        if len(colleges[fact]) < floor
    ]
    if thin:
        fatal(
            f"aid-policy coverage collapsed [{'; '.join(thin)}]; "
            f"refusing to overwrite the seed in [{outdir}]"
        )


def build_seed_files(outdir, seed):
    """[(path, bytes)] for one CSV per fact group, in FACT_GROUPS order."""
    return [
        (outdir / name, build_csv(header, seed[group]))
        for group, name, header, _ in FACT_GROUPS
    ]


def build_provenance(outdir, bodies, seed, drops, manifest, fields, source, anon_key_source):
    """The regenerable-seed manifest AS BYTES: when and from where the seed was built,
    the corpus it was built from, every value dropped as unreported (with a
    bounded sample of the offending documents, and the per-fact-group counters
    nested under their group), and each CSV's row count and digest."""
    provenance = {
        "fetched_at": datetime.now(timezone.utc).isoformat(timespec="seconds"),
        "source": source,
        "anon_key_source": anon_key_source,
        "corpus": {
            "manifest_rows": len(manifest),
            "cds_fields_rows": len(fields),
            "documents_selected": len(
                {(r["unit_id"], r["source_year"]) for rows in seed.values() for r in rows}
            ),
            "dropped": drops.as_json(),
        },
        "rows": {name: len(seed[group]) for group, name, _, _ in FACT_GROUPS},
        "sha256": {name: sha256_of(body) for name, body in bodies.items()},
    }
    return (json.dumps(provenance, indent=2) + "\n").encode("utf-8")


# The name this script reports itself as; every refusal names it, because the
# fetchers all run under one wrapper and a message must say which refused.
SCRIPT_NAME = "fetch-cds-seed"

# The option grammar, in getopt's own notation and declared ONCE: this is what
# pyfunctions.parse_short_options parses argv with, and what it derives the
# value-taking letters from.
#
# -K, not --anon-key: the bin/ conventions allow SHORT options only, and this is
# a hand-run operator tool with no callers in the tree, so the long option is
# replaced rather than aliased. $COLLEGEDATA_ANON_KEY and the API-page scrape are
# the two fallbacks and are unchanged.
GETOPT_SPEC = "o:F:K:h"


def parse_args(argv):
    """(outdir, fixtures, anon_key) from argv, fataling on a malformed option.

    The grammar, the -h answer and every value-shape guard getopt cannot make --
    a repeated option, an empty value (which for -K is an unusable credential the
    fallbacks would then never be consulted for), a value that is really the next
    option -- live in bin/pyfunctions.py, shared with the sibling fetchers. All
    this adds is the typing of the three values."""
    given = parse_short_options(argv, GETOPT_SPEC, __doc__, SCRIPT_NAME)

    outdir = Path(given["-o"]) if "-o" in given else DEFAULT_OUTDIR
    fixtures = Path(given["-F"]) if "-F" in given else None
    # The one post-parse rule only this script has, so it stays here rather than
    # in pyfunctions (fetch-ipeds keeps its own output-directory check for the
    # same reason). A fixtures path that is not a directory is a USAGE mistake:
    # without this, `load_corpus` opens `<file>/manifest.json` and the operator
    # gets a NotADirectoryError traceback and exit 1, which reads as a fault of
    # the corpus rather than of the command they typed.
    if fixtures is not None and not fixtures.is_dir():
        fatal(
            f"option [-F] names [{fixtures}], which is not a directory; an offline replay reads "
            f"[manifest.json] and [fields.json] from inside it",
            status=EXIT_INVALID_ARG_VALUE,
        )
    # The key stays a STRING, never a Path: it is a credential, not a location.
    anon_key = given.get("-K")
    return outdir, fixtures, anon_key


def main(argv):
    outdir, fixtures, anon_key = parse_args(argv)
    outdir.mkdir(parents=True, exist_ok=True)

    manifest, fields, anon_key_source = load_corpus(fixtures, anon_key)
    seed, drops = build_seed(manifest, fields)
    require_plausible_seed(outdir, seed, manifest, fields)
    # A recorded fixture is a few schools by design, so the per-fact coverage
    # floors are asked of a NETWORK run only. main knows which this is; a
    # boolean mode flag threaded into the guard would make the guard ask. It
    # runs BEFORE anything is written, like every other refusal here: a seed
    # whose coverage collapsed must not reach the disk at all.
    if fixtures is None:
        require_aid_policy_coverage(outdir, seed["aid_policy"])

    # EVERY file this run produces is written as one set, or none of it is
    # (RFC 172, bin/pyfunctions.write_atomically). These three CSVs are
    # COMMITTED, REVIEWED files: writing them one at a time means a fault partway
    # through leaves new rows under a STALE PROVENANCE.json, whose digests and
    # row counts then describe files that no longer exist -- and the next run
    # measures its shrink guard against exactly those numbers.
    source = "fixtures" if fixtures is not None else "network"
    files = build_seed_files(outdir, seed)
    bodies = {path.name: body for path, body in files}
    files.append((
        outdir / "PROVENANCE.json",
        build_provenance(outdir, bodies, seed, drops, manifest, fields, source, anon_key_source),
    ))
    write_atomically(files, SCRIPT_NAME)

    # Every value in brackets, and the drop ledger rendered rather than
    # interpolated: a dict interpolates as a Python repr, whose quotes are a
    # second wrapper this project's messages do not use.
    counts = " ".join(f"{name}=[{len(seed[group])}]" for group, name, _, _ in FACT_GROUPS)
    dropped = " ".join(f"{reason}=[{count}]" for reason, count in drops.summary().items())
    log_info(f"seed written to [{outdir}]: {counts} dropped: {dropped or '[none]'}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
