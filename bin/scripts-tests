  cds_drop_count deadline_flag_junk 1
assert_success "the whitelist-missing rating text is recorded, not just counted" \
  cds_drop_sample_has factor_rating_junk 'value=[X]'
# The still-usable half of zeta's H2A block seeds a row; only the junk cell is
# dropped.
assert_success "the parsed merit cells still seed a row beside the junk one" \
  seed_has '^666666,2025,1200,,,' merit-aid.csv


# RFC 170: the H2 need figures and the H8 forms, each row carrying its own
# status. The seed's fourth file is the first place a cell the corpus HAS but
# could not extract survives as a fact about OUR gap, rather than as a drop
# counter nobody downstream can see.
assert_success "a percent cell is read from value_num, not from its text" \
  seed_has '^111111,2025,avg_need_met_percent,94.3,reported,H.209,' aid_policy.csv
assert_success "a dollar average keeps its cents, which get_int would have dropped" \
  seed_has '^111111,2025,avg_need_based_grant_usd,18006.5357,reported,H.211,' aid_policy.csv
assert_success "the two H2 headcounts land as reported integers" \
  seed_has '^111111,2025,aid_awarded_freshmen_count,800,reported,H.204,' aid_policy.csv
assert_success "a ticked form checkbox lands as required" \
  seed_has '^111111,2025,fafsa_required,true,reported,H.801,' aid_policy.csv
assert_success "a Yes-spelled form flag lands as required too" \
  seed_has '^111111,2025,css_profile_required,true,reported,H.803,' aid_policy.csv
# D7: a corpus parse_error is OUR gap, and says so in a row with no value --
# NOT the school's silence, which is row-absence.
assert_success "a corpus parse_error lands as not_collected_by_us, with no value" \
  seed_has '^111111,2025,noncustodial_css_profile_required,,not_collected_by_us,H.805,' aid_policy.csv
assert_success "a form the school did not list gets no row at all" \
  seed_lacks 'business_farm_supplement_required' aid_policy.csv
# D5: the corpus publishes 9,072 ticks and no unticked box; a false that some
# future corpus does publish is counted, never seeded as "not required".
assert_success "an explicit false form flag is dropped, never seeded as not-required" \
  seed_lacks 'institutional_form_required' aid_policy.csv
assert_success "the ignored false flag is counted in PROVENANCE.json" \
  cds_drop_count aid_policy_form_not_required_ignored 1
# The corpus's own not_applicable is the SOURCE speaking, so it keeps its own
# status rather than being read as our gap.
assert_success "a corpus not_applicable keeps its own status" \
  seed_has '^666666,2025,avg_need_based_grant_usd,,not_applicable,H.211,' aid_policy.csv
assert_success "a reported-but-unparseable need figure is counted, and says so as our own gap" \
  cds_drop_count aid_policy_value_junk 1
assert_success "the unreadable need figure seeds a valueless row rather than vanishing" \
  seed_has '^666666,2025,avg_need_met_percent,,not_collected_by_us,H.209,' aid_policy.csv
# The drop records the WHOLE cell, not value_text alone: the rules that refuse
# a cell test value_num and value_bool too, so a ledger naming only the text
# names a column that did not fail.
assert_success "the junk need cell's field and every part of the cell are recorded" \
  cds_drop_sample_has aid_policy_value_junk 'field_id=[H.209] kind=[None] num=[None] bool=[None] text=[Nearest 1%]'
# A form flag the tri-state reader cannot recognise ('Response Text' is a real
# corpus value) is OUR gap, not the school's silence: the corpus carries the
# cell and we could not read it, which is the same statement its own
# parse_error makes. It is counted AND seeded as a valueless row, so the row's
# absence keeps meaning "this school's CDS does not list the form".
assert_success "a reported-but-unrecognised form flag seeds our own gap, not silence" \
  seed_has '^666666,2025,state_aid_form_required,,not_collected_by_us,H.804,' aid_policy.csv
assert_success "the junk form flag is counted in PROVENANCE.json" \
  cds_drop_count aid_policy_flag_junk 1
assert_success "the junk form cell's field and every part of the cell are recorded" \
  cds_drop_sample_has aid_policy_flag_junk 'field_id=[H.804] kind=[checkbox] num=[None] bool=[None] text=[Response Text]'
# The same all-or-nothing rule H2A already applies: a fully-met headcount above
# the denominator it is reported against means the block was mis-extracted.
assert_success "a contradictory H2 block emits no aid-policy row at all" \
  seed_lacks '^555555,' aid_policy.csv
assert_success "the contradictory H2 block is counted in PROVENANCE.json" \
  cds_drop_count aid_policy_h2_contradictory 1

# group_fields' two silent skips are counted: a non-'reported' status (an
