}
assert_success "a Scorecard-only ingest-colleges run passes no IPEDS argv at all" test_ingest_colleges_no_ipeds_argv

# SFA group (RFC 162): its OWN all-or-nothing group, -S (the sfa CSV) plus -f
# (the aid-year START year). Separate from the six above because SFA is a
# separate survey on a separate year -- SFA2223 is aid year 2022-23 and ships in
# collection year 2023, so -f 2022 and -y 2023 are both right and different. The
# aid year is -f rather than -Y because RFC 161 already gave -Y to the IC_AY
# published-charges CSV. The assertions mirror the IPEDS ones one for one,
# because the same silent failure is available here: a lone flag that fell
# through would downgrade the run to a no-SFA run with a green exit.
assert_exit_code "$EXIT_MISSING_REQUIRED_ARG" "ingest-colleges rejects a partial SFA group (only -S)" \
  bin/ingest-colleges -S sfa2223.csv a.csv b.csv
assert_exit_code "$EXIT_MISSING_REQUIRED_ARG" "ingest-colleges rejects a partial SFA group (only -f)" \
  bin/ingest-colleges -f 2022 a.csv b.csv
assert_exit_code "$EXIT_OPTION_REQUIRES_VALUE" "ingest-colleges -S without a value exits 11" \
  bin/ingest-colleges -S
assert_exit_code "$EXIT_OPTION_REQUIRES_VALUE" "ingest-colleges -f without a value exits 11" \
  bin/ingest-colleges -f
assert_exit_code "$EXIT_INVALID_ARG_VALUE" "ingest-colleges rejects an empty SFA flag value" \
  bin/ingest-colleges -S "" -f 2022 a.csv b.csv
assert_exit_code "$EXIT_INVALID_ARG_VALUE" "ingest-colleges rejects an all-empty SFA group, never a silent no-SFA run" \
  bin/ingest-colleges -S "" -f "" a.csv b.csv
assert_exit_code "$EXIT_INVALID_ARG_VALUE" "ingest-colleges rejects a repeated SFA flag" \
  bin/ingest-colleges -S A.csv -S B.csv -f 2022 a.csv b.csv
# The three year-ish flags belong to two DIFFERENT all-or-nothing groups: -y
# (IPEDS collection year) and -Y (the IC_AY charges CSV) name the IPEDS group,
# -f (SFA aid year) names the SFA one. Each alone must name ITS OWN group in the
# refusal; a parser that confused them would report the wrong one and send the
# operator looking for a file it never passed.
test_ingest_colleges_year_flag_groups() {
  local out rc=0
  out="$(bin/ingest-colleges -f 2022 a.csv b.csv 2>&1)" || rc=$?
  case "$out" in
  *"the [SFA] options are all-or-nothing"*) ;;
  *) log-error "-f alone did not name the SFA group: [$out]"; return 1 ;;
  esac
  rc=0
  out="$(bin/ingest-colleges -Y ic2023_ay.csv a.csv b.csv 2>&1)" || rc=$?
  case "$out" in
  *"the [IPEDS] options are all-or-nothing"*) ;;
  *) log-error "-Y alone did not name the IPEDS group: [$out]"; return 1 ;;
  esac
  rc=0
  out="$(bin/ingest-colleges -y 2023 a.csv b.csv 2>&1)" || rc=$?
  case "$out" in
  *"the [IPEDS] options are all-or-nothing"*) return 0 ;;
  *) log-error "-y alone did not name the IPEDS group: [$out]"; return 1 ;;
  esac
}
assert_success "ingest-colleges -y, -Y and -f alone name their own group, never each other's" \
  test_ingest_colleges_year_flag_groups
# The help text documents the group. A grammar the help does not mention is a
# grammar nobody can invoke, and -h is the one place stdout is allowed to speak.
test_ingest_colleges_help_documents_sfa() {
  local out
  out="$(bin/ingest-colleges -h 2>/dev/null)"
  case "$out" in
  *"-S FILE"*) ;;
  *) log-error "help text does not document -S"; return 1 ;;
  esac
  case "$out" in
  *"-f YYYY"*) return 0 ;;
  *) log-error "help text does not document -f"; return 1 ;;
  esac
}
assert_success "ingest-colleges -h documents the -S/-f SFA group" \
  test_ingest_colleges_help_documents_sfa
# The resolved file AND the caller's original argument are both forwarded, the
# same contract the IPEDS five have: the provenance row records what the caller
# named, not the scratch path an s3:// download landed in.
test_ingest_colleges_sfa_source_flags() {
  local root parent stub argv inst fields sfa entry rc log
  parent="$(mktemp -d)"
  root="$parent/unicoach-sfaflags"
  mkdir -p "$root"
  for entry in bin .env .env.dev .env.test .env.fuzz db; do
    ln -s "$PROJECT_ROOT/$entry" "$root/$entry"
  done
  stub="$root/college/build/install/college/bin/college"
  argv="$parent/launcher-argv"
  mkdir -p "$(dirname "$stub")"
  printf '#!/usr/bin/env bash\nprintf "%%s\\n" "$@" > %q\n' "$argv" > "$stub"
  chmod +x "$stub"
  inst="$parent/institution.csv"; fields="$parent/fields.csv"
  sfa="$parent/sfa2223.csv"
  : > "$inst"; : > "$fields"; : > "$sfa"
  log="$parent/ingest.log"
  rc=0
  "$root/bin/ingest-colleges" -S "$sfa" -f 2022 "$inst" "$fields" > "$log" 2>&1 || rc=$?
  if [ "$rc" -ne 0 ]; then
    log-error "ingest-colleges exited [$rc]:"
    cat "$log" >&2
    rm -rf "$parent"
    return "$rc"
  fi
  # The --sfa= path is the RESOLVED one (an s3:// arg is downloaded, and even a
  # local path comes back through realpath), so only its PRESENCE is asserted
  # here; the exact string that must survive untouched is the --sfa-source=
  # partner, which is what the provenance row records.
  grep -q -- "^--sfa=" "$argv" &&
    grep -qxF -- "--sfa-source=$sfa" "$argv" &&
    grep -qxF -- "--sfa-aid-year=2022" "$argv"
  rc=$?
  [ "$rc" -eq 0 ] || { log-error "launcher argv was:"; cat "$argv" >&2; }
  rm -rf "$parent"
  return "$rc"
}
assert_success "ingest-colleges forwards the SFA file, its original arg and the aid year to the launcher" \
  test_ingest_colleges_sfa_source_flags
# A run without the group must not grow SFA argv at all -- absent, not
# present-and-empty, so every pre-RFC-162 invocation is byte-identical.
