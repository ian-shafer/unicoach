# A successful-looking load is not evidence: an empty or collapsed corpus read
# must never overwrite the committed, reviewed seed.
test_cds_empty_corpus_refused() {
  local empty out
  empty="$(mktemp -d)"; out="$(mktemp -d)"
  echo '[]' > "$empty/manifest.json"
  echo '[]' > "$empty/fields.json"
  bin/fetch-cds-seed -F "$empty" -o "$out" > /dev/null 2>&1
  local status=$?
  rm -rf "$empty" "$out"
  return $status
}
assert_failure "an empty corpus read is refused, not written as a blank seed" \
  test_cds_empty_corpus_refused

test_cds_collapsed_corpus_refused() {
  local out
  out="$(mktemp -d)"
  cp "$CDS_OUT"/*.csv "$CDS_OUT/PROVENANCE.json" "$out/"
  python3 - "$out/PROVENANCE.json" << 'PY'
import json, sys
path = sys.argv[1]
provenance = json.loads(open(path).read())
provenance["rows"] = {name: 1000 for name in provenance["rows"]}
open(path, "w").write(json.dumps(provenance, indent=2) + "\n")
PY
  bin/fetch-cds-seed -F "$CDS_FIXTURES" -o "$out" > /dev/null 2>&1
  local status=$?
  rm -rf "$out"
  return $status
}
assert_failure "a collapsed row count against the committed PROVENANCE is refused" \
  test_cds_collapsed_corpus_refused

# The committed seed and its manifest must agree: a hand edit or a half
# regeneration of db/seed/cds/ is a lie the ingest would happily load.
test_cds_provenance_matches_seed() {
  python3 - "$PROJECT_ROOT/db/seed/cds" << 'PY'
import csv, hashlib, io, json, sys
from pathlib import Path

seed_dir = Path(sys.argv[1])
provenance = json.loads((seed_dir / "PROVENANCE.json").read_text())
for name, digest in provenance["sha256"].items():
    body = (seed_dir / name).read_bytes()
    if hashlib.sha256(body).hexdigest() != digest:
        sys.exit(f"{name}: sha256 differs from PROVENANCE.json")
    # csv.reader, not a newline count: a quoted embedded newline would make
    # the guard a false alarm, and RECORDS is what PROVENANCE.rows means.
    rows = sum(1 for _ in csv.DictReader(io.StringIO(body.decode())))
    if rows != provenance["rows"][name]:
        sys.exit(f"{name}: {rows} rows, PROVENANCE.json says {provenance['rows'][name]}")
PY
}
assert_success "the committed CDS seed matches PROVENANCE.json (sha256 + row counts)" \
  test_cds_provenance_matches_seed

# RFC 172 §5: the option grammar is the stdlib getopt module, and the three
# bands it is mapped onto are three DIFFERENT operator mistakes.
assert_exit_code "$EXIT_UNKNOWN_OPTION" "fetch-cds-seed rejects an unknown option (10)" \
  bin/fetch-cds-seed -z
assert_exit_code "$EXIT_OPTION_REQUIRES_VALUE" "fetch-cds-seed -F without a value exits 11" \
  bin/fetch-cds-seed -F
assert_exit_code "$EXIT_OPTION_REQUIRES_VALUE" "fetch-cds-seed -o without a value exits 11" \
  bin/fetch-cds-seed -o
assert_exit_code "$EXIT_OPTION_REQUIRES_VALUE" "fetch-cds-seed -K without a value exits 11" \
  bin/fetch-cds-seed -K
assert_exit_code "$EXIT_UNEXPECTED_ARG" "fetch-cds-seed rejects a stray positional (20, not 10)" \
  bin/fetch-cds-seed stray
assert_exit_code "$EXIT_UNEXPECTED_ARG" "fetch-cds-seed rejects a positional after a good option (20)" \
  bin/fetch-cds-seed -o /tmp stray

# The value-shape checks getopt itself cannot make: an empty value, a value
# beginning with "-" (a dropped operand), and a repeated flag (a last-wins guess
# about which of two values was meant).
assert_exit_code "$EXIT_INVALID_ARG_VALUE" "fetch-cds-seed rejects an empty -o value (22)" \
  bin/fetch-cds-seed -o ""
assert_exit_code "$EXIT_INVALID_ARG_VALUE" "fetch-cds-seed rejects an empty -K value (22)" \
  bin/fetch-cds-seed -K ""
assert_exit_code "$EXIT_INVALID_ARG_VALUE" "fetch-cds-seed rejects [-o -F], a dropped operand (22)" \
  bin/fetch-cds-seed -o -F
assert_exit_code "$EXIT_INVALID_ARG_VALUE" "fetch-cds-seed refuses a repeated -o rather than last-wins (22)" \
  bin/fetch-cds-seed -o /tmp -o /tmp
assert_exit_code "$EXIT_INVALID_ARG_VALUE" "fetch-cds-seed refuses a repeated -F rather than last-wins (22)" \
  bin/fetch-cds-seed -F /tmp -F /tmp
# RFC 170: the one post-parse rule this fetcher has of its own -- a -F that names
# something other than a directory. getopt cannot see it, and without the guard
# the operator gets a NotADirectoryError traceback and exit 1 for what is a
# mistake in the command they typed.
assert_exit_code "$EXIT_INVALID_ARG_VALUE" "fetch-cds-seed refuses a -F that is not a directory (22)" \
  bin/fetch-cds-seed -F "$PROJECT_ROOT/bin/functions"

# RFC 172 §5: --anon-key is RETIRED, replaced by -K. The bin/ conventions allow
# short options only, and this is a hand-run operator tool with no callers in the
# tree, so the long form is now simply an unknown option (10) rather than an
# alias. -K itself parses, which the offline run below proves by taking one.
assert_exit_code "$EXIT_UNKNOWN_OPTION" "fetch-cds-seed rejects the retired --anon-key long option (10)" \
  bin/fetch-cds-seed --anon-key jwt -F /tmp -o /tmp
assert_exit_code "$EXIT_UNKNOWN_OPTION" "fetch-cds-seed rejects --anon-key= in its glued form too (10)" \
  bin/fetch-cds-seed --anon-key=jwt -F /tmp -o /tmp

# RFC 172 §5: stdout is EMPTY on a normal run -- the product is files on disk, so
# the closing summary is a diagnostic and belongs on stderr. The same run takes
# -K, so the replacement option is exercised on a path that reaches the write.
# (Offline, the key is never consulted; -K parsing is what is under test.)
# Modelled on test_ipeds_logs_to_stderr_and_stdout_stays_empty.
test_cds_logs_to_stderr_and_stdout_stays_empty() {
  local out stdout stderr status
  out="$(mktemp -d)"
  stdout="$(mktemp)"
  stderr="$(mktemp)"
  bin/fetch-cds-seed -F "$CDS_FIXTURES" -o "$out" -K not-a-real-jwt > "$stdout" 2> "$stderr"
  status=$?
  cds_stderr_cleanup() { rm -rf "$out" "$stdout" "$stderr"; }
  if [ "$status" -ne 0 ]; then
    log-error "exit [$status], stderr [$(cat "$stderr")]"; cds_stderr_cleanup; return 1
  fi
  if [ -s "$stdout" ]; then
    log-error "stdout is not empty, it holds [$(cat "$stdout")]"; cds_stderr_cleanup; return 1
  fi
  # The summary that used to live on stdout must still be SAID, on stderr.
  grep -qF -- "seed written to" "$stderr" \
    || { log-error "stderr does not report the summary"; cds_stderr_cleanup; return 1; }
  # "dropped:" now, with each reason=[count] bracketed: the ledger used to be
  # interpolated as a python dict repr, whose quotes are a wrapper this
  # project's messages do not use.
  grep -qF -- "dropped:" "$stderr" \
    || { log-error "stderr does not report the drop ledger: [$(cat "$stderr")]"; cds_stderr_cleanup; return 1; }
  cds_stderr_cleanup
  return 0
}
assert_success "a successful fetch-cds-seed run (-K) writes its summary to stderr and NOTHING to stdout" \
  test_cds_logs_to_stderr_and_stdout_stays_empty

# -h is the ONE thing this script puts on stdout, and it must name the new -K
# rather than the retired long option: the help is the operator's only record of
# a breaking interface change.
test_cds_help_exits_zero_on_stdout() {
  local out err status
  out="$(mktemp)"
  err="$(mktemp)"
  bin/fetch-cds-seed -h > "$out" 2> "$err"
  status=$?
  [ "$status" -eq 0 ] || { log-error "-h exited [$status]"; rm -f "$out" "$err"; return 1; }
  grep -q "fetch-cds-seed: build the CDS admissions seed" "$out" \
    || { log-error "-h printed no help: [$(head -3 "$out")]"; rm -f "$out" "$err"; return 1; }
  grep -q -- "-K JWT" "$out" \
    || { log-error "-h does not document -K"; rm -f "$out" "$err"; return 1; }
  if grep -q -- "--anon-key" "$out"; then
    log-error "-h still documents the retired --anon-key"; rm -f "$out" "$err"; return 1
  fi
  [ ! -s "$err" ] || { log-error "-h wrote to stderr: [$(head -3 "$err")]"; rm -f "$out" "$err"; return 1; }
  rm -f "$out" "$err"
  return 0
}
assert_success "fetch-cds-seed -h prints the help to stdout (documenting -K, not --anon-key)" \
  test_cds_help_exits_zero_on_stdout
rm -rf "$CDS_FIXTURES" "$CDS_OUT"

# ── RFC 147: published codebooks (bin/fetch-codebooks) ───────────────────────
echo ""
echo "==== Testing RFC 147 codebook generation ===="

assert_success "bin/fetch-codebooks parses as python3" \
  python3 -c "import ast; ast.parse(open('$PROJECT_ROOT/bin/fetch-codebooks').read())"

# The whole transform runs offline against the recorded Stata .do fixtures (-F,
# no network): the value-label and variable-label parses, the caret repair, the
# sentinel policy, the slug rule and every structure the generator claims to
# recover (D38-D43). The fixtures are verbatim SUBSETS of the published files,
# so a parse that only works on invented text cannot pass here.
CODEBOOK_FIXTURES="$PROJECT_ROOT/college/src/test/resources"
# No EXIT trap here: the harness's daemon-teardown trap (top of file) must not
# be clobbered. The dir is removed at the end of this section.
CODEBOOK_OUT="$(mktemp -d)"
assert_success "fetch-codebooks runs offline from the recorded .do fixtures" \
  bin/fetch-codebooks -F "$CODEBOOK_FIXTURES" -o "$CODEBOOK_OUT" \
    -j "$CODEBOOK_OUT/codebooks.json" > /dev/null

# The generated codebook is JSON with structure per code, so these read it as
# JSON rather than grepping a line: one helper evaluating a python expression
# over the parsed file, with `codes(domain)` giving {code -> entry}.
codebook_assert() {
  python3 - "$CODEBOOK_OUT/codebooks.json" "$1" << 'PY'
import json, sys
codebooks = json.load(open(sys.argv[1]))
scope = {
    "codebooks": codebooks,
    "codes": lambda domain: {c["code"]: c for c in codebooks[domain]["codes"]},
}
# Parenthesised so a readable multi-line assertion is one expression.
if not eval(f"({sys.argv[2]})", scope):
    sys.exit(f"codebook assertion failed: {sys.argv[2]}")
PY
}

# D39: a published label is a record. OBEREG carries its membership, and
# us_states is built from exactly that parse plus HD2023's own state names.
assert_success "an OBEREG label yields its name and its state membership" \
  codebook_assert 'codes("ipeds_region")[1]["name"] == "New England"
                   and codes("ipeds_region")[1]["member_states"] == ["CT", "ME", "MA", "NH", "RI", "VT"]
                   and codes("ipeds_region")[0]["member_states"] == []'
assert_success "every jurisdiction lands in exactly one region, with its kind" \
  codebook_assert 'codes("us_states")["MA"]["ipeds_region"] == "new-england"
                   and codes("us_states")["DC"]["jurisdiction_kind"] == "federal-district"
                   and codes("us_states")["PR"]["jurisdiction_kind"] == "territory"
                   and codes("us_states")["PW"]["jurisdiction_kind"] == "freely-associated-state"
                   and sum(1 for c in codebooks["us_states"]["codes"]
                           if c["jurisdiction_kind"] == "state") == 50'
assert_success "a locale label yields type and detail" \
  codebook_assert 'codes("nces_locale")[41]["type"] == "rural"
                   and codes("nces_locale")[41]["detail"] == "fringe"
                   and codes("nces_locale")[41]["slug"] == "rural-fringe"
                   and codes("nces_locale")[41]["name"] == "Rural: Fringe"'
assert_success "a size-setting label yields years, size and residential character" \
  codebook_assert 'codes("carnegie_2021_size_setting")[11]["years"] == 4
                   and codes("carnegie_2021_size_setting")[11]["size"] == "small"
                   and codes("carnegie_2021_size_setting")[11]["residential_character"] == "highly residential"
                   and codes("carnegie_2021_size_setting")[18]["years"] is None'
assert_success "a Carnegie basic label yields degree level and qualifier" \
  codebook_assert 'codes("carnegie_2021_basic")[15]["degree_level"] == "Doctoral Universities"
                   and codes("carnegie_2021_basic")[15]["qualifier"] == "Very High Research Activity"
                   and codes("carnegie_2021_basic")[33]["qualifier"] is None'

# D38: the published bytes are kept verbatim; the human string is repaired HERE,
# where a person reviews the diff.
assert_success "the caret apostrophe is repaired in name and kept verbatim in label_raw" \
  codebook_assert 'codes("carnegie_2021_basic")[1]["name"] == "Associate\u0027s Colleges: High Transfer-High Traditional"
                   and codes("carnegie_2021_basic")[1]["label_raw"] == "Associate^s Colleges: High Transfer-High Traditional"'

# D40: ASSOC1..6 is six flags whose meaning lives in the VARIABLE label, and
# college_ipeds.athletic_assoc stores the ordinal, so the ordinal is the code.
# The publisher's double space is repaired in name only.
assert_success "the athletic associations come from the variable labels, keyed by ordinal" \
  codebook_assert 'codes("athletic_association")[3]["slug"] == "njcaa"
                   and codes("athletic_association")[3]["source_variable"] == "assoc3"
                   and "Athletic  Association" in codes("athletic_association")[3]["label_raw"]
                   and "Athletic Association" in codes("athletic_association")[3]["name"]'

# D41: -2 is a real answer and IS a row; -1/-3 are absence, declared and never
# emitted as codes.
assert_success "-2 is a codebook row and -1/-3 are declared, not emitted" \
  codebook_assert 'codes("football_conference")[-2]["slug"] == "not-applicable"
                   and -1 not in codes("football_conference")
                   and codebooks["football_conference"]["null_sentinels"] == [-1, -3]
                   and codebooks["cip_code"]["null_sentinels"] == []'

# D43: the CIP list is the 6-digit code set. "Grand total" is an AGGREGATE the
# publisher ships in the same label set, and it is not a CIP code.
assert_success "CIP codes are six-digit strings and the Grand total aggregate is excluded" \
  codebook_assert 'codes("cip_code")["010000"]["name"] == "Agriculture, General"
                   and all(len(c) == 6 and c.isdigit() for c in codes("cip_code"))'

# The slug rule is the primary key of nine of the ten domains: it must satisfy
# the SQL domain's pattern and be unique per domain, or the load fails after the
# review rather than during it.
assert_success "every slug matches the slug domain pattern and is unique per domain" \
  codebook_assert 'all(__import__("re").match(r"^[a-z0-9]+(-[a-z0-9]+)*$", c["slug"])
                       for d in codebooks.values() for c in d["codes"] if "slug" in c)
                   and all(len({c["slug"] for c in d["codes"] if "slug" in c})
                           == len([c for c in d["codes"] if "slug" in c])
                           for d in codebooks.values())'

# PROVENANCE is read as JSON, not grepped: the per-domain counts are what the
# shrink guard compares against next time, and the conference note records the
# measured fact that CONFNO1..4 are NOT one shared vocabulary.
codebook_provenance_assert() {
  python3 - "$CODEBOOK_OUT/PROVENANCE.json" "$1" << 'PY'
import json, sys
provenance = json.load(open(sys.argv[1]))
if not eval(f"({sys.argv[2]})", {"provenance": provenance}):
    sys.exit(f"provenance assertion failed: {sys.argv[2]}")
PY
}
assert_success "PROVENANCE records the offline route and the per-domain counts" \
  codebook_provenance_assert 'provenance["source"] == "fixtures"
                              and provenance["domains"]["us_states"] == 59
                              and provenance["artifacts"]["HD2023_Stata.zip"]["member"].lower().endswith(".do")'
assert_success "PROVENANCE records the excluded CIP aggregate and the per-sport conference sets" \
  codebook_provenance_assert 'provenance["notes"]["cip_aggregate_rows_excluded"] == 1
                              and provenance["notes"]["conference_label_sets"]["confno1"]
                                  != provenance["notes"]["conference_label_sets"]["confno2"]'

# A successful-looking parse is not evidence: a domain that collapsed against
# the committed counts is a changed upstream format, and it must never overwrite
# the reviewed codebook.
test_codebooks_shrink_refused() {
  local out output status
  out="$(mktemp -d)"
  cp "$CODEBOOK_OUT/PROVENANCE.json" "$out/"
  python3 - "$out/PROVENANCE.json" << 'PY'
import json, sys
path = sys.argv[1]
provenance = json.loads(open(path).read())
provenance["domains"] = {name: 1000 for name in provenance["domains"]}
open(path, "w").write(json.dumps(provenance, indent=2) + "\n")
PY
  output="$(bin/fetch-codebooks -F "$CODEBOOK_FIXTURES" -o "$out" -j "$out/codebooks.json" 2>&1)"
  status=$?
  # A non-zero exit alone would be satisfied by a typo'd path or a traceback.
  # The guard's whole claim is that the reviewed file is NOT overwritten, so
  # that is what is asserted: the named refusal, and no output file at all.
  case "$output" in
    # The refusal names the SCRIPT that made it (RFC 172: the fetchers all run
    # under one orchestrator, so an unattributed [FATAL] costs a lookup).
    *"[FATAL] fetch-codebooks: code counts collapsed"*) ;;
    *) rm -rf "$out"; return 1 ;;
  esac
  [ -e "$out/codebooks.json" ] && { rm -rf "$out"; return 1; }
  [ "$status" -ne 0 ] || { rm -rf "$out"; return 1; }
  rm -rf "$out"
  return 0
}
assert_success "a collapsed domain count is refused, and the codebook is NOT written" \
  test_codebooks_shrink_refused

# The guard is keyed on the file it is about to overwrite, not on -o: -o and -j
# are independent options, so a fresh -o used to disarm the guard entirely for
# the committed -j. Here -o is an empty directory and -j is a real codebook.
test_codebooks_shrink_refused_with_fresh_outdir() {
  local out target output status
  out="$(mktemp -d)"
  target="$(mktemp -d)/codebooks.json"
  cp "$CODEBOOK_OUT/codebooks.json" "$target"
  python3 - "$target" << 'PY'
import json, sys
path = sys.argv[1]
codebooks = json.loads(open(path).read())
for entry in codebooks.values():
    entry["codes"] = entry["codes"] * 40
open(path, "w").write(json.dumps(codebooks, indent=2) + "\n")
PY
  output="$(bin/fetch-codebooks -F "$CODEBOOK_FIXTURES" -o "$out" -j "$target" 2>&1)"
  status=$?
  rm -rf "$out"
  case "$output" in
    # The refusal names the SCRIPT that made it (RFC 172: the fetchers all run
    # under one orchestrator, so an unattributed [FATAL] costs a lookup).
    *"[FATAL] fetch-codebooks: code counts collapsed"*) ;;
    *) return 1 ;;
  esac
  [ "$status" -ne 0 ] || return 1
  return 0
}
assert_success "a fresh -o does not disarm the shrink guard protecting -j" \
  test_codebooks_shrink_refused_with_fresh_outdir

# Provenance records a FETCH. An offline replay has none, so it must never
# overwrite a manifest that recorded one -- the documented reproduction command
# points -o at db/seed/codebooks by default.
test_codebooks_offline_leaves_network_provenance() {
  local before after json output
  json="$(mktemp -d)/codebooks.json"
  before="$(shasum -a 256 < "$PROJECT_ROOT/db/seed/codebooks/PROVENANCE.json")"
  output="$(bin/fetch-codebooks -F "$PROJECT_ROOT/db/seed/codebooks" -j "$json" 2>&1)" || return 1
  after="$(shasum -a 256 < "$PROJECT_ROOT/db/seed/codebooks/PROVENANCE.json")"
  [ "$before" = "$after" ] || return 1
  case "$output" in
    *"[WARNING]"*"records a real fetch"*) return 0 ;;
    *) return 1 ;;
  esac
}
assert_success "an offline run leaves a network PROVENANCE.json untouched, and says so" \
  test_codebooks_offline_leaves_network_provenance

# A label whose structure the generator cannot read is FATAL at generation time
# (D39): a codebook missing the labels it could not parse is worse than none.
test_codebooks_unreadable_label_refused() {
  local fixtures output status
  fixtures="$(mktemp -d)"
  cp "$CODEBOOK_FIXTURES"/codebooks-*-fixture.do "$fixtures/"
  echo 'label define label_c21szset 19 "Five-year, gargantuan, semi-residential", add' \
    >> "$fixtures/codebooks-hd2023-fixture.do"
  output="$(bin/fetch-codebooks -F "$fixtures" -o "$fixtures" -j "$fixtures/codebooks.json" 2>&1)"
  status=$?
  # The named refusal and no output file, not merely a non-zero exit: a missing
  # fixture or a traceback would satisfy the exit code just as well.
  case "$output" in
    *"[FATAL]"*"unreadable label"*) ;;
    *) rm -rf "$fixtures"; return 1 ;;
  esac
  [ -e "$fixtures/codebooks.json" ] && { rm -rf "$fixtures"; return 1; }
  [ "$status" -ne 0 ] || { rm -rf "$fixtures"; return 1; }
  rm -rf "$fixtures"
  return 0
}
assert_success "an unparseable label is refused, and the codebook is NOT written" \
  test_codebooks_unreadable_label_refused

# D39 at generation time: the CODE is a key too (the primary key in us_states
# and cip_code), and a duplicate used to survive into the reviewed file and fail
# hours later at the SQL constraint.
test_codebooks_duplicate_code_refused() {
  local fixtures output
  fixtures="$(mktemp -d)"
  cp "$CODEBOOK_FIXTURES"/codebooks-*-fixture.do "$fixtures/"
  # Two DIFFERENT labels under one code: distinct slugs, colliding key.
  echo 'label define label_relaffil 30 "Duplicated Denomination", add' \
    >> "$fixtures/codebooks-ic2023-fixture.do"
  output="$(bin/fetch-codebooks -F "$fixtures" -o "$fixtures" -j "$fixtures/codebooks.json" 2>&1)"
  rm -rf "$fixtures"
  case "$output" in
    *"[FATAL]"*"duplicate codes"*) return 0 ;;
    *) return 1 ;;
  esac
}
assert_success "a duplicate published code is refused at generation, not at the primary key" \
  test_codebooks_duplicate_code_refused

# The fixture that stands in for an artifact is DECLARED in ARTIFACTS and
# matched by exact name (bin/fetch-ipeds' rule). Under the normalised
# longest-substring rule it replaces, an unrelated .do dropped into the shared
# fixture directory became a rival candidate and fataled the run as ambiguous --
# from a change with nothing to do with codebooks.
test_codebooks_ignores_an_undeclared_lookalike() {
  local fixtures output
  fixtures="$(mktemp -d)"
  cp "$CODEBOOK_FIXTURES"/codebooks-*-fixture.do "$fixtures/"
  cp "$fixtures/codebooks-ic2023-ay-fixture.do" "$fixtures/codebooks-ic2023-ay-notes-fixture.do"
  output="$(bin/fetch-codebooks -F "$fixtures" -o "$fixtures" -j "$fixtures/codebooks.json" 2>&1)" || {
    rm -rf "$fixtures"
    return 1
  }
  [ -s "$fixtures/codebooks.json" ] || { rm -rf "$fixtures"; return 1; }
  rm -rf "$fixtures"
  case "$output" in
    *"[FATAL]"*) return 1 ;;
    *) return 0 ;;
  esac
}
assert_success "an undeclared look-alike .do in the fixture directory is ignored, not ambiguous" \
  test_codebooks_ignores_an_undeclared_lookalike

# ...and a fixture that is genuinely absent names BOTH shapes it would accept,
# rather than a normalised stem the operator never typed.
test_codebooks_missing_fixture_names_both_shapes() {
  local fixtures output
  fixtures="$(mktemp -d)"
  cp "$CODEBOOK_FIXTURES"/codebooks-*-fixture.do "$fixtures/"
  rm "$fixtures/codebooks-ic2023-ay-fixture.do"
  output="$(bin/fetch-codebooks -F "$fixtures" -o "$fixtures" -j "$fixtures/codebooks.json" 2>&1)"
  rm -rf "$fixtures"
  case "$output" in
    *"[FATAL]"*"no fixture for [IC2023_AY_Stata.zip]"*"codebooks-ic2023-ay-fixture.do"*) return 0 ;;
    *) return 1 ;;
  esac
}
assert_success "a missing codebook fixture names the archive and the declared .do" \
  test_codebooks_missing_fixture_names_both_shapes

# RFC 172 §5: the option grammar is the stdlib getopt module, and the three
# bands it is mapped onto are three DIFFERENT operator mistakes. getopt raises
# one exception class for the first two, so what separates them is the option
# that faulted rather than the message text; the third is not an exception at
# all but the operand list getopt hands back, and this script declares none.
assert_exit_code "$EXIT_UNKNOWN_OPTION" "fetch-codebooks rejects an unknown option (10)" \
  bin/fetch-codebooks -z
assert_exit_code "$EXIT_OPTION_REQUIRES_VALUE" "fetch-codebooks -F without a value exits 11" \
  bin/fetch-codebooks -F
assert_exit_code "$EXIT_OPTION_REQUIRES_VALUE" "fetch-codebooks -o without a value exits 11" \
  bin/fetch-codebooks -o
assert_exit_code "$EXIT_OPTION_REQUIRES_VALUE" "fetch-codebooks -j without a value exits 11" \
  bin/fetch-codebooks -j
assert_exit_code "$EXIT_UNEXPECTED_ARG" "fetch-codebooks rejects a stray positional (20, not 10)" \
  bin/fetch-codebooks stray
assert_exit_code "$EXIT_UNEXPECTED_ARG" "fetch-codebooks rejects a positional after a good option (20)" \
  bin/fetch-codebooks -o /tmp stray

# The value-shape checks getopt itself cannot make, each one a way a wrong
# directory gets written quietly: an empty value means the current directory, a
# value beginning with "-" is a dropped operand, and a repeated flag is a
# last-wins guess about which of two paths was meant.
assert_exit_code "$EXIT_INVALID_ARG_VALUE" "fetch-codebooks rejects an empty -o value (22)" \
  bin/fetch-codebooks -o ""
assert_exit_code "$EXIT_INVALID_ARG_VALUE" "fetch-codebooks rejects [-o -F], a dropped operand (22)" \
  bin/fetch-codebooks -o -F
assert_exit_code "$EXIT_INVALID_ARG_VALUE" "fetch-codebooks refuses a repeated -o rather than last-wins (22)" \
  bin/fetch-codebooks -o /tmp -o /tmp
assert_exit_code "$EXIT_INVALID_ARG_VALUE" "fetch-codebooks refuses a repeated -F rather than last-wins (22)" \
  bin/fetch-codebooks -F /tmp -F /tmp

# RFC 172 §5: stdout is EMPTY on a normal run. The product is files on disk, so
# the closing summary is a diagnostic and belongs on stderr with everything
# else -- and bin/fetch-external-data's own stdout contract (§1) is unachievable
# while this script writes its summary to stdout. Modelled on
# test_ipeds_logs_to_stderr_and_stdout_stays_empty.
test_codebooks_logs_to_stderr_and_stdout_stays_empty() {
  local out stdout stderr status
  out="$(mktemp -d)"
  stdout="$(mktemp)"
  stderr="$(mktemp)"
  bin/fetch-codebooks -F "$CODEBOOK_FIXTURES" -o "$out" -j "$out/codebooks.json" \
    > "$stdout" 2> "$stderr"
  status=$?
  codebooks_stderr_cleanup() { rm -rf "$out" "$stdout" "$stderr"; }
  if [ "$status" -ne 0 ]; then
    log-error "exit [$status], stderr [$(cat "$stderr")]"
    codebooks_stderr_cleanup; return 1
  fi
  if [ -s "$stdout" ]; then
    log-error "stdout is not empty, it holds [$(cat "$stdout")]"
    codebooks_stderr_cleanup; return 1
  fi
  # The summary that used to live on stdout must still be SAID, on stderr.
  grep -qF -- "codebook written to" "$stderr" \
    || { log-error "stderr does not report the summary"; codebooks_stderr_cleanup; return 1; }
  grep -qF -- "from [fixtures]" "$stderr" \
    || { log-error "stderr does not name the source route"; codebooks_stderr_cleanup; return 1; }
  codebooks_stderr_cleanup
  return 0
}
assert_success "a successful fetch-codebooks run writes its summary to stderr and NOTHING to stdout" \
  test_codebooks_logs_to_stderr_and_stdout_stays_empty

# -h is the ONE thing this script puts on stdout: stdout carries what the caller
# explicitly asked for, and a caller passing -h asked for the help text.
test_codebooks_help_exits_zero_on_stdout() {
  local out err status
  out="$(mktemp)"
  err="$(mktemp)"
  bin/fetch-codebooks -h > "$out" 2> "$err"
  status=$?
  [ "$status" -eq 0 ] || { log-error "-h exited [$status]"; rm -f "$out" "$err"; return 1; }
  grep -q "fetch-codebooks: build the published-codebook reference data" "$out" \
    || { log-error "-h printed no help: [$(head -3 "$out")]"; rm -f "$out" "$err"; return 1; }
  [ ! -s "$err" ] || { log-error "-h wrote to stderr: [$(head -3 "$err")]"; rm -f "$out" "$err"; return 1; }
  rm -f "$out" "$err"
  return 0
}
assert_success "fetch-codebooks -h prints the help to stdout and exits 0, stderr empty" \
  test_codebooks_help_exits_zero_on_stdout

# The anti-hand-edit guard: the committed codebook must be what the committed
# artifacts GENERATE, byte for byte, and the artifacts must be what
# PROVENANCE.json says they are. A hand-tuned label or a half regeneration is a
# lie the loader would happily import.
test_codebooks_match_committed_artifacts() {
  local out
  out="$(mktemp -d)"
  bin/fetch-codebooks -F "$PROJECT_ROOT/db/seed/codebooks" -o "$out" -j "$out/codebooks.json" \
    > /dev/null 2>&1 \
    && python3 - "$PROJECT_ROOT/db/seed/codebooks" "$PROJECT_ROOT/db/data/codebooks.json" \
      "$out/codebooks.json" << 'PY'
import hashlib, json, sys
from pathlib import Path

seed_dir, committed, regenerated = (Path(argument) for argument in sys.argv[1:4])
provenance = json.loads((seed_dir / "PROVENANCE.json").read_text())
# The committed manifest must record a real FETCH. An offline replay writes
# fixture_derived=true with every fetched_at null, and such a file must never
# become the committed provenance -- it would claim a download that never
# happened for artifacts nobody verified against the publisher.
if provenance.get("source") != "network" or provenance.get("fixture_derived"):
    sys.exit("PROVENANCE.json is not a network fetch record")
for name, artifact in provenance["artifacts"].items():
    body = (seed_dir / name).read_bytes()
    if hashlib.sha256(body).hexdigest() != artifact["sha256"]:
        sys.exit(f"{name}: sha256 differs from PROVENANCE.json")
    if len(body) != artifact["bytes"]:
        sys.exit(f"{name}: {len(body)} bytes, PROVENANCE.json says {artifact['bytes']}")
body = committed.read_bytes()
if hashlib.sha256(body).hexdigest() != provenance["output"]["sha256"]:
    sys.exit(f"{committed.name}: sha256 differs from PROVENANCE.json")
if body != regenerated.read_bytes():
    sys.exit(f"{committed.name} is not what the committed artifacts generate")
PY
  local status=$?
  rm -rf "$out"
  return $status
}
assert_success "the committed codebook matches the committed artifacts (regeneration is byte-identical)" \
  test_codebooks_match_committed_artifacts
rm -rf "$CODEBOOK_OUT"

# IPEDS group (RFC 144): all-or-nothing, refused BEFORE any download or JVM
# start, and each file's original argument forwarded as its --*-source partner.
# The group is -H/-I/-A/-C/-Y plus the -y year (RFC 161 added -Y, the IC_AY
# published-charges CSV): short options, parsed by the one getopts loop, because
# bin/ scripts take short options only. The long forms this
# group used to accept are GONE (see the rejection assertions below); the --hd=
# etc. flags that remain are the ingest JAR's own grammar, forwarded to it.
assert_exit_code "$EXIT_MISSING_REQUIRED_ARG" "ingest-colleges rejects a partial IPEDS group (only -H)" \
  bin/ingest-colleges -H HD2023.csv a.csv b.csv
assert_exit_code "$EXIT_MISSING_REQUIRED_ARG" "ingest-colleges rejects an IPEDS group missing -y" \
  bin/ingest-colleges -H HD.csv -I IC.csv -A adm.csv -C CA.csv -Y ic_ay.csv a.csv b.csv
# RFC 161: IC_AY joined the SAME group rather than sitting beside it. A run that
# quietly skipped it would leave the canonical fill with no IPEDS source and
# serve the Scorecard's collapsed in-state price again, with a green exit.
assert_exit_code "$EXIT_MISSING_REQUIRED_ARG" "ingest-colleges rejects an IPEDS group missing -Y" \
  bin/ingest-colleges -H HD.csv -I IC.csv -A adm.csv -C CA.csv -y 2023 a.csv b.csv
assert_exit_code "$EXIT_MISSING_REQUIRED_ARG" "ingest-colleges rejects a partial IPEDS group (only -Y)" \
  bin/ingest-colleges -Y ic_ay.csv a.csv b.csv
# Every one of the five, individually, arms the all-or-nothing rule: a group that
# fired only on -H would let a lone -y (or a lone -C) through as a silent
# Scorecard-only run.
assert_exit_code "$EXIT_MISSING_REQUIRED_ARG" "ingest-colleges rejects a partial IPEDS group (only -I)" \
  bin/ingest-colleges -I IC2023.csv a.csv b.csv
assert_exit_code "$EXIT_MISSING_REQUIRED_ARG" "ingest-colleges rejects a partial IPEDS group (only -A)" \
  bin/ingest-colleges -A adm2023.csv a.csv b.csv
assert_exit_code "$EXIT_MISSING_REQUIRED_ARG" "ingest-colleges rejects a partial IPEDS group (only -C)" \
  bin/ingest-colleges -C C2023_a.csv a.csv b.csv
assert_exit_code "$EXIT_MISSING_REQUIRED_ARG" "ingest-colleges rejects a partial IPEDS group (only -y)" \
  bin/ingest-colleges -y 2023 a.csv b.csv
# The retired long options are REJECTED, not silently read as a file name. Both
# positions matter: written before the operands getopts itself refuses the "--",
# and written after them getopts has already stopped, so the guard after the
# shift is what stops "--hd=HD.csv" from becoming the aliases argument.
assert_exit_code "$EXIT_UNKNOWN_OPTION" "ingest-colleges rejects the retired --hd= long option (10)" \
  bin/ingest-colleges --hd=HD.csv a.csv b.csv
assert_exit_code "$EXIT_UNKNOWN_OPTION" "ingest-colleges rejects a retired long option AFTER the positionals, never as a file name (10)" \
  bin/ingest-colleges a.csv b.csv --hd=HD.csv
assert_exit_code "$EXIT_UNKNOWN_OPTION" "ingest-colleges rejects the retired --survey-year= long option (10)" \
  bin/ingest-colleges --survey-year=2023 a.csv b.csv
assert_exit_code "$EXIT_UNKNOWN_OPTION" "ingest-colleges rejects the retired --codebooks-source= long option (10)" \
  bin/ingest-colleges --codebooks-source=codebooks.json a.csv b.csv
assert_exit_code "$EXIT_UNKNOWN_OPTION" "ingest-colleges rejects the retired --subjects-source= long option (10)" \
  bin/ingest-colleges --subjects-source=subjects.json a.csv b.csv
assert_exit_code "$EXIT_UNKNOWN_OPTION" "ingest-colleges rejects the retired --money-vocabulary-source= long option (10)" \
  bin/ingest-colleges --money-vocabulary-source=money-vocabulary.json a.csv b.csv
assert_exit_code "$EXIT_UNKNOWN_OPTION" "ingest-colleges rejects an unknown long option" \
  bin/ingest-colleges --hd2=HD.csv a.csv b.csv
# A flag given with an EMPTY value is a wrong value, not an omitted flag: five
# empty flags would otherwise look like "no IPEDS group" and silently downgrade
# the run to Scorecard-only with a green exit.
# The RFC 158 money-vocabulary option follows the -k/-s value rules: a value is
# required, and an explicitly-empty one is a wrong value, never the default.
assert_exit_code "$EXIT_OPTION_REQUIRES_VALUE" "ingest-colleges -v without a value exits 11" \
  bin/ingest-colleges -v
assert_exit_code "$EXIT_INVALID_ARG_VALUE" "ingest-colleges rejects an explicitly-empty -v value" \
  bin/ingest-colleges -v "" a.csv b.csv
assert_exit_code "$EXIT_INVALID_ARG_VALUE" "ingest-colleges rejects an empty IPEDS flag value" \
  bin/ingest-colleges -H "" -I IC.csv -A adm.csv -C CA.csv -Y ic_ay.csv -y 2023 a.csv b.csv
assert_exit_code "$EXIT_INVALID_ARG_VALUE" "ingest-colleges rejects an empty -Y value" \
  bin/ingest-colleges -H HD.csv -I IC.csv -A adm.csv -C CA.csv -Y "" -y 2023 a.csv b.csv
assert_exit_code "$EXIT_INVALID_ARG_VALUE" "ingest-colleges rejects an all-empty IPEDS group, never a silent Scorecard-only run" \
  bin/ingest-colleges -H "" -I "" -A "" -C "" -Y "" -y "" a.csv b.csv
# A repeated flag is the usage error the JVM names; last-wins here would forward
# only the survivor and the JVM's refusal would be unreachable.
assert_exit_code "$EXIT_INVALID_ARG_VALUE" "ingest-colleges rejects a repeated IPEDS flag" \
  bin/ingest-colleges -H A.csv -H B.csv -I IC.csv -A adm.csv -C CA.csv -Y ic_ay.csv -y 2023 a.csv b.csv
# -Y (the IC_AY charges CSV) and -y (the survey year) are the second deliberate
# case pair in this grammar. getopts is case-sensitive, so a lone -Y must fire
# the all-or-nothing rule naming -y as still required, never be read as the year.
assert_exit_code "$EXIT_MISSING_REQUIRED_ARG" "ingest-colleges keeps -Y and -y distinct, never folding the case" \
  bin/ingest-colleges -Y 2023 a.csv b.csv
# -a (the CDS admission-factors CSV) and -A (the IPEDS ADM survey file) are a
# deliberate case pair. Passing -a alone must fire the CDS rule, never the IPEDS
# one, and vice versa: a parser that folded the case would report the wrong group.
assert_exit_code "$EXIT_MISSING_REQUIRED_ARG" "ingest-colleges -a alone is a CDS group error, not an IPEDS one" \
  bin/ingest-colleges -a factors.csv a.csv b.csv
test_ingest_colleges_ipeds_source_flags() {
  local root parent stub argv inst fields hd ic adm ca icay entry rc log
  parent="$(mktemp -d)"
  root="$parent/unicoach-ipedsflags"
  mkdir -p "$root"
  for entry in bin .env .env.dev .env.test .env.fuzz db; do
    ln -s "$PROJECT_ROOT/$entry" "$root/$entry"
  done
  stub="$root/college/build/install/college/bin/college"
  argv="$parent/launcher-argv"
  mkdir -p "$(dirname "$stub")"
  printf '#!/usr/bin/env bash\nprintf "%%s\\n" "$@" > %q\n' "$argv" > "$stub"
  chmod +x "$stub"
  inst="$parent/institution.csv"; fields="$parent/fields.csv"
  hd="$parent/HD2023.csv"; ic="$parent/IC2023.csv"
  adm="$parent/adm2023.csv"; ca="$parent/C2023_a.csv"; icay="$parent/ic2023_ay.csv"
  : > "$inst"; : > "$fields"; : > "$hd"; : > "$ic"; : > "$adm"; : > "$ca"; : > "$icay"
  log="$parent/ingest.log"
  rc=0
  "$root/bin/ingest-colleges" \
    -H "$hd" -I "$ic" -A "$adm" -C "$ca" -Y "$icay" -y 2023 \
    "$inst" "$fields" > "$log" 2>&1 || rc=$?
  if [ "$rc" -ne 0 ]; then
    log-error "ingest-colleges exited [$rc]:"
    cat "$log" >&2
    rm -rf "$parent"
    return "$rc"
  fi
  grep -qxF -- "--hd-source=$hd" "$argv" &&
    grep -qxF -- "--ic-source=$ic" "$argv" &&
    grep -qxF -- "--adm-source=$adm" "$argv" &&
    grep -qxF -- "--completions-source=$ca" "$argv" &&
    grep -qxF -- "--ic-ay-source=$icay" "$argv" &&
    grep -qxF -- "--survey-year=2023" "$argv"
  rc=$?
  [ "$rc" -eq 0 ] || { log-error "launcher argv was:"; cat "$argv" >&2; }
  rm -rf "$parent"
  return "$rc"
}
assert_success "ingest-colleges forwards each IPEDS file's original arg as its --*-source flag" \
  test_ingest_colleges_ipeds_source_flags
# A Scorecard-only run must not grow IPEDS argv: the optional group is genuinely
# absent, not present-and-empty.
test_ingest_colleges_no_ipeds_argv() {
  local root parent stub argv inst fields entry rc log
  parent="$(mktemp -d)"
  root="$parent/unicoach-noipeds"
  mkdir -p "$root"
  for entry in bin .env .env.dev .env.test .env.fuzz db; do
    ln -s "$PROJECT_ROOT/$entry" "$root/$entry"
  done
  stub="$root/college/build/install/college/bin/college"
  argv="$parent/launcher-argv"
  mkdir -p "$(dirname "$stub")"
  printf '#!/usr/bin/env bash\nprintf "%%s\\n" "$@" > %q\n' "$argv" > "$stub"
  chmod +x "$stub"
  inst="$parent/institution.csv"; fields="$parent/fields.csv"
  : > "$inst"; : > "$fields"
  log="$parent/ingest.log"
  rc=0
  "$root/bin/ingest-colleges" "$inst" "$fields" > "$log" 2>&1 || rc=$?
  if [ "$rc" -ne 0 ]; then
    log-error "ingest-colleges exited [$rc]:"
    cat "$log" >&2
    rm -rf "$parent"
    return "$rc"
  fi
  ! grep -qE -- "^--(hd|ic|adm|completions|ic-ay|survey-year)" "$argv"
  rc=$?
  [ "$rc" -eq 0 ] || { log-error "launcher argv was:"; cat "$argv" >&2; }
