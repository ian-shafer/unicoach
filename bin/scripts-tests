# 13. Unexpected-argument rejection across the guard set. Each guard fires before
#     any real work, so no live cluster/daemon is needed: the stray argument is
#     rejected with EXIT_UNEXPECTED_ARG (20) up front. postgres-bounce now rejects
#     a stray argument before running either child (down then up) — the direct
#     inversion of the former ignore-and-exit-0 behaviour. The *-check probe and
#     is-nix cases assert 20 is distinct from their operational 1/2 (down) and
#     0/1 (dev-shell) codes, which they return through stderr-suppressed `if`
#     guards where a reused 1 would read silently as "down" / "not in the shell".
assert_exit_code "$EXIT_UNEXPECTED_ARG" "postgres-bounce rejects an unexpected argument" bin/postgres-bounce stray
assert_exit_code "$EXIT_UNEXPECTED_ARG" "rest-server-down rejects an unexpected argument" bin/rest-server-down stray
assert_exit_code "$EXIT_UNEXPECTED_ARG" "rest-server-check rejects an unexpected argument" bin/rest-server-check stray
assert_exit_code "$EXIT_UNEXPECTED_ARG" "postgres-wait-for-health rejects an unexpected argument" bin/postgres-wait-for-health stray
assert_exit_code "$EXIT_UNEXPECTED_ARG" "postgres-check rejects an unexpected argument" bin/postgres-check stray
assert_exit_code "$EXIT_UNEXPECTED_ARG" "is-nix rejects an unexpected argument" bin/is-nix stray
assert_exit_code "$EXIT_UNKNOWN_OPTION" "rest-server-check rejects an unknown option" bin/rest-server-check -z

# 14. Grammar guards on the exactly-one and required-pair scripts. Each guard
#     fires after getopts but before any kill/db work, so no live process or
#     cluster is needed: too-many positionals map to EXIT_UNEXPECTED_ARG (20) and
#     a missing required positional maps to EXIT_MISSING_REQUIRED_ARG (21).
assert_exit_code "$EXIT_MISSING_REQUIRED_ARG" "check-pid with zero args exits 21" bin/check-pid
assert_exit_code "$EXIT_UNEXPECTED_ARG" "check-pid with two args exits 20" bin/check-pid 1 2
assert_success "list-listening-pids -h exits 0" bin/list-listening-pids -h
assert_exit_code "$EXIT_MISSING_REQUIRED_ARG" "list-listening-pids with zero args exits 21" bin/list-listening-pids
assert_exit_code "$EXIT_UNEXPECTED_ARG" "list-listening-pids with two args exits 20" bin/list-listening-pids 18000 18001
assert_exit_code "$EXIT_INVALID_ARG_VALUE" "list-listening-pids with a non-numeric port exits 22" bin/list-listening-pids notaport
assert_success "is-port-free -h exits 0" bin/is-port-free -h
assert_exit_code "$EXIT_MISSING_REQUIRED_ARG" "is-port-free with zero args exits 21" bin/is-port-free
assert_exit_code "$EXIT_UNEXPECTED_ARG" "is-port-free with two args exits 20" bin/is-port-free 18000 18001
assert_exit_code "$EXIT_INVALID_ARG_VALUE" "is-port-free with a non-numeric port exits 22" bin/is-port-free notaport
# The port-bound up-wrappers learned -k: it parses as a known no-value option, so
# a stray positional after it is EXIT_UNEXPECTED_ARG (20), never EXIT_UNKNOWN_OPTION
# (10). Firing before the binary check, this proves -k is accepted without booting.
assert_exit_code "$EXIT_UNEXPECTED_ARG" "rest-server-up -k parses (stray positional -> 20)" bin/rest-server-up -k stray
assert_exit_code "$EXIT_UNEXPECTED_ARG" "rest-server-up -9 parses (stray positional -> 20)" bin/rest-server-up -9 stray
assert_exit_code "$EXIT_UNEXPECTED_ARG" "admin-web-up -k parses (stray positional -> 20)" bin/admin-web-up -k stray
assert_exit_code "$EXIT_UNEXPECTED_ARG" "public-web-up -k parses (stray positional -> 20)" bin/public-web-up -k stray
assert_exit_code "$EXIT_MISSING_REQUIRED_ARG" "q-enqueue with one arg exits 21" bin/q-enqueue only-job-type
assert_exit_code "$EXIT_UNEXPECTED_ARG" "q-enqueue with a residual positional exits 20" bin/q-enqueue job '{}' stray
assert_exit_code "$EXIT_INVALID_ARG_VALUE" "q-enqueue with a malformed -d delay exits 22" bin/q-enqueue job '{}' -d not-a-duration

# 15. RFC 92 ops tool runner. The scripts and shared functions the ops-tool path
#     depends on: static lint, the two shared resolvers, and the argument-validation
#     surfaces of bin/remote and bin/ingest-colleges. The AWS trigger itself
#     (S3 upload, send-command, the s3:// branch of resolve_file_arg) cannot run
#     without live AWS and is covered by the RFC's post-apply deployment
#     verification, mirroring RFC 50's original deploy path.
echo ""
echo "==== Testing RFC 92 ops tool runner ===="

# Script lint: bash -n over every script the RFC touches or adds.
for script in deploy build build-college ingest-colleges remote functions; do
  assert_success "bash -n bin/$script parses cleanly" bash -n "$PROJECT_ROOT/bin/$script"
done

# Every systemd unit under infra/files/ MUST be deploy-managed across all four
# lists: bin/deploy bundles it (DEPLOY_MANAGED_PATHS); build_deploy_command
# (bin/functions) installs it into /etc/systemd/system/ AND `systemctl enable`s it;
# and deploy-on-instance.sh `systemctl restart`s it. Miss bundle/install/enable and
# a unit added to an already-running instance never lands there; miss the restart
# and deploy-on-instance never (re)starts it — or, for a unit whose restart line
# exists but was never installed, `systemctl restart` (set -e) aborts the whole
# deploy. This guards RFC 97's cron unit — and any future unit — against that gap.
echo ""
echo "==== Testing every systemd unit is deploy-managed ===="
unit_bundled() { grep -qF "infra/files/$1" "$PROJECT_ROOT/bin/deploy"; }
unit_installed() { grep -qF "infra/files/$1" "$PROJECT_ROOT/bin/functions"; }
unit_restarted() { grep -qF "systemctl restart $1" "$PROJECT_ROOT/infra/files/deploy-on-instance.sh"; }
# The enable list names units bare (no path). Strip comment lines first so a
# future comment naming a unit can't masquerade as its `systemctl enable` entry;
# of the survivors, the line carrying the bare name but no 'infra/files/' path is
# the enable line (vs the path-bearing install line). Capture-and-test for
# non-empty rather than piping into `grep -q`, which under `set -o pipefail` exits
# early and SIGPIPEs the upstream grep, wrongly failing the pipeline.
unit_enabled() { [ -n "$(grep -vE '^[[:space:]]*#' "$PROJECT_ROOT/bin/functions" | grep -F "$1" | grep -v 'infra/files/')" ]; }
for unit_path in "$PROJECT_ROOT"/infra/files/unicoach-*.service; do
  unit="$(basename "$unit_path")"
  assert_success "bin/deploy bundles $unit (DEPLOY_MANAGED_PATHS)" unit_bundled "$unit"
  assert_success "build_deploy_command installs $unit" unit_installed "$unit"
  assert_success "build_deploy_command enables $unit" unit_enabled "$unit"
  assert_success "deploy-on-instance restarts $unit" unit_restarted "$unit"
done

echo ""
echo "==== Testing every shell test harness is run by bin/shell-tests ===="
# The anti-orphan guard (RFC 115). These harnesses are executed by nothing but
# bin/shell-tests, and an orphaned one looks exactly like a passing one: three of
# them sat unrun for months, hiding two real defects. So discover the harnesses
# from the filesystem and assert each is named in the aggregator — a new
# bin/<x>-scripts-tests that nobody wired up halts here, loudly, by name.
#
# ios-scripts-tests is the ONE deliberate exclusion: it drives system Xcode and
# refuses to run inside the Nix dev shell (RFC 114), which is where bin/test and
# the pre-commit hook run. It is carved out BY NAME rather than by a pattern, so
# a future omission cannot be silently swallowed by the same carve-out.
#
# The glob is `*scripts-tests`, not `*-scripts-tests`: the latter (as RFC 115
# sketched it) silently misses `bin/scripts-tests` itself — the most expensive
# harness and the one this guard most needs to keep wired up.
HARNESS_EXCLUSIONS=(ios-scripts-tests)
harness_excluded() {
  local candidate="$1" excluded
  for excluded in "${HARNESS_EXCLUSIONS[@]}"; do
    [ "$excluded" = "$candidate" ] && return 0
  done
  return 1
}
harness_in_shell_tests() { grep -qF "bin/$1" "$PROJECT_ROOT/bin/shell-tests"; }
for harness_path in "$PROJECT_ROOT"/bin/*scripts-tests; do
  harness="$(basename "$harness_path")"
  harness_excluded "$harness" && continue
  assert_success "bin/shell-tests runs $harness" harness_in_shell_tests "$harness"
done

# OpenTofu static validation of infra/ (ops.tf + the iam.tf/outputs.tf edits).
# fmt -check is purely static. validate needs the providers installed, so init
# first with -backend=false (no remote state, no AWS) into a throwaway TF_DATA_DIR
# so the developer's real infra/.terraform is left untouched; providers resolve
# offline from the tracked infra/.terraform.lock.hcl. Both must exit 0.
assert_success "tofu -chdir=infra fmt -check passes" \
  tofu -chdir="$PROJECT_ROOT/infra" fmt -check
test_tofu_validate() {
  local tf_data rc=0
  tf_data="$(mktemp -d)"
  (
    export TF_DATA_DIR="$tf_data"
    tofu -chdir="$PROJECT_ROOT/infra" init -backend=false -input=false >/dev/null 2>&1 \
      && tofu -chdir="$PROJECT_ROOT/infra" validate >/dev/null 2>&1
  ) || rc=$?
  rm -rf "$tf_data"
  [ "$rc" -eq 0 ]
}
assert_success "tofu -chdir=infra validate passes (init -backend=false, no AWS)" test_tofu_validate

# resolve_file_arg (local-path branch only; the s3:// branch needs AWS).
test_resolve_file_arg_existing() {
  local f resolved
  f="$(mktemp)"
  resolved="$(resolve_file_arg "$f")"
  rm -f "$f"
  # realpath may resolve /var -> /private/var on macOS; compare basenames.
  [ "$(basename "$resolved")" = "$(basename "$f")" ] && [[ "$resolved" = /* ]]
}
assert_success "resolve_file_arg resolves an existing local path to an absolute path" test_resolve_file_arg_existing
test_resolve_file_arg_missing() {
  ( resolve_file_arg "/no/such/file/$$-does-not-exist" ) >/dev/null 2>&1
}
assert_failure "resolve_file_arg fatals on a nonexistent local path" test_resolve_file_arg_missing

# bin/remote argument validation (no AWS reached: every case fatals before the
# first tofu/aws call). A real local file (bin/functions) stands in for a -f path.
assert_success "remote -h exits 0" bin/remote -h
assert_exit_code "$EXIT_MISSING_REQUIRED_ARG" "remote with no <env> exits 21" bin/remote
assert_exit_code "$EXIT_MISSING_REQUIRED_ARG" "remote without a -- separator exits 21" bin/remote prod -f a:bin/functions ingest-colleges
assert_exit_code "$EXIT_MISSING_REQUIRED_ARG" "remote with -- but no <script> exits 21" bin/remote prod --
assert_exit_code "$EXIT_INVALID_ARG_VALUE" "remote -f with no ':' exits 22" bin/remote prod -f nocolon -- ingest-colleges
assert_exit_code "$EXIT_INVALID_ARG_VALUE" "remote -f with an empty name exits 22" bin/remote prod -f :bin/functions -- ingest-colleges
assert_exit_code "$EXIT_INVALID_ARG_VALUE" "remote -f with a '/' in the name exits 22" bin/remote prod -f a/b:bin/functions -- ingest-colleges
assert_exit_code "$EXIT_INVALID_ARG_VALUE" "remote -f with a name starting '-' exits 22" bin/remote prod -f -x:bin/functions -- ingest-colleges
assert_exit_code "$EXIT_INVALID_ARG_VALUE" "remote -f with a nonexistent path exits 22" bin/remote prod -f a:/no/such/path -- ingest-colleges
assert_exit_code "$EXIT_INVALID_ARG_VALUE" "remote @name undeclared by -f exits 22" bin/remote prod -f a:bin/functions -- ingest-colleges @b
assert_exit_code "$EXIT_INVALID_ARG_VALUE" "remote env=local is rejected before AWS (band 22)" bin/remote local -- ingest-colleges
assert_exit_code "$EXIT_UNKNOWN_OPTION" "remote rejects an unknown option (10)" bin/remote prod -z -- ingest-colleges

# Ops-tool allowlist: only a sanctioned <script> may run. An unsanctioned name is
# rejected with EXIT_INVALID_ARG_VALUE before any AWS call — the enforcement of
# the "ops tool MUST NOT modify current / restart a service" invariant (a bare
# bin/ token like deploy-on-instance can no longer be triggered).
assert_exit_code "$EXIT_INVALID_ARG_VALUE" "remote rejects an unsanctioned <script> (band 22)" bin/remote prod -- deploy-on-instance
assert_exit_code "$EXIT_INVALID_ARG_VALUE" "remote rejects a shell-injection <script> token (band 22)" bin/remote prod -- 'ingest-colleges; rm -rf /'

# -t and -p take a duration string (e.g. 30m, 5s) like `sleep`, validated with
# validate_duration. A valid duration passes the option parse and reaches the AWS
# stage (which fails without live AWS — that failure is not a usage-band code, so
# these two only assert the value was accepted, i.e. NOT rejected in the 10-29
# band). A malformed value (no unit, non-numeric) is a usage error in the reserved
# band, and a missing value is band 11, never a silent fall-through to the default.
test_remote_t_duration_accepted() {
  local rc=0
  bin/remote prod -t 30m -- ingest-colleges >/dev/null 2>&1 || rc=$?
  # Accepted past the option parse: exit is not a usage-band (10-29) rejection.
  [ "$rc" -lt 10 ] || [ "$rc" -gt 29 ]
}
assert_success "remote -t 30m is accepted past the option parse (not a usage-band reject)" test_remote_t_duration_accepted
assert_exit_code "$EXIT_INVALID_ARG_VALUE" "remote -t badval is rejected (band 22)" bin/remote prod -t badval -- ingest-colleges
test_remote_p_duration_accepted() {
  local rc=0
  bin/remote prod -p 5s -- ingest-colleges >/dev/null 2>&1 || rc=$?
  [ "$rc" -lt 10 ] || [ "$rc" -gt 29 ]
}
assert_success "remote -p 5s is accepted past the option parse (not a usage-band reject)" test_remote_p_duration_accepted
# -p 0s is a SUPPORTED value: -p is the poll interval, and 0 means poll with no
# pause until the command reaches a terminal status (sleep 0 is a valid no-op); it
# terminates (SSM's own -t returns TimedOut, which the loop breaks on). So it must
# pass the option parse, NOT be rejected in the usage band.
test_remote_p_zero_duration_accepted() {
  local rc=0
  bin/remote prod -p 0s -- ingest-colleges >/dev/null 2>&1 || rc=$?
  [ "$rc" -lt 10 ] || [ "$rc" -gt 29 ]
}
assert_success "remote -p 0s is accepted past the option parse (not a usage-band reject)" test_remote_p_zero_duration_accepted
assert_exit_code "$EXIT_INVALID_ARG_VALUE" "remote -p non-duration is rejected (band 22)" bin/remote prod -p abc -- ingest-colleges
assert_exit_code "$EXIT_INVALID_ARG_VALUE" "remote -p 0 (no unit) is rejected (band 22)" bin/remote prod -p 0 -- ingest-colleges
assert_exit_code "$EXIT_OPTION_REQUIRES_VALUE" "remote -p (missing value) is rejected (band 11)" bin/remote prod -p -- ingest-colleges

# bin/ingest-colleges argument validation (no AWS reached: the arity guard fires
# before resolve_file_arg / the launcher).
assert_success "ingest-colleges -h exits 0" bin/ingest-colleges -h
assert_exit_code "$EXIT_MISSING_REQUIRED_ARG" "ingest-colleges with no args exits 21" bin/ingest-colleges
assert_exit_code "$EXIT_MISSING_REQUIRED_ARG" "ingest-colleges with one arg exits 21" bin/ingest-colleges only.csv
assert_exit_code "$EXIT_MISSING_REQUIRED_ARG" "ingest-colleges with three args exits 21" bin/ingest-colleges a.csv b.csv c.csv
test_ingest_colleges_missing_file() {
  bin/ingest-colleges "/no/such/$$-institution.csv" "/no/such/$$-fields.csv" >/dev/null 2>&1
}
assert_failure "ingest-colleges fatals on a nonexistent local CSV path" test_ingest_colleges_missing_file

# ── bin/common layering (RFC 95): ENV_FILES string, both-set, empty base ───────
echo "==== Testing bin/common dotenv layering ===="

# ENV_FILES layers left-to-right over the base: a key set only in the last delta
# wins over an earlier delta wins over the base. Drives a real child bin/common.
test_env_files_layering() {
  local dev test_delta out
  dev="$(mktemp)"; test_delta="$(mktemp)"
  printf 'POSTGRES_PORT=5432\nLAYER_KEY=from_dev\n' > "$dev"
  printf 'LAYER_KEY=from_test\n' > "$test_delta"
  out="$(ENV_FILES="$dev:$test_delta" bash -c 'source "'"$PROJECT_ROOT"'/bin/common"; echo "$LAYER_KEY"' 2>&1)"
  rm -f "$dev" "$test_delta"
  [ "$out" = "from_test" ] || { echo "LAYER_KEY was [$out]"; return 1; }
}
assert_success "ENV_FILES layers deltas left-to-right (last wins)" test_env_files_layering

# ENV_FILE and ENV_FILES together fatal (mutually exclusive).
test_env_file_and_files_mutually_exclusive() {
  local delta
  delta="$(mktemp)"
  printf 'POSTGRES_PORT=5432\n' > "$delta"
  ENV_FILE="$delta" ENV_FILES="$delta" bash -c 'source "'"$PROJECT_ROOT"'/bin/common"' >/dev/null 2>&1
  local rc=$?
  rm -f "$delta"
  [ "$rc" -ne 0 ]
}
assert_success "ENV_FILE + ENV_FILES set together fatals" test_env_file_and_files_mutually_exclusive

# Empty base + ENV_FILE=<complete>: sourcing yields exactly the complete file's
# values and does not fatal (no "deploy host has no .env" special case). Runs in a
# throwaway PROJECT_ROOT whose .env is empty.
test_empty_base_host_shape() {
  local root complete out
  root="$(mktemp -d)"; mkdir -p "$root/bin"
  cp "$PROJECT_ROOT/bin/functions" "$PROJECT_ROOT/bin/common" "$root/bin/"
  printf '# intentionally empty base\n' > "$root/.env"
  complete="$root/etc-env"
  printf 'POSTGRES_PORT=5432\nHOST_KEY=complete\n' > "$complete"
  # Clear the harness's exported ENV_FILES so pinning a single ENV_FILE does not
  # trip the mutual-exclusion fatal (this simulates the on-host caller, which sets
  # only ENV_FILE=/etc/unicoach/env).
  out="$(env -u ENV_FILES ENV_FILE="$complete" bash -c 'source "'"$root"'/bin/common"; echo "$HOST_KEY"' 2>&1)"
  local rc=$?
  rm -rf "$root"
  [ "$rc" -eq 0 ] && [ "$out" = "complete" ] || { echo "rc=$rc HOST_KEY=[$out]"; return 1; }
}
assert_success "empty base + ENV_FILE=<complete> yields the complete values, no fatal" test_empty_base_host_shape

# ── bin/gen-deployed-env (RFC 95) ─────────────────────────────────────────────
echo "==== Testing gen-deployed-env ===="

# Build a throwaway env root with its own .env/.env.dev/.env.<env> so the test is
# hermetic (never touches the repo's real cloud env files). Echoes the root.
make_gen_env_root() {
  local root; root="$(mktemp -d)"
  mkdir -p "$root/bin"
  cp "$PROJECT_ROOT/bin/functions" "$PROJECT_ROOT/bin/common" "$PROJECT_ROOT/bin/gen-deployed-env" "$root/bin/"
  cat > "$root/.env" <<'EOF'
POSTGRES_PORT=5432
POSTGRES_DB=unicoach
DATABASE_MAXIMUM_POOL_SIZE=10
PUBLIC_WEB_PORT=8082
ADMIN_WEB_PORT=8081
SERVER_PORT=8080
EOF
  # .env.dev carries a dev value for a DEPLOY_VAR_NAMES key (GOOGLE_AUTH_PROVIDER)
  # that the cloud fixture below deliberately OMITS — the leak-close under test.
  cat > "$root/.env.dev" <<'EOF'
GOOGLE_AUTH_PROVIDER=stub
DATABASE_PASSWORD=devpassword
PGHOST=localhost
POSTGRES_USER=postgres
DATABASE_USER=unicoach
APP_DOMAIN=localhost
EOF
  echo "$root"
}

# Full, valid cloud fixture (all DEPLOY_VAR_NAMES keys present).
write_full_cloud_env() {
  cat > "$1/.env.gentest" <<'EOF'
APP_DOMAIN=gentest.example.com
GOOGLE_CLIENT_IDS=abc.apps.googleusercontent.com
APPLE_CLIENT_IDS=com.example.gentest
SERVER_HOST=0.0.0.0
PUBLIC_WEB_HOST=0.0.0.0
ADMIN_WEB_HOST=0.0.0.0
SESSION_COOKIE_SECURE=true
ADMIN_COOKIE_SECURE=true
EMAIL_PROVIDER=ses
CHAT_PROVIDER=anthropic
GOOGLE_AUTH_PROVIDER=google
APPLE_AUTH_PROVIDER=apple
APP_STORE_ENVIRONMENT=production
EMAIL_DEFAULT_FROM=noreply@$APP_DOMAIN
EMAIL_VERIFICATION_VERIFY_URL_BASE=https://app.$APP_DOMAIN/verify-email
EOF
}

test_gen_deployed_env_happy() {
  local root out err rc=0; root="$(make_gen_env_root)"; write_full_cloud_env "$root"
  # Keep stderr: gen-deployed-env fatals name the offending key, which is the
  # whole diagnosis. Discarding it (2>/dev/null) reduced a failure to a bare
  # "exit 22" and cost real time the last time this fixture drifted.
  out="$("$root/bin/gen-deployed-env" gentest 2> "$root/stderr")" || rc=$?
  err="$(cat "$root/stderr")"
  rm -rf "$root"
  [ "$rc" -eq 0 ] || { echo "exit $rc: $err"; return 1; }
  # APP_DOMAIN reflects the delta; EMAIL_DEFAULT_FROM interpolation is resolved;
  # nothing has a surviving '$'; and PATH/HOME are absent.
  echo "$out" | grep -qx 'APP_DOMAIN=gentest.example.com' || { echo "APP_DOMAIN wrong: $out"; return 1; }
  echo "$out" | grep -qx 'EMAIL_DEFAULT_FROM=noreply@gentest.example.com' || { echo "email not interpolated: $out"; return 1; }
  echo "$out" | grep -q '[$]' && { echo "unresolved \$ in output: $out"; return 1; }
  echo "$out" | grep -qE '^(PATH|HOME)=' && { echo "leaked PATH/HOME: $out"; return 1; }
  return 0
}
assert_success "gen-deployed-env emits resolved DEPLOY_VAR_NAMES, no \$/PATH/HOME leak" test_gen_deployed_env_happy

# An unresolvable <env> must stop AT the resolution failure. `fatal` inside the
# pre-common `ENV_FILE="$(unicoach_env_file …)"` substitution exits only that
# SUBSHELL, so without the prelude's own `set -euo pipefail` the script ran on
# with an empty ENV_FILE and died later on a missing key — printing a second,
# misleading fatal and exiting with that symptom's code instead of this one's.
test_gen_deployed_env_bad_env_stops_at_resolution() {
  local root err rc=0; root="$(make_gen_env_root)"
  "$root/bin/gen-deployed-env" nosuchenv > /dev/null 2> "$root/stderr" || rc=$?
  err="$(cat "$root/stderr")"
  rm -rf "$root"
  [ "$rc" -eq "$EXIT_INVALID_ARG_VALUE" ] || { echo "exit $rc (want $EXIT_INVALID_ARG_VALUE): $err"; return 1; }
  echo "$err" | grep -q 'environment file not found for \[nosuchenv\]' || { echo "did not name the env: $err"; return 1; }
  # Exactly one fatal: a second means the script continued past the failure.
  local fatals; fatals="$(echo "$err" | grep -c '\[FATAL\]')"
  [ "$fatals" -eq 1 ] || { echo "expected 1 fatal, got $fatals: $err"; return 1; }
  return 0
}
assert_success "gen-deployed-env stops at an unresolvable <env> (one fatal, band 22)" test_gen_deployed_env_bad_env_stops_at_resolution

test_gen_deployed_env_no_secret_or_identity_leak() {
  local root out err rc=0; root="$(make_gen_env_root)"; write_full_cloud_env "$root"
  out="$("$root/bin/gen-deployed-env" gentest 2> "$root/stderr")" || rc=$?
  err="$(cat "$root/stderr")"
  rm -rf "$root"
  # Assert the run SUCCEEDED and emitted something before asserting what is
  # absent from it. Without this the case passes vacuously on empty output — a
  # fatal makes "no secrets present" trivially true, which is exactly how it
  # stayed green while the fixture was broken.
  [ "$rc" -eq 0 ] || { echo "exit $rc: $err"; return 1; }
  [ -n "$out" ] || { echo "exit 0 but no output to inspect: $err"; return 1; }
  # None of the secrets nor the four Terraform-owned RDS-identity keys appear.
  # Name what leaked: this is the assertion most likely to fire on a real
  # regression, and "the leak test failed" without the key is a bisect, not a
  # diagnosis. `if` rather than `&&` because no-match is grep's exit 1 and is the
  # PASSING outcome here, so it reads as a condition, not a failure.
  local leaked
  if leaked="$(printf '%s\n' "$out" | grep -E '^(DATABASE_PASSWORD|CHAT_ANTHROPIC_API_KEY|PGPASSWORD)=')"; then
    echo "secret key(s) leaked: $(printf '%s\n' "$leaked" | cut -d= -f1 | tr '\n' ' ')"
    return 1
  fi
  if leaked="$(printf '%s\n' "$out" | grep -E '^(PGHOST|DATABASE_HOST|POSTGRES_USER|DATABASE_USER)=')"; then
    echo "RDS-identity key(s) leaked: $(printf '%s\n' "$leaked" | cut -d= -f1 | tr '\n' ' ')"
    return 1
  fi
  return 0
}
assert_success "gen-deployed-env leaks no secret nor RDS-identity key" test_gen_deployed_env_no_secret_or_identity_leak

# .env.dev is NOT layered: a DEPLOY_VAR_NAMES key present in .env.dev but omitted
# from the cloud fixture is UNSET, so gen-deployed-env fatals naming it (it does
# not inherit the dev value and emit it). This is the direct leak-close test.
test_gen_deployed_env_omitted_key_fatals() {
  local root err; root="$(make_gen_env_root)"
  # Full fixture MINUS GOOGLE_AUTH_PROVIDER (which IS present in .env.dev).
  write_full_cloud_env "$root"
  grep -v '^GOOGLE_AUTH_PROVIDER=' "$root/.env.gentest" > "$root/.env.gentest.tmp"
  mv "$root/.env.gentest.tmp" "$root/.env.gentest"
  err="$("$root/bin/gen-deployed-env" gentest 2>&1 >/dev/null)"
  local rc=$?
  rm -rf "$root"
  [ "$rc" -ne 0 ] || { echo "expected nonzero exit"; return 1; }
  echo "$err" | grep -q 'GOOGLE_AUTH_PROVIDER' || { echo "did not name the missing key: $err"; return 1; }
}
assert_success "gen-deployed-env fatals (no dev leak) when a key is omitted from .env.<env>" test_gen_deployed_env_omitted_key_fatals

# Complement: a key present in BOTH .env.dev and .env.<env> with different values
# emits the .env.<env> value, never the .env.dev one.
test_gen_deployed_env_delta_value_wins() {
  local root out; root="$(make_gen_env_root)"; write_full_cloud_env "$root"
  out="$("$root/bin/gen-deployed-env" gentest 2>/dev/null)"
  rm -rf "$root"
  # APP_DOMAIN is localhost in .env.dev, gentest.example.com in the delta.
  echo "$out" | grep -qx 'APP_DOMAIN=gentest.example.com' || { echo "delta value did not win: $out"; return 1; }
}
assert_success "gen-deployed-env: .env.<env> value wins over .env.dev" test_gen_deployed_env_delta_value_wins

# ── render-env merge (RFC 95) ─────────────────────────────────────────────────
echo "==== Testing render-env merge ===="

# Stub `aws ssm get-parameters-by-path` by putting a fake `aws` first on PATH that
# emits the given Name<TAB>Value rows. Echoes the stub dir (caller removes it).
make_aws_stub() {
  local rows_file="$1" stub_dir
  stub_dir="$(mktemp -d)"
  cat > "$stub_dir/aws" <<EOF
#!/usr/bin/env bash
# Only the get-parameters-by-path text query is stubbed; echo the fixture rows.
cat "$rows_file"
EOF
  chmod +x "$stub_dir/aws"
  echo "$stub_dir"
}

test_render_env_merge() {
  local release rows stub out_env
  release="$(mktemp -d)"; rows="$(mktemp)"; out_env="$(mktemp)"
  # deploy-env (non-secret box config) — includes APP_DOMAIN, which SSM ALSO sets
  # to a different value below to prove SSM wins on overlap.
  printf 'APP_DOMAIN=from-deploy-env\nEMAIL_PROVIDER=ses\n' > "$release/deploy-env"
  # SSM rows: a secret, an RDS-identity key, and an overlapping APP_DOMAIN.
  printf '/unicoach/test/DATABASE_PASSWORD\treal-secret\n/unicoach/test/PGHOST\trds.example.com\n/unicoach/test/APP_DOMAIN\tfrom-ssm\n' > "$rows"
  stub="$(make_aws_stub "$rows")"
  PATH="$stub:$PATH" SSM_PREFIX="/unicoach/test" ENV_PATH="$out_env" \
    ENV_OWNER="$(id -un)" ENV_GROUP="$(id -gn)" \
    bash "$PROJECT_ROOT/infra/files/render-env.sh" "$release" >/dev/null 2>&1
  local rc=$?
  local mode content
  content="$(cat "$out_env" 2>/dev/null)"
  # GNU stat (nix dev shell) uses -c '%a'; BSD/macOS stat uses -f '%Lp'. Try GNU
  # first, fall back to BSD, so the mode check is portable across both.
  mode="$(stat -c '%a' "$out_env" 2>/dev/null || stat -f '%Lp' "$out_env" 2>/dev/null)"
  rm -rf "$release" "$stub"; rm -f "$rows" "$out_env"
  [ "$rc" -eq 0 ] || { echo "render-env exit $rc"; return 1; }
  # Union: the non-overlapping deploy-env key survives; both SSM-only keys present.
  echo "$content" | grep -qx 'EMAIL_PROVIDER=ses' || { echo "deploy-env key lost: $content"; return 1; }
  echo "$content" | grep -qx 'DATABASE_PASSWORD=real-secret' || { echo "SSM secret missing: $content"; return 1; }
  echo "$content" | grep -qx 'PGHOST=rds.example.com' || { echo "SSM identity missing: $content"; return 1; }
  # SSM wins on APP_DOMAIN overlap: the deploy-env value must NOT be the effective
  # one. The merged file lists deploy-env keys SSM does not override, then all SSM
  # keys; assert the deploy-env APP_DOMAIN line is absent and the SSM one present.
  echo "$content" | grep -qx 'APP_DOMAIN=from-deploy-env' && { echo "deploy-env APP_DOMAIN not overridden: $content"; return 1; }
  echo "$content" | grep -qx 'APP_DOMAIN=from-ssm' || { echo "SSM APP_DOMAIN missing: $content"; return 1; }
  [ "$mode" = "600" ] || { echo "mode was [$mode], expected 600"; return 1; }
  return 0
}
assert_success "render-env merges deploy-env under SSM (SSM wins), mode 0600" test_render_env_merge

# An unseeded PLACEHOLDER secret still fails closed before writing the env file.
test_render_env_placeholder_fatals() {
  local release rows stub out_env
  release="$(mktemp -d)"; rows="$(mktemp)"; out_env="$(mktemp)"
  printf 'APP_DOMAIN=x\n' > "$release/deploy-env"
  printf '/unicoach/test/DATABASE_PASSWORD\tPLACEHOLDER_SEED_OUT_OF_BAND\n' > "$rows"
  stub="$(make_aws_stub "$rows")"
  : > "$out_env"  # ensure it stays empty (must not be written)
  PATH="$stub:$PATH" SSM_PREFIX="/unicoach/test" ENV_PATH="$out_env" \
    ENV_OWNER="$(id -un)" ENV_GROUP="$(id -gn)" \
    bash "$PROJECT_ROOT/infra/files/render-env.sh" "$release" >/dev/null 2>&1
  local rc=$?
  local written; written="$(cat "$out_env" 2>/dev/null)"
  rm -rf "$release" "$stub"; rm -f "$rows" "$out_env"
  [ "$rc" -ne 0 ] || { echo "expected nonzero exit on unseeded PLACEHOLDER"; return 1; }
  [ -z "$written" ] || { echo "env file was written despite PLACEHOLDER: $written"; return 1; }
}
assert_success "render-env fails closed on an unseeded PLACEHOLDER secret" test_render_env_placeholder_fatals

# ── deploy self-updating on-instance bootstrap (build_deploy_command) ──────────
# bin/deploy's SSM Run Command installs this release's render-env /
# deploy-on-instance / units from the bundle before invoking deploy-on-instance, so
# a plain deploy updates its own on-instance bootstrap. The composed command string
# is pure string assembly (build_deploy_command, bin/functions), so the harness
# drives the real function — no live AWS, no source scan. The AWS trigger itself
# (build, upload, send-command) still needs a real deploy to verify end to end.
echo "==== Testing build_deploy_command (deploy self-update) ===="

# bash -n over the two infra/files shell scripts the deploy installs on the host.
for script in render-env deploy-on-instance; do
  assert_success "bash -n infra/files/$script.sh parses cleanly" \
    bash -n "$PROJECT_ROOT/infra/files/$script.sh"
done

# The composed script bakes in the laptop-side bundle-id/region/s3-uri and carries
# every install step: both 0755 scripts, all FIVE 0644 units by explicit name (no
# wildcard, so a missing unit fails install loudly), daemon-reload, and the
# `systemctl enable` step that gives those units reboot persistence.
test_build_deploy_command_content() {
  local out unit
  out="$(build_deploy_command 20260704120000 us-west-2 s3://bkt/releases/unicoach-20260704120000.tar.gz)"
  echo "$out" | grep -qF 'RELEASE_DIR="/opt/unicoach/releases/20260704120000"' || { echo "bundle-id not baked in: $out"; return 1; }
  echo "$out" | grep -qF 'aws s3 cp --region us-west-2 s3://bkt/releases/unicoach-20260704120000.tar.gz' || { echo "region/s3-uri not baked in: $out"; return 1; }
  echo "$out" | grep -qF 'install -m 0755 "$RELEASE_DIR/infra/files/render-env.sh" /opt/unicoach/bin/render-env' || { echo "render-env install missing: $out"; return 1; }
  echo "$out" | grep -qF 'install -m 0755 "$RELEASE_DIR/infra/files/deploy-on-instance.sh" /opt/unicoach/bin/deploy-on-instance' || { echo "deploy-on-instance install missing: $out"; return 1; }
  for unit in rest-server queue-worker cron public-web admin-web; do
    echo "$out" | grep -qF "\"\$RELEASE_DIR/infra/files/unicoach-$unit.service\"" || { echo "unit install source missing for [$unit]: $out"; return 1; }
  done
  echo "$out" | grep -qF '/etc/systemd/system/' || { echo "systemd unit dest missing: $out"; return 1; }
  # No wildcard install: the units are enumerated, not globbed.
  echo "$out" | grep -qF 'unicoach-*.service' && { echo "unexpected wildcard unit install: $out"; return 1; }
  echo "$out" | grep -qF 'systemctl daemon-reload' || { echo "daemon-reload missing: $out"; return 1; }
  echo "$out" | grep -qF 'systemctl enable' || { echo "systemctl enable step missing: $out"; return 1; }
  return 0
}
assert_success "build_deploy_command bakes in values and every install step" test_build_deploy_command_content

# The install + daemon-reload MUST precede the deploy-on-instance invocation — the
# ordering that lets the freshly-installed copy run this deploy.
test_build_deploy_command_install_before_invoke() {
  local out reload_line invoke_line
  out="$(build_deploy_command b us-east-1 s3://x/y.tar.gz)"
  reload_line="$(echo "$out" | grep -nF 'systemctl daemon-reload' | cut -d: -f1)"
  invoke_line="$(echo "$out" | grep -nF '/opt/unicoach/bin/deploy-on-instance "$RELEASE_DIR"' | cut -d: -f1)"
  [ -n "$reload_line" ] && [ -n "$invoke_line" ] || { echo "missing markers: reload=$reload_line invoke=$invoke_line"; return 1; }
  [ "$reload_line" -lt "$invoke_line" ] || { echo "daemon-reload ($reload_line) not before invoke ($invoke_line)"; return 1; }
}
assert_success "build_deploy_command installs+daemon-reload before invoking deploy-on-instance" test_build_deploy_command_install_before_invoke

# The emitted remote script must be syntactically valid bash (the instance runs it).
test_build_deploy_command_valid_bash() {
  local out tmp rc=0
  out="$(build_deploy_command b us-east-1 s3://x/y.tar.gz)"
  tmp="$(mktemp)"
  printf '%s\n' "$out" > "$tmp"
  bash -n "$tmp" || rc=$?
  rm -f "$tmp"
  [ "$rc" -eq 0 ]
}
assert_success "build_deploy_command emits syntactically valid bash" test_build_deploy_command_valid_bash

# json_string encodes the multi-line, quote-bearing script as ONE valid JSON string
# that decodes back verbatim — the send-command --parameters commands=[...] contract.
test_json_string_roundtrips_multiline() {
  local out encoded decoded
  out="$(build_deploy_command b us-east-1 s3://x/y.tar.gz)"
  encoded="$(json_string "$out")"
  decoded="$(printf '%s' "$encoded" | python3 -c 'import json,sys; sys.stdout.write(json.load(sys.stdin))')" || return 1
  [ "$decoded" = "$out" ] || { echo "json round-trip mismatch"; return 1; }
}
assert_success "json_string round-trips the multi-line deploy script through JSON" test_json_string_roundtrips_multiline

end_tests
