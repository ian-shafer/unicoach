  rm -f "$EXTERNAL_ROOT/db/seed/cds"
  ln -s "$PROJECT_ROOT/db/seed/cds" "$EXTERNAL_ROOT/db/seed/cds"
  rm -rf "$seed"
  return "$rc"
}
assert_success "a missing CDS aid-policy seed is refused by name (RFC 170's fourth CDS file)" \
  test_load_external_data_refuses_a_missing_aid_policy_seed

