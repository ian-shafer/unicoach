#!/usr/bin/env bash
# Layer `.env -> .env.dev -> .env.test` (RFC 95): the DB block and required-toggle
# dev values live in .env.dev. ENV_FILES is a PATH-like ':'-separated string,
# exported so this harness's child processes (db-reset, rest-server-up/down,
# queue-worker-up/down, the bin/ SUTs it drives) inherit the same stack and target
# the per-worktree test DB. bin/common resolves each entry against PROJECT_ROOT.
export ENV_FILES=".env.dev:.env.test"
# Make fatal/log-* available before the port guard. `functions` only defines
# functions — it sources no `.env` — so it does not disturb the bootstrap
# ordering (`common`/`.env.test` is still sourced afterward and re-defines these
# idempotently).
#
# The block base is handed down as BASE_TEST_PORT, not PORT, and NOT because of
# any ordering requirement here: `.env` — the base layer every child re-sources
# — assigns PORT, ADMIN_WEB_PORT and PUBLIC_WEB_PORT unconditionally, so an
# exported PORT is clobbered in this process and in every child this harness
# drives (rest-server-up, daemon-*, the bin/ SUTs). `.env` does not own
# BASE_TEST_PORT, so it survives the layering, and each child's `.env.test`
# re-derives every service port from it — which is what makes rest-server-up
# bind the port rest-server-check later probes (RFC 131). The value is the base
# of this checkout's 16-aligned port block, derived from the checkout's name
# (bin/checkout-port, RFC 132), so two worktrees running this suite concurrently
# get provably disjoint blocks — not merely different single ports. Tests never
# hardcode a port; only .env (prod/dev) does.
source "$(dirname "$0")/functions"
export BASE_TEST_PORT="$("$(dirname "$0")/checkout-port")"
# This runs before `common` activates `set -euo pipefail`, so a checkout-port
# failure would otherwise leave BASE_TEST_PORT="" and .env.test's
# `${BASE_TEST_PORT:-17984}` would silently fall back to a hardcoded port. Guard
# it explicitly via fatal.
if [ -z "$BASE_TEST_PORT" ]; then
  fatal "checkout-port returned no free block; refusing to fall back to hardcoded ports."
fi
source "$(dirname "$0")/common"
source "$(dirname "$0")/tests-common"

# Bounded-poll knobs, named once (50 x 0.1s = ~5s ceiling).
PORT_POLL_ATTEMPTS=50
PORT_POLL_INTERVAL=0.1
# Outer guard for the bounded-probe regression test: comfortably above
# daemon-http-check's HEALTH_CONNECT_TIMEOUT(2) + HEALTH_MAX_TIME(3); a hang
# would trip this and surface as exit 124 instead of wedging the suite.
BOUNDED_PROBE_GUARD_SECS=8

# ── The bin/ sweep guards, driven from one place ──────────────────────────────
# Three sections assert the same SHAPE of property: no bin/ script may contain a
# line matching <pattern>, past a named allowlist. They used to be three verbatim
# copies of the membership loop and two of the sweep, so each carried its own
# chance of a subtly different scan (RFC 174). Membership itself is
# tests-common's list_contains, shared with bin/db-scripts-tests.
#
# COMMENTS ARE STRIPPED FIRST: every one of these guards explains its rule by
# quoting the very text it forbids. Capture-and-test for empty rather than piping
# into `grep -q`, which under `set -o pipefail` SIGPIPEs the upstream grep.
bin_script_free_of_pattern() {
  [ -z "$(grep -vE '^[[:space:]]*#' "$PROJECT_ROOT/bin/$2" | grep -E "$1")" ]
}
# One assertion PER SCRIPT, so a failure names the offending file rather than
# reporting "some script in bin/ does this".
assert_every_bin_script_free_of() {
  local description="$1" pattern="$2" script_path script
  shift 2
  for script_path in "$PROJECT_ROOT"/bin/*; do
    [ -f "$script_path" ] || continue
    script="$(basename "$script_path")"
    list_contains "$script" "$@" && continue
    assert_success "bin/$script $description" bin_script_free_of_pattern "$pattern" "$script"
  done
}

# Poll until <port> is free (check-port reports not-in-use), bounded. Returns 0
# once free, 1 on timeout. Replaces the inline `for i in {1..50}` free-polls.
wait_for_port_free() {
  local port="$1" i
  for ((i = 0; i < PORT_POLL_ATTEMPTS; i++)); do
    bin/check-port "$port" >/dev/null 2>&1 || return 0
    sleep "$PORT_POLL_INTERVAL"
  done
  return 1
}

# This checkout's identity as a NUMBER, from the same input every other
# per-worktree derivation uses (bin/functions' checkout_block_base, .env.dev's
# database name): the checkout root path. Two checkouts of this repo run this
# harness at the same time, so anything it names in a namespace the machine
# shares has to carry this tag — see the sentinel sleeps below and the isolation
# section's fake checkout names.
CKP_CHECKOUT_TAG="$(printf '%s' "$PROJECT_ROOT" | cksum | cut -d' ' -f1)"

# The daemon-up port tests park a long `sleep <n>` as their fake daemon and then
# find it again with `pgrep -f` / `pkill -f` — which match the WHOLE process
# table, not this checkout's children. Fixed numbers therefore had each
# concurrent checkout pkill'ing the OTHER's fake daemon: the victim's daemon-up
# died on SIGTERM and the run failed with "did not reclaim the port and boot
# (exit 143)", while the survivor's `pgrep` saw the other's child and failed with
# "daemon-up spawned a child despite the collision". Same defect as the isotest
# database names, in the process namespace instead of the database server.
#
# Spaced by 10 so the three offsets of one checkout can never overlap another's
# block, and kept 7 digits so the pattern cannot match an ordinary `sleep`.
SLEEP_SENTINEL_BASE=$(( 1000000 + (CKP_CHECKOUT_TAG % 800000) * 10 ))
SLEEP_SENTINEL_COLLISION=$(( SLEEP_SENTINEL_BASE + 1 ))
SLEEP_SENTINEL_RECLAIM=$(( SLEEP_SENTINEL_BASE + 2 ))
SLEEP_SENTINEL_KILL9=$(( SLEEP_SENTINEL_BASE + 3 ))

# Every foreign listener this harness spawns records its PID here so the EXIT
# trap can reap any that a test forgot or that a mid-run abort skipped — a leaked
# listen socket would block a later run's curl / probe on the same port.
FOREIGN_LISTENER_PIDS=()

reap_foreign_listeners() {
  local pid
  for pid in "${FOREIGN_LISTENER_PIDS[@]:-}"; do
    [ -n "$pid" ] && kill -9 "$pid" 2>/dev/null || true
  done
}

# Same contract for the cross-checkout isolation section's two REAL dev
# databases: the section sets ISO_DATABASES_LIVE while they exist, so a mid-run abort —
# fail_test exits the harness without unwinding, and a SIGINT does not unwind at
# all — still drops them. A leaked database is not the harness's own mess to
# tolerate: it sits on the cluster every checkout shares. iso_cleanup is defined
# with that section, far below; a trap body is resolved when it fires, not when
# it is installed.
reap_iso_databases() {
  [ -n "${ISO_DATABASES_LIVE:-}" ] || return 0
  iso_cleanup
}

# Tear down only the daemons this harness starts. The PostgreSQL cluster is
# shared across worktrees (see bin/INVARIANTS.md) — never stop it.
reap_harness_resources() {
  bin/rest-server-down >/dev/null 2>&1 || true
  bin/queue-worker-down >/dev/null 2>&1 || true
  bin/daemon-down idem-test >/dev/null 2>&1 || true
  bin/daemon-down collision-test >/dev/null 2>&1 || true
  bin/daemon-down reclaim-test >/dev/null 2>&1 || true
  reap_foreign_listeners
  reap_iso_databases
}

# INT and TERM EXIT rather than falling back into the script. A bash signal
# handler RESUMES where it interrupted, and this reaper now destroys state the
# run is still using — it drops the isolation section's two databases and removes
# its fake checkouts — so a Ctrl-C mid-section would otherwise be reported as a
# cascade of fabricated assertion failures instead of an interrupt. Exiting
# re-enters the same reaper through the EXIT trap; it is idempotent.
trap reap_harness_resources EXIT
trap 'reap_harness_resources; exit 130' INT
trap 'reap_harness_resources; exit 143' TERM

echo "Harness up"
echo ""

TEST_LOCK="$PROJECT_ROOT/var/run/test.lock"
mkdir -p "$PROJECT_ROOT/var/run"

echo "==== Testing file-lock ===="
rm -rf "$TEST_LOCK" || true
rm -rf "${TEST_LOCK}.stale."* || true

bin/file-lock -o op-a "$TEST_LOCK" 60
if [ ! -d "$TEST_LOCK" ]; then echo "Fail: Failed to create lock"; exit 1; fi
pass_test "File lock created successfully"

bin/file-lock -o op-a "$TEST_LOCK" 60 || STATUS=$?
if [ "${STATUS:-0}" -ne 3 ]; then echo "Fail: Failed to fast-fail on matching op"; exit 1; fi
pass_test "File lock fast-failed on matching op"

rm -rf "$TEST_LOCK" || true
mkdir "$TEST_LOCK"
echo "op-a" > "$TEST_LOCK/op"
echo "10" > "$TEST_LOCK/expires-at"
if ! bin/file-lock -o op-a "$TEST_LOCK" 60; then
  echo "Fail: Failed to organically break a stale lock because the OP happened to loosely match."
  exit 1
fi
pass_test "File lock cleanly broke stale lock on loose match"

if bin/file-lock -t 1s -o op-b "$TEST_LOCK" 60 2>/dev/null; then echo "Fail: Failed to block conflicting op"; exit 1; fi
pass_test "File lock blocked conflicting op"

echo "$(( $(date +%s) - 10 ))" > "$TEST_LOCK/expires-at"
bin/file-lock -o op-c "$TEST_LOCK" 60
if [ "$(cat "$TEST_LOCK/op")" != "op-c" ]; then echo "Fail: Failed to recover stale lock"; exit 1; fi
pass_test "File lock recovered stale lock"

rm -rf "$TEST_LOCK" || true
rm -rf "${TEST_LOCK}.stale."* || true

# Foreign-listener helpers. Each spawns bin/test-tcp-listener (a real, lintable
# python3 file — bash cannot listen(), and the dev shell ships no nc/socat) to
# occupy 127.0.0.1:<port> with a PID NOT recorded in any var/run/*.pid file: the
# cross-worktree / foreign-occupant case. _spawn_test_listener sets the global
# FOREIGN_LISTENER_PID (NOT echoed — a $(...) subshell would lose the PID from
# the EXIT-trap tracking array) and blocks until the port is actually bound, so
# the probe never races. Pair each with stop_foreign_listener to bracket the
# assertion.
FOREIGN_LISTENER_PID=""

_spawn_test_listener() {
  local port="$1" mode="$2" ignore_term="${3:-}"
  local env_prefix=()
  [ "$ignore_term" = ignore-term ] && env_prefix=(env TEST_LISTENER_IGNORE_SIGTERM=1)
  "${env_prefix[@]}" "$PROJECT_ROOT/bin/test-tcp-listener" "$port" "$mode" >/dev/null 2>&1 &
  local listener_pid=$!
  FOREIGN_LISTENER_PIDS+=("$listener_pid")
  local i
  for ((i = 0; i < PORT_POLL_ATTEMPTS; i++)); do
    # Readiness is "MY listener is up", not "the port is occupied". If this
    # child has exited it lost the bind (EADDRINUSE from a leaked fixture), and
    # check-port would then report the port in use by the WINNER -- handing back
    # a listener of the wrong mode. A stalled-listener test that silently
    # measured a leftover close-mode listener would pass while testing nothing,
    # which is the same occupancy-is-not-identity confusion daemon-http-check
    # had. Fail loudly instead.
    if ! kill -0 "$listener_pid" 2>/dev/null; then
      wait "$listener_pid" 2>/dev/null || true
      FOREIGN_LISTENER_PID=""
      return 1
    fi
    if bin/check-port "$port" >/dev/null 2>&1; then
      FOREIGN_LISTENER_PID="$listener_pid"
      return 0
    fi
    sleep "$PORT_POLL_INTERVAL"
  done
  kill -9 "$listener_pid" 2>/dev/null || true
  FOREIGN_LISTENER_PID=""
  return 1
}

# accept + immediately close: a fast empty reply, as a non-HTTP occupant gives.
start_foreign_listener() { _spawn_test_listener "$1" close; }

# accept + reply HTTP 200: a foreign occupant that is a perfectly healthy daemon,
# just not ours -- the cross-worktree case. A port-only or curl-only probe cannot
# tell this apart from our own service, which is precisely how a stopped service
# was once reported as running.
start_healthy_foreign_listener() { _spawn_test_listener "$1" healthy; }

# accept + hold open, never replying: the "wedged server" case. An unbounded
# curl against this blocks forever, so it proves daemon-http-check's bounded
# probe gives up instead of hanging.
start_stalled_listener() { _spawn_test_listener "$1" hold; }

# accept + immediately close, but ignore SIGTERM: survives daemon-up -k and is
# cleared only by -9 (SIGKILL). The fixture that distinguishes the two signals.
start_term_ignoring_listener() { _spawn_test_listener "$1" close ignore-term; }

stop_foreign_listener() {
  local listener_pid="$1"
  [ -n "$listener_pid" ] && kill -9 "$listener_pid" 2>/dev/null || true
  wait "$listener_pid" 2>/dev/null || true
}

# Ensures postgres is up and the test database exists before starting any JVM
# daemon. Provisioning goes through bin/db-create, never a raw `psql -U postgres`:
# since RFC 174 the database must be OWNED by this checkout's role, and a
# superuser-created one could not be dropped by this harness's own db-reset test
# below — the harness would manufacture exactly the state the change forbids.
#
# db-create's status AND its diagnostics are BOTH kept. This harness sets no
# `set -e`, and RFC 174 gave db-create two new ways to fail (the role bootstrap
# and the adoption), so a discarded refusal used to resurface fifty lines later as
# an unrelated "the daemon did not boot". The fault is reported where it happens,
# naming the database, the role and what the server said.
ensure_postgres_for_jvm() {
  local create_log
  bin/postgres-up >/dev/null
  for i in {1..15}; do
    if bin/db-query -r -d "${POSTGRES_ADMIN_DB:-postgres}" 'SELECT 1' >/dev/null 2>&1; then break; fi
    sleep 1
  done
  if ! create_log="$(bin/db-create 2>&1)"; then
    fail_test "could not provision database [$POSTGRES_DB] as role [$POSTGRES_USER] before starting a JVM daemon: $create_log"
  fi
}

test_daemon_wrapper() {
  local WRAPPER="$1"
  local UP_CMD="bin/$WRAPPER-up"
  local DOWN_CMD="bin/$WRAPPER-down"
  local BOUNCE_CMD="bin/$WRAPPER-bounce"
  local CHECK_CMD="bin/$WRAPPER-check"

  echo ""
  echo "==== Testing Wrapper: $WRAPPER ===="

  # 1. Simple Up & Down & 4. Idempotent Down
  $DOWN_CMD >/dev/null || true
  if $CHECK_CMD >/dev/null 2>&1; then echo "Fail: $WRAPPER claimed success despite stripped service."; exit 1; fi
  ensure_postgres_for_jvm
  $UP_CMD >/dev/null
  if ! $CHECK_CMD >/dev/null; then echo "Fail: $WRAPPER did not actually boot or reach a healthy state."; exit 1; fi
  pass_test "$WRAPPER Simple Up & Down & Idempotent Down"

  # 2. Idempotent Up
  if ! $UP_CMD >/dev/null; then echo "Fail: Redundant up was not idempotent for $WRAPPER."; exit 1; fi
  pass_test "$WRAPPER Idempotent Up"

  # 6. Restart Lifecycle
  if ! $BOUNCE_CMD >/dev/null; then echo "Fail: Bounce failed natively for $WRAPPER."; exit 1; fi
  if ! $CHECK_CMD >/dev/null; then echo "Fail: Restart did not leave $WRAPPER securely running."; exit 1; fi
  pass_test "$WRAPPER Restart Lifecycle"

  # Assert PID file exists and contains a running process after up
  PID_FILE="$PROJECT_ROOT/var/run/${WRAPPER}.pid"
  if [ ! -f "$PID_FILE" ]; then echo "Fail: PID file not found for $WRAPPER after up."; exit 1; fi
  running_pid="$(cat "$PID_FILE")"
  if ! bin/check-pid "$running_pid" >/dev/null 2>&1; then echo "Fail: PID in PID file is not alive for $WRAPPER."; exit 1; fi
  pass_test "$WRAPPER PID file created and process is alive"

  # Assert log file exists after up
  LOG_FILE="$PROJECT_ROOT/var/log/${WRAPPER}.log"
  if [ ! -f "$LOG_FILE" ]; then echo "Fail: Log file not found for $WRAPPER."; exit 1; fi
  pass_test "$WRAPPER log file created"

  # 3. Concurrent Up (After stopping first)
  $DOWN_CMD >/dev/null
  ensure_postgres_for_jvm
  $UP_CMD >/dev/null & PID1=$!
  $UP_CMD >/dev/null & PID2=$!
  wait $PID1; if [ $? -ne 0 ]; then echo "Fail: Process 1 failed to boot daemon $WRAPPER"; exit 1; fi
  wait $PID2; if [ $? -ne 0 ]; then echo "Fail: Process 2 failed lock concurrency coordination $WRAPPER"; exit 1; fi
  if ! $CHECK_CMD >/dev/null; then echo "Fail: $WRAPPER concurrent up didn't end up healthy."; exit 1; fi
  pass_test "$WRAPPER Concurrent Up"

  # 5. Concurrent Down
  $DOWN_CMD >/dev/null & PID3=$!
  $DOWN_CMD >/dev/null & PID4=$!
  wait $PID3; if [ $? -ne 0 ]; then echo "Fail: Process 3 failed concurrent down for $WRAPPER"; exit 1; fi
  wait $PID4; if [ $? -ne 0 ]; then echo "Fail: Process 4 failed concurrent down coordination for $WRAPPER"; exit 1; fi
  if $CHECK_CMD >/dev/null 2>&1; then echo "Fail: Concurrent down didn't actually stop $WRAPPER"; exit 1; fi
  pass_test "$WRAPPER Concurrent Down"

  # Assert PID file is removed after down
  if [ -f "$PID_FILE" ]; then echo "Fail: PID file still exists for $WRAPPER after down."; exit 1; fi
  pass_test "$WRAPPER PID file removed after down"

  # Assert stale PID file (process exited externally) is handled gracefully by down
  ensure_postgres_for_jvm
  $UP_CMD >/dev/null
  stale_pid="$(cat "$PID_FILE")"
  kill -KILL "$stale_pid" 2>/dev/null || true
  sleep 1
  if ! $DOWN_CMD >/dev/null; then echo "Fail: $WRAPPER down did not handle stale PID gracefully."; exit 1; fi
  if [ -f "$PID_FILE" ]; then echo "Fail: Stale PID file not cleaned up by down for $WRAPPER."; exit 1; fi
  pass_test "$WRAPPER stale PID file handled gracefully by down"

  # Assert daemon-up idempotency: second invocation while service is running exits 0 without duplicate
  ensure_postgres_for_jvm
  $UP_CMD >/dev/null
  first_pid="$(cat "$PID_FILE")"
  $UP_CMD >/dev/null
  second_pid="$(cat "$PID_FILE")"
  if [ "$first_pid" != "$second_pid" ]; then
    echo "Fail: daemon-up spawned a duplicate process for $WRAPPER (PIDs: $first_pid vs $second_pid)"
    exit 1
  fi
  pass_test "$WRAPPER idempotent up does not spawn duplicate process"

  # Check help flag for check
  if ! $CHECK_CMD -h >/dev/null; then echo "Fail: Help flag did not natively exit 0 on check for $WRAPPER"; exit 1; fi
  pass_test "$WRAPPER Help flag returned 0"
}

test_daemon_wrapper "rest-server"
test_daemon_wrapper "queue-worker"

# Ensure all services are stopped before the standalone section tests.
bin/rest-server-down >/dev/null 2>&1 || true
bin/queue-worker-down >/dev/null 2>&1 || true

echo ""
echo "==== Testing daemon-status ===="
if ! bin/daemon-status -h >/dev/null; then echo "Fail: daemon-status -h did not exit 0"; exit 1; fi
pass_test "daemon-status help flag returned 0"

# daemon-status now threads $PORT into the rest-server check, so the stopped
# assertion only holds when that port is actually free. Confirm it defensively
# (mirrors the foreign-listener teardown discipline) before asserting stopped.
if ! wait_for_port_free "${PORT:-8080}"; then
  echo "Fail: precondition — rest-server port ${PORT:-8080} must be free for the stopped assertion"
  exit 1
fi
daemon_status_out="$(bin/daemon-status)"
if ! echo "$daemon_status_out" | grep "rest-server" | grep "stopped" >/dev/null; then
  echo "Fail: daemon-status did not report rest-server as stopped"
  echo "$daemon_status_out"
  exit 1
fi
pass_test "daemon-status output accuracy"

# daemon-status conflict tri-state: a foreign listener on rest-server's port
# while its PID file is absent ⇒ a printed "conflict" line, not "stopped".
start_foreign_listener "${PORT:-8080}" || { echo "Fail: could not bind foreign listener on ${PORT:-8080}"; exit 1; }
ds_listener="$FOREIGN_LISTENER_PID"
daemon_status_conflict="$(bin/daemon-status)"
if ! echo "$daemon_status_conflict" | grep "rest-server" | grep "conflict" >/dev/null; then
  echo "Fail: daemon-status did not report rest-server as conflict when its port is foreign-held"
  echo "$daemon_status_conflict"
  stop_foreign_listener "$ds_listener"
  exit 1
fi
stop_foreign_listener "$ds_listener"
pass_test "daemon-status reports conflict when rest-server port is foreign-held"

echo ""
echo "==== Testing check-pid ===="
if ! bin/check-pid $$ >/dev/null; then echo "Fail: check-pid did not exit 0 for live PID"; exit 1; fi
pass_test "check-pid exits 0 when PID is alive"

if bin/check-pid 999999 >/dev/null 2>&1; then echo "Fail: check-pid did not exit 1 for nonexistent PID"; exit 1; fi
pass_test "check-pid exits 1 when PID does not exist"

echo ""
echo "==== Testing SIGKILL escalation ===="
mkdir -p "$PROJECT_ROOT/var/run" "$PROJECT_ROOT/var/log"
( trap '' TERM; while true; do sleep 1; done ) >/dev/null 2>&1 &
STUBBORN_PID=$!
echo "$STUBBORN_PID" > "$PROJECT_ROOT/var/run/sigkill-test.pid"
if ! bin/daemon-down sigkill-test >/dev/null; then echo "Fail: daemon-down failed on SIGKILL escalation test"; exit 1; fi
if bin/check-pid "$STUBBORN_PID" 2>/dev/null; then echo "Fail: Stubborn process still alive after SIGKILL"; exit 1; fi
pass_test "daemon-down escalates to SIGKILL when process ignores SIGTERM"

echo ""
echo "==== Testing Bash Utilities ===="
test_validate_duration_valid() {
  if ! validate_duration 5s; then return 1; fi
  if ! validate_duration 10m; then return 1; fi
  if ! validate_duration 2h; then return 1; fi
  if ! validate_duration 1d; then return 1; fi
  return 0
}
assert_success "validate_duration valid" test_validate_duration_valid

test_validate_duration_invalid() {
  if validate_duration 5x; then return 1; fi
  if validate_duration s; then return 1; fi
  if validate_duration ""; then return 1; fi
  return 0
}
assert_success "validate_duration invalid" test_validate_duration_invalid

test_transform_duration_to_postgres_valid() {
  if [ "$(transform_duration_to_postgres 5s)" != "5 seconds" ]; then return 1; fi
  if [ "$(transform_duration_to_postgres 10m)" != "10 minutes" ]; then return 1; fi
  if [ "$(transform_duration_to_postgres 2h)" != "2 hours" ]; then return 1; fi
  if [ "$(transform_duration_to_postgres 1d)" != "1 days" ]; then return 1; fi
  return 0
}
assert_success "transform_duration_to_postgres valid" test_transform_duration_to_postgres_valid

test_require_dangerous_confirmation_success() {
  echo "Yes, I really want to do this" | require_dangerous_confirmation "test" >/dev/null 2>&1
}
assert_success "require_dangerous_confirmation success" test_require_dangerous_confirmation_success

test_require_dangerous_confirmation_empty() {
  (echo "" | require_dangerous_confirmation "test" >/dev/null 2>&1)
}
assert_success "require_dangerous_confirmation empty" test_require_dangerous_confirmation_empty

# Validates the caller-side flag bypass pattern used by q-truncate and db-drop:
# when -y is present, the prompt is never invoked.
test_require_dangerous_confirmation_flag() {
  skip_prompt=false
  for arg in -y; do
    case "$arg" in
      -y) skip_prompt=true ;;
    esac
  done
  if [ "$skip_prompt" = false ]; then
    require_dangerous_confirmation "test" >/dev/null 2>&1
  fi
}
assert_success "require_dangerous_confirmation flag bypass" test_require_dangerous_confirmation_flag

echo ""
echo "==== Testing AWS account guard ===="
# validate_aws_account_id: pure 12-digit format check (single owner of the rule).
test_validate_aws_account_id_valid() {
  validate_aws_account_id 464190673722
}
assert_success "validate_aws_account_id accepts a 12-digit id" test_validate_aws_account_id_valid

test_validate_aws_account_id_invalid() {
  if validate_aws_account_id ""; then return 1; fi
  if validate_aws_account_id 12345; then return 1; fi         # too short
  if validate_aws_account_id 4641906737220; then return 1; fi # 13 digits
  if validate_aws_account_id 46419067372a; then return 1; fi  # non-digit
  return 0
}
assert_success "validate_aws_account_id rejects malformed ids" test_validate_aws_account_id_invalid

# assert_aws_account: fatals on a missing/malformed expected id before any AWS
# call, and — with a shimmed `aws` reporting a known account — passes on a match
# and fatals on a mismatch. The shim keeps the test hermetic: no real STS call,
# no credentials, so it runs identically anywhere.
test_assert_aws_account_guard() {
  # Missing / malformed expected id ⇒ fatal, before aws is ever consulted.
  if ( assert_aws_account "" ) >/dev/null 2>&1; then return 1; fi
  if ( assert_aws_account 12345 ) >/dev/null 2>&1; then return 1; fi

  local shim_dir
  shim_dir="$(mktemp -d)"
  cat > "$shim_dir/aws" <<'SHIM'
#!/usr/bin/env bash
echo 111122223333
SHIM
  chmod +x "$shim_dir/aws"

  local rc=0
  # Active account matches the expected id ⇒ success.
  ( PATH="$shim_dir:$PATH"; hash -r; assert_aws_account 111122223333 ) >/dev/null 2>&1 || rc=1
  # Active account differs from the expected id ⇒ fatal.
  if ( PATH="$shim_dir:$PATH"; hash -r; assert_aws_account 444455556666 ) >/dev/null 2>&1; then rc=1; fi

  rm -rf "$shim_dir"
  return "$rc"
}
assert_success "assert_aws_account passes on a match and fatals on a mismatch" test_assert_aws_account_guard

# The four scratch ports this suite binds are ASSIGNED from the offset registry
# in bin/checkout-port's help text (+3..+6), not scanned for. Scanning is what
# RFC 132 removes: a scan bleeds out of this checkout's block and can hand back
# a port a NEIGHBOURING checkout has already derived but not yet bound, and
# find-free-port only ever claims a port is free at the instant of printing.
# checkout-port has already verified every port in this block is free.
PORT_FREE=$((BASE_TEST_PORT + 3))
PORT_IDEM=$((BASE_TEST_PORT + 4))
PORT_HTTP=$((BASE_TEST_PORT + 5))
PORT_KILL=$((BASE_TEST_PORT + 6))

echo ""
echo "==== Testing check-port ===="
# check-port: free
if bin/check-port "$PORT_FREE" >/dev/null 2>&1; then echo "Fail: check-port did not exit 1 for a free port"; exit 1; fi
pass_test "check-port exits 1 when port is free"

# check-port: in use, then free again after kill
start_foreign_listener "$PORT_FREE" || { echo "Fail: could not bind foreign listener on $PORT_FREE"; exit 1; }
cp_listener="$FOREIGN_LISTENER_PID"
if ! bin/check-port "$PORT_FREE" >/dev/null 2>&1; then echo "Fail: check-port did not exit 0 for a bound port"; stop_foreign_listener "$cp_listener"; exit 1; fi
pass_test "check-port exits 0 when port is in use"
stop_foreign_listener "$cp_listener"
# Wait for the kernel to release the socket, bounded.
if ! wait_for_port_free "$PORT_FREE"; then echo "Fail: check-port did not exit 1 after listener killed"; exit 1; fi
pass_test "check-port exits 1 again after listener is killed"

# check-port: usage errors now route to the reserved band — a missing <port> is
# EXIT_MISSING_REQUIRED_ARG (21), a non-numeric one EXIT_INVALID_ARG_VALUE (22) —
# disjoint from the operational 0 (in use) / 1 (free) the probe returns.
cp_status=0; bin/check-port >/dev/null 2>&1 || cp_status=$?
if [ "$cp_status" -ne "$EXIT_MISSING_REQUIRED_ARG" ]; then echo "Fail: check-port (no arg) did not exit $EXIT_MISSING_REQUIRED_ARG (got $cp_status)"; exit 1; fi
cp_status=0; bin/check-port notaport >/dev/null 2>&1 || cp_status=$?
if [ "$cp_status" -ne "$EXIT_INVALID_ARG_VALUE" ]; then echo "Fail: check-port notaport did not exit $EXIT_INVALID_ARG_VALUE (got $cp_status)"; exit 1; fi
pass_test "check-port rejects missing / non-numeric <port> with band codes (21 / 22)"

echo ""
echo "==== Testing checkout-port and test-port isolation ===="
# Determinism: the block base is derived from the checkout name, so repeated
# calls in one checkout agree. That is what makes a leaked daemon anywhere in the
# block attributable to this checkout.
ckp_first="$(bin/checkout-port)"
ckp_second="$(bin/checkout-port)"
if [ "$ckp_first" != "$ckp_second" ]; then echo "Fail: checkout-port is not deterministic ($ckp_first vs $ckp_second)"; exit 1; fi
if ! validate_port "$ckp_first"; then echo "Fail: checkout-port printed an invalid base [$ckp_first]"; exit 1; fi
if ! validate_port $((ckp_first + 15)); then echo "Fail: checkout-port block top $((ckp_first + 15)) is not a valid port"; exit 1; fi
pass_test "checkout-port returns the same block base on repeated calls in one checkout"

# Block disjointness — the property RFC 132 adds, and the one RFC 131's
# single-port derivation cannot provide. Two DIFFERENT checkout names must get
# blocks that do not OVERLAP, not merely different bases: under a per-port
# derivation two checkouts 1 apart both "differ" while their in-use windows sit
# on top of each other. Exercised end to end rather than by re-deriving the hash
# here: a fake checkout root is a directory of symlinks back into this one, so
# `basename $PROJECT_ROOT` — the only input — is the only thing that differs.
CKP_FAKE_PARENT="$(mktemp -d)"
# CALLER'S INVARIANT: a fake checkout that goes on to create a REAL object on
# shared state — a dev database above all, since .env.dev derives its name from
# the checkout name alone and every checkout shares one server — must be given a
# name that no OTHER checkout can derive (the isolation section below tags its
# two names with a cksum of $PROJECT_ROOT). A name-only or port-only fixture,
# like the two searches here, needs no tag: they derive numbers and bind nothing.
make_fake_checkout() {
  local name="$1" entry root
  # Assigned on its own line: a `local` statement expands all its words before
  # any of them is assigned, so `local name=$1 root=.../$name` would interpolate
  # whatever `name` meant OUTSIDE the function (the nix dev shell exports
  # name=nix-shell-env).
  root="$CKP_FAKE_PARENT/$name"
  mkdir -p "$root"
  # `db` is linked too so a fake root can run the DB scripts (db-migrate resolves
  # DB_SCHEMA_DIR as $PROJECT_ROOT/db/schema) — the cross-checkout isolation test
  # below drives a real bin/db-reset inside one of these roots.
  for entry in bin db .env .env.dev .env.test .env.fuzz; do
    ln -s "$PROJECT_ROOT/$entry" "$root/$entry"
  done
  echo "$root"
}

# Walks fake checkout names under $1 until two of them RESOLVE DIFFERENTLY under
# $2 — a resolver function taking a fake root and echoing one value — then leaves
# the pair in FAKE_NAME_A/FAKE_RESOLVED_A and FAKE_NAME_B/FAKE_RESOLVED_B.
# FAKE_NAME_B empty means no differing pair was found. Globals rather than a return value:
# it yields four strings, and bash cannot return a tuple. Both disjointness
# properties below (port BLOCKS, and dev port TRIPLES) need exactly this search,
# differing only in what they resolve.
find_two_differing_checkouts() {
  local prefix="$1" resolver="$2" suffix root resolved
  FAKE_NAME_A=""; FAKE_NAME_B=""; FAKE_RESOLVED_A=""; FAKE_RESOLVED_B=""
  for suffix in a b c d e f g h; do
    root="$(make_fake_checkout "$prefix-$suffix")"
    resolved="$("$resolver" "$root")"
    if [ -z "$FAKE_NAME_A" ]; then
      FAKE_NAME_A="$prefix-$suffix"; FAKE_RESOLVED_A="$resolved"
    elif [ "$resolved" != "$FAKE_RESOLVED_A" ]; then
      FAKE_NAME_B="$prefix-$suffix"; FAKE_RESOLVED_B="$resolved"
      break
    fi
  done
}

resolve_checkout_port() {
  "$1/bin/checkout-port"
}

# env -u ENV_FILES: this harness exports the test layering, and the dev ports
# only exist under the ambient `.env -> .env.dev` default. The root is passed as
# an ARGUMENT to the child rather than interpolated into its program text.
resolve_dev_ports() {
  env -u ENV_FILES -u ENV_FILE bash -c \
    'source "$1/bin/common"; echo "$PORT $ADMIN_WEB_PORT $PUBLIC_WEB_PORT"' _ "$1"
}

find_two_differing_checkouts "unicoach-blocktest" resolve_checkout_port
ckp_name_a="$FAKE_NAME_A"; ckp_base_a="$FAKE_RESOLVED_A"
ckp_name_b="$FAKE_NAME_B"; ckp_base_b="$FAKE_RESOLVED_B"
rm -rf "$CKP_FAKE_PARENT"
if [ -z "$ckp_name_b" ]; then echo "Fail: could not find two checkout names with different derived blocks"; exit 1; fi
# Disjoint, not merely different: neither block may contain any port of the other.
if [ "$ckp_base_a" -lt "$ckp_base_b" ]; then ckp_lo="$ckp_base_a"; ckp_hi="$ckp_base_b"; else ckp_lo="$ckp_base_b"; ckp_hi="$ckp_base_a"; fi
if [ $((ckp_lo + 15)) -ge "$ckp_hi" ]; then
  echo "Fail: blocks for [$ckp_name_a] ($ckp_base_a..$((ckp_base_a + 15))) and [$ckp_name_b] ($ckp_base_b..$((ckp_base_b + 15))) overlap"
  exit 1
fi
pass_test "two different checkout names derive non-overlapping port blocks"

# Ceiling: the highest derivable block must stay entirely below macOS's ephemeral
# range (net.inet.ip.portrange.first = 49152), where an outbound socket could
# steal a test port. Read the geometry from the script rather than restating it.
# The constants moved to bin/functions (RFC 156), their single home now that
# checkout_block_base shares them with bin/checkout-port. Read the SOURCED
# variables, not a text grep of the file: this harness already sources
# bin/functions (line 25), and a harmless reformat there -- `CHECKOUT_BLOCK_SIZE=$((8 * 2))`
# -- would make a grep yield empty strings and this ceiling test pass vacuously.
ckp_floor="$CHECKOUT_BLOCK_FLOOR"
ckp_size="$CHECKOUT_BLOCK_SIZE"
ckp_count="$CHECKOUT_BLOCK_COUNT"
ckp_top=$((ckp_floor + (ckp_count - 1) * ckp_size + ckp_size - 1))
if [ "$ckp_top" -ge 49152 ]; then echo "Fail: highest derivable port $ckp_top is at or above the ephemeral floor 49152"; exit 1; fi
pass_test "the highest derivable block stays below the 49152 ephemeral floor ($ckp_top)"

# Floor: the harness-less fallback in the delta files must sit entirely BELOW the
# block floor, so it is not a derivable block base and can never be mistaken for
# — or collide with — a block some checkout owns. 18080 used to be exactly block
# index 5. Read both literals from the files rather than restating them, and
# require the two deltas to agree: .env.fuzz's offsets (+7..+9) are relative to
# the same base as .env.test's (+0..+2).
ckp_fb_test="$(grep -oE 'BASE_TEST_PORT:-[0-9]+' .env.test | head -1 | grep -oE '[0-9]+$')"
ckp_fb_fuzz="$(grep -oE 'BASE_TEST_PORT:-[0-9]+' .env.fuzz | head -1 | grep -oE '[0-9]+$')"
if [ -z "$ckp_fb_test" ] || [ -z "$ckp_fb_fuzz" ]; then echo "Fail: could not read the BASE_TEST_PORT fallback from the delta files"; exit 1; fi
if [ "$ckp_fb_test" != "$ckp_fb_fuzz" ]; then
  echo "Fail: .env.test falls back to $ckp_fb_test but .env.fuzz falls back to $ckp_fb_fuzz; the fuzz offsets are relative to the same base"
  exit 1
fi
if [ $((ckp_fb_test + ckp_size - 1)) -ge "$ckp_floor" ]; then
  echo "Fail: fallback block $ckp_fb_test..$((ckp_fb_test + ckp_size - 1)) reaches the derivable range (floor $ckp_floor)"
  exit 1
fi
pass_test "the delta files' fallback block ($ckp_fb_test) sits below the $ckp_floor block floor"

# Block-wise fallback: the derived block is a preference, not a guarantee (hash
# collision, or a foreign process squatting inside it). Hold a port in the middle
# of the EPHEMERAL half — offset +5, one of the scripts-tests scratch offsets, so
# a port-wise fallback would happily return a base whose block still straddles
# the held port. The whole point of RFC 132 is that checkout-port advances by
# BLOCK: the fallback must be a different block, entirely free.
#
# The fixture used to sit on +12. RFC 156 assigned +10/+11/+12 to the DEV
# daemons and narrowed the free-check to +0..+9, so a listener on +12 no longer
# advances anything — it is now the subject of the opposite assertion below.
# Holding it here would have turned this test green-but-vacuous.
start_foreign_listener $((ckp_first + 5)) || fail_test "could not bind foreign listener on [$((ckp_first + 5))]"
ckp_listener="$FOREIGN_LISTENER_PID"
ckp_fallback="$(bin/checkout-port)" || { echo "Fail: checkout-port failed while a port inside its derived block was held"; stop_foreign_listener "$ckp_listener"; exit 1; }
if [ "$ckp_fallback" = "$ckp_first" ]; then stop_foreign_listener "$ckp_listener"; fail_test "checkout-port returned block [$ckp_first], which contains the held port [$((ckp_first + 5))]"; fi
if [ "$ckp_fallback" -le $((ckp_first + 15)) ] && [ $((ckp_fallback + 15)) -ge "$ckp_first" ]; then
  echo "Fail: checkout-port fallback block $ckp_fallback..$((ckp_fallback + 15)) overlaps the held block $ckp_first..$((ckp_first + 15))"
  stop_foreign_listener "$ckp_listener"; exit 1
fi
for ckp_offset in $(seq 0 15); do
  if bin/check-port $((ckp_fallback + ckp_offset)) >/dev/null 2>&1; then
    echo "Fail: port $((ckp_fallback + ckp_offset)) in the fallback block $ckp_fallback is not free"
    stop_foreign_listener "$ckp_listener"; exit 1
  fi
done
stop_foreign_listener "$ckp_listener"
pass_test "checkout-port advances a whole block when a port in the ephemeral half is held"
# The suite's own scratch ports live in this block; release it before moving on.
if ! wait_for_port_free $((ckp_first + 5)); then fail_test "[$((ckp_first + 5))] not released after the checkout-port fallback case"; fi

# ── The dev half of the block (RFC 156) ──────────────────────────────────────
# checkout_block_base (bin/functions) is the PURE derivation, shared by
# bin/checkout-port and .env.dev. It must be deterministic for the same reason
# the script is: a dev port that moves is baked-in-wrong in every iOS bundle
# built before it moved.
#
# …and it must AGREE with bin/checkout-port whenever that script has no reason to
# advance, or the registry in its help text and the derivation .env.dev reads
# would be describing two different blocks. The agreement only holds when the
# ephemeral half is free, which is exactly the condition the script advances on,
# so establish that first and assert the weaker (still-derived) property
# otherwise rather than failing on someone else's stray listener.
ckp_derived_base="$(checkout_block_base)"

test_checkout_block_base_is_the_pure_derivation() {
  local again offset held=0
  again="$(checkout_block_base)"
  if [ "$ckp_derived_base" != "$again" ]; then
    fail_test "checkout_block_base is not deterministic ($ckp_derived_base vs $again)"
  fi
  if ! validate_port "$ckp_derived_base"; then
    fail_test "checkout_block_base printed an invalid base [$ckp_derived_base]"
  fi
  for offset in $(seq 0 9); do
    if bin/check-port $((ckp_derived_base + offset)) >/dev/null 2>&1; then held=1; fi
  done
  if [ "$held" -eq 0 ]; then
    if [ "$ckp_derived_base" != "$ckp_first" ]; then
      fail_test "checkout_block_base [$ckp_derived_base] disagrees with bin/checkout-port [$ckp_first] with the ephemeral half free"
    fi
  elif [ "$ckp_first" -le "$ckp_derived_base" ] || [ $(( (ckp_first - ckp_derived_base) % ckp_size )) -ne 0 ]; then
    fail_test "with the ephemeral half held, bin/checkout-port [$ckp_first] is not a whole-block advance from checkout_block_base [$ckp_derived_base]"
  fi
  return 0
}

# An EXPLICIT EMPTY root must FAIL, not fall back to the ambient PROJECT_ROOT:
# taking the root by argument exists precisely so a caller cannot get another
# checkout's block by accident. Run in a SUBSHELL — the guard is a fatal, which
# exits the shell it runs in.
test_checkout_derivations_refuse_an_empty_root() {
  if (checkout_block_base "" >/dev/null 2>&1); then
    fail_test "checkout_block_base accepted an empty checkout root"
  fi
  if (checkout_name "" >/dev/null 2>&1); then
    fail_test "checkout_name accepted an empty checkout root"
  fi
  return 0
}

# PostgreSQL truncates a `name` at 63 bytes and the per-worktree databases are
# `unicoach-{dev,test,fuzz}-<checkout name>` — the LONGEST prefix being the
# 14-byte `unicoach-test-` — so two checkouts agreeing in their first
# CHECKOUT_NAME_MAX_BYTES bytes would SHARE one database while cksum — which sees
# the whole name — gave them different port blocks. Nothing would fail to bind,
# and the documented remedy ("rename a worktree") does not apply because the
# names already differ. The derivation must refuse the input instead. Subshells
# again: the refusal is a fatal.
#
# The budget is DERIVED here, not restated. The prefixes are OWNED by the dotenv
# derivation lines (.env.test's `unicoach-test-`, .env.dev's `owner-`), so they are
# read from there: a hand-copied `unicoach-test-` would keep passing at 49 after
# someone lengthened the real prefix, and silent truncation — the data-loss bug
# RFC 174 corrected the constant for — would be back with nothing failing.
# POSTGRES_DB and POSTGRES_USER are the only keys that prepend a prefix to
# checkout_name, so the budget is 63 minus the LONGEST of them, the role prefix
# included: RFC 174 asserts that `owner-` is short enough never to bind, and this
# is the only thing that checks it. RFC 174 corrected the constant from 50 (which
# counted only the 13-byte `unicoach-dev-`) to 49.
test_checkout_name_budget_matches_the_longest_prefix() {
  local file key prefix longest="" expected
  # The dotenv line shape is parsed by ONE named extractor (bin/tests-common's
  # checkout_derivation_prefix), shared with the literal-name sweep below: a
  # second, differently-spelled parser for the same format is how one guard goes
  # on measuring while the other silently measures nothing.
  for file in .env.dev .env.test .env.fuzz; do
    for key in POSTGRES_DB POSTGRES_USER; do
      prefix="$(checkout_derivation_prefix "$PROJECT_ROOT/$file" "$key")"
      if [ "${#prefix}" -gt "${#longest}" ]; then longest="$prefix"; fi
    done
  done
  if [ -z "$longest" ]; then
    fail_test "found no <prefix>\$(checkout_name \"\$PROJECT_ROOT\") derivation in .env.dev/.env.test/.env.fuzz; the budget check would be vacuous"
  fi
  # The SAME constant bin/functions budgets against, not a second copy of 63: a
  # re-typed server limit is a second thing to keep in step, and the whole point
  # of naming it was that the arithmetic already shipped wrong once.
  expected=$(( POSTGRES_NAME_MAX_BYTES - ${#longest} ))
  if [ "$CHECKOUT_NAME_MAX_BYTES" -ne "$expected" ]; then
    fail_test "CHECKOUT_NAME_MAX_BYTES is [$CHECKOUT_NAME_MAX_BYTES]; PostgreSQL truncates at [$POSTGRES_NAME_MAX_BYTES] bytes and the longest derived prefix [$longest] is ${#longest} bytes, so it must be [$expected]"
  fi
  return 0
}

test_checkout_name_refuses_a_truncating_name() {
  local at_limit over_limit
  at_limit="$(printf 'a%.0s' $(seq 1 "$CHECKOUT_NAME_MAX_BYTES"))"
  over_limit="$at_limit"a
  if ! (checkout_name "/tmp/$at_limit" >/dev/null 2>&1); then
    fail_test "checkout_name rejected a name of exactly $CHECKOUT_NAME_MAX_BYTES bytes"
  fi
  if (checkout_name "/tmp/$over_limit" >/dev/null 2>&1); then
    fail_test "checkout_name accepted a ${#over_limit}-byte name, which PostgreSQL would truncate into another checkout's dev database"
  fi
  return 0
}

# The rule the dev half exists for: a listener on a DEV offset must NOT advance
# the block. This is the inverse of the +5 case above, and it is not cosmetic —
# once a dev rest-server holds +10, an unnarrowed free-check would send this
# checkout's own bin/test onto base+16, a block another checkout derives. The
# fixture is +10 (rest-server, dev), the offset a real dev daemon holds.
test_dev_half_listener_does_not_advance_checkout_port() {
  local listener base
  start_foreign_listener $((ckp_derived_base + 10)) \
    || fail_test "could not bind foreign listener on the dev offset $((ckp_derived_base + 10))"
  listener="$FOREIGN_LISTENER_PID"
  base="$(bin/checkout-port)" || {
    stop_foreign_listener "$listener"
    fail_test "checkout-port failed while a dev-half port was held"
  }
  stop_foreign_listener "$listener"
  if [ "$base" != "$ckp_first" ]; then
    fail_test "a listener on the dev offset $((ckp_derived_base + 10)) advanced checkout-port from $ckp_first to $base; the free-check must cover +0..+9 only"
  fi
  if ! wait_for_port_free $((ckp_derived_base + 10)); then
    fail_test "$((ckp_derived_base + 10)) not released after the dev-half no-advance case"
  fi
  return 0
}

# Two different checkout names must get DISJOINT dev port triples — the property
# that lets two worktrees run dev servers at once. Exercised end to end through
# fake checkout roots (directories of symlinks back into this one, so
# `basename $PROJECT_ROOT` is the only input that differs) and resolved in a
# CHILD sourcing bin/common, because the .env.dev layering only happens there.
test_two_checkouts_derive_disjoint_dev_port_triples() {
  local name_a ports_a name_b ports_b distinct
  CKP_FAKE_PARENT="$(mktemp -d)"
  find_two_differing_checkouts "unicoach-devporttest" resolve_dev_ports
  name_a="$FAKE_NAME_A"; ports_a="$FAKE_RESOLVED_A"
  name_b="$FAKE_NAME_B"; ports_b="$FAKE_RESOLVED_B"
  rm -rf "$CKP_FAKE_PARENT"
  if [ -z "$name_b" ]; then
    fail_test "could not find two checkout names with different derived dev ports"
  fi
  # Disjoint, not merely different: six ports, six distinct values.
  distinct="$(printf '%s\n' $ports_a $ports_b | sort -u | wc -l | tr -d ' ')"
  if [ "$distinct" -ne 6 ]; then
    fail_test "dev triples for [$name_a] ($ports_a) and [$name_b] ($ports_b) are not disjoint"
  fi
  return 0
}

# The .env:30 trap, and the reason .env.dev re-derives SERVER_PORT: the BASE
# layer assigns SERVER_PORT=$PORT before any delta is read, so a delta that
# overrode PORT alone would leave the JVM's rest-server.conf ${SERVER_PORT} on
# 8080 while the daemon bound base+10. Asserted in a CHILD — the layering only
# happens there — and against the registry's LITERAL +10, not against the
# constant .env.dev itself adds, which would make the check circular.
test_env_dev_derives_port_and_server_port_from_the_block() {
  local pair
  pair="$(env -u ENV_FILES -u ENV_FILE bash -c 'source bin/common; echo "$PORT $SERVER_PORT"')"
  if [ "$pair" != "$((ckp_derived_base + 10)) $((ckp_derived_base + 10))" ]; then
    fail_test "sourcing .env.dev resolved PORT/SERVER_PORT to [$pair], not the registry's dev offset [$((ckp_derived_base + 10)) $((ckp_derived_base + 10))]"
  fi
  return 0
}

# .env.template is the file a NEW env role is copied from, and NOTHING sources it
# at runtime — so its copy of the four per-worktree derivations can rot silently
# and hand whoever copies it a wrong port or a wrong database name. Compare the
# derivation lines themselves, not just the key names: the `:?` guard that makes
# the port fail closed is IN the value, so a template that kept the key and lost
# the guard would still fail open. sort -u because the template also restates
# SERVER_PORT in its base block.
test_env_template_restates_the_dev_derivations() {
  local pattern dev_derivations tpl_derivations
  pattern='^[A-Za-z_]+=.*(CHECKOUT_BLOCK_BASE|checkout_name)|^SERVER_PORT='
  dev_derivations="$(grep -E "$pattern" .env.dev | sort -u)"
  tpl_derivations="$(grep -E "$pattern" .env.template | sort -u)"
  if [ -z "$dev_derivations" ]; then
    fail_test "found no per-worktree derivations in .env.dev; the .env.template comparison would be vacuous"
  fi
  if [ "$dev_derivations" != "$tpl_derivations" ]; then
    diff <(echo "$dev_derivations") <(echo "$tpl_derivations") >&2 || true
    fail_test ".env.template's per-worktree derivations differ from .env.dev's."
  fi
  return 0
}

assert_success "checkout_block_base is deterministic and consistent with bin/checkout-port" test_checkout_block_base_is_the_pure_derivation
assert_success "checkout_block_base / checkout_name refuse an empty checkout root" test_checkout_derivations_refuse_an_empty_root
assert_success "CHECKOUT_NAME_MAX_BYTES is 63 minus the longest prefix the dotenvs derive with" test_checkout_name_budget_matches_the_longest_prefix
assert_success "checkout_name refuses a name PostgreSQL would truncate" test_checkout_name_refuses_a_truncating_name
assert_success "a listener on the dev half (+10) does not advance checkout-port" test_dev_half_listener_does_not_advance_checkout_port
assert_success "two different checkout names derive disjoint dev port triples" test_two_checkouts_derive_disjoint_dev_port_triples
assert_success "sourcing .env.dev yields SERVER_PORT == PORT == checkout_block_base + 10" test_env_dev_derives_port_and_server_port_from_the_block
# DEV-ONLY KEYS, table-driven: each belongs in .env.dev AND in .env.template's
# .env.dev block with the SAME value, and in NEITHER the base .env (the value is
# env-specific) nor a cloud .env.<env>. Nothing sources .env.template at runtime,
# so without this its copies rot in silence — a template that lost a key hands
# whoever copies it a broken environment. A list rather than one copy of the same
# four assertions per key: POSTGRES_SUPERUSER got the template copy and NOT the
# test, which is exactly the omission this shape removes.
#
#   POSTGRES_DUMP_DIR  -- bin/db-dump's artifact directory and bin/db-restore's
#                         no-argument default; a shared absolute $HOME path, like
#                         POSTGRES_DATA_DIR beside it.
#   POSTGRES_SUPERUSER -- the cluster admin (RFC 174). Every reader spells it
#                         ${POSTGRES_SUPERUSER:-$POSTGRES_USER} (bin/functions'
#                         cluster_superuser), so a base-.env copy would stop a
#                         cloud env collapsing onto its RDS master — and the
#                         instance would grow an owner-<release-dir> role.
DEV_ONLY_KEYS=(POSTGRES_DUMP_DIR POSTGRES_SUPERUSER)
# The two files a dev-only key MAY live in, named positively, with every OTHER
# dotenv in the repo root swept. Checking only the base `.env` left `.env.prod`
# and `.env.deploy.prod` -- the exact files that would stop a cloud environment
# collapsing onto its RDS master -- free to set POSTGRES_SUPERUSER, which is the
# "the instance grows an owner-<release-dir> role" case the comment above warns
# about.
DEV_ONLY_KEY_FILES=(.env.dev .env.template)
test_dev_only_keys_are_set_in_dev_and_template() {
  local key dev_line tpl_line env_file
  for key in "${DEV_ONLY_KEYS[@]}"; do
    dev_line="$(grep -E "^$key=" .env.dev | sort -u)"
    tpl_line="$(grep -E "^$key=" .env.template | sort -u)"
    if [ -z "$dev_line" ]; then
      fail_test ".env.dev does not set $key"
    fi
    if [ -z "$tpl_line" ]; then
      fail_test ".env.template does not set $key"
    fi
    if [ "$dev_line" != "$tpl_line" ]; then
      fail_test ".env.template's $key [$tpl_line] differs from .env.dev's [$dev_line]"
    fi
    for env_file in "$PROJECT_ROOT"/.env*; do
      list_contains "$(basename "$env_file")" "${DEV_ONLY_KEY_FILES[@]}" && continue
      if grep -qE "^$key=" "$env_file"; then
        fail_test "$(basename "$env_file") sets $key; it is a dev-only key, owned by .env.dev and .env.template alone"
      fi
    done
  done
  return 0
}

assert_success ".env.template restates .env.dev's per-worktree derivations exactly" test_env_template_restates_the_dev_derivations
assert_success ".env.dev and .env.template agree on every dev-only key (and .env sets none)" test_dev_only_keys_are_set_in_dev_and_template

# RFC 131 regression, and it MUST cross a process boundary: `.env` assigns PORT
# unconditionally, so a PORT exported by this harness is clobbered in every child
# — which is the process that actually binds the socket. An in-process check of
# $PORT passes even with the bug. Assert that a CHILD sourcing bin/common lands
# on the harness's BASE_TEST_PORT.
child_port="$(bash -c 'source bin/common; echo $PORT')"
if [ "$child_port" != "$BASE_TEST_PORT" ]; then
  echo "Fail: a child sourcing bin/common resolved PORT to [$child_port], not the harness BASE_TEST_PORT [$BASE_TEST_PORT]"
  exit 1
fi
pass_test "a child sourcing bin/common resolves PORT to the harness BASE_TEST_PORT"

# Every port-binding service lands in the block, and the test and fuzz halves
# never share one (RFC 132 defect 2): before this, .env.test and .env.fuzz
# overrode only PORT, so admin-web and public-web bound the DEV 8081/8082 under
# both layerings — the developer's own ports, and identical across the two
# harnesses. Resolved in CHILDREN, because the layering only happens there.
ckp_test_ports="$(ENV_FILES=".env.dev:.env.test" bash -c 'source bin/common; echo "$PORT $ADMIN_WEB_PORT $PUBLIC_WEB_PORT"')"
ckp_fuzz_ports="$(ENV_FILES=".env.dev:.env.fuzz" bash -c 'source bin/common; echo "$PORT $ADMIN_WEB_PORT $PUBLIC_WEB_PORT"')"
read -r ckp_t0 ckp_t1 ckp_t2 <<< "$ckp_test_ports"
read -r ckp_f7 ckp_f8 ckp_f9 <<< "$ckp_fuzz_ports"
# The offset registry in bin/checkout-port's help text is the authority.
ckp_expected="$BASE_TEST_PORT $((BASE_TEST_PORT + 1)) $((BASE_TEST_PORT + 2)) $((BASE_TEST_PORT + 7)) $((BASE_TEST_PORT + 8)) $((BASE_TEST_PORT + 9))"
ckp_actual="$ckp_t0 $ckp_t1 $ckp_t2 $ckp_f7 $ckp_f8 $ckp_f9"
if [ "$ckp_actual" != "$ckp_expected" ]; then
  echo "Fail: service ports resolved to [$ckp_actual], not the registry's [$ckp_expected] (test PORT/ADMIN_WEB_PORT/PUBLIC_WEB_PORT then fuzz)"
  exit 1
fi
# Distinct and in-block, asserted independently of the offsets above: six ports,
# six values, all inside this checkout's 16-port block.
ckp_distinct="$(printf '%s\n' $ckp_actual | sort -u | wc -l | tr -d ' ')"
if [ "$ckp_distinct" -ne 6 ]; then echo "Fail: the six service ports are not distinct: [$ckp_actual]"; exit 1; fi
for ckp_port in $ckp_actual; do
  if [ "$ckp_port" -lt "$BASE_TEST_PORT" ] || [ "$ckp_port" -gt $((BASE_TEST_PORT + 15)) ]; then
    echo "Fail: service port $ckp_port is outside this checkout's block $BASE_TEST_PORT..$((BASE_TEST_PORT + 15)): [$ckp_actual]"
    exit 1
  fi
done
pass_test "all three service ports resolve inside the block under both test and fuzz layering, six distinct values"

# The fuzz harness no longer scans for a port (RFC 132 defect 3): find-free-port's
# default scan base is 18000, exactly the floor of checkout-port's range, so a
# fuzz run could be handed a port inside some checkout's derived block.
# Comment lines are stripped first: the prose still names find-free-port when it
# explains why the TOCTOU guard survived it; what must be gone is the CALL.
if grep -v '^[[:space:]]*#' bin/test-fuzz | grep -q 'find-free-port'; then echo "Fail: bin/test-fuzz still calls find-free-port"; exit 1; fi
pass_test "bin/test-fuzz claims no port by scanning"

echo ""
echo "==== Testing daemon-up port preflight ===="
# Cross-process collision regression (the reported bug; also covers the
# PID-file-lost / orphaned-alive edge case — indistinguishable from here).
rm -f "$PROJECT_ROOT/var/run/collision-test.pid"
rm -rf "$PROJECT_ROOT/var/run/collision-test.daemon.lock"
start_foreign_listener "$PORT_FREE" || { echo "Fail: could not bind foreign listener on $PORT_FREE"; exit 1; }
coll_listener="$FOREIGN_LISTENER_PID"
up_status=0
# Unique sentinel arg so this daemon command cannot be confused with the
# other `sleep 60` daemons elsewhere in the suite.
bin/daemon-up -p "$PORT_FREE" collision-test -- sleep "$SLEEP_SENTINEL_COLLISION" >/dev/null 2>&1 || up_status=$?
if [ "$up_status" -ne 3 ]; then echo "Fail: daemon-up on a held port did not exit 3 (got $up_status)"; pkill -f "sleep $SLEEP_SENTINEL_COLLISION" 2>/dev/null; stop_foreign_listener "$coll_listener"; exit 1; fi
if [ -f "$PROJECT_ROOT/var/run/collision-test.pid" ]; then echo "Fail: daemon-up wrote a PID file despite the collision"; pkill -f "sleep $SLEEP_SENTINEL_COLLISION" 2>/dev/null; stop_foreign_listener "$coll_listener"; exit 1; fi
if [ -d "$PROJECT_ROOT/var/run/collision-test.daemon.lock" ]; then echo "Fail: daemon-up left the lock directory after a collision"; pkill -f "sleep $SLEEP_SENTINEL_COLLISION" 2>/dev/null; stop_foreign_listener "$coll_listener"; exit 1; fi
if pgrep -f "sleep $SLEEP_SENTINEL_COLLISION" >/dev/null 2>&1; then echo "Fail: daemon-up spawned a child despite the collision"; pkill -f "sleep $SLEEP_SENTINEL_COLLISION" 2>/dev/null; stop_foreign_listener "$coll_listener"; exit 1; fi
# Defensive reap: if a future regression DID spawn, do not leak it.
pkill -f "sleep $SLEEP_SENTINEL_COLLISION" 2>/dev/null || true
stop_foreign_listener "$coll_listener"
pass_test "daemon-up fatals (exit 3) on cross-process port collision without spawning or writing a PID"

# Idempotency preserved with -p (free port).
rm -f "$PROJECT_ROOT/var/run/idem-test.pid"
rm -rf "$PROJECT_ROOT/var/run/idem-test.daemon.lock"
bin/daemon-up -p "$PORT_IDEM" idem-test -- sleep 60 >/dev/null 2>&1
if [ ! -f "$PROJECT_ROOT/var/run/idem-test.pid" ]; then echo "Fail: daemon-up did not write a PID on a free port"; exit 1; fi
idem_first="$(cat "$PROJECT_ROOT/var/run/idem-test.pid")"
if ! bin/check-pid "$idem_first" >/dev/null 2>&1; then echo "Fail: idem-test PID is not alive after up"; exit 1; fi
bin/daemon-up -p "$PORT_IDEM" idem-test -- sleep 60 >/dev/null 2>&1
idem_second="$(cat "$PROJECT_ROOT/var/run/idem-test.pid")"
if [ "$idem_first" != "$idem_second" ]; then echo "Fail: idempotent up spawned a duplicate (PIDs $idem_first vs $idem_second)"; bin/daemon-down idem-test >/dev/null 2>&1; exit 1; fi
pass_test "daemon-up -p idempotent: second up reuses the same live PID"

# Concurrent-up exit-0 contract with -p: two racers, exactly one process.
bin/daemon-down idem-test >/dev/null 2>&1 || true
rm -f "$PROJECT_ROOT/var/run/idem-test.pid"
rm -rf "$PROJECT_ROOT/var/run/idem-test.daemon.lock"
bin/daemon-up -p "$PORT_IDEM" idem-test -- sleep 60 >/dev/null 2>&1 & cu1=$!
bin/daemon-up -p "$PORT_IDEM" idem-test -- sleep 60 >/dev/null 2>&1 & cu2=$!
cu1_status=0; wait $cu1 || cu1_status=$?
cu2_status=0; wait $cu2 || cu2_status=$?
if [ "$cu1_status" -ne 0 ] || [ "$cu2_status" -ne 0 ]; then echo "Fail: concurrent -p up did not both exit 0 ($cu1_status / $cu2_status)"; bin/daemon-down idem-test >/dev/null 2>&1; exit 1; fi
conc_pid="$(cat "$PROJECT_ROOT/var/run/idem-test.pid")"
if ! bin/check-pid "$conc_pid" >/dev/null 2>&1; then echo "Fail: concurrent -p up did not leave a live process"; exit 1; fi
pass_test "daemon-up -p concurrent up: both exit 0, exactly one process"

echo ""
echo "==== Testing daemon-check tri-state ===="
# Running (our PID is alive) ⇒ 0.
dc_status=0; bin/daemon-check -p "$PORT_IDEM" idem-test >/dev/null 2>&1 || dc_status=$?
if [ "$dc_status" -ne 0 ]; then echo "Fail: daemon-check on a running service did not exit 0 (got $dc_status)"; bin/daemon-down idem-test >/dev/null 2>&1; exit 1; fi
pass_test "daemon-check -p exits 0 when our PID is alive"

bin/daemon-down idem-test >/dev/null 2>&1 || true
rm -f "$PROJECT_ROOT/var/run/idem-test.pid"
# Stopped + port free ⇒ 1.
if bin/check-port "$PORT_IDEM" >/dev/null 2>&1; then echo "Fail: precondition — $PORT_IDEM must be free after down"; exit 1; fi
dc_status=0; bin/daemon-check -p "$PORT_IDEM" idem-test >/dev/null 2>&1 || dc_status=$?
if [ "$dc_status" -ne 1 ]; then echo "Fail: daemon-check stopped+free did not exit 1 (got $dc_status)"; exit 1; fi
pass_test "daemon-check -p exits 1 when stopped and port is free"

# Stopped + foreign listener ⇒ 2.
start_foreign_listener "$PORT_IDEM" || { echo "Fail: could not bind foreign listener on $PORT_IDEM"; exit 1; }
dc_listener="$FOREIGN_LISTENER_PID"
dc_status=0; bin/daemon-check -p "$PORT_IDEM" idem-test >/dev/null 2>&1 || dc_status=$?
if [ "$dc_status" -ne 2 ]; then echo "Fail: daemon-check stopped+held did not exit 2 (got $dc_status)"; stop_foreign_listener "$dc_listener"; exit 1; fi
pass_test "daemon-check -p exits 2 (conflict) when stopped and port is foreign-held"

# -p-less backward compatibility: stopped+held ⇒ still 1, never 2.
dc_status=0; bin/daemon-check idem-test >/dev/null 2>&1 || dc_status=$?
if [ "$dc_status" -ne 1 ]; then echo "Fail: daemon-check without -p did not exit 1 on a held port (got $dc_status)"; stop_foreign_listener "$dc_listener"; exit 1; fi
pass_test "daemon-check without -p exits 1 even when port is held (backward compatible)"
stop_foreign_listener "$dc_listener"

echo ""
echo "==== Testing -p intake validation (no silent portless degrade) ===="
# An empty -p value must be a usage error, never a silent fall-through to the
# unsafe portless path. daemon-check and daemon-up both reject it at the parse site.
# A malformed -p value is a usage error in the reserved band:
# EXIT_INVALID_ARG_VALUE (22), never a silent fall-through to the unsafe portless
# path. daemon-check and daemon-up both reject it at the parse site.
dc_status=0; bin/daemon-check -p "" idem-test >/dev/null 2>&1 || dc_status=$?
if [ "$dc_status" -ne "$EXIT_INVALID_ARG_VALUE" ]; then echo "Fail: daemon-check -p '' did not reject empty value with $EXIT_INVALID_ARG_VALUE (got $dc_status)"; exit 1; fi
pass_test "daemon-check rejects an empty -p value"

du_status=0; bin/daemon-up -p "" idem-test -- sleep 60 >/dev/null 2>&1 || du_status=$?
if [ "$du_status" -ne "$EXIT_INVALID_ARG_VALUE" ]; then echo "Fail: daemon-up -p '' did not reject empty value with $EXIT_INVALID_ARG_VALUE (got $du_status)"; exit 1; fi
if [ -f "$PROJECT_ROOT/var/run/idem-test.pid" ]; then echo "Fail: daemon-up -p '' wrote a PID file"; bin/daemon-down idem-test >/dev/null 2>&1; exit 1; fi
pass_test "daemon-up rejects an empty -p value without spawning"

# -k requires -p: reclaim modifies the port preflight, which never runs portless,
# so -k without -p is a usage error (21) rejected before any spawn.
duk_status=0; bin/daemon-up -k idem-test -- sleep 60 >/dev/null 2>&1 || duk_status=$?
if [ "$duk_status" -ne "$EXIT_MISSING_REQUIRED_ARG" ]; then echo "Fail: daemon-up -k without -p did not reject with $EXIT_MISSING_REQUIRED_ARG (got $duk_status)"; bin/daemon-down idem-test >/dev/null 2>&1; exit 1; fi
if [ -f "$PROJECT_ROOT/var/run/idem-test.pid" ]; then echo "Fail: daemon-up -k without -p wrote a PID file"; bin/daemon-down idem-test >/dev/null 2>&1; exit 1; fi
pass_test "daemon-up -k without -p is rejected without spawning"

# -9 goes through the same require-a-port guard as -k.
du9_status=0; bin/daemon-up -9 idem-test -- sleep 60 >/dev/null 2>&1 || du9_status=$?
if [ "$du9_status" -ne "$EXIT_MISSING_REQUIRED_ARG" ]; then echo "Fail: daemon-up -9 without -p did not reject with $EXIT_MISSING_REQUIRED_ARG (got $du9_status)"; bin/daemon-down idem-test >/dev/null 2>&1; exit 1; fi
pass_test "daemon-up -9 without -p is rejected without spawning"

echo ""
echo "==== Testing list-listening-pids and is-port-free ===="
# Free port: list-listening-pids prints nothing at exit 0 (lsof's non-zero "no
# match" is swallowed); is-port-free exits 0.
llp_out="$(bin/list-listening-pids "$PORT_KILL")"; llp_rc=$?
if [ "$llp_rc" -ne 0 ] || [ -n "$llp_out" ]; then echo "Fail: list-listening-pids on a free port did not print nothing at exit 0 (rc=$llp_rc, out=[$llp_out])"; exit 1; fi
pass_test "list-listening-pids prints nothing (exit 0) for a free port"
assert_success "is-port-free exits 0 for a free port" bin/is-port-free "$PORT_KILL"

# Bound port: list-listening-pids reports the owning PID on its own line;
# is-port-free exits 1.
start_foreign_listener "$PORT_KILL" || { echo "Fail: could not bind foreign listener on $PORT_KILL"; exit 1; }
llp_listener="$FOREIGN_LISTENER_PID"
llp_out="$(bin/list-listening-pids "$PORT_KILL")"
if ! echo "$llp_out" | grep -qx "$llp_listener"; then echo "Fail: list-listening-pids did not report the listener PID $llp_listener (got [$llp_out])"; stop_foreign_listener "$llp_listener"; exit 1; fi
pf_status=0; bin/is-port-free "$PORT_KILL" >/dev/null 2>&1 || pf_status=$?
if [ "$pf_status" -ne 1 ]; then echo "Fail: is-port-free did not exit 1 for a bound port (got $pf_status)"; stop_foreign_listener "$llp_listener"; exit 1; fi
stop_foreign_listener "$llp_listener"
pass_test "list-listening-pids reports the bound port's PID; is-port-free exits 1 while bound"

echo ""
echo "==== Testing daemon-up -k port reclaim ===="
# -k reclaims the port: SIGTERM to the listener frees it, the boot proceeds, and
# the old listener is gone while the new daemon is recorded and alive.
rm -f "$PROJECT_ROOT/var/run/reclaim-test.pid"
rm -rf "$PROJECT_ROOT/var/run/reclaim-test.daemon.lock"
start_foreign_listener "$PORT_KILL" || { echo "Fail: could not bind foreign listener on $PORT_KILL"; exit 1; }
rk_listener="$FOREIGN_LISTENER_PID"
up_status=0
bin/daemon-up -k -p "$PORT_KILL" reclaim-test -- sleep "$SLEEP_SENTINEL_RECLAIM" >/dev/null 2>&1 || up_status=$?
if [ "$up_status" -ne 0 ]; then echo "Fail: daemon-up -k did not reclaim the port and boot (exit $up_status)"; pkill -f "sleep $SLEEP_SENTINEL_RECLAIM" 2>/dev/null; stop_foreign_listener "$rk_listener"; exit 1; fi
if bin/check-pid "$rk_listener" >/dev/null 2>&1; then echo "Fail: daemon-up -k left the listener (PID $rk_listener) alive"; pkill -f "sleep $SLEEP_SENTINEL_RECLAIM" 2>/dev/null; bin/daemon-down reclaim-test >/dev/null 2>&1; stop_foreign_listener "$rk_listener"; exit 1; fi
rk_pid="$(cat "$PROJECT_ROOT/var/run/reclaim-test.pid" 2>/dev/null || true)"
if [ -z "$rk_pid" ] || ! bin/check-pid "$rk_pid" >/dev/null 2>&1; then echo "Fail: daemon-up -k did not spawn/record a live daemon (pid=[$rk_pid])"; pkill -f "sleep $SLEEP_SENTINEL_RECLAIM" 2>/dev/null; stop_foreign_listener "$rk_listener"; exit 1; fi
bin/daemon-down reclaim-test >/dev/null 2>&1 || true
pkill -f "sleep $SLEEP_SENTINEL_RECLAIM" 2>/dev/null || true
stop_foreign_listener "$rk_listener"
pass_test "daemon-up -k reclaims the port listener (SIGTERM) and boots"

# -9 escalates to SIGKILL: a listener that ignores SIGTERM is untouched by -k
# but reclaimed by -9 (SIGKILL cannot be trapped), so the boot proceeds.
start_term_ignoring_listener "$PORT_KILL" || { echo "Fail: could not bind SIGTERM-ignoring listener on $PORT_KILL"; exit 1; }
k9_listener="$FOREIGN_LISTENER_PID"
rm -f "$PROJECT_ROOT/var/run/reclaim-test.pid"
rm -rf "$PROJECT_ROOT/var/run/reclaim-test.daemon.lock"
up_status=0
bin/daemon-up -9 -p "$PORT_KILL" reclaim-test -- sleep "$SLEEP_SENTINEL_KILL9" >/dev/null 2>&1 || up_status=$?
if [ "$up_status" -ne 0 ]; then echo "Fail: daemon-up -9 did not reclaim a SIGTERM-ignoring listener (exit $up_status)"; pkill -f "sleep $SLEEP_SENTINEL_KILL9" 2>/dev/null; bin/daemon-down reclaim-test >/dev/null 2>&1; stop_foreign_listener "$k9_listener"; exit 1; fi
if bin/check-pid "$k9_listener" >/dev/null 2>&1; then echo "Fail: daemon-up -9 left the SIGTERM-ignoring listener (PID $k9_listener) alive"; pkill -f "sleep $SLEEP_SENTINEL_KILL9" 2>/dev/null; bin/daemon-down reclaim-test >/dev/null 2>&1; stop_foreign_listener "$k9_listener"; exit 1; fi
bin/daemon-down reclaim-test >/dev/null 2>&1 || true
pkill -f "sleep $SLEEP_SENTINEL_KILL9" 2>/dev/null || true
stop_foreign_listener "$k9_listener"
pass_test "daemon-up -9 (SIGKILL) reclaims a listener that ignores SIGTERM"

# A non-numeric / out-of-range -p must be rejected before any port check, in
# daemon-check too (matching daemon-up's existing validation).
dc_status=0; bin/daemon-check -p notaport idem-test >/dev/null 2>&1 || dc_status=$?
if [ "$dc_status" -ne "$EXIT_INVALID_ARG_VALUE" ]; then echo "Fail: daemon-check -p notaport did not reject non-numeric value with $EXIT_INVALID_ARG_VALUE (got $dc_status)"; exit 1; fi
dc_status=0; bin/daemon-check -p 99999 idem-test >/dev/null 2>&1 || dc_status=$?
if [ "$dc_status" -ne "$EXIT_INVALID_ARG_VALUE" ]; then echo "Fail: daemon-check -p 99999 did not reject out-of-range value with $EXIT_INVALID_ARG_VALUE (got $dc_status)"; exit 1; fi
pass_test "daemon-check rejects a non-numeric / out-of-range -p value"

echo ""
echo "==== Testing daemon-http-check ===="
# Not running: nothing bound, curl fails, port free ⇒ exit 1.
dh_status=0; bin/daemon-http-check svc "$PORT_HTTP" "http://localhost:$PORT_HTTP/healthz" >/dev/null 2>&1 || dh_status=$?
if [ "$dh_status" -ne 1 ]; then echo "Fail: daemon-http-check on a free port did not exit 1 (got $dh_status)"; exit 1; fi
pass_test "daemon-http-check exits 1 when nothing is bound (not running)"

# Port held / unhealthy: a raw foreign listener ⇒ curl -sf fails, port in use ⇒ exit 2.
start_foreign_listener "$PORT_HTTP" || { echo "Fail: could not bind foreign listener on $PORT_HTTP"; exit 1; }
dh_listener="$FOREIGN_LISTENER_PID"
dh_status=0; dh_out="$(bin/daemon-http-check svc "$PORT_HTTP" "http://localhost:$PORT_HTTP/healthz" 2>&1)" || dh_status=$?
if [ "$dh_status" -ne 2 ]; then echo "Fail: daemon-http-check with a foreign-held port did not exit 2 (got $dh_status)"; stop_foreign_listener "$dh_listener"; exit 1; fi
if ! echo "$dh_out" | grep -qF "bound but not responding as [svc]"; then echo "Fail: daemon-http-check did not log the 'bound but not responding as [svc]' message"; echo "$dh_out"; stop_foreign_listener "$dh_listener"; exit 1; fi
stop_foreign_listener "$dh_listener"
pass_test "daemon-http-check exits 2 and reports 'bound but not responding as [svc]' when foreign-held"

# A foreign listener that ANSWERS /healthz. curl alone cannot distinguish it from
# our own daemon, so without the ownership gate this reports 0 (running) while
# the service is stopped -- the false positive that failed a pre-commit gate from
# a rest-server left running in a different worktree.
dh_listener=""
# The previous case just killed a listener on this port; bind only once the
# kernel has actually released it, or this fixture silently fails to bind and
# the probe measures the corpse of the last one.
if ! wait_for_port_free "$PORT_HTTP"; then echo "Fail: port $PORT_HTTP not released before the healthy-foreign case"; exit 1; fi
start_healthy_foreign_listener "$PORT_HTTP" || { echo "Fail: could not bind healthy foreign listener on $PORT_HTTP"; exit 1; }
dh_listener="$FOREIGN_LISTENER_PID"
dh_status=0; dh_out="$(bin/daemon-http-check svc "$PORT_HTTP" "http://localhost:$PORT_HTTP/healthz" 2>&1)" || dh_status=$?
if [ "$dh_status" -ne 2 ]; then echo "Fail: daemon-http-check trusted a HEALTHY foreign daemon as ours (expected 2, got $dh_status)"; echo "$dh_out"; stop_foreign_listener "$dh_listener"; exit 1; fi
if ! echo "$dh_out" | grep -qF "not from this checkout"; then echo "Fail: daemon-http-check did not explain that the responder is not ours"; echo "$dh_out"; stop_foreign_listener "$dh_listener"; exit 1; fi
stop_foreign_listener "$dh_listener"
pass_test "daemon-http-check exits 2 when a HEALTHY foreign daemon answers on the port (ownership gate)"
stop_foreign_listener "$dh_listener"

# Usage errors route to the reserved band, disjoint from the 0/1/2 operational
# tri-state: too few arguments is EXIT_MISSING_REQUIRED_ARG (21), a non-numeric
# port is EXIT_INVALID_ARG_VALUE (22).
dh_status=0; bin/daemon-http-check svc >/dev/null 2>&1 || dh_status=$?
if [ "$dh_status" -ne "$EXIT_MISSING_REQUIRED_ARG" ]; then echo "Fail: daemon-http-check with too few args did not exit $EXIT_MISSING_REQUIRED_ARG (got $dh_status)"; exit 1; fi
dh_status=0; bin/daemon-http-check svc notaport http://localhost/healthz >/dev/null 2>&1 || dh_status=$?
if [ "$dh_status" -ne "$EXIT_INVALID_ARG_VALUE" ]; then echo "Fail: daemon-http-check with a non-numeric port did not exit $EXIT_INVALID_ARG_VALUE (got $dh_status)"; exit 1; fi
pass_test "daemon-http-check rejects invalid args with band codes (21 / 22), disjoint from the 2 conflict state"

# Bounded probe (regression): a listener that accepts but never replies must NOT
# hang the probe. Without curl's --max-time the probe blocks forever; `timeout`
# guards the whole call so a regression FAILS loudly (exit 124) instead of
# wedging the suite. The bounded probe gives up (~3s) and check-port then reports
# the port in use ⇒ exit 2, well within the timeout guard.
start_stalled_listener "$PORT_HTTP" || { echo "Fail: could not bind stalled listener on $PORT_HTTP"; exit 1; }
dh_listener="$FOREIGN_LISTENER_PID"
dh_status=0; timeout "$BOUNDED_PROBE_GUARD_SECS" bin/daemon-http-check svc "$PORT_HTTP" "http://localhost:$PORT_HTTP/healthz" >/dev/null 2>&1 || dh_status=$?
stop_foreign_listener "$dh_listener"
if [ "$dh_status" -eq 124 ]; then echo "Fail: daemon-http-check hung on an accept-but-never-reply listener (probe is not bounded)"; exit 1; fi
if [ "$dh_status" -ne 2 ]; then echo "Fail: daemon-http-check on a stalled listener did not exit 2 (got $dh_status)"; exit 1; fi
pass_test "daemon-http-check returns (exit 2) within the bound against an accept-but-never-reply listener"

echo ""
echo "==== Testing rest-server-check failure-path hardening ===="
# Precondition: rest-server is down (PID file absent).
bin/rest-server-down >/dev/null 2>&1 || true
if [ -f "$PROJECT_ROOT/var/run/rest-server.pid" ]; then echo "Fail: precondition — rest-server PID file must be absent"; exit 1; fi
REST_PORT="${PORT:-8080}"
# Nothing on the port ⇒ exit 1.
if ! wait_for_port_free "$REST_PORT"; then echo "Fail: precondition — rest-server port $REST_PORT must be free"; exit 1; fi
rc_status=0; bin/rest-server-check >/dev/null 2>&1 || rc_status=$?
if [ "$rc_status" -ne 1 ]; then echo "Fail: rest-server-check with a free port did not exit 1 (got $rc_status)"; exit 1; fi
pass_test "rest-server-check exits 1 when its port is free and the daemon is down"

# Foreign listener on its port ⇒ exit 2 with the held-by-another-process message.
start_foreign_listener "$REST_PORT" || { echo "Fail: could not bind foreign listener on $REST_PORT"; exit 1; }
rc_listener="$FOREIGN_LISTENER_PID"
rc_status=0; rc_out="$(bin/rest-server-check 2>&1)" || rc_status=$?
if [ "$rc_status" -ne 2 ]; then echo "Fail: rest-server-check with a foreign-held port did not exit 2 (got $rc_status)"; stop_foreign_listener "$rc_listener"; exit 1; fi
if ! echo "$rc_out" | grep -qF "bound but not responding as [rest-server]"; then echo "Fail: rest-server-check did not log the truthful 'bound but not responding' message"; echo "$rc_out"; stop_foreign_listener "$rc_listener"; exit 1; fi
if ! echo "$rc_out" | grep -q "held by another process or an unhealthy instance"; then echo "Fail: rest-server-check did not log the 'held by another process or an unhealthy instance' qualifier"; echo "$rc_out"; stop_foreign_listener "$rc_listener"; exit 1; fi
pass_test "rest-server-check exits 2 and reports the port is bound but not responding when foreign-held"
stop_foreign_listener "$rc_listener"

echo ""
echo "==== Testing option parsing ===="

# 1. Unknown option rejected, exit code preserved.
assert_failure "check-pid -x is rejected" bin/check-pid -x
assert_failure "daemon-down -x svc is rejected" bin/daemon-down -x svc
# db-status -x confirms the *) break tightening: an unknown leading option is now
# rejected, not treated as a positional.
assert_failure "db-status -x is rejected (no silent positional fall-through)" bin/db-status -x

# 2. Missing option-argument rejected.
assert_failure "daemon-down -t (no value) is rejected" bin/daemon-down -t
assert_failure "file-lock -o (no value) is rejected" bin/file-lock -o
assert_failure "wait-for -p (no value) is rejected" bin/wait-for -p

# 3. Value option accepted: db-status -f parses (existing format behavior). With
#    no schema dir change the command still runs; a parse failure would exit
#    non-zero before any DB work.
test_db_status_f_parses() {
  bin/db-status -f applied-only >/dev/null 2>&1
  # exit status reflects the db-status run, not a parse error; any non-2 (usage)
  # outcome means the -f value was accepted. Treat both 0 and a DB error as
  # "parsed". A usage error from a bad parse would have printed the help banner.
  local rc=$?
  [ "$rc" -ne 2 ]
}
assert_success "db-status -f value option is accepted (parses)" test_db_status_f_parses

# 4. Clustering and the -q guard. is-nix -qv is accepted (exits per the
#    unicoach-dev-shell predicate — UNICOACH_DEV_SHELL, set by this repo's
#    flake.nix — not a parse error). is-nix -q is the exact form bin/pre-commit's
#    nix-guard uses; inside the unicoach dev shell it exits 0.
test_is_nix_qv_no_parse_error() {
  bin/is-nix -qv >/dev/null 2>&1
  # 0 = in the unicoach dev shell, 1 = not; both are valid predicate outcomes. A parse error
  # would route through fatal (also exit 1) but print a [FATAL] message — assert
  # the absence of that message instead.
  ! bin/is-nix -qv 2>&1 | grep -q '\[FATAL\]'
}
assert_success "is-nix -qv clusters without a parse error" test_is_nix_qv_no_parse_error
test_is_nix_q_in_shell() {
  # This harness runs inside the unicoach dev shell, so the nix guard must
  # succeed (exit 0) — the exact predicate bin/pre-commit relies on.
  bin/is-nix -q
}
assert_success "is-nix -q exits 0 inside the dev shell (pre-commit nix-guard)" test_is_nix_q_in_shell

# 5. -h exits 0.
assert_success "file-lock -h exits 0" bin/file-lock -h
assert_success "wait-for -h exits 0" bin/wait-for -h

# 6. fatal option parsing (the harness already sources bin/functions).
test_fatal_status_code() { ( fatal -s 7 "x" ); [ "$?" -eq 7 ]; }
assert_success "fatal -s 7 exits 7" test_fatal_status_code
test_fatal_default_code() { ( fatal "x" ); [ "$?" -eq 1 ]; }
assert_success "fatal with no -s exits 1" test_fatal_default_code
test_fatal_message_survives_shift() {
  local out rc
  out="$( (fatal -s 7 "a b c") 2>&1 )"; rc=$?
  [ "$rc" -eq 7 ] && echo "$out" | grep -qF "a b c"
}
assert_success "fatal -s 7 'a b c' exits 7 and prints the full message" test_fatal_message_survives_shift

# 7. daemon-up -- passthrough still boots a flag-carrying command. The command
#    after -- (bash -c '...') carries its own options; getopts must not consume
#    -- or those flags.
test_daemon_up_passthrough() {
  bin/daemon-down passthru-test >/dev/null 2>&1 || true
  bin/daemon-up passthru-test -- bash -c 'sleep 60' >/dev/null 2>&1 || return 1
  local pid
  pid="$(cat "$PROJECT_ROOT/var/run/passthru-test.pid" 2>/dev/null || true)"
  [ -n "$pid" ] || return 1
  bin/check-pid "$pid" >/dev/null 2>&1 || return 1
  bin/daemon-down passthru-test >/dev/null 2>&1
  return 0
}
assert_success "daemon-up -- passthrough boots a flag-carrying command (getopts keeps --)" test_daemon_up_passthrough

# 8. bin/test option/positional permutation. Real invocations, each driven to a
#    deterministic terminal outcome by the parser's pre-Gradle validation, so no
#    Gradle task runs and the suite never recursively re-invokes itself.
assert_failure "bin/test bogus-module is rejected (unknown module)" bin/test bogus-module
assert_failure "bin/test -z is rejected (unknown option)" bin/test -z
test_bin_test_permutation_trailing() {
  local out
  out="$( (bin/test rest-server -t 'ed.unicoach.X' queue-worker) 2>&1 )"
  echo "$out" | grep -qF "requires exactly one module"
}
assert_success "bin/test permutation: trailing -t is parsed (two modules => --tests error)" test_bin_test_permutation_trailing
test_bin_test_permutation_leading() {
  local out
  out="$( (bin/test -t 'ed.unicoach.X' rest-server queue-worker) 2>&1 )"
  echo "$out" | grep -qF "requires exactly one module"
}
assert_success "bin/test permutation: option-first yields the identical error (position-independent)" test_bin_test_permutation_leading

# 9. -p daemon scripts: missing value and unknown option.
assert_failure "daemon-check -p (missing value) is rejected" bin/daemon-check -p
assert_failure "daemon-up -p (missing value) is rejected" bin/daemon-up -p
assert_failure "daemon-check -x svc is rejected" bin/daemon-check -x svc

# 10. find-free-port and checkout-port.
assert_success "find-free-port -h exits 0" bin/find-free-port -h
assert_failure "find-free-port -x is rejected" bin/find-free-port -x
assert_failure "find-free-port 18000 19000 (too many args) is rejected" bin/find-free-port 18000 19000
assert_success "checkout-port -h exits 0" bin/checkout-port -h
assert_failure "checkout-port -x is rejected" bin/checkout-port -x
assert_failure "checkout-port 18000 (unexpected arg) is rejected" bin/checkout-port 18000

# 12. db-reset still drops after the db-drop -y collapse: the relayed -y bypasses
#     the confirmation prompt non-interactively.
test_db_reset_drops() { bin/db-reset >/dev/null 2>&1; }
assert_success "db-reset drops/recreates non-interactively (relays db-drop -y)" test_db_reset_drops

# 12b. Cross-checkout dev-data isolation (RFC 156) — the regression the whole RFC
#      exists for, asserted rather than assumed. Before it, every worktree shared
#      one database literally named `unicoach`, so a routine bin/db-reset in ANY
#      checkout destroyed every other checkout's dev data; it happened twice in
#      one day. This drives the REAL bin/db-reset in one checkout and proves the
#      other's rows survive it.
#
#      Two fake checkout roots (directories of symlinks back into this one, so
#      `basename $PROJECT_ROOT` — the only input to the derivation — is the only
#      difference) each get their own dev database from .env.dev's
#      unicoach-dev-<dir> derivation. Real cluster, real databases, real DROP:
#      a mocked version of this test would assert nothing, since the failure mode
#      was precisely that the two names were the same string.
echo ""
echo "==== Testing cross-checkout dev database isolation ===="
# The two fake names must differ PER CHECKOUT, not merely per directory. The dev
# database is derived from the checkout NAME (.env.dev: POSTGRES_DB=
# unicoach-dev-$(checkout_name "$PROJECT_ROOT")) and every checkout shares one
# server, so the former fixed names had every checkout deriving the SAME two
# databases — and iso_cleanup's DROP DATABASE ... WITH (FORCE) then terminated a
# CONCURRENT run's sessions, failing it with a bare "terminating connection due
# to administrator command": a name collision wearing the costume of a Postgres
# crash. The tag is a cksum of this checkout's ROOT PATH, the same input the port
# block already keys on.
#
# Deliberately NOT unique per run (no $$): CKP_CHECKOUT_TAG is a pure function of
# the checkout, so a leaked database is one THIS checkout's next run derives
# again and drops, and only ever this checkout's to drop. A per-run tag would buy
# nothing: two runs of this harness in ONE checkout already collide on that
# checkout's test database, its var/run daemons and its port block, so the pair
# is not a supported configuration — and paying $$ would cost the reclaimability
# above.
CKP_FAKE_PARENT="$(mktemp -d)"
iso_name_a="unicoach-isotest-a-$CKP_CHECKOUT_TAG"
iso_name_b="unicoach-isotest-b-$CKP_CHECKOUT_TAG"
# A tripwire, not a live risk: the names are at most 29 bytes today (a 19-byte
# prefix plus cksum's 10-digit ceiling) against a 49-byte bound, so this cannot
# fire until someone lengthens the prefix. Checked HERE anyway, before any
# database exists: checkout_name refuses an over-long name with a fatal inside a
# CHILD process, which would surface two steps later as an empty derived name and
# a misleading message. Bytes, not characters — the limit the server truncates at
# is bytes.
for iso_name in "$iso_name_a" "$iso_name_b"; do
  iso_name_bytes="$(printf '%s' "$iso_name" | LC_ALL=C wc -c | tr -d '[:space:]')"
  if [ "$iso_name_bytes" -gt "$CHECKOUT_NAME_MAX_BYTES" ]; then
    rm -rf "$CKP_FAKE_PARENT"
    fail_test "fake checkout name [$iso_name] is [$iso_name_bytes] bytes, over checkout_name's [$CHECKOUT_NAME_MAX_BYTES]; its dev database would be truncated by PostgreSQL and could collide with another checkout's"
  fi
done
iso_root_a="$(make_fake_checkout "$iso_name_a")"
iso_root_b="$(make_fake_checkout "$iso_name_b")"

# Every invocation drops the harness's exported ENV_FILES: the dev database only
# exists under the AMBIENT `.env -> .env.dev` layering, which is the layering an
# operator's bin/db-reset actually runs under.
iso_dev() {
  local root="$1"; shift
  env -u ENV_FILES -u ENV_FILE "$root/bin/$@"
}
iso_db_name() {
  env -u ENV_FILES -u ENV_FILE bash -c 'source "$1/bin/common"; echo "$POSTGRES_DB"' _ "$1"
}
# The checkout's OWNER role (RFC 174), read the same way: whatever .env.dev
# derives POSTGRES_USER to inside that root.
iso_role_name() {
  env -u ENV_FILES -u ENV_FILE bash -c 'source "$1/bin/common"; echo "$POSTGRES_USER"' _ "$1"
}
# One role's attributes, LABELLED by SQL so the value is self-describing in the
# assertion and in the failure message.
iso_role_attrs() {
  iso_dev "$iso_root_a" db-run -r -d "${POSTGRES_ADMIN_DB:-postgres}" ro \
    "SELECT format('superuser=%s createdb=%s login=%s', rolsuper::text, rolcreatedb::text, rolcanlogin::text) FROM pg_roles WHERE rolname = '$1'" 2>&1 | tr -d '\n'
}

# How the held session below is recognised from any other connection: set by the
# holder, matched by both pg_stat_activity reads. ONE name, so a typo cannot make
# the survival assertion pass against zero rows.
ISO_HOLD_TAG=rfc174-iso-hold
# The held session must outlive the wait for it to APPEAR plus the refused DROP
# and both pg_stat_activity reads, so its lifetime is set well above
# ISO_HOLD_POLL_ATTEMPTS * ISO_HOLD_POLL_INTERVAL. The interval is coarser than
# PORT_POLL_INTERVAL because each attempt pays a full bin/common load.
ISO_HOLD_SESSION_SECS=60
ISO_HOLD_POLL_ATTEMPTS=30
ISO_HOLD_POLL_INTERVAL=0.2
# The backend pids of the held session on B, read from any connection. stderr is
# NOT suppressed: a failed read and "no such session" must stay distinguishable,
# and the polling caller already treats an empty answer as "not yet".
iso_hold_session_pids() {
  iso_dev "$iso_root_b" db-run -r -d "${POSTGRES_ADMIN_DB:-postgres}" ro \
    "SELECT pid FROM pg_stat_activity WHERE application_name = '$ISO_HOLD_TAG' AND datname = '$iso_db_b'" | tr -d '[:space:]'
}
# The tag travels in the SQL db-run already takes as an explicit argument, NOT in
# an inherited PGAPPNAME: that would have to survive iso_dev's `env -u`,
# bin/common and db-run before libpq ever saw it, an inheritance chain the db-run
# interface neither declares nor documents. psql -c accepts several statements, so
# the SET is ordered before the sleep, and SET application_name is legal under
# db-run ro's default_transaction_read_only=on.
#
# NOT run in a subshell, so the EXIT trap still sees the pid it assigns.
iso_start_held_session_on_b() {
  iso_dev "$iso_root_b" db-run ro \
    "SET application_name = '$ISO_HOLD_TAG'; SELECT pg_sleep($ISO_HOLD_SESSION_SECS);" >/dev/null 2>&1 &
  iso_hold_pid=$!
}
# Bounded: echoes the pids once the backend appears, and nothing on timeout.
# `seq`, not `{1..N}` — brace expansion does not expand a variable.
iso_await_held_session_pids() {
  local pids= _
  for _ in $(seq "$ISO_HOLD_POLL_ATTEMPTS"); do
    pids="$(iso_hold_session_pids)"
    [ -n "$pids" ] && break
    sleep "$ISO_HOLD_POLL_INTERVAL"
  done
  printf '%s' "$pids"
}
iso_hold_pid=
# Idempotent, and clears ISO_DATABASES_LIVE last so the EXIT trap does not repeat a
# cleanup the section already ran.
iso_cleanup() {
  [ -n "$iso_hold_pid" ] && kill "$iso_hold_pid" >/dev/null 2>&1
  iso_dev "$iso_root_a" db-drop -y >/dev/null 2>&1 || true
  iso_dev "$iso_root_b" db-drop -y >/dev/null 2>&1 || true
  # The two roles are real cluster objects, so the section drops them as well —
  # a fake checkout that leaked a role would leave the NEXT run adopting a
  # database it already owned and asserting nothing. Databases first: a role that
  # still owns one cannot be dropped.
  #
  # ONE STATEMENT PER ROLE, in its own db-write. db-run passes SQL as `psql -c`,
  # which runs a multi-statement string in a SINGLE transaction, so a role A that
  # still owned something rolled back the INDEPENDENT drop of role B — and the
  # `|| true` then hid that the cleanup had done nothing. Best-effort, but each
  # failure is WARNED rather than swallowed: a silently leaked role is a later run
  # that asserts nothing.
  local iso_root
  for iso_root in "$iso_root_a" "$iso_root_b"; do
    bin/db-write -U "$(cluster_superuser)" -d "${POSTGRES_ADMIN_DB:-postgres}" \
      "DROP ROLE IF EXISTS \"$(iso_role_name "$iso_root")\";" >/dev/null 2>&1 \
      || log-warning "could not drop the owner role of [$iso_root]; the next run of this section will not start role-less"
  done
  rm -rf "$CKP_FAKE_PARENT"
  ISO_DATABASES_LIVE=""
}
# Armed BEFORE anything can create a database — db-create runs below and may fail
# halfway — and only now that iso_cleanup is DEFINED: a signal arriving between
# the two would otherwise pass the trap's guard and call a command that does not
# exist yet, reaping nothing.
ISO_DATABASES_LIVE=1
# The ONE failure exit for this section. fail_test exits the harness, so every
# abort has to drop the two real databases first — repeating that cleanup at each
# branch is exactly how one forgotten copy leaks a database into the shared dev
# cluster.
iso_fail() {
  iso_cleanup
  fail_test "$1"
}

# Two properties, checked in the order that reports the RFC 156 regression in its
# own words. FIRST that the two names DIFFER — one string for both checkouts is
# the regression itself, and it deserves to say so rather than arrive as a
# mismatch against an expected name. THEN that each equals .env.dev's derivation,
# unicoach-dev-<checkout name>, restated here over the names we ASKED for and
# compared against a child that really sources bin/common (iso_db_name): derived
# rather than hardcoded, since
# the fake names carry this checkout's tag and no literal could be right in every
# checkout — but still the full rule, not a weaker "they are different".
test_iso_derives_distinct_dev_databases() {
  local want_a want_b
  iso_db_a="$(iso_db_name "$iso_root_a")"
  iso_db_b="$(iso_db_name "$iso_root_b")"
  if [ "$iso_db_a" = "$iso_db_b" ]; then
    iso_fail "the two fake checkouts derived the SAME dev database [$iso_db_a]; per-worktree derivation is gone"
  fi
  # Built from the names we ASKED for, never from a spelled-out database name: a
  # literal here would be exactly the hardcoded-name defect the guard below
  # (RFC 174) forbids, in the file that hosts the guard.
  want_a="unicoach-dev-$iso_name_a"
  want_b="unicoach-dev-$iso_name_b"
  if [ "$iso_db_a" != "$want_a" ] || [ "$iso_db_b" != "$want_b" ]; then
    iso_fail ".env.dev did not derive a per-worktree dev database (got [$iso_db_a] and [$iso_db_b], expected [$want_a] and [$want_b])"
  fi
  return 0
}

# RFC 174, and the path a brand-new worktree actually takes: its first command is
# usually bin/db-reset (bin/test runs it), and db-reset's step 1 is db-drop —
# which since RFC 174 connects as an owner role that does not exist yet, so the
# connection would be refused before anything is dropped. db-drop therefore
# bootstraps the role itself.
#
# Placed BEFORE every db-create in this section, and registered before them too:
# that ordering is the whole test. Once any db-create has run, the role exists and
# the bootstrap inside db-drop is a no-op on every later run, which is exactly why
# the branch was uncovered.
test_iso_db_reset_bootstraps_a_brand_new_checkout() {
  local out role_a exists
  role_a="$(iso_role_name "$iso_root_a")"
  # `2>/dev/null` here used to collapse "the query FAILED" and "the count is not
  # 0" onto one empty string, and the branch below then reported the second as
  # fact. errexit is OFF inside these functions (assert_success runs them under
  # `if !`), so the masked value really did flow. The substitution's own status
  # separates the two, and psql's message reaches the harness log.
  if ! exists="$(bin/db-run -r -d "${POSTGRES_ADMIN_DB:-postgres}" ro \
    "SELECT count(*) FROM pg_roles WHERE rolname = '$role_a'" | tr -d '[:space:]')"; then
    iso_fail "could not read pg_roles for [$role_a]; this test's precondition is UNKNOWN, not satisfied (psql's error is above)"
  fi
  if [ "$exists" != "0" ]; then
    iso_fail "the owner role [$role_a] already exists before any provisioning; this test's precondition (a role-less checkout) is gone and it would assert nothing"
  fi
  if ! out="$(iso_dev "$iso_root_a" db-reset 2>&1)"; then
    iso_fail "bin/db-reset failed in a fresh checkout whose owner role [$role_a] does not exist yet: $out"
  fi
  return 0
}

# The blast radius under test: a full drop/create/migrate in checkout A only.
# A's own marker must be GONE (so the survival of B's row is isolation and not a
# no-op) and B's must be untouched.
test_iso_db_reset_spares_the_other_checkout() {
  local marker_sql="CREATE TABLE IF NOT EXISTS rfc156_marker (id INT PRIMARY KEY); INSERT INTO rfc156_marker VALUES (1);"
  local out a_gone b_rows
  if ! out="$(iso_dev "$iso_root_a" db-create 2>&1)" || ! out="$(iso_dev "$iso_root_b" db-create 2>&1)"; then
    iso_fail "could not provision the two fake checkouts' dev databases: $out"
  fi
  if ! out="$(iso_dev "$iso_root_a" db-run rw "$marker_sql" 2>&1)" \
    || ! out="$(iso_dev "$iso_root_b" db-run rw "$marker_sql" 2>&1)"; then
    iso_fail "could not seed the marker row in both dev databases: $out"
  fi
  # db-reset's own output is CAPTURED and reported: a provisioning failure in the
  # test this whole RFC exists for must not be a bare "it failed".
  if ! out="$(iso_dev "$iso_root_a" db-reset 2>&1)"; then
    iso_fail "bin/db-reset failed in the fake checkout [$iso_root_a]: $out"
  fi
  if ! a_gone="$(iso_dev "$iso_root_a" db-run -r ro "SELECT to_regclass('public.rfc156_marker') IS NULL" | tr -d '[:space:]')"; then
    iso_fail "could not read [$iso_db_a] after its db-reset; whether the marker table was dropped is UNKNOWN (psql's error is above)"
  fi
  if [ "$a_gone" != "t" ]; then
    iso_fail "db-reset in [$iso_db_a] did not drop its own marker table (to_regclass IS NULL returned [$a_gone])"
  fi
  # A failed READ is not data destruction. Reporting it as such would send the
  # reader after the one bug this section exists to catch when the real fault is
  # an unreachable cluster.
  if ! b_rows="$(iso_dev "$iso_root_b" db-run -r ro "SELECT count(*) FROM rfc156_marker" | tr -d '[:space:]')"; then
    iso_fail "could not read the marker table in [$iso_db_b]; whether db-reset in [$iso_db_a] spared it is UNKNOWN, not answered (psql's error is above)"
  fi
  if [ "$b_rows" != "1" ]; then
    iso_fail "db-reset in [$iso_db_a] destroyed the other checkout's data: [$iso_db_b] reports [$b_rows] marker rows, expected 1"
  fi
  return 0
}

# RFC 174. The positive test above proves the two NAMES differ; it cannot prove
# that anything would stop a checkout which derived the WRONG name. Until now
# nothing would: every bin/ command connected as the cluster SUPERUSER, and a
# superuser is never asked for permission — which is how, on 2026-09-05, one
# harness run force-dropped another checkout's live connections. Ownership is the
# thing that IS asked. So: each fake checkout now derives its own non-superuser
# role, owns its own database, and the drop across the boundary is REFUSED.
test_iso_derives_distinct_non_superuser_roles() {
  local role_a role_b role attrs
  role_a="$(iso_role_name "$iso_root_a")"
  role_b="$(iso_role_name "$iso_root_b")"
  if [ "$role_a" = "$role_b" ] || [ -z "$role_a" ] || [ -z "$role_b" ]; then
    iso_fail ".env.dev did not derive a per-worktree owner role (got [$role_a] and [$role_b])"
  fi
  # A superuser bypasses every ownership check, so a role that is one would make
  # the refusal test below vacuous. CREATEDB and LOGIN are what db-create needs.
  #
  # ONE ROLE PER CHECK, with SQL labelling each attribute. The old form packed
  # three booleans into a positional `011` token AND concatenated two rows with no
  # separator, so the expected value only held because role names happen not to
  # end in digits — and a failure printed something no reader could decode.
  for role in "$role_a" "$role_b"; do
    attrs="$(iso_role_attrs "$role")"
    if [ "$attrs" != "superuser=false createdb=true login=true" ]; then
      iso_fail "checkout role [$role] is not LOGIN CREATEDB NOSUPERUSER (pg_roles reports [$attrs])"
    fi
  done
  return 0
}

# The negative test, and the point of RFC 174: checkout A trying to drop checkout
# B's database must FAIL, and B's live session must SURVIVE the attempt. Both
# halves matter — `DROP DATABASE ... WITH (FORCE)` terminates every other session
# on the target, so a refusal that still killed the connections would be no
# better than the bug. The privilege check runs BEFORE the termination step.
#
# Driven through the bounded interface (db-write -d postgres), not a raw psql:
# the identity under test is the one an operator's real command would use.
test_iso_cannot_drop_another_checkouts_database() {
  local out pids_before pids_after b_rows
  # B must exist and hold a row; A's own database was just recreated by the
  # db-reset test above, so it exists and is owned by A.
  if ! out="$(iso_dev "$iso_root_b" db-create 2>&1)"; then
    iso_fail "could not re-provision [$iso_db_b]: $out"
  fi
  # A held session on B, tagged so it can be counted from any other connection.
  iso_start_held_session_on_b
  pids_before="$(iso_await_held_session_pids)"
  if [ -z "$pids_before" ]; then
    iso_fail "could not open a held session on [$iso_db_b]; the survival half of the test would be vacuous"
  fi

  if out="$(iso_dev "$iso_root_a" db-write -d "${POSTGRES_ADMIN_DB:-postgres}" "DROP DATABASE \"$iso_db_b\" WITH (FORCE);" 2>&1)"; then
    iso_fail "checkout [$iso_root_a] DROPPED another checkout's database [$iso_db_b] — ownership is not enforced"
  fi
  if ! printf '%s' "$out" | grep -q 'must be owner of database'; then
    iso_fail "the cross-checkout DROP failed, but not with a privilege error: $out"
  fi

  # The owner's live connection survived: same backend pid, still there. The
  # READ's own status is checked first — a failed query and "the pids changed"
  # are different facts, and announcing the second when the first happened points
  # the reader at a data-destruction bug that did not occur.
  if ! pids_after="$(iso_hold_session_pids)"; then
    iso_fail "could not read pg_stat_activity for [$iso_db_b] after the refused DROP; whether the live session survived is UNKNOWN (psql's error is above)"
  fi
  if [ "$pids_after" != "$pids_before" ]; then
    iso_fail "the refused DROP still disturbed [$iso_db_b]'s live session (pids before [$pids_before], after [$pids_after])"
  fi
  kill "$iso_hold_pid" >/dev/null 2>&1 || true
  iso_hold_pid=

  if ! b_rows="$(iso_dev "$iso_root_b" db-run -r ro "SELECT count(*) FROM rfc156_marker" | tr -d '[:space:]')"; then
    iso_fail "could not read the marker table in [$iso_db_b] after the refused DROP; whether its data survived is UNKNOWN (psql's error is above)"
  fi
  if [ "$b_rows" != "1" ]; then
    iso_fail "the refused DROP destroyed data in [$iso_db_b]: it reports [$b_rows] marker rows, expected 1"
  fi
  return 0
}

assert_success "two checkouts derive distinct dev databases" test_iso_derives_distinct_dev_databases
assert_success "bin/db-reset provisions a checkout whose owner role does not exist yet" test_iso_db_reset_bootstraps_a_brand_new_checkout
assert_success "bin/db-reset in one checkout leaves another checkout's dev data untouched" test_iso_db_reset_spares_the_other_checkout
assert_success "two checkouts derive distinct non-superuser owner roles" test_iso_derives_distinct_non_superuser_roles
assert_success "a checkout cannot drop another checkout's database, and the owner's session survives" test_iso_cannot_drop_another_checkouts_database
iso_cleanup

echo ""
echo "==== Testing no bin/ script names a per-checkout database literally ===="
# RFC 174, and the defect it is the second half of. Every per-checkout database
# name is DERIVED, in exactly three dotenv lines, from checkout_name
# "$PROJECT_ROOT". A literal `unicoach-dev-<something>` written into a script or a
# fixture is a name that belongs to whichever checkout is called <something>, and
# a shared cluster does not care that the writer meant it as a stand-in: the
# cross-checkout isolation section used to hardcode its two fake checkout names,
# so two real checkouts running this harness at once derived the SAME databases
# and one force-dropped the other's live connections.
#
# Comment lines are stripped first: the prose above and below explains the rule by
# quoting the very prefixes it forbids.
#
# The exclusion list is ONE name, carried the way HARNESS_EXCLUSIONS carries its
# own: bin/db-scripts-tests is the single bin/ file allowed to name a database
# literally, because its POSTGRES_DB=unicoach-db-scripts-test lives on a PRIVATE
# throwaway cluster with its own data directory and its own PID-derived port
# (bin/db-scripts-tests:1-31), which no other checkout can reach and which is
# deleted on exit. Carved out by NAME, so that harness renaming its database into
# the shape below would be a deliberate, visible decision rather than a silent
# pass.
DB_LITERAL_EXCLUSIONS=(db-scripts-tests)
# The prefixes come from the dotenv lines that OWN them, never a copy: a renamed
# prefix keeps being guarded instead of silently matching nothing and passing on
# every file.
DB_NAME_PREFIXES="$( { checkout_derivation_prefix "$PROJECT_ROOT/.env.dev" POSTGRES_DB
  checkout_derivation_prefix "$PROJECT_ROOT/.env.test" POSTGRES_DB
  checkout_derivation_prefix "$PROJECT_ROOT/.env.fuzz" POSTGRES_DB; } | paste -sd'|' -)"
# A prefix followed by a LITERAL, i.e. an alphanumeric — `unicoach-dev-$(...)`
# is the derivation and passes. Capture-and-test for non-empty rather than
# piping into `grep -q`, which under `set -o pipefail` SIGPIPEs the upstream grep.
assert_every_bin_script_free_of "names no per-checkout database literally" \
  "($DB_NAME_PREFIXES)[A-Za-z0-9]" "${DB_LITERAL_EXCLUSIONS[@]}"

# The positive half: the guard above only proves nobody SPELLED a name out. These
# three lines are where the names actually come from, and checkout_name — not a
# bare `basename` — is what carries the 63-byte truncation guard. .env.test and
# .env.fuzz used a bare basename until RFC 174, which is how a 64-byte test
# database name reached the server and was silently shortened.
test_dotenvs_derive_their_databases_from_checkout_name() {
  local file
  for file in .env.dev .env.test .env.fuzz; do
    if ! grep -qE '^POSTGRES_DB=unicoach-(dev|test|fuzz)-\$\(checkout_name "\$PROJECT_ROOT"\)$' "$PROJECT_ROOT/$file"; then
      fail_test "$file does not derive POSTGRES_DB with checkout_name \"\$PROJECT_ROOT\": [$(grep -E '^POSTGRES_DB=' "$PROJECT_ROOT/$file" || echo 'no POSTGRES_DB line at all')]"
    fi
  done
  return 0
}

# The DEPLOY-SAFETY half, and its own named test rather than a third `if` inside
# the one above: this is the check whose failure means a ROLE NAME could be
# derived from the release directory on RDS, and it must not be reported under a
# heading about dotenv database names, after two earlier fail_test calls that
# would hide it.
#
# The owner role's derivation must live in .env.dev and NOWHERE else. bin/deploy
# ships much of bin/ to the instance (its REPO_PATHS array, which is bin/deploy's
# to change), so a default computed inside a shipped script would compute a role
# name from the release directory. .env.dev is never layered by the deploy path
# (it pins ENV_FILE=.env.<env>), which is the barrier that keeps this local. The
# grep is over ALL of bin/, so it needs no list of which scripts are shipped.
test_only_env_dev_derives_the_owner_role() {
  local owner_derivations
  # The offending LINE is printed, exactly as the POSTGRES_DB sibling above does,
  # with the same "no line at all" fallback: "not what was expected" without the
  # actual value is a manual grep the reader should not have to run.
  if ! grep -qE '^POSTGRES_USER=owner-\$\(checkout_name "\$PROJECT_ROOT"\)$' "$PROJECT_ROOT/.env.dev"; then
    fail_test ".env.dev does not derive POSTGRES_USER as owner-\$(checkout_name \"\$PROJECT_ROOT\"): [$(grep -E '^POSTGRES_USER=' "$PROJECT_ROOT/.env.dev" || echo 'no POSTGRES_USER line at all')]"
  fi
  # -rn, not -rl: this is the guard whose failure means an owner-<release-dir>
  # role could be created on RDS, and the exact file:line was already in hand.
  owner_derivations="$(grep -rnE 'owner-\$\(checkout_name' "$PROJECT_ROOT/bin" 2>/dev/null)"
  if [ -n "$owner_derivations" ]; then
    fail_test "these bin/ scripts derive the owner role name; the derivation belongs to .env.dev alone, because bin/ is shipped to the instance by bin/deploy: [$owner_derivations]"
  fi
  return 0
}
assert_success ".env.dev/.env.test/.env.fuzz derive their databases with checkout_name" test_dotenvs_derive_their_databases_from_checkout_name
assert_success "only .env.dev derives the owner role name, never a bin/ script" test_only_env_dev_derives_the_owner_role

echo ""
echo "==== Testing no bin/ script stops or restarts the shared PostgreSQL server ===="
# RFC 174's other guard. ONE cluster serves every worktree on this machine
# (POSTGRES_DATA_DIR is a shared absolute path by design), so stopping it is a
# cross-checkout outage: every other worktree's dev server, test run and psql dies
# at once, and the failure surfaces in the innocent checkout as an unrelated
# connection error. The repo satisfies this rule TODAY -- `pg_ctl stop`,
# `pg_ctl restart` and `brew services` have zero hits -- so this pins a property
# rather than fixing a defect, which is exactly when a guard is cheapest to add.
#
# Each allowlist entry has its reason:
#   postgres-down    -- IS the stop; an operator asking for it explicitly.
#   postgres-bounce  -- its only caller, and equally deliberate.
#   db-scripts-tests -- stops its OWN private throwaway cluster (own data dir,
#                       own PID-derived port), from a trap on exit.
#   scripts-tests    -- names bin/postgres-bounce inside an argument-rejection
#                       assertion (`bin/postgres-bounce stray`) that exits on the
#                       grammar before anything is started or stopped.
#   postgres-up      -- the one script entitled to `pg_ctl start`.
#
# The pattern names the COMMANDS, not the stop SPELLINGS. `pg_ctl <space> stop`
# missed `pg_ctl -D "$DATA_DIR" stop` -- the repo's OWN flag style, in
# bin/postgres-up -- and `systemctl stop postgresql` entirely. A script outside
# the allowlist has no business NAMING pg_ctl or systemctl at all, so that is what
# is forbidden and the entitled scripts are named instead.
#
# EXECUTABLES only: bin/INVARIANTS.md discusses pg_ctl in prose.
PG_LIFECYCLE_ALLOWLIST=(postgres-up postgres-down postgres-bounce db-scripts-tests scripts-tests)
PG_LIFECYCLE_PATTERN='pg_ctl|systemctl[^|;&]*postgres|brew[[:space:]]+services|(pkill|killall)[^|;&]*postgres|bin/postgres-(down|bounce)'
for script_path in "$PROJECT_ROOT"/bin/*; do
  [ -f "$script_path" ] && [ -x "$script_path" ] || continue
  script="$(basename "$script_path")"
  list_contains "$script" "${PG_LIFECYCLE_ALLOWLIST[@]}" && continue
  assert_success "bin/$script neither stops nor restarts the shared cluster" \
    bin_script_free_of_pattern "$PG_LIFECYCLE_PATTERN" "$script"
done

echo ""
echo "==== Testing no bin/ script connects as the cluster superuser ===="
# RFC 174 D4 claims exactly TWO superuser touchpoints, both bootstraps —
# db-create-role (creating this checkout's owner role) and db-adopt (moving a
# pre-RFC-174 database's ownership onto it). Everything else connects as
# POSTGRES_USER and is refused by the SERVER when it reaches for another
# checkout's data. That count is the whole guarantee, and until this guard nothing
# measured it: bin/db-run's -U makes a third touchpoint a single, review-invisible
# line, and a superuser bypasses every ownership check — so that one line would
# void the isolation with every other test in this suite still green.
#
# The permitted connect identity is stated POSITIVELY: outside the five
# bootstraps below, a bin/ script may name only its OWN checkout role --
# $POSTGRES_USER, or db-run's $CONNECT_USER which defaults to it -- plus the
# `<user>` placeholder a help text prints. EVERY other -U value is a superuser
# touchpoint, whatever it is spelled as: a variable, a helper call, or the bare
# literal `postgres`. The guard used to list three forbidden SPELLINGS, so a
# literal `psql -U postgres` -- a shape that really exists in this tree, at
# bin/db-scripts-tests -- passed it green.
#
# Each allowlist entry has its reason:
#   db-create-role   -- touchpoint 1; creates this checkout's owner role.
#   db-adopt         -- touchpoint 2; moves ownership onto it.
#   db-bootstrap     -- initdb CREATES the superuser account; that is not a
#                       connection as one.
#   db-scripts-tests -- seeds and drops superuser-owned fixtures on its own
#                       PRIVATE throwaway cluster to test the adoption path.
#   scripts-tests    -- drops the two fake checkouts' roles in its own cleanup.
SUPERUSER_CONNECT_ALLOWLIST=(db-create-role db-adopt db-bootstrap db-scripts-tests scripts-tests)
# The placeholder alternative is `<user>` followed by ONE of `]` or `:` -- the two
# shapes a help text prints, `[-U <user>]` in a synopsis and `-U <user>:` in an
# option list -- and nothing else, so a real connection cannot hide behind the
# placeholder by spelling itself `-U <user>foo`. Inside the bracket expression the
# LEADING `]` is a LITERAL `]`, not the closing bracket: first position is the only
# place a `]` can be matched, so moving or "tidying" it breaks the pattern and the
# guard stops matching the help texts it was written to allow.
ALLOWED_CONNECT_USER='^-U[[:space:]]+"?(\$\{?(POSTGRES_USER|CONNECT_USER)\}?|<user>[]:])$'
bin_script_connects_only_as_its_own_role() {
  [ -z "$(grep -vE '^[[:space:]]*#' "$PROJECT_ROOT/bin/$1" \
        | grep -oE '\-U[[:space:]]+"?[^[:space:]"]+' \
        | grep -vE "$ALLOWED_CONNECT_USER")" ]
}
for script_path in "$PROJECT_ROOT"/bin/*; do
  [ -f "$script_path" ] || continue
  script="$(basename "$script_path")"
  list_contains "$script" "${SUPERUSER_CONNECT_ALLOWLIST[@]}" && continue
  assert_success "bin/$script connects only as its own checkout role" \
    bin_script_connects_only_as_its_own_role "$script"
done

# 13. Unexpected-argument rejection across the guard set. Each guard fires before
#     any real work, so no live cluster/daemon is needed: the stray argument is
#     rejected with EXIT_UNEXPECTED_ARG (20) up front. postgres-bounce now rejects
#     a stray argument before running either child (down then up) — the direct
#     inversion of the former ignore-and-exit-0 behaviour. The *-check probe and
#     is-nix cases assert 20 is distinct from their operational 1/2 (down) and
#     0/1 (dev-shell) codes, which they return through stderr-suppressed `if`
#     guards where a reused 1 would read silently as "down" / "not in the shell".
assert_exit_code "$EXIT_UNEXPECTED_ARG" "postgres-bounce rejects an unexpected argument" bin/postgres-bounce stray
assert_exit_code "$EXIT_UNEXPECTED_ARG" "rest-server-down rejects an unexpected argument" bin/rest-server-down stray
assert_exit_code "$EXIT_UNEXPECTED_ARG" "rest-server-check rejects an unexpected argument" bin/rest-server-check stray
assert_exit_code "$EXIT_UNEXPECTED_ARG" "postgres-wait-for-health rejects an unexpected argument" bin/postgres-wait-for-health stray
assert_exit_code "$EXIT_UNEXPECTED_ARG" "postgres-check rejects an unexpected argument" bin/postgres-check stray
assert_exit_code "$EXIT_UNEXPECTED_ARG" "is-nix rejects an unexpected argument" bin/is-nix stray
assert_exit_code "$EXIT_UNKNOWN_OPTION" "rest-server-check rejects an unknown option" bin/rest-server-check -z

# 14. Grammar guards on the exactly-one and required-pair scripts. Each guard
#     fires after getopts but before any kill/db work, so no live process or
#     cluster is needed: too-many positionals map to EXIT_UNEXPECTED_ARG (20) and
#     a missing required positional maps to EXIT_MISSING_REQUIRED_ARG (21).
assert_exit_code "$EXIT_MISSING_REQUIRED_ARG" "check-pid with zero args exits 21" bin/check-pid
assert_exit_code "$EXIT_UNEXPECTED_ARG" "check-pid with two args exits 20" bin/check-pid 1 2
assert_success "list-listening-pids -h exits 0" bin/list-listening-pids -h
assert_exit_code "$EXIT_MISSING_REQUIRED_ARG" "list-listening-pids with zero args exits 21" bin/list-listening-pids
assert_exit_code "$EXIT_UNEXPECTED_ARG" "list-listening-pids with two args exits 20" bin/list-listening-pids 18000 18001
assert_exit_code "$EXIT_INVALID_ARG_VALUE" "list-listening-pids with a non-numeric port exits 22" bin/list-listening-pids notaport
assert_success "is-port-free -h exits 0" bin/is-port-free -h
assert_exit_code "$EXIT_MISSING_REQUIRED_ARG" "is-port-free with zero args exits 21" bin/is-port-free
assert_exit_code "$EXIT_UNEXPECTED_ARG" "is-port-free with two args exits 20" bin/is-port-free 18000 18001
assert_exit_code "$EXIT_INVALID_ARG_VALUE" "is-port-free with a non-numeric port exits 22" bin/is-port-free notaport
# The port-bound up-wrappers learned -k: it parses as a known no-value option, so
# a stray positional after it is EXIT_UNEXPECTED_ARG (20), never EXIT_UNKNOWN_OPTION
# (10). Firing before the binary check, this proves -k is accepted without booting.
assert_exit_code "$EXIT_UNEXPECTED_ARG" "rest-server-up -k parses (stray positional -> 20)" bin/rest-server-up -k stray
assert_exit_code "$EXIT_UNEXPECTED_ARG" "rest-server-up -9 parses (stray positional -> 20)" bin/rest-server-up -9 stray
assert_exit_code "$EXIT_UNEXPECTED_ARG" "admin-web-up -k parses (stray positional -> 20)" bin/admin-web-up -k stray
assert_exit_code "$EXIT_UNEXPECTED_ARG" "public-web-up -k parses (stray positional -> 20)" bin/public-web-up -k stray
assert_exit_code "$EXIT_MISSING_REQUIRED_ARG" "q-enqueue with one arg exits 21" bin/q-enqueue only-job-type
assert_exit_code "$EXIT_UNEXPECTED_ARG" "q-enqueue with a residual positional exits 20" bin/q-enqueue job '{}' stray
assert_exit_code "$EXIT_INVALID_ARG_VALUE" "q-enqueue with a malformed -d delay exits 22" bin/q-enqueue job '{}' -d not-a-duration

# 15. RFC 92 ops tool runner. The scripts and shared functions the ops-tool path
#     depends on: static lint, the two shared resolvers, and the argument-validation
#     surfaces of bin/remote and bin/ingest-colleges. The AWS trigger itself
#     (S3 upload, send-command, the s3:// branch of resolve_file_arg) cannot run
#     without live AWS and is covered by the RFC's post-apply deployment
#     verification, mirroring RFC 50's original deploy path.
echo ""
echo "==== Testing RFC 92 ops tool runner ===="

# Script lint: bash -n over every script the RFC touches or adds.
for script in deploy build build-college ingest-colleges remote functions; do
  assert_success "bash -n bin/$script parses cleanly" bash -n "$PROJECT_ROOT/bin/$script"
done

# Every systemd unit under infra/files/ MUST be deploy-managed across all four
# lists: bin/deploy bundles it (DEPLOY_MANAGED_PATHS); build_deploy_command
# (bin/functions) installs it into /etc/systemd/system/ AND `systemctl enable`s it;
# and deploy-on-instance.sh `systemctl restart`s it. Miss bundle/install/enable and
# a unit added to an already-running instance never lands there; miss the restart
# and deploy-on-instance never (re)starts it — or, for a unit whose restart line
# exists but was never installed, `systemctl restart` (set -e) aborts the whole
# deploy. This guards RFC 97's cron unit — and any future unit — against that gap.
echo ""
echo "==== Testing every systemd unit is deploy-managed ===="
unit_bundled() { grep -qF "infra/files/$1" "$PROJECT_ROOT/bin/deploy"; }
unit_installed() { grep -qF "infra/files/$1" "$PROJECT_ROOT/bin/functions"; }
unit_restarted() { grep -qF "systemctl restart $1" "$PROJECT_ROOT/infra/files/deploy-on-instance.sh"; }
# The enable list names units bare (no path). Strip comment lines first so a
# future comment naming a unit can't masquerade as its `systemctl enable` entry;
# of the survivors, the line carrying the bare name but no 'infra/files/' path is
# the enable line (vs the path-bearing install line). Capture-and-test for
# non-empty rather than piping into `grep -q`, which under `set -o pipefail` exits
# early and SIGPIPEs the upstream grep, wrongly failing the pipeline.
unit_enabled() { [ -n "$(grep -vE '^[[:space:]]*#' "$PROJECT_ROOT/bin/functions" | grep -F "$1" | grep -v 'infra/files/')" ]; }
for unit_path in "$PROJECT_ROOT"/infra/files/unicoach-*.service; do
  unit="$(basename "$unit_path")"
  assert_success "bin/deploy bundles $unit (DEPLOY_MANAGED_PATHS)" unit_bundled "$unit"
  assert_success "build_deploy_command installs $unit" unit_installed "$unit"
  assert_success "build_deploy_command enables $unit" unit_enabled "$unit"
  assert_success "deploy-on-instance restarts $unit" unit_restarted "$unit"
done

# The mirror image, for local-only tooling (RFC 156 4d). bin/deploy's REPO_PATHS
# is an ALLOW-LIST, so a new bin/ script is excluded by construction — and
# exclusion by omission is invisible, which is exactly how a future "helpful"
# addition would slip a laptop-only DB tool into the deploy bundle. bin/db-dump
# and bin/db-restore target $POSTGRES_DB on the developer's shared cluster and
# have no meaning on an instance. The check is pure text against bin/deploy, so
# it holds whether or not the scripts themselves exist yet.
not_bundled() { ! grep -qE "\"bin/$1\"" "$PROJECT_ROOT/bin/deploy"; }
assert_success "bin/deploy does not bundle db-dump (local-only)" not_bundled db-dump
assert_success "bin/deploy does not bundle db-restore (local-only)" not_bundled db-restore

echo ""
echo "==== Testing every shell test harness is run by bin/shell-tests ===="
# The anti-orphan guard (RFC 115). These harnesses are executed by nothing but
# bin/shell-tests, and an orphaned one looks exactly like a passing one: three of
# them sat unrun for months, hiding two real defects. So discover the harnesses
# from the filesystem and assert each is named in the aggregator — a new
# bin/<x>-scripts-tests that nobody wired up halts here, loudly, by name.
#
# ios-scripts-tests is the ONE deliberate exclusion: it drives system Xcode and
# refuses to run inside the Nix dev shell (RFC 114), which is where bin/test and
# the pre-commit hook run. It is carved out BY NAME rather than by a pattern, so
# a future omission cannot be silently swallowed by the same carve-out.
#
# The glob is `*scripts-tests`, not `*-scripts-tests`: the latter (as RFC 115
# sketched it) silently misses `bin/scripts-tests` itself — the most expensive
# harness and the one this guard most needs to keep wired up.
HARNESS_EXCLUSIONS=(ios-scripts-tests)
harness_in_shell_tests() { grep -qF "bin/$1" "$PROJECT_ROOT/bin/shell-tests"; }
for harness_path in "$PROJECT_ROOT"/bin/*scripts-tests; do
  harness="$(basename "$harness_path")"
  list_contains "$harness" "${HARNESS_EXCLUSIONS[@]}" && continue
  assert_success "bin/shell-tests runs $harness" harness_in_shell_tests "$harness"
done

# OpenTofu static validation of infra/ (ops.tf + the iam.tf/outputs.tf edits).
# fmt -check is purely static. validate needs the providers installed, so init
# first with -backend=false (no remote state, no AWS) into a throwaway TF_DATA_DIR
# so the developer's real infra/.terraform is left untouched; providers resolve
# offline from the tracked infra/.terraform.lock.hcl. Both must exit 0.
assert_success "tofu -chdir=infra fmt -check passes" \
  tofu -chdir="$PROJECT_ROOT/infra" fmt -check
test_tofu_validate() {
  local tf_data rc=0
  tf_data="$(mktemp -d)"
  (
    export TF_DATA_DIR="$tf_data"
    tofu -chdir="$PROJECT_ROOT/infra" init -backend=false -input=false >/dev/null 2>&1 \
      && tofu -chdir="$PROJECT_ROOT/infra" validate >/dev/null 2>&1
  ) || rc=$?
  rm -rf "$tf_data"
  [ "$rc" -eq 0 ]
}
assert_success "tofu -chdir=infra validate passes (init -backend=false, no AWS)" test_tofu_validate

# resolve_file_arg (local-path branch only; the s3:// branch needs AWS).
test_resolve_file_arg_existing() {
  local f resolved
  f="$(mktemp)"
  resolved="$(resolve_file_arg "$f")"
  rm -f "$f"
  # realpath may resolve /var -> /private/var on macOS; compare basenames.
  [ "$(basename "$resolved")" = "$(basename "$f")" ] && [[ "$resolved" = /* ]]
}
assert_success "resolve_file_arg resolves an existing local path to an absolute path" test_resolve_file_arg_existing
test_resolve_file_arg_missing() {
  ( resolve_file_arg "/no/such/file/$$-does-not-exist" ) >/dev/null 2>&1
}
assert_failure "resolve_file_arg fatals on a nonexistent local path" test_resolve_file_arg_missing

# bin/remote argument validation (no AWS reached: every case fatals before the
# first tofu/aws call). A real local file (bin/functions) stands in for a -f path.
assert_success "remote -h exits 0" bin/remote -h
assert_exit_code "$EXIT_MISSING_REQUIRED_ARG" "remote with no <env> exits 21" bin/remote
assert_exit_code "$EXIT_MISSING_REQUIRED_ARG" "remote without a -- separator exits 21" bin/remote prod -f a:bin/functions ingest-colleges
assert_exit_code "$EXIT_MISSING_REQUIRED_ARG" "remote with -- but no <script> exits 21" bin/remote prod --
assert_exit_code "$EXIT_INVALID_ARG_VALUE" "remote -f with no ':' exits 22" bin/remote prod -f nocolon -- ingest-colleges
assert_exit_code "$EXIT_INVALID_ARG_VALUE" "remote -f with an empty name exits 22" bin/remote prod -f :bin/functions -- ingest-colleges
assert_exit_code "$EXIT_INVALID_ARG_VALUE" "remote -f with a '/' in the name exits 22" bin/remote prod -f a/b:bin/functions -- ingest-colleges
assert_exit_code "$EXIT_INVALID_ARG_VALUE" "remote -f with a name starting '-' exits 22" bin/remote prod -f -x:bin/functions -- ingest-colleges
assert_exit_code "$EXIT_INVALID_ARG_VALUE" "remote -f with a nonexistent path exits 22" bin/remote prod -f a:/no/such/path -- ingest-colleges
assert_exit_code "$EXIT_INVALID_ARG_VALUE" "remote @name undeclared by -f exits 22" bin/remote prod -f a:bin/functions -- ingest-colleges @b
assert_exit_code "$EXIT_INVALID_ARG_VALUE" "remote env=local is rejected before AWS (band 22)" bin/remote local -- ingest-colleges
assert_exit_code "$EXIT_UNKNOWN_OPTION" "remote rejects an unknown option (10)" bin/remote prod -z -- ingest-colleges

# Ops-tool allowlist: only a sanctioned <script> may run. An unsanctioned name is
# rejected with EXIT_INVALID_ARG_VALUE before any AWS call — the enforcement of
# the "ops tool MUST NOT modify current / restart a service" invariant (a bare
# bin/ token like deploy-on-instance can no longer be triggered).
assert_exit_code "$EXIT_INVALID_ARG_VALUE" "remote rejects an unsanctioned <script> (band 22)" bin/remote prod -- deploy-on-instance
assert_exit_code "$EXIT_INVALID_ARG_VALUE" "remote rejects a shell-injection <script> token (band 22)" bin/remote prod -- 'ingest-colleges; rm -rf /'

# -t and -p take a duration string (e.g. 30m, 5s) like `sleep`, validated with
# validate_duration. A valid duration passes the option parse and reaches the AWS
# stage (which fails without live AWS — that failure is not a usage-band code, so
# these two only assert the value was accepted, i.e. NOT rejected in the 10-29
# band). A malformed value (no unit, non-numeric) is a usage error in the reserved
# band, and a missing value is band 11, never a silent fall-through to the default.
test_remote_t_duration_accepted() {
  local rc=0
  bin/remote prod -t 30m -- ingest-colleges >/dev/null 2>&1 || rc=$?
  # Accepted past the option parse: exit is not a usage-band (10-29) rejection.
  [ "$rc" -lt 10 ] || [ "$rc" -gt 29 ]
}
assert_success "remote -t 30m is accepted past the option parse (not a usage-band reject)" test_remote_t_duration_accepted
assert_exit_code "$EXIT_INVALID_ARG_VALUE" "remote -t badval is rejected (band 22)" bin/remote prod -t badval -- ingest-colleges
test_remote_p_duration_accepted() {
  local rc=0
  bin/remote prod -p 5s -- ingest-colleges >/dev/null 2>&1 || rc=$?
  [ "$rc" -lt 10 ] || [ "$rc" -gt 29 ]
}
assert_success "remote -p 5s is accepted past the option parse (not a usage-band reject)" test_remote_p_duration_accepted
# -p 0s is a SUPPORTED value: -p is the poll interval, and 0 means poll with no
# pause until the command reaches a terminal status (sleep 0 is a valid no-op); it
# terminates (SSM's own -t returns TimedOut, which the loop breaks on). So it must
# pass the option parse, NOT be rejected in the usage band.
test_remote_p_zero_duration_accepted() {
  local rc=0
  bin/remote prod -p 0s -- ingest-colleges >/dev/null 2>&1 || rc=$?
  [ "$rc" -lt 10 ] || [ "$rc" -gt 29 ]
}
assert_success "remote -p 0s is accepted past the option parse (not a usage-band reject)" test_remote_p_zero_duration_accepted
assert_exit_code "$EXIT_INVALID_ARG_VALUE" "remote -p non-duration is rejected (band 22)" bin/remote prod -p abc -- ingest-colleges
assert_exit_code "$EXIT_INVALID_ARG_VALUE" "remote -p 0 (no unit) is rejected (band 22)" bin/remote prod -p 0 -- ingest-colleges
assert_exit_code "$EXIT_OPTION_REQUIRES_VALUE" "remote -p (missing value) is rejected (band 11)" bin/remote prod -p -- ingest-colleges

# bin/ingest-colleges argument validation (no AWS reached: the arity guard fires
# before resolve_file_arg / the launcher).
assert_success "ingest-colleges -h exits 0" bin/ingest-colleges -h
assert_exit_code "$EXIT_MISSING_REQUIRED_ARG" "ingest-colleges with no args exits 21" bin/ingest-colleges
assert_exit_code "$EXIT_MISSING_REQUIRED_ARG" "ingest-colleges with one arg exits 21" bin/ingest-colleges only.csv
assert_exit_code "$EXIT_MISSING_REQUIRED_ARG" "ingest-colleges with four args exits 21" bin/ingest-colleges a.csv b.csv c.json d.csv
test_ingest_colleges_missing_file() {
  bin/ingest-colleges "/no/such/$$-institution.csv" "/no/such/$$-fields.csv" >/dev/null 2>&1
}
assert_failure "ingest-colleges fatals on a nonexistent local CSV path" test_ingest_colleges_missing_file

# Provenance routing (RFC 139): the launcher must receive the caller's ORIGINAL
# source args as explicit --*-source flags after the three resolved paths — no
# environment side channel. Exercised end to end against a fake checkout whose
# college launcher is a stub that captures its argv.
test_ingest_colleges_source_flags() {
  local root parent stub argv inst fields entry rc
  parent="$(mktemp -d)"
  root="$parent/unicoach-ingestflags"
  mkdir -p "$root"
  for entry in bin .env .env.dev .env.test .env.fuzz db; do
    ln -s "$PROJECT_ROOT/$entry" "$root/$entry"
  done
  stub="$root/college/build/install/college/bin/college"
  argv="$parent/launcher-argv"
  mkdir -p "$(dirname "$stub")"
  printf '#!/usr/bin/env bash\nprintf "%%s\\n" "$@" > %q\n' "$argv" > "$stub"
  chmod +x "$stub"
  inst="$parent/institution.csv"; fields="$parent/fields.csv"
  : > "$inst"; : > "$fields"
  # Keep the run's output and replay it on failure only: a green run stays
  # quiet, a red one explains itself instead of reporting a bare "test failed".
  local log="$parent/ingest.log"
  # rc must be captured from the command itself, NOT inside `if ! cmd; then`:
  # there $? is the NEGATION's status (always 0), so the failure path would
  # return success and this test would pass vacuously on a broken ingest.
  rc=0
  "$root/bin/ingest-colleges" "$inst" "$fields" > "$log" 2>&1 || rc=$?
  if [ "$rc" -ne 0 ]; then
    echo "ingest-colleges exited [$rc]:" >&2
    cat "$log" >&2
    rm -rf "$parent"
    return "$rc"
  fi
  grep -qxF -- "--institution-source=$inst" "$argv" &&
    grep -qxF -- "--fields-source=$fields" "$argv" &&
    grep -qxF -- "--aliases-source=$root/db/data/college-aliases.json" "$argv" &&
    grep -qxF -- "--money-vocabulary-source=$root/db/data/money-vocabulary.json" "$argv"
  rc=$?
  [ "$rc" -eq 0 ] || { echo "launcher argv was:" >&2; cat "$argv" >&2; }
  rm -rf "$parent"
  return "$rc"
}
assert_success "ingest-colleges passes original source args to the launcher as --*-source flags" test_ingest_colleges_source_flags

# Channel discipline (RFC 158 / bin conventions): on a normal run the wrapper
# writes NOTHING of its own to stdout -- every diagnostic, including the final
# summary, is stderr traffic. Exercised with the same stub-launcher fixture as
# the flags test above (the stub writes its argv to a file, not to stdout), so
# any stdout byte observed here is the wrapper's own regression.
test_ingest_colleges_stdout_stays_empty() {
  local root parent stub inst fields entry rc stdout stderr
  parent="$(mktemp -d)"
  root="$parent/unicoach-ingeststdout"
  mkdir -p "$root"
  for entry in bin .env .env.dev .env.test .env.fuzz db; do
    ln -s "$PROJECT_ROOT/$entry" "$root/$entry"
  done
  stub="$root/college/build/install/college/bin/college"
  mkdir -p "$(dirname "$stub")"
  printf '#!/usr/bin/env bash\nprintf "%%s\\n" "$@" > %q\n' "$parent/launcher-argv" > "$stub"
  chmod +x "$stub"
  inst="$parent/institution.csv"; fields="$parent/fields.csv"
  : > "$inst"; : > "$fields"
  stdout="$parent/stdout"; stderr="$parent/stderr"
  rc=0
  "$root/bin/ingest-colleges" "$inst" "$fields" > "$stdout" 2> "$stderr" || rc=$?
  if [ "$rc" -ne 0 ]; then
    log-error "ingest-colleges exited [$rc], stderr [$(cat "$stderr")]"
    rm -rf "$parent"
    return 1
  fi
  if [ -s "$stdout" ]; then
    log-error "stdout is not empty, it holds [$(cat "$stdout")]"
    rm -rf "$parent"
    return 1
  fi
  rm -rf "$parent"
}
assert_success "ingest-colleges writes nothing of its own to stdout on a normal run" \
  test_ingest_colleges_stdout_stays_empty
# An explicitly-empty aliases argument is a wrong value, not an omitted one: it
# must be refused, never silently replaced by the repo default (RFC 139).
assert_exit_code "$EXIT_MISSING_REQUIRED_ARG" "ingest-colleges rejects an explicitly-empty aliases argument" \
  bin/ingest-colleges a.csv b.csv ""
# ── RFC 140: CDS seed group on ingest-colleges + bin/fetch-cds-seed ───────────
echo ""
echo "==== Testing RFC 140 CDS seed surfaces ===="

assert_success "bin/fetch-cds-seed parses as python3" \
  python3 -c "import ast; ast.parse(open('$PROJECT_ROOT/bin/fetch-cds-seed').read())"

# The CDS options are all-or-nothing (one source group, RFC 140 / 0004 D19).
assert_exit_code "$EXIT_MISSING_REQUIRED_ARG" "ingest-colleges with only -m exits 21" \
  bin/ingest-colleges -m merit.csv a.csv b.csv
assert_exit_code "$EXIT_MISSING_REQUIRED_ARG" "ingest-colleges with -m -a but no -d exits 21" \
  bin/ingest-colleges -m merit.csv -a factors.csv a.csv b.csv
# RFC 170 made the group four: three of the four is still a partial load.
assert_exit_code "$EXIT_MISSING_REQUIRED_ARG" "ingest-colleges with -m -a -d but no -p exits 21" \
  bin/ingest-colleges -m merit.csv -a factors.csv -d deadlines.csv a.csv b.csv
assert_exit_code "$EXIT_OPTION_REQUIRES_VALUE" "ingest-colleges -m without a value exits 11" \
  bin/ingest-colleges -m
assert_exit_code "$EXIT_UNKNOWN_OPTION" "ingest-colleges rejects an unknown option (10)" \
  bin/ingest-colleges -z a.csv b.csv
test_ingest_colleges_missing_cds_file() {
  bin/ingest-colleges -m "/no/such/$$-m.csv" -a "/no/such/$$-a.csv" -d "/no/such/$$-d.csv" \
    -p "/no/such/$$-p.csv" bin/functions bin/functions >/dev/null 2>&1
}
assert_failure "ingest-colleges fatals on a nonexistent CDS seed path" test_ingest_colleges_missing_cds_file

# Fetcher normalisation against recorded fixture JSON (-F: no network). Covers
# the RFC 140 interpretation rules end to end: per-fact-group document
# selection (newest doc that reports the group, with the fallback counted), the
# C7 rating whitelist (junk dropped, not guessed), currency parsing, the
# 2025-26 split month/day deadline mapping vs the 2024-25 free-text mapping
# (incl. the Excel-mangled '1-Jan' day-month form), the refusal of an unmapped
# schema_version, the half-date rule (month-only kept, orphan day dropped), the
# impossible-calendar-pair rule (Feb 30 is never seeded), the all-or-nothing
# contradictory H2A block, the tri-state rolling flag, and the drop ledger.

# The recorded two-template corpus: alpha (2024-25 + 2025-26 docs), beta
# (free-text dates, rolling), gamma (per-group fallback), delta (unmapped
# schema), epsilon (contradictory H2A), zeta (Feb 30, junk int, junk flag,
# duplicate + parse_error field rows, rolling reported as "No"), eta (a
# manifest row with no school_id). Wrapped in a function, per this file's
# convention: fixture data is detail, not top-level script body.
