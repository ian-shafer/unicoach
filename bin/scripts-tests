CDS_FIXTURES="$(mktemp -d)"
# No EXIT trap here: the harness's daemon-teardown trap (top of file) must not
# be clobbered. The dirs are removed at the end of this section; a mid-section
# failure aborts the run and leaks two mktemp dirs, which is acceptable.
CDS_OUT="$(mktemp -d)"
write_cds_fixtures "$CDS_FIXTURES"
assert_success "fetch-cds-seed runs offline from fixtures" \
  bin/fetch-cds-seed -F "$CDS_FIXTURES" -o "$CDS_OUT" > /dev/null

# The bin/ rule: this script's product is FILES, so a normal run writes nothing
# at all to stdout -- the closing summary is a diagnostic and goes to stderr
# with every other one. Asserted, because the regression is invisible: a
# summary moved back to stdout still looks right on a terminal, where the two
# streams are the same screen.
test_cds_fetch_stdout_is_empty() {
  local out
  out="$(bin/fetch-cds-seed -F "$CDS_FIXTURES" -o "$(mktemp -d)" 2>/dev/null)"
  [ -z "$out" ]
}
assert_success "fetch-cds-seed writes NOTHING to stdout on a normal run" \
  test_cds_fetch_stdout_is_empty

# ... and the summary is still emitted, on stderr.
test_cds_fetch_summary_on_stderr() {
  bin/fetch-cds-seed -F "$CDS_FIXTURES" -o "$(mktemp -d)" 2>&1 >/dev/null |
    grep -q "seed written to"
}
assert_success "fetch-cds-seed's closing summary goes to stderr" \
  test_cds_fetch_summary_on_stderr

seed_has() { grep -q "$1" "$CDS_OUT/$2"; }
seed_lacks() { ! grep -q "$1" "$CDS_OUT/$2"; }

# PROVENANCE's drop ledger is STRUCTURED (counts, a bounded sample of the
# offending documents per reason, and the per-fact-group counters nested under
# their group rather than glued into the reason string), so these read it as
# JSON instead of grepping an assembled key.
cds_drop_count() {
  python3 - "$CDS_OUT/PROVENANCE.json" "$1" "$2" << 'PY'
import json, sys
dropped = json.load(open(sys.argv[1]))["corpus"]["dropped"]
actual = dropped["by_reason"].get(sys.argv[2], 0)
if actual != int(sys.argv[3]):
    sys.exit(f"dropped.{sys.argv[2]} is {actual}, expected {sys.argv[3]}")
PY
}
cds_group_drop_count() {
  python3 - "$CDS_OUT/PROVENANCE.json" "$1" "$2" "$3" << 'PY'
import json, sys
group = json.load(open(sys.argv[1]))["corpus"]["dropped"]["by_group"].get(sys.argv[2], {})
actual = group.get("by_reason", {}).get(sys.argv[3], 0)
if actual != int(sys.argv[4]):
    sys.exit(f"dropped.{sys.argv[2]}.{sys.argv[3]} is {actual}, expected {sys.argv[4]}")
PY
}
cds_drop_sample_has() {
  python3 - "$CDS_OUT/PROVENANCE.json" "$1" "$2" << 'PY'
import json, sys
samples = json.load(open(sys.argv[1]))["corpus"]["dropped"]["samples"].get(sys.argv[2], [])
if not any(sys.argv[3] in entry for entry in samples):
    sys.exit(f"no sample for {sys.argv[2]} contains [{sys.argv[3]}]: {samples}")
PY
}
cds_group_sample_has() {
  python3 - "$CDS_OUT/PROVENANCE.json" "$1" "$2" "$3" << 'PY'
import json, sys
group = json.load(open(sys.argv[1]))["corpus"]["dropped"]["by_group"].get(sys.argv[2], {})
samples = group.get("samples", {}).get(sys.argv[3], [])
if not any(sys.argv[4] in entry for entry in samples):
    sys.exit(f"no {sys.argv[2]}.{sys.argv[3]} sample contains [{sys.argv[4]}]: {samples}")
PY
}

# Latest-doc selection: alpha's merit facts come from the 2025-26 doc only;
# the currency-text average parses; the grouping comma in H.201 parses.
assert_success "merit row uses the latest doc, currency parsed" \
  seed_has '^111111,2025,1000,100,12000,' merit-aid.csv
assert_success "the superseded 2024-25 alpha doc contributes nothing" \
  seed_lacks '^111111,2024' merit-aid.csv
# C7 whitelist: 'Very Important' -> very_important; junk 'X' -> empty cell.
assert_success "factor whitelist normalises and drops junk" \
  seed_has '^111111,2025,very_important,,' admission-factors.csv
# 2025-26 split-style ED1 closing month/day; EA offered=false carried.
assert_success "2025-26 split ED1 closing lands as month/day" \
  seed_has '^111111,2025,early_decision_1,true,11,15,,,' deadlines.csv
assert_success "EA offered=No lands as false" \
  seed_has '^111111,2025,early_action,false,' deadlines.csv
# 2024-25 free-text mapping: C.2104/05 are the ED2 dates there, and the
# Excel-mangled '1-Jan'/'1-Mar' day-month forms parse via month names.
assert_success "2024-25 free-text ED2 dates parse ('1-Jan' form)" \
  seed_has '^222222,2024,early_decision_2,true,1,1,3,1,' deadlines.csv
assert_success "2024-25 regular closing month/day lands" \
  seed_has '^222222,2024,regular,true,1,15,,,' deadlines.csv
assert_success "the rolling checkbox emits a flags-only round" \
  seed_has '^222222,2024,rolling,true,,,,,' deadlines.csv
# beta reported no whitelisted rating at all -> no factors row.
assert_success "a school with only junk ratings gets no factors row" \
  seed_lacks '^222222,' admission-factors.csv

# Per-fact-group selection: gamma's newest (2025-26) doc reports only the C7
# grid, so merit aid falls back to the newest doc that DOES report it (2024-25)
# rather than being forfeited. The two rows carry their own source_year.
assert_success "merit aid falls back to an older doc that reports it" \
  seed_has '^333333,2024,,,5000,https://gamma.example.edu/cds-2024-25.pdf' merit-aid.csv
assert_success "the same school's factors still come from its newest doc" \
  seed_has '^333333,2025,considered,' admission-factors.csv
assert_success "the fallback is counted under its fact group in PROVENANCE.json" \
  cds_group_drop_count merit_aid fell_back_to_older_doc 1
assert_success "the passed-over document is named, with why it was passed over" \
  cds_group_sample_has merit_aid passed_over 'document_id=[doc-gamma-new]'

# An unmapped schema_version (a template whose C21/C22 numbering this script
# has not been taught) refuses that document's DEADLINES -- never guesses a
# numbering -- while its other fact groups are unaffected.
assert_success "an unmapped schema_version emits no deadline rows" \
  seed_lacks '^444444,' deadlines.csv
assert_success "the unmapped document still seeds its factor grid" \
  seed_has '^444444,2026,important,' admission-factors.csv
assert_success "the unmapped schema is counted in PROVENANCE.json" \
  cds_drop_count deadline_schema_unmapped 1
# A count alone names no template to teach; the offending version is the datum.
assert_success "the unmapped schema_version itself is recorded" \
  cds_drop_sample_has deadline_schema_unmapped 'schema_version=[2026-27]'

# Half-dates: a month with no day is real CDS reporting and is kept; a DAY with
# no month is not a date, and the orphan component is dropped.
assert_success "a month with no day is kept (priority closing month only)" \
  seed_has '^111111,2025,priority,true,3,,,,' deadlines.csv
assert_success "a day with no month is dropped, not half-reported" \
  seed_has '^111111,2025,regular,true,,,,,' deadlines.csv
assert_success "the orphan day is counted in PROVENANCE.json" \
  cds_drop_count deadline_day_without_month 1
assert_success "the drop names the document it came from" \
  cds_drop_sample_has deadline_day_without_month 'document_id=[doc-alpha-new]'

# A contradictory H2A block (more no-need merit awards than freshmen) is
# unreported IN FULL: the average award from the same block never ships alone.
assert_success "a contradictory H2A block emits no merit row at all" \
  seed_lacks '^555555,' merit-aid.csv
assert_success "the contradictory H2A block is counted in PROVENANCE.json" \
  cds_drop_count merit_h2a_contradictory 1

# Impossible calendar pairs are never seeded and so never cited: Feb 30 is
# extraction junk, so the day is dropped (counted) and the reported MONTH is
# kept, exactly as a month-only cell would be.
assert_success "an impossible month/day pair keeps the month, drops the day" \
  seed_has '^666666,2025,regular,true,2,,,,' deadlines.csv
assert_success "the impossible pair is counted in PROVENANCE.json" \
  cds_drop_count deadline_impossible_month_day 1
assert_success "the impossible pair itself is recorded" \
  cds_drop_sample_has deadline_impossible_month_day 'month=[2] day=[30]'

# The rolling flag is tri-state like every other round's: an explicitly
# reported "no rolling admission" is a citable fact, not silence. (The value
# arrives as a real JSON false in value_bool, which must not coerce to true.)
assert_success "a reported 'no rolling admission' lands as offered=false" \
  seed_has '^666666,2025,rolling,false,,,,,' deadlines.csv

# Reported-but-unparseable merit ints and deadline flags are counted, like the
# C7 grid's junk ratings: PROVENANCE is the complete ledger or it is a lie.
assert_success "a reported-but-unparseable merit int is counted" \
  cds_drop_count merit_int_junk 1
