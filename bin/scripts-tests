# ── bin/common layering (RFC 95): ENV_FILES string, both-set, empty base ───────
echo "==== Testing bin/common dotenv layering ===="

# ENV_FILES layers left-to-right over the base: a key set only in the last delta
# wins over an earlier delta wins over the base. Drives a real child bin/common.
test_env_files_layering() {
  local dev test_delta out
  dev="$(mktemp)"; test_delta="$(mktemp)"
  printf 'POSTGRES_PORT=5432\nLAYER_KEY=from_dev\n' > "$dev"
  printf 'LAYER_KEY=from_test\n' > "$test_delta"
  out="$(ENV_FILES="$dev:$test_delta" bash -c 'source "'"$PROJECT_ROOT"'/bin/common"; echo "$LAYER_KEY"' 2>&1)"
  rm -f "$dev" "$test_delta"
  [ "$out" = "from_test" ] || { echo "LAYER_KEY was [$out]"; return 1; }
}
assert_success "ENV_FILES layers deltas left-to-right (last wins)" test_env_files_layering

# ENV_FILE and ENV_FILES together fatal (mutually exclusive).
test_env_file_and_files_mutually_exclusive() {
  local delta
  delta="$(mktemp)"
  printf 'POSTGRES_PORT=5432\n' > "$delta"
  ENV_FILE="$delta" ENV_FILES="$delta" bash -c 'source "'"$PROJECT_ROOT"'/bin/common"' >/dev/null 2>&1
  local rc=$?
  rm -f "$delta"
  [ "$rc" -ne 0 ]
}
assert_success "ENV_FILE + ENV_FILES set together fatals" test_env_file_and_files_mutually_exclusive

# Empty base + ENV_FILE=<complete>: sourcing yields exactly the complete file's
# values and does not fatal (no "deploy host has no .env" special case). Runs in a
# throwaway PROJECT_ROOT whose .env is empty.
test_empty_base_host_shape() {
  local root complete out
  root="$(mktemp -d)"; mkdir -p "$root/bin"
  cp "$PROJECT_ROOT/bin/functions" "$PROJECT_ROOT/bin/common" "$root/bin/"
  printf '# intentionally empty base\n' > "$root/.env"
  complete="$root/etc-env"
  printf 'POSTGRES_PORT=5432\nHOST_KEY=complete\n' > "$complete"
  # Clear the harness's exported ENV_FILES so pinning a single ENV_FILE does not
  # trip the mutual-exclusion fatal (this simulates the on-host caller, which sets
  # only ENV_FILE=/etc/unicoach/env).
  out="$(env -u ENV_FILES ENV_FILE="$complete" bash -c 'source "'"$root"'/bin/common"; echo "$HOST_KEY"' 2>&1)"
  local rc=$?
  rm -rf "$root"
  [ "$rc" -eq 0 ] && [ "$out" = "complete" ] || { echo "rc=$rc HOST_KEY=[$out]"; return 1; }
}
assert_success "empty base + ENV_FILE=<complete> yields the complete values, no fatal" test_empty_base_host_shape

# ── bin/gen-deployed-env (RFC 95) ─────────────────────────────────────────────
echo "==== Testing gen-deployed-env ===="

# Build a throwaway env root with its own .env/.env.dev/.env.<env> so the test is
# hermetic (never touches the repo's real cloud env files). Echoes the root.
make_gen_env_root() {
  local root; root="$(mktemp -d)"
  mkdir -p "$root/bin"
  cp "$PROJECT_ROOT/bin/functions" "$PROJECT_ROOT/bin/common" "$PROJECT_ROOT/bin/gen-deployed-env" "$root/bin/"
  # No POSTGRES_DB here: RFC 156 removed it from the real base .env (dev derives
  # it per worktree), so a fixture that still set it would model the pre-RFC
  # world and keep these cases green through a base-removal regression.
  cat > "$root/.env" <<'EOF'
POSTGRES_PORT=5432
DATABASE_MAXIMUM_POOL_SIZE=10
PUBLIC_WEB_PORT=8082
ADMIN_WEB_PORT=8081
SERVER_PORT=8080
EOF
  # .env.dev carries a dev value for a DEPLOY_VAR_NAMES key (GOOGLE_AUTH_PROVIDER)
  # that the cloud fixture below deliberately OMITS — the leak-close under test.
  cat > "$root/.env.dev" <<'EOF'
GOOGLE_AUTH_PROVIDER=stub
DATABASE_PASSWORD=devpassword
PGHOST=localhost
POSTGRES_USER=postgres
DATABASE_USER=unicoach
APP_DOMAIN=localhost
EOF
  echo "$root"
}

# Full, valid cloud fixture (all DEPLOY_VAR_NAMES keys present).
write_full_cloud_env() {
  cat > "$1/.env.gentest" <<'EOF'
POSTGRES_DB=unicoach
APP_DOMAIN=gentest.example.com
GOOGLE_CLIENT_IDS=abc.apps.googleusercontent.com
APPLE_CLIENT_IDS=com.example.gentest
SERVER_HOST=0.0.0.0
PUBLIC_WEB_HOST=0.0.0.0
ADMIN_WEB_HOST=0.0.0.0
SESSION_COOKIE_SECURE=true
ADMIN_COOKIE_SECURE=true
EMAIL_PROVIDER=ses
CHAT_PROVIDER=anthropic
GOOGLE_AUTH_PROVIDER=google
APPLE_AUTH_PROVIDER=apple
APP_STORE_ENVIRONMENT=production
EMAIL_DEFAULT_FROM=noreply@$APP_DOMAIN
PUBLIC_WEB_URL_BASE=https://app.$APP_DOMAIN
EOF
}

test_gen_deployed_env_happy() {
  local root out err rc=0; root="$(make_gen_env_root)"; write_full_cloud_env "$root"
  # Keep stderr: gen-deployed-env fatals name the offending key, which is the
  # whole diagnosis. Discarding it (2>/dev/null) reduced a failure to a bare
  # "exit 22" and cost real time the last time this fixture drifted.
  out="$("$root/bin/gen-deployed-env" gentest 2> "$root/stderr")" || rc=$?
  err="$(cat "$root/stderr")"
  rm -rf "$root"
  [ "$rc" -eq 0 ] || { echo "exit $rc: $err"; return 1; }
  # APP_DOMAIN reflects the delta; EMAIL_DEFAULT_FROM interpolation is resolved;
  # nothing has a surviving '$'; and PATH/HOME are absent.
  echo "$out" | grep -qx 'APP_DOMAIN=gentest.example.com' || { echo "APP_DOMAIN wrong: $out"; return 1; }
  echo "$out" | grep -qx 'EMAIL_DEFAULT_FROM=noreply@gentest.example.com' || { echo "email not interpolated: $out"; return 1; }
  # The ONE public-web origin (RFC 155 D-J) ships, and the retired per-link keys
  # do not: service.conf derives both page links from this single value.
  echo "$out" | grep -qx 'PUBLIC_WEB_URL_BASE=https://app.gentest.example.com' || { log-error "public-web origin wrong: [$out]"; return 1; }
  echo "$out" | grep -qE '^(EMAIL_VERIFICATION_VERIFY_URL_BASE|COST_REPORT_SHARE_URL_BASE)=' && { log-error "retired per-link key shipped: [$out]"; return 1; }
  echo "$out" | grep -q '[$]' && { echo "unresolved \$ in output: $out"; return 1; }
  echo "$out" | grep -qE '^(PATH|HOME)=' && { echo "leaked PATH/HOME: $out"; return 1; }
  return 0
}
assert_success "gen-deployed-env emits resolved DEPLOY_VAR_NAMES, no \$/PATH/HOME leak" test_gen_deployed_env_happy

# An unresolvable <env> must stop AT the resolution failure. `fatal` inside the
# pre-common `ENV_FILE="$(unicoach_env_file …)"` substitution exits only that
# SUBSHELL, so without the prelude's own `set -euo pipefail` the script ran on
# with an empty ENV_FILE and died later on a missing key — printing a second,
# misleading fatal and exiting with that symptom's code instead of this one's.
test_gen_deployed_env_bad_env_stops_at_resolution() {
  local root err rc=0; root="$(make_gen_env_root)"
  "$root/bin/gen-deployed-env" nosuchenv > /dev/null 2> "$root/stderr" || rc=$?
  err="$(cat "$root/stderr")"
  rm -rf "$root"
  [ "$rc" -eq "$EXIT_INVALID_ARG_VALUE" ] || { echo "exit $rc (want $EXIT_INVALID_ARG_VALUE): $err"; return 1; }
  echo "$err" | grep -q 'environment file not found for \[nosuchenv\]' || { echo "did not name the env: $err"; return 1; }
  # Exactly one fatal: a second means the script continued past the failure.
  local fatals; fatals="$(echo "$err" | grep -c '\[FATAL\]')"
  [ "$fatals" -eq 1 ] || { echo "expected 1 fatal, got $fatals: $err"; return 1; }
  return 0
}
assert_success "gen-deployed-env stops at an unresolvable <env> (one fatal, band 22)" test_gen_deployed_env_bad_env_stops_at_resolution

test_gen_deployed_env_no_secret_or_identity_leak() {
  local root out err rc=0; root="$(make_gen_env_root)"; write_full_cloud_env "$root"
  out="$("$root/bin/gen-deployed-env" gentest 2> "$root/stderr")" || rc=$?
  err="$(cat "$root/stderr")"
  rm -rf "$root"
  # Assert the run SUCCEEDED and emitted something before asserting what is
  # absent from it. Without this the case passes vacuously on empty output — a
  # fatal makes "no secrets present" trivially true, which is exactly how it
  # stayed green while the fixture was broken.
  [ "$rc" -eq 0 ] || { echo "exit $rc: $err"; return 1; }
  [ -n "$out" ] || { echo "exit 0 but no output to inspect: $err"; return 1; }
  # None of the secrets nor the four Terraform-owned RDS-identity keys appear.
  # Name what leaked: this is the assertion most likely to fire on a real
  # regression, and "the leak test failed" without the key is a bisect, not a
  # diagnosis. `if` rather than `&&` because no-match is grep's exit 1 and is the
  # PASSING outcome here, so it reads as a condition, not a failure.
  local leaked
  if leaked="$(printf '%s\n' "$out" | grep -E '^(DATABASE_PASSWORD|CHAT_ANTHROPIC_API_KEY|PGPASSWORD)=')"; then
    echo "secret key(s) leaked: $(printf '%s\n' "$leaked" | cut -d= -f1 | tr '\n' ' ')"
    return 1
  fi
  if leaked="$(printf '%s\n' "$out" | grep -E '^(PGHOST|DATABASE_HOST|POSTGRES_USER|DATABASE_USER)=')"; then
    echo "RDS-identity key(s) leaked: $(printf '%s\n' "$leaked" | cut -d= -f1 | tr '\n' ' ')"
    return 1
  fi
  return 0
}
assert_success "gen-deployed-env leaks no secret nor RDS-identity key" test_gen_deployed_env_no_secret_or_identity_leak

# .env.dev is NOT layered: a DEPLOY_VAR_NAMES key present in .env.dev but omitted
# from the cloud fixture is UNSET, so gen-deployed-env fatals naming it (it does
# not inherit the dev value and emit it). This is the direct leak-close test.
test_gen_deployed_env_omitted_key_fatals() {
  local root err; root="$(make_gen_env_root)"
  # Full fixture MINUS GOOGLE_AUTH_PROVIDER (which IS present in .env.dev).
  write_full_cloud_env "$root"
  grep -v '^GOOGLE_AUTH_PROVIDER=' "$root/.env.gentest" > "$root/.env.gentest.tmp"
  mv "$root/.env.gentest.tmp" "$root/.env.gentest"
  err="$("$root/bin/gen-deployed-env" gentest 2>&1 >/dev/null)"
  local rc=$?
  rm -rf "$root"
  [ "$rc" -ne 0 ] || { echo "expected nonzero exit"; return 1; }
  echo "$err" | grep -q 'GOOGLE_AUTH_PROVIDER' || { echo "did not name the missing key: $err"; return 1; }
}
assert_success "gen-deployed-env fatals (no dev leak) when a key is omitted from .env.<env>" test_gen_deployed_env_omitted_key_fatals

# Complement: a key present in BOTH .env.dev and .env.<env> with different values
# emits the .env.<env> value, never the .env.dev one.
test_gen_deployed_env_delta_value_wins() {
  local root out; root="$(make_gen_env_root)"; write_full_cloud_env "$root"
  out="$("$root/bin/gen-deployed-env" gentest 2>/dev/null)"
  rm -rf "$root"
  # APP_DOMAIN is localhost in .env.dev, gentest.example.com in the delta.
  echo "$out" | grep -qx 'APP_DOMAIN=gentest.example.com' || { echo "delta value did not win: $out"; return 1; }
}
assert_success "gen-deployed-env: .env.<env> value wins over .env.dev" test_gen_deployed_env_delta_value_wins

# RFC 156 removed POSTGRES_DB from the base .env and re-added it to .env.prod.
# Asserted against the REAL env files, not the hermetic gentest fixture: the
# fixture writes its own base, so it cannot see a regression in .env.prod at all.
# infra/rds.tf OWNS the name -- `db_name = "unicoach"` is what RDS actually
# creates -- and POSTGRES_DB is what the instance JVM connects to. So assert the
# PAIRING, not the literal: an assertion on the literal `unicoach` stays GREEN
# after a rename in rds.tf while the JVM points at a database RDS never created.
# Read-only: gen-deployed-env only prints, and the sed only reads.
#
# WHY sed AND NOT A TOFU OUTPUT: `tofu output` requires an INITIALISED working
# directory (a provider download and, for this stack, remote state and AWS
# credentials), so reading the value the "proper" way would make a pure shell
# assertion depend on network, credentials, and `tofu init` — and it would then
# report a broken pairing as a green skip whenever those are absent. `db_name =
# "..."` is a literal in one HCL file, and this sed reads exactly that line
# shape; a value that stopped matching it yields an empty string, which the
# guard below turns into a FAILURE rather than a pass.
test_gen_deployed_env_prod_postgres_db() {
  local out err diag rds_db rc=0
  rds_db="$(sed -n 's/^[[:space:]]*db_name[[:space:]]*=[[:space:]]*"\(.*\)"[[:space:]]*$/\1/p' "$PROJECT_ROOT/infra/rds.tf")"
  if [ -z "$rds_db" ]; then
    echo "could not read db_name from infra/rds.tf -- the pairing is unasserted, not satisfied"
    return 1
  fi
  err="$(mktemp)"
  out="$(env -u ENV_FILES -u ENV_FILE "$PROJECT_ROOT/bin/gen-deployed-env" prod 2> "$err")" || rc=$?
  diag="$(cat "$err")"; rm -f "$err"
  [ "$rc" -eq 0 ] || { echo "gen-deployed-env prod exited $rc: $diag"; return 1; }
  echo "$out" | grep -qx "POSTGRES_DB=$rds_db" \
    || { echo "prod POSTGRES_DB [$(echo "$out" | grep '^POSTGRES_DB=')] does not match infra/rds.tf db_name [$rds_db]. stderr: $diag"; return 1; }
  return 0
}
assert_success "gen-deployed-env prod POSTGRES_DB matches infra/rds.tf db_name (RFC 156)" test_gen_deployed_env_prod_postgres_db

# ── render-env merge (RFC 95) ─────────────────────────────────────────────────
echo "==== Testing render-env merge ===="

# Stub `aws ssm get-parameters-by-path` by putting a fake `aws` first on PATH that
# emits the given Name<TAB>Value rows. Echoes the stub dir (caller removes it).
make_aws_stub() {
  local rows_file="$1" stub_dir
  stub_dir="$(mktemp -d)"
  cat > "$stub_dir/aws" <<EOF
#!/usr/bin/env bash
# Only the get-parameters-by-path text query is stubbed; echo the fixture rows.
cat "$rows_file"
EOF
  chmod +x "$stub_dir/aws"
  echo "$stub_dir"
}

test_render_env_merge() {
  local release rows stub out_env
  release="$(mktemp -d)"; rows="$(mktemp)"; out_env="$(mktemp)"
  # deploy-env (non-secret box config) — includes APP_DOMAIN, which SSM ALSO sets
  # to a different value below to prove SSM wins on overlap.
  printf 'APP_DOMAIN=from-deploy-env\nEMAIL_PROVIDER=ses\n' > "$release/deploy-env"
  # SSM rows: a secret, an RDS-identity key, and an overlapping APP_DOMAIN.
  printf '/unicoach/test/DATABASE_PASSWORD\treal-secret\n/unicoach/test/PGHOST\trds.example.com\n/unicoach/test/APP_DOMAIN\tfrom-ssm\n' > "$rows"
  stub="$(make_aws_stub "$rows")"
  PATH="$stub:$PATH" SSM_PREFIX="/unicoach/test" ENV_PATH="$out_env" \
    ENV_OWNER="$(id -un)" ENV_GROUP="$(id -gn)" \
    bash "$PROJECT_ROOT/infra/files/render-env.sh" "$release" >/dev/null 2>&1
  local rc=$?
  local mode content
  content="$(cat "$out_env" 2>/dev/null)"
  # GNU stat (nix dev shell) uses -c '%a'; BSD/macOS stat uses -f '%Lp'. Try GNU
  # first, fall back to BSD, so the mode check is portable across both.
  mode="$(stat -c '%a' "$out_env" 2>/dev/null || stat -f '%Lp' "$out_env" 2>/dev/null)"
  rm -rf "$release" "$stub"; rm -f "$rows" "$out_env"
  [ "$rc" -eq 0 ] || { echo "render-env exit $rc"; return 1; }
  # Union: the non-overlapping deploy-env key survives; both SSM-only keys present.
  echo "$content" | grep -qx 'EMAIL_PROVIDER=ses' || { echo "deploy-env key lost: $content"; return 1; }
  echo "$content" | grep -qx 'DATABASE_PASSWORD=real-secret' || { echo "SSM secret missing: $content"; return 1; }
  echo "$content" | grep -qx 'PGHOST=rds.example.com' || { echo "SSM identity missing: $content"; return 1; }
  # SSM wins on APP_DOMAIN overlap: the deploy-env value must NOT be the effective
  # one. The merged file lists deploy-env keys SSM does not override, then all SSM
  # keys; assert the deploy-env APP_DOMAIN line is absent and the SSM one present.
  echo "$content" | grep -qx 'APP_DOMAIN=from-deploy-env' && { echo "deploy-env APP_DOMAIN not overridden: $content"; return 1; }
  echo "$content" | grep -qx 'APP_DOMAIN=from-ssm' || { echo "SSM APP_DOMAIN missing: $content"; return 1; }
  [ "$mode" = "600" ] || { echo "mode was [$mode], expected 600"; return 1; }
  return 0
}
assert_success "render-env merges deploy-env under SSM (SSM wins), mode 0600" test_render_env_merge

# An unseeded PLACEHOLDER secret still fails closed before writing the env file.
test_render_env_placeholder_fatals() {
  local release rows stub out_env
  release="$(mktemp -d)"; rows="$(mktemp)"; out_env="$(mktemp)"
  printf 'APP_DOMAIN=x\n' > "$release/deploy-env"
  printf '/unicoach/test/DATABASE_PASSWORD\tPLACEHOLDER_SEED_OUT_OF_BAND\n' > "$rows"
  stub="$(make_aws_stub "$rows")"
  : > "$out_env"  # ensure it stays empty (must not be written)
  PATH="$stub:$PATH" SSM_PREFIX="/unicoach/test" ENV_PATH="$out_env" \
    ENV_OWNER="$(id -un)" ENV_GROUP="$(id -gn)" \
    bash "$PROJECT_ROOT/infra/files/render-env.sh" "$release" >/dev/null 2>&1
  local rc=$?
  local written; written="$(cat "$out_env" 2>/dev/null)"
  rm -rf "$release" "$stub"; rm -f "$rows" "$out_env"
  [ "$rc" -ne 0 ] || { echo "expected nonzero exit on unseeded PLACEHOLDER"; return 1; }
  [ -z "$written" ] || { echo "env file was written despite PLACEHOLDER: $written"; return 1; }
}
assert_success "render-env fails closed on an unseeded PLACEHOLDER secret" test_render_env_placeholder_fatals

# ── deploy self-updating on-instance bootstrap (build_deploy_command) ──────────
# bin/deploy's SSM Run Command installs this release's render-env /
# deploy-on-instance / units from the bundle before invoking deploy-on-instance, so
# a plain deploy updates its own on-instance bootstrap. The composed command string
# is pure string assembly (build_deploy_command, bin/functions), so the harness
# drives the real function — no live AWS, no source scan. The AWS trigger itself
# (build, upload, send-command) still needs a real deploy to verify end to end.
echo "==== Testing build_deploy_command (deploy self-update) ===="

# bash -n over the two infra/files shell scripts the deploy installs on the host.
for script in render-env deploy-on-instance; do
  assert_success "bash -n infra/files/$script.sh parses cleanly" \
    bash -n "$PROJECT_ROOT/infra/files/$script.sh"
done

# The composed script bakes in the laptop-side bundle-id/region/s3-uri and carries
# every install step: both 0755 scripts, all FIVE 0644 units by explicit name (no
# wildcard, so a missing unit fails install loudly), daemon-reload, and the
# `systemctl enable` step that gives those units reboot persistence.
test_build_deploy_command_content() {
  local out unit
  out="$(build_deploy_command 20260704120000 us-west-2 s3://bkt/releases/unicoach-20260704120000.tar.gz)"
  echo "$out" | grep -qF 'RELEASE_DIR="/opt/unicoach/releases/20260704120000"' || { echo "bundle-id not baked in: $out"; return 1; }
  echo "$out" | grep -qF 'aws s3 cp --region us-west-2 s3://bkt/releases/unicoach-20260704120000.tar.gz' || { echo "region/s3-uri not baked in: $out"; return 1; }
  echo "$out" | grep -qF 'install -m 0755 "$RELEASE_DIR/infra/files/render-env.sh" /opt/unicoach/bin/render-env' || { echo "render-env install missing: $out"; return 1; }
  echo "$out" | grep -qF 'install -m 0755 "$RELEASE_DIR/infra/files/deploy-on-instance.sh" /opt/unicoach/bin/deploy-on-instance' || { echo "deploy-on-instance install missing: $out"; return 1; }
  for unit in rest-server queue-worker cron public-web admin-web; do
    echo "$out" | grep -qF "\"\$RELEASE_DIR/infra/files/unicoach-$unit.service\"" || { echo "unit install source missing for [$unit]: $out"; return 1; }
  done
  echo "$out" | grep -qF '/etc/systemd/system/' || { echo "systemd unit dest missing: $out"; return 1; }
  # No wildcard install: the units are enumerated, not globbed.
  echo "$out" | grep -qF 'unicoach-*.service' && { echo "unexpected wildcard unit install: $out"; return 1; }
  echo "$out" | grep -qF 'systemctl daemon-reload' || { echo "daemon-reload missing: $out"; return 1; }
  echo "$out" | grep -qF 'systemctl enable' || { echo "systemctl enable step missing: $out"; return 1; }
  return 0
}
assert_success "build_deploy_command bakes in values and every install step" test_build_deploy_command_content

# The install + daemon-reload MUST precede the deploy-on-instance invocation — the
# ordering that lets the freshly-installed copy run this deploy.
test_build_deploy_command_install_before_invoke() {
  local out reload_line invoke_line
  out="$(build_deploy_command b us-east-1 s3://x/y.tar.gz)"
  reload_line="$(echo "$out" | grep -nF 'systemctl daemon-reload' | cut -d: -f1)"
  invoke_line="$(echo "$out" | grep -nF '/opt/unicoach/bin/deploy-on-instance "$RELEASE_DIR"' | cut -d: -f1)"
  [ -n "$reload_line" ] && [ -n "$invoke_line" ] || { echo "missing markers: reload=$reload_line invoke=$invoke_line"; return 1; }
  [ "$reload_line" -lt "$invoke_line" ] || { echo "daemon-reload ($reload_line) not before invoke ($invoke_line)"; return 1; }
}
assert_success "build_deploy_command installs+daemon-reload before invoking deploy-on-instance" test_build_deploy_command_install_before_invoke

# The emitted remote script must be syntactically valid bash (the instance runs it).
test_build_deploy_command_valid_bash() {
  local out tmp rc=0
  out="$(build_deploy_command b us-east-1 s3://x/y.tar.gz)"
  tmp="$(mktemp)"
  printf '%s\n' "$out" > "$tmp"
  bash -n "$tmp" || rc=$?
  rm -f "$tmp"
  [ "$rc" -eq 0 ]
}
assert_success "build_deploy_command emits syntactically valid bash" test_build_deploy_command_valid_bash

# json_string encodes the multi-line, quote-bearing script as ONE valid JSON string
# that decodes back verbatim — the send-command --parameters commands=[...] contract.
test_json_string_roundtrips_multiline() {
  local out encoded decoded
  out="$(build_deploy_command b us-east-1 s3://x/y.tar.gz)"
  encoded="$(json_string "$out")"
  decoded="$(printf '%s' "$encoded" | python3 -c 'import json,sys; sys.stdout.write(json.load(sys.stdin))')" || return 1
  [ "$decoded" = "$out" ] || { echo "json round-trip mismatch"; return 1; }
}
assert_success "json_string round-trips the multi-line deploy script through JSON" test_json_string_roundtrips_multiline

# state-apply must TERMINATE, not merely succeed. Argon2 hashing runs on
# Dispatchers.Crypto's pool; when those threads were non-daemon they kept the JVM
# alive after main returned, and the CLI hung forever after doing all its work
# (once for 12 hours). That was patched per-CLI with an exitProcess(0); the real
# fix made the pool daemon, and this asserts the behaviour that fix must deliver.
#
# The assertion is the `timeout`, so the failure mode is exit 124 in ~3 minutes
# rather than a wedged suite: a silent hang is exactly what regressed before, and
# a test that only checked the exit code would pass on a hang by never returning.
# Deliberately end-to-end — a unit test of Thread.isDaemon checks the mechanism,
# not that this process exits, and any future non-daemon pool would reproduce the
# original symptom while leaving such a unit test green.
STATE_APPLY_TIMEOUT_SECS=180
test_state_apply_terminates() {
  bin/build-fixture >/dev/null 2>&1 || return 1
  # -f rebuilds the world from empty, so the create-only applier is re-runnable.
  timeout "$STATE_APPLY_TIMEOUT_SECS" bin/state-apply -f fixtures/dev-users.yaml >/dev/null 2>&1
}
assert_success "state-apply exits on its own after argon2 hashing (no non-daemon pool pinning the JVM)" test_state_apply_terminates

# ── RFC 172: the three external-data wrappers ────────────────────────────────
echo ""
echo "==== Testing RFC 172 external-data wrappers ===="

assert_success "bin/pyfunctions.py parses as python3" \
  python3 -c "import ast; ast.parse(open('$PROJECT_ROOT/bin/pyfunctions.py').read())"
# The four fetchers now IMPORT that module, so parsing each one alone is no
# longer enough: an import resolved against the caller's cwd would parse and then
# fail at run time from any other directory. Imported here from a directory that
# is deliberately not bin/.
test_fetchers_import_pyfunctions_from_anywhere() {
  local fetcher elsewhere
  elsewhere="$(mktemp -d)"
  for fetcher in fetch-scorecard fetch-ipeds fetch-codebooks fetch-cds-seed; do
    if ! (cd "$elsewhere" && "$PROJECT_ROOT/bin/$fetcher" -h > /dev/null 2> "$elsewhere/stderr"); then
      log-error "[$fetcher] could not run from [$elsewhere]: [$(cat "$elsewhere/stderr")]"
      rm -rf "$elsewhere"
      return 1
    fi
  done
  rm -rf "$elsewhere"
}
assert_success "all four fetchers import bin/pyfunctions.py from any working directory" \
  test_fetchers_import_pyfunctions_from_anywhere

# ...and importing it leaves NO bin/__pycache__ behind. bin/ is a reviewed
# directory of scripts, not a package build tree, and an untracked directory
# appearing there on every operator run is a real cost (the fetchers set
# sys.dont_write_bytecode before the import for exactly this).
test_pyfunctions_import_writes_no_bytecode_cache() {
  rm -rf "$PROJECT_ROOT/bin/__pycache__"
  bin/fetch-ipeds -h >/dev/null 2>&1 \
    || { log-error "bin/fetch-ipeds -h failed, so this test never exercised the import"; return 1; }
  [ ! -e "$PROJECT_ROOT/bin/__pycache__" ] && return 0
  log-error "importing bin/pyfunctions.py wrote [$PROJECT_ROOT/bin/__pycache__]"
  rm -rf "$PROJECT_ROOT/bin/__pycache__"
  return 1
}
assert_success "importing bin/pyfunctions.py leaves no __pycache__ in bin/" \
  test_pyfunctions_import_writes_no_bytecode_cache

# The years the fixture manifests are compared against come from the FETCHER's
# own constants, so a survey-year bump moves the assertions with the code instead
# of leaving two literals behind in this file.
IPEDS_DECLARED_YEARS="$(python3 - "$PROJECT_ROOT/bin/fetch-ipeds" << 'PY'
import ast
import sys

# Parsed, not grepped: a regex over the source dies as an AttributeError the day
# someone reformats the assignment, and this file is already parsed with ast
# elsewhere in this suite.
module = ast.parse(open(sys.argv[1]).read())
declared = {
    target.id: node.value.value
    for node in module.body
    if isinstance(node, ast.Assign)
    for target in node.targets
    if isinstance(target, ast.Name) and isinstance(node.value, ast.Constant)
}
for name in ("SURVEY_YEAR", "SFA_AID_YEAR"):
    print(declared[name])
PY
)"
IPEDS_SURVEY_YEAR_DECLARED="$(printf '%s\n' "$IPEDS_DECLARED_YEARS" | sed -n 1p)"
IPEDS_SFA_YEAR_DECLARED="$(printf '%s\n' "$IPEDS_DECLARED_YEARS" | sed -n 2p)"

assert_success "bin/fetch-external-data parses as bash" bash -n "$PROJECT_ROOT/bin/fetch-external-data"
assert_success "bin/load-external-data parses as bash" bash -n "$PROJECT_ROOT/bin/load-external-data"
assert_success "bin/reload-external-data parses as bash" bash -n "$PROJECT_ROOT/bin/reload-external-data"

assert_success "fetch-external-data -h exits 0" bin/fetch-external-data -h
assert_success "load-external-data -h exits 0" bin/load-external-data -h
assert_success "reload-external-data -h exits 0" bin/reload-external-data -h

# Usage grammar. Every one of these is refused BEFORE anything is fetched or
# loaded, so none of them touches the network or the database.
assert_exit_code "$EXIT_UNKNOWN_OPTION" "fetch-external-data rejects an unknown option (10)" \
  bin/fetch-external-data -z
assert_exit_code "$EXIT_OPTION_REQUIRES_VALUE" "fetch-external-data -F without a value exits 11" \
  bin/fetch-external-data -F
assert_exit_code "$EXIT_OPTION_REQUIRES_VALUE" "fetch-external-data -o without a value exits 11" \
  bin/fetch-external-data -o
assert_exit_code "$EXIT_UNEXPECTED_ARG" "fetch-external-data rejects a stray positional (20)" \
  bin/fetch-external-data stray
assert_exit_code "$EXIT_INVALID_ARG_VALUE" "fetch-external-data rejects an empty -F value (22)" \
  bin/fetch-external-data -F "" -o /tmp
# -F REQUIRES -o: an offline replay aimed at the committed default directories
# would write fixture-derived data over db/data/codebooks.json and db/seed/.
assert_exit_code "$EXIT_MISSING_REQUIRED_ARG" "fetch-external-data -F without -o exits 21" \
  bin/fetch-external-data -F "$PROJECT_ROOT/college/src/test/resources"
assert_exit_code "$EXIT_UNKNOWN_OPTION" "load-external-data rejects an unknown option (10)" \
  bin/load-external-data -z a.csv b.csv
assert_exit_code "$EXIT_MISSING_REQUIRED_ARG" "load-external-data with no positionals exits 21" \
  bin/load-external-data
assert_exit_code "$EXIT_UNEXPECTED_ARG" "load-external-data with four positionals exits 20" \
  bin/load-external-data a.csv b.csv c.json d.json
assert_exit_code "$EXIT_MISSING_REQUIRED_ARG" "load-external-data rejects an explicitly-empty aliases argument" \
  bin/load-external-data a.csv b.csv ""
assert_exit_code "$EXIT_UNKNOWN_OPTION" "reload-external-data rejects an unknown option (10)" \
  bin/reload-external-data -z a.csv b.csv
assert_exit_code "$EXIT_MISSING_REQUIRED_ARG" "reload-external-data with one positional exits 21" \
  bin/reload-external-data a.csv
assert_exit_code "$EXIT_UNEXPECTED_ARG" "reload-external-data with four positionals exits 20" \
  bin/reload-external-data a.csv b.csv c.json d.json

# One offline fixture directory serving all four fetchers: the recorded IPEDS
# CSVs, codebook .do files and Scorecard archives are matched by EXACT name out
# of the shared test resources, so only the fifteen this replay reads are linked
# in, and the CDS fixtures are the same recorded API responses the RFC 140
# section above writes. The Scorecard half needs three of them, because its
# release discovery runs offline too: the recorded /data/ page as well as the two
# archives (RFC 173).
# No EXIT trap here: the harness's daemon-teardown trap (top of file) must not be
# clobbered. The dirs are removed at the end of this section.
EXTERNAL_FIXTURES="$(mktemp -d)"
EXTERNAL_OUT="$(mktemp -d)"
for fixture in \
  codebooks-hd2023-fixture.do codebooks-ic2023-fixture.do codebooks-adm2023-fixture.do \
  codebooks-c2023-a-fixture.do codebooks-ic2023-ay-fixture.do \
  ipeds-hd2023-fixture.csv ipeds-ic2023-fixture.csv ipeds-adm2023-fixture.csv \
  ipeds-c2023-a-fixture.csv ipeds-ic2023-ay-fixture.csv ipeds-sfa2223-fixture.csv \
  ipeds-sfa2223-dict-fixture.xlsx \
  scorecard-data-page-fixture.html scorecard-institution-zip-fixture.zip \
  scorecard-field-of-study-zip-fixture.zip; do
  ln -s "$PROJECT_ROOT/college/src/test/resources/$fixture" "$EXTERNAL_FIXTURES/$fixture"
done
write_cds_fixtures "$EXTERNAL_FIXTURES"

# The committed codebook is the file an -o that did not also carry -j would
# silently rewrite, so its digest is taken before the offline run and compared
# after it.
EXTERNAL_CODEBOOK_DIGEST_BEFORE="$(shasum -a 256 < "$PROJECT_ROOT/db/data/codebooks.json")"
EXTERNAL_STDOUT="$(mktemp)"
# The redirect belongs INSIDE the function under test: written on the
# assert_success line it would capture the harness's own pass line instead, and
# the stdout assertion below would read that.
run_external_offline_fetch() {
  bin/fetch-external-data -F "$EXTERNAL_FIXTURES" -o "$EXTERNAL_OUT" > "$EXTERNAL_STDOUT" 2>/dev/null
}
assert_success "fetch-external-data runs all four fetchers offline from fixtures" \
  run_external_offline_fetch

# The stdout contract of RFC 172 1: the product is files on disk plus a
# diagnostic summary, and the summary is a diagnostic. This is only true because
# all four fetchers now log to stderr (RFC 172 5, RFC 173).
test_fetch_external_data_stdout_stays_empty() {
  [ -s "$EXTERNAL_STDOUT" ] || return 0
  log-error "fetch-external-data wrote to stdout: [$(cat "$EXTERNAL_STDOUT")]"
  return 1
}
assert_success "fetch-external-data writes nothing to stdout on a normal run" \
  test_fetch_external_data_stdout_stays_empty

# -o is an output ROOT: each source lands in its own subdirectory, because all
# four fetchers write a PROVENANCE.json and one shared directory would have
# them overwrite each other's.
test_fetch_external_data_writes_four_sources() {
  local name
  for name in scorecard/PROVENANCE.json scorecard/Most-Recent-Cohorts-Institution.csv \
    scorecard/Most-Recent-Cohorts-Field-of-Study.csv \
    codebooks/PROVENANCE.json codebooks/codebooks.json ipeds/PROVENANCE.json \
    ipeds/HD2023.csv ipeds/ic2023_ay.csv ipeds/sfa2223.csv cds/PROVENANCE.json cds/merit-aid.csv; do
    [ -s "$EXTERNAL_OUT/$name" ] || { log-error "offline run did not write [$name]"; return 1; }
  done
  return 0
}
assert_success "each of the four sources is written under its own subdirectory of -o" \
  test_fetch_external_data_writes_four_sources

test_fetch_external_data_spares_the_committed_codebook() {
  local after
  after="$(shasum -a 256 < "$PROJECT_ROOT/db/data/codebooks.json")"
  [ "$after" = "$EXTERNAL_CODEBOOK_DIGEST_BEFORE" ] && return 0
  log-error "the offline run rewrote the committed db/data/codebooks.json"
  return 1
}
assert_success "an offline run leaves the committed db/data/codebooks.json untouched" \
  test_fetch_external_data_spares_the_committed_codebook

# S2/RFC 172 1: -o redirects ALL of a fetcher's output. fetch-codebooks' generated
# codebook follows -o with no -j at all, so the wrapper needs no compensating
# flag and a redirected run cannot reach a committed file through a path -o did
# not cover.
test_fetch_codebooks_o_redirects_the_generated_codebook() {
  local out
  out="$(mktemp -d)"
  bin/fetch-codebooks -F "$PROJECT_ROOT/college/src/test/resources" -o "$out" >/dev/null 2>"$out/stderr" || {
    log-error "fetch-codebooks -o (no -j) did not succeed offline: [$(cat "$out/stderr" 2>/dev/null)]"
    rm -rf "$out"
    return 1
  }
  if [ ! -s "$out/codebooks.json" ]; then
    log-error "the generated codebook did not follow -o into [$out]"
    rm -rf "$out"
    return 1
  fi
  rm -rf "$out"
}
assert_success "fetch-codebooks -o with no -j writes the generated codebook under -o" \
  test_fetch_codebooks_o_redirects_the_generated_codebook

# S1: an -o the fetchers cannot use is ONE source's failure, tallied and survived,
# not an abort before any source runs. A wrapper-level mkdir would fail first,
# under set -e, and cancel the whole best-effort run.
test_fetch_external_data_bad_output_root_is_a_tallied_failure() {
  local root file stderr rc=0
  root="$(mktemp -d)"
  file="$root/ipeds"
  : > "$file"
  stderr="$root/stderr"
  bin/fetch-external-data -i -F "$PROJECT_ROOT/college/src/test/resources" -o "$root" \
    >/dev/null 2>"$stderr" || rc=$?
  if [ "$rc" -ne 1 ]; then
    log-error "expected the wrapper's own exit 1, got [$rc]: [$(cat "$stderr")]"
    rm -rf "$root"
    return 1
  fi
  if ! grep -qF "of [1] sources fetched" "$stderr"; then
    log-error "the failure was not tallied: [$(cat "$stderr")]"
    rm -rf "$root"
    return 1
  fi
  rm -rf "$root"
}
assert_success "an unusable -o is one source's tallied failure, not an aborted run" \
  test_fetch_external_data_bad_output_root_is_a_tallied_failure

# RFC 172: the survey year is RECORDED, so bin/load-external-data never has to
# infer it from a filename. An offline replay records it from the same constant.
assert_success "a fetch-ipeds run records the survey year in PROVENANCE.json" \
  provenance_assert "$EXTERNAL_OUT/ipeds/PROVENANCE.json" \
    "provenance['survey_year'] == $IPEDS_SURVEY_YEAR_DECLARED
     and all('year' in a and 'ingest_option' in a for a in artifacts.values())
     and artifacts['SFA2223.zip']['year'] == $IPEDS_SFA_YEAR_DECLARED"
assert_success "the committed db/seed/ipeds/PROVENANCE.json records the fetcher's declared survey year" \
  provenance_assert "$PROJECT_ROOT/db/seed/ipeds/PROVENANCE.json" \
    "provenance['survey_year'] == $IPEDS_SURVEY_YEAR_DECLARED and provenance['source'] == 'network'"
# Every artifact records its OWN year, and the two SFA ones record the aid year
# (2022), not the collection year: SFA2223 covers aid year 2022-23 inside the
# 2023 collection (RFC 162), and one number cannot label both.
assert_success "the committed manifest records a per-artifact year, the SFA aid year on the SFA archives" \
  provenance_assert "$PROJECT_ROOT/db/seed/ipeds/PROVENANCE.json" \
    "all('year' in a for a in artifacts.values())
     and {name for name, a in artifacts.items() if a['year'] == $IPEDS_SFA_YEAR_DECLARED} == {'SFA2223.zip', 'SFA2223_Dict.zip'}
     and {a['year'] for name, a in artifacts.items() if not name.startswith('SFA')} == {$IPEDS_SURVEY_YEAR_DECLARED}"
# B2: which bin/ingest-colleges flag each artifact is loaded as is RECORDED, so
# the wrapper reads a declaration instead of re-deriving it from archive names --
# and the dictionary's null is how the fetcher says "never ingested".
assert_success "the committed manifest records the ingest option of every artifact, null for the dictionary" \
  provenance_assert "$PROJECT_ROOT/db/seed/ipeds/PROVENANCE.json" \
    'all("ingest_option" in a for a in artifacts.values())
     and artifacts["SFA2223_Dict.zip"]["ingest_option"] is None
     and {a["ingest_option"] for name, a in artifacts.items() if name != "SFA2223_Dict.zip"}
         == {"-H", "-I", "-A", "-C", "-Y", "-S"}'

rm -f "$EXTERNAL_STDOUT"
rm -rf "$EXTERNAL_FIXTURES" "$EXTERNAL_OUT"

# A stub PROJECT_ROOT: bin/common derives PROJECT_ROOT from its own path, so a
# directory of symlinks to the real bin/ is a complete checkout as far as these
# scripts are concerned -- and an individual entry can then be REPLACED by a
# stub, which is what makes the selector, best-effort and ordering rules testable
# with no network and no database. db/seed/ipeds is a real directory holding a
# fixture manifest and empty stand-ins for the (gitignored) survey CSVs.
make_external_stub_root() {
  local root="$1" entry
  mkdir -p "$root/bin" "$root/db/seed"
  for entry in "$PROJECT_ROOT"/bin/*; do
    ln -s "$entry" "$root/bin/$(basename "$entry")"
  done
  for entry in .env .env.dev .env.test .env.fuzz; do
    ln -s "$PROJECT_ROOT/$entry" "$root/$entry"
  done
  ln -s "$PROJECT_ROOT/db/data" "$root/db/data"
  ln -s "$PROJECT_ROOT/db/seed/cds" "$root/db/seed/cds"
  mkdir -p "$root/db/seed/ipeds"
}

# Marker-writing stubs for the four fetchers, so which children ran is a fact on
# disk rather than a guess from scrollback. `exit $1` is what makes the
# best-effort and exit-code rules testable with no network.
write_fetcher_stub() {
  local path="$1" marker="$2" status="$3"
  rm -f "$path"
  printf '#!/usr/bin/env bash\ntouch %q\nexit %s\n' "$marker" "$status" > "$path"
  chmod +x "$path"
}

# The manifest shapes a reader must tell apart. The fixture COLLECTION year is
# 2026 and the fixture SFA AID year is 2025, both different from the committed
# 2023/2022 pair and from each other, so a -n command carrying -y 2026 -f 2025
# and ic2026_ay.csv proves every one of them was READ rather than defaulted or
# copied from the other number. The ingest FLAG of each artifact is recorded the
# way bin/fetch-ipeds records it, and the seventh artifact -- the SFA data
# dictionary -- records a null one, which is how the fetcher says "never
# ingested".
#   top       a complete RFC 172 manifest: survey_year, per-artifact year, ingest_option
#   no-year   no top-level survey_year
#   non-integer-year  a hand-edited "2026" where an integer is recorded
#   no-sfa-year   the SFA artifact records no year of its own
#   no-sfa    no SFA data archive at all (the dictionary alone is not one)
#   contradiction one collection artifact declares a year the top level does not
#   unknown   an ingest flag this WRAPPER has no slot for
#   no-option an artifact block with no ingest_option recorded at all
#   duplicate two archives claiming the same ingest flag
#   no-member an artifact block with no recorded member name
#   no-artifacts  a manifest whose artifacts object is empty
#   many-faults   several independent faults in one manifest
write_ipeds_fixture_manifest() {
  python3 - "$1" "$2" << 'PY'
import json
import sys
from pathlib import Path

outdir, shape = Path(sys.argv[1]), sys.argv[2]
COLLECTION_YEAR, SFA_AID_YEAR = 2026, 2025
# archive -> (member, year, ingest_option), the three facts bin/fetch-ipeds
# declares per artifact and records for the wrapper to read.
members = {
    "HD2026.zip": ("HD2026.csv", COLLECTION_YEAR, "-H"),
    "IC2026.zip": ("IC2026.csv", COLLECTION_YEAR, "-I"),
    "ADM2026.zip": ("adm2026.csv", COLLECTION_YEAR, "-A"),
    "C2026_A.zip": ("C2026_a.csv", COLLECTION_YEAR, "-C"),
    "IC2026_AY.zip": ("ic2026_ay.csv", COLLECTION_YEAR, "-Y"),
    "SFA2526.zip": ("sfa2526.csv", SFA_AID_YEAR, "-S"),
    "SFA2526_Dict.zip": ("sfa2526.xlsx", SFA_AID_YEAR, None),
}
if shape == "no-sfa":
    del members["SFA2526.zip"]
if shape == "unknown":
    # A survey the FETCHER knows and this wrapper does not: a flag with no slot.
    members["GR2026.zip"] = ("gr2026.csv", COLLECTION_YEAR, "-G")
if shape == "duplicate":
    # A second archive claiming -H, which is a manifest to re-fetch and never a
    # choice this reader makes for the operator.
    members["HD2025.zip"] = ("HD2025.csv", COLLECTION_YEAR, "-H")
artifacts = {}
for archive, (member, year, option) in members.items():
    entry = {
        "url": f"https://example.invalid/{archive}",
        "member": member,
        "rows": 3,
        "year": year,
        "ingest_option": option,
    }
    if shape in ("no-sfa-year", "many-faults") and archive == "SFA2526.zip":
        del entry["year"]
    if shape == "non-integer-year" and archive == "SFA2526.zip":
        entry["year"] = str(year)
    if shape in ("no-member", "many-faults") and archive == "HD2026.zip":
        del entry["member"]
    if shape in ("no-option", "many-faults") and archive == "IC2026.zip":
        del entry["ingest_option"]
    if shape == "contradiction" and archive == "ADM2026.zip":
        entry["year"] = COLLECTION_YEAR - 1
    artifacts[archive] = entry
manifest = {"fetched_at": "2026-01-01T00:00:00+00:00", "source": "network", "artifacts": artifacts}
if shape == "no-artifacts":
    manifest["artifacts"] = {}
if shape == "non-integer-year":
    manifest["survey_year"] = str(COLLECTION_YEAR)
elif shape != "no-year":
    manifest["survey_year"] = COLLECTION_YEAR
outdir.mkdir(parents=True, exist_ok=True)
(outdir / "PROVENANCE.json").write_text(json.dumps(manifest, indent=2) + "\n")
for member, _, _ in members.values():
    (outdir / member).write_text("UNITID,VALUE\n100001,1\n")
PY
}


# One command line on stdout and nothing else: -n is the ONE thing this wrapper
# is asked for by name, and it is what an operator pastes into bin/remote.
EXTERNAL_ROOT="$(mktemp -d)/checkout"
mkdir -p "$EXTERNAL_ROOT"
make_external_stub_root "$EXTERNAL_ROOT"
write_ipeds_fixture_manifest "$EXTERNAL_ROOT/db/seed/ipeds" top
: > "$EXTERNAL_ROOT/institution.csv"
: > "$EXTERNAL_ROOT/fields.csv"
EXTERNAL_DRY_RUN=""

test_load_external_data_prints_one_command() {
  local out
  local stderr
  stderr="$(mktemp)"
  # stderr is KEPT, not discarded: these scripts report only on stderr, so a
  # failure whose cause went to /dev/null prints no cause at all.
  out="$("$EXTERNAL_ROOT/bin/load-external-data" -n \
    "$EXTERNAL_ROOT/institution.csv" "$EXTERNAL_ROOT/fields.csv" 2> "$stderr")" || {
    log-error "load-external-data -n exited nonzero: [$(cat "$stderr")]"
    rm -f "$stderr"
    return 1
  }
  rm -f "$stderr"
  EXTERNAL_DRY_RUN="$out"
  [ "$(printf '%s\n' "$out" | wc -l | tr -d ' ')" = "1" ] && return 0
  log-error "load-external-data -n printed [$(printf '%s\n' "$out" | wc -l)] lines, not one"
  return 1
}
assert_success "load-external-data -n prints exactly one command line to stdout" \
  test_load_external_data_prints_one_command

# Every flag of the maximal ingest command, with the paths it must carry. The
# IPEDS half is the point: -H/-I/-A/-C/-Y and -y are the six an operator used to
# type over year-stamped filenames, and all six here come from the manifest.
test_load_external_data_command_is_complete() {
  [ -n "$EXTERNAL_DRY_RUN" ] || { log-error "no -n command was captured to assert against"; return 1; }
  local expected missing=() letters letter
  # The value-taking option LETTERS come from bin/ingest-colleges' own getopts
  # spec, not from a list retyped here: a fifteenth ingest option must fail this
  # test rather than ship as a silently partial load.
  letters="$(python3 - "$PROJECT_ROOT/bin" "$PROJECT_ROOT/bin/ingest-colleges" << 'PY'
import re
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, sys.argv[1])
from pyfunctions import value_options

# ONE implementation of "which letters in a getopts spec take a value", shared
# with the scripts that parse with it -- a second copy here could disagree with
# the one the code uses and the disagreement would look like a passing test.
spec = re.search(r'while getopts "([^"]+)"', open(sys.argv[2]).read()).group(1)
print(" ".join(option.lstrip("-") for option in value_options(spec)))
PY
)"
  [ -n "$letters" ] || { log-error "no option letters were read from bin/ingest-colleges"; return 1; }
  for letter in $letters; do
    case "$EXTERNAL_DRY_RUN" in
    *" -$letter "*) ;;
    *) missing+=("-$letter") ;;
    esac
  done
  for expected in \
    "/bin/ingest-colleges" \
    "-k $EXTERNAL_ROOT/db/data/codebooks.json" \
    "-s $EXTERNAL_ROOT/db/data/subjects.json" \
    "-v $EXTERNAL_ROOT/db/data/money-vocabulary.json" \
    "-m $EXTERNAL_ROOT/db/seed/cds/merit-aid.csv" \
    "-a $EXTERNAL_ROOT/db/seed/cds/admission-factors.csv" \
    "-d $EXTERNAL_ROOT/db/seed/cds/deadlines.csv" \
    "-p $EXTERNAL_ROOT/db/seed/cds/aid_policy.csv" \
    "-H $EXTERNAL_ROOT/db/seed/ipeds/HD2026.csv" \
    "-I $EXTERNAL_ROOT/db/seed/ipeds/IC2026.csv" \
    "-A $EXTERNAL_ROOT/db/seed/ipeds/adm2026.csv" \
    "-C $EXTERNAL_ROOT/db/seed/ipeds/C2026_a.csv" \
    "-Y $EXTERNAL_ROOT/db/seed/ipeds/ic2026_ay.csv" \
    "-y 2026" \
    "-S $EXTERNAL_ROOT/db/seed/ipeds/sfa2526.csv" \
    "-f 2025" \
    "$EXTERNAL_ROOT/institution.csv $EXTERNAL_ROOT/fields.csv $EXTERNAL_ROOT/db/data/college-aliases.json"; do
    case "$EXTERNAL_DRY_RUN" in
    *"$expected"*) ;;
    *) missing+=("$expected") ;;
    esac
  done
  [ "${#missing[@]}" -eq 0 ] && return 0
  log-error "the -n command is missing ${missing[*]} -- it read [$EXTERNAL_DRY_RUN]"
  return 1
}
assert_success "the -n command carries every value-taking ingest option, the manifest's six CSVs and both years" \
  test_load_external_data_command_is_complete

# The three positionals come LAST, after every option: bin/ingest-colleges'
# getopts stops at the first operand and fatals on anything option-shaped after
# it, so this ordering is a contract and not a style choice.
test_load_external_data_options_precede_positionals() {
  [ -n "$EXTERNAL_DRY_RUN" ] || { log-error "no -n command was captured to assert against"; return 1; }
  case "$EXTERNAL_DRY_RUN" in
  *"-f 2025 $EXTERNAL_ROOT/institution.csv"*) return 0 ;;
  esac
  log-error "the -n command does not put the positionals last: [$EXTERNAL_DRY_RUN]"
  return 1
}
assert_success "the -n command puts every option before the positionals" \
  test_load_external_data_options_precede_positionals

# The two years are read from two different recorded fields and must stay two
# different numbers: -y is the manifest's top-level collection year and -f is the
# SFA artifact's own recorded aid-year start. Conflating them is the defect
# bin/ingest-colleges' help warns about twice (RFC 162).
test_load_external_data_keeps_the_two_years_apart() {
  # Guarded, because this reads the command the -n test captured: an assertion
  # over an empty global would pass without seeing a command at all.
  [ -n "$EXTERNAL_DRY_RUN" ] || { log-error "no -n command was captured to assert against"; return 1; }
  case "$EXTERNAL_DRY_RUN" in
  *"-y 2026"*) ;;
  *) log-error "the -n command carries no collection year: [$EXTERNAL_DRY_RUN]"; return 1 ;;
  esac
  case "$EXTERNAL_DRY_RUN" in
  *"-f 2025"*) return 0 ;;
  esac
  log-error "the -n command carries no SFA aid year, or copied the collection year: [$EXTERNAL_DRY_RUN]"
  return 1
}
assert_success "-y carries the collection year and -f the SFA aid year, and they differ" \
  test_load_external_data_keeps_the_two_years_apart

# The SFA data DICTIONARY is recorded in the same manifest and is never ingested
# (an .xlsx pinned for its digest and citation, RFC 162). It is skipped BY NAME
# and in SILENCE: a warning on every load about a file this project has decided
# never to load is noise that teaches an operator to read past warnings.
test_load_external_data_skips_the_sfa_dictionary_silently() {
  local stdout stderr status=0
  stdout="$(mktemp)"
  stderr="$(mktemp)"
  # This test performs its OWN dry run rather than reading a global an earlier
  # test set: an assertion about what an empty string does not contain passes
  # hardest exactly when its input is missing.
  "$EXTERNAL_ROOT/bin/load-external-data" -n \
    "$EXTERNAL_ROOT/institution.csv" "$EXTERNAL_ROOT/fields.csv" > "$stdout" 2> "$stderr" || status=$?
  if [ "$status" -ne 0 ]; then
    log-error "the dry run exited [$status]: [$(cat "$stderr")]"
    rm -f "$stdout" "$stderr"
    return 1
  fi
  if [ ! -s "$stdout" ]; then
    log-error "no command was printed to assert against"
    rm -f "$stdout" "$stderr"
    return 1
  fi
  # The [WARNING] PREFIX at line start, not the word: the -n banner mentions
  # warnings in prose, and matching that would fail on a run with none.
  if grep -q "^\[WARNING\]" "$stderr"; then
    log-error "the dictionary provoked a warning: [$(cat "$stderr")]"
    rm -f "$stdout" "$stderr"
    return 1
  fi
  if grep -q "sfa2526.xlsx" "$stdout"; then
    log-error "the dictionary reached the ingest command: [$(cat "$stdout")]"
    rm -f "$stdout" "$stderr"
    return 1
  fi
  rm -f "$stdout" "$stderr"
  return 0
}
assert_success "the SFA data dictionary is skipped by name, with no warning and no flag" \
  test_load_external_data_skips_the_sfa_dictionary_silently

# The generic warning is still there for an artifact nothing has decided about:
# a new survey in the manifest must be REPORTED, and must not make the load
# refuse before bin/ingest-colleges has grown a flag for it.
test_load_external_data_warns_about_an_unrecognised_artifact() {
  local stderr rc=0
  write_ipeds_fixture_manifest "$EXTERNAL_ROOT/db/seed/ipeds" unknown
  stderr="$("$EXTERNAL_ROOT/bin/load-external-data" -n \
    "$EXTERNAL_ROOT/institution.csv" "$EXTERNAL_ROOT/fields.csv" 2>&1 >/dev/null)" || rc=$?
  write_ipeds_fixture_manifest "$EXTERNAL_ROOT/db/seed/ipeds" top
  [ "$rc" -eq 0 ] || { log-error "an unrecognised ingest option made -n refuse: [$stderr]"; return 1; }
  case "$stderr" in
  *"[WARNING]"*"[GR2026.zip]"*"[-G]"*) return 0 ;;
  esac
  log-error "an ingest option with no mapping was not reported under -n: [$stderr]"
  return 1
}
assert_success "under -n, an ingest option with no mapping is WARNED about and the command still prints" \
  test_load_external_data_warns_about_an_unrecognised_artifact

# Each refusal below is EXIT_MISSING_REQUIRED_ARG and names both the missing
# thing and the command that produces it, and each is discovered BEFORE the JVM
# starts -- a missing file found by phase 9 is a re-run, one found by argument
# validation is a corrected command.
# VARIADIC over expected substrings, because a refusal has two halves the RFC
# requires together: what is missing, and the command that produces it. Asserting
# only the leading phrase would let the remedy half be deleted silently.
external_load_refuses() {
  local out rc=0 expected
  out="$("$EXTERNAL_ROOT/bin/load-external-data" -n \
    "$EXTERNAL_ROOT/institution.csv" "$EXTERNAL_ROOT/fields.csv" 2>&1 >/dev/null)" || rc=$?
  if [ "$rc" -ne "$EXIT_MISSING_REQUIRED_ARG" ]; then
    log-error "expected exit [$EXIT_MISSING_REQUIRED_ARG], got [$rc]: [$out]"
    return 1
  fi
  for expected in "$@"; do
    case "$out" in
    *"$expected"*) ;;
    *) log-error "the refusal does not mention [$expected]: [$out]"; return 1 ;;
    esac
  done
  return 0
}

test_load_external_data_refuses_a_manifest_with_no_survey_year() {
  write_ipeds_fixture_manifest "$EXTERNAL_ROOT/db/seed/ipeds" no-year
  external_load_refuses "records no [survey_year]" "db/seed/ipeds/PROVENANCE.json" "re-run bin/fetch-ipeds"
}
assert_success "a manifest recording no collection year is refused, and names bin/fetch-ipeds" \
  test_load_external_data_refuses_a_manifest_with_no_survey_year

# The SFA aid year has ONE recorded source and no substitute: borrowing the
# collection year would stamp every college_sfa row with the year after the one
# the file reports on.
test_load_external_data_refuses_an_sfa_artifact_with_no_year() {
  write_ipeds_fixture_manifest "$EXTERNAL_ROOT/db/seed/ipeds" no-sfa-year
  external_load_refuses "[SFA2526.zip] records no [year]" "db/seed/ipeds/PROVENANCE.json" "re-run bin/fetch-ipeds"
}
assert_success "an SFA artifact with no recorded year is refused, never given the collection year" \
  test_load_external_data_refuses_an_sfa_artifact_with_no_year

test_load_external_data_refuses_a_manifest_with_no_sfa_survey() {
  write_ipeds_fixture_manifest "$EXTERNAL_ROOT/db/seed/ipeds" no-sfa
  external_load_refuses "declares no artifact for [-S]" \
    "db/seed/ipeds/PROVENANCE.json" "re-run bin/fetch-ipeds"
}
assert_success "a manifest with no SFA survey artifact is refused (the dictionary is not one)" \
  test_load_external_data_refuses_a_manifest_with_no_sfa_survey

# The manifest reader's remaining refusals. Each is a fatal 21 whose precondition
# nothing else in the suite supplies, and an inverted guard here loads one of two
# archives arbitrarily -- or a manifest with nothing in it -- and reports success.
test_load_external_data_refuses_an_unparseable_manifest() {
  printf 'not json at all\n' > "$EXTERNAL_ROOT/db/seed/ipeds/PROVENANCE.json"
  external_load_refuses "is not readable JSON" "re-run bin/fetch-ipeds"
}
assert_success "a manifest that is not JSON is refused, and names bin/fetch-ipeds" \
  test_load_external_data_refuses_an_unparseable_manifest

test_load_external_data_refuses_an_empty_artifacts_object() {
  write_ipeds_fixture_manifest "$EXTERNAL_ROOT/db/seed/ipeds" no-artifacts
  external_load_refuses "records no [artifacts] object" "re-run bin/fetch-ipeds"
}
assert_success "a manifest recording no artifacts is refused, and names bin/fetch-ipeds" \
  test_load_external_data_refuses_an_empty_artifacts_object

test_load_external_data_refuses_two_artifacts_for_one_flag() {
  write_ipeds_fixture_manifest "$EXTERNAL_ROOT/db/seed/ipeds" duplicate
  external_load_refuses "[HD2025.zip]" "[HD2026.zip]" "both claim [-H]" \
    "which one to load is not a guess this script makes"
}
assert_success "two archives claiming one survey role are refused, not picked between" \
  test_load_external_data_refuses_two_artifacts_for_one_flag

test_load_external_data_refuses_an_artifact_with_no_member() {
  write_ipeds_fixture_manifest "$EXTERNAL_ROOT/db/seed/ipeds" no-member
  external_load_refuses "[HD2026.zip] records no [member]" "re-run bin/fetch-ipeds"
}
assert_success "an artifact recording no member name is refused, and names bin/fetch-ipeds" \
  test_load_external_data_refuses_an_artifact_with_no_member

# A year is READ, not interpreted: "2025" is what a hand edit produces, and this
# file tells the operator to re-fetch rather than hand-edit the record. Accepting
# the string would contradict its own message.
# A present-but-wrong value is reported as what it IS. "records no year" about a
# file the operator can see a year in sends them looking for the wrong fault.
test_load_external_data_refuses_a_hand_typed_string_year() {
  write_ipeds_fixture_manifest "$EXTERNAL_ROOT/db/seed/ipeds" non-integer-year
  external_load_refuses "records [survey_year] as ['2026'], which is not a four-digit year" \
    "[SFA2526.zip] records [year] as ['2025'], which is not a four-digit year" \
    "re-run bin/fetch-ipeds"
}
assert_success "a string-typed year is reported as non-integer, not as absent" \
  test_load_external_data_refuses_a_hand_typed_string_year

# B2: the ingest flag is a DECLARED fact. An artifact that records none is a
# manifest this wrapper cannot assemble a command from, and it says so rather
# than pattern-matching the name it also has.
test_load_external_data_refuses_an_artifact_with_no_ingest_option() {
  write_ipeds_fixture_manifest "$EXTERNAL_ROOT/db/seed/ipeds" no-option
  external_load_refuses "[IC2026.zip] records no [ingest_option]" \
    "never guessed from its name" "re-run bin/fetch-ipeds"
}
assert_success "an artifact recording no ingest_option is refused, not name-matched" \
  test_load_external_data_refuses_an_artifact_with_no_ingest_option

# NOT the consensus rule RFC 162 killed: this is one recorded fact contradicting
# another, and preferring either would be a guess.
test_load_external_data_refuses_a_contradicted_survey_year() {
  write_ipeds_fixture_manifest "$EXTERNAL_ROOT/db/seed/ipeds" contradiction
  external_load_refuses "[ADM2026.zip] declares year [2025]" "[survey_year] is [2026]" \
    "neither is this script's to prefer"
}
assert_success "an artifact contradicting the top-level survey year is refused, not preferred against" \
  test_load_external_data_refuses_a_contradicted_survey_year

# The manifest reader reports like the missing-input collector does: every fault
# in ONE refusal. Two opposite reporting disciplines in one script is what this
# rules out.
test_load_external_data_reports_every_manifest_fault_at_once() {
  write_ipeds_fixture_manifest "$EXTERNAL_ROOT/db/seed/ipeds" many-faults
  external_load_refuses "[HD2026.zip] records no [member]" \
    "[IC2026.zip] records no [ingest_option]" "[SFA2526.zip] records no [year]" \
    "fault(s) listed above"
}
assert_success "three manifest faults are reported in ONE refusal, with their count" \
  test_load_external_data_reports_every_manifest_fault_at_once

# bin/read-ipeds-manifest is a bin/ script in its own right, so it is tested
# directly and not only through the wrapper: its PRODUCT is the KIND-tagged
# records on stdout, and its grammar and refusals are its own.
assert_success "bin/read-ipeds-manifest -h exits 0" bin/read-ipeds-manifest -h
assert_exit_code "$EXIT_UNKNOWN_OPTION" "read-ipeds-manifest rejects an unknown option (10)" \
  bin/read-ipeds-manifest -z
assert_exit_code "$EXIT_OPTION_REQUIRES_VALUE" "read-ipeds-manifest -m without a value exits 11" \
  bin/read-ipeds-manifest -m
assert_exit_code "$EXIT_UNEXPECTED_ARG" "read-ipeds-manifest rejects a stray positional (20)" \
  bin/read-ipeds-manifest stray
assert_exit_code "$EXIT_INVALID_ARG_VALUE" "read-ipeds-manifest rejects a repeated option (22)" \
  bin/read-ipeds-manifest -m /tmp/a -m /tmp/b

# A5: every record is KIND-tagged, so a fact the manifest DECLARED (member) can
# never share a namespace with one this reader DERIVED (year). Without the kind,
# an artifact recording ingest_option "-y" would bind a file path to the survey
# year and the year would silently overwrite it.
test_read_ipeds_manifest_emits_kind_tagged_records() {
  local out
  out="$(bin/read-ipeds-manifest 2>/dev/null)" || { log-error "the committed manifest did not read"; return 1; }
  # Six members, two years, and every line is one of those two kinds.
  [ "$(printf '%s\n' "$out" | grep -c '^member	-')" = "6" ] \
    || { log-error "expected six member records: [$out]"; return 1; }
  [ "$(printf '%s\n' "$out" | grep -c '^year	-')" = "2" ] \
    || { log-error "expected two year records: [$out]"; return 1; }
  printf '%s\n' "$out" | grep -qE '^year	-y	[0-9]{4}$' \
    || { log-error "no collection-year record: [$out]"; return 1; }
  printf '%s\n' "$out" | grep -qE '^year	-f	[0-9]{4}$' \
    || { log-error "no SFA aid-year record: [$out]"; return 1; }
  printf '%s\n' "$out" | grep -qv '^\(member\|year\)	' && return 0
  return 0
}
assert_success "read-ipeds-manifest emits KIND-tagged records: six members and two years" \
  test_read_ipeds_manifest_emits_kind_tagged_records

# The refusals of the reader itself, each asserted on the reader and each naming
# the offending VALUE rather than restating the rule. One shared helper: the
# manifest is written into a scratch directory, the reader is pointed at it, and
# the exit code and every expected substring are checked.
read_manifest_refuses() {
  local body="$1" expected_status="$2" out rc=0 scratch
  shift 2
  scratch="$(mktemp -d)"
  printf '%s' "$body" > "$scratch/PROVENANCE.json"
  out="$(bin/read-ipeds-manifest -m "$scratch/PROVENANCE.json" -d "$scratch" 2>&1 >/dev/null)" || rc=$?
  rm -rf "$scratch"
  if [ "$rc" -ne "$expected_status" ]; then
    log-error "expected exit [$expected_status], got [$rc]: [$out]"
    return 1
  fi
  local expected
  for expected in "$@"; do
    case "$out" in
    *"$expected"*) ;;
    *) log-error "the refusal does not mention [$expected]: [$out]"; return 1 ;;
    esac
  done
  return 0
}

# A1: a JSON document that parses but is not an object. Each of these used to
# reach .get() and die as an AttributeError traceback with exit 1 -- outside the
# reserved band, with no remedy in it.
test_read_ipeds_manifest_refuses_non_object_json() {
  local body
  for body in '[]' 'null' '"2023"' '17'; do
    read_manifest_refuses "$body" "$EXIT_MISSING_REQUIRED_ARG" \
      "not an object" "it is not a manifest at all" || return 1
  done
}
assert_success "a JSON document that is not an object is refused in the reserved band, not a traceback" \
  test_read_ipeds_manifest_refuses_non_object_json

# A2: every ingest FILE option must be declared. Only -S used to be required, so
# a manifest missing -H read cleanly and became an empty path in the command --
# reported two layers away as "missing input []", which names nothing.
test_read_ipeds_manifest_requires_every_file_option() {
  read_manifest_refuses '{"survey_year": 2026, "artifacts": {
      "SFA2526.zip": {"member": "sfa2526.csv", "year": 2025, "ingest_option": "-S"}}}' \
    "$EXIT_MISSING_REQUIRED_ARG" "declares no artifact for" "[-H]" "[-Y]" "re-run bin/fetch-ipeds"
}
assert_success "a manifest missing any IPEDS file option is refused, naming every absent one" \
  test_read_ipeds_manifest_requires_every_file_option

# A3: the year shape check must be the shape it PROMISES. `-y 99` and `-y 20231`
# both used to pass a check whose message said "four-digit year".
test_read_ipeds_manifest_refuses_malformed_years() {
  local year
  for year in 99 20231 0 3999; do
    read_manifest_refuses "{\"survey_year\": $year, \"artifacts\": {
        \"HD2026.zip\": {\"member\": \"HD2026.csv\", \"year\": $year, \"ingest_option\": \"-H\"}}}" \
      "$EXIT_MISSING_REQUIRED_ARG" "records [survey_year] as [$year]" "not a four-digit year" || return 1
  done
}
assert_success "a year that is not four digits is refused, naming the field and the value" \
  test_read_ipeds_manifest_refuses_malformed_years

# A4: a `member` is a FILE NAME. A path escapes the directory bin/fetch-ipeds
# writes, and a tab or newline splits this reader's own TSV channel into records
# it never emitted -- an extra ingest argument assembled from data.
test_read_ipeds_manifest_refuses_a_member_that_is_not_a_file_name() {
  read_manifest_refuses '{"survey_year": 2026, "artifacts": {
      "HD2026.zip": {"member": "../../etc/passwd", "year": 2026, "ingest_option": "-H"}}}' \
    "$EXIT_MISSING_REQUIRED_ARG" "records [member] as [../../etc/passwd]" "which is a path rather than a file name" \
    || return 1
  read_manifest_refuses '{"survey_year": 2026, "artifacts": {
      "HD2026.zip": {"member": "HD2026.csv\tsmuggled", "year": 2026, "ingest_option": "-H"}}}' \
    "$EXIT_MISSING_REQUIRED_ARG" "contains a tab or a line break"
}
assert_success "a member that is a path, or carries a tab, is refused" \
  test_read_ipeds_manifest_refuses_a_member_that_is_not_a_file_name

# A6: an absent ingest_option KEY and a null VALUE are different states. Null is
# the fetcher saying "deliberately not ingested" (the SFA dictionary); an absent
# key is nobody having decided, and this script does not decide for them.
test_read_ipeds_manifest_separates_absent_from_null_ingest_option() {
  read_manifest_refuses '{"survey_year": 2026, "artifacts": {
      "HD2026.zip": {"member": "HD2026.csv", "year": 2026}}}' \
    "$EXIT_MISSING_REQUIRED_ARG" "[HD2026.zip] records no [ingest_option]" "never guessed from its name"
}
assert_success "an absent ingest_option is refused while a null one stays the deliberate skip" \
  test_read_ipeds_manifest_separates_absent_from_null_ingest_option

# The allowlist: a manifest is DATA, and data that names the flag a file is
# passed as decides part of a command line. "-z", or a long option, must not
# reach argv because a JSON string happened to start with a dash.
test_read_ipeds_manifest_allowlists_the_ingest_option() {
  local out rc=0 scratch
  scratch="$(mktemp -d)"
  cat > "$scratch/PROVENANCE.json" << 'JSON'
{"survey_year": 2026, "artifacts": {
  "HD2026.zip": {"member": "HD2026.csv", "year": 2026, "ingest_option": "-H"},
  "IC2026.zip": {"member": "IC2026.csv", "year": 2026, "ingest_option": "-I"},
  "ADM2026.zip": {"member": "adm2026.csv", "year": 2026, "ingest_option": "-A"},
  "C2026_A.zip": {"member": "C2026_a.csv", "year": 2026, "ingest_option": "-C"},
  "IC2026_AY.zip": {"member": "ic2026_ay.csv", "year": 2026, "ingest_option": "-Y"},
  "SFA2526.zip": {"member": "sfa2526.csv", "year": 2025, "ingest_option": "-S"},
  "EVIL2026.zip": {"member": "evil.csv", "year": 2026, "ingest_option": "--hd=/etc/passwd"}}}
JSON
  out="$(bin/read-ipeds-manifest -l -m "$scratch/PROVENANCE.json" -d "$scratch" 2>&1 >/dev/null)" || rc=$?
  rm -rf "$scratch"
  [ "$rc" -eq "$EXIT_MISSING_REQUIRED_ARG" ] || { log-error "expected 21, got [$rc]: [$out]"; return 1; }
  case "$out" in
  *"[--hd=/etc/passwd]"*"no mapping for"*) return 0 ;;
  esac
  log-error "an out-of-allowlist ingest option was not refused under -l: [$out]"
  return 1
}
assert_success "an ingest option outside the allowlist never reaches argv" \
  test_read_ipeds_manifest_allowlists_the_ingest_option

# A7: a manifest that cannot be READ -- as opposed to one that parses wrongly.
# Both used to escape as tracebacks with exit 1.
test_read_ipeds_manifest_refuses_an_unreadable_manifest() {
  local scratch out rc=0
  scratch="$(mktemp -d)"
  mkdir "$scratch/PROVENANCE.json"
  out="$(bin/read-ipeds-manifest -m "$scratch/PROVENANCE.json" -d "$scratch" 2>&1 >/dev/null)" || rc=$?
  rm -rf "$scratch"
  [ "$rc" -eq "$EXIT_MISSING_REQUIRED_ARG" ] || { log-error "expected 21, got [$rc]: [$out]"; return 1; }
  case "$out" in
  *Traceback*) log-error "a raw traceback reached the operator: [$out]"; return 1 ;;
  *"cannot be read"*"Error]"*) return 0 ;;
  esac
  log-error "the refusal does not name the read failure: [$out]"
  return 1
}
assert_success "a directory named where the manifest should be is refused, not a traceback" \
  test_read_ipeds_manifest_refuses_an_unreadable_manifest

# B1: the reversal. Under -n an unmapped ingest option is a warning, because
# printing a command is not loading. A REAL load REFUSES: a green run that loaded
# less than the operator believed it loaded is the failure RFC 172 exists to
# prevent, and a warning a hundred lines above a zero exit IS that failure.
test_load_external_data_refuses_an_unmapped_option_on_a_real_load() {
  local root out rc=0
  root="$(mktemp -d)/checkout"
  mkdir -p "$root"
  make_external_stub_root "$root"
  write_ipeds_fixture_manifest "$root/db/seed/ipeds" unknown
  : > "$root/institution.csv"
  : > "$root/fields.csv"
  rm -f "$root/bin/ingest-colleges"
  printf '#!/usr/bin/env bash\nexit 0\n' > "$root/bin/ingest-colleges"
  chmod +x "$root/bin/ingest-colleges"
  out="$("$root/bin/load-external-data" "$root/institution.csv" "$root/fields.csv" 2>&1 >/dev/null)" || rc=$?
  if [ "$rc" -ne "$EXIT_MISSING_REQUIRED_ARG" ]; then
    log-error "a real load accepted an unmapped ingest option: exit [$rc], output [$out]"
    rm -rf "$(dirname "$root")"
    return 1
  fi
  case "$out" in
  *"[GR2026.zip]"*"[-G]"*) ;;
  *) log-error "the refusal does not name the artifact and its option: [$out]"; rm -rf "$(dirname "$root")"; return 1 ;;
  esac
  rm -rf "$(dirname "$root")"
}
assert_success "a REAL load refuses an ingest option with no mapping (a -n run only warns)" \
  test_load_external_data_refuses_an_unmapped_option_on_a_real_load

test_load_external_data_refuses_a_missing_manifest() {
  write_ipeds_fixture_manifest "$EXTERNAL_ROOT/db/seed/ipeds" top
  rm -f "$EXTERNAL_ROOT/db/seed/ipeds/PROVENANCE.json"
  external_load_refuses "db/seed/ipeds/PROVENANCE.json] cannot be read" "FileNotFoundError" "run bin/fetch-ipeds"
}
assert_success "a missing PROVENANCE.json is refused by path, and names bin/fetch-ipeds" \
  test_load_external_data_refuses_a_missing_manifest

# The currently-real case: db/seed/ipeds/*.csv are gitignored, so a fresh
# checkout has the manifest and none of the survey data.
test_load_external_data_refuses_a_missing_ipeds_csv() {
  write_ipeds_fixture_manifest "$EXTERNAL_ROOT/db/seed/ipeds" top
  rm -f "$EXTERNAL_ROOT/db/seed/ipeds/ic2026_ay.csv"
  external_load_refuses "ic2026_ay.csv] does not exist -- the IPEDS IC_AY published-charges survey file; run bin/fetch-ipeds"
}
assert_success "a missing IPEDS CSV is refused by name, and names bin/fetch-ipeds" \
  test_load_external_data_refuses_a_missing_ipeds_csv

# The SFA CSV is one more gitignored member, and its own missing-input class: it
# is named by the SAME manifest and produced by the SAME command, but a load that
# silently dropped it would leave college_sfa and every canonical-money figure
# built from it unwritten.
test_load_external_data_refuses_a_missing_sfa_csv() {
  write_ipeds_fixture_manifest "$EXTERNAL_ROOT/db/seed/ipeds" top
  rm -f "$EXTERNAL_ROOT/db/seed/ipeds/sfa2526.csv"
  external_load_refuses "sfa2526.csv] does not exist -- the IPEDS SFA student-financial-aid survey file; run bin/fetch-ipeds"
}
assert_success "a missing SFA CSV is refused by name, and names bin/fetch-ipeds" \
  test_load_external_data_refuses_a_missing_sfa_csv

# The aggregation the MISSING array exists for. Every test above removes ONE
# input, so all of them would pass a loop that reported the first and exited; a
# fresh checkout is missing every gitignored survey CSV at once, and reporting
# them one at a time turns one corrected command into as many runs as there are
# missing files. Three DIFFERENT classes at once, so the count and the per-class
# remedies are both exercised.
test_load_external_data_reports_every_missing_input_at_once() {
  local data seed rc=0
  write_ipeds_fixture_manifest "$EXTERNAL_ROOT/db/seed/ipeds" top
  rm -f "$EXTERNAL_ROOT/db/seed/ipeds/sfa2526.csv"
  seed="$(mktemp -d)"
  cp "$PROJECT_ROOT/db/seed/cds/merit-aid.csv" "$PROJECT_ROOT/db/seed/cds/admission-factors.csv" \
    "$PROJECT_ROOT/db/seed/cds/aid_policy.csv" "$seed/"
  rm -f "$EXTERNAL_ROOT/db/seed/cds"
  ln -s "$seed" "$EXTERNAL_ROOT/db/seed/cds"
  data="$(mktemp -d)"
  cp "$PROJECT_ROOT/db/data/codebooks.json" "$PROJECT_ROOT/db/data/money-vocabulary.json" \
    "$PROJECT_ROOT/db/data/college-aliases.json" "$data/"
  rm -f "$EXTERNAL_ROOT/db/data"
  ln -s "$data" "$EXTERNAL_ROOT/db/data"
  external_load_refuses \
    "sfa2526.csv] does not exist -- the IPEDS SFA student-financial-aid survey file; run bin/fetch-ipeds" \
    "deadlines.csv] does not exist -- the CDS deadlines seed; run bin/fetch-cds-seed" \
    "subjects.json] does not exist -- the authored subject taxonomy" \
    "[3] required input(s) are missing or unusable (listed above); nothing was loaded" || rc=1
  rm -f "$EXTERNAL_ROOT/db/seed/cds" "$EXTERNAL_ROOT/db/data"
  ln -s "$PROJECT_ROOT/db/seed/cds" "$EXTERNAL_ROOT/db/seed/cds"
  ln -s "$PROJECT_ROOT/db/data" "$EXTERNAL_ROOT/db/data"
  rm -rf "$seed" "$data"
  write_ipeds_fixture_manifest "$EXTERNAL_ROOT/db/seed/ipeds" top
  return "$rc"
}
assert_success "three missing inputs of different classes are reported in ONE refusal, with their count" \
  test_load_external_data_reports_every_missing_input_at_once

test_load_external_data_refuses_a_missing_cds_seed() {
  local seed
  write_ipeds_fixture_manifest "$EXTERNAL_ROOT/db/seed/ipeds" top
  seed="$(mktemp -d)"
  cp "$PROJECT_ROOT/db/seed/cds/merit-aid.csv" "$PROJECT_ROOT/db/seed/cds/deadlines.csv" \
    "$PROJECT_ROOT/db/seed/cds/aid_policy.csv" "$seed/"
  rm -f "$EXTERNAL_ROOT/db/seed/cds"
  ln -s "$seed" "$EXTERNAL_ROOT/db/seed/cds"
  local rc=0
  external_load_refuses "admission-factors.csv] does not exist -- the CDS admission-factors seed; run bin/fetch-cds-seed" || rc=1
  rm -f "$EXTERNAL_ROOT/db/seed/cds"
  ln -s "$PROJECT_ROOT/db/seed/cds" "$EXTERNAL_ROOT/db/seed/cds"
  rm -rf "$seed"
  return "$rc"
}
assert_success "a missing CDS seed CSV is refused by name, and names bin/fetch-cds-seed" \
  test_load_external_data_refuses_a_missing_cds_seed

# RFC 170 made the CDS group FOUR files, and bin/ingest-colleges refuses three of
# the four (21). So the aid-policy seed is a required input of this wrapper too:
# without this it would be the one CDS file whose absence is reported by the
