#!/usr/bin/env bash
# is-nix is a standalone predicate reporting whether the caller is inside
# unicoach's OWN Nix dev shell. The signal is UNICOACH_DEV_SHELL, a marker this
# repo's flake.nix declares on devShells.default; IN_NIX_SHELL is not usable
# here because nix sets it for ANY flake's shell, so an unrelated project's
# shell would read as a false positive. IN_NIX_SHELL is consulted only to word
# the status line, never to decide the exit code. Sources ONLY bin/functions
# (never bin/common, which requires the very dev shell this predicate is meant
# to detect). The exit code is the contract; a human status line goes to stderr
# via log-info. Mirrors the bin/postgres-check convention.
set -euo pipefail

source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/functions"

help() {
  cat << 'EOF'
is-nix [options]

Exits 0 if the caller is inside unicoach's Nix dev shell (UNICOACH_DEV_SHELL
non-empty, as declared by this repo's flake.nix), 1 otherwise. A different
flake's shell exits 1, and says so. Sources only bin/functions, so it is safe
to call from scripts that must NOT enter the dev shell (e.g. bin/build-ios,
bin/install-ios).

Options:
  -q     Suppress the status line; report only via exit code.
  -v     Additionally list the enabled packages parsed from the
         exported nativeBuildInputs (ignored under -q).
  -h     Help
EOF
  exit 0
}

QUIET=0
VERBOSE=0
while getopts ":hqv" opt; do
  case "$opt" in
  h) help ;;
  q) QUIET=1 ;;
  v) VERBOSE=1 ;;
  \?) fatal -s "$EXIT_UNKNOWN_OPTION" "unknown option [-$OPTARG]" ;;
  :)  fatal -s "$EXIT_OPTION_REQUIRES_VALUE" "option [-$OPTARG] requires an argument" ;;
  esac
done
shift $((OPTIND-1))

if [ "$#" -gt 0 ]; then
  fatal -s "$EXIT_UNEXPECTED_ARG" "is-nix accepts no arguments: $*"
fi

# nativeBuildInputs holds space-separated /nix/store/<hash>-<name> paths; the
# package name is the basename with the leading <hash>- stripped.
list_packages() {
  local path name
  for path in ${nativeBuildInputs:-}; do
    name="${path##*/}"      # /nix/store/<hash>-<name> -> <hash>-<name>
    name="${name#*-}"       # <hash>-<name> -> <name>
    log-info "$name"
  done
}

# Marker first, unconditionally: inside unicoach's shell BOTH variables are set,
# so this branch must win over the IN_NIX_SHELL one below. Each status line names
# the deciding state, and no line is a prefix of another, so a caller or a test
# can match one without ambiguity.
if [ -n "${UNICOACH_DEV_SHELL:-}" ]; then
  if [ "$QUIET" -eq 0 ]; then
    log-info "unicoach dev shell active"
    if [ "$VERBOSE" -eq 1 ]; then
      list_packages
    fi
  fi
  exit 0
elif [ -n "${IN_NIX_SHELL:-}" ]; then
  # A Nix shell is active, but not this repo's: no unicoach toolchain here.
  # IN_NIX_SHELL only sharpens the message; the exit code is the same 1.
  if [ "$QUIET" -eq 0 ]; then
    log-info "unicoach dev shell NOT active (a different Nix shell is active)"
  fi
  exit 1
else
  if [ "$QUIET" -eq 0 ]; then
    log-info "unicoach dev shell NOT active (no Nix shell)"
  fi
  exit 1
fi
