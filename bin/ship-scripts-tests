#!/usr/bin/env bash
# ship-scripts-tests — shell assertions over the /ship scripts: ship-lock
# (RFC 167), ship-land's refusal of a foreign lock holder, ship-order (RFC 180
# D6) and ship-lens (RFC 234). One harness, one temp-dir style; the sections below
# are banner-separated and each names its own subject.
#
# The first subject is .prime/agent/skills/ship/scripts/ship-lock, the repo-wide
# gate that serialises phase 6 of a /ship run. Its one job that a human cannot eyeball
# is the exit-code-3 trap: bin/file-lock answers 3 when the lock is already held
# by an operation MATCHING -o, bin/daemon-up treats that as success, and a land
# that did the same would sail straight through the lock into the collision the
# lock exists to prevent. Assertion 2 is that case and it is the reason this file
# exists.
#
# NO WORKTREE, NO GRADLE, NO POSTGRES. Every assertion runs against a throwaway
# `git init` repo plus a fabricated run-scratch state file. That is not merely
# cheap: ship-lock derives its lock path from `git rev-parse --git-common-dir` of
# the repo named by the run state, so pointing the state at a temp repo is what
# keeps this harness off the REAL var/run/ship-land.lock — a test that acquired
# that one would silently gate every live /ship run on this machine for 15
# minutes. There is deliberately no test-only override flag: git is the override.
export ENV_FILES="${ENV_FILES:-.env.dev:.env.test}"
source "$(dirname "$0")/common"
source "$(dirname "$0")/tests-common"

help() {
  cat << 'EOF'
ship-scripts-tests [options]

Runs the shell assertions over .prime/agent/skills/ship/scripts/ship-lock (and
ship-land's refusal of a foreign lock holder), ship-order and ship-lens. Needs
no database, no daemon and no worktree: each assertion runs against a throwaway
git repo, run scratch and lens corpus under a temp dir.

Options:
  -h: Help
EOF
  exit 0
}

while getopts ":h" opt; do
  case "$opt" in
  h) help ;;
  \?) fatal -s "$EXIT_UNKNOWN_OPTION" "unknown option [-$OPTARG]" ;;
  :)  fatal -s "$EXIT_OPTION_REQUIRES_VALUE" "option [-$OPTARG] requires an argument" ;;
  esac
done
shift $((OPTIND-1))

if [ "$#" -ne 0 ]; then
  fatal -s "$EXIT_UNEXPECTED_ARG" "Error: ship-scripts-tests accepts no positional arguments."
fi

SHIP_SCRIPTS="$PROJECT_ROOT/.prime/agent/skills/ship/scripts"
SHIP_LOCK="$SHIP_SCRIPTS/ship-lock"
SHIP_LAND="$SHIP_SCRIPTS/ship-land"

[ -x "$SHIP_LOCK" ] || fail_test "ship-lock is missing or not executable [$SHIP_LOCK]"

# The hook that runs this harness exports GIT_DIR and GIT_INDEX_FILE, and both
# outrank `git -C`. Stripped here for this file's own `git init`; ship-lock strips
# them for itself, and the assertion at the end of the acquire section proves it.
strip_git_hook_env

FIXTURE_DIR="$(mktemp -d)"
trap 'rm -rf "$FIXTURE_DIR"' EXIT INT TERM

REPO="$FIXTURE_DIR/repo"
git init -q "$REPO"
LOCK_DIR="$REPO/var/run/ship-land.lock"

# Two runs of the same repo, exactly as two live /ship worktrees would be. Only
# RUN_ID differs, which is the whole point: the operation name IS the run id, so
# no two runs ever match and a second lander waits instead of being told it
# already holds the lock.
# make_run <run-id> [repo] [base-sha]
#
# The repo defaults to $REPO (the lock fixture); the ship-order cases pass their
# own throwaway repo and the BASE_SHA that script reads the landed ORDER from.
# A run-scratch state file is the whole interface of every ship script, so one
# writer serves both sections.
make_run() {
  # Two statements, not one `local a=… b=…`: bash creates every name in a
  # single `local` before assigning any of them, so `b="$a"` reads an UNSET a
  # and aborts under `set -u`.
  local run_id="$1"
  local repo="${2:-$REPO}"
  local base_sha="${3:-}"
  local rs="$FIXTURE_DIR/$run_id"
  mkdir -p "$rs"
  {
    echo "RUN_ID=$run_id"
    echo "LANE=quick"
    echo "BRANCH=ship/$run_id"
    echo "CODEBASE_ROOT=$repo"
    echo "ORIGINAL_CHECKOUT=$repo"
    echo "BASE_BRANCH=main"
    [ -n "$base_sha" ] && echo "BASE_SHA=$base_sha"
    echo "RUN_SCRATCH=$rs"
    echo "PHASE=landing"
  } > "$rs/state"
  echo "$rs"
}

RS_A="$(make_run run-a)"
RS_B="$(make_run run-b)"

holder() { cat "$LOCK_DIR/op" 2>/dev/null || echo "(none)"; }
clear_lock() { rm -rf "$LOCK_DIR" "$LOCK_DIR".stale.* 2>/dev/null || true; }

echo "==== ship-lock: acquire ===="

# 1. A free lock is taken, and the holder recorded is this run's RUN_ID.
clear_lock
assert_success "acquire on a free lock exits 0" \
  "$SHIP_LOCK" -s "$RS_A" acquire
[ -d "$LOCK_DIR" ] || fail_test "acquire did not create the lock directory"
[ "$(holder)" = "run-a" ] || fail_test "acquire wrote op=[$(holder)], expected [run-a]"
pass_test "acquire records op = RUN_ID"

# 2. THE ONE THAT MATTERS. A second, DIFFERENT run must be blocked. If ship-lock
# ever passed a fixed -o, file-lock would answer 3 ("held by a matching
# operation"), and a caller copying daemon-up's reading of 3 would call that
# success — two runs inside the gate at once.
assert_failure "a second, different RUN_ID is BLOCKED (file-lock 3 is never success)" \
  "$SHIP_LOCK" -s "$RS_B" -t 1s acquire
[ "$(holder)" = "run-a" ] || fail_test "the blocked run overwrote op with [$(holder)]"
pass_test "the blocked run left the holder untouched"

# 2c. `git -C` loses to GIT_DIR, and a git hook exports GIT_DIR. Without the
# strip in ship-lock, this harness — which the pre-commit hook runs — walks out
# of its fixture and takes the REAL var/run/ship-land.lock, blocking every live
# /ship run on the machine for 15 minutes. That is not hypothetical: it is how
# this assertion came to exist. The lock stays held by run-a for 2b below;
# `status` is read-only, which is what makes that safe.
GIT_DIR="$PROJECT_ROOT/.git" "$SHIP_LOCK" -s "$RS_A" status | grep -q "held by \[run-a\].*$LOCK_DIR" ||
  fail_test "GIT_DIR overrode the run's own repo: ship-lock resolved a lock outside the fixture"
pass_test "GIT_DIR from a hook cannot move the lock off the run's own repo"

# 2b. The SAME run re-acquiring is a success, and the hold is refreshed. A
# compacted session is told to re-read PHASE and re-enter it, so a resumed run
# runs `acquire` a second time; refusing there would break the skill's own
# recovery path, and a silent success without the refresh would hand it a lock
# about to expire under its own gate.
echo "$(( $(date +%s) + 30 ))" > "$LOCK_DIR/expires-at"
assert_success "the SAME run re-acquiring is a no-op success" \
  "$SHIP_LOCK" -s "$RS_A" acquire
[ "$(cat "$LOCK_DIR/expires-at")" -gt "$(( $(date +%s) + 600 ))" ] ||
  fail_test "re-acquire did not refresh the hold (expires-at=$(cat "$LOCK_DIR/expires-at"), now=$(date +%s))"
pass_test "re-acquire refreshes the hold to the full 15m"

echo ""
echo "==== ship-lock: release ===="

# 3. The holder drops it, and the queue moves.
assert_success "release by the holder exits 0" \
  "$SHIP_LOCK" -s "$RS_A" release
[ ! -d "$LOCK_DIR" ] || fail_test "release left the lock directory behind"
pass_test "release removes the lock"
assert_success "the other run can then acquire" \
  "$SHIP_LOCK" -s "$RS_B" acquire

# 4. A foreign holder is not a script's to break; -f is for a human, and it says
# whose lock it took.
assert_failure "release by a NON-holder fails" \
  "$SHIP_LOCK" -s "$RS_A" release
[ "$(holder)" = "run-b" ] || fail_test "a refused release damaged the lock (op=[$(holder)])"
pass_test "a refused release leaves the lock intact"
force_err="$("$SHIP_LOCK" -s "$RS_A" -f release 2>&1 >/dev/null)" ||
  fail_test "release -f by a non-holder should succeed"
echo "$force_err" | grep -q "WARNING" ||
  fail_test "release -f did not warn; said [$force_err]"
echo "$force_err" | grep -q "run-b" ||
  fail_test "release -f did not name the displaced holder; said [$force_err]"
pass_test "release -f breaks a foreign lock and warns, naming the holder"

# 5. An expiry is what stops a killed session wedging every other run. The lock
# is time-based, so a lock whose expires-at is in the past is taken from it.
clear_lock
mkdir -p "$LOCK_DIR"
echo "run-b" > "$LOCK_DIR/op"
echo "$(( $(date +%s) - 10 ))" > "$LOCK_DIR/expires-at"
assert_success "an EXPIRED lock is broken and re-acquired" \
  "$SHIP_LOCK" -s "$RS_A" acquire
[ "$(holder)" = "run-a" ] || fail_test "expired lock not taken over (op=[$(holder)])"
pass_test "the expired holder was replaced by the acquiring run"

# 5b. The expiry break is where mutual exclusion is hardest to keep: file-lock
# does `mv` the stale lock aside, then `mkdir`, and the pair is not atomic, so
# two runs whose expiry reads both predate the other's break can BOTH exit 0.
# Single-threaded assertion 5 cannot see that, and neither can racers that merely
# start at about the same time — they must be released together. So the racers
# spin on a start file and are freed at once, and the trial is repeated: the
# defect this guards is probabilistic — with the confirmation removed, 12 racers
# reproduced it in 3 of 8 trials and 8 racers in roughly 1 in 4; with it in
# place, never once — so a single trial would be a test that passes for the
# wrong reason, and no number of trials makes it a proof. It is a net, not a
# gate: sized here at 2 trials because the honest alternative is 14 seconds in
# every pre-commit run, and this defect is one a reviewer found by reading.
RACERS=8
TRIALS=2
for r in $(seq 1 "$RACERS"); do make_run "race-$r" > /dev/null; done
for t in $(seq 1 "$TRIALS"); do
  clear_lock
  mkdir -p "$LOCK_DIR"
  echo "run-z" > "$LOCK_DIR/op"
  echo "$(( $(date +%s) - 10 ))" > "$LOCK_DIR/expires-at"
  wins="$FIXTURE_DIR/wins-$t"
  mkdir -p "$wins"
  # A fifo, not a spin on a flag file: 12 busy-waiting subshells cost more CPU
  # than the whole rest of this harness, and every racer blocking in `read`
  # until one write releases them all is a tighter start anyway.
  gate="$FIXTURE_DIR/gate-$t"
  mkfifo "$gate"
  for r in $(seq 1 "$RACERS"); do
    (
      read -r _ < "$gate"
      "$SHIP_LOCK" -s "$FIXTURE_DIR/race-$r" -t 1s acquire > /dev/null 2>&1 &&
        echo won > "$wins/$r"
    ) &
  done
  sleep 0.2
  for r in $(seq 1 "$RACERS"); do echo go; done > "$gate"
  wait
  winners="$(find "$wins" -type f | wc -l | tr -d ' ')"
  [ "$winners" -eq 1 ] ||
    fail_test "trial $t: $RACERS runs raced an EXPIRED lock and $winners won; exactly 1 may"
done
pass_test "exactly one run wins the race to break an expired lock, over $TRIALS trials"
clear_lock
"$SHIP_LOCK" -s "$RS_A" acquire

echo ""
echo "==== ship-lock: status ===="

# 6. status reports; it never judges. Exit 0 either way — ship-status calls it on
# every listed run, and a free lock is not an error.
status_held="$("$SHIP_LOCK" -s "$RS_A" status)" || fail_test "status on a HELD lock should exit 0"
echo "$status_held" | grep -q "held by \[run-a\]" ||
  fail_test "status on a held lock did not name the holder; said [$status_held]"
pass_test "status on a held lock names the holder and exits 0"
"$SHIP_LOCK" -s "$RS_A" release
status_free="$("$SHIP_LOCK" -s "$RS_A" status)" || fail_test "status on a FREE lock should exit 0"
echo "$status_free" | grep -q "free" ||
  fail_test "status on a free lock did not say so; said [$status_free]"
pass_test "status on a free lock says so and exits 0"

echo ""
echo "==== ship-lock: usage grammar ===="

# 7. The reserved bin/functions exit codes. ship-lock copies the values rather
# than sourcing bin/common, so these assertions are what stops the copy drifting:
# a caller that invoked it wrongly must be distinguishable from a run that
# faulted, and identically so across bin/.
assert_exit_code "$EXIT_UNKNOWN_OPTION" "unknown option exits EXIT_UNKNOWN_OPTION" \
  "$SHIP_LOCK" -Z -s "$RS_A" status
assert_exit_code "$EXIT_OPTION_REQUIRES_VALUE" "-s without a value exits EXIT_OPTION_REQUIRES_VALUE" \
  "$SHIP_LOCK" -s
assert_exit_code "$EXIT_INVALID_ARG_VALUE" "an unknown subcommand exits EXIT_INVALID_ARG_VALUE" \
  "$SHIP_LOCK" -s "$RS_A" grab
assert_exit_code "$EXIT_MISSING_REQUIRED_ARG" "acquire without -s exits EXIT_MISSING_REQUIRED_ARG" \
  "$SHIP_LOCK" acquire
assert_exit_code "$EXIT_MISSING_REQUIRED_ARG" "no subcommand at all exits EXIT_MISSING_REQUIRED_ARG" \
  "$SHIP_LOCK" -s "$RS_A"
assert_exit_code "$EXIT_UNEXPECTED_ARG" "a surplus positional exits EXIT_UNEXPECTED_ARG" \
  "$SHIP_LOCK" -s "$RS_A" status extra
# -t is a value, and getopts only guarantees it was PRESENT. CLAUDE.md's bin/ rule
# is that value-shape checks belong after the grammar: without one this reaches
# wait-for, which fails with its own copy of the same code and names itself, not
# ship-lock, in the message.
assert_exit_code "$EXIT_INVALID_ARG_VALUE" "-t with a non-duration exits EXIT_INVALID_ARG_VALUE" \
  "$SHIP_LOCK" -s "$RS_A" -t bogus acquire
# Both orders parse. getopts stops at the first non-option, so without the second
# pass this — the order RFC 167 itself writes — would be a surplus positional.
assert_success "options may FOLLOW the subcommand (ship-lock status -s <rs>)" \
  "$SHIP_LOCK" status -s "$RS_A"

echo ""
echo "==== ship-lock: the stdout/stderr invariant ===="

# 8. bin/ rule: stdout carries ONLY what the caller asked for. `-h` asked for the
# help; acquire and release asked for a lock, so their progress and their result
# are diagnostics and belong on stderr. This is exactly what regresses when
# someone "helpfully" turns a log-info into an echo.
help_out="$("$SHIP_LOCK" -h 2>/dev/null)" || fail_test "-h should exit 0"
[ -n "$help_out" ] || fail_test "-h printed nothing to stdout"
pass_test "-h exits 0 and prints the help to stdout"
clear_lock
acquire_out="$("$SHIP_LOCK" -s "$RS_A" acquire 2>/dev/null)"
[ -z "$acquire_out" ] || fail_test "acquire wrote to stdout: [$acquire_out]"
release_out="$("$SHIP_LOCK" -s "$RS_A" release 2>/dev/null)"
[ -z "$release_out" ] || fail_test "release wrote to stdout: [$release_out]"
pass_test "acquire and release write NOTHING to stdout on success"

echo ""
echo "==== ship-lock: status with no -s ===="

# The ONLY path that resolves the anchor to the script's own checkout and so
# names the REAL lock. Read-only, and it is what a human or a killed run's
# survivor actually types — there is no state file left to pass -s.
clear_lock
status_bare="$("$SHIP_LOCK" status)" || fail_test "bare status should exit 0"
echo "$status_bare" | grep -qE "lock (free|held by)" ||
  fail_test "bare status printed no verdict; said [$status_bare]"
pass_test "status needs no -s and answers for this checkout"

echo ""
echo "==== ship-land: the foreign-holder backstop ===="

# ship-land is the backstop: correctness must not depend on phase 6 remembering
# to take the lock. Only the refusal is reachable without a real worktree, and it
# is the half that matters — it fires BEFORE the ship-verified assert and before
# any git write, so a run whose hook ran against a base another run is about to
# move is stopped rather than fast-forwarded. The fast-forward path itself stays
# uncovered here, as it is today: it needs a real worktree, and a /ship run
# exercises it every time it lands.
clear_lock
"$SHIP_LOCK" -s "$RS_B" acquire
land_err="$("$SHIP_LAND" -s "$RS_A" 2>&1 >/dev/null)" && land_status=0 || land_status=$?
[ "$land_status" -ne 0 ] || fail_test "ship-land landed while another run held the lock"
echo "$land_err" | grep -q "run-b" ||
  fail_test "ship-land did not name the foreign holder; said [$land_err]"
pass_test "ship-land refuses a lock held by another run, naming the holder"
clear_lock

# The prompt-seed re-check is WIRING, and wiring is what silently disappears:
# ship-land calls bin/prompt-seed by a path it builds from $CODEBASE_ROOT (RFC
# 181 step 3c), and the call is guarded on that path being executable. So a
# renamed or moved script does not FAIL a land — it SKIPS this gate, and every
# other check stays green. These two assertions are the only thing that would
# ever say so. The full path needs a real worktree; the wiring does not.
grep -q 'PROMPT_SEED" -b "\$BASE_SHA" -d "\$CODEBASE_ROOT/db/schema" -n' "$SHIP_LAND" ||
  fail_test "ship-land no longer runs bin/prompt-seed -b \$BASE_SHA -d <schema dir> -n before the fast-forward"
grep -q 'run_land_gate "bin/prompt-seed"' "$SHIP_LAND" ||
  fail_test "ship-land no longer routes bin/prompt-seed through run_land_gate, so its status is not passed through"
grep -q 'exit "\$status"' "$SHIP_LAND" ||
  fail_test "run_land_gate no longer exits with the gated tool's OWN status"
pass_test "ship-land runs bin/prompt-seed -n before the fast-forward and passes its status through"

# The schema directory is passed EXPLICITLY. bin/prompt-seed used to be routed by
# the inherited $DB_SCHEMA_DIR, which bin/common calls "a caller's variable, not
# a routing channel": a stale export in whoever invoked ship-land would have made
# the gate read and report on ANOTHER checkout, and call the landing tree green
# without ever reading it.
# Comments are stripped first: the script EXPLAINS the rule by naming the very
# variable it forbids itself, which is exactly the text a naive grep would find.
if grep -vE '^[[:space:]]*#' "$PROJECT_ROOT/bin/prompt-seed" | grep -q 'DB_SCHEMA_DIR'; then
  fail_test "bin/prompt-seed reads \$DB_SCHEMA_DIR again; it must be routed by -d only"
fi
pass_test "bin/prompt-seed is routed by an explicit -d, never by the inherited \$DB_SCHEMA_DIR"

# The guard is on PRESENCE, and a present-but-not-executable file is a LOUD
# failure rather than a skipped gate. A single `[ -x ]` answered "the exec bit is
# gone" with "this checkout predates RFC 181" and deleted the gate in silence.
grep -q 'if \[ -e "\$PROMPT_SEED" \]' "$SHIP_LAND" ||
  fail_test "ship-land no longer guards bin/prompt-seed on EXISTENCE; an [ -x ] guard skips the gate on a lost exec bit"
grep -q 'exists but is not executable' "$SHIP_LAND" ||
  fail_test "ship-land no longer fails loudly on a present-but-not-executable bin/prompt-seed"
pass_test "ship-land distinguishes an absent bin/prompt-seed from one that lost its exec bit"

# And a DANGLING SYMLINK is the same fault as a lost exec bit, not the same
# state as a checkout that predates RFC 181. `[ -e ]` follows the link, so on
# its own it answers "absent" for a link pointing at nothing and skips the gate
# in silence — the exact conflation the paragraph above the guard refuses. `-L`
# sees the link itself and `-f` refuses it.
grep -q '\[ -L "\$PROMPT_SEED" \]' "$SHIP_LAND" ||
  fail_test "ship-land no longer probes bin/prompt-seed with [ -L ]; a dangling symlink then reads as absent and the gate is skipped"
grep -q 'is not a regular file' "$SHIP_LAND" ||
  fail_test "ship-land no longer refuses a bin/prompt-seed that is not a regular file (a dangling symlink, a directory)"
pass_test "ship-land refuses a dangling-symlink or directory bin/prompt-seed instead of skipping the gate"
[ -x "$PROJECT_ROOT/bin/prompt-seed" ] ||
  fail_test "ship-land's guarded path names no executable [$PROJECT_ROOT/bin/prompt-seed], so the gate would be skipped"
pass_test "the path ship-land guards on names a script that exists and is executable"

echo ""
echo "==== ship-land: the docs-only fast path (RFC 193) ===="

# RFC 167 serialises phase 6 so two runs cannot spend the gate on the same base,
# but a plain `docs:` commit on main never takes that lock — it is an ordinary
# commit from a session that is not in phase 6 at all. It moved main under a live
# run four times on 2026-09-11 and cost ~16 minutes of gate time. RFC 193's fast
# path replays the run onto a base that advanced ONLY by product/** commits and
# lands it without re-running the gate.
#
# Unlike the lock assertions above, these need a REAL worktree and a REAL
# fast-forward: the thing under test is what ship-land does to the base branch,
# and a grep over the source would pass on a script that never runs. Everything
# is still local — a throwaway `git init`, no Gradle, no database, no hook. The
# verified-tree marker is written by hand, which is exactly what bin/pre-commit
# would have appended.
#
# fast_path_fixture <run-id> — sets FP_REPO, FP_WT, FP_RS, FP_BASE and leaves the
# run's own commit on ship/<run-id> with its tree recorded as verified.
fast_path_fixture() {
  local run_id="$1"
  FP_REPO="$FIXTURE_DIR/fp-$run_id"
  FP_WT="$FIXTURE_DIR/fp-$run_id-wt"
  FP_RS="$FIXTURE_DIR/fp-$run_id-rs"
  git init -q "$FP_REPO"
  # A repo whose HEAD is `master` would make BASE_BRANCH=main a lie; name the
  # branch rather than inheriting the machine's init.defaultBranch.
  git -C "$FP_REPO" symbolic-ref HEAD refs/heads/main
  git -C "$FP_REPO" config user.email "ship-scripts-tests@example.invalid"
  git -C "$FP_REPO" config user.name "ship-scripts-tests"
  git -C "$FP_REPO" config commit.gpgsign false
  # db/schema/ORDER exists because ship-land's step 3b gate runs `ship-order -n`
  # against it; an empty corpus is a no-op there, which is what this section
  # wants — the subject is step 3a, not the migration manifest.
  mkdir -p "$FP_REPO/db/schema" "$FP_REPO/product" "$FP_REPO/src" "$FP_REPO/rfc"
  : > "$FP_REPO/db/schema/ORDER"
  echo "status" > "$FP_REPO/product/STATUS.md"
  echo "code" > "$FP_REPO/src/code.txt"
  git -C "$FP_REPO" add -A
  git -C "$FP_REPO" commit -q -m "init"
  FP_BASE="$(git -C "$FP_REPO" rev-parse HEAD)"

  git -C "$FP_REPO" worktree add -q -b "ship/$run_id" "$FP_WT" main
  git -C "$FP_WT" config user.email "ship-scripts-tests@example.invalid"
  git -C "$FP_WT" config user.name "ship-scripts-tests"
  git -C "$FP_WT" config commit.gpgsign false
}

# fast_path_verify_and_state — records the run's tip tree as hook-verified and
# writes the run scratch. Called after the caller has made the run's commits.
fast_path_verify_and_state() {
  local run_id="$1"
  git -C "$FP_WT" rev-parse 'HEAD^{tree}' >> "$FP_REPO/.git/ship-verified-trees"
  mkdir -p "$FP_RS"
  {
    echo "RUN_ID=$run_id"
    echo "LANE=quick"
    echo "BRANCH=ship/$run_id"
    echo "CODEBASE_ROOT=$FP_WT"
    echo "ORIGINAL_CHECKOUT=$FP_REPO"
    echo "BASE_BRANCH=main"
    echo "BASE_SHA=$FP_BASE"
    echo "RUN_SCRATCH=$FP_RS"
    echo "PHASE=landing"
  } > "$FP_RS/state"
}

# The ordinary run: one code commit, hook-verified, ready to land.
fast_path_run_commit() {
  echo "new" > "$FP_WT/src/new.txt"
  git -C "$FP_WT" add -A
  git -C "$FP_WT" commit -q -m "feat: the run's own work"
}

fp_err="$FIXTURE_DIR/fast-path.err"
fp_status=0
run_ship_land() {
  fp_status=0
  "$SHIP_LAND" -s "$FP_RS" > /dev/null 2> "$fp_err" || fp_status=$?
}

# The archived state, since a LANDED run's scratch has been moved out of the
# worktree ship-land deleted.
fp_state() { cat "$FP_RS/state" 2> /dev/null || cat "$FP_REPO/.scratch/ship-archive/$1/state"; }
fp_note() { cat "$FP_RS/land-fast-path.md" 2> /dev/null || cat "$FP_REPO/.scratch/ship-archive/$1/land-fast-path.md"; }

# 1. THE CASE THE FAST PATH EXISTS FOR, and the nesting matters. Real doc traffic
# is several levels deep (product/0009-say-it-once/research/_parts/x.md), so a
# single-level `product/*` glob would match STATUS.md and silently miss the
# research files — recognising the deep path is the assertion that pins the
# PREFIX contract rather than a glob.
fast_path_fixture fp-docs
fast_path_run_commit
fast_path_verify_and_state fp-docs
mkdir -p "$FP_REPO/product/0009-brief/research/_parts"
echo "deep" > "$FP_REPO/product/0009-brief/research/_parts/history.md"
git -C "$FP_REPO" add -A
git -C "$FP_REPO" commit -q -m "docs: a deeply nested research part"
echo "more" >> "$FP_REPO/product/STATUS.md"
git -C "$FP_REPO" add -A
git -C "$FP_REPO" commit -q -m "docs: product status"
FP_RUN_TIP="$(git -C "$FP_WT" rev-parse HEAD)"
run_ship_land
[ "$fp_status" -eq 0 ] ||
  fail_test "ship-land refused a docs-only advance (status $fp_status): $(cat "$fp_err")"
git -C "$FP_REPO" log --oneline main | grep -q "the run's own work" ||
  fail_test "the fast path landed without this run's work on main"
git -C "$FP_REPO" log --oneline main | grep -q "deeply nested research part" ||
  fail_test "the fast path dropped the docs commits it replayed onto"
[ "$(git -C "$FP_REPO" rev-parse main)" != "$FP_RUN_TIP" ] ||
  fail_test "main is the PRE-rebase tip: the run was never replayed onto the docs commits"
pass_test "a docs-only advance (including a 3-level-deep product path) lands with no second gate run"

# 2. The record, without which a land that skipped the gate and one that ran it
# are indistinguishable afterwards.
fp_state fp-docs | grep -qx "LAND_FAST_PATH=docs-only" ||
  fail_test "the run state does not record LAND_FAST_PATH=docs-only: $(fp_state fp-docs)"
fp_state fp-docs | grep -qE "^LAND_FAST_PATH_COMMITS=[0-9a-f]+,[0-9a-f]+$" ||
  fail_test "LAND_FAST_PATH_COMMITS does not name the two commits as single-token short shas: $(fp_state fp-docs)"
# Single tokens are not cosmetic: the state file is SOURCED by every ship script,
# so `KEY=two words` would execute `words` on the next load.
if fp_state fp-docs | grep -E "^LAND_FAST_PATH" | grep -q " "; then
  fail_test "a LAND_FAST_PATH value contains a space, and the state file is sourced"
fi
fp_note fp-docs | grep -q "docs-only" ||
  fail_test "land-fast-path.md does not classify the commits it skipped the gate for"
pass_test "the fast path records its verdict and the commits it classified"

# 3. THE TRAP, driven in the exact order that springs it: docs -> code -> docs.
# The advance has a docs-only TIP and is not docs-only. A check that looked at
# the tip, or at the cumulative diff, sleeps through exactly this case — the same
# shape as the stale-BASE_SHA trap the skill already documents.
fast_path_fixture fp-mixed
fast_path_run_commit
fast_path_verify_and_state fp-mixed
echo "a" > "$FP_REPO/product/a.md"
git -C "$FP_REPO" add -A && git -C "$FP_REPO" commit -q -m "docs: first"
echo "x" > "$FP_REPO/src/theirs.txt"
git -C "$FP_REPO" add -A && git -C "$FP_REPO" commit -q -m "feat: their code"
echo "b" > "$FP_REPO/product/b.md"
git -C "$FP_REPO" add -A && git -C "$FP_REPO" commit -q -m "docs: last"
run_ship_land
[ "$fp_status" -ne 0 ] ||
  fail_test "ship-land took the fast path over a docs -> CODE -> docs advance"
grep -q "advanced past this run's base" "$fp_err" ||
  fail_test "the mixed advance did not fall back to today's refusal: $(cat "$fp_err")"
fp_state fp-mixed | grep -qx "LAND_FAST_PATH=none" ||
  fail_test "a refused advance did not record LAND_FAST_PATH=none"
fp_note fp-mixed | grep -q "not-docs (src/theirs.txt)" ||
  fail_test "the classification does not name the commit that made the advance mixed"
pass_test "docs -> code -> docs REFUSES, and the record names the code path that decided it"

# 4. Three advances that are NOT this predicate, each one a way a wider or lazier
# test would wrongly qualify. rfc/**, deliberately excluded so the day a test
# reads an RFC as a fixture the predicate is not silently wrong; a commit with NO
# paths, which satisfies "every path is under product/" vacuously and is the
# classic empty-set silent pass; and a merge, which is not a replay of anybody's
# docs commit and has no single parent to diff against.
fp_refuses() { # fp_refuses <run-id> <expected note text> <advance commands...>
  local run_id="$1" expect="$2"
  shift 2
  fast_path_fixture "$run_id"
  fast_path_run_commit
  fast_path_verify_and_state "$run_id"
  ( cd "$FP_REPO" && eval "$@" )
  run_ship_land
  [ "$fp_status" -ne 0 ] ||
    fail_test "[$run_id] ship-land took the fast path over an advance that is not docs-only"
  fp_state "$run_id" | grep -qx "LAND_FAST_PATH=none" ||
    fail_test "[$run_id] did not record LAND_FAST_PATH=none"
  fp_note "$run_id" | grep -q "$expect" ||
    fail_test "[$run_id] classification does not say [$expect]: $(fp_note "$run_id")"
}

fp_refuses fp-rfc "not-docs (rfc/999-x.md)" \
  'echo x > rfc/999-x.md && git add -A && git commit -q -m "rfc: 999"'
pass_test "an rfc/**-only advance is NOT docs-only — the predicate is product/ and nothing else"

fp_refuses fp-empty "not-docs (no paths)" \
  'echo a > product/a.md && git add -A && git commit -q -m "docs: one" && git commit -q --allow-empty -m "empty"'
pass_test "a commit that changes NO path is not docs-only (an empty set does not satisfy the test)"

fp_refuses fp-merge "not-docs (parents: 2)" \
  'git checkout -q -b side && echo a > product/side.md && git add -A && git commit -q -m "docs: side" &&
   git checkout -q main && echo b > product/main.md && git add -A && git commit -q -m "docs: main" &&
   git merge -q --no-ff side -m "merge docs"'
pass_test "a MERGE whose whole diff is under product/ is still not docs-only"

fp_refuses fp-lookalike "not-docs (productX/a.md)" \
  'mkdir -p productX && echo a > productX/a.md && git add -A && git commit -q -m "docs: lookalike"'
pass_test "the prefix is [product/]: a productX/ path does not qualify"

# 5. A conflicting replay ABORTS and falls back, leaving the worktree exactly as
# it was. Two runs editing the same product file is a real disagreement for a
# human to read — not something the one script that reaches main resolves
# mechanically — and a rebase left IN PROGRESS here would wedge the worktree the
# operator is about to work in.
fast_path_fixture fp-conflict
echo "the run's sentence" > "$FP_WT/product/STATUS.md"
echo "new" > "$FP_WT/src/new.txt"
git -C "$FP_WT" add -A
git -C "$FP_WT" commit -q -m "feat: the run's own work"
fast_path_verify_and_state fp-conflict
FP_CONFLICT_HEAD="$(git -C "$FP_WT" rev-parse HEAD)"
echo "their sentence" > "$FP_REPO/product/STATUS.md"
git -C "$FP_REPO" add -A && git -C "$FP_REPO" commit -q -m "docs: their edit to the same file"
run_ship_land
[ "$fp_status" -ne 0 ] ||
  fail_test "ship-land landed a replay that conflicted"
grep -q "FAILED and was aborted" "$fp_err" ||
  fail_test "the conflicting replay did not report an abort: $(cat "$fp_err")"
[ "$(git -C "$FP_WT" rev-parse HEAD)" = "$FP_CONFLICT_HEAD" ] ||
  fail_test "the aborted replay moved the run's HEAD"
[ ! -e "$(git -C "$FP_WT" rev-parse --git-path rebase-merge)" ] &&
  [ ! -e "$(git -C "$FP_WT" rev-parse --git-path rebase-apply)" ] ||
  fail_test "the conflicting replay left a rebase IN PROGRESS in the run's worktree"
[ -z "$(git -C "$FP_WT" status --porcelain)" ] ||
  fail_test "the aborted replay left the run's worktree dirty"
fp_state fp-conflict | grep -qx "LAND_FAST_PATH=none" ||
  fail_test "the aborted replay recorded a fast path it did not take"
pass_test "a conflicting docs-only replay aborts, restores the worktree, and falls back to the gate"

# 6. The generated-artifact land gates run AFTER the replay, on the tree that
# actually lands. Nothing else in this section would notice if step 3a were moved
# below them — the fixture's ORDER is empty and it has no bin/prompt-seed — so the
# ordering is pinned with a bin/prompt-seed STUB that records the arguments it was
# handed. ship-land passes it `-b "$BASE_SHA"`, so the recorded base being the
# POST-replay tip is the proof: the gate saw the landing base, not the stale one.
fast_path_fixture fp-gates
mkdir -p "$FP_WT/bin"
cat > "$FP_WT/bin/prompt-seed" << 'STUB'
#!/usr/bin/env bash
# Test stub: record the arguments ship-land handed the coach-prompt land gate.
echo "$*" > "${PROMPT_SEED_ARGS:-/dev/null}"
exit 0
STUB
chmod +x "$FP_WT/bin/prompt-seed"
echo "new" > "$FP_WT/src/new.txt"
git -C "$FP_WT" add -A
git -C "$FP_WT" commit -q -m "feat: the run's own work"
fast_path_verify_and_state fp-gates
echo "more" >> "$FP_REPO/product/STATUS.md"
git -C "$FP_REPO" add -A
git -C "$FP_REPO" commit -q -m "docs: product status"
FP_MOVED_TIP="$(git -C "$FP_REPO" rev-parse main)"
PROMPT_SEED_ARGS="$FIXTURE_DIR/prompt-seed.args"
export PROMPT_SEED_ARGS
run_ship_land
unset PROMPT_SEED_ARGS
[ "$fp_status" -eq 0 ] ||
  fail_test "the fast path failed with a bin/prompt-seed present: $(cat "$fp_err")"
[ -f "$FIXTURE_DIR/prompt-seed.args" ] ||
  fail_test "the coach-prompt land gate never ran on the fast path"
grep -q -- "-b $FP_MOVED_TIP" "$FIXTURE_DIR/prompt-seed.args" ||
  fail_test "the land gate ran against the STALE base [$(cat "$FIXTURE_DIR/prompt-seed.args")], not the replayed one [$FP_MOVED_TIP] — step 3a must come before it"
pass_test "the generated-artifact land gates run AFTER the replay, against the base that lands"

# 7. A worktree already mid-rebase is NOT this step's to touch. The fallback
# aborts, and aborting an operator's paused rebase — while calling it a conflict
# of our own — destroys work the old code left alone while refusing cleanly.
fast_path_fixture fp-busy
fast_path_run_commit
fast_path_verify_and_state fp-busy
echo "more" >> "$FP_REPO/product/STATUS.md"
git -C "$FP_REPO" add -A
git -C "$FP_REPO" commit -q -m "docs: product status"
# A rebase left in progress, exactly as ship-rebase leaves one on conflict.
git -C "$FP_WT" rebase -x false HEAD~1 > /dev/null 2>&1 || true
[ -e "$(git -C "$FP_WT" rev-parse --git-path rebase-merge)" ] ||
  fail_test "the fixture did not manage to leave a rebase in progress"
run_ship_land
[ "$fp_status" -ne 0 ] ||
  fail_test "ship-land landed a worktree that was mid-rebase"
[ -e "$(git -C "$FP_WT" rev-parse --git-path rebase-merge)" ] ||
  fail_test "the fast path ABORTED an operation it did not start"
grep -q "already in progress" "$fp_err" ||
  fail_test "the busy worktree was not reported as such: $(cat "$fp_err")"
git -C "$FP_WT" rebase --abort > /dev/null 2>&1 || true
pass_test "a worktree already mid-rebase is left untouched, not aborted and reported as a conflict"

# 8. A path whose only difference from product/ is leading whitespace. `read`
# without IFS= strips it, so a directory literally named " product" was
# classified docs-only and skipped the gate — demonstrated, not theorised.
fp_refuses fp-space "not-docs" \
  'mkdir -p " product" && echo a > " product/x.txt" && git add -A && git commit -q -m "docs: leading space"'
pass_test "a leading-space \" product/\" path does not read as product/ (IFS= on the path reader)"

# 9. The unmoved base still lands, and says it took no fast path. This is the
# common case, and it is here because the cheapest way to break every land is to
# make the new step fire when nothing advanced.
fast_path_fixture fp-still
fast_path_run_commit
fast_path_verify_and_state fp-still
run_ship_land
[ "$fp_status" -eq 0 ] ||
  fail_test "ship-land refused a run whose base never moved (status $fp_status): $(cat "$fp_err")"
fp_state fp-still | grep -qx "LAND_FAST_PATH=none" ||
  fail_test "a land with no advance did not record LAND_FAST_PATH=none"
fp_state fp-still | grep -qx "LAND_FAST_PATH_COMMITS=none" ||
  fail_test "a land with no advance named commits it never classified"
pass_test "a base that did not move lands as before, recorded as no fast path"

echo ""
echo "==== ship-order: land-time re-placement of db/schema/ORDER ===="

# ship-order is the other half of the land gate (RFC 180 D6): db/schema/ORDER is
# the DECLARED apply order of the migration corpus, and the only moment the true
# order is a fact rather than a prediction is the moment a run lands. The run
# appended its line early — its own tests refuse an unordered migration — so at
# land the line sits wherever the run happened to put it, possibly AHEAD of
# migrations that landed while it was open. Every assertion below is about that
# re-placement, and, like the lock assertions, needs nothing but a throwaway git
# repo and a fabricated run-scratch state file.
SHIP_ORDER="$SHIP_SCRIPTS/ship-order"
[ -x "$SHIP_ORDER" ] || fail_test "ship-order is missing or not executable [$SHIP_ORDER]"

# ship-order's exit vocabulary, named once and used at every site below: 1 is a
# REFUSAL (the corpus is corrupt), 3 is the -n verdict "ORDER would change".
# ship-land tells the two apart and reports them differently, so these
# assertions name them too rather than testing bare numbers.
SHIP_ORDER_REFUSED=1
SHIP_ORDER_WOULD_CHANGE=3

order_err="$FIXTURE_DIR/order.err"
order_status=0

# Records BOTH halves of the answer: stderr in $order_err and the exit status in
# $order_status. A refusal assertion that discards the status (`... || true`)
# and greps only stderr passes on a ship-order that printed the refusal and
# exited 0 — a test that cannot fail. Every refusal case below asserts both.
run_ship_order() {
  order_status=0
  "$SHIP_ORDER" "$@" 2> "$order_err" || order_status=$?
}

ORDER_REPO="$FIXTURE_DIR/order-repo"
ORDER_SCHEMA="$ORDER_REPO/db/schema"
mkdir -p "$ORDER_SCHEMA"
git init -q "$ORDER_REPO"
# The fixture commits, and a commit needs an identity. Set it on the throwaway
# repo rather than trusting whatever global config the running machine has.
git -C "$ORDER_REPO" config user.email "ship-scripts-tests@example.invalid"
git -C "$ORDER_REPO" config user.name "ship-scripts-tests"

write_order() { printf '%s\n' "$@" > "$ORDER_SCHEMA/ORDER"; }
add_sql() { echo "-- $1" > "$ORDER_SCHEMA/$1"; }
order_lines() { tr '\n' ' ' < "$ORDER_SCHEMA/ORDER"; }

# The base branch: two migrations that have already landed, in that order.
add_sql "0001.a.sql"
add_sql "0002.b.sql"
write_order "0001.a.sql" "0002.b.sql"
git -C "$ORDER_REPO" add -A
git -C "$ORDER_REPO" commit -q -m "base corpus"
ORDER_BASE_SHA="$(git -C "$ORDER_REPO" rev-parse HEAD)"
RS_ORDER="$(make_run run-order "$ORDER_REPO" "$ORDER_BASE_SHA")"

# 1. THE CASE THE SCRIPT EXISTS FOR. This run's line is written in the MIDDLE —
# exactly what happens when the run appended it, then 0002.b.sql landed under it
# and the rebase replayed the append. Re-placement must put the landed lines
# first, in their landed order, and this run's line last.
add_sql "mine.sql"
write_order "0001.a.sql" "mine.sql" "0002.b.sql"
order_out="$("$SHIP_ORDER" -s "$RS_ORDER" 2> "$order_err")" ||
  fail_test "ship-order failed on a plain append: $(cat "$order_err")"
[ "$(order_lines)" = "0001.a.sql 0002.b.sql mine.sql " ] ||
  fail_test "ship-order produced [$(order_lines)], expected the base order then mine.sql last"
pass_test "ship-order re-places this run's line LAST and keeps the base order"

# 1b. bin/ rule: the caller asked for a rewritten file, not for prose, so the
# report is a diagnostic and belongs on stderr — and it has to say what it did,
# or a wrong re-placement is invisible in the run log.
[ -z "$order_out" ] || fail_test "ship-order wrote to stdout: [$order_out]"
grep -q "mine.sql" "$order_err" || fail_test "ship-order did not name the line it appended; said [$(cat "$order_err")]"
pass_test "ship-order writes NOTHING to stdout and names the appended line on stderr"

# 2. Derived, so re-runnable: phase 6 fix loops re-enter and run it again, and a
# second pass that appended mine.sql twice would be caught only by db-migrate's
# duplicate refusal, one merge later.
cp "$ORDER_SCHEMA/ORDER" "$FIXTURE_DIR/order.after-first"
"$SHIP_ORDER" -s "$RS_ORDER" 2> "$order_err" ||
  fail_test "the second ship-order run failed: $(cat "$order_err")"
cmp -s "$ORDER_SCHEMA/ORDER" "$FIXTURE_DIR/order.after-first" ||
  fail_test "a second ship-order run changed the file: [$(order_lines)]"
pass_test "a second ship-order run is a byte-for-byte no-op"

# 3. Most runs touch no migration at all, and phase 6 calls ship-order on every
# one of them. Such a run must leave the file exactly as committed — a rewrite
# here would put db/schema/ORDER in the diff of a run that never touched db/.
write_order "0001.a.sql" "0002.b.sql"
cp "$ORDER_SCHEMA/ORDER" "$FIXTURE_DIR/order.no-migration"
rm -f "$ORDER_SCHEMA/mine.sql"
"$SHIP_ORDER" -s "$RS_ORDER" 2> "$order_err" ||
  fail_test "ship-order failed on a run that adds no migration: $(cat "$order_err")"
cmp -s "$ORDER_SCHEMA/ORDER" "$FIXTURE_DIR/order.no-migration" ||
  fail_test "a run with no migration had its ORDER rewritten: [$(order_lines)]"
pass_test "a run that adds no migration leaves ORDER byte-identical, exit 0"

# 4. A base line missing from the worktree is not an append — it is landed
# history being rewritten, most likely a rebase conflict resolved the wrong way.
# Silently writing the line back would hide exactly that, so it refuses, and it
# must not half-write the file on the way out.
write_order "0002.b.sql"
cp "$ORDER_SCHEMA/ORDER" "$FIXTURE_DIR/order.deleted"
assert_failure "ship-order REFUSES a worktree ORDER that deletes a landed line" \
  "$SHIP_ORDER" -s "$RS_ORDER"
run_ship_order -s "$RS_ORDER"
[ "$order_status" -eq "$SHIP_ORDER_REFUSED" ] ||
  fail_test "the deletion refusal exited $order_status, expected $SHIP_ORDER_REFUSED"
grep -q "0001.a.sql" "$order_err" ||
  fail_test "the deletion refusal did not name the deleted line; said [$(cat "$order_err")]"
cmp -s "$ORDER_SCHEMA/ORDER" "$FIXTURE_DIR/order.deleted" ||
  fail_test "the refused run modified ORDER anyway: [$(order_lines)]"
pass_test "the refusal names the deleted line and leaves ORDER untouched"

# 5. An *.sql on disk that no ORDER line names is the RFC 169 defect, and it is
# REFUSED, not placed. This script does not decide where a migration belongs —
# the refusal four cases above says exactly that about a deleted line — and the
# state cannot reach land anyway: bin/db-migrate refuses an unordered file, so
# phase 5 already failed on it. Guessing a position would only hide that.
write_order "0001.a.sql" "0002.b.sql"
cp "$ORDER_SCHEMA/ORDER" "$FIXTURE_DIR/order.unordered"
add_sql "0003.c.sql"
assert_failure "ship-order REFUSES a db/schema/*.sql that no ORDER line names" \
  "$SHIP_ORDER" -s "$RS_ORDER"
run_ship_order -s "$RS_ORDER"
[ "$order_status" -eq "$SHIP_ORDER_REFUSED" ] ||
  fail_test "the unordered-file refusal exited $order_status, expected $SHIP_ORDER_REFUSED"
grep -q "0003.c.sql" "$order_err" ||
  fail_test "the unordered-file refusal did not name the file; said [$(cat "$order_err")]"
cmp -s "$ORDER_SCHEMA/ORDER" "$FIXTURE_DIR/order.unordered" ||
  fail_test "the refused run modified ORDER anyway: [$(order_lines)]"
pass_test "the unordered-file refusal names the file and leaves ORDER untouched"
rm -f "$ORDER_SCHEMA/0003.c.sql"

# 6. A DUPLICATE line. db/schema/ORDER is merge=union, and union never reports a
# conflict, so two appends of the same filename arrive silently. ship/SKILL.md
# claims this script is what makes the final order deterministic, so it must not
# copy a duplicate through. (A line the BASE copy already has is not a
# duplicate: it is dropped by the derivation, which is where union's replayed
# append lands.)
add_sql "mine.sql"
write_order "0001.a.sql" "0002.b.sql" "mine.sql" "mine.sql"
cp "$ORDER_SCHEMA/ORDER" "$FIXTURE_DIR/order.duplicate"
assert_failure "ship-order REFUSES a duplicated line merge=union can produce" \
  "$SHIP_ORDER" -s "$RS_ORDER"
run_ship_order -s "$RS_ORDER"
[ "$order_status" -eq "$SHIP_ORDER_REFUSED" ] ||
  fail_test "the duplicate refusal exited $order_status, expected $SHIP_ORDER_REFUSED"
grep -q "mine.sql" "$order_err" ||
  fail_test "the duplicate refusal did not name the repeated line; said [$(cat "$order_err")]"
cmp -s "$ORDER_SCHEMA/ORDER" "$FIXTURE_DIR/order.duplicate" ||
  fail_test "the refused run modified ORDER anyway: [$(order_lines)]"
pass_test "the duplicate refusal names the repeated line and leaves ORDER untouched"

# 7. -n, the ENFORCEMENT half (RFC 180 / ship-land). Phase 6 calling this script
# is prose, and a run that skips it still lands cleanly — the ORDER line exists,
# only its POSITION is wrong. ship-land runs `-n` before the fast-forward, so
# dry-run must answer that question without writing anything.
write_order "0001.a.sql" "mine.sql" "0002.b.sql"
cp "$ORDER_SCHEMA/ORDER" "$FIXTURE_DIR/order.stale"
run_ship_order -s "$RS_ORDER" -n
[ "$order_status" -eq "$SHIP_ORDER_WOULD_CHANGE" ] ||
  fail_test "ship-order -n on a stale ORDER exited $order_status, expected $SHIP_ORDER_WOULD_CHANGE"
cmp -s "$ORDER_SCHEMA/ORDER" "$FIXTURE_DIR/order.stale" ||
  fail_test "ship-order -n WROTE to ORDER: [$(order_lines)]"
pass_test "ship-order -n exits 3 on an ORDER that would change, and writes nothing"

# 7b. And the other verdict: after the real run, -n must pass, or ship-land
# could never land a run that did the right thing.
"$SHIP_ORDER" -s "$RS_ORDER" 2> "$order_err" ||
  fail_test "ship-order failed re-placing the stale ORDER: $(cat "$order_err")"
"$SHIP_ORDER" -s "$RS_ORDER" -n 2> "$order_err" ||
  fail_test "ship-order -n refused an ORDER already in land order: $(cat "$order_err")"
pass_test "ship-order -n exits 0 once ORDER is in land order"

# 7c. -n is a dry run, not a downgrade: a CORRUPT corpus is still a refusal, and
# it must be distinguishable from the stale-order verdict, since ship-land
# reports the two differently. Each refusal, under -n, exits 1 rather than 3.
write_order "0002.b.sql" "mine.sql"
assert_failure "ship-order -n still REFUSES a deleted landed line" \
  "$SHIP_ORDER" -s "$RS_ORDER" -n
write_order "0001.a.sql" "0002.b.sql" "mine.sql" "mine.sql"
run_ship_order -s "$RS_ORDER" -n
[ "$order_status" -eq "$SHIP_ORDER_REFUSED" ] ||
  fail_test "ship-order -n on a duplicate exited $order_status, expected $SHIP_ORDER_REFUSED (a refusal, not $SHIP_ORDER_WOULD_CHANGE)"
write_order "0001.a.sql" "0002.b.sql" "mine.sql"
add_sql "0004.d.sql"
run_ship_order -s "$RS_ORDER" -n
[ "$order_status" -eq "$SHIP_ORDER_REFUSED" ] ||
  fail_test "ship-order -n on an unordered *.sql exited $order_status, expected $SHIP_ORDER_REFUSED (a refusal, not $SHIP_ORDER_WOULD_CHANGE)"
rm -f "$ORDER_SCHEMA/0004.d.sql"
pass_test "ship-order -n reports each refusal as 1, never as the stale-order 3"

# 7d. The -n REFUSAL IS THE BRANCH MOST LIKELY TO FIRE, and it fires from inside
# ship-land with the land lock HELD. A verdict with no state is not actionable
# there: the operator sees "not in land order" and has to reconstruct what
# ORDER holds, what it should hold, and how to fix it, from a script they did
# not run. So the report must show both orders and the exact re-run command.
write_order "0001.a.sql" "mine.sql" "0002.b.sql"
run_ship_order -s "$RS_ORDER" -n
[ "$order_status" -eq "$SHIP_ORDER_WOULD_CHANGE" ] ||
  fail_test "the -n stale verdict exited $order_status, expected $SHIP_ORDER_WOULD_CHANGE"
grep -q "ship-order -s $RS_ORDER" "$order_err" ||
  fail_test "the -n refusal did not print the re-run command; said [$(cat "$order_err")]"
grep -q "0002.b.sql" "$order_err" ||
  fail_test "the -n refusal did not print the order it would write; said [$(cat "$order_err")]"
pass_test "the -n refusal prints both orders and the exact ship-order re-run command"

# 7e. EVERY refusal in ONE pass. A corpus can hold a deletion, a duplicate and
# an unordered file at once, and this check runs at land time: reporting the
# first kind and exiting costs the operator one more land attempt — and one more
# full hook run — per kind.
write_order "0002.b.sql" "mine.sql" "mine.sql"
add_sql "0005.e.sql"
run_ship_order -s "$RS_ORDER"
[ "$order_status" -eq "$SHIP_ORDER_REFUSED" ] ||
  fail_test "the three-fault corpus exited $order_status, expected $SHIP_ORDER_REFUSED"
grep -q "0001.a.sql" "$order_err" ||
  fail_test "the combined refusal did not report the DELETED line; said [$(cat "$order_err")]"
grep -q "mine.sql" "$order_err" ||
  fail_test "the combined refusal did not report the DUPLICATE line; said [$(cat "$order_err")]"
grep -q "0005.e.sql" "$order_err" ||
  fail_test "the combined refusal did not report the UNORDERED file; said [$(cat "$order_err")]"
pass_test "one run reports the deletion, the duplicate AND the unordered file"
rm -f "$ORDER_SCHEMA/0005.e.sql"

# 7f. It must validate what it would WRITE. A `# comment`, a trailing space or
# `hello world` survives every check above — no line is deleted, nothing is
# duplicated, no *.sql is unnamed — so it would be written, committed, landed,
# and refused only later by bin/db-migrate against a live database.
write_order "0001.a.sql" "0002.b.sql" "mine.sql" "# a comment"
cp "$ORDER_SCHEMA/ORDER" "$FIXTURE_DIR/order.badline"
run_ship_order -s "$RS_ORDER"
[ "$order_status" -eq "$SHIP_ORDER_REFUSED" ] ||
  fail_test "an ORDER line that is not a filename exited $order_status, expected $SHIP_ORDER_REFUSED"
grep -q "a comment" "$order_err" ||
  fail_test "the illegal-line refusal did not name the line; said [$(cat "$order_err")]"
cmp -s "$ORDER_SCHEMA/ORDER" "$FIXTURE_DIR/order.badline" ||
  fail_test "the refused run modified ORDER anyway: [$(order_lines)]"
pass_test "an ORDER line that is not a legal migration filename is REFUSED, not written"

# 7g. A line that names NO FILE is the mirror of the unordered case, and it
# reaches the same reader: bin/db-migrate refuses an ORDER line with no file.
write_order "0001.a.sql" "0002.b.sql" "mine.sql" "0009.ghost.sql"
run_ship_order -s "$RS_ORDER"
[ "$order_status" -eq "$SHIP_ORDER_REFUSED" ] ||
  fail_test "an ORDER line naming no file exited $order_status, expected $SHIP_ORDER_REFUSED"
grep -q "0009.ghost.sql" "$order_err" ||
  fail_test "the missing-file refusal did not name the line; said [$(cat "$order_err")]"
pass_test "an ORDER line that names no file on disk is REFUSED"

# 7h. THE BASE COPY IS LOAD-BEARING. Every refusal above is stated relative to
# the ORDER at BASE_SHA, so an empty base copy that is really a GIT FAILURE — a
# pruned or wrong BASE_SHA, a state file pointing at another repo — disables the
# append-only deletion refusal entirely: the deleted line reads as "not in the
# base", the corpus reads as clean, and ship-land's -n gate passes a mis-ordered
# ORDER. Asking git for the file and treating "" as "no base copy" cannot tell
# the two apart, so a bad BASE_SHA must be a fatal, not an empty answer.
GHOST_SHA="0000000000000000000000000000000000000000"
RS_GHOST="$(make_run run-order-ghost-sha "$ORDER_REPO" "$GHOST_SHA")"
write_order "0002.b.sql" "mine.sql"
cp "$ORDER_SCHEMA/ORDER" "$FIXTURE_DIR/order.ghost"
run_ship_order -s "$RS_GHOST"
[ "$order_status" -ne 0 ] ||
  fail_test "a BASE_SHA that is not a commit was treated as 'no base copy' and exited 0"
grep -q "$GHOST_SHA" "$order_err" ||
  fail_test "the bad-BASE_SHA fatal did not name the sha; said [$(cat "$order_err")]"
cmp -s "$ORDER_SCHEMA/ORDER" "$FIXTURE_DIR/order.ghost" ||
  fail_test "the run with a bad BASE_SHA wrote ORDER anyway: [$(order_lines)]"
pass_test "a BASE_SHA git cannot resolve is a FATAL, never a silently empty base copy"
write_order "0001.a.sql" "0002.b.sql" "mine.sql"

# 8. The run that INTRODUCES the file has no base copy to preserve, and asking
# git for it fails rather than returning empty. Missing at the base sha is the
# honest empty case, not an error.
NEW_REPO="$FIXTURE_DIR/order-repo-new"
mkdir -p "$NEW_REPO/db/schema"
git init -q "$NEW_REPO"
git -C "$NEW_REPO" config user.email "ship-scripts-tests@example.invalid"
git -C "$NEW_REPO" config user.name "ship-scripts-tests"
echo "-- 0001.first.sql" > "$NEW_REPO/db/schema/0001.first.sql"
git -C "$NEW_REPO" add -A
git -C "$NEW_REPO" commit -q -m "no ORDER yet"
NEW_BASE_SHA="$(git -C "$NEW_REPO" rev-parse HEAD)"
RS_NEW="$(make_run run-order-new "$NEW_REPO" "$NEW_BASE_SHA")"
printf '%s\n' "0001.first.sql" > "$NEW_REPO/db/schema/ORDER"
"$SHIP_ORDER" -s "$RS_NEW" 2> "$order_err" ||
  fail_test "ship-order failed when ORDER is absent at the base sha: $(cat "$order_err")"
[ "$(tr '\n' ' ' < "$NEW_REPO/db/schema/ORDER")" = "0001.first.sql " ] ||
  fail_test "ORDER absent at the base sha was not treated as empty; got [$(cat "$NEW_REPO/db/schema/ORDER")]"
pass_test "ORDER absent at the base sha is treated as empty, and this run's line stands"

# 9. THE ESCAPE. `git -C <dir>` loses to GIT_DIR, and a git hook exports GIT_DIR
# and GIT_INDEX_FILE — and phase 6 runs ship-order beside the hook. Without the
# strip in ship-order, every `git -C "$CODEBASE_ROOT"` in it answers about the
# HOOK's repository instead of the run's: the base copy of ORDER is read from
# the wrong history, so the append-only refusals are stated against a corpus
# this run never touched. That is the same trap ship-lock carries a comment for,
# and the same one that let bin/db-scripts-tests re-`git init` the REAL checkout.
# The exported values are what a hook really sets, so this fails on a ship-order
# that trusts the environment over its argument.
ESCAPE_GIT_DIR="$(git -C "$PROJECT_ROOT" rev-parse --absolute-git-dir)"
REAL_ORDER_BEFORE="$(cksum < "$PROJECT_ROOT/db/schema/ORDER")"
write_order "0001.a.sql" "mine.sql" "0002.b.sql"
order_status=0
GIT_DIR="$ESCAPE_GIT_DIR" GIT_INDEX_FILE="$ESCAPE_GIT_DIR/index" \
  "$SHIP_ORDER" -s "$RS_ORDER" 2> "$order_err" || order_status=$?
[ "$order_status" -eq 0 ] ||
  fail_test "GIT_DIR overrode the run's own repo: ship-order exited $order_status, said [$(cat "$order_err")]"
[ "$(order_lines)" = "0001.a.sql 0002.b.sql mine.sql " ] ||
  fail_test "under GIT_DIR ship-order produced [$(order_lines)], expected the fixture's land order"
[ "$(cksum < "$PROJECT_ROOT/db/schema/ORDER")" = "$REAL_ORDER_BEFORE" ] ||
  fail_test "ship-order under GIT_DIR wrote to the REAL repo's db/schema/ORDER"
pass_test "GIT_DIR from a hook cannot move ship-order off the run's own repo"

echo ""
echo "==== ship-lens: the dispatch ledger (RFC 234) ===="

# The subject is .prime/agent/skills/ship/scripts/ship-lens, which turns the
# lens plan from a document written after the review into an append-only ledger
# written at dispatch. Every assertion below is behavioural: it builds a ledger
# and a findings directory in a known state and asserts `missing`'s exit code
# and which list it names. None greps a skill file for a sentence.
#
# THE CORPUS IS FABRICATED, and that is load-bearing twice over. `missing`
# derives the lens set from the DIRECTORY NAMES under
# $CODEBASE_ROOT/.claude/skills and their tier from that skill's tiers.md, so a
# fixture pointing CODEBASE_ROOT at a temp tree is what keeps these assertions
# off the real 40-lens corpus — which is read-only to /ship, and whose contents
# would otherwise make this harness fail whenever a lens is added. It also keeps
# every write inside the temp run-scratch, so no assertion can touch a live run.
SHIP_LENS="$SHIP_SCRIPTS/ship-lens"
[ -x "$SHIP_LENS" ] || fail_test "ship-lens is missing or not executable [$SHIP_LENS]"

# ship-lens's exit vocabulary, named once and used at every site below, exactly
# as ship-order's is above: 1 is the tier's OWN answer, with the faults on
# stdout; 2 is "the script could not do what was asked" — a record it could not
# write, or a check it could not run — which is NEVER a clean tier and is the
# distinction this script was built around. A bare literal asserts an integer,
# not that meaning.
SHIP_LENS_FAULTS=1
SHIP_LENS_CANNOT_RUN=2

LENS_CORPUS="$FIXTURE_DIR/lens-corpus"
mkdir -p "$LENS_CORPUS/.claude/skills/review-fix"
# code-review-chain and design-review-chain are the orchestrators that RUN the
# lenses, not lenses; they are in the glob's way and must be dropped. They carry
# no tiers.md row, so a ship-lens that kept them would fail the discovery halt.
for lens in code-review-alpha design-review-beta code-review-gamma code-review-chain design-review-chain; do
  mkdir -p "$LENS_CORPUS/.claude/skills/$lens"
  echo "# $lens" > "$LENS_CORPUS/.claude/skills/$lens/SKILL.md"
done
# The real tiers.md in miniature: `## Tier <N>` headings over a Markdown table
# whose data rows open with the skill name in backticks. The prose line naming a
# skill in backticks is here deliberately — it is the shape that a first-cell
# parser must not mistake for a row.
cat > "$LENS_CORPUS/.claude/skills/review-fix/tiers.md" << 'EOF'
# Review tier manifest (fixture)

## Tier 1 — multi-file / structural

| Skill                |
| -------------------- |
| `code-review-alpha`  |
| `design-review-beta` |

`code-review-alpha` is the one most likely to belong in another tier.

## Tier 2 — single-file

| Skill               |
| ------------------- |
| `code-review-gamma` |
EOF

RS_LENS="$(make_run run-lens "$LENS_CORPUS")"
LENS_FINDINGS="$RS_LENS/findings"
LENS_LEDGER="$LENS_FINDINGS/lens-ledger.tsv"
LENS_OUT="$FIXTURE_DIR/lens.out"
LENS_ERR="$FIXTURE_DIR/lens.err"
lens_status=0

# run_lens <args>… — EVERY ship-lens invocation in this section goes through
# here, against any run scratch and any verb. It records both halves of the
# answer — the streams in $LENS_OUT/$LENS_ERR and the exit status in
# $lens_status — so no assertion can drop the status, which is the currency the
# script's contract is written in.
run_lens() {
  lens_status=0
  "$SHIP_LENS" "$@" > "$LENS_OUT" 2> "$LENS_ERR" || lens_status=$?
}

# clone_corpus <name> — a private copy of the fixture corpus, and a run scratch
# pointing at it, in $CORPUS_DIR and $CORPUS_RS. The corpus-shape fixtures each
# break the copy in one way, so none of them can disturb $LENS_CORPUS.
clone_corpus() {
  CORPUS_DIR="$FIXTURE_DIR/lens-corpus-$1"
  mkdir -p "$CORPUS_DIR/.claude/skills"
  cp -R "$LENS_CORPUS/.claude/skills/." "$CORPUS_DIR/.claude/skills/"
  CORPUS_RS="$(make_run "run-lens-$1" "$CORPUS_DIR")"
  mkdir -p "$CORPUS_RS/findings"
}

lens_reset() { rm -rf "$LENS_FINDINGS"; mkdir -p "$LENS_FINDINGS"; }
lens_start() { run_lens -s "$RS_LENS" start -t "$1" -l "$2" -c "$3"; }
lens_skip() { run_lens -s "$RS_LENS" skip -t "$1" -l "$2" -r "$3"; }
lens_report() { echo "## Findings" > "$LENS_FINDINGS/tier$1-$2.md"; }
lens_missing() { run_lens -s "$RS_LENS" missing -t "$1"; }
lens_said() { grep -q "$1" "$LENS_OUT"; }

# L1. THE FILE IS APPEND-ONLY. Each verb adds exactly one record, in the order
# the acts happened, and leaves every earlier line byte-identical — the whole
# claim that makes a `start` line evidence rather than a reconstruction. And
# none of the three says anything on stdout: a writer's product is the file.
lens_reset
lens_start 1 code-review-alpha sub-a1
[ "$lens_status" -eq 0 ] || fail_test "start failed: $(cat "$LENS_ERR")"
[ ! -s "$LENS_OUT" ] || fail_test "start wrote to stdout: [$(cat "$LENS_OUT")]"
[ "$(wc -l < "$LENS_LEDGER" | tr -d ' ')" -eq 1 ] ||
  fail_test "start appended $(wc -l < "$LENS_LEDGER") lines, expected 1"
[ "$(sed -n 1p "$LENS_LEDGER")" = "$(printf 'start\t1\tcode-review-alpha\tsub-a1')" ] ||
  fail_test "the start record is [$(sed -n 1p "$LENS_LEDGER")]"
cp "$LENS_LEDGER" "$FIXTURE_DIR/ledger.after-start"
run_lens -s "$RS_LENS" done -t 1 -l code-review-alpha
[ "$lens_status" -eq 0 ] || fail_test "done failed: $(cat "$LENS_ERR")"
[ ! -s "$LENS_OUT" ] || fail_test "done wrote to stdout: [$(cat "$LENS_OUT")]"
lens_skip 1 design-review-beta "no wire payload in this diff"
[ "$lens_status" -eq 0 ] || fail_test "skip failed: $(cat "$LENS_ERR")"
[ ! -s "$LENS_OUT" ] || fail_test "skip wrote to stdout: [$(cat "$LENS_OUT")]"
# The reason is the one free-text value the script logs, and it is printed last
# on the line, where a trailing space is invisible: it is delimited like every
# other value beside it, so `-r "reason "` and `-r "reason"` do not log alike.
grep -qF -- "[no wire payload in this diff]" "$LENS_ERR" ||
  fail_test "the skip log left the free-text reason undelimited; said [$(cat "$LENS_ERR")]"
[ "$(wc -l < "$LENS_LEDGER" | tr -d ' ')" -eq 3 ] ||
  fail_test "three records produced $(wc -l < "$LENS_LEDGER") lines"
head -n 1 "$LENS_LEDGER" | cmp -s - "$FIXTURE_DIR/ledger.after-start" ||
  fail_test "a later append rewrote the first record: [$(sed -n 1p "$LENS_LEDGER")]"
[ "$(sed -n 2p "$LENS_LEDGER")" = "$(printf 'done\t1\tcode-review-alpha')" ] ||
  fail_test "the done record is [$(sed -n 2p "$LENS_LEDGER")]"
[ "$(sed -n 3p "$LENS_LEDGER")" = "$(printf 'skip\t1\tdesign-review-beta\tno wire payload in this diff')" ] ||
  fail_test "the skip record is [$(sed -n 3p "$LENS_LEDGER")]"
pass_test "start, done and skip each append exactly one record, in order, and say nothing on stdout"

# L2. ONE RECORD PER LINE IS THE FILE'S ONLY STRUCTURAL PROMISE. A reason
# carrying a tab or a newline would be read back as a different record — or as
# two — so it is refused at append time, and the refusal writes nothing.
cp "$LENS_LEDGER" "$FIXTURE_DIR/ledger.before-bad-reason"
assert_exit_code "$EXIT_INVALID_ARG_VALUE" "a skip reason containing a TAB is refused" \
  "$SHIP_LENS" -s "$RS_LENS" skip -t 1 -l code-review-alpha -r "$(printf 'child\tstalled')"
assert_exit_code "$EXIT_INVALID_ARG_VALUE" "a skip reason containing a NEWLINE is refused" \
  "$SHIP_LENS" -s "$RS_LENS" skip -t 1 -l code-review-alpha -r "$(printf 'child\nstalled')"
cmp -s "$LENS_LEDGER" "$FIXTURE_DIR/ledger.before-bad-reason" ||
  fail_test "a refused append modified the ledger: [$(cat "$LENS_LEDGER")]"
pass_test "a refused reason leaves the ledger byte-identical"

# L3. THE CLEAN TIER. Every started lens has a report on disk and the rest of
# the tier is skipped — the skip IS the override, which is why a skipped lens is
# not a fault. Nothing on stdout, exit 0.
lens_reset
lens_start 1 code-review-alpha sub-a1
lens_report 1 code-review-alpha
lens_skip 1 design-review-beta "no wire payload in this diff"
lens_missing 1
[ "$lens_status" -eq 0 ] ||
  fail_test "a fully accounted tier exited $lens_status, said [$(cat "$LENS_OUT")]"
[ ! -s "$LENS_OUT" ] ||
  fail_test "a clean tier printed a list: [$(cat "$LENS_OUT")]"
pass_test "a tier whose starts all have reports, with the rest skipped, exits 0 and prints nothing"

# L3b. THE CHECK LEAVES AN ARTIFACT, clean or not. Phase 7 must report what
# `missing` printed at each tier close, including "nothing", and a verdict that
# exists only in the coordinator's head is the reconstruction this whole ledger
# exists to remove — the same reason the write-scope result is teed to a file.
# The name ends .txt so the UNDECLARED glob cannot read the record of the check
# as a lens report, which would make the check fail the next tier.
[ -f "$LENS_FINDINGS/tier1-missing.txt" ] ||
  fail_test "a clean tier left no record that the check ran"
[ ! -s "$LENS_FINDINGS/tier1-missing.txt" ] ||
  fail_test "a clean tier recorded faults: [$(cat "$LENS_FINDINGS/tier1-missing.txt")]"
lens_missing 1
[ "$lens_status" -eq 0 ] ||
  fail_test "the recorded verdict was read back as a lens report; said [$(cat "$LENS_OUT")]"
pass_test "missing records its verdict in tier<N>-missing.txt, empty on a clean tier, and never reads it back"

# L4. THE 28-CLAIMS CASE: a lens claimed as dispatched with no report on disk.
# This is the fault the whole script exists for — before the ledger it was
# indistinguishable from a lens that ran and found nothing.
lens_reset
lens_start 1 code-review-alpha sub-a1
lens_skip 1 design-review-beta "no wire payload in this diff"
lens_missing 1
[ "$lens_status" -eq "$SHIP_LENS_FAULTS" ] || fail_test "a start with no report exited $lens_status, expected $SHIP_LENS_FAULTS"
lens_said "^STALLED.*code-review-alpha" ||
  fail_test "the stalled child was not named under STALLED; said [$(cat "$LENS_OUT")]"
pass_test "a start with no tier<N>-<lens>.md exits 1 and names the lens under STALLED"

# L4b. An EMPTY report is the same fault wearing a filename: a child that was
# spawned, created its file and died writes one. Existence is not enough, and
# checking non-emptiness still never opens the file.
: > "$LENS_FINDINGS/tier1-code-review-alpha.md"
lens_missing 1
[ "$lens_status" -eq "$SHIP_LENS_FAULTS" ] || fail_test "an EMPTY report exited $lens_status, expected $SHIP_LENS_FAULTS"
lens_said "^STALLED.*code-review-alpha" ||
  fail_test "an empty report was not reported as stalled; said [$(cat "$LENS_OUT")]"
pass_test "an empty tier<N>-<lens>.md counts as stalled, not as a report"

# L4c. THE SKIP IS THE OVERRIDE, and a stalled child is the case it exists for.
# "child stalled twice" is the repair references/review.md names for a STALLED
# line — the archive's rfc-225/rfc-159/rfc-138 recovery — so a skip appended
# after the start must clear it. Without this the only way to close the tier is
# to fabricate a report no child produced, which is the behaviour this script
# exists to catch.
lens_reset
lens_start 1 code-review-alpha sub-a1
lens_skip 1 code-review-alpha "child stalled twice"
lens_skip 1 design-review-beta "no wire payload in this diff"
lens_missing 1
[ "$lens_status" -eq 0 ] ||
  fail_test "a skip did not clear the stall it repairs; said [$(cat "$LENS_OUT")]"
[ ! -s "$LENS_OUT" ] ||
  fail_test "a skipped lens was still a fault: [$(cat "$LENS_OUT")]"
# And the give-up stays on the record: the ledger holds both acts, so phase 7
# reads why the lens did not report.
grep -q "child stalled twice" "$LENS_LEDGER" ||
  fail_test "the give-up reason is not in the ledger: [$(cat "$LENS_LEDGER")]"
pass_test "a skip appended after a stalled start clears STALLED and keeps its reason"

# L5. THE SILENT SKIP: a lens the tier assigns that was neither started nor
# skipped. Nothing else in the run can see it — there is no file to be missing.
lens_reset
lens_start 1 code-review-alpha sub-a1
lens_report 1 code-review-alpha
lens_missing 1
[ "$lens_status" -eq "$SHIP_LENS_FAULTS" ] || fail_test "an undispatched lens exited $lens_status, expected $SHIP_LENS_FAULTS"
lens_said "^UNDISPATCHED.*design-review-beta" ||
  fail_test "the undispatched lens was not named; said [$(cat "$LENS_OUT")]"
pass_test "a lens with neither a start nor a skip exits 1 and is named under UNDISPATCHED"

# L6. THE rfc-232 BATCHED-REVIEW CASE, which is why this script exists: a report
# file on disk that no start line names. One child wrote one file covering
# several lenses and the plan was written up afterwards as if each had run.
lens_reset
lens_start 1 code-review-alpha sub-a1
lens_report 1 code-review-alpha
lens_skip 1 design-review-beta "no wire payload in this diff"
echo "## a batched review of several lenses" > "$LENS_FINDINGS/tier1-structural.md"
lens_missing 1
[ "$lens_status" -eq "$SHIP_LENS_FAULTS" ] || fail_test "an undeclared report exited $lens_status, expected $SHIP_LENS_FAULTS"
lens_said "^UNDECLARED.*tier1-structural.md" ||
  fail_test "the undeclared file was not named; said [$(cat "$LENS_OUT")]"
pass_test "a tier1-*.md with no start line exits 1 and names the file under UNDECLARED"

# L6b. The names the RUN ITSELF writes are not lens reports and must not be read
# as undeclared ones, or every tier would fail on its own fix plan. The exempt
# set is exactly the four names references/review.md defines — the fix plan, the
# fix report, the outcome records and missing's own output — enumerated in the
# script and never a filename shape.
#
# THIS ASSERTION COVERS THE TWO THAT THE GLOB CAN REACH, and says so. The
# UNDECLARED scan globs tier<N>-*.md, so tier1-outcomes.jsonl and
# tier1-missing.txt cannot reach the exempt check at all: delete either name
# from RUN_WRITTEN and nothing here fails. They are enumerated against a glob
# that is widened later — that is sound, and it is also why no behavioural
# assertion can hold them. A test whose NAME claims four is green for the wrong
# reason, and the .jsonl file is written below only to prove it is ignored.
rm -f "$LENS_FINDINGS/tier1-structural.md"
echo "dispatched/held/promoted/contradicted" > "$LENS_FINDINGS/tier1-fix-plan.md"
echo "what the fix child changed" > "$LENS_FINDINGS/tier1-fix-report.md"
echo '{"finding":"f1"}' > "$LENS_FINDINGS/tier1-outcomes.jsonl"
lens_missing 1
[ "$lens_status" -eq 0 ] ||
  fail_test "the run's own files were read as lens reports; said [$(cat "$LENS_OUT")]"
pass_test "the run's own tier<N>-fix-plan.md and tier<N>-fix-report.md are not UNDECLARED reports"

# L6c. And NOTHING ELSE is exempt. A batched report can be given any name at
# all, so a name that merely LOOKS like an artifact of the run — a second
# attempt, a draft — is still a tier<N>-*.md that no `start` line declared. An
# exemption for a filename shape no script writes is a hole in exactly the check
# this script exists for.
echo "## second attempt" > "$LENS_FINDINGS/tier1-code-review-alpha.attempt2.md"
lens_missing 1
[ "$lens_status" -eq "$SHIP_LENS_FAULTS" ] ||
  fail_test "an undeclared file with an artifact-shaped name exited $lens_status, expected $SHIP_LENS_FAULTS"
lens_said "^UNDECLARED.*tier1-code-review-alpha.attempt2.md" ||
  fail_test "an artifact-shaped filename dodged UNDECLARED; said [$(cat "$LENS_OUT")]"
rm -f "$LENS_FINDINGS/tier1-code-review-alpha.attempt2.md"
pass_test "a tier<N>-*.md is UNDECLARED whatever its name suggests"

# L7. Two lenses claiming one child id is a fan-out that was really a batch —
# free to detect, because the ids are already in the ledger. It is also the
# honest limit: a coordinator that appends one start per lens while spawning one
# child for five defeats this exactly as --no-verify defeats the hook.
lens_reset
lens_start 1 code-review-alpha sub-a1
lens_start 1 design-review-beta sub-a1
lens_report 1 code-review-alpha
lens_report 1 design-review-beta
lens_missing 1
[ "$lens_status" -eq "$SHIP_LENS_FAULTS" ] || fail_test "two lenses on one child id exited $lens_status, expected $SHIP_LENS_FAULTS"
lens_said "^SHARED-CHILD.*sub-a1" ||
  fail_test "the shared child id was not reported; said [$(cat "$LENS_OUT")]"
pass_test "two start lines sharing one child id exits 1 and names the child"

# L8. ALL THREE IN ONE RUN. A tier does not close while `missing` prints
# anything, so reporting the first fault and stopping would cost the coordinator
# one re-dispatch round per kind — the same one-pass rule ship-order follows.
lens_reset
lens_start 1 code-review-alpha sub-a1
echo "## a batched review" > "$LENS_FINDINGS/tier1-structural.md"
lens_missing 1
[ "$lens_status" -eq "$SHIP_LENS_FAULTS" ] || fail_test "the three-fault fixture exited $lens_status, expected $SHIP_LENS_FAULTS"
lens_said "^STALLED.*code-review-alpha" ||
  fail_test "the combined run did not report the STALLED lens; said [$(cat "$LENS_OUT")]"
lens_said "^UNDISPATCHED.*design-review-beta" ||
  fail_test "the combined run did not report the UNDISPATCHED lens; said [$(cat "$LENS_OUT")]"
lens_said "^UNDECLARED.*tier1-structural.md" ||
  fail_test "the combined run did not report the UNDECLARED file; said [$(cat "$LENS_OUT")]"
pass_test "one run reports the stalled child, the undispatched lens AND the undeclared file"

# L9. A RE-DISPATCH IS NOT A FAULT. Each line names its own repair, and
# re-dispatching a stalled lens is one of the two honest ones: two start lines,
# one report, nothing missing. A started set kept per LINE rather than per NAME
# would call this a stall forever.
lens_reset
lens_start 1 code-review-alpha sub-a1
lens_start 1 code-review-alpha sub-a2
lens_report 1 code-review-alpha
lens_skip 1 design-review-beta "no wire payload in this diff"
lens_missing 1
[ "$lens_status" -eq 0 ] ||
  fail_test "a re-dispatched lens exited $lens_status, said [$(cat "$LENS_OUT")]"
pass_test "a lens re-dispatched after a stall — two starts, one report — exits 0"

# L9b. THE SAME CHILD TWICE IS THE SAME RE-DISPATCH. A stalled child is
# sometimes re-dispatched to the id it already had, which writes the SAME
# (child, lens) pair twice — and SHARED-CHILD counts pairs, not lines, for
# exactly this input. Counting lines would report a routine repair as a batched
# fan-out and hold the tier open on a fault no coordinator can clear: the record
# is append-only, so the duplicate start cannot be withdrawn.
lens_reset
lens_start 1 code-review-alpha sub-a1
lens_start 1 code-review-alpha sub-a1
lens_report 1 code-review-alpha
lens_skip 1 design-review-beta "no wire payload in this diff"
lens_missing 1
[ "$lens_status" -eq 0 ] ||
  fail_test "a re-dispatch to the same child id exited $lens_status, said [$(cat "$LENS_OUT")]"
! lens_said "^SHARED-CHILD" ||
  fail_test "one lens started twice on one child read as two lenses sharing it; said [$(cat "$LENS_OUT")]"
pass_test "one lens re-dispatched to the SAME child id is not a shared child"

# L10. THE TIERS ARE SEPARATE RUNS. Tier 2 opens with tier 1's ledger lines and
# tier 1's files already on disk, so a `missing` that ignored the tier field
# would report every one of them and no tier after the first could ever close.
lens_reset
lens_start 1 code-review-alpha sub-a1
echo "## a batched review" > "$LENS_FINDINGS/tier1-structural.md"
lens_start 2 code-review-gamma sub-b1
lens_report 2 code-review-gamma
lens_missing 2
[ "$lens_status" -eq 0 ] ||
  fail_test "missing -t 2 read tier-1 lines or files; said [$(cat "$LENS_OUT")]"
pass_test "missing -t 2 ignores tier-1 ledger lines and tier-1 files"

# L10b. A RECORD THIS SCRIPT DID NOT WRITE. Only a hand edit produces a first
# field that is not one of the three verbs, and silently skipping the line is the
# single thing nothing else in the run would ever notice: a half-written `start`
# would read as a lens that was never dispatched at all.
lens_reset
lens_start 1 code-review-alpha sub-a1
lens_report 1 code-review-alpha
lens_skip 1 design-review-beta "no wire payload in this diff"
printf 'strt\t1\tcode-review-alpha\tsub-a1\n' >> "$LENS_LEDGER"
lens_missing 1
[ "$lens_status" -eq "$SHIP_LENS_FAULTS" ] ||
  fail_test "a hand-edited ledger record exited $lens_status, expected $SHIP_LENS_FAULTS"
lens_said "^MALFORMED.*code-review-alpha" ||
  fail_test "the malformed record was not named; said [$(cat "$LENS_OUT")]"
pass_test "a ledger record whose first field is not a verb is reported MALFORMED"

# L10c. A SHORT RECORD IS CORRUPT TOO, and it is the corruption that reads as
# ordinary data. TAB is IFS whitespace, so a positional read COLLAPSES adjacent
# tabs: `start<TAB>1<TAB><TAB>sub-c1` was mis-parsed as a lens named after the
# CHILD ID and reported STALLED against a report no lens could ever write. The
# verb is right in every one of these; only the shape is wrong.
lens_reset
lens_start 1 code-review-alpha sub-a1
lens_report 1 code-review-alpha
lens_skip 1 design-review-beta "no wire payload in this diff"
printf 'start\t1\t\tsub-c1\n' >> "$LENS_LEDGER"
lens_missing 1
[ "$lens_status" -eq "$SHIP_LENS_FAULTS" ] || fail_test "a record with a lost field exited $lens_status, expected $SHIP_LENS_FAULTS"
lens_said "^MALFORMED.*sub-c1" ||
  fail_test "a record with a lost field was mis-parsed instead of reported; said [$(cat "$LENS_OUT")]"
! lens_said "^STALLED" ||
  fail_test "a child id was read as a lens name; said [$(cat "$LENS_OUT")]"
pass_test "a record with a missing field is MALFORMED, not silently re-read with its fields shifted"

# L10d. A start with an EMPTY child id is the same fault: it is the one record
# that would disable the SHARED-CHILD check, and it can only arrive by hand.
lens_reset
lens_start 1 code-review-alpha sub-a1
lens_report 1 code-review-alpha
lens_skip 1 design-review-beta "no wire payload in this diff"
printf 'start\t1\tcode-review-alpha\t\n' >> "$LENS_LEDGER"
lens_missing 1
[ "$lens_status" -eq "$SHIP_LENS_FAULTS" ] || fail_test "a start with no child id exited $lens_status, expected $SHIP_LENS_FAULTS"
lens_said "^MALFORMED" ||
  fail_test "a start with no child id was accepted; said [$(cat "$LENS_OUT")]"
pass_test "a start carrying no child id is MALFORMED rather than a start that opts out of SHARED-CHILD"

# L10e. AND THE SHAPE CHECK IS NOT SCOPED TO A TIER, which is the whole reason
# MALFORMED exists: a corrupt record is a fact about the FILE. A record whose
# TIER field is the one that was lost belongs to no tier at all, so a tier-scoped
# check would hide it until the owning tier closed — which, for a tier already
# closed, is never.
lens_reset
lens_start 1 code-review-alpha sub-a1
lens_report 1 code-review-alpha
lens_skip 1 design-review-beta "no wire payload in this diff"
printf 'start\t\tcode-review-gamma\tsub-d1\n' >> "$LENS_LEDGER"
lens_missing 1
[ "$lens_status" -eq "$SHIP_LENS_FAULTS" ] ||
  fail_test "a record stamped with no tier was invisible to tier 1, exited $lens_status"
lens_said "^MALFORMED.*code-review-gamma" ||
  fail_test "a record belonging to no tier was dropped in silence; said [$(cat "$LENS_OUT")]"
pass_test "a corrupt record is reported by whichever tier closes next, whatever tier it claims"

# L10f. The faults are recorded as well as printed, byte for byte: the archive
# reads the file, and a file that disagreed with stdout would be worse than none.
cmp -s "$LENS_OUT" "$LENS_FINDINGS/tier1-missing.txt" ||
  fail_test "the recorded verdict differs from stdout: [$(cat "$LENS_FINDINGS/tier1-missing.txt")]"
pass_test "tier<N>-missing.txt holds exactly the fault lines that went to stdout"

# L10g. A MALFORMED LINE NAMES THE LINE AND THE RULE. Only a hand edit produces
# one, so its reader is a human repairing a file: four structurally different
# corruptions produced one undifferentiated label while the script had already
# computed which of the three rules broke, and no line number survived, so the
# repair began with a hunt. The record stays LAST — it is the field that carries
# tabs — so the fields ahead of it are fixed.
lens_reset
lens_start 1 code-review-alpha sub-a1
lens_report 1 code-review-alpha
lens_skip 1 design-review-beta "no wire payload in this diff"
printf 'strt\t1\tcode-review-alpha\tsub-a1\n' >> "$LENS_LEDGER"
printf 'start\t1\tcode-review-alpha\t\n' >> "$LENS_LEDGER"
lens_missing 1
[ "$lens_status" -eq "$SHIP_LENS_FAULTS" ] ||
  fail_test "the two hand-edited records exited $lens_status, expected $SHIP_LENS_FAULTS"
lens_said "$(printf '^MALFORMED\t3\tfirst field')" ||
  fail_test "the bad verb on ledger line 3 was not located and named; said [$(cat "$LENS_OUT")]"
lens_said "$(printf '^MALFORMED\t4\tfield 4 of 4 is empty')" ||
  fail_test "the empty field on ledger line 4 was not located and named; said [$(cat "$LENS_OUT")]"
pass_test "a MALFORMED line carries the ledger LINE NUMBER and which rule the record broke"

# L10h. AND THE LAST RECORD IS READ. `read` returns false at a final line with
# no newline, having already assigned it, so the commonest hand-edit artifact —
# and an interrupted append, whose record is the most recent dispatch — walked
# straight past the one check that exists for a hand-edited ledger.
lens_reset
lens_start 1 code-review-alpha sub-a1
lens_report 1 code-review-alpha
lens_skip 1 design-review-beta "no wire payload in this diff"
printf 'strt\t1\tcode-review-gamma\tsub-z9' >> "$LENS_LEDGER"
lens_missing 1
[ "$lens_status" -eq "$SHIP_LENS_FAULTS" ] ||
  fail_test "an unterminated last record exited $lens_status, expected $SHIP_LENS_FAULTS"
lens_said "^MALFORMED.*sub-z9" ||
  fail_test "the unterminated last record was dropped in silence; said [$(cat "$LENS_OUT")]"
pass_test "a final ledger record with no trailing newline is judged, not dropped"

# L10i. AN UNREADABLE LEDGER IS NOT AN EMPTY ONE, and the two are opposite
# facts. `[ -f ]` then `done < "$LEDGER"` asks two different questions: bash
# skips the body of a compound command whose redirection could not be opened, so
# an IO failure became "the ledger records nothing" — the one state this script
# treats as legitimate — and every lens came back UNDISPATCHED with a confident
# exit 1. The OPEN is now the test.
#
# The fixture is a mode-000 file, so it cannot be built by a caller who can read
# anything: that is asserted rather than assumed, because a vacuous version of
# this test passes for the wrong reason.
lens_reset
lens_start 1 code-review-alpha sub-a1
lens_report 1 code-review-alpha
lens_skip 1 design-review-beta "no wire payload in this diff"
printf 'strt\t1\tcode-review-alpha\tsub-a1\n' >> "$LENS_LEDGER"
lens_missing 1
[ -s "$LENS_FINDINGS/tier1-missing.txt" ] ||
  fail_test "the fault run left no verdict to be made stale"
chmod 000 "$LENS_LEDGER"
[ ! -r "$LENS_LEDGER" ] ||
  fail_test "the unreadable-ledger fixture is still readable — running as root? this assertion cannot be made"
lens_missing 1
chmod 644 "$LENS_LEDGER"
[ "$lens_status" -eq "$SHIP_LENS_CANNOT_RUN" ] ||
  fail_test "an unreadable ledger exited $lens_status, expected $SHIP_LENS_CANNOT_RUN — it was read as an empty one"
grep -q "cannot be opened" "$LENS_ERR" ||
  fail_test "the unreadable-ledger halt did not say why; said [$(cat "$LENS_ERR")]"
[ ! -s "$LENS_OUT" ] ||
  fail_test "a halt wrote a tier verdict to stdout: [$(cat "$LENS_OUT")]"
pass_test "an unreadable ledger HALTS with the system code instead of reading as an empty one"

# L10j. AND THE ARCHIVE CAN TELL THE TWO APART. The exit status lives in the
# coordinator's shell; tier<N>-missing.txt is what phase 7 and the workflow
# audit read, and an EMPTY file answered for a clean tier, a halted check and a
# tier never checked at all — while a halt that exited above the write left the
# PREVIOUS invocation's faults standing as this close's verdict. The file now
# carries the reason it could not answer.
! grep -q '^MALFORMED' "$LENS_FINDINGS/tier1-missing.txt" ||
  fail_test "the halt archived the previous run's faults as this check's verdict: [$(cat "$LENS_FINDINGS/tier1-missing.txt")]"
grep -q '^INCOMPLETE.*cannot be opened' "$LENS_FINDINGS/tier1-missing.txt" ||
  fail_test "the halted check left no reason in its verdict file: [$(cat "$LENS_FINDINGS/tier1-missing.txt")]"
pass_test "a halted check replaces the verdict with one INCOMPLETE line carrying the reason"

# L10k. THE rfc-232 BATCH, WEARING AN INVENTED LENS NAME. The ledger's names
# were taken as given, so `start 1 structural` plus one batched
# tier1-structural.md DECLARED that file and the tier closed clean — a bypass of
# UNDECLARED, the check this script exists for, using the honest `skip` for the
# two real lenses. A name the manifest does not give this tier now declares
# nothing, so the file is UNDECLARED and the surplus record is named on stderr.
lens_reset
lens_start 1 structural sub-batch
lens_skip 1 code-review-alpha "batched into one child"
lens_skip 1 design-review-beta "batched into one child"
echo "## a batched review of every tier-1 lens" > "$LENS_FINDINGS/tier1-structural.md"
lens_missing 1
[ "$lens_status" -eq "$SHIP_LENS_FAULTS" ] ||
  fail_test "a fabricated start legitimised a batched report, exited $lens_status"
lens_said "^UNDECLARED.*tier1-structural.md" ||
  fail_test "the batched report was declared by a name no lens has; said [$(cat "$LENS_OUT")]"
grep -q "structural" "$LENS_ERR" ||
  fail_test "the surplus ledger name was dropped in silence; said [$(cat "$LENS_ERR")]"
pass_test "a start naming a lens the manifest does not assign declares no report"

# L10l. THE SUMMARY NAMES THE ARTIFACT. stderr and stdout are different streams:
# the moment a caller redirects the fault lines, "N line(s) above" points at
# nothing and names neither the file just written nor the tier's own record.
grep -q "also written to" "$LENS_ERR" ||
  fail_test "the summary still says [above]; said [$(cat "$LENS_ERR")]"
grep -q "tier1-missing.txt" "$LENS_ERR" ||
  fail_test "the summary did not name the verdict file; said [$(cat "$LENS_ERR")]"
# And it carries a severity: without the prefix the line that closes a FAILING
# tier is typographically identical to the clean one, so a reader grepping a
# captured log for [ERROR] sees a green tier that did not close.
grep -q "^\[ERROR\] tier 1 is not accounted for" "$LENS_ERR" ||
  fail_test "the failing summary carried no severity; said [$(cat "$LENS_ERR")]"
pass_test "the closing summary names the file the faults were also written to"

# L10m. A DIRECTORY IS NOT A REPORT. `-s` is true for any non-empty inode, a
# directory included, so `mkdir tier1-<lens>.md` in the findings directory
# cleared the stall — and telling PRESENT from CLAIMED is the check's whole job.
lens_reset
lens_start 1 code-review-alpha sub-a1
lens_skip 1 design-review-beta "no wire payload in this diff"
mkdir -p "$LENS_FINDINGS/tier1-code-review-alpha.md"
lens_missing 1
[ "$lens_status" -eq "$SHIP_LENS_FAULTS" ] ||
  fail_test "a DIRECTORY named like a report cleared the stall, exited $lens_status"
lens_said "^STALLED.*code-review-alpha" ||
  fail_test "a directory was accepted as the lens's report; said [$(cat "$LENS_OUT")]"
rmdir "$LENS_FINDINGS/tier1-code-review-alpha.md"
pass_test "a directory named tier<N>-<lens>.md does not clear STALLED"

# L10n. A `done` WITH NO `start` is a ledger that contradicts itself — the reply
# was recorded and the dispatch record was lost — and the branch evaluated to
# nothing, so `missing` answered "every lens accounted for". It is a warning and
# not a sixth fault kind: the report on disk still decides the tier.
lens_reset
run_lens -s "$RS_LENS" done -t 1 -l code-review-alpha
lens_skip 1 code-review-alpha "child stalled twice"
lens_skip 1 design-review-beta "no wire payload in this diff"
lens_missing 1
[ "$lens_status" -eq 0 ] ||
  fail_test "the orphan-done fixture exited $lens_status, expected 0; said [$(cat "$LENS_OUT")]"
grep -q "done with no start line" "$LENS_ERR" ||
  fail_test "a done with no start was evaluated to nothing; said [$(cat "$LENS_ERR")]"
pass_test "a done record with no start line is named on stderr"

# L10o. A WRITE THAT CANNOT HAPPEN IS NOT A DOMAIN ANSWER. `start` IS the
# mechanism — RFC 234's guarantee holds only because the line is on disk before
# the child works — and a failed append exited 1 through set -e, a status -h
# never defined and the one that means "faults found" for the sibling verb. The
# verdict write had the same leak: exit 1 with an empty list, destroying the
# sixteen faults it had just computed by failing to archive them.
#
# The fixture makes findings/ a FILE, so every write beneath it fails for any
# user, root included — a chmod fixture would be vacuous for one of them.
BLOCKED_RS="$(make_run run-lens-blocked "$LENS_CORPUS")"
: > "$BLOCKED_RS/findings"
run_lens -s "$BLOCKED_RS" start -t 1 -l code-review-alpha -c sub-a1
[ "$lens_status" -eq "$SHIP_LENS_CANNOT_RUN" ] ||
  fail_test "a start whose ledger could not be written exited $lens_status, expected $SHIP_LENS_CANNOT_RUN"
grep -q "unrecorded" "$LENS_ERR" ||
  fail_test "the unwritable ledger did not say the dispatch was lost; said [$(cat "$LENS_ERR")]"
run_lens -s "$BLOCKED_RS" missing -t 1
[ "$lens_status" -eq "$SHIP_LENS_CANNOT_RUN" ] ||
  fail_test "a verdict that could not be written exited $lens_status, expected $SHIP_LENS_CANNOT_RUN"
grep -q "tier1-missing.txt" "$LENS_ERR" ||
  fail_test "the unwritable verdict did not name the file; said [$(cat "$LENS_ERR")]"
pass_test "a record or verdict that cannot be WRITTEN exits the system code, never a domain answer"

echo ""
echo "==== ship-lens: usage grammar ===="

# L11. The reserved bin/functions exit codes. ship-lens copies the values rather
# than sourcing bin/common — it must run outside the dev shell — so these
# assertions are what stops the copy drifting: a caller that invoked it wrongly
# must be distinguishable from a run that faulted, and identically so across
# bin/.
assert_exit_code "$EXIT_INVALID_ARG_VALUE" "an unknown verb exits EXIT_INVALID_ARG_VALUE" \
  "$SHIP_LENS" -s "$RS_LENS" grab -t 1
assert_exit_code "$EXIT_UNKNOWN_OPTION" "an unknown option exits EXIT_UNKNOWN_OPTION" \
  "$SHIP_LENS" -Z -s "$RS_LENS" missing -t 1
assert_exit_code "$EXIT_OPTION_REQUIRES_VALUE" "-s without a value exits EXIT_OPTION_REQUIRES_VALUE" \
  "$SHIP_LENS" -s
assert_exit_code "$EXIT_UNEXPECTED_ARG" "a surplus positional exits EXIT_UNEXPECTED_ARG" \
  "$SHIP_LENS" -s "$RS_LENS" missing -t 1 tier2
assert_exit_code "$EXIT_MISSING_REQUIRED_ARG" "missing without -s exits EXIT_MISSING_REQUIRED_ARG" \
  "$SHIP_LENS" missing -t 1
assert_exit_code "$EXIT_MISSING_REQUIRED_ARG" "start without -c exits EXIT_MISSING_REQUIRED_ARG" \
  "$SHIP_LENS" -s "$RS_LENS" start -t 1 -l code-review-alpha
assert_exit_code "$EXIT_MISSING_REQUIRED_ARG" "no verb at all exits EXIT_MISSING_REQUIRED_ARG" \
  "$SHIP_LENS" -s "$RS_LENS" -t 1
assert_exit_code "$EXIT_INVALID_ARG_VALUE" "a -t that is not a tier number exits EXIT_INVALID_ARG_VALUE" \
  "$SHIP_LENS" -s "$RS_LENS" missing -t two
assert_exit_code "$EXIT_INVALID_ARG_VALUE" "a -s that is not a run scratch exits EXIT_INVALID_ARG_VALUE" \
  "$SHIP_LENS" -s "$FIXTURE_DIR/not-a-run" missing -t 1

# A lens name becomes a FILENAME — tier<N>-<lens>.md — the moment `missing`
# looks for its report, so a name that is not one is refused before it is
# written rather than recorded as a claim no file could ever satisfy.
lens_reset
assert_exit_code "$EXIT_INVALID_ARG_VALUE" "a lens name that is a PATH exits EXIT_INVALID_ARG_VALUE" \
  "$SHIP_LENS" -s "$RS_LENS" start -t 1 -l ../../escape -c sub-a1
assert_exit_code "$EXIT_INVALID_ARG_VALUE" "an empty lens name exits EXIT_INVALID_ARG_VALUE" \
  "$SHIP_LENS" -s "$RS_LENS" done -t 1 -l ""
[ ! -f "$LENS_LEDGER" ] ||
  fail_test "a refused lens name was appended anyway: [$(cat "$LENS_LEDGER")]"
pass_test "a refused lens name writes no ledger at all"

# L11b. A REPEATED OPTION IS SURPLUS, NOT A CORRECTION. `-t 1 start -t 2` names
# two tiers and the ledger records one, so last-wins wrote the record nobody
# asked for — and the same script already refuses an option the verb does not
# take, on the argument that a caller who named a value believes it was used.
# The two-pass parser makes the split form the easy one to hit, so both are
# refused; CLAUDE.md's bin/ conventions name a repeated flag as a value-shape
# check that belongs after the grammar.
lens_reset
assert_exit_code "$EXIT_UNEXPECTED_ARG" "a repeated -t is refused" \
  "$SHIP_LENS" -s "$RS_LENS" start -t 1 -t 2 -l code-review-alpha -c sub-a1
assert_exit_code "$EXIT_UNEXPECTED_ARG" "an option repeated ACROSS the verb is refused" \
  "$SHIP_LENS" -s "$RS_LENS" -t 1 start -t 2 -l code-review-alpha -c sub-a1
assert_exit_code "$EXIT_UNEXPECTED_ARG" "a repeated -l is refused" \
  "$SHIP_LENS" -s "$RS_LENS" done -t 1 -l code-review-alpha -l design-review-beta
[ ! -f "$LENS_LEDGER" ] ||
  fail_test "a refused repeat was recorded anyway: [$(cat "$LENS_LEDGER")]"
pass_test "a refused repeated option writes no ledger at all"

# L11c. A REFUSAL A CALLER CAN ACT ON. Three payloads described a rule the input
# satisfied or withheld the input itself: ".hidden" IS letters and a dot, so the
# stated class accepted the value it had just rejected; an empty -l rendered as
# "lens [-l ]" where -c and -r both say "is empty" by name; and a reason refused
# for carrying a tab never showed the reason, so a coordinator that built it
# from a child's failure text had to go and print the string to find out which
# character it meant.
lens_reset
run_lens -s "$RS_LENS" start -t 1 -l .hidden -c sub-a1
[ "$lens_status" -eq "$EXIT_INVALID_ARG_VALUE" ] ||
  fail_test "a lens name beginning with a dot exited $lens_status, expected $EXIT_INVALID_ARG_VALUE"
grep -q "begins with a dot" "$LENS_ERR" ||
  fail_test "the refusal named a class that ACCEPTS [.hidden]; said [$(cat "$LENS_ERR")]"
run_lens -s "$RS_LENS" done -t 1 -l ""
grep -q "the lens name (-l) is empty" "$LENS_ERR" ||
  fail_test "an empty lens name was not refused by name; said [$(cat "$LENS_ERR")]"
BAD_REASON="$(printf 'child\tstalled')"
run_lens -s "$RS_LENS" skip -t 1 -l code-review-alpha -r "$BAD_REASON"
grep -qF -- "$(printf '%q' "$BAD_REASON")" "$LENS_ERR" ||
  fail_test "the refused value was not shown; said [$(cat "$LENS_ERR")]"
pass_test "a refused value is shown, and each refusal names the rule it applied"

# L12. -h is the one thing besides the lists that stdout carries, because the
# caller asked for it.
"$SHIP_LENS" -h > "$LENS_OUT" 2> "$LENS_ERR" || fail_test "-h did not exit 0"
grep -q "ship-lens -s <run-scratch> missing" "$LENS_OUT" ||
  fail_test "-h did not write the usage to stdout; said [$(cat "$LENS_OUT")]"
[ ! -s "$LENS_ERR" ] || fail_test "-h wrote to stderr: [$(cat "$LENS_ERR")]"
pass_test "-h writes the usage to stdout and nothing to stderr"

# L13. A REVIEW THAT QUIETLY RUNS WITH FEWER LENSES LOOKS EXACTLY LIKE A CLEAN
# ONE, so neither half of the discovery may answer "nothing". An unreadable
# tiers.md and an empty skills directory are both halts, not empty tiers — and
# they exit 2, not 1. Exit 1 is the tier's own answer, with the faults on
# stdout; a check that could not RUN prints nothing there, which is exactly what
# a clean tier looks like to a caller reading the lists.
EMPTY_CORPUS="$FIXTURE_DIR/lens-corpus-empty"
mkdir -p "$EMPTY_CORPUS/.claude/skills/review-fix"
cp "$LENS_CORPUS/.claude/skills/review-fix/tiers.md" "$EMPTY_CORPUS/.claude/skills/review-fix/tiers.md"
RS_LENS_EMPTY="$(make_run run-lens-empty "$EMPTY_CORPUS")"
mkdir -p "$RS_LENS_EMPTY/findings"
run_lens -s "$RS_LENS_EMPTY" missing -t 1
[ "$lens_status" -eq "$SHIP_LENS_CANNOT_RUN" ] ||
  fail_test "a corpus with NO lens directories exited $lens_status, expected $SHIP_LENS_CANNOT_RUN — a review with no lenses read as a tier"
grep -q "no review lenses" "$LENS_ERR" ||
  fail_test "the empty-corpus halt did not say why; said [$(cat "$LENS_ERR")]"
[ ! -s "$LENS_OUT" ] ||
  fail_test "a halt wrote a diagnostic to stdout: [$(cat "$LENS_OUT")]"
pass_test "a corpus with no lens directories HALTS with the system code instead of reporting a tier"

NO_TIERS_CORPUS="$FIXTURE_DIR/lens-corpus-no-tiers"
mkdir -p "$NO_TIERS_CORPUS/.claude/skills"
cp -R "$LENS_CORPUS/.claude/skills/code-review-alpha" "$NO_TIERS_CORPUS/.claude/skills/"
RS_LENS_NO_TIERS="$(make_run run-lens-no-tiers "$NO_TIERS_CORPUS")"
mkdir -p "$RS_LENS_NO_TIERS/findings"
run_lens -s "$RS_LENS_NO_TIERS" missing -t 1
[ "$lens_status" -eq "$SHIP_LENS_CANNOT_RUN" ] ||
  fail_test "an unreadable tier manifest exited $lens_status, expected $SHIP_LENS_CANNOT_RUN — every lens would belong to no tier"
grep -q "tiers.md" "$LENS_ERR" ||
  fail_test "the unreadable-manifest halt did not name the file; said [$(cat "$LENS_ERR")]"
pass_test "an unreadable tiers.md HALTS with the system code instead of leaving every lens tierless"

# L13b. THE RUN STATE IS THE ONLY SOURCE OF THE CORPUS ROOT. SKILL.md phase 1
# tells every coordinator to hold CODEBASE_ROOT in its shell for the whole run,
# so an inherited value is always present in practice: if the environment could
# stand in for a state file that does not name the root, `missing` would judge
# whichever worktree the environment happened to name and report another
# corpus's lenses as this run's faults. The argument is the answer.
NO_ROOT_RS="$FIXTURE_DIR/run-lens-no-root"
mkdir -p "$NO_ROOT_RS/findings"
printf 'RUN_ID=run-lens-no-root\nPHASE=reviewing\n' > "$NO_ROOT_RS/state"
CODEBASE_ROOT="$LENS_CORPUS" run_lens -s "$NO_ROOT_RS" missing -t 1
[ "$lens_status" -eq "$SHIP_LENS_CANNOT_RUN" ] ||
  fail_test "an exported CODEBASE_ROOT stood in for the run's own state, exited $lens_status"
grep -q "has no CODEBASE_ROOT" "$LENS_ERR" ||
  fail_test "the halt did not name the missing state key; said [$(cat "$LENS_ERR")]"
pass_test "an exported CODEBASE_ROOT cannot stand in for the run scratch's state"

# L13c. THE TWO ASYMMETRIES OF CORPUS DISCOVERY, and both are refusals or drops
# that are silent on every run where their precondition is absent — so without
# these two fixtures the whole suite passes with either branch deleted.
#
# First: a lens DIRECTORY with no row in tiers.md. It belongs to no tier, so no
# tier ever asks for it and nothing is ever missing — the silent-shrinkage case
# from the other side, and therefore fatal by name.
clone_corpus untiered
mkdir -p "$CORPUS_DIR/.claude/skills/code-review-delta"
echo "# code-review-delta" > "$CORPUS_DIR/.claude/skills/code-review-delta/SKILL.md"
run_lens -s "$CORPUS_RS" missing -t 1
[ "$lens_status" -eq "$SHIP_LENS_CANNOT_RUN" ] ||
  fail_test "a lens with no tiers.md row exited $lens_status, expected $SHIP_LENS_CANNOT_RUN — a lens no tier would ever ask for"
grep -q "code-review-delta" "$LENS_ERR" ||
  fail_test "the untiered lens was not named; said [$(cat "$LENS_ERR")]"
# …and it does not take the tier's own faults down with it. The halt is raised
# after the lists are printed, because a corpus fault that blanked stdout would
# make the state in which the most is unknown the one that reads cleanest.
lens_said "^UNDISPATCHED.*code-review-alpha" ||
  fail_test "the untiered-lens halt swallowed this tier's faults; said [$(cat "$LENS_OUT")]"
# …and the ARCHIVE keeps both halves too: the halt reason is appended UNDER this
# tier's own fault lines rather than replacing them, so the file phase 7 reads
# says what was missing AND why the check stopped.
grep -q "^UNDISPATCHED" "$CORPUS_RS/findings/tier1-missing.txt" ||
  fail_test "the halt erased the tier's faults from its verdict file: [$(cat "$CORPUS_RS/findings/tier1-missing.txt")]"
grep -q "^INCOMPLETE.*code-review-delta" "$CORPUS_RS/findings/tier1-missing.txt" ||
  fail_test "the corpus halt left no reason in the verdict file: [$(cat "$CORPUS_RS/findings/tier1-missing.txt")]"
pass_test "a lens directory with no tiers.md row HALTS by name AFTER reporting the tier's own faults"

# L13d. Second, and deliberately NOT symmetrical: a tiers.md ROW whose skill
# directory is gone is a RETIRED lens. Dropping it is the whole point — kept, it
# would print UNDISPATCHED forever with no child able to clear it, and the tier
# could never close. The warning is what keeps the drop from being silent.
clone_corpus retired
rm -rf "$CORPUS_DIR/.claude/skills/design-review-beta"
run_lens -s "$CORPUS_RS" start -t 1 -l code-review-alpha -c sub-a1
[ "$lens_status" -eq 0 ] || fail_test "start against the retired-lens corpus failed: $(cat "$LENS_ERR")"
echo "## Findings" > "$CORPUS_RS/findings/tier1-code-review-alpha.md"
run_lens -s "$CORPUS_RS" missing -t 1
[ "$lens_status" -eq 0 ] ||
  fail_test "a retired lens held the tier open; said [$(cat "$LENS_OUT")]"
grep -q "design-review-beta" "$LENS_ERR" ||
  fail_test "the retired lens was dropped silently; said [$(cat "$LENS_ERR")]"
pass_test "a tiers.md row with no skill directory warns and drops the lens"

# L13e. AND THE DROP MUST NOT COVER FOR A DRIFTED GLOB. The three discovery
# families are owned by references/review.md and restated by /review-fix's step
# 2; this script's glob is the third copy. When they drift — a new family, a
# renamed one — the row lands in the retired branch, whose warning then asserts
# the opposite of the truth: the skill is right there on disk, the lens never
# runs, and the tier closes clean. That is the silent shrinkage this script
# exists to prevent, so a row whose SKILL.md exists halts by name instead.
clone_corpus drifted
mkdir -p "$CORPUS_DIR/.claude/skills/arch-review-foo"
echo "# arch-review-foo" > "$CORPUS_DIR/.claude/skills/arch-review-foo/SKILL.md"
printf '| `arch-review-foo` |\n' >> "$CORPUS_DIR/.claude/skills/review-fix/tiers.md"
run_lens -s "$CORPUS_RS" missing -t 2
[ "$lens_status" -eq "$SHIP_LENS_CANNOT_RUN" ] ||
  fail_test "a tiers.md row whose skill EXISTS was dropped as retired, exited $lens_status"
grep -q "arch-review-foo" "$LENS_ERR" ||
  fail_test "the undiscovered lens was not named; said [$(cat "$LENS_ERR")]"
pass_test "a tiers.md row whose skill directory exists but discovery missed HALTS instead of being called retired"

# L13f. THE TWO WAYS A TIER CAN HAVE NO LENS, which wore one message and have
# opposite repairs: add a row, or restore a skill. The script holds the whole
# assignment when it says this, and told the caller none of it — "no lens is
# assigned to tier [9]" named neither the manifest nor the tiers that exist,
# which is exactly what a mistyped -t needs.
run_lens -s "$RS_LENS" missing -t 7
[ "$lens_status" -eq "$SHIP_LENS_CANNOT_RUN" ] ||
  fail_test "a tier the manifest does not name exited $lens_status, expected $SHIP_LENS_CANNOT_RUN"
grep -q "no row for tier \[7\]" "$LENS_ERR" ||
  fail_test "the no-such-tier halt did not name the tier asked for; said [$(cat "$LENS_ERR")]"
grep -q "tiers \[1 2\]" "$LENS_ERR" ||
  fail_test "the no-such-tier halt hid the tiers the manifest does assign; said [$(cat "$LENS_ERR")]"
pass_test "a tier with no row HALTS naming the manifest and the tiers it does assign"

clone_corpus all-retired
rm -rf "$CORPUS_DIR/.claude/skills/code-review-alpha" "$CORPUS_DIR/.claude/skills/design-review-beta"
run_lens -s "$CORPUS_RS" missing -t 1
[ "$lens_status" -eq "$SHIP_LENS_CANNOT_RUN" ] ||
  fail_test "a tier whose every lens is retired exited $lens_status, expected $SHIP_LENS_CANNOT_RUN"
grep -q "is retired" "$LENS_ERR" ||
  fail_test "a tier emptied by retirement was reported as a tier with no row; said [$(cat "$LENS_ERR")]"
grep -q "code-review-alpha" "$LENS_ERR" ||
  fail_test "the retired lenses that emptied the tier were not named; said [$(cat "$LENS_ERR")]"
pass_test "a tier whose every row was dropped as retired HALTS saying so, not [no row for this tier]"

end_tests
