#!/usr/bin/env bash
# deploy: the single operator entry point for shipping a release. Contains no AWS
# resource definitions (those are OpenTofu's). Sequence:
#   1. bin/build           — produce all deployable installDist distributions locally.
#   2. assemble a bundle   — tarball preserving repo-relative paths.
#   3. upload to S3        — the artifacts bucket (OpenTofu output).
#   4. SSM Run Command     — execute deploy-on-instance on the host (output id).
source "$(dirname "$0")/common"

help() {
  cat << 'EOF'
deploy <env> [options]

Builds, bundles, uploads, and triggers an on-instance deploy via SSM Run Command
for one environment (<env>, e.g. prod). Requires an active AWS session and a
completed `bin/infra-apply <env>` (reads the artifacts bucket and instance id
from that env's OpenTofu outputs).

Options:
  -h: Help
EOF
  exit 0
}

while getopts ":h" opt; do
  case "$opt" in
  h) help ;;
  \?) fatal -s "$EXIT_UNKNOWN_OPTION" "unknown option [-$OPTARG]" ;;
  :)  fatal -s "$EXIT_OPTION_REQUIRES_VALUE" "option [-$OPTARG] requires an argument" ;;
  esac
done
shift $((OPTIND-1))

UNICOACH_ENV="${1:-}"
if [ -n "$UNICOACH_ENV" ]; then
  shift
fi
if [ "$#" -gt 0 ]; then
  fatal -s "$EXIT_UNEXPECTED_ARG" "deploy accepts only an environment argument: $*"
fi

# Deploy-control config (AWS account/region) comes from .env.deploy.<env>, sourced
# over the base bin/common already loaded. bin/deploy itself reads only the
# account/region and the <env> argument; the app config it forwards to
# gen-deployed-env, which resolves its own ENV_FILE=.env.<env> (base -> .env.<env>,
# never .env.dev — the chain rule). AWS_REGION is derived from REGION inside
# .env.deploy.<env> and exported by the helper, feeding every
# `aws … --region "$AWS_REGION"` call below. `unicoach_env_file` fatals on a
# missing/absent env before any work; load_deploy_control_env then sources the
# deploy-control file and asserts the active credentials resolve to its declared
# AWS_ACCOUNT_ID before any tofu output read, build, upload, or SSM call, so a stray
# ambient AWS profile fails loudly instead of shipping a release to the wrong account.
unicoach_env_file "$UNICOACH_ENV" >/dev/null
load_deploy_control_env "$UNICOACH_ENV"

# Point this run's OpenTofu reads at <env>'s disjoint state (TF_DATA_DIR) and init
# the partial backend with its state key. The init is not optional: an output read
# against an uninitialized or foreign-keyed backend fails or returns the wrong
# env's state. TF_DATA_DIR is exported so the later `tofu output` reads hit the
# same per-env data dir.
export TF_DATA_DIR="$PROJECT_ROOT/infra/.terraform-$UNICOACH_ENV"
tofu -chdir="$PROJECT_ROOT/infra" init \
  -backend-config="key=unicoach/$UNICOACH_ENV/terraform.tfstate" >&2

# AWS_REGION for the S3 upload and SSM --region calls below is a true env var,
# derived from REGION in .env.deploy.<env> (AWS_REGION="${AWS_REGION:-$REGION}")
# and exported when sourced above with `set -a`, so the aws CLI and OpenTofu
# (TF_VAR_region) target one region. An externally exported AWS_REGION still wins.

# ── 1. Build all deployable distributions ─────────────────────────────────────
"$PROJECT_ROOT/bin/build"

REST_DIST="rest-server/build/install/rest-server"
WORKER_DIST="queue-worker/build/install/queue-worker"
PUBLIC_WEB_DIST="public-web/build/install/public-web"
ADMIN_WEB_DIST="admin-web/build/install/admin-web"
# COLLEGE_DIST is defined once in bin/functions (sourced via bin/common) as the
# single source of truth shared with bin/ingest-colleges; do not redefine it here.

for dist in "$REST_DIST" "$WORKER_DIST" "$PUBLIC_WEB_DIST" "$ADMIN_WEB_DIST" "$COLLEGE_DIST"; do
  [ -d "$PROJECT_ROOT/$dist" ] || fatal "Missing distribution [$dist]; did bin/build succeed?"
done

# ── 2. Assemble the bundle ────────────────────────────────────────────────────
# The service dists (rest-server/, queue-worker/, public-web/, admin-web/) are
# tarred from their build/install parent so they enter the bundle as bare
# rest-server/, queue-worker/, public-web/, and admin-web/ — the paths the systemd
# units expect at current/<svc>/bin/<svc>, decoupled from the Gradle build layout.
# The college dist is tarred preserving its full repo-relative path
# college/build/install/college, so on the instance its launcher lands at
# current/college/build/install/college/bin/college — the SAME $PROJECT_ROOT-
# relative path as the local dev tree, so bin/ingest-colleges resolves one path in
# both trees (no build/install-stripping split to reconcile).
# The on-instance migration scripts source bin/common -> bin/functions and shell
# out to the bin/db-* family; bin/db-status and bin/db-create both invoke
# bin/db-query for their existence checks, so it must be included. Every db-run
# gates on bin/postgres-check, so it is bundled too. bin/ingest-colleges is the
# ops tool bin/remote triggers on the instance; its own script must ship alongside
# its college/ dist. These repo files keep their repo-relative paths under
# $PROJECT_ROOT.
BUNDLE_ID="$(date -u +%Y%m%d%H%M%S)"
BUNDLE_PATH="$(mktemp -t unicoach-deploy.XXXXXX).tar.gz"

# Stage the two GENERATED bundle members (deploy-env, empty .env) in a scratch dir
# tarred with -C, so nothing is written into the working tree. Cleaned up with the
# bundle on exit.
GEN_STAGE="$(mktemp -d -t unicoach-deploy-gen.XXXXXX)"
trap 'rm -f "$BUNDLE_PATH"; rm -rf "$GEN_STAGE"' EXIT

# Flatten .env -> .env.<env> (never .env.dev) into deploy-env: the non-secret box
# config as flat KEY=<resolved-value> lines. gen-deployed-env fatals on the laptop
# (before upload) if any DEPLOY_VAR_NAMES key is missing, aborting the deploy. The
# empty .env is the intentionally-empty base the host carries so bin/common runs
# the same `base -> delta` shape everywhere (the complete /etc/unicoach/env layers
# on top of it, contributing nothing).
log-info "Generating deploy-env for [$UNICOACH_ENV]..."
"$PROJECT_ROOT/bin/gen-deployed-env" "$UNICOACH_ENV" > "$GEN_STAGE/deploy-env"
printf '# Intentionally empty base on the deploy host. The complete materialized\n# environment is /etc/unicoach/env, layered over this by bin/common (RFC 95).\n' > "$GEN_STAGE/.env"

REPO_PATHS=(
  "db/schema"
  "bin/common"
  "bin/functions"
  "bin/db-create-role"
  "bin/db-create"
  "bin/db-migrate"
  "bin/db-status"
  "bin/db-write"
  "bin/db-query"
  "bin/db-run"
  "bin/postgres-check"
  "bin/ingest-colleges"
)

for path in "${REPO_PATHS[@]}"; do
  [ -e "$PROJECT_ROOT/$path" ] || fatal "Bundle path missing [$path]."
done

# The two staged generated members enter the bundle at the repo-relative root
# (deploy-env and .env), the paths render-env and bin/common expect on the host.
GEN_PATHS=("deploy-env" ".env")

log-info "Assembling deploy bundle [$BUNDLE_ID]..."
tar -czf "$BUNDLE_PATH" \
  -C "$(dirname "$PROJECT_ROOT/$REST_DIST")" "$(basename "$REST_DIST")" \
  -C "$(dirname "$PROJECT_ROOT/$WORKER_DIST")" "$(basename "$WORKER_DIST")" \
  -C "$(dirname "$PROJECT_ROOT/$PUBLIC_WEB_DIST")" "$(basename "$PUBLIC_WEB_DIST")" \
  -C "$(dirname "$PROJECT_ROOT/$ADMIN_WEB_DIST")" "$(basename "$ADMIN_WEB_DIST")" \
  -C "$PROJECT_ROOT" "$COLLEGE_DIST" \
  -C "$PROJECT_ROOT" "${REPO_PATHS[@]}" \
  -C "$GEN_STAGE" "${GEN_PATHS[@]}"

# ── 3. Upload to the artifacts bucket ─────────────────────────────────────────
# Read the bucket from this env's OpenTofu outputs (under the TF_DATA_DIR exported
# above), fataling on empty so a missing/renamed output surfaces loudly instead of
# feeding an empty string into the S3 upload.
ARTIFACTS_BUCKET="$(tofu -chdir="$PROJECT_ROOT/infra" output -raw artifacts_bucket)"
[ -n "$ARTIFACTS_BUCKET" ] || fatal "Could not read [artifacts_bucket] from OpenTofu outputs."

BUNDLE_KEY="releases/unicoach-$BUNDLE_ID.tar.gz"
BUNDLE_S3_URI="s3://$ARTIFACTS_BUCKET/$BUNDLE_KEY"

log-info "Uploading bundle to [$BUNDLE_S3_URI]..."
aws s3 cp --region "$AWS_REGION" "$BUNDLE_PATH" "$BUNDLE_S3_URI"

# ── 4. Trigger the on-instance deploy via SSM Run Command ─────────────────────
INSTANCE_ID="$(tofu -chdir="$PROJECT_ROOT/infra" output -raw instance_id)"
[ -n "$INSTANCE_ID" ] || fatal "Could not read [instance_id] from OpenTofu outputs."

log-info "Issuing SSM Run Command to [$INSTANCE_ID]..."
COMMAND_ID="$(aws ssm send-command \
  --region "$AWS_REGION" \
  --instance-ids "$INSTANCE_ID" \
  --document-name "AWS-RunShellScript" \
  --comment "unicoach deploy $BUNDLE_ID" \
  --parameters "commands=[\"/opt/unicoach/bin/deploy-on-instance $BUNDLE_S3_URI\"]" \
  --query "Command.CommandId" \
  --output text)"

log-info "SSM command [$COMMAND_ID] dispatched. Tail with:"
log-info "  aws ssm get-command-invocation --region $AWS_REGION --command-id $COMMAND_ID --instance-id $INSTANCE_ID"
