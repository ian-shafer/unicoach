#!/usr/bin/env bash
source "$(dirname "$0")/common"

help() {
  cat << 'EOF'
db-drop [options]

Drops the application database (DROP DATABASE IF EXISTS ... WITH FORCE).
Idempotent. The postgres cluster and its data directory are left intact;
only the single database named by POSTGRES_DB is removed.

DROP DATABASE is checked against the OWNER, so this first ensures this checkout
owns its target (RFC 174): its own role, and — for a database that predates the
change and is still owned by the cluster admin — the database itself. A no-op
when POSTGRES_USER already IS the cluster admin.

Options:
  -y: Disable confirmation prompt
  -h: Help
EOF
  exit 0
}

skip_prompt=false
while getopts ":hy" opt; do
  case "$opt" in
    h) help ;;
    y) skip_prompt=true ;;
    \?) fatal -s "$EXIT_UNKNOWN_OPTION" "unknown option [-$OPTARG]" ;;
    :)  fatal -s "$EXIT_OPTION_REQUIRES_VALUE" "option [-$OPTARG] requires an argument" ;;
  esac
done
shift $((OPTIND-1))

if [ "$#" -gt 0 ]; then
  fatal -s "$EXIT_UNEXPECTED_ARG" "db-drop does not accept positional arguments: $*"
fi

if [ "$skip_prompt" = false ]; then
  require_dangerous_confirmation "drop the application database and all its data"
fi

log-info "Dropping database [$POSTGRES_DB]..."
"$PROJECT_ROOT/bin/postgres-up" >/dev/null

# The same one idea db-create opens with, and for the same reason: db-drop
# connects as POSTGRES_USER, which since RFC 174 is this checkout's own owner
# role, and BOTH halves of that can be missing here.
#
#   * The ROLE does not exist yet in a brand-new worktree, so the connection is
#     refused before anything is dropped — and db-reset's step 1 is this script.
#   * The DATABASE may still be owned by `postgres` (every database predating
#     RFC 174 is), and DROP DATABASE is checked against the OWNER. `IF EXISTS`
#     does not help: the database exists. Without the adoption, bin/db-reset,
#     bin/test and bin/db-restore all die here in every pre-existing checkout.
#
# It is not db-drop's job to decide either of those things, which is why it asks
# for the named outcome rather than restating the policy: ownership of the target
# is a PRECONDITION of dropping it, not a second responsibility. A no-op when
# POSTGRES_USER already IS the cluster admin (the cloud case; db-drop is not
# shipped to an instance anyway). Diagnostics to stderr: this script's product is
# a side effect.
set_checkout_database_ownership
printf 'DROP DATABASE IF EXISTS "%s" WITH (FORCE);' "$(sql_ident "$POSTGRES_DB")" \
  | "$PROJECT_ROOT/bin/db-write" -d "${POSTGRES_ADMIN_DB:-postgres}"
log-info "Database [$POSTGRES_DB] successfully dropped."
