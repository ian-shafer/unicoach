#!/usr/bin/env bash
# Aggregator for the shell script-test harnesses (RFC 115).
#
# OWNS NO POSTGRES LIFECYCLE: like bin/db-tests, it assumes the caller (bin/test
# check, or a developer who has run db-bootstrap) provides a live shared cluster.
# q-scripts-tests and scripts-tests self-provision their per-worktree test DB
# against it (each runs db-reset, so this aggregator leaves the test DB dirty —
# bin/test's existing db-reset is the cleanup); db-scripts-tests provisions and
# tears down its own private, throwaway cluster regardless.
#
# scripts-tests additionally requires built rest-server/queue-worker installDist
# artifacts, and stops THIS CHECKOUT's rest-server/queue-worker daemons via its
# EXIT trap (daemon identity hangs off bin/common's PROJECT_ROOT, so no other
# worktree is touched). bin/test check builds those artifacts before calling here.
#
# Each harness aborts on its first failure and this script runs them sequentially
# under `set -e`, so it aborts non-zero on the first failing harness. Ordering is
# cheapest-first: the ordering only changes how long a developer waits to learn
# the tree is broken.
# Layer `.env -> .env.dev -> .env.test` (RFC 95): the DB block and required-toggle
# dev values live in .env.dev. ENV_FILES is a PATH-like ':'-separated string.
# Under bin/test it is inherited (exported) across the process boundary; run
# STANDALONE it defaults here to the same stack if unset. bin/common resolves each
# entry against PROJECT_ROOT.
export ENV_FILES="${ENV_FILES:-.env.dev:.env.test}"
source "$(dirname "$0")/common"

help() {
  cat << 'EOF'
shell-tests [options]

Runs the shell script-test harnesses sequentially, cheapest first, aborting on
the first failure. With -n, runs only the named ones, still in this order:

  ship-scripts-tests        the /ship land lock, no cluster at all
  prompt-seed-scripts-tests the coach prompt seed generator, no cluster at all
  docs-scripts-tests        the /chart documentation land path, no cluster
  test-calendar-seed-scripts-tests
                            the SAT/ACT calendar seed generator, no cluster
  test-state-programme-seed-scripts-tests
                            the state school-day programme seed generator
  fafsa-deadline-seed-scripts-tests
                            the FAFSA filing-deadline seed generator, no cluster
  gate-scope-scripts-tests  the commit gate's path-to-harness map, no cluster
  web-assets-scripts-tests  the client-side TypeScript rail, deno only, no
                            cluster
  q-scripts-tests           queue ops tools, shared cluster
  db-scripts-tests          db/cluster lifecycle, its OWN private cluster
  scripts-tests             daemon/ops/deploy scripts, shared cluster + built
                            rest-server/queue-worker installDist artifacts

NO PER-HARNESS COSTS ARE PUBLISHED HERE ANY MORE, DELIBERATELY. This help used
to carry them (~6s / ~3s / 4.6s / ~2s / ~12s / ~15s / ~63s, about 105s in
total) and they were quiet-machine figures that a reader then quoted as fact.
Measured individually on a working machine at load 3.2-3.4 on 2026-09-14, the
same set took 639s, of which db-scripts-tests was 284s -- roughly 19x its old
published figure, and the SLOWEST of the set rather than the second cheapest
that the ordering above implies. Measure on the machine you care about, state
the load average, or say nothing (RFC 214).

Owns no Postgres lifecycle: the caller supplies a live shared cluster. Leaves
this worktree's test DB dirty, and stops this checkout's rest-server and
queue-worker daemons. bin/test check invokes this after installDist and before
its db-reset.

Options:
  -n NAME  run only this harness; repeatable; order is always the one above,
           never the order given. Unknown name -> exit 22.
  -h: Help
EOF
  exit 0
}

SELECTED=()

while getopts ":n:h" opt; do
  case "$opt" in
  n) SELECTED+=("$OPTARG") ;;
  h) help ;;
  \?) fatal -s "$EXIT_UNKNOWN_OPTION" "unknown option [-$OPTARG]" ;;
  :)  fatal -s "$EXIT_OPTION_REQUIRES_VALUE" "option [-$OPTARG] requires an argument" ;;
  esac
done
shift $((OPTIND-1))

if [ "$#" -ne 0 ]; then
  fatal -s "$EXIT_UNEXPECTED_ARG" "Error: shell-tests accepts no positional arguments."
fi

# The harnesses, in the order they run: cheapest first, so a developer learns the
# tree is broken as early as the ordering allows.
#
# ENTRIES ARE `bin/<name>`, NOT BARE NAMES, AND THAT IS LOAD-BEARING. The
# anti-orphan sweep in bin/scripts-tests greps THIS FILE for the literal string
# `bin/<harness>` and fails when it is absent -- that is what stops a harness
# being added to bin/ and then never run. An array of bare names would have
# turned every one of those assertions green while asserting nothing.
#
# Two harnesses need a word each:
#
#  * gate-scope-scripts-tests is the map that decides which of these run for a
#    given diff (RFC 214). It needs no cluster, no daemon and no worktree, only
#    throwaway `git init` repos, so it sits with the cheap ones.
#  * web-assets-scripts-tests drives bin/build-web-assets (RFC 225): deno, into
#    temp trees, plus one check-only run over the committed tree. No cluster, no
#    daemon, no Gradle, so it sits with the cheap ones too. It is the thing that
#    catches a TypeScript edit committed without a rebuild.
#  * db-scripts-tests builds its own private env file and sets ENV_FILE, which
#    bin/common rejects as mutually exclusive with an inherited ENV_FILES. The
#    variable is cleared for that child only -- its private cluster is
#    deliberately unrelated to the shared one this stack points at.
#
# The cheap six above q-scripts-tests are all cheap for the same reason: they
# drive a script that reads files and a git tree, so a temp directory is the
# whole environment they need. ship (the /ship land lock), prompt-seed (the coach
# prompt generator, RFC 181), docs (the /chart land path, RFC 201, which also
# gates bin/pre-commit's refusal to commit in the root checkout), test-calendar
# (RFC 197), test-state-programme (RFC 208) and fafsa-deadline (RFC 223) -- the
# last three reach refusals that are reachable ONLY from a bad CSV, so they are
# executed here and nowhere else.
HARNESSES=(
  bin/ship-scripts-tests
  bin/prompt-seed-scripts-tests
  bin/docs-scripts-tests
  bin/test-calendar-seed-scripts-tests
  bin/test-state-programme-seed-scripts-tests
  bin/fafsa-deadline-seed-scripts-tests
  bin/gate-scope-scripts-tests
  bin/web-assets-scripts-tests
  bin/q-scripts-tests
  bin/db-scripts-tests
  bin/scripts-tests
)

# Validate every -n BEFORE running anything. A typo that silently ran a shorter
# set would be a gate reporting green over tests nobody executed, which is the
# failure mode this whole mechanism exists to avoid.
for requested in ${SELECTED[@]+"${SELECTED[@]}"}; do
  found=0
  for harness in "${HARNESSES[@]}"; do
    [ "${harness#bin/}" = "$requested" ] && found=1 && break
  done
  if [ "$found" -ne 1 ]; then
    fatal -s "$EXIT_INVALID_ARG_VALUE" "unknown harness [$requested]. Run 'bin/shell-tests -h' for the list."
  fi
done

if [ "${#SELECTED[@]}" -gt 0 ]; then
  log-info "running only the requested harnesses: ${SELECTED[*]}"
fi

for harness in "${HARNESSES[@]}"; do
  name="${harness#bin/}"
  if [ "${#SELECTED[@]}" -gt 0 ]; then
    wanted=0
    for requested in ${SELECTED[@]+"${SELECTED[@]}"}; do
      [ "$requested" = "$name" ] && wanted=1 && break
    done
    [ "$wanted" -eq 1 ] || continue
  fi
  case "$name" in
  db-scripts-tests) env -u ENV_FILES "$PROJECT_ROOT/$harness" ;;
  *) "$PROJECT_ROOT/$harness" ;;
  esac
done
