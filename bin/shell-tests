#!/usr/bin/env bash
# Aggregator for the shell script-test harnesses (RFC 115).
#
# OWNS NO POSTGRES LIFECYCLE: like bin/db-tests, it assumes the caller
# (bin/check, or a developer who has run db-bootstrap) provides a live shared
# cluster.
# q-scripts-tests and scripts-tests self-provision their per-worktree test DB
# against it (each runs db-reset, so this aggregator leaves the test DB dirty —
# bin/test's existing db-reset is the cleanup); db-scripts-tests provisions and
# tears down its own private, throwaway cluster regardless.
#
# scripts-tests additionally requires built rest-server/queue-worker installDist
# artifacts, and stops THIS CHECKOUT's rest-server/queue-worker daemons via its
# EXIT trap (daemon identity hangs off bin/common's PROJECT_ROOT, so no other
# worktree is touched). bin/check builds those artifacts before calling here.
#
# The harnesses run in three LANES at once (RFC 259), split by what each shares:
# a private cluster, nothing at all, or this checkout's test DB and daemons. A
# lane runs its harnesses in the declared order and stops at its first failure,
# as the serial loop did; the other lanes run on, so one run reports every
# failing harness. The lane map, below the harness list, is the only place a
# harness is let out of the serial `shared` lane.
# Layer `.env -> .env.dev -> .env.test` (RFC 95): the DB block and required-toggle
# dev values live in .env.dev. ENV_FILES is a PATH-like ':'-separated string.
# Under bin/test it is inherited (exported) across the process boundary; run
# STANDALONE it defaults here to the same stack if unset. bin/common resolves each
# entry against PROJECT_ROOT.
export ENV_FILES="${ENV_FILES:-.env.dev:.env.test}"
source "$(dirname "$0")/common"

help() {
  cat << 'EOF'
shell-tests [options]

Runs the shell script-test harnesses in three concurrent lanes (RFC 259):

  own-cluster   db-scripts-tests, on its own private cluster
  cluster-free  the harnesses below that need no cluster
  shared        q-scripts-tests then scripts-tests, which share this checkout's
                test DB, ports and daemons -- and any harness not named in the
                lane map, which is the safe default

Inside a lane, harnesses run in the order below and the lane stops at its first
failure. The other lanes run on, so every failure is reported. Each harness's
output is captured and replayed to stderr in this order once all lanes finish;
a one-line note is printed as each harness ends. The exit status is the first
failing harness's, in this order. When only one lane has work (e.g. -n
scripts-tests), it runs in the foreground with live output. Every harness gets
/dev/null as stdin, as it does under git's hook.

With -n, runs only the named ones, still in this order:

  ship-scripts-tests        the /ship land lock, no cluster at all
  prompt-seed-scripts-tests the coach prompt seed generator, no cluster at all
  docs-scripts-tests        the /chart documentation land path, no cluster
  codebook-seed-scripts-tests
                            the published-codebook seed generator, no cluster
  test-calendar-seed-scripts-tests
                            the SAT/ACT calendar seed generator, no cluster
  test-state-programme-seed-scripts-tests
                            the state school-day programme seed generator
  fafsa-deadline-seed-scripts-tests
                            the FAFSA filing-deadline seed generator, no cluster
  national-merit-seed-scripts-tests
                            the National Merit cycle seed generator, no cluster
  gate-scope-scripts-tests  the commit gate's path-to-harness map, no cluster
  web-assets-scripts-tests  the client-side TypeScript rail, deno only, no
                            cluster
  q-scripts-tests           queue ops tools, shared cluster
  db-scripts-tests          db/cluster lifecycle, its OWN private cluster
  scripts-tests             daemon/ops/deploy scripts, shared cluster + built
                            rest-server/queue-worker installDist artifacts

NO PER-HARNESS COSTS ARE PUBLISHED HERE ANY MORE, DELIBERATELY. This help used
to carry them (~6s / ~3s / 4.6s / ~2s / ~12s / ~15s / ~63s, about 105s in
total) and they were quiet-machine figures that a reader then quoted as fact.
Measured individually on a working machine at load 3.2-3.4 on 2026-09-14, the
same set took 639s, of which db-scripts-tests was 284s -- roughly 19x its old
published figure, and the SLOWEST of the set rather than the second cheapest
that the ordering above implies. Measure on the machine you care about, state
the load average, or say nothing (RFC 214).

Owns no Postgres lifecycle: the caller supplies a live shared cluster. Leaves
this worktree's test DB dirty, and stops this checkout's rest-server and
queue-worker daemons. bin/check invokes this after installDist and before
bin/test's db-reset.

Options:
  -n NAME  run only this harness; repeatable; order is always the one above,
           never the order given. Unknown name -> exit 22.
  -h: Help
EOF
  exit 0
}

SELECTED=()

while getopts ":n:h" opt; do
  case "$opt" in
  n) SELECTED+=("$OPTARG") ;;
  h) help ;;
  \?) fatal -s "$EXIT_UNKNOWN_OPTION" "unknown option [-$OPTARG]" ;;
  :)  fatal -s "$EXIT_OPTION_REQUIRES_VALUE" "option [-$OPTARG] requires an argument" ;;
  esac
done
shift $((OPTIND-1))

if [ "$#" -ne 0 ]; then
  fatal -s "$EXIT_UNEXPECTED_ARG" "Error: shell-tests accepts no positional arguments."
fi

# The harnesses, in the DECLARED order: the order each lane runs its own
# harnesses in, the order the captured logs are replayed in, and the order that
# decides which failure sets the exit status.
#
# ENTRIES ARE `bin/<name>`, NOT BARE NAMES, AND THAT IS LOAD-BEARING. The
# anti-orphan sweep in bin/scripts-tests greps THIS FILE for the literal string
# `bin/<harness>` and fails when it is absent -- that is what stops a harness
# being added to bin/ and then never run. An array of bare names would have
# turned every one of those assertions green while asserting nothing.
#
# Two harnesses need a word each:
#
#  * gate-scope-scripts-tests is the map that decides which of these run for a
#    given diff (RFC 214). It needs no cluster, no daemon and no worktree, only
#    throwaway `git init` repos, so it sits with the cheap ones.
#  * web-assets-scripts-tests drives bin/build-web-assets (RFC 225): deno, into
#    temp trees, plus one check-only run over the committed tree. No cluster, no
#    daemon, no Gradle, so it sits with the cheap ones too. It is the thing that
#    catches a TypeScript edit committed without a rebuild.
#  * db-scripts-tests builds its own private env file and sets ENV_FILE, which
#    bin/common rejects as mutually exclusive with an inherited ENV_FILES. The
#    variable is cleared for that child only -- its private cluster is
#    deliberately unrelated to the shared one this stack points at.
#
# The cheap ones above q-scripts-tests are all cheap for the same reason: they
# drive a script that reads files and a git tree, so a temp directory is the
# whole environment they need. ship (the /ship land lock), prompt-seed (the coach
# prompt generator, RFC 181), docs (the /chart land path, RFC 201, which also
# gates bin/pre-commit's refusal to commit in the root checkout) and the seed
# generators -- codebook (RFC 189), test-calendar (RFC 197), test-state-programme
# (RFC 208), fafsa-deadline (RFC 223) and national-merit (RFC 243), each of which
# reaches refusals that are reachable ONLY from a bad CSV, so each is executed
# here and nowhere else. The property is attached to the harnesses by NAME rather
# than to a position and a count: the sentence this replaced counted the entries
# of the array below it, and had already drifted -- it said "the last four" over
# five generators and omitted codebook-seed entirely.
HARNESSES=(
  bin/ship-scripts-tests
  bin/prompt-seed-scripts-tests
  bin/docs-scripts-tests
  bin/codebook-seed-scripts-tests
  bin/test-calendar-seed-scripts-tests
  bin/test-state-programme-seed-scripts-tests
  bin/fafsa-deadline-seed-scripts-tests
  bin/national-merit-seed-scripts-tests
  bin/gate-scope-scripts-tests
  bin/web-assets-scripts-tests
  bin/q-scripts-tests
  bin/db-scripts-tests
  bin/scripts-tests
)

# Validate every -n BEFORE running anything. A typo that silently ran a shorter
# set would be a gate reporting green over tests nobody executed, which is the
# failure mode this whole mechanism exists to avoid.
for requested in ${SELECTED[@]+"${SELECTED[@]}"}; do
  found=0
  for harness in "${HARNESSES[@]}"; do
    [ "${harness#bin/}" = "$requested" ] && found=1 && break
  done
  if [ "$found" -ne 1 ]; then
    fatal -s "$EXIT_INVALID_ARG_VALUE" "unknown harness [$requested]. Run 'bin/shell-tests -h' for the list."
  fi
done

if [ "${#SELECTED[@]}" -gt 0 ]; then
  log-info "running only the requested harnesses: ${SELECTED[*]}"
fi

# Which harnesses may run beside which. A harness's LANE is decided by what it
# shares, and only two lanes are named here:
#
#   own-cluster   db-scripts-tests provisions and tears down a PRIVATE cluster on
#                 its own port, so it shares nothing with the other lanes.
#   cluster-free  needs a temp directory and git, nothing else: no database, no
#                 daemon, no var/ state, and no write into the checkout (each was
#                 checked when this map was written, RFC 259).
#
# Everything else -- q-scripts-tests and scripts-tests, which share this
# checkout's test DB, test ports and daemons, AND any harness added later -- is
# in `shared`, the one lane that runs serially beside the database users. A new
# harness is never given concurrency nobody reviewed it for: moving it out of
# `shared` is a decision someone makes here, by name.
harness_lane() {
  case "$1" in
  db-scripts-tests) echo own-cluster ;;
  ship-scripts-tests | prompt-seed-scripts-tests | docs-scripts-tests | \
    codebook-seed-scripts-tests | test-calendar-seed-scripts-tests | \
    test-state-programme-seed-scripts-tests | fafsa-deadline-seed-scripts-tests | \
    national-merit-seed-scripts-tests | gate-scope-scripts-tests | \
    web-assets-scripts-tests) echo cluster-free ;;
  *) echo shared ;;
  esac
}

# stdin is /dev/null for every harness, which is what git already gives the hook,
# so a direct run behaves the same and a confirmation prompt reached by mistake
# fails instead of blocking a lane forever.
run_harness() {
  local name="$1"
  case "$name" in
  db-scripts-tests) env -u ENV_FILES "$PROJECT_ROOT/bin/$name" < /dev/null ;;
  *) "$PROJECT_ROOT/bin/$name" < /dev/null ;;
  esac
}

# The harnesses this run executes, in the declared order.
TO_RUN=()
for harness in "${HARNESSES[@]}"; do
  name="${harness#bin/}"
  if [ "${#SELECTED[@]}" -gt 0 ]; then
    wanted=0
    for requested in ${SELECTED[@]+"${SELECTED[@]}"}; do
      [ "$requested" = "$name" ] && wanted=1 && break
    done
    [ "$wanted" -eq 1 ] || continue
  fi
  TO_RUN+=("$name")
done

# The lanes that have work, each once, in the order they first appear.
ACTIVE_LANES=()
for name in "${TO_RUN[@]}"; do
  lane="$(harness_lane "$name")"
  list_has_lane=0
  for active in ${ACTIVE_LANES[@]+"${ACTIVE_LANES[@]}"}; do
    [ "$active" = "$lane" ] && list_has_lane=1 && break
  done
  [ "$list_has_lane" -eq 1 ] || ACTIVE_LANES+=("$lane")
done

# One lane: nothing to overlap, so run it as the serial loop always ran -- in
# the foreground, output live, stopping at the first failure with its status.
# This is the tight loop (`bin/shell-tests -n scripts-tests`), where a developer
# watches the harness rather than waiting for a replay.
if [ "${#ACTIVE_LANES[@]}" -le 1 ]; then
  for name in "${TO_RUN[@]}"; do
    run_harness "$name"
  done
  exit 0
fi

LOG_DIR="$(mktemp -d "${TMPDIR:-/tmp}/shell-tests.XXXXXX")"
LANE_PIDS=()

# On INT/TERM, stop the lanes' harnesses too: each harness's own trap then tears
# down what it started (scripts-tests' daemons, db-scripts-tests' cluster).
# Without this, an interrupted gate would leave three lanes running unseen.
stop_lanes() {
  local pid
  for pid in ${LANE_PIDS[@]+"${LANE_PIDS[@]}"}; do
    pkill -TERM -P "$pid" 2>/dev/null || true
    kill -TERM "$pid" 2>/dev/null || true
  done
}
trap 'rm -rf "$LOG_DIR"' EXIT
trap 'stop_lanes; exit 130' INT TERM

# A lane: its harnesses in the declared order, each captured to its own log, its
# status recorded beside the log, stopping at the first failure. A harness with
# no status file afterwards was never reached.
run_lane() {
  local lane="$1" name status started
  for name in "${TO_RUN[@]}"; do
    [ "$(harness_lane "$name")" = "$lane" ] || continue
    started=$SECONDS
    status=0
    run_harness "$name" > "$LOG_DIR/$name.log" 2>&1 || status=$?
    printf '%s\n' "$status" > "$LOG_DIR/$name.status"
    if [ "$status" -eq 0 ]; then
      log-info "[shell-tests] $name passed in $(( SECONDS - started ))s ($lane lane)"
    else
      log-error "[shell-tests] $name FAILED with status [$status] after $(( SECONDS - started ))s ($lane lane); the rest of the $lane lane is not run"
      return 0
    fi
  done
}

log-info "[shell-tests] running ${#TO_RUN[@]} harness(es) in ${#ACTIVE_LANES[@]} lanes: ${ACTIVE_LANES[*]}"
for lane in "${ACTIVE_LANES[@]}"; do
  run_lane "$lane" &
  LANE_PIDS+=("$!")
done
# A lane's own status is not the verdict -- the status files are -- so a lane
# that died is not allowed to abort the replay here; its unreached harnesses
# surface below as not run, and that alone fails the run.
for pid in "${LANE_PIDS[@]}"; do
  wait "$pid" || log-error "[shell-tests] a lane process exited with status [$?]"
done

# Replay every log in the declared order, then the verdict. The exit status is
# the FIRST failure's in that order, so it does not depend on which lane happened
# to finish first.
FIRST_FAILURE_STATUS=0
FAILED=()
NOT_RUN=()
for name in "${TO_RUN[@]}"; do
  if [ ! -f "$LOG_DIR/$name.status" ]; then
    NOT_RUN+=("$name")
    continue
  fi
  log-info "==== shell-tests: $name ($(harness_lane "$name") lane) ===="
  cat "$LOG_DIR/$name.log" >&2
  status="$(cat "$LOG_DIR/$name.status")"
  if [ "$status" -ne 0 ]; then
    FAILED+=("$name")
    [ "$FIRST_FAILURE_STATUS" -ne 0 ] || FIRST_FAILURE_STATUS="$status"
  fi
done

if [ "${#FAILED[@]}" -gt 0 ]; then
  if [ "${#NOT_RUN[@]}" -gt 0 ]; then
    log-error "[shell-tests] not run, because an earlier harness in their lane failed: ${NOT_RUN[*]}"
  fi
  log-error "[shell-tests] FAILED: ${FAILED[*]}"
  exit "$FIRST_FAILURE_STATUS"
fi
# Unreached with nothing failed means a lane died between harnesses. A harness
# nobody ran is never a pass.
if [ "${#NOT_RUN[@]}" -gt 0 ]; then
  fatal "[shell-tests] no harness failed, yet these were never run: ${NOT_RUN[*]}. A lane ended early; the gate cannot pass over tests that did not execute."
fi
log-info "[shell-tests] all ${#TO_RUN[@]} harness(es) passed."
