#!/usr/bin/env bash
source "$(dirname "$0")/common"

help() {
  cat << 'EOF'
db-restore [-y] [<file>]

Arguments:
  file: A pg_dump custom-format artifact written by bin/db-dump; when omitted,
        the dump is read from stdin

Restores POSTGRES_DB from a bin/db-dump artifact. DESTRUCTIVE: the target is
dropped and recreated first (bin/db-drop -y, then bin/db-create), because
restoring over a populated database yields a merge, not a restore. It does NOT
run bin/db-migrate — the dump already carries the schema and the
schema_migrations rows. That is right for a CURRENT dump and quietly wrong for
an old one, so the success line names the migration level the restore landed
at; if this checkout expects newer migrations, run bin/db-migrate yourself.
Nothing is migrated implicitly.

bin/db-create pre-creates an empty schema_migrations, which collides with the
same table in the dump, so the restore runs
`pg_restore --single-transaction --clean --if-exists --no-owner --no-privileges`.
db-create is still required in the sequence: it issues the database-level GRANT
CONNECT to DATABASE_USER, which a plain pg_dump does not carry.

The restore itself is ALL-OR-NOTHING. pg_restore's default is to CONTINUE past
errors, which would leave a partly restored database — and since the dump
carries schema_migrations, a partial restore can make bin/db-status report a
fully migrated database over a broken schema. --single-transaction (which
implies --exit-on-error) makes a failed restore roll back instead, so the
outcome is either the whole archive or an EMPTY database, never a plausible
half.

The internal bin/db-drop -y disarms the only confirmation in the chain, so this
script prompts for itself and takes its own -y. On a stdin restore the prompt
cannot share stdin with the dump, so it is read from /dev/tty; with no terminal,
pass -y.

The input is verified to be a readable pg_dump custom-format archive BEFORE the
target is dropped. Only then is anything destroyed. A truncated file, or a plain
SQL file passed by mistake — the natural mistake, since -Fc is not
human-readable — is refused with exit 7 and the database is left exactly as it
was, rather than dropped and then found unrestorable.

There is deliberately no option to name a different target database: this script
DESTROYS what it restores over, and a restore aimed at the wrong database is the
accident RFC 156 exists to prevent. bin/db-dump's read-only -d has no
counterpart here.

Artifacts live outside the repo, in $POSTGRES_DUMP_DIR (a .env.dev key, which
owns the value). With NO file argument and no stdin stream, that directory's
dev.dump is what is restored, so a fresh worktree does not have to type the
path; bin/db-dump -D writes exactly that file:

  nix develop -c bin/db-restore                # $POSTGRES_DUMP_DIR/dev.dump
  nix develop -c bin/db-restore /some/other.dump
  nix develop -c bin/db-dump | ssh other-mac 'nix develop -c bin/db-restore -y'

The default applies ONLY when POSTGRES_DUMP_DIR is set to a usable directory
path. Unset, empty, or "/" — all of which would make the default the
filesystem-root path "/dev.dump" or claim a key is missing when it is merely
malformed — the no-argument case is exit 4 instead, with a message that says
which of the three it was. A missing default file is exit 4 too, and the message
names the path that was looked for.

The stream form is for a DIFFERENT MACHINE. Piping a bin/db-dump from THIS
checkout into it is not a workflow: both ends resolve the same POSTGRES_DB, so
it would drop a live dev database to restore it from itself.

Local-only tooling; never deployed.

Options:
  -y: Disable confirmation prompt
  -h: Help

Exit codes:
  3: the named input file does not exist or is not readable
  4: no input — stdin is a terminal and neither a named file nor a
     $POSTGRES_DUMP_DIR/dev.dump default was available, or the stdin stream was
     empty
  5: pg_restore failed; the restore was rolled back and the target is EMPTY
  6: no terminal available to confirm a stdin restore (pass -y)
  7: the input is not a readable pg_dump custom-format archive (nothing dropped)
 10: unknown option
 11: option given without its value
 20: unexpected positional argument

Only code 5 is deliberately aligned with bin/db-dump: in both scripts it means
"the underlying pg_* tool failed". Every other code here is private to
bin/db-restore and carries no meaning in its sibling.
EOF
  exit 0
}

EXIT_NO_SUCH_INPUT_FILE=3
EXIT_NO_INPUT=4
# 5 is "the underlying pg_* tool failed" in bin/db-dump too; these two ship as a
# pair, so the code that means a tool failure means it in both.
EXIT_RESTORE_FAILED=5
EXIT_CANNOT_PROMPT=6
EXIT_NOT_AN_ARCHIVE=7

skip_prompt=false
while getopts ":yh" opt; do
  case "$opt" in
  y) skip_prompt=true ;;
  h) help ;;
  \?) fatal -s "$EXIT_UNKNOWN_OPTION" "unknown option [-$OPTARG]" ;;
  :)  fatal -s "$EXIT_OPTION_REQUIRES_VALUE" "option [-$OPTARG] requires an argument" ;;
  esac
done
shift $((OPTIND-1))

if [ "$#" -gt 1 ]; then
  fatal -s "$EXIT_UNEXPECTED_ARG" "db-restore accepts at most one argument: <file>; received: [$*]"
fi

# WHERE the dump comes from, as one discriminant rather than a boolean, because
# the three sources are not two: `argument` (a path the caller typed),
# `default` (the conventional artifact this script resolved), `stdin` (a
# stream). A boolean forced two different questions -- "was an argument given"
# and "is there a file on disk" -- through one variable that was then MUTATED,
# so `given=true` with `SOURCE_LABEL=stdin` was representable, and SOURCE_LABEL
# is the string the DESTRUCTIVE confirmation shows the operator.
#
# Keeping `argument` distinct from `default` is what preserves exit 3 for
# `bin/db-restore ""` -- the shape a caller's unset variable makes,
# `bin/db-restore "$DUMP"`. That named a file, so it must be refused as a missing
# file, never re-read as "no argument" and turned into a STDIN restore that
# prompts to replace the database "with the contents of [stdin]".
#
# The three fields are one fact and are written TOGETHER, at each of the two
# places a source is decided (here for an argument, in resolve_input for the
# default), so a destination without its matching label cannot exist. IN_FILE
# alone is reassigned once more, to the buffered stdin copy, which is why
# INPUT_SOURCE and not IN_FILE answers "what am I restoring from".
INPUT_SOURCE=stdin
IN_FILE=
SOURCE_LABEL=stdin

# Decide WHAT is being restored, and refuse the inputs that are not restorable at
# all. Nothing is destroyed here.
resolve_input() {
  if [ "$INPUT_SOURCE" = argument ]; then
    if [ ! -f "$IN_FILE" ] || [ ! -r "$IN_FILE" ]; then
      fatal -s "$EXIT_NO_SUCH_INPUT_FILE" "dump file not found or not readable [$IN_FILE]"
    fi
    return 0
  fi
  [ -t 0 ] || return 0

  # No file named and no stream: fall back to the conventional artifact,
  # $POSTGRES_DUMP_DIR/dev.dump. The GUARD is the point — the key's PRESENCE and
  # its VALUE are separate answers (dump_dir_status, shared with bin/db-dump -D
  # so the pair cannot drift): unset is not the same as set-but-empty, and "/"
  # is a set value that would still make the default the filesystem-root path
  # "/dev.dump", which the operator never named. None of the three invents a
  # target. Either way the failure message NAMES what was looked for; "no file
  # was named" alone sent the operator hunting for a path nothing knew.
  local status=0
  dump_dir_status || status=$?
  case "$status" in
  0) ;;
  1) fatal -s "$EXIT_NO_INPUT" "no dump to restore: stdin is a terminal, no file was named, and POSTGRES_DUMP_DIR is not set (it is a .env.dev key), so there is no default to fall back to. Name a file, or restore .env.dev and write the default with bin/db-dump -D" ;;
  *) fatal -s "$EXIT_NO_INPUT" "no dump to restore: stdin is a terminal, no file was named, and POSTGRES_DUMP_DIR is set to [$POSTGRES_DUMP_DIR], which cannot hold a dump (an empty value or the filesystem root), so there is no default to fall back to. Fix the .env.dev key, or name a file" ;;
  esac

  # Three ways the default can be unusable, and they do not share a remedy: a
  # directory that was never created, a file that was never written, and a file
  # that IS there but cannot be read. Telling the third "write it with
  # bin/db-dump" is wrong advice — that run refuses to overwrite an existing
  # target (exit 3) and the operator learns nothing. Each branch names the path.
  local default_file
  default_file="$(conventional_dump_path)"
  if [ ! -d "$POSTGRES_DUMP_DIR" ]; then
    fatal -s "$EXIT_NO_INPUT" "no dump to restore: stdin is a terminal, no file was named, and the dump directory [$POSTGRES_DUMP_DIR] does not exist, so the default [$default_file] is not there either. Write it with: bin/db-dump -D"
  fi
  if [ ! -e "$default_file" ]; then
    fatal -s "$EXIT_NO_INPUT" "no dump to restore: stdin is a terminal, no file was named, and the default [$default_file] does not exist. Write it with: bin/db-dump -D"
  fi
  if [ ! -f "$default_file" ] || [ ! -r "$default_file" ]; then
    fatal -s "$EXIT_NO_INPUT" "no dump to restore: stdin is a terminal, no file was named, and the default [$default_file] exists but is not a readable file. Fix its permissions (or replace it); bin/db-dump -D would refuse to overwrite it without -f"
  fi

  INPUT_SOURCE=default
  IN_FILE="$default_file"
  SOURCE_LABEL="$default_file"
}

# The prompt must not eat the dump. With a named file, stdin is free and the
# prompt reads it as usual; on a stdin restore the confirmation is read from the
# controlling terminal instead, and its absence is an error rather than a silent
# destructive run.
#
# The terminal is named by a variable so the no-terminal refusal can be triggered
# under test — a harness always runs with a real /dev/tty, and an untriggerable
# refusal on a destructive path is an untested one. Same test-hook convention as
# UNICOACH_DOTENV / UNICOACH_ENV_DIR; unset, the behaviour is byte-identical to
# reading /dev/tty directly.
confirm_destruction() {
  [ "$skip_prompt" = false ] || return 0
  local tty_device="${UNICOACH_TTY_DEVICE:-/dev/tty}"
  local description="drop database [$POSTGRES_DB] and replace it with the contents of [$SOURCE_LABEL]"
  # The question is whether stdin is FREE for the prompt, which is exactly
  # "the dump is not coming from stdin" — a named file and the resolved default
  # both leave it free.
  if [ "$INPUT_SOURCE" != stdin ]; then
    require_dangerous_confirmation "$description"
    return 0
  fi
  if [ ! -e "$tty_device" ] || ! : < "$tty_device" 2>/dev/null; then
    fatal -s "$EXIT_CANNOT_PROMPT" "cannot confirm a stdin restore without a terminal; pass -y"
  fi
  require_dangerous_confirmation "$description" < "$tty_device"
}

# A stdin dump is buffered to a private temp file BEFORE anything is dropped.
#
# The durable reason is not the same-checkout self-pipe (which is not a workflow
# — see help()): it is that THE TARGET MUST NOT BE DROPPED UNTIL THE INPUT IS
# KNOWN READABLE AND NON-EMPTY. A stream cannot be inspected without being
# consumed, and a stream that turns out to be empty or truncated after the drop
# leaves the operator with no database and no archive. Buffering first makes the
# input a file, which the archive gate below then reads exactly as it reads a
# named one. That the buffering also lets a same-machine producer finish and
# disconnect is a side effect, not the reason.
buffer_stdin_to_file() {
  # Only a stream needs buffering; a file is already a file.
  [ "$INPUT_SOURCE" = stdin ] || return 0
  local tmp_base="${TMPDIR:-/tmp}"
  mkdir -p "$tmp_base"
  RESTORE_TMP="$(mktemp "$tmp_base/unicoach-db-restore.XXXXXX")"
  trap 'rm -f "$RESTORE_TMP"' EXIT INT TERM
  cat > "$RESTORE_TMP"
  if [ ! -s "$RESTORE_TMP" ]; then
    # The non-tty half of "the operator gave no dump", so it names the same
    # conventional artifact the terminal half does: an empty pipe usually means
    # the producer failed, and the remedy is the file that is already there.
    local default_hint="\$POSTGRES_DUMP_DIR/$DUMP_DEFAULT_FILENAME"
    if dump_dir_status; then
      default_hint="$(conventional_dump_path)"
    fi
    fatal -s "$EXIT_NO_INPUT" "no dump to restore: stdin was empty (the producing command wrote nothing). Restore a file instead: bin/db-restore [$default_hint], or with no argument from a terminal; write it with bin/db-dump -D"
  fi
  IN_FILE="$RESTORE_TMP"
}

# THE LAST GATE BEFORE DESTRUCTION. pg_restore --list reads the archive's table
# of contents and nothing else, so it is cheap and read-only, and it fails on
# exactly the inputs that would have been discovered only AFTER the drop: a
# truncated artifact, and a plain-SQL file (the natural mistake, since -Fc is not
# human-readable). Emptiness alone was not enough, and it was only ever checked
# on the stdin path.
#
# pg_restore's own diagnostic is CAPTURED INTO the refusal (`2>&1 >/dev/null`, in
# that order: stderr to the current stdout, then stdout to /dev/null), because it
# is the one fact that separates a truncated transfer from a plain SQL file from
# a permission problem. On the stdin path it is the only evidence there is: the
# label is the word "stdin" and the buffered copy is removed by the EXIT trap, so
# the path is named too.
require_readable_archive() {
  local err
  if ! err="$(pg_restore --list "$IN_FILE" 2>&1 >/dev/null)"; then
    fatal -s "$EXIT_NOT_AN_ARCHIVE" \
      "[$SOURCE_LABEL] is not a readable pg_dump custom-format archive; database [$POSTGRES_DB] was not touched. pg_restore --list [$IN_FILE] said [$(printf '%s' "$err" | tr '\n' ' ')]"
  fi
}

# The destructive step, and the only one. --single-transaction makes it
# ALL-OR-NOTHING: pg_restore's DEFAULT is to CONTINUE past errors, which would
# leave a PARTLY restored database -- and schema_migrations can restore while a
# table does not, so bin/db-status would then report a fully migrated database
# over a broken schema. --single-transaction implies --exit-on-error, so a failed
# restore rolls back and leaves the (already dropped and recreated) database
# EMPTY, which no tool mistakes for healthy.
#
# --clean --if-exists drops each object the archive is about to create, which is
# what resolves db-create's pre-created schema_migrations; --no-owner and
# --no-privileges keep the artifact portable across roles (db-create has already
# issued the grants this checkout needs).
#
# `< /dev/null` on the two children, which bin/db-reset (the precedent help()
# cites) does NOT use: on a stdin restore THIS script's stdin is the DUMP
# STREAM, and a child that read one byte of it would eat part of the artifact
# being restored. Neither child wants stdin -- db-drop is passed -y -- so
# closing it costs nothing. It is defence in depth, not the sole guard: the
# buffer-before-drop step has already drained stdin to a temp file by the time
# these run. Keep it anyway; it is what makes the safety local to this line
# instead of resting on a decision made 100 lines up.
restore_into_fresh_database() {
  "$PROJECT_ROOT/bin/db-drop" -y < /dev/null
  "$PROJECT_ROOT/bin/db-create" < /dev/null

  local status=0
  pg_restore --single-transaction --clean --if-exists --no-owner --no-privileges \
    -U "$POSTGRES_USER" -d "$POSTGRES_DB" "$IN_FILE" || status=$?
  if [ "$status" -ne 0 ]; then
    fatal -s "$EXIT_RESTORE_FAILED" \
      "pg_restore failed for database [$POSTGRES_DB] from [$SOURCE_LABEL] [status=$status]; the restore was ROLLED BACK, so [$POSTGRES_DB] is EMPTY (dropped and recreated, nothing from the archive applied). Fix or replace the archive and re-run this command, or run bin/db-reset for an empty migrated database."
  fi
}

if [ "$#" -eq 1 ]; then
  INPUT_SOURCE=argument
  IN_FILE="$1"
  SOURCE_LABEL="$1"
fi

# The order of these steps IS the safety property: nothing is destroyed until the
# input has been resolved, confirmed, buffered, and proven to be a readable
# archive.
resolve_input
confirm_destruction
log-info "Restoring database [$POSTGRES_DB] from [${SOURCE_LABEL}]..."
buffer_stdin_to_file
require_readable_archive
restore_into_fresh_database

# The stale-dump hint. This script deliberately does NOT run migrations — the
# archive carries both the schema and the schema_migrations rows — which is
# right for a current dump and silently wrong for an older one: the checkout is
# then left behind whatever migrations landed after the dump was taken, with
# nothing saying so. Report the level the restore landed at and name the remedy;
# running bin/db-migrate here instead would migrate implicitly, which this
# script does not do.
#
# THREE OUTCOMES, NOT TWO — the same rule bin/db-dump's require_database_exists
# states in this pair. A probe that FAILED (cluster gone, auth refused, no
# schema_migrations table) is not evidence that no migrations are applied, and
# saying so would ASSERT DATABASE STATE THIS SCRIPT NEVER OBSERVED, immediately
# after a destructive step. The status is kept (pipefail is on, so it is already
# computed) and db-query's own diagnostic is left on stderr, because that
# diagnostic is the only thing separating the three cases.
#
# Best-effort in the ONLY sense that applies: the restore has already SUCCEEDED,
# so a failing probe is warned about and never turned into a non-zero exit — and
# the warning says so, because a [WARNING] straight after a drop-and-recreate
# otherwise reads as "the restore broke".
report_migration_level() {
  local level=
  local status=0
  level="$("$PROJECT_ROOT/bin/db-query" -r \
    "SELECT filename FROM schema_migrations ORDER BY version_id DESC LIMIT 1;" \
    < /dev/null | head -n 1 | tr -d '[:space:]')" || status=$?
  if [ "$status" -ne 0 ]; then
    log-warning "THE RESTORE ITSELF SUCCEEDED: database [$POSTGRES_DB] was restored from [$SOURCE_LABEL] and nothing below undoes that. Only the migration-level probe failed [status=$status] (its own diagnostic is above), so the level is UNKNOWN, not empty. Check it with bin/db-status."
    return 0
  fi
  if [ -z "$level" ]; then
    log-info "Restored database [$POSTGRES_DB] reports no applied migrations. bin/db-restore does not run migrations; run bin/db-migrate if this checkout expects any."
    return 0
  fi
  log-info "Restored database [$POSTGRES_DB] is at migration level [$level]. bin/db-restore does not run migrations; run bin/db-migrate if this checkout expects newer ones."
}

log-info "Database [$POSTGRES_DB] restored from [$SOURCE_LABEL]."
report_migration_level
