#!/usr/bin/env bash
# The single path-to-harness map (RFC 214). Given a repository's STAGED set, says
# what the commit gate must run: whether Gradle is needed, which of the shell
# harnesses in bin/shell-tests can observe those paths, and whether contract
# fuzzing (bin/test-fuzz) must run.
#
# THIS IS A CORRECTNESS CLAIM, NOT A CONFIGURATION TABLE. If a row here is wrong,
# a defect reaches main and the gate reports green -- the worst failure this repo
# can have, because it is silent. So every narrow row below cites the EVIDENCE
# that no excluded harness observes those paths, and the script is fail-closed in
# five directions:
#
#   1. an unrecognised path  -> full
#   2. a MIXED set           -> full (the diff is judged AS A WHOLE, never per file)
#   3. an EMPTY staged set   -> full (a vacuous pass is not a pass)
#   4. a rename crossing a scope boundary -> full (--no-renames, so both sides are
#      classified: a delete on one side and an add on the other)
#   5. a bin/*scripts-tests this table does not name -> FATAL, by name, whatever
#      the diff. Mirrors the anti-orphan sweep in bin/scripts-tests.
#
# ONE SCRIPT, NEVER TWO TABLES. RFC 211's deferred D2 binds this: a wrong map in
# /ship phase 5 fails SILENTLY because the hook catches what it missed, while a
# wrong map in the hook does not -- so the duplicated copy that got trusted would
# be the one whose errors are invisible. bin/pre-commit is the only caller today;
# phase 5 may CALL this script later. It must never carry a copy of the table.
#
# RFC 194's product/** rule is not reimplemented here. This script CALLS
# bin/functions' staged_changes_are_product_docs_only, which was written and
# tested for that claim. Rewriting it would have been the second table.

source "$(dirname "$0")/common"

help() {
  cat << 'EOF'
gate-scope [options]

Classifies a repository's STAGED set and prints what the commit gate must run.
bin/pre-commit is its caller.

Writes exactly four key=value lines to stdout:

  scope=<name>              full | full-gated | markdown-docs | product-docs
                            | prime-scripts | ios-app | module-source
  gradle=yes|no             whether bin/check's Gradle half must run
  harnesses=ALL|<names>|    which bin/shell-tests harnesses must run; ALL means
                            "whatever bin/shell-tests runs", so a newly added
                            harness is covered with no edit here; an empty value
                            means none. The path-gated harnesses (the
                            PATH_GATED_HARNESSES table in this script names them
                            and their inputs) are then dropped from that set
                            unless a staged path is one of their inputs,
                            whatever the scope. A `full` set that loses one is
                            `full-gated` instead, with the remaining harnesses
                            named explicitly instead of ALL. An empty index is
                            the exception: it stays `full` and ALL.
  fuzz=yes|no               whether bin/test-fuzz must run: yes when any staged
                            path is one of its inputs (the REST contract, the
                            harness, its uv project, its config). Independent of
                            scope.

The reason for the classification is written to stderr, in words.

Anything not recognised, any mixed set, and an empty index are all `full`
(`full-gated` when a path-gated harness was dropped). A
bin/*scripts-tests that this script's table does not name is a fatal error,
whatever the diff.

Options:
  -r DIR  repository to classify (default: this checkout)
  -h      Help
EOF
  exit 0
}

REPO="$PROJECT_ROOT"

while getopts ":r:h" opt; do
  case "$opt" in
  r) REPO="$OPTARG" ;;
  h) help ;;
  \?) fatal -s "$EXIT_UNKNOWN_OPTION" "unknown option [-$OPTARG]" ;;
  :)  fatal -s "$EXIT_OPTION_REQUIRES_VALUE" "option [-$OPTARG] requires an argument" ;;
  esac
done
shift $((OPTIND-1))

if [ "$#" -ne 0 ]; then
  fatal -s "$EXIT_UNEXPECTED_ARG" "Error: gate-scope accepts no positional arguments."
fi

if [ -z "$REPO" ]; then
  fatal -s "$EXIT_INVALID_ARG_VALUE" "option [-r] requires a non-empty directory"
fi
if [ ! -d "$REPO" ]; then
  fatal -s "$EXIT_INVALID_ARG_VALUE" "not a directory [$REPO]"
fi
if ! git -C "$REPO" rev-parse --git-dir > /dev/null 2>&1; then
  fatal -s "$EXIT_INVALID_ARG_VALUE" "not a git repository [$REPO]"
fi

# ---------------------------------------------------------------------------
# The table.
# ---------------------------------------------------------------------------
# Every harness bin/shell-tests runs, and the scopes each one belongs to. A
# harness named in NO narrow scope simply never runs for a narrow scope; it is
# still covered by `full`, which is `ALL`.
#
# KNOWN_HARNESSES is what makes rule 5 work: it is compared against the
# filesystem, so a harness added to bin/ and wired into bin/shell-tests but not
# declared here halts the gate by name rather than silently never running.
KNOWN_HARNESSES=(
  ship-scripts-tests
  prompt-seed-scripts-tests
  docs-scripts-tests
  codebook-seed-scripts-tests
  test-calendar-seed-scripts-tests
  test-state-programme-seed-scripts-tests
  fafsa-deadline-seed-scripts-tests
  national-merit-seed-scripts-tests
  gate-scope-scripts-tests
  web-assets-scripts-tests
  q-scripts-tests
  db-scripts-tests
  scripts-tests
)

# ios-scripts-tests is the ONE deliberate exclusion, carved out BY NAME rather
# than by a pattern so a future omission cannot be swallowed by the carve-out:
# it drives system Xcode and refuses to run inside the Nix dev shell (RFC 114),
# which is where the gate runs. bin/scripts-tests' own anti-orphan sweep excludes
# it for the same reason and in the same way.
HARNESS_EXCLUSIONS=(ios-scripts-tests)

# Scope `prime-scripts`: the harnesses that OBSERVE .prime/.
#
# EVIDENCE, and the third name is the one an instruction to write this script got
# wrong. bin/db-scripts-tests:1770 EXECUTES the real
# .prime/agent/skills/ship/scripts/ship-order against a throwaway git fixture, to
# make bin/common's ORDER reader and ship-order's ORDER writer meet. A map naming
# only ship- and docs-scripts-tests would land a ship-order change green with its
# one contract test never run.
#
# The sweep behind this list is by literal `.prime/` MENTION, not by resolved
# path, and that is deliberate: bin/ship-scripts-tests builds its targets as
# SHIP_SCRIPTS="$PROJECT_ROOT/.prime/agent/skills/ship/scripts" and then
# "$SHIP_SCRIPTS/ship-lock", and bin/docs-scripts-tests does the same through
# CHART_SCRIPTS. An exact-path map would not see those targets at all. Directory
# mention survives variable composition; exact matching does not. The harness
# bin/gate-scope-scripts-tests re-runs that sweep over the REAL harness files, so
# a future harness that starts reading .prime/ fails the build until this list
# catches up.
PRIME_HARNESSES="ship-scripts-tests docs-scripts-tests db-scripts-tests"

# Scope `module-source`: the harnesses that OBSERVE compiled Kotlin.
#
# EVIDENCE for what is KEPT: bin/scripts-tests boots the REAL built rest-server
# and queue-worker (test_daemon_wrapper "rest-server" / "queue-worker") and
# asserts they come up and answer. That is genuine observation of compiled
# Kotlin, so a module-source diff runs it. It is 269s of the 639s this table is
# trying to avoid, and it is kept anyway, because the evidence says to keep it.
#
# EVIDENCE for web-assets-scripts-tests (RFC 225 D-J): public-web's client-side
# TypeScript lives at public-web/src/main/ts and its COMMITTED bundle at
# public-web/src/main/resources/static/js, both inside a module src/ tree, so a
# TypeScript edit IS a module-source diff -- and the only thing that catches such
# an edit committed without a rebuild is that harness running
# `bin/build-web-assets -c`. It is listed UNCONDITIONALLY and not made
# conditional on a ts/ path: a TypeScript edit and a Kotlin edit both land in
# this scope, the harness costs seconds and needs no cluster, and a
# path-conditional row would be one more correctness claim to get wrong.
#
# EVIDENCE for what is EXCLUDED: none of the other harnesses references a built
# artifact, a daemon wrapper, or a module src path. The three apparent exceptions
# were read rather than counted -- prompt-seed-scripts-tests CREATES
# service/src/main/resources/service.conf inside its own fixture repo and never
# reads the real one; docs-scripts-tests' only .kt hit is a fixture file named
# " product/x.kt" with a leading space; q-scripts-tests drives bin/q-* through
# psql and never starts the JVM.
MODULE_SOURCE_HARNESSES="scripts-tests web-assets-scripts-tests"

# Contract fuzzing's inputs: the paths whose change can change bin/test-fuzz's
# answer without any Kotlin changing. The contract it fuzzes, the harness itself,
# the uv project that pins Schemathesis and everything beneath it, the check
# config it passes Schemathesis (schemathesis.toml), and the three env layers it
# runs on (.env, which bin/common always reads, and the .env.dev:.env.fuzz pair
# its ENV_FILES line names). A lock bump that re-admits a broken hypothesis release is
# the failure this catches: without it the bump lands green and the next spec
# change fails as "contract drift" (a8567607). A directory entry ends in `/` and
# matches everything under it; any other entry is an exact path.
#
# This list mirrors bin/test-fuzz by hand, so bin/gate-scope-scripts-tests holds
# it to the real tree: every entry must exist, and every env layer bin/test-fuzz
# names in ENV_FILES must be listed.
#
# Kotlin is deliberately absent: a route change can drift from the contract too,
# but fuzzing every module-source commit is the multi-minute cost the spec-only
# trigger was chosen to avoid. That trade is unchanged here.
FUZZ_INPUTS=(
  api-specs/openapi.yaml
  bin/test-fuzz
  tools/fuzz/
  schemathesis.toml
  .env
  .env.dev
  .env.fuzz
)

# The path-gated harnesses: each one paired with the paths whose change can
# change its answer, as `<harness>:<input>` -- one entry per pair, so the table
# stays ONE flat array that bash 3.2 can hold (it has no associative arrays) and
# that bin/gate-scope-scripts-tests reads the way it reads FUZZ_INPUTS. An input
# ending in `/` matches everything under it; any other input is an exact path.
#
# Like FUZZ_INPUTS this is independent of scope, and it is a FILTER, never an
# addition: a gated harness runs only when ANY staged path is one of its inputs
# (the fuzz quantifier, for the fuzz reason -- one input in a mixed set is enough
# to change its answer), and it is dropped from whatever list the scope row
# emitted otherwise, `full` included -- and a `full` that loses one is renamed
# `full-gated` (see the fallback row at the bottom). Ian, 2026-10-31: these harnesses "should
# not run unless the code that they test changes". Before this table, every
# mixed commit -- a Kotlin change with its RFC, say -- paid for both of them while
# changing nothing either one can observe.
#
# EVIDENCE for each input, and why the inputs are DIRECTORIES:
#
#  * the skill directory. bin/ship-scripts-tests drives
#    .prime/agent/skills/ship/scripts/* and the python suite under
#    .prime/agent/skills/ship/driver/tests; bin/docs-scripts-tests drives
#    .prime/agent/skills/chart/scripts/*. Neither skill's scripts call the
#    other's (read, not counted: every `ship` in the chart scripts is a comment),
#    so a ship change does not run the docs harness or the reverse.
#  * bin/, WHOLESALE, not the exact files each harness drives. The ship and chart
#    scripts source and execute bin/functions, bin/common, bin/env,
#    bin/file-lock, bin/gate-scope, bin/pre-commit, bin/format and more, and the
#    two harness files themselves live there. An exact-file list would be one
#    more correctness claim to go stale; directory membership is fail-closed.
#  * flake.nix and flake.lock: the toolchain (python, bash, git) both run on.
#  * .claude/skills/review-fix/tiers.md, for ship only: the driver suite's
#    test_applicability reads the REAL tier manifest and fails when a lens there
#    has no applicability row. Listing it keeps a mixed commit that adds a lens
#    from landing green over that failure. (A tiers.md-only commit is
#    markdown-docs and runs no harness at all, which this filter cannot change:
#    it only ever removes.)
#
# THE RESIDUE, stated rather than glossed: ship-scripts-tests reads beyond these
# inputs. The driver suite's test_every_irreversible_glob_matches_a_tracked_path
# (.prime/agent/skills/ship/driver/tests/test_dials.py) runs `git ls-files` over
# the WHOLE tree and fails when an IRREVERSIBLE_GLOBS entry matches no tracked
# path. So a commit that renames or deletes the last file such a glob matches --
# PRODUCT.md, a public-web HomePage, the budget package -- stages no input here,
# skips the harness, and lands green; the failure surfaces on the next commit
# that does stage a ship or bin/ path. Accepted, not overlooked: Ian decided on
# 2026-10-31 that these harnesses run only when the code they test changes, and
# listing every glob's owner as an input would be a second copy of
# IRREVERSIBLE_GLOBS that runs the harness on most commits anyway.
#
# THE EMPTY INDEX IS NOT FILTERED. Rule 3 says an empty set is `full` because it
# states nothing about what changed, and "nothing staged is an input" would be
# reading a claim into that silence -- the vacuous pass rule 3 refuses.
#
# bin/gate-scope-scripts-tests holds this table to the tree: every harness named
# here must be in KNOWN_HARNESSES and executable, every input must exist, and
# each harness's own file must be one of its inputs.
PATH_GATED_HARNESSES=(
  ship-scripts-tests:.prime/agent/skills/ship/
  ship-scripts-tests:bin/
  ship-scripts-tests:flake.nix
  ship-scripts-tests:flake.lock
  ship-scripts-tests:.claude/skills/review-fix/tiers.md
  docs-scripts-tests:.prime/agent/skills/chart/
  docs-scripts-tests:bin/
  docs-scripts-tests:flake.nix
  docs-scripts-tests:flake.lock
)

# ---------------------------------------------------------------------------
# Rule 5: the anti-orphan sweep. Runs BEFORE any classification, so a repository
# with an undeclared harness fails whatever the diff is -- including a `full`
# one. Failing only on a narrow path would hide it exactly when it matters least
# and let it surprise someone later.
#
# The glob is `*scripts-tests`, not `*-scripts-tests`, for the reason
# bin/scripts-tests already documents: the hyphenated form silently misses
# bin/scripts-tests itself, the most expensive harness of the set.
# ---------------------------------------------------------------------------
# Membership by exact NAME. bin/tests-common has a list_contains, but that file
# is a TEST helper -- it defines pass_test/fail_test and a TOTAL_TESTS counter --
# and a production script in the gate path has no business sourcing it.
# `${a[@]+"${a[@]}"}` and not the tidier `"${a[@]}"` at every array expansion in
# this script: bash 3.2 treats the expansion of an EMPTY array as an UNBOUND
# variable, so `set -u` aborts on an ordinary empty state. bin/common carries the
# same note for the same reason.
name_in() {
  local needle="$1" item
  shift
  for item in "$@"; do
    [ "$item" = "$needle" ] && return 0
  done
  return 1
}

for harness_path in "$PROJECT_ROOT"/bin/*scripts-tests; do
  [ -e "$harness_path" ] || continue
  harness="$(basename "$harness_path")"
  name_in "$harness" ${HARNESS_EXCLUSIONS[@]+"${HARNESS_EXCLUSIONS[@]}"} && continue
  if ! name_in "$harness" ${KNOWN_HARNESSES[@]+"${KNOWN_HARNESSES[@]}"}; then
    fatal "bin/gate-scope does not know the harness [$harness]. Every bin/*scripts-tests must be declared in KNOWN_HARNESSES and placed in whichever narrow scopes can observe it, or a narrow-scope commit would silently never run it. Add it and say which scopes see it."
  fi
done

# ---------------------------------------------------------------------------
# The staged set.
#
# -z with `IFS= read -r -d ''`: a pathname containing a newline, or a directory
# named " .prime" with a LEADING SPACE, must not be able to dodge a glob. That is
# a demonstrated defect in this repo, not a hypothetical (RFC 193).
#
# --no-renames: a rename is classified on BOTH sides, as a delete and an add, so
# `git mv .prime/x/SKILL.md bin/x` is `full` rather than inheriting the source
# path's scope.
# ---------------------------------------------------------------------------
STAGED=()
while IFS= read -r -d '' staged_path; do
  STAGED+=("$staged_path")
done < <(git -C "$REPO" diff --cached --name-only -z --no-renames)

# The Gradle modules, read from settings.gradle.kts -- the SOURCE OF TRUTH for
# what a module is, rather than a third copy of the list that bin/test also
# carries. A module that is added to the build and not here would only ever make
# this script fall back to `full`, which is the safe direction.
MODULES=()
while IFS= read -r module; do
  [ -n "$module" ] && MODULES+=("$module")
done < <(sed -n 's/^include("\([^"]*\)").*/\1/p' "$REPO/settings.gradle.kts" 2> /dev/null)

# Is $1 a path under a Gradle module's src/ tree?
is_module_source() {
  local path="$1" module
  for module in ${MODULES[@]+"${MODULES[@]}"}; do
    case "$path" in
    "$module"/src/*) return 0 ;;
    esac
  done
  return 1
}

# Is the staged path $1 the input $2 names? The one matching rule both input
# tables use: an input ending in `/` is a directory and matches everything under
# it, any other input is an exact path. A prefix without the slash would let
# tools/fuzzer/ pass for tools/fuzz/, and bin-old/ for bin/.
path_is_input() { # <staged path> <input>
  local path="$1" input="$2"
  case "$input" in
  */) case "$path" in "$input"*) return 0 ;; esac ;;
  *) [ "$path" = "$input" ] && return 0 ;;
  esac
  return 1
}

# The first staged path that is one of the inputs given, printed on stdout; exit
# 1 when no staged path is. The ONE quantifier both input tables use: a check
# must run when ANY staged path is one of its inputs -- the opposite quantifier
# to the scope rows, which need EVERY path to qualify, and for the same
# fail-closed reason: one input in a mixed set is enough to change that check's
# answer. Deletes count (deleting uv.lock breaks fuzzing), and --no-renames above
# means a rename into or out of an input counts on both sides.
first_staged_input() { # <input...>
  local staged_path input
  for staged_path in ${STAGED[@]+"${STAGED[@]}"}; do
    for input in "$@"; do
      if path_is_input "$staged_path" "$input"; then
        printf '%s\n' "$staged_path"
        return 0
      fi
    done
  done
  return 1
}

# Fuzzing. An empty index stages nothing that could change the answer, so it is
# `no`.
FUZZ=no
FUZZ_REASON="no staged path is a contract-fuzzing input"
if fuzz_trigger="$(first_staged_input "${FUZZ_INPUTS[@]}")"; then
  FUZZ=yes
  FUZZ_REASON="[$fuzz_trigger] is a contract-fuzzing input"
fi

# The path-gated harnesses, each named once, in table order.
GATED=()
for gated_entry in "${PATH_GATED_HARNESSES[@]}"; do
  gated_name="${gated_entry%%:*}"
  name_in "$gated_name" ${GATED[@]+"${GATED[@]}"} || GATED+=("$gated_name")
done

# The staged path that is one of $1's inputs, printed on stdout; exit 1 when no
# staged path is -- first_staged_input over that harness's rows of the table.
gated_trigger() { # <gated harness>
  local harness="$1" entry inputs=()
  for entry in "${PATH_GATED_HARNESSES[@]}"; do
    if [ "${entry%%:*}" = "$harness" ]; then
      inputs+=("${entry#*:}")
    fi
  done
  first_staged_input ${inputs[@]+"${inputs[@]}"}
}

# SKIPPED_GATED: the gated harnesses this staged set cannot affect, which every
# emitted harness list drops. GATED_REASONS: one line per gated harness for the
# stderr log, so a hook run says which of them ran and what triggered it. An
# empty index skips none (rule 3, stated at the table).
SKIPPED_GATED=()
GATED_REASONS=()
for gated_name in ${GATED[@]+"${GATED[@]}"}; do
  if [ "${#STAGED[@]}" -eq 0 ]; then
    GATED_REASONS+=("$gated_name: runs -- the index is empty, and an empty set is not a narrow one")
  elif trigger="$(gated_trigger "$gated_name")"; then
    GATED_REASONS+=("$gated_name: runs if the scope does -- [$trigger] is one of its inputs")
  else
    SKIPPED_GATED+=("$gated_name")
    GATED_REASONS+=("$gated_name: skipped -- no staged path is one of its inputs")
  fi
done

# <harness...> minus SKIPPED_GATED, space-separated on stdout, order kept.
without_skipped_gated() { # <harness...>
  local harness kept=()
  for harness in "$@"; do
    name_in "$harness" ${SKIPPED_GATED[@]+"${SKIPPED_GATED[@]}"} || kept+=("$harness")
  done
  printf '%s' "${kept[*]+"${kept[*]}"}"
}

# Every scope's harness list passes through here, so no row can forget the
# filter. ALL stays ALL when nothing is skipped -- "whatever bin/shell-tests
# runs" is the stronger answer and keeps a new harness covered with no edit here
# -- and otherwise becomes KNOWN_HARNESSES spelled out minus the skipped ones.
# That explicit list is complete because rule 5 has already held KNOWN_HARNESSES
# to the filesystem, and a stale name in it fails bin/shell-tests' own -n check
# loudly rather than shrinking the run.
filter_gated() { # <harnesses value as a row emits it>
  local harnesses="$1"
  if [ "${#SKIPPED_GATED[@]}" -eq 0 ]; then
    printf '%s' "$harnesses"
  elif [ "$harnesses" = "ALL" ]; then
    without_skipped_gated "${KNOWN_HARNESSES[@]}"
  else
    # Unquoted on purpose: a row's list is space-separated names, and an empty
    # one must become zero arguments.
    # shellcheck disable=SC2086
    without_skipped_gated $harnesses
  fi
}

emit() {
  local scope="$1" gradle="$2" harnesses reason="$4" gated_reason
  harnesses="$(filter_gated "$3")"
  log-info "gate scope: $scope -- $reason"
  log-info "contract fuzzing: $FUZZ -- $FUZZ_REASON"
  for gated_reason in ${GATED_REASONS[@]+"${GATED_REASONS[@]}"}; do
    log-info "path-gated harness $gated_reason"
  done
  echo "scope=$scope"
  echo "gradle=$gradle"
  echo "harnesses=$harnesses"
  echo "fuzz=$FUZZ"
  exit 0
}

# Rule 3: an empty index is `full`, not a vacuous pass. The same answer
# staged_changes_are_product_docs_only gives, for the same reason.
if [ "${#STAGED[@]}" -eq 0 ]; then
  emit full yes ALL "the index is empty, and an empty set is not a narrow one"
fi

# Classify the whole set at once. Each flag stays true only while EVERY path
# qualifies, which is rule 2: a mixed set collapses to `full` because no flag
# survives it.
ALL_MARKDOWN=1
ALL_PRIME=1
ALL_IOS_APP=1
ALL_MODULE_SOURCE=1
for staged_path in ${STAGED[@]+"${STAGED[@]}"}; do
  # Markdown, but NOT inside a module's src/ tree. Those ~10 INVARIANTS.md files
  # live in Kotlin source directories and this script will not guess whether
  # Gradle hashes them as source-set inputs. Excluding them costs nothing --
  # CLAUDE.md retired those files in 2026-08 -- and guessing could cost a silent
  # skip of the whole Gradle half.
  case "$staged_path" in
  *.md)
    # Written as an `if` and not `is_module_source ... && ALL_MARKDOWN=0`. That
    # form is correct under `set -e` -- the failing command is not the one
    # following the final && -- but a reader has to derive that to trust it, and
    # a later edit that appends anything after it would turn a silent exemption
    # into an aborted scan.
    if is_module_source "$staged_path"; then
      ALL_MARKDOWN=0
    fi
    ;;
  *) ALL_MARKDOWN=0 ;;
  esac
  case "$staged_path" in
  .prime/*) ;;
  *) ALL_PRIME=0 ;;
  esac
  case "$staged_path" in
  ios-app/*) ;;
  *) ALL_IOS_APP=0 ;;
  esac
  is_module_source "$staged_path" || ALL_MODULE_SOURCE=0
done

# Order matters only where two rows could both match, and where they can the
# WEAKER claim must win. All-Markdown under .prime/ is markdown-docs, which runs
# fewer harnesses than prime-scripts; that is safe because the Markdown claim is
# about the file's readers, not its directory.

# Scope `markdown-docs`.
#
# EVIDENCE: no harness reads any real .md in this repository. The only mentions
# are three comments (bin/INVARIANTS.md, CLAUDE.md) and one fixture -- 
# bin/ship-scripts-tests writes rfc/999-x.md inside a throwaway repo to assert
# that the product/ predicate rejects rfc/. Markdown's only executable
# consequence here is `deno fmt`, and bin/format -c runs on EVERY path through
# bin/pre-commit, including this one; bin/common's DENO_FMT_PATHS already
# covers **/*.md, .claude and .prime.
#
# The residue, stated rather than glossed: a harness that composed a Markdown
# path from a variable would escape the sweep in bin/gate-scope-scripts-tests.
# None does, the sweep fails the build on any literal one, and a variable one
# would have to be written deliberately.
if [ "$ALL_MARKDOWN" -eq 1 ]; then
  emit markdown-docs no "" "every staged path is Markdown outside a module src/ tree; nothing but deno fmt reads a .md here, and bin/format -c still runs"
fi

# Scope `product-docs` (RFC 194). Its predicate, not a copy of it.
if staged_changes_are_product_docs_only "$REPO"; then
  emit product-docs no "" "every staged path is under product/, which is not a build input at all (RFC 194)"
fi

# Scope `prime-scripts`.
#
# A WEAKER CLAIM THAN RFC 194's, and written as one. product/** is safe because
# it is not a build input AT ALL. .prime/ is not in that class -- it holds
# executable scripts that harnesses run -- so this row is safe not because
# nothing observes .prime/ but because the things that observe it are NAMED AND
# RUN. That is a claim about a list, and a list can go stale, which is what the
# anti-orphan sweep above and the cross-sweep in the harness are for.
if [ "$ALL_PRIME" -eq 1 ]; then
  emit prime-scripts no "$PRIME_HARNESSES" "every staged path is under .prime/; the harnesses that observe .prime/ are named and run, and no Gradle input is touched"
fi

# Scope `ios-app`.
#
# EVIDENCE: of the harnesses bin/shell-tests actually runs, NONE mentions
# ios-app at all -- bin/scripts-tests' only two `ios` hits are the
# HARNESS_EXCLUSIONS name, not a path. ios-app is not a Gradle module
# (settings.gradle.kts does not include it) and no build file references it; the
# only Kotlin mentions anywhere are two COMMENTS in rest-server tests pointing at
# Swift files. It is Swift, an Xcode project and some env files.
#
# bin/ios-scripts-tests DOES read the real ios-app/env/prod*.env files -- and it
# is carved out of bin/shell-tests BY NAME (RFC 114: it drives system Xcode and
# refuses inside the Nix dev shell, which is where the gate runs). So it never
# ran at the gate before this row and does not now. The honest statement of what
# changes for an iOS commit: it stops paying for a Kotlin-and-Postgres gate that
# cannot observe it, and its own coverage -- a human running
# `bin/ios-scripts-tests` outside the dev shell -- is exactly what it was.
if [ "$ALL_IOS_APP" -eq 1 ]; then
  emit ios-app no "" "every staged path is under ios-app/, which is Swift and an Xcode project: not a Gradle module, and mentioned by no harness the gate runs"
fi

# Scope `module-source`.
if [ "$ALL_MODULE_SOURCE" -eq 1 ]; then
  emit module-source yes "$MODULE_SOURCE_HARNESSES" "every staged path is under a Gradle module's src/ tree; Gradle runs in full, scripts-tests runs because it boots the built rest-server and queue-worker, and web-assets-scripts-tests runs because public-web's TypeScript and its committed bundle both live in a module src/ tree"
fi

# Rules 1, 2 and 4 all land here.
#
# Scope `full-gated`: the same fallback with a path-gated harness filtered out.
# It is NOT `full`, because the name is what ship-verified records: a `full`
# marker is the bare tree, "the whole gate passed here", accepted with no
# condition, while any other scope name is recorded against the parent tree and
# accepted at land only on a parent already on the base branch. A filtered full
# is "green if the parent was" for the harnesses it skipped -- a --no-verify WIP
# commit on the branch may have changed a skill script that this commit's staged
# set never shows -- so it must carry that condition. Naming it is the whole fix;
# ship-verified already handles every non-`full` name that way.
if [ "${#SKIPPED_GATED[@]}" -eq 0 ]; then
  emit full yes ALL "the staged set is mixed or contains a path no narrow scope recognises"
fi
emit full-gated yes ALL "the staged set is mixed or contains a path no narrow scope recognises, and a path-gated harness was skipped (${SKIPPED_GATED[*]}), so the pass is conditional on the parent tree"
