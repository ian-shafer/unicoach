#!/usr/bin/env bash
source "$(dirname "$0")/common"

CHECK=false

help() {
  cat << 'EOF'
format [options]

The single formatting avenue for the repo, using the nix-provided tools: ktlint
(Kotlin) and deno fmt (Markdown and the client-side TypeScript of RFC 225), run
concurrently. There is no Gradle ktlint plugin — this script is the only ktlint,
so format and check can never disagree.

Options:
  -c: Check only — report violations and exit non-zero WITHOUT rewriting files.
      This is the pre-commit format gate. Default rewrites in place.
  -h: Help
EOF
  exit 0
}

while getopts ":ch" opt; do
  case "$opt" in
  c) CHECK=true ;;
  h) help ;;
  \?) fatal -s "$EXIT_UNKNOWN_OPTION" "unknown option [-$OPTARG]" ;;
  :)  fatal -s "$EXIT_OPTION_REQUIRES_VALUE" "option [-$OPTARG] requires an argument" ;;
  esac
done
shift $((OPTIND-1))

if [ "$#" -ne 0 ]; then
  fatal -s "$EXIT_UNEXPECTED_ARG" "Error: format accepts no positional arguments."
fi

# Kotlin targets. ktlint's own `**` glob does not descend hidden dirs; none of our
# Kotlin lives under one, so plain globs suffice (unlike the deno paths).
KT_GLOBS=("**/*.kt" "**/*.kts" "!var/**" "!build/**" "!.gradle/**")

if [ "$CHECK" = true ]; then
  log-info "Checking Kotlin, Markdown and TypeScript formatting concurrently..."
  # ktlint with no --format is check-mode: it exits non-zero on any violation.
  ktlint "${KT_GLOBS[@]}" &
  KOTLIN_PID=$!
  deno fmt --check "${DENO_FMT_PATHS[@]}" &
  DENO_PID=$!
else
  log-info "Formatting Kotlin, Markdown and TypeScript code concurrently..."
  ktlint --format "${KT_GLOBS[@]}" &
  KOTLIN_PID=$!
  deno fmt "${DENO_FMT_PATHS[@]}" &
  DENO_PID=$!
fi

# Safely capture exit codes without un-setting set -e
KOTLIN_STATUS=0
DENO_STATUS=0
wait $KOTLIN_PID || KOTLIN_STATUS=$?
wait $DENO_PID || DENO_STATUS=$?

VERB=$([ "$CHECK" = true ] && echo check || echo formatter)
FAILED=0

if [ "$KOTLIN_STATUS" -ne 0 ]; then
  log-error "Kotlin ktlint $VERB failed (Status: $KOTLIN_STATUS)"
  FAILED=1
fi

if [ "$DENO_STATUS" -ne 0 ]; then
  log-error "deno fmt $VERB failed (Status: $DENO_STATUS)"
  FAILED=1
fi

if [ "$FAILED" -ne 0 ]; then
  log-info "Formatting $VERB found problems."
  exit 2
fi

log-info "Formatting $VERB passed."
