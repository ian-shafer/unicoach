#!/usr/bin/env bash
# db-scripts-tests runs against its OWN private, throwaway PostgreSQL cluster
# (private data dir + unique port), NOT the shared cluster. This harness
# deliberately exercises cluster lifecycle — postgres-down, db-drop,
# re-provisioning — so it must never stop or wipe the cluster that other
# worktrees share. The private cluster is torn down and deleted on exit.
set -euo pipefail

THIS_DIR="$(cd "$(dirname "$0")" && pwd)"

# Private env: throwaway data dir, a PID-derived port (dynamic/private range) to
# avoid colliding with the shared cluster or a concurrent run, and a dedicated DB.
# mktemp only creates the final XXXXXX component, so the base must already exist —
# ensure it does (nix sets TMPDIR to a per-shell path that is not always present).
TMP_BASE="${TMPDIR:-/tmp}"
mkdir -p "$TMP_BASE"
PRIVATE_ROOT="$(mktemp -d "$TMP_BASE/unicoach-db-scripts-tests.XXXXXX")"
PRIVATE_ENV="$PRIVATE_ROOT/env"
# POSTGRES_SUPERUSER is the cluster admin (initdb, and the two role/ownership
# bootstraps); POSTGRES_USER is a NON-superuser owner role, exactly as a real
# checkout has since RFC 174 — so this harness exercises the ownership path
# rather than the superuser shortcut every bin/ command used to take. The name is
# a fixed literal because this cluster is private: no other checkout can reach it.
cat > "$PRIVATE_ENV" <<EOF
POSTGRES_SUPERUSER=postgres
POSTGRES_USER=owner-db-scripts-test
POSTGRES_DB=unicoach-db-scripts-test
POSTGRES_HOST_AUTH_METHOD=trust
PGHOST=localhost
POSTGRES_DATA_DIR=$PRIVATE_ROOT/pg
POSTGRES_ADMIN_DB=postgres
POSTGRES_PORT=$(( 49152 + ($$ % 16000) ))
DATABASE_USER=unicoach
DATABASE_PASSWORD=password
EOF

export ENV_FILE="$PRIVATE_ENV"
source "$THIS_DIR/common"
source "$THIS_DIR/tests-common"

# The hook that runs this harness exports GIT_DIR and GIT_INDEX_FILE, and both
# outrank `git -C`. Stripped here for the throwaway `git init` fixture below; it
# escaped once and re-initialised the REAL checkout, rewriting .git/config with
# core.bare=true (which broke `git check-ignore` in every worktree) plus this
# harness's test identity, and failing an unrelated pre-commit test.
#
# The strip itself is bin/functions' strip_git_hook_env: three bin/ files needed
# the same three unsets for the same reason and each carried its own copy and its
# own explanation of it. Nothing above this line runs git.
strip_git_hook_env

# Tear down the PRIVATE cluster and delete its data on exit. Safe — it is ours
# alone (private port + data dir), unrelated to the shared cluster.
trap 'bin/postgres-down >/dev/null 2>&1 || true; rm -rf "$PRIVATE_ROOT" >/dev/null 2>&1 || true' EXIT INT TERM

wait_for_postgres() {
  for i in {1..15}; do
    if psql -U postgres -d "$POSTGRES_DB" -c '\q' >/dev/null 2>&1; then return 0; fi
    sleep 1
  done
  echo "Fail: Timed out waiting for database '$POSTGRES_DB' runtime to become queryable organically."
  exit 1
}

# Bootstrap the private cluster (initdb + role) and provision its database.
bin/db-bootstrap >/dev/null
bin/db-create >/dev/null

# Set up testing table
bin/db-run rw "CREATE TABLE db_scripts_test (id INT PRIMARY KEY, val TEXT);" >/dev/null

test_db_run_ro_blocks_mutation() {
  if bin/db-run ro "INSERT INTO db_scripts_test (id, val) VALUES (1, 'ro');" >/dev/null 2>&1; then
    return 1
  fi
  return 0
}

test_db_run_rw_allows_mutation() {
  bin/db-run rw "INSERT INTO db_scripts_test (id, val) VALUES (2, 'rw');" >/dev/null
}

test_db_query_via_stdin() {
  echo "SELECT * FROM db_scripts_test WHERE id = 2;" | bin/db-query | grep "rw" >/dev/null
}

test_db_query_via_positional() {
  bin/db-query "SELECT * FROM db_scripts_test WHERE id = 2;" | grep "rw" >/dev/null
}

test_db_write_via_stdin() {
  echo "INSERT INTO db_scripts_test (id, val) VALUES (3, 'stdin');" | bin/db-write >/dev/null
  bin/db-query "SELECT val FROM db_scripts_test WHERE id = 3;" | grep "stdin" >/dev/null
}

test_db_write_via_positional() {
  bin/db-write "INSERT INTO db_scripts_test (id, val) VALUES (4, 'positional');" >/dev/null
  bin/db-query "SELECT val FROM db_scripts_test WHERE id = 4;" | grep "positional" >/dev/null
}

test_db_repl_interactive_shell() {
  echo "\q" | bin/db-repl >/dev/null
}

test_psql_error_propagation() {
  bin/db-query "SELECT * FROM non_existent_table;" >/dev/null 2>&1
  local status=$?
  if [ "$status" -eq 0 ] || [ "$status" -eq 2 ]; then
    return 1
  fi
  return 0
}

test_psql_stderr_output() {
  local out
  out=$(bin/db-query "SELECT * FROM non_existent_table;" 2>&1 >/dev/null)
  echo "$out" | grep "relation \"non_existent_table\" does not exist" >/dev/null
}

# -r is the raw (tuples-only, unaligned) shape former -tA callers depend on: a
# single-value query returns the bare value with no header/footer/padding.
test_db_query_raw_is_bare_value() {
  local out
  out=$(bin/db-query -r "SELECT 1;")
  [ "$out" = "1" ]
}

# -x is the expanded record view (reproducing q-inspect's -x -P border=0): the
# column label is present and there is no aligned-header / border-rule output.
test_db_query_expanded_is_record_view() {
  local out
  out=$(bin/db-query -x "SELECT 1 AS only_col;")
  echo "$out" | grep -q "only_col" || return 1
  # bordered/aligned output would draw a header separator rule of dashes; -P
  # border=0 removes it, so a run of '---' must be absent.
  if echo "$out" | grep -q -- "---"; then return 1; fi
  return 0
}

# The former opaque passthrough flag is now an unknown option: it exits 10 and
# produces no query output. This is the control assertion proving the interface
# is bounded — it would have silently reached psql before this RFC.
test_db_query_tA_rejected() {
  local out
  out=$(bin/db-query -tA "SELECT 1;" 2>/dev/null)
  local status=$?
  [ "$status" -eq "$EXIT_UNKNOWN_OPTION" ] && [ -z "$out" ]
}

# A residual psql-style flag after the mode is a post-mode positional beginning
# with '-', rejected as an unexpected argument (20), never forwarded.
test_db_run_residual_flag_rejected() {
  local status=0
  bin/db-run rw "SELECT 1;" --bogus >/dev/null 2>&1 || status=$?
  [ "$status" -eq "$EXIT_UNEXPECTED_ARG" ]
}

# Reordered options (-r before the mode) plus a stdin-piped write round-trip:
# write via db-run rw, then read it back raw.
test_db_run_reorder_roundtrip() {
  bin/db-run rw "INSERT INTO db_scripts_test (id, val) VALUES (5, 'reorder');" >/dev/null
  local out
  out=$(bin/db-run -r ro "SELECT val FROM db_scripts_test WHERE id = 5;")
  [ "$out" = "reorder" ]
}

echo "==== Testing Core Execution & Queries ===="

assert_success "db-run ro blocks mutation" test_db_run_ro_blocks_mutation
assert_success "db-run rw allows mutation" test_db_run_rw_allows_mutation
assert_success "db-query via stdin" test_db_query_via_stdin
assert_success "db-query via positional" test_db_query_via_positional
assert_success "db-write via stdin" test_db_write_via_stdin
assert_success "db-write via positional" test_db_write_via_positional
assert_success "db-repl interactive shell" test_db_repl_interactive_shell
assert_success "psql error propagation" test_psql_error_propagation
assert_success "psql stderr output" test_psql_stderr_output

echo "==== Testing Bounded db Interface ===="

assert_success "db-query -r is raw" test_db_query_raw_is_bare_value
assert_success "db-query -x is expanded" test_db_query_expanded_is_record_view
assert_success "db-query -tA is rejected with code 10" test_db_query_tA_rejected
assert_success "db-run residual flag is rejected with code 20" test_db_run_residual_flag_rejected
assert_success "db-run -r reorder round-trip" test_db_run_reorder_roundtrip

# Band-code mapping: every category pinned to its exact code (10, 11, 20, 21, 22, 23).
assert_exit_code "$EXIT_MISSING_REQUIRED_ARG" "db-run (no mode) exits 21" bin/db-run
assert_exit_code "$EXIT_INVALID_ARG_VALUE" "db-run bogus mode exits 22" bin/db-run bogus
assert_exit_code "$EXIT_EXCLUSIVE_OPTIONS" "db-run -r -x ro exits 23" bin/db-run -r -x ro
assert_exit_code "$EXIT_UNKNOWN_OPTION" "db-run -z ro exits 10" bin/db-run -z ro
assert_exit_code "$EXIT_OPTION_REQUIRES_VALUE" "db-run -d (no value) exits 11" bin/db-run -d
# -U is the option RFC 174 adds, and it takes a value exactly as -d does: a
# valueless -U must land in the same band, not silently connect as POSTGRES_USER.
assert_exit_code "$EXIT_OPTION_REQUIRES_VALUE" "db-run -U (no value) exits 11" bin/db-run -U
assert_exit_code "$EXIT_UNEXPECTED_ARG" "db-query rw extra exits 20" bin/db-query rw extra
assert_exit_code "$EXIT_UNEXPECTED_ARG" "db-repl rejects an unexpected argument" bin/db-repl stray
assert_exit_code "$EXIT_UNEXPECTED_ARG" "db-drop rejects a stray positional" bin/db-drop stray
# db-adopt is the script RFC 174 adds, and it is zero-argument like every other
# operator command: the same three refusals its siblings above are pinned to.
assert_exit_code "$EXIT_UNKNOWN_OPTION" "db-adopt -z exits 10" bin/db-adopt -z
assert_exit_code "$EXIT_UNEXPECTED_ARG" "db-adopt rejects a stray positional" bin/db-adopt stray
assert_success "db-adopt -h exits 0" bin/db-adopt -h

echo "==== Testing Error Handling Validation ===="

test_container_unreachable_exits_2() {
  bin/postgres-down >/dev/null
  bin/db-query "SELECT 1;" >/dev/null 2>&1
  local status=$?
  if [ "$status" -ne 2 ]; then
    return 1
  fi
  return 0
}
assert_success "container unreachable exits 2" test_container_unreachable_exits_2

# The private cluster is still stopped here (test_container_unreachable_exits_2
# ran postgres-down). db-create must perform schema work only and never start a
# cluster: with the cluster down it must fail rather than booting one.
test_db_create_does_not_start_stopped_cluster() {
  if [ -f "$POSTGRES_DATA_DIR/postmaster.pid" ]; then
    fail_test "precondition violated: cluster was running before db-create"
    return 1
  fi
  if bin/db-create >/dev/null 2>&1; then
    fail_test "db-create succeeded against a stopped cluster"
    return 1
  fi
  if [ -f "$POSTGRES_DATA_DIR/postmaster.pid" ]; then
    fail_test "db-create started the cluster (postmaster.pid appeared)"
    return 1
  fi
  return 0
}
assert_success "db-create does not start a stopped cluster" test_db_create_does_not_start_stopped_cluster

echo "==== Testing Database Lifecycle ===="
test_db_lifecycle_wipes_data() {
  # Restart postgres after the unreachable test above
  bin/postgres-up >/dev/null
  wait_for_postgres
  bin/db-create

  # Write dummy data and ensure we can read it
  bin/db-run rw "CREATE TABLE IF NOT EXISTS lifecycle_test (id INT);"
  bin/db-run rw "INSERT INTO lifecycle_test (id) VALUES (42);"

  if ! bin/db-query "SELECT * FROM lifecycle_test;" | grep -q "42"; then
    fail_test "lifecycle_test read failed"
    return 1
  fi

  # Drop the database
  bin/db-drop -y

  # Ensure the dropped database is gone / data destroyed
  if bin/db-query "SELECT * FROM lifecycle_test;" 2>/dev/null; then
    fail_test "db-query erroneously succeeded after db-drop"
    return 1
  fi

  # Recreate it
  bin/db-create

  if bin/db-query "SELECT * FROM schema_migrations limit 1;" 2>&1 | grep -q "relation.*schema_migrations.*does not exist"; then
    fail_test "db-create failed to recreate schema_migrations table"
    return 1
  fi
  pass_test "db-drop and db-create completed successfully"
}
test_db_lifecycle_wipes_data

test_db_provisioning_idempotent() {
  bin/db-drop -y
  bin/db-create

  # Re-running bootstrap and create must both exit 0 with no errors.
  if ! out=$(bin/db-bootstrap 2>&1); then
    fail_test "db-bootstrap failed on re-run: $out"
    return 1
  fi
  if ! out=$(bin/db-create 2>&1); then
    fail_test "db-create failed on re-run: $out"
    return 1
  fi
  pass_test "db-bootstrap and db-create are idempotent"
}
test_db_provisioning_idempotent

test_db_status_formats() {
  bin/db-drop -y
  bin/db-create

  export DB_SCHEMA_DIR="/tmp/test_migrations_status_$$"
  rm -rf "$DB_SCHEMA_DIR"
  mkdir -p "$DB_SCHEMA_DIR"
  # A migration is a FILE PLUS ITS LINE IN ORDER (RFC 180) — db-status and
  # db-migrate both refuse a *.sql that ORDER does not name.
  echo "CREATE TABLE s1 (id INT);" > "$DB_SCHEMA_DIR/0001.s1.sql"
  echo "0001.s1.sql" > "$DB_SCHEMA_DIR/ORDER"

  # Forward migration (applies 0001.s1.sql)
  bin/db-migrate

  # Creates another schema file
  echo "CREATE TABLE s2 (id INT);" > "$DB_SCHEMA_DIR/0002.s2.sql"
  echo "0002.s2.sql" >> "$DB_SCHEMA_DIR/ORDER"

  # Test that -f applied-only only outputs a single, correct line
  applied_out=$(bin/db-status -f applied-only)
  if [ "$applied_out" != "0001.s1.sql" ]; then
    fail_test "db-status -f applied-only did not output expected single line. Got: $applied_out"
    return 1
  fi

  # Test that -f unapplied-only only outputs a single, correct line
  unapplied_out=$(bin/db-status -f unapplied-only)
  if [ "$unapplied_out" != "0002.s2.sql" ]; then
    fail_test "db-status -f unapplied-only did not output expected single line. Got: $unapplied_out"
    return 1
  fi

  pass_test "db-status format option correctly filters migration states"
  rm -rf "$DB_SCHEMA_DIR"
  unset DB_SCHEMA_DIR
}
test_db_status_formats

echo "==== Testing Dump & Restore ===="
# All scratch artifacts live under PRIVATE_ROOT, so the EXIT trap removes them.
DUMP_DIR="$PRIVATE_ROOT/dumps"

# The shape both the dump/restore and the migration sections need: an empty
# database and an empty migration directory to drive it from. Written once, and
# defined here because the dump section runs first; setup_migration_test calls it
# too.
reset_database_with_schema_dir() {
  bin/db-drop -y >/dev/null 2>&1 || true
  bin/db-create >/dev/null
  export DB_SCHEMA_DIR="$1"
  rm -rf "$DB_SCHEMA_DIR"
  mkdir -p "$DB_SCHEMA_DIR"
}

# A migration in a scratch corpus is a FILE PLUS ITS LINE IN db/schema/ORDER
# (RFC 180): apply order is declared, not globbed, and a *.sql that ORDER does
# not name is a refusal. Writing both here keeps every fixture below honest and
# leaves the ORDER-vs-disk disagreements to the tests that assert them.
add_migration() {
  local base="$1" sql="$2"
  printf '%s\n' "$sql" > "$DB_SCHEMA_DIR/$base"
  printf '%s\n' "$base" >> "$DB_SCHEMA_DIR/ORDER"
}

setup_dump_restore_test() {
  mkdir -p "$DUMP_DIR"
  rm -f "$DUMP_DIR"/*.dump
  reset_database_with_schema_dir "$PRIVATE_ROOT/dump_schema"
  add_migration "0001.dump-test.sql" "CREATE TABLE dump_rows (id INT PRIMARY KEY, val TEXT);"
  bin/db-migrate >/dev/null
  bin/db-run rw "INSERT INTO dump_rows (id, val) VALUES (1, 'kept');" >/dev/null
}

teardown_dump_restore_test() {
  rm -rf "$DB_SCHEMA_DIR"
  unset DB_SCHEMA_DIR
}

# The marker row setup_dump_restore_test plants. Its survival — or its return
# after a restore — is what every case in this section actually asserts, so the
# query lives in one place.
dump_marker_row_present() {
  bin/db-run -r ro "SELECT val FROM dump_rows WHERE id = 1;" 2>/dev/null | grep -q "kept"
}

test_db_dump_restore_round_trip() {
  setup_dump_restore_test
  bin/db-dump -o "$DUMP_DIR/round-trip.dump" >/dev/null 2>&1
  if [ ! -s "$DUMP_DIR/round-trip.dump" ]; then
    fail_test "db-dump produced no artifact"
    return 1
  fi
  bin/db-drop -y >/dev/null
  bin/db-restore -y "$DUMP_DIR/round-trip.dump" >/dev/null 2>&1
  if ! dump_marker_row_present; then
    fail_test "restored database is missing the dumped row"
    return 1
  fi
  return 0
}

# Restoring over a POPULATED database must replace it, not merge into it: the row
# inserted after the dump was taken has to be gone afterwards.
test_db_restore_replaces_rather_than_merges() {
  setup_dump_restore_test
  bin/db-dump -o "$DUMP_DIR/replace.dump" >/dev/null 2>&1
  bin/db-run rw "INSERT INTO dump_rows (id, val) VALUES (2, 'after-dump');" >/dev/null
  bin/db-run rw "CREATE TABLE only_after_dump (id INT);" >/dev/null
  bin/db-restore -y "$DUMP_DIR/replace.dump" >/dev/null 2>&1

  if bin/db-run -r ro "SELECT val FROM dump_rows;" | grep -q "after-dump"; then
    fail_test "db-restore merged: the post-dump row survived"
    return 1
  fi
  if ! bin/db-run -r ro "SELECT val FROM dump_rows;" | grep -q "kept"; then
    fail_test "db-restore lost the dumped row"
    return 1
  fi
  if bin/db-run ro "SELECT * FROM only_after_dump;" >/dev/null 2>&1; then
    fail_test "db-restore merged: the post-dump table survived"
    return 1
  fi
  return 0
}

# The dump carries schema_migrations, so a restored database is fully migrated
# without db-restore ever running db-migrate.
test_db_restore_restores_schema_migrations() {
  setup_dump_restore_test
  bin/db-dump -o "$DUMP_DIR/migrations.dump" >/dev/null 2>&1
  bin/db-restore -y "$DUMP_DIR/migrations.dump" >/dev/null 2>&1

  applied_out=$(bin/db-status -f applied-only)
  if [ "$applied_out" != "0001.dump-test.sql" ]; then
    fail_test "restored schema_migrations wrong. Got: $applied_out"
    return 1
  fi
  unapplied_out=$(bin/db-status -f unapplied-only)
  if [ -n "$unapplied_out" ]; then
    fail_test "db-status reports pending migrations after a restore. Got: $unapplied_out"
    return 1
  fi
  return 0
}

# MECHANISM ONLY — this is NOT a recommended workflow, and the help texts do not
# advertise it. Both ends resolve the same POSTGRES_DB, so in real use it would
# drop a live database to restore it from itself; the shipped stream form sends
# the dump to ANOTHER MACHINE over ssh. What is asserted here is the mechanism
# the cross-machine form relies on: stdout and stdin compose, and db-restore
# drains and validates the whole stream before it drops anything. It is kept as
# the one same-checkout pipe case because it is also the most hostile one.
test_db_dump_restore_pipe() {
  setup_dump_restore_test
  bin/db-dump 2>/dev/null | bin/db-restore -y >/dev/null 2>&1
  if ! dump_marker_row_present; then
    fail_test "piped dump | restore lost the row"
    return 1
  fi
  return 0
}

# stdout carries the archive alone; every log line goes to stderr. A single
# stray log-info on stdout would corrupt the artifact.
test_db_dump_logs_to_stderr_only() {
  setup_dump_restore_test
  bin/db-dump > "$DUMP_DIR/stdout.dump" 2> "$DUMP_DIR/stdout.err"
  if ! head -c 5 "$DUMP_DIR/stdout.dump" | grep -q "PGDMP"; then
    fail_test "db-dump stdout is not a pg_dump custom archive (log output leaked?)"
    return 1
  fi
  if ! grep -q "Dumping database" "$DUMP_DIR/stdout.err"; then
    fail_test "db-dump did not log to stderr"
    return 1
  fi
  return 0
}

# db-restore calls db-drop -y internally, disarming the only confirmation in the
# chain, so it must prompt for itself. With stdin at EOF the prompt is refused
# and the database is left untouched.
test_db_restore_without_y_prompts() {
  setup_dump_restore_test
  bin/db-dump -o "$DUMP_DIR/prompt.dump" >/dev/null 2>&1
  if bin/db-restore "$DUMP_DIR/prompt.dump" > /dev/null 2> "$DUMP_DIR/prompt.err" < /dev/null; then
    fail_test "db-restore without -y succeeded with no confirmation"
    return 1
  fi
  if ! grep -q "Destructive action" "$DUMP_DIR/prompt.err"; then
    fail_test "db-restore without -y did not prompt"
    return 1
  fi
  if ! dump_marker_row_present; then
    fail_test "db-restore destroyed data despite an unconfirmed prompt"
    return 1
  fi
  return 0
}

# Operational failures live in 1-9 and are distinct per reason (bin/INVARIANTS.md).
test_db_dump_refuses_to_overwrite() {
  setup_dump_restore_test
  bin/db-dump -o "$DUMP_DIR/exists.dump" >/dev/null 2>&1
  local status=0
  bin/db-dump -o "$DUMP_DIR/exists.dump" >/dev/null 2>&1 || status=$?
  if [ "$status" -ne 3 ]; then
    fail_test "db-dump over an existing target expected exit 3, got $status"
    return 1
  fi
  if ! bin/db-dump -f -o "$DUMP_DIR/exists.dump" >/dev/null 2>&1; then
    fail_test "db-dump -f did not overwrite an existing target"
    return 1
  fi
  return 0
}

test_db_dump_missing_database_exits_4() {
  setup_dump_restore_test
  bin/db-drop -y >/dev/null
  local status=0
  bin/db-dump -o "$DUMP_DIR/missing-db.dump" >/dev/null 2>&1 || status=$?
  bin/db-create >/dev/null
  if [ "$status" -ne 4 ]; then
    fail_test "db-dump against a missing database expected exit 4, got $status"
    return 1
  fi
  return 0
}

# db-dump attaches to a running cluster and never provisions one, so a stopped
# cluster is exit 2 — the repo-wide "postgres unreachable" code (bin/db-run).
test_db_dump_stopped_cluster_exits_2() {
  bin/postgres-down >/dev/null
  local status=0
  bin/db-dump -o "$DUMP_DIR/offline.dump" >/dev/null 2>&1 || status=$?
  if [ -f "$POSTGRES_DATA_DIR/postmaster.pid" ]; then
    fail_test "db-dump started the cluster (postmaster.pid appeared)"
    return 1
  fi
  bin/postgres-up >/dev/null
  wait_for_postgres
  if [ "$status" -ne 2 ]; then
    fail_test "db-dump against a stopped cluster expected exit 2, got $status"
    return 1
  fi
  return 0
}

test_db_restore_missing_file_exits_3() {
  local status=0
  bin/db-restore -y "$DUMP_DIR/does-not-exist.dump" >/dev/null 2>&1 || status=$?
  if [ "$status" -ne 3 ]; then
    fail_test "db-restore with a missing input file expected exit 3, got $status"
    return 1
  fi
  return 0
}

test_db_restore_empty_stdin_exits_4() {
  local status=0
  bin/db-restore -y < /dev/null >/dev/null 2>&1 || status=$?
  if [ "$status" -ne 4 ]; then
    fail_test "db-restore with an empty stdin stream expected exit 4, got $status"
    return 1
  fi
  return 0
}

# A piped restore has the archive on stdin, so the confirmation has to come from
# the terminal — and with no terminal it is a refusal, never a silent destroy.
# UNICOACH_TTY_DEVICE points the script at a path that does not exist, which is
# the only way to reach this branch from a harness that has a real /dev/tty.
test_db_restore_piped_without_y_refuses() {
  setup_dump_restore_test
  local status=0
  bin/db-dump 2>/dev/null \
    | env UNICOACH_TTY_DEVICE="$PRIVATE_ROOT/no-such-tty" bin/db-restore >/dev/null 2>&1 \
    || status=$?
  if [ "$status" -ne 6 ]; then
    fail_test "piped db-restore without -y and without a terminal expected exit 6, got $status"
    return 1
  fi
  if ! dump_marker_row_present; then
    fail_test "db-restore destroyed data despite refusing to confirm"
    return 1
  fi
  return 0
}

# THE DATA-LOSS CASE. Only emptiness used to be checked, and only on the stdin
# path, so a truncated artifact or a plain-SQL file — the natural mistake, since
# -Fc is not human-readable — was discovered only AFTER the target was dropped.
# The database must SURVIVE, with its rows, and the exit must be 7.
test_db_restore_rejects_non_archive_without_dropping() {
  setup_dump_restore_test
  local status=0
  printf 'CREATE TABLE not_an_archive (id INT);\n' > "$DUMP_DIR/plain.sql"
  bin/db-restore -y "$DUMP_DIR/plain.sql" >/dev/null 2>&1 || status=$?
  if [ "$status" -ne 7 ]; then
    fail_test "db-restore of a non-archive expected exit 7, got $status"
    return 1
  fi
  if ! dump_marker_row_present; then
    fail_test "db-restore DESTROYED the database while refusing a non-archive input"
    return 1
  fi
  return 0
}

# THE OTHER HALF OF THE DATA-LOSS CASE, and the one no gate before the drop can
# catch: an archive that IS a readable custom-format archive but cannot be
# restored (a truncated transfer — its table of contents lives at the front, so
# `pg_restore --list` still succeeds). pg_restore CONTINUES PAST ERRORS by
# default, which would leave a PARTLY restored database: schema_migrations can
# come back while a table does not, and bin/db-status would then report a fully
# migrated database over a broken schema. --single-transaction makes it
# all-or-nothing, so the outcome here must be exit 5 and an EMPTY database — not
# a plausible-looking half.
test_db_restore_rolls_back_a_failing_restore() {
  setup_dump_restore_test
  # Enough bulk for the DATA section to dominate the archive: the table of
  # contents lives at the front, so a two-row dump truncated at 2/3 loses its
  # TOC and is refused by the exit-7 gate instead of failing mid-restore.
  bin/db-run rw "CREATE TABLE bulk_rows AS SELECT g AS id, repeat('x', 200) AS val FROM generate_series(1, 5000) g;" >/dev/null
  bin/db-dump -o "$DUMP_DIR/rollback.dump" >/dev/null 2>&1
  local size status=0 listable=0 leftover
  size="$(wc -c < "$DUMP_DIR/rollback.dump" | tr -d '[:space:]')"
  head -c $(( size * 2 / 3 )) "$DUMP_DIR/rollback.dump" > "$DUMP_DIR/truncated.dump"
  # The precondition IS the point of the case: if the truncated file no longer
  # lists, the exit-7 gate would refuse it and this test would prove nothing.
  pg_restore --list "$DUMP_DIR/truncated.dump" >/dev/null 2>&1 || listable=$?
  if [ "$listable" -ne 0 ]; then
    fail_test "precondition: the truncated archive is not listable, so the restore-failure path is unreachable"
    return 1
  fi
  bin/db-restore -y "$DUMP_DIR/truncated.dump" >/dev/null 2>&1 || status=$?
  if [ "$status" -ne 5 ]; then
    fail_test "a failing db-restore expected exit 5, got $status"
    return 1
  fi
  # EMPTY, not partial: the dumped table must not exist at all.
  leftover="$(bin/db-run -r ro "SELECT to_regclass('public.dump_rows') IS NULL" 2>/dev/null | tr -d '[:space:]')"
  if [ "$leftover" != "t" ]; then
    fail_test "a failed db-restore left objects behind (to_regclass IS NULL returned [$leftover]); the restore was not rolled back"
    return 1
  fi
  # …and a GOOD archive still restores fully over that empty database.
  bin/db-restore -y "$DUMP_DIR/rollback.dump" >/dev/null 2>&1
  if ! dump_marker_row_present; then
    fail_test "a good archive did not restore after the rolled-back one"
    return 1
  fi
  return 0
}

# An EMPTY path argument named a file — it is the shape `bin/db-restore "$DUMP"`
# takes when DUMP is unset. It must be refused as a missing file (exit 3), never
# read as "no argument given" and turned into a STDIN restore of the live dev
# database.
test_db_restore_empty_argument_exits_3() {
  setup_dump_restore_test
  local status=0
  bin/db-restore -y "" < /dev/null >/dev/null 2>&1 || status=$?
  if [ "$status" -ne 3 ]; then
    fail_test "db-restore with an empty path argument expected exit 3, got $status"
    return 1
  fi
  if ! dump_marker_row_present; then
    fail_test "db-restore with an empty path argument DESTROYED the database"
    return 1
  fi
  return 0
}

# The migration this pair exists for reads a database NO checkout points at, and
# `POSTGRES_DB=other bin/db-dump` cannot express it — bin/common layers the
# dotenvs over the caller's environment. -d is that expression, and it is
# read-only: the ambient POSTGRES_DB must be untouched afterwards.
test_db_dump_other_database_with_d() {
  setup_dump_restore_test
  psql -U "$POSTGRES_USER" -d "${POSTGRES_ADMIN_DB:-postgres}" \
    -c 'DROP DATABASE IF EXISTS "unicoach-dump-other"' >/dev/null 2>&1
  psql -U "$POSTGRES_USER" -d "${POSTGRES_ADMIN_DB:-postgres}" \
    -c 'CREATE DATABASE "unicoach-dump-other"' >/dev/null
  psql -U "$POSTGRES_USER" -d "unicoach-dump-other" \
    -c 'CREATE TABLE only_in_other (id INT)' >/dev/null
  bin/db-dump -d "unicoach-dump-other" -o "$DUMP_DIR/other.dump" >/dev/null 2>&1
  local ok=0
  if ! pg_restore --list "$DUMP_DIR/other.dump" | grep -q "only_in_other"; then
    fail_test "db-dump -d did not dump the named database"
    ok=1
  fi
  if pg_restore --list "$DUMP_DIR/other.dump" | grep -q "dump_rows"; then
    fail_test "db-dump -d dumped POSTGRES_DB instead of the named database"
    ok=1
  fi
  if ! dump_marker_row_present; then
    fail_test "db-dump -d disturbed POSTGRES_DB"
    ok=1
  fi
  psql -U "$POSTGRES_USER" -d "${POSTGRES_ADMIN_DB:-postgres}" \
    -c 'DROP DATABASE IF EXISTS "unicoach-dump-other"' >/dev/null 2>&1
  return "$ok"
}

# `pg_dump -f` TRUNCATES its target in place, so a dump that fails half-way used
# to leave a PARTIAL archive under the name an operator trusts — and the operator
# would then restore it. The dump is written to a temporary sibling and moved in
# only on success. Forced with a failing `pg_dump` first on PATH, because there
# is no reliable way to make the real one fail after the existence probe passes.
test_db_dump_failure_leaves_the_target_intact() {
  setup_dump_restore_test
  bin/db-dump -o "$DUMP_DIR/good.dump" >/dev/null 2>&1
  local before after status=0 stub_dir
  before="$(shasum "$DUMP_DIR/good.dump" | cut -d' ' -f1)"
  stub_dir="$PRIVATE_ROOT/failing-pg_dump"
  mkdir -p "$stub_dir"
  printf '#!/usr/bin/env bash\nexit 1\n' > "$stub_dir/pg_dump"
  chmod +x "$stub_dir/pg_dump"
  PATH="$stub_dir:$PATH" bin/db-dump -f -o "$DUMP_DIR/good.dump" >/dev/null 2>&1 || status=$?
  after="$(shasum "$DUMP_DIR/good.dump" | cut -d' ' -f1)"
  rm -rf "$stub_dir"
  if [ "$status" -ne 5 ]; then
    fail_test "a failing pg_dump expected exit 5, got $status"
    return 1
  fi
  if [ "$before" != "$after" ]; then
    fail_test "a failed db-dump overwrote the existing -o target with a partial archive"
    return 1
  fi
  if compgen -G "$DUMP_DIR/.unicoach-db-dump.*" > /dev/null; then
    fail_test "a failed db-dump left its temporary sibling behind"
    return 1
  fi
  return 0
}

# --- The conventional artifact directory (POSTGRES_DUMP_DIR) ---------------
# This harness's private env deliberately does NOT set POSTGRES_DUMP_DIR, so
# every case below either sets it explicitly or proves the UNSET behaviour.
DEFAULT_DUMP_DIR="$PRIVATE_ROOT/default-dumps"

# db-restore's no-argument default is reachable ONLY when stdin is a TERMINAL —
# without one, no argument means "the dump is on stdin" and that must not
# change. A harness has no terminal, so one is synthesised with `script`, which
# runs the command under a pty and propagates its exit status. Output is
# COMBINED (the pty carries stdout and stderr together), which is fine here:
# every assertion below looks for a message, and db-restore writes no stdout.
run_with_terminal_stdin() {
  script -q /dev/null "$@" < /dev/null 2>&1
}

# The discoverability fix: no argument, a terminal, and $POSTGRES_DUMP_DIR/dev.dump
# present restores that file — the operator no longer types a 45-character path
# in every worktree. The unconfirmed run first proves the implicit input is SHOWN
# before anything is destroyed: the prompt has to name the database AND the
# source, since neither was typed on the command line.
test_db_restore_defaults_to_the_dump_dir_artifact() {
  setup_dump_restore_test
  rm -rf "$DEFAULT_DUMP_DIR"
  bin/db-dump -o "$DEFAULT_DUMP_DIR/dev.dump" >/dev/null 2>&1
  local out status=0
  out="$(POSTGRES_DUMP_DIR="$DEFAULT_DUMP_DIR" run_with_terminal_stdin bin/db-restore)" || status=$?
  if [ "$status" -eq 0 ]; then
    fail_test "db-restore with no argument and no -y succeeded without a confirmation"
    return 1
  fi
  if ! echo "$out" | grep -q "$POSTGRES_DB"; then
    fail_test "the confirmation for an implicit input did not name the database. Got: $out"
    return 1
  fi
  if ! echo "$out" | grep -q "$DEFAULT_DUMP_DIR/dev.dump"; then
    fail_test "the confirmation for an implicit input did not name the source file. Got: $out"
    return 1
  fi
  # …and with -y it actually restores that artifact.
  bin/db-drop -y >/dev/null
  status=0
  POSTGRES_DUMP_DIR="$DEFAULT_DUMP_DIR" run_with_terminal_stdin bin/db-restore -y >/dev/null || status=$?
  if [ "$status" -ne 0 ]; then
    fail_test "db-restore with no argument did not restore \$POSTGRES_DUMP_DIR/dev.dump (exit $status)"
    return 1
  fi
  if ! dump_marker_row_present; then
    fail_test "the default-artifact restore did not bring the row back"
    return 1
  fi
  return 0
}

# Still exit 4 when the default is absent — but the message must NAME the path it
# looked for. "no file was named" alone is what sent the operator hunting for a
# convention that lived only in prose.
test_db_restore_missing_default_names_the_path() {
  setup_dump_restore_test
  local empty_dir="$PRIVATE_ROOT/empty-dumps" out status=0
  rm -rf "$empty_dir"
  mkdir -p "$empty_dir"
  out="$(POSTGRES_DUMP_DIR="$empty_dir" run_with_terminal_stdin bin/db-restore -y)" || status=$?
  if [ "$status" -ne 4 ]; then
    fail_test "db-restore with no argument and no default artifact expected exit 4, got $status"
    return 1
  fi
  if ! echo "$out" | grep -q "$empty_dir/dev.dump"; then
    fail_test "the exit-4 message did not name the path it looked for. Got: $out"
    return 1
  fi
  if ! dump_marker_row_present; then
    fail_test "db-restore destroyed the database while reporting no input"
    return 1
  fi
  return 0
}

# THE GUARD. With POSTGRES_DUMP_DIR unset the default would concatenate to the
# literal "/dev.dump" — a path in the filesystem ROOT that no operator named and
# that could belong to anyone. Unset must keep the old refusal instead of
# inventing a target: exit 4, and "/dev.dump" must not appear anywhere in the
# message.
test_db_restore_unset_dump_dir_never_uses_root_dev_dump() {
  setup_dump_restore_test
  local out status=0
  out="$(env -u POSTGRES_DUMP_DIR bash -c 'script -q /dev/null bin/db-restore -y < /dev/null 2>&1')" || status=$?
  if [ "$status" -ne 4 ]; then
    fail_test "db-restore with POSTGRES_DUMP_DIR unset expected exit 4, got $status"
    return 1
  fi
  if echo "$out" | grep -q "/dev\.dump"; then
    fail_test "db-restore with POSTGRES_DUMP_DIR unset referred to a /dev.dump path. Got: $out"
    return 1
  fi
  if ! dump_marker_row_present; then
    fail_test "db-restore with POSTGRES_DUMP_DIR unset destroyed the database"
    return 1
  fi
  return 0
}

# The first dump on a fresh machine names a directory that does not exist yet
# ($POSTGRES_DUMP_DIR is outside the repo and nothing creates it). It must be
# created, not reported as a temp-file failure.
test_db_dump_creates_a_missing_output_directory() {
  setup_dump_restore_test
  local fresh="$PRIVATE_ROOT/not-yet/created/dumps"
  rm -rf "$PRIVATE_ROOT/not-yet"
  if ! bin/db-dump -o "$fresh/dev.dump" >/dev/null 2>&1; then
    fail_test "db-dump failed to write into a not-yet-existing directory"
    return 1
  fi
  if [ ! -s "$fresh/dev.dump" ]; then
    fail_test "db-dump created no archive under the new directory"
    return 1
  fi
  if ! head -c 5 "$fresh/dev.dump" | grep -q "PGDMP"; then
    fail_test "the archive written into the new directory is not a pg_dump custom archive"
    return 1
  fi
  return 0
}

# ABSENCE is only half of "there is nowhere to write". A dump directory that
# EXISTS but refuses a new file used to fail inside mktemp — exit 1, which help()
# does not document, in a message naming neither db-dump nor -o nor
# POSTGRES_DUMP_DIR. It must be the documented exit 6, said in words.
test_db_dump_unwritable_output_directory_exits_6() {
  setup_dump_restore_test
  local readonly_dir="$PRIVATE_ROOT/readonly-dumps" out status=0
  rm -rf "$readonly_dir"
  mkdir -p "$readonly_dir"
  # root ignores the mode bits, so the refusal could not fire and the assertion
  # would be about the test runner rather than the script.
  if [ "$(id -u)" -eq 0 ]; then
    rm -rf "$readonly_dir"
    return 0
  fi
  chmod 500 "$readonly_dir"
  out="$(bin/db-dump -o "$readonly_dir/dev.dump" 2>&1)" || status=$?
  chmod 700 "$readonly_dir"
  rm -rf "$readonly_dir"
  if [ "$status" -ne 6 ]; then
    fail_test "db-dump into an unwritable directory expected exit 6, got $status. Got: $out"
    return 1
  fi
  if ! echo "$out" | grep -q "db-dump"; then
    fail_test "the exit-6 message did not name the script. Got: $out"
    return 1
  fi
  if ! echo "$out" | grep -q "$readonly_dir"; then
    fail_test "the exit-6 message did not name the directory. Got: $out"
    return 1
  fi
  return 0
}

# THE SYMMETRY. -o "$POSTGRES_DUMP_DIR/dev.dump" cannot work from a caller's
# shell — the key is a dotenv value only a script sourcing bin/common can see —
# so -D resolves it INSIDE db-dump, onto the same filename db-restore reads.
test_db_dump_D_writes_the_conventional_artifact() {
  setup_dump_restore_test
  local target="$PRIVATE_ROOT/dashd-dumps"
  rm -rf "$target"
  if ! POSTGRES_DUMP_DIR="$target" bin/db-dump -D >/dev/null 2>&1; then
    fail_test "db-dump -D failed"
    return 1
  fi
  if [ ! -s "$target/dev.dump" ]; then
    fail_test "db-dump -D did not write \$POSTGRES_DUMP_DIR/dev.dump"
    return 1
  fi
  if ! head -c 5 "$target/dev.dump" | grep -q "PGDMP"; then
    fail_test "db-dump -D wrote something that is not a pg_dump custom archive"
    return 1
  fi
  # …and db-restore with no argument reads exactly that file, which is the whole
  # point of the pair sharing one filename constant.
  bin/db-drop -y >/dev/null 2>&1
  local status=0
  POSTGRES_DUMP_DIR="$target" run_with_terminal_stdin bin/db-restore -y >/dev/null || status=$?
  if [ "$status" -ne 0 ]; then
    fail_test "db-restore with no argument did not read what db-dump -D wrote (exit $status)"
    return 1
  fi
  if ! dump_marker_row_present; then
    fail_test "the -D round trip did not bring the row back"
    return 1
  fi
  return 0
}

# -D with no usable POSTGRES_DUMP_DIR is a bad value for an option the caller DID
# give (22), never a silent write to the filesystem root. "/" is set and passes a
# bare -z check, so it is asserted next to the unset case.
test_db_dump_D_without_a_usable_dump_dir_exits_22() {
  setup_dump_restore_test
  local out status=0
  out="$(env -u POSTGRES_DUMP_DIR bin/db-dump -D 2>&1)" || status=$?
  if [ "$status" -ne 22 ]; then
    fail_test "db-dump -D with POSTGRES_DUMP_DIR unset expected exit 22, got $status. Got: $out"
    return 1
  fi
  if [ -e /dev.dump ]; then
    fail_test "db-dump -D with POSTGRES_DUMP_DIR unset wrote /dev.dump"
    return 1
  fi
  status=0
  out="$(POSTGRES_DUMP_DIR=/ bin/db-dump -D 2>&1)" || status=$?
  if [ "$status" -ne 22 ]; then
    fail_test "db-dump -D with POSTGRES_DUMP_DIR=/ expected exit 22, got $status. Got: $out"
    return 1
  fi
  status=0
  out="$(POSTGRES_DUMP_DIR= bin/db-dump -D 2>&1)" || status=$?
  if [ "$status" -ne 22 ]; then
    fail_test "db-dump -D with an empty POSTGRES_DUMP_DIR expected exit 22, got $status. Got: $out"
    return 1
  fi
  return 0
}

# The other half of the same shape check: POSTGRES_DUMP_DIR=/ used to PASS
# db-restore's guard and yield "//dev.dump" — the filesystem-root path the guard
# exists to forbid. It failed safe only because that file does not exist.
test_db_restore_malformed_dump_dir_is_refused() {
  setup_dump_restore_test
  local out status=0
  out="$(POSTGRES_DUMP_DIR=/ run_with_terminal_stdin bin/db-restore -y)" || status=$?
  if [ "$status" -ne 4 ]; then
    fail_test "db-restore with POSTGRES_DUMP_DIR=/ expected exit 4, got $status. Got: $out"
    return 1
  fi
  if echo "$out" | grep -q "//dev\.dump"; then
    fail_test "db-restore with POSTGRES_DUMP_DIR=/ still built a root dump path. Got: $out"
    return 1
  fi
  status=0
  out="$(POSTGRES_DUMP_DIR= run_with_terminal_stdin bin/db-restore -y)" || status=$?
  if [ "$status" -ne 4 ]; then
    fail_test "db-restore with an empty POSTGRES_DUMP_DIR expected exit 4, got $status. Got: $out"
    return 1
  fi
  # An EMPTY value is malformed, not missing: the message must not claim the key
  # is unset.
  if echo "$out" | grep -q "is not set"; then
    fail_test "db-restore called a set-but-empty POSTGRES_DUMP_DIR 'not set'. Got: $out"
    return 1
  fi
  if ! dump_marker_row_present; then
    fail_test "db-restore destroyed the database while refusing a malformed POSTGRES_DUMP_DIR"
    return 1
  fi
  return 0
}

# db-restore deliberately does not run migrations, so a dump taken before a newer
# migration leaves this checkout quietly behind. The success log must state the
# level it landed at and name bin/db-migrate as the remedy — without running it.
# The probe asks "what did this database land at", and the answer is the LAST
# APPLIED migration — `applied_at DESC`, never a filename sort (RFC 180 D4). One
# migration cannot tell the two apart, so the fixture applies a SECOND one whose
# filename sorts EARLIER: `0000.applied-second.sql` is applied last, so
# applied_at DESC names it and any filename ordering names 0001.dump-test.sql.
# The two assertions below therefore disagree under the wrong ORDER BY.
test_db_restore_success_log_names_the_migration_level() {
  setup_dump_restore_test
  add_migration "0000.applied-second.sql" "CREATE TABLE level_probe_second (id INT);"
  bin/db-migrate >/dev/null 2>&1
  bin/db-dump -o "$DUMP_DIR/level.dump" >/dev/null 2>&1
  local err="$DUMP_DIR/level.err"
  bin/db-restore -y "$DUMP_DIR/level.dump" >/dev/null 2> "$err"
  if ! grep -q "migration level \[0000.applied-second.sql\]" "$err"; then
    fail_test "the success log did not name the LAST APPLIED migration. Got: $(cat "$err")"
    return 1
  fi
  if grep -q "migration level \[0001.dump-test.sql\]" "$err"; then
    fail_test "the level probe ordered by filename, not applied_at. Got: $(cat "$err")"
    return 1
  fi
  if ! grep -q "bin/db-migrate" "$err"; then
    fail_test "the success log did not name bin/db-migrate as the remedy. Got: $(cat "$err")"
    return 1
  fi
  return 0
}

# `applied_at` is NULLABLE (bin/db-create sets only a DEFAULT), and in PostgreSQL
# `DESC` is NULLS FIRST — so a single unstamped row sorts ahead of every real one
# and gets reported as the level. Such a row is ordinary: a hand-repaired
# tracking table, or a database restored from a dump older than the DEFAULT. The
# probe must name the last STAMPED migration, and this case fails under the plain
# `applied_at DESC` ordering.
test_db_restore_level_probe_ignores_a_null_applied_at() {
  setup_dump_restore_test
  bin/db-write "INSERT INTO schema_migrations (filename, applied_at) VALUES ('0002.null-stamp.sql', NULL);" >/dev/null
  bin/db-dump -o "$DUMP_DIR/nullstamp.dump" >/dev/null 2>&1
  local err="$DUMP_DIR/nullstamp.err"
  bin/db-restore -y "$DUMP_DIR/nullstamp.dump" >/dev/null 2> "$err"
  if grep -q "migration level \[0002.null-stamp.sql\]" "$err"; then
    fail_test "the level probe reported the row with a NULL applied_at (DESC is NULLS FIRST). Got: $(cat "$err")"
    return 1
  fi
  if ! grep -q "migration level \[0001.dump-test.sql\]" "$err"; then
    fail_test "the level probe did not report the last STAMPED migration. Got: $(cat "$err")"
    return 1
  fi
  return 0
}

assert_success "db-dump | db-restore round-trips row data" test_db_dump_restore_round_trip
assert_success "db-restore replaces rather than merges" test_db_restore_replaces_rather_than_merges
assert_success "db-restore restores schema_migrations (no pending migrations)" test_db_restore_restores_schema_migrations
assert_success "db-dump | db-restore works over a pipe" test_db_dump_restore_pipe
assert_success "db-dump writes the archive to stdout and logs to stderr" test_db_dump_logs_to_stderr_only
assert_success "db-restore without -y prompts and leaves the database intact" test_db_restore_without_y_prompts
assert_success "db-dump refuses to overwrite without -f (exit 3)" test_db_dump_refuses_to_overwrite
assert_success "db-dump against a missing database exits 4" test_db_dump_missing_database_exits_4
assert_success "db-dump against a stopped cluster exits 2" test_db_dump_stopped_cluster_exits_2
assert_success "db-restore with a missing input file exits 3" test_db_restore_missing_file_exits_3
assert_success "db-restore with an empty stdin stream exits 4" test_db_restore_empty_stdin_exits_4
assert_success "db-restore piped without -y and without a terminal exits 6, changes nothing" test_db_restore_piped_without_y_refuses
assert_success "db-restore refuses a non-archive with exit 7 and drops nothing" test_db_restore_rejects_non_archive_without_dropping
assert_success "a failing db-restore rolls back (exit 5, empty database), and a good archive still restores" test_db_restore_rolls_back_a_failing_restore
assert_success "db-restore with an empty path argument exits 3 and destroys nothing" test_db_restore_empty_argument_exits_3
assert_success "db-dump -d dumps the named database, not POSTGRES_DB" test_db_dump_other_database_with_d
assert_success "a failed db-dump leaves the existing -o target intact" test_db_dump_failure_leaves_the_target_intact
assert_success "db-restore with no argument restores \$POSTGRES_DUMP_DIR/dev.dump and names it in the prompt" test_db_restore_defaults_to_the_dump_dir_artifact
assert_success "db-restore names the default path it looked for when it is missing (exit 4)" test_db_restore_missing_default_names_the_path
assert_success "db-restore with POSTGRES_DUMP_DIR unset exits 4 and never uses /dev.dump" test_db_restore_unset_dump_dir_never_uses_root_dev_dump
assert_success "db-dump -o creates a not-yet-existing directory" test_db_dump_creates_a_missing_output_directory
assert_success "db-dump into an existing but unwritable directory exits 6 and says so" test_db_dump_unwritable_output_directory_exits_6
assert_success "db-dump -D writes \$POSTGRES_DUMP_DIR/dev.dump and db-restore reads it" test_db_dump_D_writes_the_conventional_artifact
assert_success "db-dump -D without a usable POSTGRES_DUMP_DIR exits 22" test_db_dump_D_without_a_usable_dump_dir_exits_22
assert_success "db-restore refuses a malformed POSTGRES_DUMP_DIR instead of building //dev.dump" test_db_restore_malformed_dump_dir_is_refused
assert_success "a successful db-restore logs the migration level it landed at" test_db_restore_success_log_names_the_migration_level
assert_success "the db-restore level probe ignores a NULL applied_at row" test_db_restore_level_probe_ignores_a_null_applied_at

assert_exit_code "$EXIT_UNKNOWN_OPTION" "db-dump -z exits 10" bin/db-dump -z
assert_exit_code "$EXIT_OPTION_REQUIRES_VALUE" "db-dump -o (no value) exits 11" bin/db-dump -o
assert_exit_code "$EXIT_UNEXPECTED_ARG" "db-dump rejects a stray positional" bin/db-dump stray
assert_exit_code "$EXIT_EXCLUSIVE_OPTIONS" "db-dump -f without -o or -D exits 23" bin/db-dump -f
assert_exit_code "$EXIT_EXCLUSIVE_OPTIONS" "db-dump -o with -D exits 23 (two destinations)" bin/db-dump -o /tmp/unicoach-never-written.dump -D
assert_exit_code "$EXIT_INVALID_ARG_VALUE" "db-dump -d with an empty value exits 22" bin/db-dump -d ""
assert_exit_code "$EXIT_INVALID_ARG_VALUE" "db-dump -o with an empty value exits 22" bin/db-dump -o ""
assert_exit_code "$EXIT_INVALID_ARG_VALUE" "db-dump -f -o with an empty value exits 22 (not 23)" bin/db-dump -f -o ""
assert_exit_code "$EXIT_UNKNOWN_OPTION" "db-restore -z exits 10" bin/db-restore -z
assert_exit_code "$EXIT_UNEXPECTED_ARG" "db-restore rejects a second positional" bin/db-restore -y one two

teardown_dump_restore_test
bin/db-drop -y >/dev/null
bin/db-create >/dev/null

echo "==== Testing Migration Engine ===="
setup_migration_test() {
  reset_database_with_schema_dir "/tmp/test_migrations_$$"
}

teardown_migration_test() {
  rm -rf "$DB_SCHEMA_DIR"
  unset DB_SCHEMA_DIR
}

test_db_migrate_forward() {
  setup_migration_test

  add_migration "0001.m1.sql" "CREATE TABLE m1 (id INT);"
  add_migration "0002.m2.sql" "CREATE TABLE m2 (id INT);"

  status_out=$(bin/db-status)
  if ! echo "$status_out" | grep -q "\[PENDING\] 0001.m1.sql"; then
    fail_test "db-status did not detect pending migration 0001.m1.sql"
    teardown_migration_test
    return 1
  fi
  if ! echo "$status_out" | grep -q "\[PENDING\] 0002.m2.sql"; then
    fail_test "db-status did not detect pending migration 0002.m2.sql"
    teardown_migration_test
    return 1
  fi

  bin/db-migrate

  if ! echo "SELECT * FROM m1;" | bin/db-query >/dev/null 2>&1; then
    fail_test "migration 1 was not physically applied"
    teardown_migration_test
    return 1
  fi
  if ! echo "SELECT * FROM m2;" | bin/db-query >/dev/null 2>&1; then
    fail_test "migration 2 was not physically applied"
    teardown_migration_test
    return 1
  fi

  applied_count=$(echo "SELECT count(*) FROM schema_migrations;" | bin/db-query -r)
  if [ "$applied_count" != "2" ]; then
    fail_test "schema_migrations did not track completions. Expected 2, got: '$applied_count'"
    teardown_migration_test
    return 1
  fi

  teardown_migration_test
  return 0
}

test_db_migrate_idempotent() {
  setup_migration_test

  add_migration "0001.m1.sql" "CREATE TABLE m1 (id INT);"
  add_migration "0002.m2.sql" "CREATE TABLE m2 (id INT);"
  bin/db-migrate

  if ! bin/db-migrate >/dev/null 2>&1; then
    fail_test "db-migrate was not idempotent (did not exit 0)"
    teardown_migration_test
    return 1
  fi

  applied_count=$(echo "SELECT count(*) FROM schema_migrations;" | bin/db-query -r)
  if [ "$applied_count" != "2" ]; then
    fail_test "schema counts broke during idempotent migrate"
    teardown_migration_test
    return 1
  fi

  teardown_migration_test
  return 0
}

test_db_migrate_transaction_rollback() {
  setup_migration_test

  # 0001.m1.sql contains valid then invalid SQL
  add_migration "0001.m1.sql" "CREATE TABLE good_table (id INT);"
  echo "GARBAGE SQL;" >> "$DB_SCHEMA_DIR/0001.m1.sql"

  if bin/db-migrate >/dev/null 2>&1; then
    fail_test "db-migrate did not fail on broken transaction"
    teardown_migration_test
    return 1
  fi

  # Ensure the good SQL was rolled back
  if echo "SELECT * FROM good_table;" | bin/db-query >/dev/null 2>&1; then
    fail_test "transaction was not rolled back; good_table exists"
    teardown_migration_test
    return 1
  fi

  applied_count=$(echo "SELECT count(*) FROM schema_migrations;" | bin/db-query -r)
  if [ "$applied_count" != "0" ]; then
    fail_test "schema_migrations erroneously tracked failed transaction"
    teardown_migration_test
    return 1
  fi

  teardown_migration_test
  return 0
}

# Halting keeps its meaning under a DECLARED order: the broken migration is
# listed BEFORE m4 in ORDER, so m4 is what must stay unapplied. Nothing here
# depends on `0003` sorting before `0004` any more — the two ORDER lines are the
# only thing that decides.
test_db_migrate_halts_on_error() {
  setup_migration_test

  add_migration "0001.m1.sql" "CREATE TABLE m1 (id INT);"
  add_migration "0002.m2.sql" "CREATE TABLE m2 (id INT);"
  bin/db-migrate

  add_migration "0003.bad.sql" "GARBAGE SQL SYNTAX;"
  add_migration "0004.m4.sql" "CREATE TABLE m4 (id INT);"

  if bin/db-migrate >/dev/null 2>&1; then
    fail_test "db-migrate did not fail on broken SQL"
    teardown_migration_test
    return 1
  fi

  if echo "SELECT * FROM m4;" | bin/db-query >/dev/null 2>&1; then
    fail_test "db-migrate did not halt; execution continued past broken SQL"
    teardown_migration_test
    return 1
  fi

  applied_count=$(echo "SELECT count(*) FROM schema_migrations;" | bin/db-query -r)
  if [ "$applied_count" != "2" ]; then
    fail_test "schema_migrations erroneously tracked failed migration"
    teardown_migration_test
    return 1
  fi

  teardown_migration_test
  return 0
}

# ── RFC 180: the apply order is a declared file ───────────────────────────────

# The acceptance criterion for an ALREADY-MIGRATED database: re-running
# db-migrate changes nothing. Asserted on count(*) as well as the exit status and
# the log line, because a second INSERT would still exit 0 while doubling the
# table.
test_db_migrate_no_op_on_a_current_database() {
  setup_migration_test

  add_migration "0001.m1.sql" "CREATE TABLE m1 (id INT);"
  add_migration "0002.m2.sql" "CREATE TABLE m2 (id INT);"
  bin/db-migrate

  local before after out
  before=$(bin/db-query -r "SELECT count(*) FROM schema_migrations;" | tr -d '[:space:]')
  if ! out=$(bin/db-migrate 2>&1); then
    fail_test "db-migrate failed on an already-migrated database: $out"
    teardown_migration_test
    return 1
  fi
  if ! echo "$out" | grep -q "fully migrated"; then
    fail_test "db-migrate did not report a current database as fully migrated. Got: $out"
    teardown_migration_test
    return 1
  fi
  after=$(bin/db-query -r "SELECT count(*) FROM schema_migrations;" | tr -d '[:space:]')
  if [ "$before" != "$after" ] || [ "$after" != "2" ]; then
    fail_test "re-running db-migrate changed schema_migrations (before=$before after=$after, expected 2)"
    teardown_migration_test
    return 1
  fi

  teardown_migration_test
  return 0
}

# The production upgrade path, and the one thing local green cannot prove: every
# run of bin/test db-resets, so the suite only ever sees a COLD database, while a
# real one already has schema_migrations and a bare CREATE TABLE IF NOT EXISTS is
# a no-op against it. So the pre-RFC-180 shape is rebuilt here on purpose and
# db-create is asked to upgrade it in place.
test_db_create_reshapes_a_legacy_schema_migrations() {
  setup_migration_test

  add_migration "0001.m1.sql" "CREATE TABLE m1 (id INT);"
  bin/db-migrate

  bin/db-write "DROP TABLE schema_migrations;
    CREATE TABLE schema_migrations (
      version_id VARCHAR(4)   PRIMARY KEY,
      filename   VARCHAR(255) NOT NULL,
      applied_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()
    );
    INSERT INTO schema_migrations (version_id, filename) VALUES ('0001', '0001.m1.sql');" >/dev/null

  local out legacy_col pkey_col rows count
  if ! out=$(bin/db-create 2>&1); then
    fail_test "db-create failed against a pre-RFC-180 schema_migrations: $out"
    teardown_migration_test
    return 1
  fi

  legacy_col=$(bin/db-query -r "SELECT count(*) FROM information_schema.columns WHERE table_name = 'schema_migrations' AND column_name = 'version_id';" | tr -d '[:space:]')
  if [ "$legacy_col" != "0" ]; then
    fail_test "db-create left version_id on schema_migrations"
    teardown_migration_test
    return 1
  fi

  pkey_col=$(bin/db-query -r "SELECT a.attname FROM pg_index i JOIN pg_attribute a ON a.attrelid = i.indrelid AND a.attnum = ANY(i.indkey) WHERE i.indrelid = 'schema_migrations'::regclass AND i.indisprimary;" | tr -d '[:space:]')
  if [ "$pkey_col" != "filename" ]; then
    fail_test "schema_migrations' primary key is [$pkey_col], not filename"
    teardown_migration_test
    return 1
  fi

  rows=$(bin/db-query -r "SELECT filename FROM schema_migrations;" | tr -d '[:space:]')
  if [ "$rows" != "0001.m1.sql" ]; then
    fail_test "the reshape lost the existing rows. Got: [$rows]"
    teardown_migration_test
    return 1
  fi

  # The point of preserving them: the migration they record is not re-applied.
  if ! out=$(bin/db-migrate 2>&1); then
    fail_test "db-migrate failed after the reshape: $out"
    teardown_migration_test
    return 1
  fi
  count=$(bin/db-query -r "SELECT count(*) FROM schema_migrations;" | tr -d '[:space:]')
  if [ "$count" != "1" ]; then
    fail_test "db-migrate was not a no-op after the reshape (schema_migrations has $count rows, expected 1)"
    teardown_migration_test
    return 1
  fi

  # And it is idempotent: a second db-create on the already-new shape does nothing.
  if ! out=$(bin/db-create 2>&1); then
    fail_test "db-create is not idempotent after the reshape: $out"
    teardown_migration_test
    return 1
  fi

  teardown_migration_test
  return 0
}

# The four refusals share a shape: a corpus that disagrees with itself, a
# db-migrate that must fail BEFORE the first BEGIN, a message that NAMES the
# offender, and a database that gained nothing. Run against an already-migrated
# corpus so "nothing applied" is a count that a half-run would visibly move.
assert_migrate_refuses() {
  local what="$1" expected_count="$2"
  shift 2
  local out status=0 count
  out=$(bin/db-migrate 2>&1) || status=$?
  if [ "$status" -eq 0 ]; then
    fail_test "db-migrate accepted $what. Got: $out"
    teardown_migration_test
    return 1
  fi
  # -F: the needles are LITERAL message text, and several now carry the [ ]
  # brackets the bin/ convention puts around an interpolated value. As a BRE,
  # "[2]" is a character class that matches a bare 2, so the very brackets the
  # assertion exists to pin would go unchecked.
  local needle
  for needle in "$@"; do
    if ! echo "$out" | grep -qF -- "$needle"; then
      fail_test "db-migrate's refusal of $what did not name [$needle]. Got: $out"
      teardown_migration_test
      return 1
    fi
  done
  count=$(bin/db-query -r "SELECT count(*) FROM schema_migrations;" | tr -d '[:space:]')
  if [ "$count" != "$expected_count" ]; then
    fail_test "db-migrate applied something while refusing $what (schema_migrations has $count rows, expected $expected_count)"
    teardown_migration_test
    return 1
  fi
  return 0
}

# The RFC 169 defect, now loud: a migration on disk that ORDER never placed. Two
# of them, to prove the message collects every offender rather than the first.
test_db_migrate_refuses_a_file_absent_from_order() {
  setup_migration_test
  add_migration "0001.m1.sql" "CREATE TABLE m1 (id INT);"
  bin/db-migrate

  echo "CREATE TABLE unordered_a (id INT);" > "$DB_SCHEMA_DIR/0002.unordered-a.sql"
  echo "CREATE TABLE unordered_b (id INT);" > "$DB_SCHEMA_DIR/0003.unordered-b.sql"

  assert_migrate_refuses "a migration absent from ORDER" 1 \
    "0002.unordered-a.sql" "0003.unordered-b.sql" || return 1
  if bin/db-query "SELECT * FROM unordered_a;" >/dev/null 2>&1; then
    fail_test "db-migrate applied an unordered migration before refusing"
    teardown_migration_test
    return 1
  fi

  teardown_migration_test
  return 0
}

test_db_migrate_refuses_an_order_line_absent_from_disk() {
  setup_migration_test
  add_migration "0001.m1.sql" "CREATE TABLE m1 (id INT);"
  bin/db-migrate

  printf '%s\n' "0002.never-written.sql" >> "$DB_SCHEMA_DIR/ORDER"

  assert_migrate_refuses "an ORDER line with no file" 1 "0002.never-written.sql" || return 1
  teardown_migration_test
  return 0
}

# Two migrations can no longer share a position, because a position IS a line and
# a repeated line is refused.
test_db_migrate_refuses_a_duplicate_order_line() {
  setup_migration_test
  add_migration "0001.m1.sql" "CREATE TABLE m1 (id INT);"
  add_migration "0002.m2.sql" "CREATE TABLE m2 (id INT);"
  printf '%s\n' "0002.m2.sql" >> "$DB_SCHEMA_DIR/ORDER"

  assert_migrate_refuses "a duplicated ORDER line" 0 "0002.m2.sql" || return 1
  teardown_migration_test
  return 0
}

test_db_migrate_refuses_a_missing_or_empty_order() {
  setup_migration_test
  add_migration "0001.m1.sql" "CREATE TABLE m1 (id INT);"

  rm -f "$DB_SCHEMA_DIR/ORDER"
  assert_migrate_refuses "a missing ORDER beside a migration" 0 "0001.m1.sql" "ORDER" || return 1

  : > "$DB_SCHEMA_DIR/ORDER"
  assert_migrate_refuses "an empty ORDER beside a migration" 0 "0001.m1.sql" "ORDER" || return 1

  teardown_migration_test
  return 0
}

# The whole point of the file. Lexicographically `a-first.sql` sorts first; ORDER
# says otherwise and ORDER wins. Proven twice over: the second-listed migration
# INSERTs into a table only the first-listed one creates (so the wrong order
# cannot even run), and applied_at records the sequence.
test_db_migrate_applies_in_declared_not_lexicographic_order() {
  setup_migration_test

  add_migration "b-second.sql" "CREATE TABLE declared_order_marker (id INT);"
  add_migration "a-first.sql" "INSERT INTO declared_order_marker (id) VALUES (1);"

  local out sequence
  if ! out=$(bin/db-migrate 2>&1); then
    fail_test "db-migrate failed on a corpus whose ORDER contradicts lexicographic order: $out"
    teardown_migration_test
    return 1
  fi
  sequence=$(bin/db-query -r "SELECT string_agg(filename, ',' ORDER BY applied_at ASC) FROM schema_migrations;" | tr -d '[:space:]')
  if [ "$sequence" != "b-second.sql,a-first.sql" ]; then
    fail_test "migrations were applied in [$sequence], not the declared [b-second.sql,a-first.sql]"
    teardown_migration_test
    return 1
  fi

  teardown_migration_test
  return 0
}

# New migrations carry a slug and no number (RFC 180 D5), and schema_migrations
# records the filename VERBATIM — there is nothing left to derive it from.
test_db_migrate_records_slug_filenames_verbatim() {
  setup_migration_test

  add_migration "add-users-timezone.sql" "CREATE TABLE slug_named (id INT);"
  add_migration "x.sql" "CREATE TABLE slug_single_char (id INT);"
  bin/db-migrate

  local recorded objects
  recorded=$(bin/db-query -r "SELECT string_agg(filename, ',' ORDER BY applied_at ASC) FROM schema_migrations;" | tr -d '[:space:]')
  if [ "$recorded" != "add-users-timezone.sql,x.sql" ]; then
    fail_test "slug filenames were not recorded verbatim. Got: [$recorded]"
    teardown_migration_test
    return 1
  fi

  # A row in schema_migrations only says the file was RECORDED. What makes a
  # slug migration "apply" is its SQL having run, so ask the catalogue for the
  # tables each one creates rather than reading exit 0 as proof.
  objects=$(bin/db-query -r "SELECT string_agg(tablename, ',' ORDER BY tablename) FROM pg_tables WHERE schemaname = 'public' AND tablename IN ('slug_named', 'slug_single_char');" | tr -d '[:space:]')
  if [ "$objects" != "slug_named,slug_single_char" ]; then
    fail_test "the slug migrations were recorded but their SQL did not run (tables found: [$objects])"
    teardown_migration_test
    return 1
  fi

  teardown_migration_test
  return 0
}

# Both grammars stay STRICT, because the filename is interpolated into the
# INSERT. Uppercase, a space and a single quote are each still refused, and the
# refusal happens before any SQL is generated.
test_db_migrate_refuses_a_bad_filename() {
  local bad
  for bad in "0001.Upper.sql" "has space.sql" "quote'.sql" "0001..sql" "-leading.sql"; do
    setup_migration_test
    add_migration "$bad" "CREATE TABLE never_created (id INT);"

    local out status=0 count
    out=$(bin/db-migrate 2>&1) || status=$?
    if [ "$status" -eq 0 ]; then
      fail_test "db-migrate accepted the invalid migration filename [$bad]. Got: $out"
      teardown_migration_test
      return 1
    fi
    if ! echo "$out" | grep -q "Invalid migration filename"; then
      fail_test "db-migrate's refusal of [$bad] was not the filename check. Got: $out"
      teardown_migration_test
      return 1
    fi
    count=$(bin/db-query -r "SELECT count(*) FROM schema_migrations;" | tr -d '[:space:]')
    if [ "$count" != "0" ]; then
      fail_test "db-migrate recorded something while refusing the filename [$bad]"
      teardown_migration_test
      return 1
    fi
  done

  teardown_migration_test
  return 0
}

# The name check is a property of the CORPUS, not of one apply step. Put the bad
# name LAST and the difference is visible: the loop-local check refused it only
# after the earlier migrations had COMMITTED, leaving a half-applied database and
# contradicting db-migrate's own "never half-applies" promise. Nothing may be
# applied here.
test_db_migrate_refuses_a_bad_filename_at_a_later_position() {
  setup_migration_test

  add_migration "0001.good-first.sql" "CREATE TABLE good_first (id INT);"
  add_migration "0002.good-second.sql" "CREATE TABLE good_second (id INT);"
  add_migration "0003.Bad-Third.sql" "CREATE TABLE never_created_late (id INT);"

  local out status=0 count
  out=$(bin/db-migrate 2>&1) || status=$?
  if [ "$status" -eq 0 ]; then
    fail_test "db-migrate accepted an invalid filename at a later position. Got: $out"
    teardown_migration_test
    return 1
  fi
  if ! echo "$out" | grep -q "0003.Bad-Third.sql"; then
    fail_test "db-migrate's refusal did not name the offending filename. Got: $out"
    teardown_migration_test
    return 1
  fi
  count=$(bin/db-query -r "SELECT count(*) FROM schema_migrations;" | tr -d '[:space:]')
  if [ "$count" != "0" ]; then
    fail_test "db-migrate applied the earlier migrations before refusing the later bad name ($count rows recorded)"
    teardown_migration_test
    return 1
  fi
  if bin/db-query "SELECT * FROM good_first;" >/dev/null 2>&1; then
    fail_test "db-migrate half-applied the corpus: good_first exists although the run was refused"
    teardown_migration_test
    return 1
  fi

  teardown_migration_test
  return 0
}

# db-migrate no longer routes through db-status, so it no longer inherits
# db-status's provisioning as a side effect: it calls bin/db-create itself
# (bin/db-migrate:36). Nothing else in this suite reaches db-migrate with the
# tracking table absent — every other fixture runs db-create first — so without
# this case a dropped `bin/db-create` line stays green here and fails only on the
# deploy path, which is the one place it is unattended.
test_db_migrate_provisions_a_missing_schema_migrations() {
  setup_migration_test

  add_migration "0001.provisioned.sql" "CREATE TABLE provisioned (id INT);"

  # (a) the database is there, the tracking table is not.
  bin/db-write "DROP TABLE schema_migrations;" >/dev/null
  local out count
  if ! out=$(bin/db-migrate 2>&1); then
    fail_test "db-migrate failed against a database with no schema_migrations: $out"
    teardown_migration_test
    return 1
  fi
  count=$(bin/db-query -r "SELECT count(*) FROM schema_migrations;" | tr -d '[:space:]')
  if [ "$count" != "1" ]; then
    fail_test "db-migrate did not re-provision and apply (schema_migrations has $count rows, expected 1)"
    teardown_migration_test
    return 1
  fi

  # (b) the whole database is gone. Same call, same answer: db-create makes both.
  bin/db-drop -y >/dev/null 2>&1
  if ! out=$(bin/db-migrate 2>&1); then
    fail_test "db-migrate failed against a missing database: $out"
    teardown_migration_test
    return 1
  fi
  count=$(bin/db-query -r "SELECT count(*) FROM schema_migrations;" | tr -d '[:space:]')
  if [ "$count" != "1" ]; then
    fail_test "db-migrate did not provision a missing database (schema_migrations has $count rows, expected 1)"
    teardown_migration_test
    return 1
  fi
  if ! bin/db-query "SELECT * FROM provisioned;" >/dev/null 2>&1; then
    fail_test "db-migrate recorded the migration but its table is missing"
    teardown_migration_test
    return 1
  fi

  teardown_migration_test
  return 0
}

# The fourth shape ORDER can be corrupt in (bin/common's blank-line refusal). A
# blank line is not a migration and must not become a phantom entry, and the
# message carries the LINE NUMBER because a blank line has no other name.
test_db_migrate_refuses_a_blank_order_line() {
  setup_migration_test
  add_migration "0001.m1.sql" "CREATE TABLE m1 (id INT);"
  bin/db-migrate

  echo "CREATE TABLE m2 (id INT);" > "$DB_SCHEMA_DIR/0002.m2.sql"
  printf '%s\n\n%s\n' "0001.m1.sql" "0002.m2.sql" > "$DB_SCHEMA_DIR/ORDER"

  assert_migrate_refuses "a blank line in ORDER" 1 "blank line(s) at: [2]" || return 1
  if bin/db-query "SELECT * FROM m2;" >/dev/null 2>&1; then
    fail_test "db-migrate applied a migration past the blank line before refusing"
    teardown_migration_test
    return 1
  fi

  teardown_migration_test
  return 0
}

# D3: db-status enumerates through the SAME corpus checks db-migrate uses (one
# owner in bin/common), but it does NOT share db-migrate's refusal. db-migrate is
# the writer and refuses; db-status is the diagnostic a human reaches for once
# db-migrate has refused, so a corpus that disagrees with itself is exactly the
# corpus it must still describe. It reports each disagreement as a payload row,
# warns on stderr, and exits 0.
#
# All three drift kinds at once, because they are computed in three different
# places: a *.sql on disk ORDER never names, an ORDER line with no file, and an
# applied row for a migration the corpus no longer knows about (a deleted or
# renamed migration, which every other reader shows as "fully migrated").
test_db_status_reports_drift_as_payload_and_exits_zero() {
  setup_migration_test
  add_migration "0001.m1.sql" "CREATE TABLE m1 (id INT);"
  bin/db-migrate

  echo "CREATE TABLE unordered_status (id INT);" > "$DB_SCHEMA_DIR/0002.unordered-status.sql"
  printf '%s\n' "0003.never-written.sql" >> "$DB_SCHEMA_DIR/ORDER"
  bin/db-write "INSERT INTO schema_migrations (filename) VALUES ('0009.forgotten.sql');" >/dev/null

  local out status=0 err
  err="$PRIVATE_ROOT/db-status-drift.err"
  out=$(bin/db-status 2> "$err") || status=$?
  if [ "$status" -ne 0 ]; then
    fail_test "db-status refused a disagreeing corpus (exit $status) instead of reporting it. Got: $out $(cat "$err")"
    teardown_migration_test
    return 1
  fi

  local needle
  for needle in "[APPLIED] 0001.m1.sql" "[UNORDERED] 0002.unordered-status.sql" \
    "[MISSING] 0003.never-written.sql" "[UNKNOWN] [0009.forgotten.sql]"; do
    if ! echo "$out" | grep -qF -- "$needle"; then
      fail_test "db-status did not report [$needle] in its payload. Got: $out"
      teardown_migration_test
      return 1
    fi
  done

  if ! grep -q "WARNING" "$err"; then
    fail_test "db-status reported drift on stdout without warning on stderr. Got: $(cat "$err")"
    teardown_migration_test
    return 1
  fi

  # The machine formats are a list of FILENAMES a caller pipes onward, so a drift
  # row on their stdout would be read as a migration to apply.
  local applied_out unapplied_out
  applied_out=$(bin/db-status -f applied-only 2>/dev/null)
  if [ "$applied_out" != "0001.m1.sql" ]; then
    fail_test "db-status -f applied-only leaked drift rows. Got: [$applied_out]"
    teardown_migration_test
    return 1
  fi
  unapplied_out=$(bin/db-status -f unapplied-only 2>/dev/null)
  if [ -n "$unapplied_out" ]; then
    fail_test "db-status -f unapplied-only leaked drift rows. Got: [$unapplied_out]"
    teardown_migration_test
    return 1
  fi
  # Captured to a FILE, not piped into grep: the harness runs under `pipefail`,
  # and `grep -q` exits on its first match, so the SIGPIPE it delivers to a
  # db-status that still has warnings to write would fail the pipeline while the
  # assertion itself succeeded.
  bin/db-status -f unapplied-only >/dev/null 2> "$err"
  if ! grep -qF -- "0002.unordered-status.sql" "$err"; then
    fail_test "db-status -f unapplied-only hid the drift entirely instead of warning on stderr. Got: $(cat "$err")"
    teardown_migration_test
    return 1
  fi

  # The hard refusal stays with the WRITER, on the same corpus.
  local migrate_status=0
  bin/db-migrate >/dev/null 2>&1 || migrate_status=$?
  if [ "$migrate_status" -eq 0 ]; then
    fail_test "db-migrate accepted the corpus db-status only warned about"
    teardown_migration_test
    return 1
  fi

  teardown_migration_test
  return 0
}


# And it ENUMERATES through ORDER: same lines as before, now in declared order.
# `a-first.sql` sorts before `b-second.sql`, so a glob-order db-status prints
# them the other way round from the order db-migrate applies them in.
test_db_status_emits_in_declared_order() {
  setup_migration_test

  add_migration "b-second.sql" "CREATE TABLE status_order_marker (id INT);"
  add_migration "a-first.sql" "INSERT INTO status_order_marker (id) VALUES (1);"

  local pending applied
  pending=$(bin/db-status | tr -s '[:space:]' ' ' | sed 's/ $//')
  if [ "$pending" != "[PENDING] b-second.sql [PENDING] a-first.sql" ]; then
    fail_test "db-status listed pending migrations in [$pending], not the declared order"
    teardown_migration_test
    return 1
  fi

  bin/db-migrate
  applied=$(bin/db-status -f applied-only | tr -s '[:space:]' ' ' | sed 's/ $//')
  if [ "$applied" != "b-second.sql a-first.sql" ]; then
    fail_test "db-status listed applied migrations in [$applied], not the declared order"
    teardown_migration_test
    return 1
  fi

  teardown_migration_test
  return 0
}

assert_success "migration engine forward migration" test_db_migrate_forward
assert_success "migration engine restricts idempotency" test_db_migrate_idempotent
assert_success "migration engine rolls back failed transactions" test_db_migrate_transaction_rollback
assert_success "migration engine halts on error" test_db_migrate_halts_on_error
assert_success "db-migrate is a no-op on an already-migrated database" test_db_migrate_no_op_on_a_current_database
assert_success "db-create reshapes a pre-RFC-180 schema_migrations in place" test_db_create_reshapes_a_legacy_schema_migrations
assert_success "db-migrate refuses a migration absent from ORDER, naming every one" test_db_migrate_refuses_a_file_absent_from_order
assert_success "db-migrate refuses an ORDER line with no file on disk" test_db_migrate_refuses_an_order_line_absent_from_disk
assert_success "db-migrate refuses a duplicated ORDER line" test_db_migrate_refuses_a_duplicate_order_line
assert_success "db-migrate refuses a missing or empty ORDER beside migrations" test_db_migrate_refuses_a_missing_or_empty_order
assert_success "db-migrate applies in ORDER's order, not lexicographic order" test_db_migrate_applies_in_declared_not_lexicographic_order
assert_success "db-migrate records slug filenames verbatim" test_db_migrate_records_slug_filenames_verbatim
assert_success "db-migrate still refuses a malformed migration filename" test_db_migrate_refuses_a_bad_filename
assert_success "db-migrate refuses a bad filename at a LATER position, applying nothing" test_db_migrate_refuses_a_bad_filename_at_a_later_position
assert_success "db-migrate provisions a missing database and schema_migrations itself" test_db_migrate_provisions_a_missing_schema_migrations
assert_success "db-migrate refuses a blank line in ORDER, naming the line number" test_db_migrate_refuses_a_blank_order_line
assert_success "db-status reports corpus drift as payload and exits 0" test_db_status_reports_drift_as_payload_and_exits_zero

# WHAT THE ORDER FILE IS is enforced in bin/common; WHAT WRITES IT at land is
# .prime/agent/skills/ship/scripts/ship-order, which deliberately does not source
# bin/functions (the ship scripts stay independent of repo internals). Two
# implementations of one grammar that never meet are two grammars, so this case
# makes them meet: run the REAL ship-order against a throwaway git fixture and
# feed the file it writes straight through the reader that db-migrate uses.
test_ship_order_output_is_accepted_by_schema_order_files() {
  local ship_order="$PROJECT_ROOT/.prime/agent/skills/ship/scripts/ship-order"
  if [ ! -x "$ship_order" ]; then
    fail_test "ship-order is not executable at [$ship_order]"
    return 1
  fi

  local root="$PRIVATE_ROOT/ship_order_fixture"
  rm -rf "$root"
  mkdir -p "$root/db/schema"
  git -C "$root" init -q -b main >/dev/null 2>&1
  git -C "$root" config user.email "tests@example.invalid"
  git -C "$root" config user.name "db-scripts-tests"
  git -C "$root" config commit.gpgsign false

  # The base branch: two migrations that already landed.
  echo "CREATE TABLE so_a (id INT);" > "$root/db/schema/0001.so-a.sql"
  echo "CREATE TABLE so_b (id INT);" > "$root/db/schema/0002.so-b.sql"
  printf '%s\n%s\n' "0001.so-a.sql" "0002.so-b.sql" > "$root/db/schema/ORDER"
  git -C "$root" add -A >/dev/null
  git -C "$root" commit -qm "base" >/dev/null
  local base_sha
  base_sha=$(git -C "$root" rev-parse HEAD)

  # This run's own migration, appended during implementation.
  echo "CREATE TABLE so_mine (id INT);" > "$root/db/schema/add-so-mine.sql"
  printf '%s\n' "add-so-mine.sql" >> "$root/db/schema/ORDER"

  local scratch="$root/run-scratch"
  mkdir -p "$scratch"
  printf 'CODEBASE_ROOT=%s\nBASE_SHA=%s\n' "$root" "$base_sha" > "$scratch/state"

  local out status=0
  out=$("$ship_order" -s "$scratch" 2> "$root/ship-order.err") || status=$?
  if [ "$status" -ne 0 ]; then
    fail_test "ship-order failed on a valid fixture (exit $status): $(cat "$root/ship-order.err")"
    return 1
  fi
  if [ -n "$out" ]; then
    fail_test "ship-order wrote to stdout on a normal run. Got: $out"
    return 1
  fi

  local files reader_status=0
  files=$(schema_order_files "$root/db/schema" 2> "$root/reader.err") || reader_status=$?
  if [ "$reader_status" -ne 0 ]; then
    fail_test "bin/common refused the ORDER that ship-order wrote (exit $reader_status): $(cat "$root/reader.err")"
    return 1
  fi
  local expected
  expected=$(printf '%s\n%s\n%s' "0001.so-a.sql" "0002.so-b.sql" "add-so-mine.sql")
  if [ "$files" != "$expected" ]; then
    fail_test "the order bin/common read back is [$files], not the land order [$expected]"
    return 1
  fi

  rm -rf "$root"
  return 0
}

assert_success "bin/common accepts the ORDER that the ship skill's ship-order writes" test_ship_order_output_is_accepted_by_schema_order_files

# The number matters as much as the refusal: a corrupt CORPUS is not a usage
# error and not a failed migration, and a caller can only tell them apart if they
# carry different exit codes.
setup_migration_test
add_migration "0001.drift-code.sql" "CREATE TABLE drift_code (id INT);"
echo "CREATE TABLE drift_unordered (id INT);" > "$DB_SCHEMA_DIR/0002.drift-unordered.sql"
assert_exit_code "$EXIT_SCHEMA_ORDER_DRIFT" "db-migrate exits EXIT_SCHEMA_ORDER_DRIFT on a corpus that disagrees with ORDER" bin/db-migrate
assert_exit_code 0 "db-status exits 0 on the very corpus db-migrate refuses" bin/db-status
teardown_migration_test

assert_success "db-status enumerates in ORDER's order, not lexicographic order" test_db_status_emits_in_declared_order

# ── Tier-2 review fixes (RFC 180) ─────────────────────────────────────────────

# Deleting a migration file cannot UN-APPLY it. The file-on-disk test used to run
# before the applied test and `continue`, so an applied migration whose file had
# since been deleted vanished from `-f applied-only` — the machine format whose
# only job is to say what this database has already run. A caller diffing that
# list against a fresh checkout would re-apply it.
test_db_status_still_lists_an_applied_migration_whose_file_was_deleted() {
  setup_migration_test
  add_migration "0001.m1.sql" "CREATE TABLE m1 (id INT);"
  add_migration "0002.m2.sql" "CREATE TABLE m2 (id INT);"
  bin/db-migrate

  rm -f "$DB_SCHEMA_DIR/0001.m1.sql"

  local applied_out human_out
  applied_out=$(bin/db-status -f applied-only 2>/dev/null)
  if ! echo "$applied_out" | grep -qxF -- "0001.m1.sql"; then
    fail_test "db-status -f applied-only dropped an APPLIED migration whose file was deleted. Got: [$applied_out]"
    teardown_migration_test
    return 1
  fi
  human_out=$(bin/db-status 2>/dev/null)
  if ! echo "$human_out" | grep -qF -- "[APPLIED] 0001.m1.sql"; then
    fail_test "the human format called an applied-but-deleted migration something other than APPLIED. Got: $human_out"
    teardown_migration_test
    return 1
  fi

  teardown_migration_test
  return 0
}

# An [UNKNOWN] applied row is the ONE drift kind schema_order_scan cannot see: it
# compares ORDER against DISK and never reads schema_migrations, so
# schema_order_has_drift is false and the corpus warning never fires. In the
# machine formats the row is dropped from stdout by design, so before this fix
# the state was reported NOWHERE — while a comment claimed the warning covered it.
test_db_status_warns_about_unknown_applied_rows_in_every_format() {
  setup_migration_test
  add_migration "0001.m1.sql" "CREATE TABLE m1 (id INT);"
  bin/db-migrate

  # The ONLY disagreement in this corpus: ORDER and disk agree exactly.
  bin/db-write "INSERT INTO schema_migrations (filename) VALUES ('0009.forgotten.sql');" >/dev/null

  local err="$PRIVATE_ROOT/db-status-unknown.err" out fmt
  for fmt in "" "-f applied-only" "-f unapplied-only"; do
    # shellcheck disable=SC2086
    out=$(bin/db-status $fmt 2> "$err")
    if ! grep -qF -- "0009.forgotten.sql" "$err"; then
      fail_test "db-status [$fmt] did not warn about an applied row the corpus no longer names. stderr: $(cat "$err")"
      teardown_migration_test
      return 1
    fi
    if ! grep -qF -- "$POSTGRES_DB" "$err"; then
      fail_test "the [UNKNOWN] warning did not name the database. stderr: $(cat "$err")"
      teardown_migration_test
      return 1
    fi
    if ! grep -qF -- "schema_migrations" "$err"; then
      fail_test "the [UNKNOWN] warning did not name schema_migrations. stderr: $(cat "$err")"
      teardown_migration_test
      return 1
    fi
    if [ -n "$fmt" ] && echo "$out" | grep -qF -- "0009.forgotten.sql"; then
      fail_test "db-status [$fmt] leaked an [UNKNOWN] row onto machine stdout. Got: $out"
      teardown_migration_test
      return 1
    fi
  done

  # The value is BRACKETED in the payload: it is raw database content, and an
  # empty or whitespace filename is otherwise invisible.
  out=$(bin/db-status 2>/dev/null)
  if ! echo "$out" | grep -qF -- "[UNKNOWN] [0009.forgotten.sql]"; then
    fail_test "the [UNKNOWN] payload row did not bracket the raw value. Got: $out"
    teardown_migration_test
    return 1
  fi

  teardown_migration_test
  return 0
}

# The reshape guard asks information_schema a question about ONE table, but every
# ALTER it then runs resolves that name through the search path. Without a
# `table_schema = current_schema()` filter an unrelated legacy table in ANOTHER
# schema keeps the guard true forever — and the first ALTER then fails on EVERY
# db-create, which is every db-migrate and every db-status.
test_db_create_reshape_guard_is_scoped_to_this_schema() {
  setup_migration_test
  add_migration "0001.m1.sql" "CREATE TABLE m1 (id INT);"
  bin/db-migrate

  bin/db-write "CREATE SCHEMA IF NOT EXISTS legacy_probe;
    CREATE TABLE legacy_probe.schema_migrations (
      version_id VARCHAR(4)   PRIMARY KEY,
      filename   VARCHAR(255) NOT NULL
    );" >/dev/null

  local out status=0
  out=$(bin/db-create 2>&1) || status=$?
  bin/db-write "DROP SCHEMA legacy_probe CASCADE;" >/dev/null 2>&1 || true
  if [ "$status" -ne 0 ]; then
    fail_test "db-create failed because a legacy schema_migrations exists in ANOTHER schema (exit $status): $out"
    teardown_migration_test
    return 1
  fi

  teardown_migration_test
  return 0
}

# 255 was a bound stated only in this DDL. schema_filename_is_valid (bin/common)
# has no length rule, so nothing else in the tree knew about it: a long but
# perfectly legal slug would pass the pre-BEGIN corpus gate and then die on the
# INSERT, mid-run, after earlier migrations had COMMITTED. TEXT and VARCHAR(n)
# are the same storage in PostgreSQL, so the bound bought nothing to lose. (The
# filesystem's own 255-byte NAME_MAX is why this is asserted on the COLUMN TYPE
# as well as on a long name: a filename can no longer reach the old limit.)
test_schema_migrations_filename_is_text_and_takes_a_long_slug() {
  setup_migration_test

  local slug
  slug="$(printf 'a%.0s' {1..200})"
  add_migration "0001.first.sql" "CREATE TABLE long_slug_first (id INT);"
  add_migration "$slug.sql" "CREATE TABLE long_slug_second (id INT);"

  local out status=0 column_type recorded
  out=$(bin/db-migrate 2>&1) || status=$?
  if [ "$status" -ne 0 ]; then
    fail_test "db-migrate refused a legal 200-character slug filename (exit $status): $out"
    teardown_migration_test
    return 1
  fi
  column_type=$(bin/db-query -r "SELECT data_type FROM information_schema.columns WHERE table_schema = current_schema() AND table_name = 'schema_migrations' AND column_name = 'filename';" | tr -d '[:space:]')
  if [ "$column_type" != "text" ]; then
    fail_test "schema_migrations.filename is [$column_type], not text — a length bound no other reader knows about"
    teardown_migration_test
    return 1
  fi
  recorded=$(bin/db-query -r "SELECT count(*) FROM schema_migrations WHERE filename = '$slug.sql';" | tr -d '[:space:]')
  if [ "$recorded" != "1" ]; then
    fail_test "the long slug migration was not recorded verbatim"
    teardown_migration_test
    return 1
  fi

  teardown_migration_test
  return 0
}

# A line of spaces is not a migration name. `[ -z "$line" ]` accepted one, and it
# was then reported in two wrong sections with an invisible payload — while
# ship-order, the writer, strips exactly these. The two now agree.
test_db_migrate_treats_a_whitespace_only_order_line_as_blank() {
  setup_migration_test
  add_migration "0001.m1.sql" "CREATE TABLE m1 (id INT);"
  bin/db-migrate

  echo "CREATE TABLE m2 (id INT);" > "$DB_SCHEMA_DIR/0002.m2.sql"
  printf '%s\n   \n%s\n' "0001.m1.sql" "0002.m2.sql" > "$DB_SCHEMA_DIR/ORDER"

  assert_migrate_refuses "a whitespace-only ORDER line" 1 "blank line(s) at: [2]" || return 1

  local out status=0
  out=$(bin/db-migrate 2>&1) || status=$?
  if echo "$out" | grep -q "Invalid migration filename"; then
    fail_test "a whitespace-only ORDER line was reported as a migration NAME. Got: $out"
    teardown_migration_test
    return 1
  fi

  teardown_migration_test
  return 0
}

# An illegally named file on disk used to be reported only as "[UNORDERED] …
# append it, in the order it should be applied" — advice that produces a corpus
# the very next run refuses for a different reason. The grammar applies to what
# is on disk, not only to what ORDER lists.
test_db_migrate_refuses_an_illegally_named_file_on_disk() {
  setup_migration_test
  add_migration "0001.m1.sql" "CREATE TABLE m1 (id INT);"
  bin/db-migrate

  echo "CREATE TABLE never_created_disk (id INT);" > "$DB_SCHEMA_DIR/0002.Bad Name.sql"

  assert_migrate_refuses "an illegally named file on disk" 1 "Invalid migration filename" "0002.Bad Name.sql" || return 1

  local out status=0
  out=$(bin/db-migrate 2>&1) || status=$?
  if echo "$out" | grep -q "Append each one"; then
    fail_test "an illegally named file was offered as something to append to ORDER. Got: $out"
    teardown_migration_test
    return 1
  fi

  teardown_migration_test
  return 0
}

# Every offender is named with the LINE it sits on. The remedy is "edit that
# line", and the line number was known at detection and thrown away, leaving the
# reader to search the whole file by eye.
test_db_migrate_refusals_name_the_order_line_number() {
  setup_migration_test
  add_migration "0001.m1.sql" "CREATE TABLE m1 (id INT);"
  add_migration "0002.m2.sql" "CREATE TABLE m2 (id INT);"
  printf '%s\n' "0002.m2.sql" >> "$DB_SCHEMA_DIR/ORDER"

  assert_migrate_refuses "a duplicate without a line number" 0 "line 3, first at line 2" || return 1
  teardown_migration_test

  setup_migration_test
  add_migration "0001.m1.sql" "CREATE TABLE m1 (id INT);"
  printf '%s\n' "0002.never-written.sql" >> "$DB_SCHEMA_DIR/ORDER"

  assert_migrate_refuses "an absent file without a line number" 0 "[0002.never-written.sql] (line 2)" || return 1
  teardown_migration_test
  return 0
}

# ORDER can be present and still unusable. A DIRECTORY called ORDER was reported
# as "not found" — advice that cannot be followed — and an unreadable ORDER died
# on the read redirect with a bare status 1, where the caller expects the corpus
# code.
test_db_migrate_refuses_an_unusable_order_file() {
  setup_migration_test
  add_migration "0001.m1.sql" "CREATE TABLE m1 (id INT);"

  rm -f "$DB_SCHEMA_DIR/ORDER"
  mkdir -p "$DB_SCHEMA_DIR/ORDER"
  assert_migrate_refuses "a directory named ORDER" 0 "is not a regular file" || return 1
  local status=0
  bin/db-migrate >/dev/null 2>&1 || status=$?
  if [ "$status" -ne "$EXIT_SCHEMA_ORDER_DRIFT" ]; then
    fail_test "a directory named ORDER exited $status, not EXIT_SCHEMA_ORDER_DRIFT"
    teardown_migration_test
    return 1
  fi
  rmdir "$DB_SCHEMA_DIR/ORDER"

  # An unreadable ORDER is a third state again: its contents are unknown, so no
  # order can be reported. root ignores the mode bits, so the case would be
  # about the test runner rather than the script.
  if [ "$(id -u)" -ne 0 ]; then
    printf '%s\n' "0001.m1.sql" > "$DB_SCHEMA_DIR/ORDER"
    chmod 000 "$DB_SCHEMA_DIR/ORDER"
    status=0
    local out
    out=$(bin/db-migrate 2>&1) || status=$?
    chmod 644 "$DB_SCHEMA_DIR/ORDER"
    if [ "$status" -ne "$EXIT_SCHEMA_ORDER_DRIFT" ]; then
      fail_test "an unreadable ORDER exited $status, not EXIT_SCHEMA_ORDER_DRIFT. Got: $out"
      teardown_migration_test
      return 1
    fi
    if ! echo "$out" | grep -q "not readable"; then
      fail_test "the refusal of an unreadable ORDER did not say it could not be read. Got: $out"
      teardown_migration_test
      return 1
    fi
  fi

  teardown_migration_test
  return 0
}

# Each migration is its own transaction, so a halt at pending #2 of 2 leaves one
# COMMITTED and the rest unattempted. That state — the only thing an operator
# needs after a failure — used to be stated nowhere: the message named the file
# and stopped.
test_db_migrate_failure_states_what_was_committed() {
  setup_migration_test
  add_migration "0001.good.sql" "CREATE TABLE halt_good (id INT);"
  add_migration "0002.bad.sql" "GARBAGE SQL SYNTAX;"

  local out status=0
  out=$(bin/db-migrate 2>&1) || status=$?
  if [ "$status" -eq 0 ]; then
    fail_test "db-migrate did not fail on broken SQL. Got: $out"
    teardown_migration_test
    return 1
  fi
  if ! echo "$out" | grep -qF -- "[1] of [2] pending migration(s) already COMMITTED"; then
    fail_test "the halt message did not state how many migrations had already committed. Got: $out"
    teardown_migration_test
    return 1
  fi
  if ! echo "$out" | grep -q "not attempted"; then
    fail_test "the halt message did not state how many migrations were left unattempted. Got: $out"
    teardown_migration_test
    return 1
  fi

  teardown_migration_test
  return 0
}

# The SCHEMA_ORDER_* globals are a SCAN's return channel. They used to default to
# "" — a value, and a value answers questions: a reader called before any scan
# was told the corpus is CLEAN, about a corpus nothing had read.
test_schema_order_readers_refuse_an_unscanned_corpus() {
  local out status=0
  out=$(bash -c 'source bin/common; schema_order_has_drift' 2>&1) || status=$?
  if [ "$status" -eq 0 ]; then
    fail_test "schema_order_has_drift reported a CLEAN corpus before any scan ran"
    return 1
  fi
  if ! echo "$out" | grep -q "before schema_order_scan"; then
    fail_test "the misuse was not reported as a call before schema_order_scan. Got: $out"
    return 1
  fi
  return 0
}

assert_success "db-status still lists an APPLIED migration whose file was deleted" test_db_status_still_lists_an_applied_migration_whose_file_was_deleted
assert_success "db-status warns about [UNKNOWN] applied rows in every format" test_db_status_warns_about_unknown_applied_rows_in_every_format
assert_success "db-create's reshape guard ignores a legacy schema_migrations in another schema" test_db_create_reshape_guard_is_scoped_to_this_schema
assert_success "schema_migrations.filename is TEXT and takes a long slug" test_schema_migrations_filename_is_text_and_takes_a_long_slug
assert_success "db-migrate treats a whitespace-only ORDER line as blank" test_db_migrate_treats_a_whitespace_only_order_line_as_blank
assert_success "db-migrate refuses an illegally named file on disk" test_db_migrate_refuses_an_illegally_named_file_on_disk
assert_success "db-migrate's refusals name the ORDER line number" test_db_migrate_refusals_name_the_order_line_number
assert_success "db-migrate refuses an ORDER that is a directory or unreadable" test_db_migrate_refuses_an_unusable_order_file
assert_success "db-migrate's halt states what committed and what was not attempted" test_db_migrate_failure_states_what_was_committed
assert_success "bin/common's corpus readers refuse a call before any scan" test_schema_order_readers_refuse_an_unscanned_corpus
assert_exit_code "$EXIT_INVALID_ARG_VALUE" "db-status -f with an empty value exits 22" bin/db-status -f ""
assert_exit_code 0 "db-status accepts the explicit -f human format" bin/db-status -f human


echo ""
echo "==== Testing roles and database ownership (RFC 174) ===="
# The first role coverage in the tree. Until RFC 174 every bin/ command connected
# as the cluster superuser, so ownership bought nothing and nothing asserted a
# privilege — there was no way to even express one, because bin/db-run had no -U.

# What the bootstrap above must already have produced: a LOGIN CREATEDB role that
# is NOT a superuser. NOSUPERUSER is the whole guarantee; a superuser bypasses
# every ownership check, so a role that quietly gained it would void the
# isolation while every test still passed.
test_owner_role_is_login_createdb_nosuperuser() {
  local attrs
  # SQL labels the attributes. They used to be concatenated into a positional
  # `011` digit token, so a failure printed `[001]` and told the reader nothing
  # until they re-derived which column was which.
  attrs="$(bin/db-run -r -d "$POSTGRES_ADMIN_DB" ro \
    "SELECT format('superuser=%s createdb=%s login=%s', rolsuper::text, rolcreatedb::text, rolcanlogin::text) FROM pg_roles WHERE rolname = '$POSTGRES_USER'" | tr -d '\n')"
  if [ "$attrs" != "superuser=false createdb=true login=true" ]; then
    fail_test "role [$POSTGRES_USER] is not LOGIN CREATEDB NOSUPERUSER (pg_roles reports [$attrs])"
  fi
  return 0
}

# And that it OWNS its database and the objects in it — ownership of the database
# alone is not enough, since ALTER TABLE on a pre-existing table is checked
# against the TABLE's owner (which is what breaks db-migrate).
test_owner_role_owns_its_database_and_objects() {
  local db_owner tbl_owner
  db_owner="$(database_owner_of "$POSTGRES_DB")"
  if [ "$db_owner" != "$POSTGRES_USER" ]; then
    fail_test "database [$POSTGRES_DB] is owned by [$db_owner], not [$POSTGRES_USER]"
  fi
  tbl_owner="$(bin/db-run -r ro \
    "SELECT tableowner FROM pg_tables WHERE tablename = 'schema_migrations'" | tr -d '[:space:]')"
  if [ "$tbl_owner" != "$POSTGRES_USER" ]; then
    fail_test "schema_migrations is owned by [$tbl_owner], not [$POSTGRES_USER]"
  fi
  return 0
}

# Idempotent AND repairing: the unconditional ALTER inside db-create-role's DO
# block exists so a role that already exists but lost LOGIN or CREATEDB is healed
# on the next run rather than diagnosed three scripts later.
test_db_create_role_repairs_a_deficient_role() {
  local out
  bin/db-write -U "$POSTGRES_SUPERUSER" -d "$POSTGRES_ADMIN_DB" \
    "ALTER ROLE \"$POSTGRES_USER\" NOLOGIN NOCREATEDB;" >/dev/null
  # The server's message is CARRIED, not muted: fail_test exits, the EXIT trap
  # rm -rf's this private cluster, and the SQLSTATE is then gone together with the
  # state that produced it. It is the answer to every question an ownership test
  # raises.
  if ! out="$(bin/db-create-role 2>&1)"; then
    # Put it back before failing: every later test connects as this role.
    bin/db-write -U "$POSTGRES_SUPERUSER" -d "$POSTGRES_ADMIN_DB" \
      "ALTER ROLE \"$POSTGRES_USER\" LOGIN CREATEDB;" >/dev/null 2>&1 || true
    fail_test "db-create-role failed against an existing deficient role [$POSTGRES_USER]: $out"
  fi
  test_owner_role_is_login_createdb_nosuperuser
  # And again, on a role that now needs nothing: a plain no-op.
  if ! out="$(bin/db-create-role 2>&1)"; then
    fail_test "db-create-role is not idempotent (second run failed) for role [$POSTGRES_USER]: $out"
  fi
  return 0
}

# db-adopt carries no state and no flag, so re-running it must be free. Every loop
# in its DO block filters on `owner <> role`, which matches nothing the second
# time; the ALTER DATABASE is a successful no-op when the owner is unchanged.
test_db_adopt_is_idempotent() {
  local out
  if ! out="$(bin/db-adopt 2>&1)"; then
    fail_test "db-adopt failed on the already-adopted database [$POSTGRES_DB] as role [$POSTGRES_USER]: $out"
  fi
  if ! out="$(bin/db-adopt 2>&1)"; then
    fail_test "db-adopt is not idempotent (second run failed) on [$POSTGRES_DB] as role [$POSTGRES_USER]: $out"
  fi
  test_owner_role_owns_its_database_and_objects
  return 0
}

# The steady state a MIGRATED checkout is actually in: a migration creates an
# EXTENSION as the superuser, so every member function/table/type it brings is
# owned by the superuser and re-created that way on the next db-migrate. Before
# the pg_depend deptype 'e' carve-out, db-adopt re-owned fuzzystrmatch's eleven
# functions on EVERY bin/db-reset -- a permanent non-no-op contradicting RFC 174
# D5's "a second run executes no statements at all", and wrong on its own terms:
# an extension's members must follow their extension for DROP EXTENSION and
# dump/restore to stay faithful. Asserted as OWNERSHIP (the members are STILL the
# superuser's) AND as the reported count (zero), because either alone passes for
# the wrong reason: a count of 0 is what a broken sweep prints on its SECOND run,
# and the ownership check alone would pass on a db-adopt that never ran.
test_db_adopt_leaves_extension_members_alone() {
  local out reowned member_owners
  bin/db-write -U "$POSTGRES_SUPERUSER" "CREATE EXTENSION IF NOT EXISTS fuzzystrmatch;" >/dev/null
  if ! out="$(bin/db-adopt 2>&1)"; then
    fail_test "db-adopt failed on [$POSTGRES_DB] after CREATE EXTENSION fuzzystrmatch: $out"
  fi
  reowned="$(printf '%s' "$out" | sed -n 's/.*re-owned \([0-9]*\) object(s).*/\1/p')"
  if [ "$reowned" != "0" ]; then
    fail_test "db-adopt re-owned [$reowned] object(s) on an adopted database whose only superuser-owned objects are extension members; expected 0: $out"
  fi
  member_owners="$(bin/db-run -r ro "SELECT string_agg(DISTINCT pg_get_userbyid(p.proowner), ',') FROM pg_depend d JOIN pg_proc p ON p.oid = d.objid JOIN pg_extension e ON e.oid = d.refobjid WHERE d.deptype = 'e' AND d.classid = 'pg_proc'::regclass AND e.extname = 'fuzzystrmatch'" | tr -d '[:space:]')"
  if [ "$member_owners" != "$POSTGRES_SUPERUSER" ]; then
    fail_test "fuzzystrmatch's members are owned by [$member_owners], not [$POSTGRES_SUPERUSER]; db-adopt must leave an extension's members to their extension"
  fi
  bin/db-write -U "$POSTGRES_SUPERUSER" "DROP EXTENSION fuzzystrmatch;" >/dev/null
  return 0
}

# The pre-RFC-174 fixture, NAMED — the way create_cloud_shape_env next door names its
# own. Both tests below open on the same five lines of superuser DDL plus a sed of
# the private dotenv, which is the subject of neither of them.
#
# A database as it existed BEFORE RFC 174: owned by the SUPERUSER, with a
# superuser-owned table and a row in it. Echoes the private ENV_FILE that points a
# bin/ command at it — a FILE, not an exported POSTGRES_DB, because bin/common
# sources the env file under `set -a`, so an inherited value for a key the file
# sets is clobbered before any script reads it.
seed_legacy_database() {
  local legacy="$1" legacy_env="$PRIVATE_ROOT/env.$1"
  drop_legacy_database "$legacy"
  bin/db-write -U "$POSTGRES_SUPERUSER" -d "$POSTGRES_ADMIN_DB" "CREATE DATABASE \"$legacy\";" >/dev/null
  # Both sequence-ownership shapes, because db-adopt must skip them by two
  # different pg_depend deptypes: serial's sequence is linked to its column with
  # 'a' (auto), an identity column's with 'i' (internal). A serial-only fixture
  # passes against a carve-out that matches 'a' alone; the real schema, which is
  # identity throughout, does not.
  bin/db-write -U "$POSTGRES_SUPERUSER" -d "$legacy" \
    "CREATE TABLE legacy_t (id serial PRIMARY KEY, v text); INSERT INTO legacy_t (v) VALUES ('kept');
     CREATE TABLE legacy_identity_t (id bigint GENERATED ALWAYS AS IDENTITY PRIMARY KEY, v text); INSERT INTO legacy_identity_t (v) VALUES ('kept');" >/dev/null
  sed "s|^POSTGRES_DB=.*|POSTGRES_DB=$legacy|" "$PRIVATE_ENV" > "$legacy_env"
  printf '%s\n' "$legacy_env"
}

drop_legacy_database() {
  bin/db-write -U "$POSTGRES_SUPERUSER" -d "$POSTGRES_ADMIN_DB" \
    "DROP DATABASE IF EXISTS \"$1\" WITH (FORCE);" >/dev/null 2>&1 || true
}

# Who owns a database, by name. Inlined at four sites before this.
database_owner_of() {
  bin/db-run -r -d "$POSTGRES_ADMIN_DB" ro \
    "SELECT pg_get_userbyid(datdba) FROM pg_database WHERE datname = '$1'" | tr -d '[:space:]'
}

# The transition RFC 174 exists to make: a database that predates it exists and is
# owned by the SUPERUSER, with superuser-owned tables inside. db-create must adopt
# it in place — nothing dropped, the data still there — and the owner role must
# then be able to run the ALTER that db-migrate would.
test_db_create_adopts_a_legacy_database() {
  local legacy="unicoach-db-scripts-legacy" legacy_env rows owner out
  legacy_env="$(seed_legacy_database "$legacy")"
  if ! out="$(ENV_FILE="$legacy_env" bin/db-create 2>&1)"; then
    fail_test "db-create failed to adopt superuser-owned [$legacy] as role [$POSTGRES_USER]: $out"
  fi
  owner="$(database_owner_of "$legacy")"
  if [ "$owner" != "$POSTGRES_USER" ]; then
    fail_test "db-create did not adopt [$legacy]: still owned by [$owner]"
  fi
  rows="$(bin/db-run -r -d "$legacy" ro "SELECT count(*) FROM legacy_t" | tr -d '[:space:]')"
  if [ "$rows" != "1" ]; then
    fail_test "adopting [$legacy] lost its data: [$rows] rows, expected 1"
  fi
  # The identity table asserted through a WRITE, not a count: the row this adds
  # can only be created by calling nextval on legacy_identity_t_id_seq, the
  # sequence db-adopt skipped. Reading it back proves the skip left a sequence
  # the owner role can actually use, rather than one still owned by the
  # superuser -- and it does not depend on db-adopt's loop order the way the
  # aborting ALTER SEQUENCE does.
  if ! out="$(bin/db-write -d "$legacy" "INSERT INTO legacy_identity_t (v) VALUES ('added');" 2>&1)"; then
    fail_test "role [$POSTGRES_USER] cannot write to the identity table in [$legacy] after db-adopt; the server said: $out"
  fi
  rows="$(bin/db-run -r -d "$legacy" ro "SELECT count(*) FROM legacy_identity_t" | tr -d '[:space:]')"
  if [ "$rows" != "2" ]; then
    fail_test "identity table in [$legacy] has [$rows] rows after adopt + insert, expected 2"
  fi
  # The half that ALTER DATABASE alone does not buy: a db-migrate-shaped statement
  # against a table created before the transition.
  if ! out="$(bin/db-write -d "$legacy" "ALTER TABLE legacy_t ADD COLUMN added int;" 2>&1)"; then
    fail_test "role [$POSTGRES_USER] still cannot ALTER a pre-existing table in [$legacy] after db-adopt; the server said: $out"
  fi
  drop_legacy_database "$legacy"
  return 0
}

# The SAME legacy database, met through bin/db-reset instead of bin/db-create —
# and this is the path that matters, because db-reset's FIRST step is db-drop and
# DROP DATABASE is checked against the OWNER. The db-create test above passed
# while every existing checkout's bin/test, bin/db-reset and bin/db-restore died
# with `must be owner of database`: the adoption was wired into step 2 and step 1
# never reached it. Driving db-create here would re-test what is already covered
# and re-hide the gap.
test_db_reset_adopts_and_recreates_a_legacy_database() {
  local legacy="unicoach-db-scripts-legacy-reset" legacy_env owner out
  legacy_env="$(seed_legacy_database "$legacy")"
  if ! out="$(ENV_FILE="$legacy_env" bin/db-reset 2>&1)"; then
    fail_test "db-reset failed against superuser-owned [$legacy] as role [$POSTGRES_USER]: $out"
  fi
  owner="$(database_owner_of "$legacy")"
  if [ "$owner" != "$POSTGRES_USER" ]; then
    fail_test "db-reset left [$legacy] owned by [$owner], not [$POSTGRES_USER]"
  fi
  drop_legacy_database "$legacy"
  return 0
}


# -U has to REACH psql, not merely parse: session_user IS the role the connection
# was made as. db-query is the one of the three scripts whose -U appears nowhere
# else in the tree, so dropping "${USER_FLAGS[@]}" from its db-run argv — a silent
# fallback to POSTGRES_USER — would otherwise pass the whole suite.
test_db_query_forwards_the_connecting_role() {
  local session_role
  session_role="$(bin/db-query -r -U "$POSTGRES_SUPERUSER" "SELECT session_user" | tr -d '[:space:]')"
  if [ "$session_role" != "$POSTGRES_SUPERUSER" ]; then
    fail_test "db-query -U [$POSTGRES_SUPERUSER] connected as [$session_role]; the option is not forwarded to db-run"
  fi
  return 0
}

# The CLOUD shape of the environment, and the one claim RFC 174 makes about
# DEPLOYED behaviour: with POSTGRES_SUPERUSER unset the cluster admin collapses
# onto POSTGRES_USER, so db-create-role must create NO checkout owner role and
# db-adopt must do nothing at all. That precondition (the two roles EQUAL) occurs
# nowhere else in the suite — every other test runs the unequal, per-checkout
# shape — so both guards are silent on every run without it. Inverted, they would
# create an owner-<release-dir> role on RDS and re-own the instance's database.
# Safe here and nowhere else: this harness owns its private throwaway cluster.
#
# The FIXTURE is what the three cases share, not an assertion, so it is what gets
# extracted; each command then gets its own pass/fail line, and a db-adopt
# regression can no longer report as a db-create-role failure. It is a FILE, not
# an exported variable: bin/common sources the env file under `set -a`, so an
# inherited value is clobbered before any script reads it.
create_cloud_shape_env() {
  local cloud_env="$PRIVATE_ROOT/env.cloud"
  grep -v '^POSTGRES_SUPERUSER=' "$PRIVATE_ENV" \
    | sed 's|^POSTGRES_USER=.*|POSTGRES_USER=postgres|' > "$cloud_env"
  printf '%s\n' "$cloud_env"
}

# db-create is the command the deploy path actually calls, so it must still
# succeed unchanged in this shape.
test_db_create_succeeds_in_the_cloud_shape() {
  local cloud_env out
  cloud_env="$(create_cloud_shape_env)"
  if ! out="$(ENV_FILE="$cloud_env" bin/db-create 2>&1)"; then
    fail_test "db-create failed on [$POSTGRES_DB] when POSTGRES_USER is the cluster admin (the cloud shape): $out"
  fi
  return 0
}

# Which BRANCH the guard took, read from its own diagnostics (all bin/ logging is
# stderr), AND the resulting state. The state check cannot stand alone: on a
# cluster whose admin role already exists, a db-create-role that wrongly ran its
# block would ALTER the master role and leave no trace in pg_roles. The whole
# WHOLE role SET is compared, before and after — not a count, and not a
# `rolname LIKE 'owner-%'` pattern. RFC 174's rule is "the cloud shape creates NO
# role", so the whole set is both the stronger check and the one that needs no
# naming convention: matching a prefix would encode .env.dev's `owner-` here and
# go SILENTLY vacuous the day it changed, since a pattern matching nothing still
# compares equal before and after.
test_db_create_role_skips_the_owner_role_in_the_cloud_shape() {
  local cloud_env role_log roles_before roles_after
  local roles_sql="SELECT string_agg(rolname, ',' ORDER BY rolname) FROM pg_roles"
  cloud_env="$(create_cloud_shape_env)"
  roles_before="$(bin/db-run -r -d "$POSTGRES_ADMIN_DB" ro "$roles_sql" | tr -d '[:space:]')"
  role_log="$(ENV_FILE="$cloud_env" bin/db-create-role 2>&1)"
  if ! printf '%s' "$role_log" | grep -q 'is the cluster admin'; then
    fail_test "db-create-role did not skip the checkout owner role when POSTGRES_USER is the cluster admin: $role_log"
  fi
  if printf '%s' "$role_log" | grep -q 'Ensuring checkout owner role'; then
    fail_test "db-create-role ran the checkout owner-role block in the cloud shape; on RDS that is a role the instance must never grow: $role_log"
  fi
  roles_after="$(bin/db-run -r -d "$POSTGRES_ADMIN_DB" ro "$roles_sql" | tr -d '[:space:]')"
  if [ "$roles_after" != "$roles_before" ]; then
    fail_test "the cloud shape changed the cluster's roles (before [$roles_before], after [$roles_after]); the checkout-role block must be skipped when POSTGRES_USER is the cluster admin"
  fi
  return 0
}

# And nothing is re-owned. The state half is this harness's own database still
# belonging to its own owner role, which db-adopt would have taken away had it not
# returned early.
test_db_adopt_re_owns_nothing_in_the_cloud_shape() {
  local cloud_env adopt_log
  cloud_env="$(create_cloud_shape_env)"
  adopt_log="$(ENV_FILE="$cloud_env" bin/db-adopt 2>&1)"
  if ! printf '%s' "$adopt_log" | grep -q 'nothing to adopt'; then
    fail_test "db-adopt did not skip when POSTGRES_USER is the cluster admin: $adopt_log"
  fi
  if printf '%s' "$adopt_log" | grep -q 'Adopting database'; then
    fail_test "db-adopt re-owned the database in the cloud shape; the deployed behaviour must be unchanged: $adopt_log"
  fi
  test_owner_role_owns_its_database_and_objects
  return 0
}

assert_success "the checkout owner role is LOGIN CREATEDB NOSUPERUSER" test_owner_role_is_login_createdb_nosuperuser
assert_success "the checkout owner role owns its database and its objects" test_owner_role_owns_its_database_and_objects
assert_success "db-create-role is idempotent and repairs a deficient role" test_db_create_role_repairs_a_deficient_role
assert_success "db-adopt run twice is a no-op" test_db_adopt_is_idempotent
assert_success "db-adopt leaves an extension's members owned by their extension" test_db_adopt_leaves_extension_members_alone
assert_success "db-create adopts a pre-existing superuser-owned database in place" test_db_create_adopts_a_legacy_database
assert_success "db-reset drops, recreates and adopts a pre-existing superuser-owned database" test_db_reset_adopts_and_recreates_a_legacy_database
assert_success "db-query -U forwards the connecting role to db-run" test_db_query_forwards_the_connecting_role
assert_success "db-create succeeds when POSTGRES_USER is the cluster admin (the cloud shape)" test_db_create_succeeds_in_the_cloud_shape
assert_success "db-create-role creates no owner role in the cloud shape" test_db_create_role_skips_the_owner_role_in_the_cloud_shape
assert_success "db-adopt re-owns nothing in the cloud shape" test_db_adopt_re_owns_nothing_in_the_cloud_shape

end_tests
