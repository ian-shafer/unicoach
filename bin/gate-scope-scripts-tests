#!/usr/bin/env bash
# gate-scope-scripts-tests — shell assertions over bin/gate-scope (RFC 214), the
# single path-to-harness map the commit gate reads.
#
# WHAT IS BEING PROTECTED. gate-scope's table is a CORRECTNESS CLAIM: a row that
# is too narrow lets a defect reach main with the gate reporting green, which is
# the one failure mode nobody sees. So these assertions come in two kinds.
#
#  * CLASSIFICATION. Throwaway `git init` repos with a known staged set, run
#    through the REAL bin/gate-scope, asserting its four stdout lines. Every row
#    of the table, plus the five fail-closed directions the header of
#    bin/gate-scope names: unrecognised path, mixed set, empty index, a rename
#    across a scope boundary, and an undeclared harness -- and the
#    PATH_GATED_HARNESSES filter, which drops ship- and docs-scripts-tests from
#    any row unless a staged path is one of their inputs.
#  * CROSS-SWEEPS. Assertions over the REAL bin/*scripts-tests files, no fixture.
#    These are what keep the map honest as the harnesses change: a harness that
#    starts reading .prime/ and is not named in PRIME_HARNESSES fails the build,
#    rather than silently never running for a .prime/ commit.
#
# NO DATABASE, NO DAEMON, NO WORKTREE OF THE REAL REPO. Every classification case
# runs against a throwaway repo under mktemp -d, in the style of
# bin/docs-scripts-tests.
export ENV_FILES="${ENV_FILES:-.env.dev:.env.test}"
source "$(dirname "$0")/common"
source "$(dirname "$0")/tests-common"

help() {
  cat << 'EOF'
gate-scope-scripts-tests [options]

Runs the shell assertions over bin/gate-scope: the classification of a staged
set into a scope, the five fail-closed rules, the usage grammar, and the
cross-sweeps that hold the table against the real bin/*scripts-tests files.
Needs no database, no daemon and no worktree of this repo.

Options:
  -h: Help
EOF
  exit 0
}

while getopts ":h" opt; do
  case "$opt" in
  h) help ;;
  \?) fatal -s "$EXIT_UNKNOWN_OPTION" "unknown option [-$OPTARG]" ;;
  :)  fatal -s "$EXIT_OPTION_REQUIRES_VALUE" "option [-$OPTARG] requires an argument" ;;
  esac
done
shift $((OPTIND-1))

if [ "$#" -ne 0 ]; then
  fatal -s "$EXIT_UNEXPECTED_ARG" "Error: gate-scope-scripts-tests accepts no positional arguments."
fi

GATE_SCOPE="$PROJECT_ROOT/bin/gate-scope"
[ -x "$GATE_SCOPE" ] || fail_test "gate-scope is missing or not executable [$GATE_SCOPE]"

# This harness runs inside the pre-commit hook (git commit -> bin/pre-commit ->
# bin/check -> bin/shell-tests -> here), where GIT_DIR, GIT_WORK_TREE and
# GIT_INDEX_FILE are exported and OUTRANK `git -C`. Without this strip every
# fixture below would stage into the REAL index being committed.
strip_git_hook_env

FIXTURE_DIR="$(mktemp -d)"
trap 'rm -rf "$FIXTURE_DIR"' EXIT INT TERM

# ---------------------------------------------------------------------------
# Fixtures
# ---------------------------------------------------------------------------

# A fresh git repo, printed on stdout. Called in a command substitution, so the
# unique directory comes from mktemp and not from a counter (a counter
# incremented in a subshell dies with it and hands every caller one directory --
# the trap bin/docs-scripts-tests documents).
gs_repo() {
  local repo
  repo="$(mktemp -d "$FIXTURE_DIR/repo.XXXXXX")"
  git init -q -b main "$repo" > /dev/null
  git -C "$repo" config user.email "tests@example.com"
  git -C "$repo" config user.name "gate-scope-scripts-tests"
  printf '%s\n' "$repo"
}

# gate-scope reads the module list from settings.gradle.kts, so a fixture that
# exercises a module-source row needs one. It is deliberately NOT staged: what is
# classified is the index, and an unstaged file must not appear in it.
gs_modules() { # <repo>
  cat > "$1/settings.gradle.kts" << 'EOF'
rootProject.name = "fixture"
include("service")
include("db")
include("rest-server")
include("public-web")
EOF
}

# Write each path and stage it. `git add --` because a fixture path may begin
# with a space or contain a newline, and those cases are the point.
gs_stage() { # <repo> <relpath...>
  local repo="$1" path
  shift
  for path in "$@"; do
    mkdir -p "$repo/$(dirname "$path")"
    printf 'x\n' > "$repo/$path"
    git -C "$repo" add -- "$path"
  done
}

gs_commit() { # <repo> <message>
  git -C "$1" add -A > /dev/null
  git -C "$1" -c user.email=tests@example.com -c user.name=gate-scope-scripts-tests \
    commit -qm "$2" --no-verify > /dev/null
}

# ---------------------------------------------------------------------------
# Running the subject
# ---------------------------------------------------------------------------

# Runs gate-scope over <repo> (or the script named in $GS_SCRIPT, which the
# anti-orphan cases repoint at a copy) and leaves the answer in globals.
GS_SCRIPT=""
gs_classify() { # <repo>
  local script="${GS_SCRIPT:-$GATE_SCOPE}"
  GS_OUT="$(mktemp "$FIXTURE_DIR/out.XXXXXX")"
  GS_ERR="$(mktemp "$FIXTURE_DIR/err.XXXXXX")"
  GS_STATUS=0
  "$script" -r "$1" > "$GS_OUT" 2> "$GS_ERR" || GS_STATUS=$?
  GS_SCOPE="$(sed -n 's/^scope=//p' "$GS_OUT")"
  GS_GRADLE="$(sed -n 's/^gradle=//p' "$GS_OUT")"
  GS_HARNESSES="$(sed -n 's/^harnesses=//p' "$GS_OUT")"
  GS_FUZZ="$(sed -n 's/^fuzz=//p' "$GS_OUT")"
}

# The whole contract of one run: exit 0, exactly the four key=value lines on
# stdout and nothing else, a yes|no fuzz value, and the three scope values. The
# fuzz VALUE is asserted by gs_fuzz_case below, so the scope rows need not each
# restate it.
gs_expect() { # <repo> <scope> <gradle> <harnesses>
  local lines
  gs_classify "$1"
  [ "$GS_STATUS" -eq 0 ] ||
    { log-error "gate-scope exited [$GS_STATUS]: [$(head -3 "$GS_ERR")]"; return 1; }
  lines="$(wc -l < "$GS_OUT" | tr -d ' ')"
  [ "$lines" -eq 4 ] ||
    { log-error "expected 4 stdout lines, got [$lines]: [$(cat "$GS_OUT")]"; return 1; }
  grep -qvE '^(scope|gradle|harnesses|fuzz)=' "$GS_OUT" &&
    { log-error "stdout carries a non key=value line: [$(cat "$GS_OUT")]"; return 1; }
  case "$GS_FUZZ" in
  yes | no) ;;
  *) log-error "fuzz=[$GS_FUZZ], expected yes or no"; return 1 ;;
  esac
  [ "$GS_SCOPE" = "$2" ] ||
    { log-error "scope=[$GS_SCOPE], expected [$2] (reason: $(cat "$GS_ERR"))"; return 1; }
  [ "$GS_GRADLE" = "$3" ] ||
    { log-error "gradle=[$GS_GRADLE], expected [$3]"; return 1; }
  [ "$GS_HARNESSES" = "$4" ] ||
    { log-error "harnesses=[$GS_HARNESSES], expected [$4]"; return 1; }
  return 0
}

# The commonest shape: build a repo, stage these paths, expect this scope.
gs_case() { # <scope> <gradle> <harnesses> <relpath...>
  local scope="$1" gradle="$2" harnesses="$3" repo
  shift 3
  repo="$(gs_repo)"
  gs_stage "$repo" "$@"
  gs_expect "$repo" "$scope" "$gradle" "$harnesses"
}

# The same, with a settings.gradle.kts in place.
gs_module_case() { # <scope> <gradle> <harnesses> <relpath...>
  local scope="$1" gradle="$2" harnesses="$3" repo
  shift 3
  repo="$(gs_repo)"
  gs_modules "$repo"
  gs_stage "$repo" "$@"
  gs_expect "$repo" "$scope" "$gradle" "$harnesses"
}

# The declared lists, read out of bin/gate-scope's source. Defined up here
# because the classification cases below derive their expected `full` list from
# KNOWN_HARNESSES; the cross-sweeps further down assert each read found
# something.
declared_value() { # <variable name>
  sed -n 's/^'"$1"'="\(.*\)"$/\1/p' "$GATE_SCOPE"
}

declared_array() { # <variable name>
  sed -n '/^'"$1"'=(/,/^)/p' "$GATE_SCOPE" | sed -e '1d' -e '$d' -e 's/[[:space:]]//g' -e '/^$/d'
}

DECLARED_KNOWN=()
while IFS= read -r line; do
  [ -n "$line" ] && DECLARED_KNOWN+=("$line")
done < <(declared_array KNOWN_HARNESSES)

# KNOWN_HARNESSES minus the named harnesses, space-separated, in declared order:
# what a filtered full (`full-gated`) emits. DERIVED rather than
# typed out, because the assertion is about the FILTER -- which names it drops
# and that it keeps every other one -- not about KNOWN_HARNESSES' contents; a
# hand-typed copy would have to change with every new harness for no gain.
known_without() { # <harness...>
  local harness kept=()
  for harness in "${DECLARED_KNOWN[@]}"; do
    list_contains "$harness" "$@" || kept+=("$harness")
  done
  printf '%s' "${kept[*]}"
}

# The two harnesses PATH_GATED_HARNESSES gates, and `full` with each of them
# dropped. The commonest `full-gated` answer below is FULL_UNGATED: a mixed set that
# touches no skill directory, no bin/ and no flake runs neither.
FULL_UNGATED="$(known_without ship-scripts-tests docs-scripts-tests)"
FULL_WITH_SHIP="$(known_without docs-scripts-tests)"
FULL_WITH_DOCS="$(known_without ship-scripts-tests)"

# The module-source row's harnesses. web-assets-scripts-tests joined it at
# RFC 225: public-web's client-side TypeScript and its COMMITTED bundle both sit
# inside a module src/ tree, so a TypeScript edit IS a module-source diff, and
# that harness is the only thing that catches such an edit committed without a
# rebuild. Written once here because four assertions below quote it.
MODULE_SOURCE_SCOPE_HARNESSES="scripts-tests web-assets-scripts-tests"

# A product/ path that is not Markdown, so it reaches the product-docs row.
PRODUCT_PATH="product/0001-brief/research/table.csv"

echo "==== classification: the empty index and the docs rows ===="

# Rule 3. A universal test over an empty set passes vacuously, and a vacuous pass
# is the silent green this whole script exists to prevent. Rule 3 also wins over
# PATH_GATED_HARNESSES: an empty index says nothing about what changed, so it is
# not read as "no gated input was staged", and the answer stays ALL.
test_empty_index() {
  local repo
  repo="$(gs_repo)"
  gs_expect "$repo" full yes ALL
}
assert_success "an empty index is full/yes/ALL, not a vacuous narrow pass, gated harnesses included" \
  test_empty_index

# A NON-Markdown product/ path, and that is not an accident. Every path the
# /chart layer actually writes is a .md, so the markdown-docs row above matches
# FIRST and product-docs is never the answer for a real brief. The two rows emit
# the identical `no` / `` pair, so nothing is lost -- but the product-docs row
# has to be exercised through a path only IT can claim, or the assertion would be
# measuring the markdown row a second time.
assert_success "one non-Markdown product/ path is product-docs, no Gradle, no harnesses" \
  gs_case product-docs no "" "$PRODUCT_PATH"

assert_success "an all-Markdown product/ diff is markdown-docs, which emits the same answer" \
  gs_case markdown-docs no "" "product/0001-brief/brief.md"

assert_success "a .prime SKILL.md alone is markdown-docs" \
  gs_case markdown-docs no "" ".prime/agent/skills/ship/SKILL.md"

assert_success "an rfc/NNN-x.md alone is markdown-docs" \
  gs_case markdown-docs no "" "rfc/214-gate-scope.md"

assert_success "CLAUDE.md alone is markdown-docs" \
  gs_case markdown-docs no "" "CLAUDE.md"

assert_success "two Markdown files in different directories are markdown-docs" \
  gs_case markdown-docs no "" "CLAUDE.md" "rfc/README.md"

# A delete is a staged path like any other, and the classification must not
# depend on the file still existing on disk -- a docs deletion is a commit
# someone really makes.
test_deleted_markdown() {
  local repo
  repo="$(gs_repo)"
  gs_stage "$repo" "rfc/214-gate-scope.md"
  gs_commit "$repo" base
  git -C "$repo" rm -q -- "rfc/214-gate-scope.md"
  gs_expect "$repo" markdown-docs no ""
}
assert_success "a delete-only diff of one Markdown file is markdown-docs" test_deleted_markdown

# The deliberate src/ exclusion. gate-scope refuses to guess whether Gradle
# hashes a .md that sits inside a Kotlin source set, so such a path is NOT
# Markdown for this table's purposes.
#
# DEVIATION FROM THE BRIEF, stated rather than glossed: the brief predicted
# `full`. The exclusion only removes the path from ALL_MARKDOWN; the path is
# still under a module's src/ tree, so the next row that matches is
# `module-source` -- which is what gate-scope emits, and which is SAFE: it keeps
# gradle=yes, the whole point of the exclusion. The load-bearing claims are
# asserted explicitly below: not markdown-docs, and Gradle still runs.
test_invariants_md_in_a_src_tree() {
  local repo
  repo="$(gs_repo)"
  gs_modules "$repo"
  gs_stage "$repo" "service/src/main/kotlin/ed/unicoach/INVARIANTS.md"
  gs_expect "$repo" module-source yes "$MODULE_SOURCE_SCOPE_HARNESSES" || return 1
  [ "$GS_SCOPE" != "markdown-docs" ] || return 1
  [ "$GS_GRADLE" = "yes" ]
}
assert_success "a .md inside a module src/ tree is NOT markdown-docs and keeps gradle=yes" \
  test_invariants_md_in_a_src_tree

echo "==== classification: prime-scripts ===="

# The three observing harnesses, minus docs-scripts-tests: a ship script is not
# one of its inputs (PATH_GATED_HARNESSES), so prime-scripts drops it.
assert_success "one .prime ship script is prime-scripts: ship- and db-scripts-tests, not docs" \
  gs_case prime-scripts no "ship-scripts-tests db-scripts-tests" ".prime/agent/skills/ship/scripts/ship-lock"

assert_success "a .prime Markdown file plus a .prime script is prime-scripts, not markdown-docs" \
  gs_case prime-scripts no "ship-scripts-tests db-scripts-tests" \
  ".prime/agent/skills/ship/SKILL.md" ".prime/agent/skills/ship/scripts/ship-lock"

# A .prime .md AND a product/ .md: every path is Markdown, so the markdown-docs
# row matches FIRST and wins -- before product-docs, and before prime-scripts.
#
# That is safe, and the order is deliberate: where two rows could both match, the
# WEAKER claim wins. markdown-docs and product-docs emit the identical answer
# (no Gradle, no harnesses), so nothing is lost there. Against prime-scripts the
# markdown row is the weaker one, and it is justified by a different piece of
# evidence: the Markdown claim is about a file's READERS -- nothing but
# `deno fmt` reads a .md in this repo, and bin/format -c runs on every path
# through bin/pre-commit -- not about which directory it sits in.
assert_success "a .prime Markdown file plus a product/ doc is markdown-docs (the weaker row wins)" \
  gs_case markdown-docs no "" ".prime/agent/skills/ship/SKILL.md" "product/0001-brief/brief.md"

echo "==== classification: module-source, ios-app, and the full fallbacks ===="

assert_success "one module src .kt is module-source, gradle=yes, scripts-tests" \
  gs_module_case module-source yes "$MODULE_SOURCE_SCOPE_HARNESSES" "service/src/main/kotlin/X.kt"

assert_success "two files in one module's src tree are module-source" \
  gs_module_case module-source yes "$MODULE_SOURCE_SCOPE_HARNESSES" \
  "service/src/main/kotlin/X.kt" "service/src/test/kotlin/XTest.kt"

assert_success "files in two different modules' src trees are module-source" \
  gs_module_case module-source yes "$MODULE_SOURCE_SCOPE_HARNESSES" \
  "service/src/main/kotlin/X.kt" "db/src/main/kotlin/Y.kt"

# settings.gradle.kts is the source of truth for what a module is. A src/ path
# under a directory it does not name falls back to full, which is the safe
# direction.
assert_success "a src/ path under a directory settings.gradle.kts does not name is full-gated" \
  gs_module_case full-gated yes "$FULL_UNGATED" "nope/src/main/kotlin/X.kt"

assert_success "one bin/ path is full" \
  gs_case full yes ALL "bin/gate-scope"

# db IS a module in the fixture, but db/schema/ is not db/src/: a migration is a
# build input no narrow row claims.
assert_success "one db/schema/ path is full-gated" \
  gs_module_case full-gated yes "$FULL_UNGATED" "db/schema/add-thing.sql"

# NOT a narrow row, and the absence is the assertion. An `infra` scope was
# proposed and removed: bin/scripts-tests really does observe infra/ -- it greps
# infra/files/deploy-on-instance.sh, loops over infra/files/unicoach-*.service,
# seds infra/rds.tf, and runs infra/files/render-env.sh and `bash -n` over
# infra/files/*.sh. Removing the tofu assertions did not make infra/ unobserved.
assert_success "one infra/ path alone is full-gated -- bin/scripts-tests observes infra/" \
  gs_case full-gated yes "$FULL_UNGATED" "infra/rds.tf"

# Rule 2: the diff is judged AS A WHOLE. Two narrow paths from different rows are
# not two narrow commits.
assert_success "infra/ plus a .kt is full-gated" \
  gs_module_case full-gated yes "$FULL_UNGATED" "infra/rds.tf" "service/src/main/kotlin/X.kt"

assert_success "a .kt plus a Markdown file is full-gated" \
  gs_module_case full-gated yes "$FULL_UNGATED" "service/src/main/kotlin/X.kt" "CLAUDE.md"

# Scope `ios-app`. None of the harnesses bin/shell-tests runs mentions ios-app,
# it is not a Gradle module, and bin/ios-scripts-tests -- the one thing that does
# read the real ios-app/env files -- is carved out of bin/shell-tests by name and
# never ran at the gate anyway.
assert_success "one ios-app Swift file is ios-app, no Gradle, no harnesses" \
  gs_case ios-app no "" "ios-app/UnicoachiOS/A.swift"

assert_success "two ios-app paths are ios-app" \
  gs_case ios-app no "" "ios-app/UnicoachiOS/A.swift" "ios-app/env/prod.env"

assert_success "an ios-app path plus a .kt is full-gated" \
  gs_module_case full-gated yes "$FULL_UNGATED" "ios-app/UnicoachiOS/A.swift" "service/src/main/kotlin/X.kt"

# ios-app/DESIGN.md ALONE is markdown-docs, not ios-app: the markdown row is
# checked FIRST, and where two rows both match the weaker claim wins. Both rows
# emit the same `no` / `` pair here, so the choice costs nothing -- but the
# markdown row rests on different evidence (nothing but `deno fmt` reads a .md,
# and bin/format -c runs on every path through bin/pre-commit), which is the
# claim that stays true if the ios-app row is ever narrowed.
assert_success "ios-app/DESIGN.md alone is markdown-docs, not ios-app" \
  gs_case markdown-docs no "" "ios-app/DESIGN.md"

echo "==== fail-closed: renames and pathological names ===="

# Rule 4. --no-renames decomposes a rename into its delete and its add, so BOTH
# sides are classified. Without it --name-only prints only the DESTINATION, and a
# script would be smuggled into bin/ wearing the source path's scope.
test_rename_out_of_prime() {
  local repo
  repo="$(gs_repo)"
  gs_stage "$repo" ".prime/x/SKILL.md"
  gs_commit "$repo" base
  mkdir -p "$repo/bin"
  git -C "$repo" mv -- ".prime/x/SKILL.md" "bin/x"
  gs_expect "$repo" full yes ALL
}
assert_success "a rename from .prime/x/SKILL.md to bin/x is full, not markdown-docs" \
  test_rename_out_of_prime

# The same mechanism the other way: both sides are inside .prime/, so the set is
# still all-.prime -- but no longer all-Markdown, because the destination is a
# script. prime-scripts -- and of the three observing harnesses only
# db-scripts-tests, because .prime/x/ is neither gated harness's input.
test_rename_inside_prime_md_to_script() {
  local repo
  repo="$(gs_repo)"
  gs_stage "$repo" ".prime/x/SKILL.md"
  gs_commit "$repo" base
  git -C "$repo" mv -- ".prime/x/SKILL.md" ".prime/x/tool"
  gs_expect "$repo" prime-scripts no "db-scripts-tests"
}
assert_success "a rename inside .prime/ from a .md to a script is prime-scripts" \
  test_rename_inside_prime_md_to_script

# -z with `read -r -d ''`. If the newline split the path in two, the second half
# ("ird") would be outside .prime/ and the answer would be `full`; prime-scripts
# is therefore the assertion that the path stayed whole.
test_newline_in_a_path() {
  local repo path
  repo="$(gs_repo)"
  path=$'.prime/we\nird'
  gs_stage "$repo" "$path"
  local staged=() entry
  while IFS= read -r -d '' entry; do staged+=("$entry"); done \
    < <(git -C "$repo" diff --cached --name-only -z --no-renames)
  [ "${#staged[@]}" -eq 1 ] && [ "${staged[0]}" = "$path" ] ||
    { log-error "the fixture staged [${#staged[@]}] path(s), expected the one newline-bearing path"; return 1; }
  gs_expect "$repo" prime-scripts no "db-scripts-tests"
}
assert_success "a path containing a newline is classified whole, not split in two" \
  test_newline_in_a_path

# A top-level directory whose name has a LEADING SPACE is not .prime/, and the
# `case` must not treat it as one. This is a demonstrated defect shape in this
# repo, not a hypothetical. The same space keeps it from matching the ship
# harness's .prime/agent/skills/ship/ input, so neither gated harness runs.
assert_success "a top-level directory named ' .prime' (leading space) is full-gated, not prime-scripts" \
  gs_case full-gated yes "$FULL_UNGATED" " .prime/agent/skills/ship/scripts/ship-lock"

echo "==== path-gated harnesses: ship- and docs-scripts-tests run only on their inputs ===="

# PATH_GATED_HARNESSES is a filter over every row: a gated harness stays in a
# scope's list only when ANY staged path is one of its inputs. These cases pin
# both directions -- dropped when nothing it reads changed, kept the moment one
# thing it reads did -- across `full` and `prime-scripts`, the two rows whose
# lists ever name a gated harness.

# The commit that prompted the table (RFC 262's shape): Kotlin, its RFC, and a
# public-web resource. Mixed, so `full`, and nothing in it is a skill directory,
# bin/ or the flake -- so neither workflow harness runs, and every other one
# still does.
test_rfc_262_shape_skips_both_workflow_harnesses() {
  local repo
  repo="$(gs_repo)"
  gs_modules "$repo"
  gs_stage "$repo" "service/src/main/kotlin/X.kt" "rfc/262-money-plan.md" \
    "public-web/src/main/resources/static/css/site.css"
  gs_expect "$repo" full-gated yes "$FULL_UNGATED" || return 1
  case " $GS_HARNESSES " in
  *" ship-scripts-tests "* | *" docs-scripts-tests "*)
    log-error "a workflow harness survived: [$GS_HARNESSES]"; return 1 ;;
  esac
  case " $GS_HARNESSES " in
  *" scripts-tests "*) ;;
  *) log-error "scripts-tests went missing: [$GS_HARNESSES]"; return 1 ;;
  esac
}
assert_success "Kotlin + rfc/*.md + public-web resources is full-gated without ship- or docs-scripts-tests" \
  test_rfc_262_shape_skips_both_workflow_harnesses

assert_success "a mixed set with one .prime/agent/skills/ship/ path runs ship-scripts-tests, not docs" \
  gs_module_case full-gated yes "$FULL_WITH_SHIP" \
  "service/src/main/kotlin/X.kt" ".prime/agent/skills/ship/scripts/ship-lock"

assert_success "a mixed set with one .prime/agent/skills/chart/ path runs docs-scripts-tests, not ship" \
  gs_module_case full-gated yes "$FULL_WITH_DOCS" \
  "service/src/main/kotlin/X.kt" ".prime/agent/skills/chart/scripts/docs-land"

# The ship driver's test_applicability reads the real tier manifest, so a mixed
# commit that touches it runs ship-scripts-tests.
assert_success "a mixed set with .claude/skills/review-fix/tiers.md runs ship-scripts-tests, not docs" \
  gs_module_case full-gated yes "$FULL_WITH_SHIP" \
  "service/src/main/kotlin/X.kt" ".claude/skills/review-fix/tiers.md"

# bin/ and the flake are inputs of BOTH, and with nothing skipped `full` is ALL
# again rather than a list that happens to name everything.
assert_success "a mixed set with one bin/ path is full with harnesses=ALL" \
  gs_module_case full yes ALL "service/src/main/kotlin/X.kt" "bin/test"

assert_success "a mixed set with flake.lock is full with harnesses=ALL" \
  gs_module_case full yes ALL "service/src/main/kotlin/X.kt" "flake.lock"

assert_success "flake.nix alone is full with harnesses=ALL" \
  gs_case full yes ALL "flake.nix"

# The scope NAME is the verdict ship-verified records, not a label. `full` is
# recorded as the bare tree -- "the whole gate passed here", no condition --
# and any other name against the parent tree, accepted at land only on a parent
# already on the base branch. A filtered full skipped harnesses a --no-verify
# WIP commit below it may have broken, so it is "green if the parent was" and
# must not be called `full`. This pins both halves side by side: the same
# fallback, one path apart, is `full-gated` with a gated harness dropped and
# `full` with nothing dropped.
test_filtered_full_is_full_gated_and_unfiltered_full_is_full() {
  local repo
  repo="$(gs_repo)"
  gs_modules "$repo"
  gs_stage "$repo" "service/src/main/kotlin/X.kt" "CLAUDE.md"
  gs_expect "$repo" full-gated yes "$FULL_UNGATED" || return 1
  gs_stage "$repo" "bin/test"
  gs_expect "$repo" full yes ALL
}
assert_success "a filtered full is full-gated (parent-conditional); an unfiltered full is full" \
  test_filtered_full_is_full_gated_and_unfiltered_full_is_full

# prime-scripts: the three observing harnesses, each gated one kept only for its
# own skill. db-scripts-tests is not gated -- it executes ship-order, and that
# claim is PRIME_HARNESSES', not this table's.
assert_success "a .prime chart script alone is prime-scripts: docs- and db-scripts-tests only" \
  gs_case prime-scripts no "docs-scripts-tests db-scripts-tests" ".prime/agent/skills/chart/scripts/docs-land"

assert_success "a .prime slice script alone is prime-scripts: db-scripts-tests only" \
  gs_case prime-scripts no "db-scripts-tests" ".prime/agent/skills/slice/scripts/slice-board"

assert_success "a ship script and a chart script together are prime-scripts with all three" \
  gs_case prime-scripts no "ship-scripts-tests docs-scripts-tests db-scripts-tests" \
  ".prime/agent/skills/ship/scripts/ship-lock" ".prime/agent/skills/chart/scripts/docs-land"

# The near misses: a sibling directory whose name STARTS with the input's, and a
# top-level directory whose name starts with `bin`. Each would run a harness
# under a match without the trailing slash.
assert_success "a .prime/agent/skills/shipper/ script does not run ship-scripts-tests" \
  gs_case prime-scripts no "db-scripts-tests" ".prime/agent/skills/shipper/scripts/x"

assert_success "a binary/ path in a mixed set runs neither workflow harness" \
  gs_module_case full-gated yes "$FULL_UNGATED" "service/src/main/kotlin/X.kt" "binary/x"

# A delete is a staged path, and deleting a script the harness drives breaks it.
test_deleted_chart_script_runs_docs() {
  local repo
  repo="$(gs_repo)"
  gs_stage "$repo" ".prime/agent/skills/chart/scripts/docs-land"
  gs_commit "$repo" base
  git -C "$repo" rm -q -- ".prime/agent/skills/chart/scripts/docs-land"
  gs_expect "$repo" prime-scripts no "docs-scripts-tests db-scripts-tests"
}
assert_success "deleting a chart script runs docs-scripts-tests" test_deleted_chart_script_runs_docs

# --no-renames: a rename OUT of the chart skill counts on its source side.
test_rename_out_of_chart_runs_docs() {
  local repo
  repo="$(gs_repo)"
  gs_stage "$repo" ".prime/agent/skills/chart/scripts/docs-land"
  gs_commit "$repo" base
  mkdir -p "$repo/.prime/agent/skills/slice/scripts"
  git -C "$repo" mv -- ".prime/agent/skills/chart/scripts/docs-land" \
    ".prime/agent/skills/slice/scripts/docs-land"
  gs_expect "$repo" prime-scripts no "docs-scripts-tests db-scripts-tests"
}
assert_success "a rename out of .prime/agent/skills/chart/ runs docs-scripts-tests" \
  test_rename_out_of_chart_runs_docs

# The decision reaches stderr by name, for each gated harness, so a hook log says
# which ran and which staged path made it run.
test_gated_reason_on_stderr() {
  local repo
  repo="$(gs_repo)"
  gs_modules "$repo"
  gs_stage "$repo" "service/src/main/kotlin/X.kt" ".prime/agent/skills/ship/scripts/ship-lock"
  gs_expect "$repo" full-gated yes "$FULL_WITH_SHIP" || return 1
  grep -q 'path-gated harness ship-scripts-tests: runs .*\[\.prime/agent/skills/ship/scripts/ship-lock\]' "$GS_ERR" ||
    { log-error "stderr does not name the ship trigger: [$(cat "$GS_ERR")]"; return 1; }
  grep -q 'path-gated harness docs-scripts-tests: skipped' "$GS_ERR" ||
    { log-error "stderr does not say docs-scripts-tests was skipped: [$(cat "$GS_ERR")]"; return 1; }
}
assert_success "each gated harness's run-or-skip decision and its trigger are logged to stderr" \
  test_gated_reason_on_stderr

echo "==== fail-closed: rule 5, the anti-orphan sweep ===="

# gate-scope sweeps "$PROJECT_ROOT"/bin/*scripts-tests -- the checkout the SCRIPT
# lives in, not the repository -r names. bin/common derives PROJECT_ROOT from
# bin/common's own location, so the honest way to exercise the sweep is to run a
# COPY of gate-scope out of a fixture bin/ alongside copies of the two files it
# sources. Nothing in bin/gate-scope is changed to make this testable.
gs_guard_root() {
  local root
  root="$(mktemp -d "$FIXTURE_DIR/guard.XXXXXX")"
  mkdir -p "$root/bin"
  cp "$PROJECT_ROOT/bin/gate-scope" "$PROJECT_ROOT/bin/common" "$PROJECT_ROOT/bin/functions" "$root/bin/"
  # The copy sources bin/common, which layers the dotenvs relative to the
  # fixture's own PROJECT_ROOT, so the fixture carries them too.
  cp "$PROJECT_ROOT/.env" "$PROJECT_ROOT/.env.dev" "$PROJECT_ROOT/.env.test" "$root/"
  cp "$PROJECT_ROOT/settings.gradle.kts" "$root/"
  git init -q -b main "$root" > /dev/null
  git -C "$root" config user.email "tests@example.com"
  git -C "$root" config user.name "gate-scope-scripts-tests"
  printf '%s\n' "$root"
}

GUARD_ROOT="$(gs_guard_root)"
GUARD_SCOPE="$GUARD_ROOT/bin/gate-scope"

# Sanity: the copy is a working gate-scope before any orphan is planted. Without
# this, a fatal below could be the fixture failing to run at all.
test_guard_copy_works() {
  local repo
  repo="$(gs_repo)"
  gs_stage "$repo" "$PRODUCT_PATH"
  GS_SCRIPT="$GUARD_SCOPE" gs_classify "$repo"
  [ "$GS_STATUS" -eq 0 ] ||
    { log-error "the copied gate-scope exited [$GS_STATUS]: [$(head -5 "$GS_ERR")]"; return 1; }
  [ "$GS_SCOPE" = "product-docs" ]
}
assert_success "the fixture copy of gate-scope runs and classifies normally" test_guard_copy_works

: > "$GUARD_ROOT/bin/zzz-scripts-tests"

# The orphan must halt an EMPTY-index (`full`) run too. Failing only on a narrow
# diff would hide the orphan exactly when it costs least and surprise someone
# later, when it costs most.
test_orphan_fatals_on_a_full_diff() {
  local repo
  repo="$(gs_repo)"
  GS_SCRIPT="$GUARD_SCOPE" gs_classify "$repo"
  [ "$GS_STATUS" -ne 0 ] ||
    { log-error "an undeclared harness did not fail a full diff; stdout [$(cat "$GS_OUT")]"; return 1; }
  grep -q 'zzz-scripts-tests' "$GS_ERR" ||
    { log-error "the fatal does not name the harness: [$(cat "$GS_ERR")]"; return 1; }
  [ ! -s "$GS_OUT" ] ||
    { log-error "a fatal run still wrote to stdout: [$(cat "$GS_OUT")]"; return 1; }
}
assert_success "an undeclared bin/*scripts-tests fatals by name on a full diff" \
  test_orphan_fatals_on_a_full_diff

test_orphan_fatals_on_a_narrow_diff() {
  local repo
  repo="$(gs_repo)"
  gs_stage "$repo" "$PRODUCT_PATH"
  GS_SCRIPT="$GUARD_SCOPE" gs_classify "$repo"
  [ "$GS_STATUS" -ne 0 ] ||
    { log-error "an undeclared harness did not fail a narrow diff; stdout [$(cat "$GS_OUT")]"; return 1; }
  grep -q 'zzz-scripts-tests' "$GS_ERR"
}
assert_success "an undeclared bin/*scripts-tests fatals by name on a narrow diff too" \
  test_orphan_fatals_on_a_narrow_diff

rm -f "$GUARD_ROOT/bin/zzz-scripts-tests"
: > "$GUARD_ROOT/bin/ios-scripts-tests"

# The one deliberate exclusion, carved out BY NAME so a future omission cannot be
# swallowed by a pattern.
test_ios_is_carved_out() {
  local repo
  repo="$(gs_repo)"
  gs_stage "$repo" "$PRODUCT_PATH"
  GS_SCRIPT="$GUARD_SCOPE" gs_classify "$repo"
  [ "$GS_STATUS" -eq 0 ] ||
    { log-error "ios-scripts-tests caused a fatal: [$(cat "$GS_ERR")]"; return 1; }
  [ "$GS_SCOPE" = "product-docs" ]
}
assert_success "bin/ios-scripts-tests present causes no fatal (carved out by name)" \
  test_ios_is_carved_out

rm -f "$GUARD_ROOT/bin/ios-scripts-tests"
GS_SCRIPT=""

echo "==== cross-sweeps over the real bin/*scripts-tests ===="

# BOTH SIDES ARE DERIVED. Hardcoding the three names here and comparing them to
# the three names in gate-scope would assert nothing at all: the test would agree
# with itself while the harnesses drifted underneath both.
#
# THIS FILE IS EXCLUDED FROM THE MENTION SWEEPS, by name, and the reason is worth
# stating because an exclusion is exactly how a sweep goes quiet. The strings
# `.prime/...` above are FIXTURE PATHS inside throwaway repos under mktemp; this
# harness never reads, runs or stages anything in the real .prime/ tree, so no
# change under .prime/ can change its result. What it does observe is bin/ -- the
# harness files themselves -- and bin/ is `full` in every scope. The exclusion is
# by exact name, so it cannot swallow any other harness.
SWEEP_EXCLUSIONS=(gate-scope-scripts-tests)

# DECLARED_KNOWN, and the declared_value / declared_array readers, are defined
# above the classification cases, which derive their expected `full` list from it.
DECLARED_PRIME="$(declared_value PRIME_HARNESSES)"
DECLARED_MODULE_SOURCE="$(declared_value MODULE_SOURCE_HARNESSES)"

# PATH_GATED_HARNESSES, as `<harness>:<input>` pairs, and the harness names it
# gates, each once.
DECLARED_GATED_PAIRS=()
while IFS= read -r line; do
  [ -n "$line" ] && DECLARED_GATED_PAIRS+=("$line")
done < <(declared_array PATH_GATED_HARNESSES)
DECLARED_GATED=()
for pair in ${DECLARED_GATED_PAIRS[@]+"${DECLARED_GATED_PAIRS[@]}"}; do
  list_contains "${pair%%:*}" ${DECLARED_GATED[@]+"${DECLARED_GATED[@]}"} ||
    DECLARED_GATED+=("${pair%%:*}")
done

# Each derivation must actually have found something. A sed that stopped matching
# would otherwise turn every sweep below into a loop over nothing.
test_declarations_were_read() {
  [ -n "$DECLARED_PRIME" ] || { log-error "could not read PRIME_HARNESSES out of bin/gate-scope"; return 1; }
  [ -n "$DECLARED_MODULE_SOURCE" ] || { log-error "could not read MODULE_SOURCE_HARNESSES"; return 1; }
  [ "${#DECLARED_KNOWN[@]}" -ge 2 ] || { log-error "could not read KNOWN_HARNESSES"; return 1; }
  [ "${#DECLARED_GATED[@]}" -ge 2 ] || { log-error "could not read PATH_GATED_HARNESSES"; return 1; }
}
assert_success "the four declarations are readable out of bin/gate-scope" \
  test_declarations_were_read

# PATH_GATED_HARNESSES is a filter over KNOWN_HARNESSES. A gated name KNOWN does
# not hold gates nothing -- the harness it meant would run on every commit, or
# never, depending on the typo -- so every key must be a known harness.
test_every_gated_harness_is_known() {
  local harness unknown=()
  for harness in ${DECLARED_GATED[@]+"${DECLARED_GATED[@]}"}; do
    list_contains "$harness" "${DECLARED_KNOWN[@]}" || unknown+=("$harness")
  done
  [ "${#unknown[@]}" -eq 0 ] ||
    { log-error "PATH_GATED_HARNESSES gates name(s) absent from KNOWN_HARNESSES: ${unknown[*]}"; return 1; }
}
assert_success "every PATH_GATED_HARNESSES harness is in KNOWN_HARNESSES" \
  test_every_gated_harness_is_known

# An input that no longer exists is a rename the table missed: the renamed
# path's changes would then run the harness nowhere.
test_every_gated_input_exists() {
  local pair missing=()
  for pair in ${DECLARED_GATED_PAIRS[@]+"${DECLARED_GATED_PAIRS[@]}"}; do
    [ -e "$PROJECT_ROOT/${pair#*:}" ] || missing+=("$pair")
  done
  [ "${#missing[@]}" -eq 0 ] ||
    { log-error "PATH_GATED_HARNESSES names input(s) absent from this checkout: ${missing[*]}"; return 1; }
}
assert_success "every PATH_GATED_HARNESSES input exists in this checkout" \
  test_every_gated_input_exists

# A harness's own file is the first thing that can change its answer. bin/
# covers both today; this holds that if the bin/ entry is ever narrowed.
test_every_gated_harness_file_is_its_own_input() {
  local harness pair covered uncovered=()
  for harness in ${DECLARED_GATED[@]+"${DECLARED_GATED[@]}"}; do
    covered=0
    for pair in "${DECLARED_GATED_PAIRS[@]}"; do
      [ "${pair%%:*}" = "$harness" ] || continue
      case "${pair#*:}" in
      */) case "bin/$harness" in "${pair#*:}"*) covered=1 ;; esac ;;
      *) [ "bin/$harness" = "${pair#*:}" ] && covered=1 ;;
      esac
    done
    [ "$covered" -eq 1 ] || uncovered+=("$harness")
  done
  [ "${#uncovered[@]}" -eq 0 ] ||
    { log-error "gated harness(es) whose own bin/ file is not one of their inputs: ${uncovered[*]}"; return 1; }
}
assert_success "every gated harness's own bin/<name> is one of its PATH_GATED_HARNESSES inputs" \
  test_every_gated_harness_file_is_its_own_input

# FUZZ_INPUTS mirrors bin/test-fuzz by hand, so hold it to the real tree from
# both sides that can be derived. An entry that no longer exists is a rename the
# list missed (that path's successor would fuzz nowhere). An env layer the
# harness names in ENV_FILES, plus the .env bin/common always reads, that the
# list lacks is a config change that lands unfuzzed.
DECLARED_FUZZ=()
while IFS= read -r line; do
  [ -n "$line" ] && DECLARED_FUZZ+=("$line")
done < <(declared_array FUZZ_INPUTS)

test_every_fuzz_input_exists() {
  local entry missing=()
  [ "${#DECLARED_FUZZ[@]}" -ge 2 ] || { log-error "could not read FUZZ_INPUTS out of bin/gate-scope"; return 1; }
  for entry in "${DECLARED_FUZZ[@]}"; do
    [ -e "$PROJECT_ROOT/$entry" ] || missing+=("$entry")
  done
  [ "${#missing[@]}" -eq 0 ] ||
    { log-error "FUZZ_INPUTS names path(s) absent from this checkout: ${missing[*]}"; return 1; }
}
assert_success "every FUZZ_INPUTS entry exists in this checkout" test_every_fuzz_input_exists

test_every_fuzz_env_layer_is_an_input() {
  local env_files layer missing=()
  env_files="$(sed -n 's/^export ENV_FILES="\(.*\)"$/\1/p' "$PROJECT_ROOT/bin/test-fuzz")"
  [ -n "$env_files" ] || { log-error "could not read ENV_FILES out of bin/test-fuzz"; return 1; }
  for layer in .env ${env_files//:/ }; do
    list_contains "$layer" "${DECLARED_FUZZ[@]}" || missing+=("$layer")
  done
  [ "${#missing[@]}" -eq 0 ] ||
    { log-error "env layer(s) bin/test-fuzz reads but FUZZ_INPUTS lacks: ${missing[*]}"; return 1; }
}
assert_success "every env layer bin/test-fuzz reads is a FUZZ_INPUTS entry" \
  test_every_fuzz_env_layer_is_an_input

# The sweep gate-scope's own comment describes: by literal `.prime/` MENTION, not
# by resolved path, because ship- and docs-scripts-tests compose their targets
# through a variable ("$SHIP_SCRIPTS/ship-lock") and an exact-path map would not
# see them at all.
test_every_prime_mentioning_harness_is_declared() {
  local path harness found=0 missing=()
  for path in "$PROJECT_ROOT"/bin/*scripts-tests; do
    [ -e "$path" ] || continue
    harness="$(basename "$path")"
    list_contains "$harness" "${SWEEP_EXCLUSIONS[@]}" && continue
    grep -q '\.prime/' "$path" || continue
    found=$((found + 1))
    list_contains "$harness" $DECLARED_PRIME || missing+=("$harness")
  done
  [ "$found" -gt 0 ] ||
    { log-error "no harness mentions .prime/ -- the sweep found nothing to check"; return 1; }
  [ "${#missing[@]}" -eq 0 ] ||
    { log-error "harness(es) reading .prime/ but absent from PRIME_HARNESSES: ${missing[*]}"; return 1; }
}
assert_success "every bin/*scripts-tests that mentions .prime/ is named in PRIME_HARNESSES" \
  test_every_prime_mentioning_harness_is_declared

# The residue gate-scope's markdown-docs row states: its evidence is that no
# harness reads a real .md. A harness that named a literal .prime/**/*.md path
# would break that, and the markdown row would then be skipping a harness that
# observes the change. Nothing does today; this is what keeps it that way.
test_no_harness_names_a_prime_markdown_path() {
  local path harness hits offenders=()
  for path in "$PROJECT_ROOT"/bin/*scripts-tests; do
    [ -e "$path" ] || continue
    harness="$(basename "$path")"
    list_contains "$harness" "${SWEEP_EXCLUSIONS[@]}" && continue
    hits="$(grep -o '\.prime/[^ "'"'"']*\.md' "$path" || true)"
    [ -z "$hits" ] || offenders+=("$harness: $(printf '%s' "$hits" | tr '\n' ' ')")
  done
  [ "${#offenders[@]}" -eq 0 ] ||
    { log-error "harness(es) naming a literal .prime/**.md path: ${offenders[*]}"; return 1; }
}
assert_success "no bin/*scripts-tests names a literal path under .prime/ ending .md" \
  test_no_harness_names_a_prime_markdown_path

# A declared name that does not exist, or is not executable, is a scope promising
# to run something the gate cannot run. KNOWN_HARNESSES is included because a
# filtered `full` spells it out as an explicit -n list.
test_declared_harnesses_exist_and_run() {
  local harness broken=()
  for harness in $DECLARED_PRIME $DECLARED_MODULE_SOURCE "${DECLARED_KNOWN[@]}" \
    ${DECLARED_GATED[@]+"${DECLARED_GATED[@]}"}; do
    [ -x "$PROJECT_ROOT/bin/$harness" ] || broken+=("$harness")
  done
  [ "${#broken[@]}" -eq 0 ] ||
    { log-error "declared harness(es) missing or not executable in bin/: ${broken[*]}"; return 1; }
}
assert_success "every name in PRIME, MODULE_SOURCE, KNOWN and PATH_GATED harnesses is an executable in bin/" \
  test_declared_harnesses_exist_and_run

# The static half of rule 5, over the REAL bin/: gate-scope fatals at run time,
# and this says the same thing at test time, with the name.
test_every_real_harness_is_known() {
  local path harness unknown=()
  for path in "$PROJECT_ROOT"/bin/*scripts-tests; do
    [ -e "$path" ] || continue
    harness="$(basename "$path")"
    [ "$harness" = "ios-scripts-tests" ] && continue
    list_contains "$harness" "${DECLARED_KNOWN[@]}" || unknown+=("$harness")
  done
  [ "${#unknown[@]}" -eq 0 ] ||
    { log-error "harness(es) absent from KNOWN_HARNESSES: ${unknown[*]}"; return 1; }
}
assert_success "every bin/*scripts-tests except ios-scripts-tests is in KNOWN_HARNESSES" \
  test_every_real_harness_is_known

echo "==== contract fuzzing: fuzz= says whether bin/test-fuzz must run ===="

# Classify <repo> and expect this fuzz answer. The scope is not asserted here --
# the rows above own it -- only that the run exited 0 and fuzz= is <want>, with
# the exit status and gate-scope's own reason in the failure message.
gs_expect_fuzz() { # <repo> <yes|no>
  gs_classify "$1"
  [ "$GS_STATUS" -eq 0 ] ||
    { log-error "gate-scope exited [$GS_STATUS]: [$(head -3 "$GS_ERR")]"; return 1; }
  [ "$GS_FUZZ" = "$2" ] ||
    { log-error "fuzz=[$GS_FUZZ], expected [$2] (stderr: $(cat "$GS_ERR"))"; return 1; }
}

# Stage these paths in a fresh repo and expect this fuzz answer.
gs_fuzz_case() { # <yes|no> <relpath...>
  local want="$1" repo
  shift
  repo="$(gs_repo)"
  gs_modules "$repo"
  gs_stage "$repo" "$@"
  gs_expect_fuzz "$repo" "$want"
}

assert_success "the REST contract alone fuzzes" gs_fuzz_case yes "api-specs/openapi.yaml"
assert_success "bin/test-fuzz alone fuzzes" gs_fuzz_case yes "bin/test-fuzz"
assert_success "tools/fuzz/uv.lock alone fuzzes" gs_fuzz_case yes "tools/fuzz/uv.lock"
assert_success "tools/fuzz/pyproject.toml alone fuzzes" gs_fuzz_case yes "tools/fuzz/pyproject.toml"
assert_success "schemathesis.toml alone fuzzes" gs_fuzz_case yes "schemathesis.toml"
assert_success ".env.fuzz alone fuzzes" gs_fuzz_case yes ".env.fuzz"
assert_success ".env.dev alone fuzzes" gs_fuzz_case yes ".env.dev"
assert_success ".env alone fuzzes" gs_fuzz_case yes ".env"
assert_success ".env.test (not a layer bin/test-fuzz reads) does not fuzz" gs_fuzz_case no ".env.test"
assert_success "one fuzz input in a mixed set fuzzes" \
  gs_fuzz_case yes "service/src/main/kotlin/A.kt" "CLAUDE.md" "tools/fuzz/uv.lock"

# The near misses: a sibling of an exact entry, a prefix of the directory entry,
# and the directory entry's name as a file. Each would fuzz under a sloppier
# match, and each costs a multi-minute run it cannot need.
assert_success "another bin/ script does not fuzz" gs_fuzz_case no "bin/test"
assert_success "bin/test-fuzz-notes (a longer name) does not fuzz" gs_fuzz_case no "bin/test-fuzz-notes"
assert_success "tools/fuzzer/x (a prefix of tools/fuzz/) does not fuzz" gs_fuzz_case no "tools/fuzzer/x"
assert_success "a Kotlin route change does not fuzz" \
  gs_fuzz_case no "rest-server/src/main/kotlin/Routing.kt"
assert_success "a Markdown change does not fuzz" gs_fuzz_case no "CLAUDE.md"

test_empty_index_does_not_fuzz() {
  local repo
  repo="$(gs_repo)"
  gs_expect "$repo" full yes ALL || return 1
  gs_expect_fuzz "$repo" no
}
assert_success "an empty index does not fuzz (nothing staged can change the answer)" \
  test_empty_index_does_not_fuzz

# Deleting the lock breaks fuzzing, so a delete-only diff must fuzz.
test_deleted_lock_fuzzes() {
  local repo
  repo="$(gs_repo)"
  gs_stage "$repo" "tools/fuzz/uv.lock"
  gs_commit "$repo" base
  git -C "$repo" rm -q -- "tools/fuzz/uv.lock"
  gs_expect_fuzz "$repo" yes
}
assert_success "deleting tools/fuzz/uv.lock fuzzes" test_deleted_lock_fuzzes

# A rename OUT of tools/fuzz/ counts on its source side (--no-renames).
test_rename_out_of_fuzz_fuzzes() {
  local repo
  repo="$(gs_repo)"
  gs_stage "$repo" "tools/fuzz/pyproject.toml"
  gs_commit "$repo" base
  git -C "$repo" mv -- "tools/fuzz/pyproject.toml" "tools/pyproject.toml"
  gs_expect_fuzz "$repo" yes
}
assert_success "a rename out of tools/fuzz/ fuzzes" test_rename_out_of_fuzz_fuzzes

# The decision reaches stderr by name, so a hook log says why fuzzing ran.
test_fuzz_reason_on_stderr() {
  local repo
  repo="$(gs_repo)"
  gs_stage "$repo" "bin/test-fuzz"
  gs_classify "$repo"
  grep -q 'contract fuzzing: yes -- \[bin/test-fuzz\]' "$GS_ERR" ||
    { log-error "stderr does not name the fuzz input: [$(cat "$GS_ERR")]"; return 1; }
}
assert_success "the fuzz decision and the input that caused it are logged to stderr" \
  test_fuzz_reason_on_stderr

echo "==== the grammar and the streams ===="

USAGE_REPO="$(gs_repo)"
NON_GIT_DIR="$(mktemp -d "$FIXTURE_DIR/plain.XXXXXX")"

assert_exit_code "$EXIT_UNKNOWN_OPTION" "gate-scope rejects an unknown option" \
  "$GATE_SCOPE" -Z
assert_exit_code "$EXIT_OPTION_REQUIRES_VALUE" "gate-scope rejects -r with no value" \
  "$GATE_SCOPE" -r
assert_exit_code "$EXIT_UNEXPECTED_ARG" "gate-scope rejects a positional argument" \
  "$GATE_SCOPE" -r "$USAGE_REPO" extra
assert_exit_code "$EXIT_INVALID_ARG_VALUE" "gate-scope rejects an empty -r" \
  "$GATE_SCOPE" -r ""
assert_exit_code "$EXIT_INVALID_ARG_VALUE" "gate-scope rejects a -r that does not exist" \
  "$GATE_SCOPE" -r "$FIXTURE_DIR/no-such-directory"
assert_exit_code "$EXIT_INVALID_ARG_VALUE" "gate-scope rejects a -r that is not a git repository" \
  "$GATE_SCOPE" -r "$NON_GIT_DIR"

# stdout carries only what the caller explicitly asked for, and -h is the one
# thing they can ask for.
test_help_on_stdout() {
  local out err
  out="$(mktemp "$FIXTURE_DIR/h-out.XXXXXX")"; err="$(mktemp "$FIXTURE_DIR/h-err.XXXXXX")"
  "$GATE_SCOPE" -h > "$out" 2> "$err" || { log-error "-h exited non-zero"; return 1; }
  grep -q 'gate-scope \[options\]' "$out" || { log-error "-h wrote no help to stdout"; return 1; }
  [ ! -s "$err" ] || { log-error "-h wrote to stderr: [$(head -2 "$err")]"; return 1; }
}
assert_success "gate-scope -h writes help to stdout, exits 0, and leaves stderr empty" \
  test_help_on_stdout

# The emptiness is the assertion. This is exactly what regresses when someone
# moves the reason line back onto stdout, and the caller -- bin/pre-commit --
# parses stdout.
test_streams_are_separated() {
  local repo
  repo="$(gs_repo)"
  gs_stage "$repo" "ios-app/UnicoachiOS/A.swift"
  gs_expect "$repo" ios-app no "" || return 1
  [ -s "$GS_ERR" ] || { log-error "no reason was written to stderr"; return 1; }
  grep -q 'gate scope: ios-app' "$GS_ERR" ||
    { log-error "stderr does not carry the reason: [$(cat "$GS_ERR")]"; return 1; }
  grep -q 'ios-app' "$GS_OUT" && [ "$(wc -l < "$GS_OUT" | tr -d ' ')" -eq 4 ]
}
assert_success "a normal run writes only the four key=value lines to stdout, the reason to stderr" \
  test_streams_are_separated

end_tests
