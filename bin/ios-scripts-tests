# -n (no-upload): archives Release for a generic device, signs, injects the build
# number and honored backend URL, exports a local .ipa, and needs NO appstore.env
# and NO upload auth flags.
test_release_no_upload_archives_and_exports() {
  write_signing_env
  rm -f "$ENV_DIR/appstore.env"   # not required on the -n path
  run_release -n explicit-device >/dev/null 2>&1 || return 1
  log_has "archive" || return 1
  log_has "-exportArchive" || return 1
  log_has "-configuration" || return 1
  log_has "Release" || return 1
  log_has "generic/platform=iOS" || return 1
  log_has "DEVELOPMENT_TEAM=$FIXTURE_TEAM" || return 1
  log_has "CODE_SIGN_STYLE=Automatic" || return 1
  log_has "-allowProvisioningUpdates" || return 1
  log_has "UNICOACH_BACKEND_URL=https://api.uni.coach" || return 1
  log_has "CURRENT_PROJECT_VERSION=7" || return 1
  # No upload auth, and the export options select local export.
  log_lacks "-authenticationKeyID" || return 1
  export_option_has "<string>export</string>" || return 1
  export_option_has "<string>app-store-connect</string>" || return 1
  return 0
}

# Default (upload) path requires appstore.env; its absence fails fast before any
# archive.
test_release_upload_requires_appstore() {
  write_signing_env
  rm -f "$ENV_DIR/appstore.env"
  local out
  if out="$(run_release explicit-device 2>&1)"; then return 1; fi
  echo "$out" | grep -q "appstore.env" || return 1
  log_no_tool "xcodebuild"
}

# Default (upload) path forwards the App Store Connect API key as xcodebuild
# -authenticationKey* flags and selects the upload destination.
test_release_upload_forwards_api_key() {
  write_signing_env
  write_appstore_env
  run_release explicit-device >/dev/null 2>&1 || return 1
  log_has "-authenticationKeyID" || return 1
  log_has "$ASC_KEY_ID" || return 1
  log_has "-authenticationKeyIssuerID" || return 1
  log_has "$ASC_ISSUER_ID" || return 1
  log_has "-authenticationKeyPath" || return 1
  log_has "$ASC_KEY_PATH" || return 1
  export_option_has "<string>upload</string>" || return 1
  return 0
}

# A missing .p8 at UNICOACH_ASC_KEY_PATH fails fast, before any archive.
test_release_upload_missing_key_file() {
  write_signing_env
  write_appstore_env
  rm -f "$ASC_KEY_PATH"
  local out
  if out="$(run_release explicit-device 2>&1)"; then return 1; fi
  echo "$out" | grep -q "$ASC_KEY_PATH" || return 1
  log_no_tool "xcodebuild"
}

# The target's UNICOACH_CONFIGURATION=Debug is ignored: a release is always
# archived Release.
test_release_forces_release_config() {
  write_signing_env
  write_appstore_env
  run_release debug-config-device >/dev/null 2>&1 || return 1
  log_has "Release" || return 1
  log_lacks "Debug" || return 1
  return 0
}

# With no pinned build number, release-ios derives one from the repo's HEAD
# commit count and forwards it as CURRENT_PROJECT_VERSION=<digits>.
test_release_derives_build_number_from_git() {
  write_signing_env
  write_appstore_env
  RELEASE_BUILD_NUMBER="" run_release explicit-device >/dev/null 2>&1 || return 1
  grep -Eq "^CURRENT_PROJECT_VERSION=[0-9]+$" "$ARGV_LOG"
}

# A DEPLOY target (UNICOACH_DEPLOY, no explicit URL — the real prod target) makes
# release-ios derive https://api.$APP_DOMAIN from .env.prod, exactly like
# build-ios. Regression guard: release-ios must NOT fall back to the localhost
# derive path for a deploy target.
test_release_deploy_derives_https() {
  write_dotenv "uni.coach"
  write_signing_env
  rm -f "$ENV_DIR/appstore.env"   # -n path needs no upload auth
  run_release -n deploy-device >/dev/null 2>&1 || return 1
  log_has "UNICOACH_BACKEND_URL=https://api.uni.coach" || return 1
  log_lacks "UNICOACH_BACKEND_URL=http://localhost:8080" || return 1
  return 0
}

# Manual export signing: when signing.env names a provisioning profile, the
# generated ExportOptions selects manual signing with the local Apple Distribution
# cert + that profile (no cloud-managed cert path), keyed by the app bundle id.
test_release_manual_signing_with_profile() {
  write_dotenv "uni.coach"
  write_signing_env_with_profile "Unicoach App Store"
  rm -f "$ENV_DIR/appstore.env"
  run_release -n explicit-device >/dev/null 2>&1 || return 1
  export_option_has "<string>manual</string>" || return 1
  export_option_has "<key>provisioningProfiles</key>" || return 1
  export_option_has "coach.uni.UnicoachiOS" || return 1
  export_option_has "Unicoach App Store" || return 1
  export_option_has "<string>Apple Distribution</string>" || return 1
  return 0
}

# Default (no profile named): export stays automatic, with no provisioningProfiles
# block.
test_release_automatic_signing_default() {
  write_dotenv "uni.coach"
  write_signing_env
  rm -f "$ENV_DIR/appstore.env"
  run_release -n explicit-device >/dev/null 2>&1 || return 1
  export_option_has "<string>automatic</string>" || return 1
  if export_option_has "<key>provisioningProfiles</key>"; then return 1; fi
  return 0
}

# ========================== screenshot-ios tests =============================

test_screenshot_guard() {
  stage_built_simulator_app
  local out rc
  out="$(DEV_SHELL_MARKER=1 run_screenshot simulator 2>&1)" && rc=0 || rc=$?
  [ "$rc" -ne 0 ] || return 1
  echo "$out" | grep -q "screenshot-ios" || return 1
  echo "$out" | grep -qi "system Xcode" || return 1
  # Guard fires before any tool: no xcrun line recorded.
  log_no_tool "xcrun"
}

test_screenshot_guard_precedence_over_missing_env() {
  # Even with a nonexistent target (which would normally be the failure), the
  # guard message must win because it precedes env resolution.
  local out rc
  out="$(DEV_SHELL_MARKER=1 run_screenshot nonexistent-env 2>&1)" && rc=0 || rc=$?
  [ "$rc" -ne 0 ] || return 1
  echo "$out" | grep -qi "system Xcode" || return 1
  if echo "$out" | grep -q "nonexistent-env.env"; then return 1; fi
  log_no_tool "xcrun"
}

test_screenshot_missing_env_file() {
  local out
  if out="$(run_screenshot nonexistent-env 2>&1)"; then return 1; fi
  echo "$out" | grep -q "nonexistent-env.env" || return 1
  log_no_tool "xcrun"
}

# Simulator-only: the device fixture (destination without "Simulator") is
# rejected — the exact inverse of install-ios's device-only guard.
test_screenshot_device_env_rejected() {
  stage_built_simulator_app
  local out
  if out="$(run_screenshot device 2>&1)"; then return 1; fi
  echo "$out" | grep -qi "simulator" || return 1
  log_no_tool "xcrun"
}

test_screenshot_no_built_app() {
  rm -rf "$PRODUCTS_DIR/Debug-iphonesimulator"
  local out
  if out="$(run_screenshot simulator 2>&1)"; then return 1; fi
  echo "$out" | grep -q "build-ios" || return 1
  log_no_tool "xcrun"
}

# Happy path: the full simctl sequence is recorded, and the path printed on
# stdout names a file that exists under the screenshot dir.
test_screenshot_happy_path() {
  stage_built_simulator_app
  local out
  out="$(run_screenshot -w 0 simulator 2>/dev/null)" || return 1
  log_has "simctl" || return 1
  log_has "boot" || return 1
  log_has "bootstatus" || return 1
  log_has "-b" || return 1
  log_has "install" || return 1
  log_has "launch" || return 1
  log_has "coach.uni.UnicoachiOS" || return 1
  log_has "$PRODUCTS_DIR/Debug-iphonesimulator/UnicoachiOS.app" || return 1
  log_has "io" || return 1
  log_has "screenshot" || return 1
  log_has "$out" || return 1
  [ -f "$out" ] || return 1
  case "$out" in "$SCREENSHOT_DIR"/*) ;; *) return 1 ;; esac
  return 0
}

# -o wins: that exact path is what simctl is told to write and what is printed.
test_screenshot_explicit_output_path() {
  stage_built_simulator_app
  local target="$WORK/explicit-shot.png"
  rm -f "$target"
  local out
  out="$(run_screenshot -w 0 -o "$target" simulator 2>/dev/null)" || return 1
  [ "$out" = "$target" ] || return 1
  log_has "$target" || return 1
  [ -f "$target" ] || return 1
  return 0
}

# Default naming: no -o puts the PNG under UNICOACH_SCREENSHOT_DIR, named for
# the target, with a .png extension.
test_screenshot_default_output_dir() {
  stage_built_simulator_app
  local out
  out="$(run_screenshot -w 0 simulator 2>/dev/null)" || return 1
  case "$out" in "$SCREENSHOT_DIR"/simulator-*.png) ;; *) return 1 ;; esac
  return 0
}

# Everything after `--` reaches the launch invocation verbatim: the seam for
# driving the app to a particular screen before the capture.
test_screenshot_forwards_launch_args() {
  stage_built_simulator_app
  run_screenshot -w 0 simulator -- -UnicoachUITestScreen profile >/dev/null 2>&1 || return 1
  log_has "launch" || return 1
  log_has "-UnicoachUITestScreen" || return 1
  log_has "profile" || return 1
  return 0
}

# A capture passes NOTHING about StoreKit: the app is disabled by default on a
# simulator Debug build, so there is no flag for this script -- or any future
# launcher -- to remember. Pinning the absence is what stops a well-meaning
# re-addition of a per-caller flag, which is the shape of the original defect.
test_screenshot_passes_no_storekit_argument() {
  stage_built_simulator_app
  run_screenshot -w 0 simulator >/dev/null 2>&1 || return 1
  log_has "launch" || return 1
  log_lacks "StoreKit" || return 1
  return 0
}

# ...but the `--` seam still carries an explicit opt-in, which is how an
# operator deliberately captures the live subscription surface.
test_screenshot_forwards_an_explicit_storekit_opt_in() {
  stage_built_simulator_app
  run_screenshot -w 0 simulator -- -UnicoachEnableStoreKit >/dev/null 2>&1 || return 1
  log_has "-UnicoachEnableStoreKit" || return 1
  return 0
}

# Device resolution defaults to THIS CHECKOUT's device (RFC 126): the
# destination's name= names a MODEL, and the device simctl is handed is the UDID
# of "<model> (<checkout>)" — never the shared `iPhone 17 Pro` every other
# checkout would also resolve, and never the literal "booted" (a second
# simulator booted elsewhere must not be capturable by mistake).
test_screenshot_device_is_this_checkouts_udid() {
  stage_built_simulator_app
  run_screenshot -w 0 simulator >/dev/null 2>&1 || return 1
  log_has "$CHECKOUT_UDID" || return 1
  log_lacks "iPhone 17 Pro" || return 1
  log_lacks "$SHARED_UDID" || return 1
  log_lacks "booted" || return 1
  # The device already existed, so nothing was created.
  log_lacks "create" || return 1
  return 0
}

# First run in a fresh checkout: the device does not exist yet, so it is created
# on demand and the capture proceeds on the NEW UDID.
test_screenshot_creates_the_checkout_device_on_demand() {
  stage_built_simulator_app
  SIMCTL_DEVICES="$DEVICES_ABSENT" run_screenshot -w 0 simulator >/dev/null 2>&1 || return 1
  log_has "create" || return 1
  log_has "$SIM_DEVICE_NAME" || return 1
  log_has "$CREATED_UDID" || return 1
  # Not the shared device, even though the listing still offers it.
  log_lacks "$SHARED_UDID" || return 1
  # The boot/install/launch/io sequence ran against the created device.
  local device
  device="$(grep -A1 -Fx "boot" "$ARGV_LOG" | sed -n '2p')"
  [ "$device" = "$CREATED_UDID" ] || return 1
  return 0
}

# UNICOACH_SIMULATOR overrides the destination-derived device. It is the escape
# hatch for deliberately driving a shared device, so it must also skip the
# per-checkout resolution entirely — no device is created, and this checkout's
# own device is not even consulted.
test_screenshot_simulator_override() {
  stage_built_simulator_app
  SIMULATOR_OVERRIDE="ABCD1234-5678-90EF-1234-567890ABCDEF" \
    run_screenshot -w 0 simulator >/dev/null 2>&1 || return 1
  log_has "ABCD1234-5678-90EF-1234-567890ABCDEF" || return 1
  log_lacks "iPhone 17 Pro" || return 1
  log_lacks "$CHECKOUT_UDID" || return 1
  log_lacks "create" || return 1
  return 0
}

# Regression pin for the tolerate-booted rule: `simctl boot` on an
# already-booted device exits non-zero with "Unable to boot device in current
# state: Booted", which is the NORMAL state on every run after the first. The
# capture must still happen.
test_screenshot_tolerates_already_booted() {
  stage_built_simulator_app
  local out
  out="$(SIMCTL_BOOT_BOOTED=1 run_screenshot -w 0 simulator 2>/dev/null)" || return 1
  log_has "screenshot" || return 1
  [ -f "$out" ] || return 1
  return 0
}

# Usage errors carry the shared EXIT_* band codes, not a bare 1, so a caller can
# tell "you invoked it wrongly" from "the capture failed".
test_screenshot_unknown_option() {
  local rc=0
  run_screenshot -Z simulator >/dev/null 2>&1 || rc=$?
  [ "$rc" -eq "$EXIT_UNKNOWN_OPTION" ]
}

test_screenshot_option_requires_value() {
  local rc=0
  run_screenshot -o >/dev/null 2>&1 || rc=$?
  [ "$rc" -eq "$EXIT_OPTION_REQUIRES_VALUE" ]
}

test_screenshot_stray_positional() {
  stage_built_simulator_app
  local rc=0
  run_screenshot simulator stray >/dev/null 2>&1 || rc=$?
  [ "$rc" -eq "$EXIT_UNEXPECTED_ARG" ]
}

# The stdout contract: a caller does OUT="$(bin/screenshot-ios simulator)" and
# must get a usable path. simctl chatters on stdout (the shim reproduces that),
# so every sub-tool invocation is redirected to stderr; this pins the result.
test_screenshot_stdout_is_only_the_png_path() {
  stage_built_simulator_app
  local out err lines
  err="$WORK/stdout-contract.err"
  out="$(run_screenshot -w 0 simulator 2>"$err")" || return 1
  lines="$(printf '%s\n' "$out" | grep -c .)"
  [ "$lines" -eq 1 ] || return 1
  case "$out" in "$SCREENSHOT_DIR"/*.png) ;; *) return 1 ;; esac
  [ -f "$out" ] || return 1
  # The chatter is not lost, just moved: it is on stderr with the logging.
  grep -q "Wrote screenshot to:" "$err" || return 1
  grep -q "Monitoring boot status" "$err" || return 1
  return 0
}

# Warm-run staleness: simctl launch does not relaunch an already-running app (and
# install over a running app does not restart it), so the capture would show the
# OLD process and ignore the -- launch args. A terminate must precede the launch.
test_screenshot_terminates_before_launch() {
  stage_built_simulator_app
  run_screenshot -w 0 simulator >/dev/null 2>&1 || return 1
  local t l
  t="$(grep -nFx "terminate" "$ARGV_LOG" | head -n 1 | cut -d: -f1)"
  l="$(grep -nFx "launch" "$ARGV_LOG" | head -n 1 | cut -d: -f1)"
  [ -n "$t" ] || return 1
  [ -n "$l" ] || return 1
  [ "$t" -lt "$l" ] || return 1
  # simctl terminate <device> <bundle>: the bundle id is two lines on.
  [ "$(sed -n "$((t + 2))p" "$ARGV_LOG")" = "coach.uni.UnicoachiOS" ] || return 1
  return 0
}

# -d is the most explicit device selector and beats BOTH UNICOACH_SIMULATOR and
# the destination's name=.
test_screenshot_device_flag_beats_env_and_destination() {
  stage_built_simulator_app
  SIMULATOR_OVERRIDE="ENVVAR-1111-2222-3333-444444444444" \
    run_screenshot -w 0 -d "FLAG-5555-6666-7777-888888888888" simulator >/dev/null 2>&1 || return 1
  log_has "FLAG-5555-6666-7777-888888888888" || return 1
  log_lacks "ENVVAR-1111-2222-3333-444444444444" || return 1
  log_lacks "iPhone 17 Pro" || return 1
  log_lacks "$CHECKOUT_UDID" || return 1
  log_lacks "create" || return 1
  return 0
}

# An option written AFTER the target gets advice that can actually help
# (reorder), not the generic "pass launch arguments after --" dead end.
test_screenshot_option_after_target() {
  stage_built_simulator_app
  local out rc=0
  out="$(run_screenshot simulator -w 10 2>&1)" || rc=$?
  [ "$rc" -eq "$EXIT_UNEXPECTED_ARG" ] || return 1
  echo "$out" | grep -q "options must precede the target" || return 1
  echo "$out" | grep -q "screenshot-ios -w 10 simulator" || return 1
  return 0
}

# A boot failure that is NOT the already-booted state is FATAL: the tolerance is
# for one specific message, not for boot failures in general.
test_screenshot_boot_failure_is_fatal() {
  stage_built_simulator_app
  local out rc=0
  out="$(SIMCTL_BOOT_FAIL=1 run_screenshot -w 0 simulator 2>&1)" || rc=$?
  [ "$rc" -ne 0 ] || return 1
  echo "$out" | grep -q "$CHECKOUT_UDID" || return 1
  # Never reached the capture.
  log_lacks "screenshot" || return 1
  log_lacks "io" || return 1
  return 0
}

# simctl can exit 0 having written nothing; the guard must fire rather than
# print a path to a file that does not exist.
test_screenshot_no_file_written_is_fatal() {
  stage_built_simulator_app
  # An explicit -o to a path this case controls: the default name is only
  # timestamped to the second, so a PNG another case wrote in the same second
  # would satisfy the existence check and hide the missing guard.
  #
  # A STALE file is planted at that path deliberately — with a stable -o that is
  # exactly the real-world shape of the hole: simctl exits 0 writing nothing and
  # the previous run's capture is printed as this run's result. The script
  # removes the file itself immediately before the capture, so the guard proves
  # THIS run wrote it. (That is also why this case no longer needs its own
  # rm -f: deleting the script's rm -f fails this case.)
  local target="$WORK/never-written.png"
  echo "stale capture from a previous run" > "$target"
  local out rc=0
  out="$(SIMCTL_NO_WRITE=1 run_screenshot -w 0 -o "$target" simulator 2>&1)" || rc=$?
  [ "$rc" -ne 0 ] || return 1
  echo "$out" | grep -q "no screenshot was written" || return 1
  [ ! -f "$target" ] || return 1
  return 0
}

# The zero-config default against the REAL ios-app/env: `screenshot-ios` with no
# arguments beyond the target must resolve a device from the checked-in
# simulator.env. An edit dropping its name= component (as prod-simulator's
# destination already lacks) would dead-end in the cannot-resolve fatal — this
# case fails then, rather than the breakage being found by hand.
test_screenshot_real_simulator_target_resolves_device() {
  stage_built_simulator_app
  local out device
  out="$(run_screenshot_real_env -w 0 simulator 2>/dev/null)" || return 1
  [ -f "$out" ] || return 1
  case "$out" in "$SCREENSHOT_DIR"/*) ;; *) return 1 ;; esac
  # The device simctl was handed: the argv line after "boot".
  device="$(grep -A1 -Fx "boot" "$ARGV_LOG" | sed -n '2p')"
  [ -n "$device" ] || return 1
  [ "$device" != "booted" ] || return 1
  # ...and it is THIS CHECKOUT's device, resolved from the checked-in
  # destination's model through bin/ios-sim.
  [ "$device" = "$CHECKOUT_UDID" ] || return 1
  return 0
}

# An EMPTY -d is a mistake, not a selection: `screenshot-ios -d "$SIM" ...`
# with SIM unset would otherwise read as "no -d given" and quietly capture a
# different simulator.
test_screenshot_empty_device_value() {
  stage_built_simulator_app
  local out rc=0
  out="$(run_screenshot -w 0 -d "" simulator 2>&1)" || rc=$?
  [ "$rc" -eq "$EXIT_INVALID_ARG_VALUE" ] || return 1
  echo "$out" | grep -q -- "-d" || return 1
  log_no_tool "xcrun"
}

# Same for an empty -o, which would otherwise silently fall back to the default
# timestamped path instead of the file the caller meant to write.
test_screenshot_empty_output_value() {
  stage_built_simulator_app
  local out rc=0
  out="$(run_screenshot -w 0 -o "" simulator 2>&1)" || rc=$?
  [ "$rc" -eq "$EXIT_INVALID_ARG_VALUE" ] || return 1
  echo "$out" | grep -q -- "-o" || return 1
  log_no_tool "xcrun"
}

# A sub-tool failure must surface as THIS script's fatal with a sane exit
# status, not as simctl's bare stderr plus its raw exit code (164 here), which
# collides with the reserved 10-29 usage band a caller reads for "invoked
# wrongly".
test_screenshot_install_failure_is_fatal() {
  stage_built_simulator_app
  local out rc=0
  out="$(SIMCTL_INSTALL_FAIL=1 run_screenshot -w 0 simulator 2>&1)" || rc=$?
  [ "$rc" -ne 0 ] || return 1
  [ "$rc" -lt 10 ] || return 1
  echo "$out" | grep -q "\[FATAL\]" || return 1
  echo "$out" | grep -q "Failed to install" || return 1
  echo "$out" | grep -q "$CHECKOUT_UDID" || return 1
  # Never reached the capture.
  log_lacks "screenshot" || return 1
  return 0
}

# The standard `platform=iOS Simulator,id=<UDID>` destination names one exact
# simulator, which is explicit intent: it is used VERBATIM, ahead of the
# per-checkout device, and nothing is created.
test_screenshot_device_from_destination_id() {
  stage_built_simulator_app
  run_screenshot -w 0 id-simulator >/dev/null 2>&1 || return 1
  log_has "AAAABBBB-CCCC-DDDD-EEEE-FFFF00001111" || return 1
  log_lacks "booted" || return 1
  log_lacks "create" || return 1
  log_lacks "$CHECKOUT_UDID" || return 1
  return 0
}

# The end of the resolution chain: a destination carrying NEITHER a `name=` nor
# an `id=` component (prod-simulator's shape) is fatal, never an empty device
# handed on to `simctl boot ""`. Also the negative half of the `name=` probe —
# without this case the probe could match anything and the suite stay green.
test_screenshot_unresolvable_destination_is_fatal() {
  stage_built_simulator_app
  local out rc=0
  out="$(run_screenshot -w 0 explicit-simulator 2>&1)" || rc=$?
  [ "$rc" -ne 0 ] || return 1
  echo "$out" | grep -q "\[FATAL\]" || return 1
  echo "$out" | grep -q "Cannot resolve a simulator" || return 1
  echo "$out" | grep -q "neither a 'name=' nor an 'id=' component" || return 1
  # Nothing was booted, and no device was created for want of one.
  log_no_tool "xcrun"
}

# The extraction is anchored to a component boundary: a decoy key that merely
# ENDS in `name=` must not be mistaken for the real one — the decoys sit on both
# sides of it, so neither a key-unanchored match nor a greedy last-match wins.
test_screenshot_device_ignores_decoy_name_key() {
  stage_built_simulator_app
  run_screenshot -w 0 decoy-name-simulator >/dev/null 2>&1 || return 1
  # `iPhone 99 Real` is the model, so the device is this checkout's
  # "iPhone 99 Real (<checkout>)" — present in the device fixture as $DECOY_UDID.
  log_has "$DECOY_UDID" || return 1
  log_lacks "Bogus Lead" || return 1
  log_lacks "Bogus Tail" || return 1
  return 0
}

test_screenshot_help_exits_zero() {
  local out rc=0
  out="$(run_screenshot -h 2>&1)" || rc=$?
  [ "$rc" -eq 0 ] || return 1
  echo "$out" | grep -q "screenshot-ios"
}

# ============================== ios-sim tests ================================
# The per-checkout simulator device (RFC 126). Every case is fixture-driven: the
# xcrun shim answers `simctl list devices/devicetypes/runtimes` from files and
# records `simctl create`, so nothing here touches a real device.

# Steady state: the device named "<model> (<checkout>)" already exists, so its
# UDID is printed and NOTHING is created. The shared `iPhone 17 Pro` is in the
# same listing, so returning it (a model-keyed rather than name-keyed lookup)
# fails here.
test_iossim_prints_existing_udid() {
  local out
  out="$(run_ios_sim simulator 2>/dev/null)" || return 1
  [ "$out" = "$CHECKOUT_UDID" ] || return 1
  log_lacks "create" || return 1
  return 0
}

# First run: no such device, so one is created — with the EXACT device type for
# the model (not `iPhone 17 Pro Max`, also in the listing) and NO third
# argument, so CoreSimulator picks the newest runtime compatible with that
# device type — and the created UDID is printed.
#
# The argv is read positionally rather than with log_has, because "no runtime
# argument" is a statement about the shape of the invocation: a `create` that
# grew a third argument would still satisfy every membership assertion.
test_iossim_creates_when_absent() {
  local out create_at trailing
  out="$(SIMCTL_DEVICES="$DEVICES_ABSENT" run_ios_sim simulator 2>/dev/null)" || return 1
  [ "$out" = "$CREATED_UDID" ] || return 1
  # Not the shared device, which the listing still offers under the bare model.
  [ "$out" != "$SHARED_UDID" ] || return 1
  create_at="$(grep -n -Fx -- "create" "$ARGV_LOG" | head -n 1 | cut -d: -f1)"
  [ -n "$create_at" ] || return 1
  [ "$(sed -n "$((create_at + 1))p" "$ARGV_LOG")" = "$SIM_DEVICE_NAME" ] || return 1
  [ "$(sed -n "$((create_at + 2))p" "$ARGV_LOG")" = "com.apple.CoreSimulator.SimDeviceType.iPhone-17-Pro" ] || return 1
  # Exactly two arguments: the next logged line is either the start of another
  # recorded invocation or end-of-file.
  trailing="$(sed -n "$((create_at + 3))p" "$ARGV_LOG")"
  [ -z "$trailing" ] || [ "$trailing" = "xcrun" ] || return 1
  log_lacks "com.apple.CoreSimulator.SimDeviceType.iPhone-17-Pro-Max" || return 1
  # No runtime id anywhere in the argv: choosing one is simctl's job now.
  log_lacks "$NEWEST_RUNTIME" || return 1
  log_lacks "$OLDER_RUNTIME" || return 1
  log_lacks "$UNAVAILABLE_RUNTIME" || return 1
  # `create`, never `clone`: a clone would inherit the shared device's data.
  log_lacks "clone" || return 1
  return 0
}

# A `simctl create` that fails is this script's fatal, carrying simctl's own
# words — the shape of the real "no iOS runtime is installed" failure, which is
# simctl's to report now that the runtime choice is simctl's. The installed
# runtimes are printed too, so that case still diagnoses itself.
test_iossim_create_failure_is_fatal() {
  local out rc=0
  out="$(SIMCTL_DEVICES="$DEVICES_ABSENT" SIMCTL_CREATE_FAIL=1 run_ios_sim simulator 2>&1)" || rc=$?
  [ "$rc" -ne 0 ] || return 1
  echo "$out" | grep -q "\[FATAL\]" || return 1
  echo "$out" | grep -q "Unable to find a runtime for device type" || return 1
  echo "$out" | grep -q "$NEWEST_RUNTIME" || return 1
  return 0
}

# The stdout contract's last guard: whatever `simctl create` prints is checked
# for the UDID's SHAPE before it is relayed. 36 dashes are 36 characters from
# the UDID's own alphabet, so a length-and-charset check passes them straight
# through to a caller's `-destination ...,id=`.
test_iossim_create_output_must_be_udid_shaped() {
  local out rc=0
  out="$(SIMCTL_DEVICES="$DEVICES_ABSENT" \
    SIMCTL_CREATE_UDID="------------------------------------" \
    run_ios_sim simulator 2>&1)" || rc=$?
  [ "$rc" -ne 0 ] || return 1
  echo "$out" | grep -q "\[FATAL\]" || return 1
  echo "$out" | grep -q "printed no UDID" || return 1
  return 0
}

# `simctl list` is this script's only source of truth, so a simctl that cannot
# run at all must produce a [FATAL] naming the listing and carrying xcrun's own
# text. Without it the caller's command substitution dies under `set -e` with no
# message whatsoever — a bare non-zero exit out of bin/test-ios.
test_iossim_list_failure_is_fatal() {
  local out rc=0
  out="$(SIMCTL_LIST_FAIL=1 run_ios_sim simulator 2>&1)" || rc=$?
  [ "$rc" -ne 0 ] || return 1
  echo "$out" | grep -q "\[FATAL\]" || return 1
  echo "$out" | grep -q "list simulator \[devices\]" || return 1
  echo "$out" | grep -q "unable to find utility" || return 1
  log_lacks "create" || return 1
  return 0
}

# simctl does not enforce unique device names, so two same-checkout first-runs
# can each list-then-create. Two devices carrying this name is a broken state,
# not a choice to make quietly: fatal, naming both UDIDs and the command that
# clears them — and creating nothing.
test_iossim_duplicate_devices_are_fatal() {
  local out rc=0
  out="$(SIMCTL_DEVICES="$DEVICES_DUPLICATE" run_ios_sim simulator 2>&1)" || rc=$?
  [ "$rc" -ne 0 ] || return 1
  echo "$out" | grep -q "\[FATAL\]" || return 1
  echo "$out" | grep -q "$CHECKOUT_UDID" || return 1
  echo "$out" | grep -q "$DUPLICATE_UDID" || return 1
  echo "$out" | grep -q "bin/ios-sim -D simulator" || return 1
  log_lacks "create" || return 1
  return 0
}

# -D names a SET, and it is the one path that must cope with the broken state it
# exists to clear: every device carrying the name goes, the unavailable twin
# included (resolution skips those because they cannot be booted, but leaving
# one behind is exactly what makes the next resolve fatal). The decoy and the
# shared machine-global device are left alone.
test_iossim_delete_removes_every_match() {
  local out rc=0
  out="$(SIMCTL_DEVICES="$DEVICES_DUPLICATE" run_ios_sim -D simulator 2>/dev/null)" || rc=$?
  [ "$rc" -eq 0 ] || return 1
  [ -z "$out" ] || return 1
  log_has "$CHECKOUT_UDID" || return 1
  log_has "$DUPLICATE_UDID" || return 1
  log_has "$UNAVAILABLE_UDID" || return 1
  log_lacks "$SHARED_UDID" || return 1
  log_lacks "$DECOY_UDID" || return 1
  return 0
}

# An unavailable device (its runtime is gone) carries the right NAME in the
# listing but cannot be booted, so it must not be handed back as this
# checkout's device — the available one is.
test_iossim_ignores_an_unavailable_device() {
  local out
  out="$(run_ios_sim simulator 2>/dev/null)" || return 1
  [ "$out" != "$UNAVAILABLE_UDID" ] || return 1
  return 0
}

# The family's stdout contract: a caller does
# `-destination "platform=iOS Simulator,id=$(bin/ios-sim)"`, so stdout is EXACTLY
# the UDID and every log line — including the resolved device name, and simctl's
# own chatter — is on stderr. Driven through the CREATE path, where simctl
# itself prints a UDID that would otherwise leak straight through.
test_iossim_stdout_is_only_the_udid() {
  local out err lines
  err="$WORK/ios-sim-stdout.err"
  out="$(SIMCTL_DEVICES="$DEVICES_ABSENT" run_ios_sim simulator 2>"$err")" || return 1
  lines="$(printf '%s\n' "$out" | grep -c .)"
  [ "$lines" -eq 1 ] || return 1
  [ "$out" = "$CREATED_UDID" ] || return 1
  # The name it resolved is announced, but on stderr — two checkouts sharing a
  # basename would share a device, and this line is what stops that being silent.
  grep -qF "$SIM_DEVICE_NAME" "$err" || return 1
  return 0
}

# "That model is not installed locally" is the expected human error, so the
# fatal names the model AND prints the actual list to choose from — and nothing
# is created.
test_iossim_unknown_model_is_fatal() {
  local out rc=0
  out="$(SIMCTL_DEVICES="$DEVICES_ABSENT" run_ios_sim unknown-model-simulator 2>&1)" || rc=$?
  [ "$rc" -ne 0 ] || return 1
  echo "$out" | grep -q "\[FATAL\]" || return 1
  echo "$out" | grep -q "iPhone Nonexistent 42" || return 1
  echo "$out" | grep -q "com.apple.CoreSimulator.SimDeviceType.iPhone-17-Pro" || return 1
  log_lacks "create" || return 1
  return 0
}

# A destination with no `name=` component (prod-simulator's shape) names no
# model, so there is nothing to create: fatal, not an arbitrary device.
test_iossim_no_name_component_is_fatal() {
  local out rc=0
  out="$(run_ios_sim explicit-simulator 2>&1)" || rc=$?
  [ "$rc" -ne 0 ] || return 1
  echo "$out" | grep -q "name=" || return 1
  log_no_tool "xcrun"
}

# Same dev-shell guard as the rest of the -ios family, before any tool runs.
test_iossim_guard() {
  local out rc=0
  out="$(DEV_SHELL_MARKER=1 run_ios_sim simulator 2>&1)" || rc=$?
  [ "$rc" -ne 0 ] || return 1
  echo "$out" | grep -q "ios-sim" || return 1
  echo "$out" | grep -qi "system Xcode" || return 1
  log_no_tool "xcrun"
}

# -D deletes by UDID (the name is the lookup key, the UDID is what simctl acts
# on) and prints nothing on stdout.
test_iossim_delete_by_udid() {
  local out shutdown_at delete_at
  out="$(run_ios_sim -D simulator 2>/dev/null)" || return 1
  [ -z "$out" ] || return 1
  log_has "delete" || return 1
  log_has "$CHECKOUT_UDID" || return 1
  # ...and the device is SHUT DOWN first: `simctl delete` refuses a booted
  # device, which is exactly the state screenshot-ios/test-ios leave it in, so
  # the shutdown must precede the delete rather than being advice in a fatal.
  shutdown_at="$(grep -n -Fx -- "shutdown" "$ARGV_LOG" | head -n 1 | cut -d: -f1)"
  delete_at="$(grep -n -Fx -- "delete" "$ARGV_LOG" | head -n 1 | cut -d: -f1)"
  [ -n "$shutdown_at" ] || return 1
  [ -n "$delete_at" ] || return 1
  [ "$shutdown_at" -lt "$delete_at" ] || return 1
  return 0
}

# ...and deleting a device that is not there is a no-op, not a failure: nothing
# is cached on disk, so a hand-deleted device is the normal state.
test_iossim_delete_absent_is_a_noop() {
  local out rc=0
  out="$(SIMCTL_DEVICES="$DEVICES_ABSENT" run_ios_sim -D simulator 2>&1)" || rc=$?
  [ "$rc" -eq 0 ] || return 1
  echo "$out" | grep -q "nothing to delete" || return 1
  log_lacks "delete" || return 1
  return 0
}

# ============================== test-ios tests ===============================

# The whole point: `xcodebuild test` is pinned to THIS CHECKOUT's device by
# UDID, not to the shared `name=iPhone 17 Pro` a hand-typed command would use,
# and it shares bin/build-ios's DerivedData tree.
test_testios_destination_is_the_checkout_device() {
  run_test_ios simulator >/dev/null 2>&1 || return 1
  log_has "xcodebuild" || return 1
  log_has "test" || return 1
  log_has "-destination" || return 1
  log_has "platform=iOS Simulator,id=$CHECKOUT_UDID" || return 1
  log_lacks "platform=iOS Simulator,name=iPhone 17 Pro" || return 1
  log_has "-derivedDataPath" || return 1
  log_has "$PROJECT_ROOT/ios-app/build/DerivedData" || return 1
  log_has "$PROJECT_ROOT/ios-app/UnicoachiOS.xcodeproj" || return 1
  log_has "UnicoachiOS" || return 1
  return 0
}

# bin/build-ios owns the DerivedData location and bin/test-ios repeats the
# literal, which is the only thing making the two share a build tree. Compare
# what each script ACTUALLY hands xcodebuild, read out of the argv log rather
# than from a third copy of the literal, so moving one and not the other fails
# here instead of silently costing a cold rebuild on every test run.
test_testios_shares_build_ios_derived_data() {
  local build_path test_path
  run_build simulator >/dev/null 2>&1 || return 1
  build_path="$(grep -A1 -Fx -- "-derivedDataPath" "$ARGV_LOG" | sed -n '2p')"
  [ -n "$build_path" ] || return 1
  run_test_ios simulator >/dev/null 2>&1 || return 1
  test_path="$(grep -A1 -Fx -- "-derivedDataPath" "$ARGV_LOG" | sed -n '2p')"
  [ -n "$test_path" ] || return 1
  [ "$test_path" = "$build_path" ] || return 1
  return 0
}

# A device target has no bootable simulator: rejected, and no build is started.
test_testios_device_target_rejected() {
  local out rc=0
  out="$(run_test_ios device 2>&1)" || rc=$?
  [ "$rc" -ne 0 ] || return 1
  # THIS script's guard, pinned by its own wording: a device destination also
  # has no `name=` component, so deleting the guard would still fail — inside
  # bin/ios-sim, with a message about models. A loose /simulator/i match would
  # accept that and the guard could be removed unnoticed.
  echo "$out" | grep -q "physical device" || return 1
  echo "$out" | grep -q "test-ios runs the suite in the simulator only" || return 1
  # Refused before any device is even resolved, let alone created.
  log_no_tool "xcrun" || return 1
  log_no_tool "xcodebuild"
}

test_testios_guard() {
  local out rc=0
  out="$(DEV_SHELL_MARKER=1 run_test_ios simulator 2>&1)" || rc=$?
  [ "$rc" -ne 0 ] || return 1
  echo "$out" | grep -q "test-ios" || return 1
  echo "$out" | grep -qi "system Xcode" || return 1
  log_no_tool "xcodebuild"
}

# Everything after `--` reaches xcodebuild verbatim: the -only-testing seam.
test_testios_forwards_args_after_dashdash() {
  run_test_ios simulator -- -only-testing:UnicoachiOSTests/PaywallTests -quiet >/dev/null 2>&1 || return 1
  log_has "-only-testing:UnicoachiOSTests/PaywallTests" || return 1
  log_has "-quiet" || return 1
  return 0
}

