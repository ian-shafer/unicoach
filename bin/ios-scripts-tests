#!/usr/bin/env bash
# ios-scripts-tests exercises bin/is-nix, bin/build-ios, bin/install-ios,
# bin/release-ios, and bin/screenshot-ios WITHOUT any real Xcode build, hardware,
# or booted simulator. xcodebuild and xcrun are shimmed onto
# PATH via a temp dir; the shims record their argv to a file the assertions
# inspect. The ios-app/env/<env>.env files are pointed at a temp fixture dir via
# UNICOACH_ENV_DIR, and the repo .env (the APP_DOMAIN/SERVER_PORT source) is
# pointed at a temp fixture file via UNICOACH_DOTENV, so the assertions drive the
# DERIVED UNICOACH_BACKEND_URL without touching the real .env.
#
# Sources ONLY bin/functions and bin/tests-common — no bin/common, no Postgres,
# no Nix dev shell (these scripts run under system Xcode, not the dev shell).
set -euo pipefail

# Make happy-path cases deterministic even when this harness is itself launched
# via `nix develop -c`: clear unicoach's dev-shell marker. "Inside the dev
# shell" is simulated per-invocation by prefixing a script call with
# UNICOACH_DEV_SHELL=impure (an external-command assignment, so it scopes to
# that child only). IN_NIX_SHELL is deliberately LEFT ALONE: this harness is
# typically launched via `nix develop -c`, and an inherited IN_NIX_SHELL with no
# marker is exactly the foreign-shell environment the is-nix cases pin.
unset UNICOACH_DEV_SHELL

THIS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$THIS_DIR/.." && pwd)"
source "$THIS_DIR/functions"
source "$THIS_DIR/tests-common"

TMP_BASE="${TMPDIR:-/tmp}"
mkdir -p "$TMP_BASE"
WORK="$(mktemp -d "$TMP_BASE/unicoach-ios-scripts-tests.XXXXXX")"
trap 'rm -rf "$WORK" >/dev/null 2>&1 || true' EXIT INT TERM

SHIM_DIR="$WORK/shims"
ENV_DIR="$WORK/env"
PRODUCTS_DIR="$WORK/products"
ARGV_LOG="$WORK/argv.log"
DOTENV="$WORK/dotenv"
# Where screenshot-ios writes its default-named PNGs in tests (redirected out of
# the real repo via UNICOACH_SCREENSHOT_DIR).
SCREENSHOT_DIR="$WORK/screenshots"
# Where snapshot-ios writes its corpus in tests (redirected out of the real repo
# via UNICOACH_SNAPSHOT_DIR).
SNAPSHOT_DIR="$WORK/snapshots"
mkdir -p "$SHIM_DIR" "$ENV_DIR" "$PRODUCTS_DIR" "$SCREENSHOT_DIR"

# --- Shims -------------------------------------------------------------------
# xcodebuild: record every arg (one per line) prefixed with "xcodebuild", succeed.
cat > "$SHIM_DIR/xcodebuild" <<EOF
#!/usr/bin/env bash
{ echo "xcodebuild"; for a in "\$@"; do echo "\$a"; done; } >> "$ARGV_LOG"
# snapshot-ios's contract lives partly in the TEST-RUNNER ENVIRONMENT rather
# than in argv (xcodebuild forwards a TEST_RUNNER_<NAME> variable into the test
# process as <NAME>), so those three are recorded too — otherwise the seam that
# tells the harness where to write could be deleted and this suite would stay
# green. Recorded only for \`xcodebuild test\`, so the build-ios/release-ios
# cases' logs are untouched.
if [ "\${1:-}" = "test" ]; then
  {
    echo "env:TEST_RUNNER_UNICOACH_SNAPSHOT_DIR=\${TEST_RUNNER_UNICOACH_SNAPSHOT_DIR:-}"
    echo "env:TEST_RUNNER_UNICOACH_SNAPSHOT_BASELINE_DIR=\${TEST_RUNNER_UNICOACH_SNAPSHOT_BASELINE_DIR:-}"
    echo "env:TEST_RUNNER_TZ=\${TEST_RUNNER_TZ:-}"
  } >> "$ARGV_LOG"
  # Stand in for the real run's product: one PNG in the corpus directory, so
  # snapshot-ios's "the corpus is non-empty" guard sees what a working run
  # leaves behind. SNAPSHOT_NO_WRITE models the failure that guard exists for —
  # a test target that ran ZERO tests and still exited 0.
  if [ -z "\${SNAPSHOT_NO_WRITE:-}" ] && [ -n "\${TEST_RUNNER_UNICOACH_SNAPSHOT_DIR:-}" ]; then
    mkdir -p "\${TEST_RUNNER_UNICOACH_SNAPSHOT_DIR}"
    : > "\${TEST_RUNNER_UNICOACH_SNAPSHOT_DIR}/fixture-scene-light.png"
    : > "\${TEST_RUNNER_UNICOACH_SNAPSHOT_DIR}/fixture-scene-dark.png"
  fi
  # A failing test run: the scenes no longer construct.
  if [ -n "\${SNAPSHOT_TEST_FAIL:-}" ]; then
    echo "** TEST FAILED **" >&2
    exit 65
  fi
fi
exit 0
EOF

# xcrun: record argv, succeed. For "devicectl list devices" it prints whatever
# the per-test DEVICECTL_LIST_OUTPUT fixture file holds, so device auto-detect
# can be driven to 0/1/2 devices without hardware. Two simctl behaviours are
# modelled for screenshot-ios:
#   - "simctl io <device> screenshot <path>" TOUCHES <path>, so the script's
#     post-capture existence check sees a real file (the shim is the only thing
#     that could ever create one here).
#   - "simctl boot" fails with the REAL already-booted text when the per-test
#     SIMCTL_BOOT_BOOTED fixture var is set, which is how the tolerate-booted
#     rule is exercised without a booted simulator; with SIMCTL_BOOT_FAIL it
#     fails with an unknown-device error instead, the case that must be FATAL.
#   - SIMCTL_NO_WRITE makes "simctl io ... screenshot" exit 0 WITHOUT creating
#     the file, the "reported success but wrote nothing" case.
#   - SIMCTL_INSTALL_FAIL makes "simctl install" fail with simctl's own stderr
#     and its raw exit status (164), the unhandled-sub-tool-failure case.
# The simctl subcommands also emit their real STDOUT chatter (bootstatus's
# progress, launch's "<bundle>: <pid>", io's "Wrote screenshot to: ..."), which
# is what makes screenshot-ios's "the PNG path is the only line on stdout"
# contract testable at all: without it every redirection could be deleted and
# the suite would stay green.
cat > "$SHIM_DIR/xcrun" <<EOF
#!/usr/bin/env bash
{ echo "xcrun"; for a in "\$@"; do echo "\$a"; done; } >> "$ARGV_LOG"
if [ "\${1:-}" = "devicectl" ] && [ "\${2:-}" = "list" ] && [ "\${3:-}" = "devices" ]; then
  if [ -n "\${DEVICECTL_LIST_OUTPUT:-}" ] && [ -f "\${DEVICECTL_LIST_OUTPUT}" ]; then
    cat "\${DEVICECTL_LIST_OUTPUT}"
  fi
fi
if [ "\${1:-}" = "simctl" ] && [ "\${2:-}" = "boot" ] && [ -n "\${SIMCTL_BOOT_BOOTED:-}" ]; then
  # Verbatim simctl wording, including its exit code, so the script's tolerance
  # is pinned to the real string it must match.
  echo "An error was encountered processing the command (domain=com.apple.CoreSimulator.SimError, code=405):" >&2
  echo "Unable to boot device in current state: Booted" >&2
  exit 149
fi
if [ "\${1:-}" = "simctl" ] && [ "\${2:-}" = "boot" ] && [ -n "\${SIMCTL_BOOT_FAIL:-}" ]; then
  # A boot failure that is NOT the already-booted state: verbatim simctl wording
  # for a device that does not exist.
  echo "An error was encountered processing the command (domain=com.apple.CoreSimulator.SimError, code=161):" >&2
  echo "Invalid device: \${3:-}" >&2
  exit 164
fi
if [ "\${1:-}" = "simctl" ] && [ "\${2:-}" = "install" ] && [ -n "\${SIMCTL_INSTALL_FAIL:-}" ]; then
  # A sub-tool failure with simctl's own wording AND its raw exit status, which
  # lands inside this repo's reserved 10-29 usage band — the collision the
  # script's own || fatal exists to prevent.
  echo "An error was encountered processing the command (domain=com.apple.CoreSimulator.SimError, code=405):" >&2
  echo "Unable to install app: \${4:-}" >&2
  exit 164
fi
if [ "\${1:-}" = "simctl" ] && [ "\${2:-}" = "shutdown" ] && [ -n "\${SIMCTL_SHUTDOWN_FAIL:-}" ]; then
  # A shutdown that fails for a reason that is NOT "it was not booted": the root
  # cause of the delete that then refuses the device, in simctl's own wording.
  echo "An error was encountered processing the command (domain=com.apple.CoreSimulator.SimError, code=405):" >&2
  echo "Unable to shutdown device in current state: Creating" >&2
  exit 164
fi
if [ "\${1:-}" = "simctl" ] && [ "\${2:-}" = "delete" ] \
  && [ -n "\${SIMCTL_DELETE_FAIL_UDID:-}" ] && [ "\${3:-}" = "\${SIMCTL_DELETE_FAIL_UDID}" ]; then
  # ONE device of the set refusing to go — the likeliest real failure, since
  # devices are machine-global and another agent may be holding this one. Keyed
  # on the UDID so the assertion can prove the sweep carried on to the others
  # rather than stopping here.
  echo "An error was encountered processing the command (domain=com.apple.CoreSimulator.SimError, code=164):" >&2
  echo "Unable to delete device in current state: Booted" >&2
  exit 164
fi
if [ "\${1:-}" = "simctl" ] && [ "\${2:-}" = "rename" ] && [ -n "\${SIMCTL_RENAME_FAIL:-}" ]; then
  # A rename that fails, in simctl's own wording. The device is then neither
  # adopted nor replaced, so bin/ios-sim must say so rather than exit wordlessly
  # under set -e or print a UDID it did not rename.
  echo "An error was encountered processing the command (domain=com.apple.CoreSimulator.SimError, code=162):" >&2
  echo "Invalid device: \${3:-}" >&2
  exit 164
fi
if [ "\${1:-}" = "simctl" ] && [ "\${2:-}" = "list" ] && [ -n "\${SIMCTL_LIST_FAIL:-}" ]; then
  # simctl itself refusing to run at all: the Command Line Tools / broken
  # CoreSimulator case, in xcrun's own wording and on STDERR. bin/ios-sim must
  # turn this into a [FATAL] naming the listing, not die wordlessly under set -e.
  echo "xcrun: error: unable to find utility \"simctl\", not a developer tool or in PATH" >&2
  exit 72
fi
if [ "\${1:-}" = "simctl" ] && [ "\${2:-}" = "create" ] && [ -n "\${SIMCTL_CREATE_FAIL:-}" ]; then
  # A create that fails with simctl's own wording — the shape of the real "no
  # runtime is installed" failure now that the runtime choice is simctl's.
  echo "An error was encountered processing the command (domain=NSPOSIXErrorDomain, code=2):" >&2
  echo "Unable to find a runtime for device type \${3:-}" >&2
  exit 164
fi
if [ "\${1:-}" = "simctl" ] && [ "\${2:-}" = "list" ]; then
  # Fixture-driven \`simctl list\`. Each of the three listings is a per-test file
  # (SIMCTL_DEVICES / SIMCTL_DEVICETYPES / SIMCTL_RUNTIMES) in the REAL simctl
  # plain-text shape, which is what bin/ios-sim parses — no jq/python3 is
  # available to these scripts, so the parser is text and so is the fixture.
  case "\${3:-}" in
  devices)
    if [ -n "\${SIMCTL_DEVICES:-}" ] && [ -f "\${SIMCTL_DEVICES}" ]; then cat "\${SIMCTL_DEVICES}"; fi
    ;;
  devicetypes)
    if [ -n "\${SIMCTL_DEVICETYPES:-}" ] && [ -f "\${SIMCTL_DEVICETYPES}" ]; then cat "\${SIMCTL_DEVICETYPES}"; fi
    ;;
  runtimes)
    if [ -n "\${SIMCTL_RUNTIMES:-}" ] && [ -f "\${SIMCTL_RUNTIMES}" ]; then cat "\${SIMCTL_RUNTIMES}"; fi
    ;;
  esac
fi
if [ "\${1:-}" = "simctl" ] && [ "\${2:-}" = "create" ]; then
  # The real \`simctl create\` prints the new device's UDID on stdout, and that is
  # the value bin/ios-sim must relay as ITS stdout.
  echo "\${SIMCTL_CREATE_UDID:-}"
fi
if [ "\${1:-}" = "simctl" ] && [ "\${2:-}" = "bootstatus" ]; then
  echo "Monitoring boot status for device \${3:-}."
  echo "Device already booted, nothing to do."
fi
if [ "\${1:-}" = "simctl" ] && [ "\${2:-}" = "launch" ]; then
  echo "\${4:-}: 1234"
fi
if [ "\${1:-}" = "simctl" ] && [ "\${2:-}" = "io" ] && [ "\${4:-}" = "screenshot" ]; then
  # SIMCTL_NO_WRITE models simctl exiting 0 having written nothing.
  if [ -z "\${SIMCTL_NO_WRITE:-}" ]; then
    : > "\${5:-/dev/null}"
  fi
  echo "Wrote screenshot to: \${5:-}"
fi
exit 0
EOF
# git: bin/ios-sim asks git which checkouts are ALIVE
# (`git worktree list --porcelain`), and that answer is what decides whether a
# tagged simulator device is an orphan — plus the first entry's basename is the
# REPO tag in every device name. Shimmed so the suite presents a fixed set of
# worktrees instead of whatever this machine happens to have checked out.
#
# The fixture answers EXACTLY the invocation bin/ios-sim makes —
# `git -C <root> worktree list --porcelain` — and only when
# GIT_WORKTREES/GIT_WORKTREE_FAIL is set; every other git call, in any shape, is
# exec'd through to the real binary by ABSOLUTE path (bin/release-ios derives its
# build number from `git rev-list`, and this shim is first on PATH for that suite
# too). Matched by POSITION, not by the word `worktree` appearing somewhere in
# argv: `git log --grep worktree` is not a worktree listing, and answering it
# from this fixture — or failing it under GIT_WORKTREE_FAIL — would silently
# reroute a future case.
REAL_GIT="$(command -v git)"
cat > "$SHIM_DIR/git" <<EOF
#!/usr/bin/env bash
if [ "\$#" = 5 ] && [ "\$1" = "-C" ] && [ "\$3" = "worktree" ] && [ "\$4" = "list" ] && [ "\$5" = "--porcelain" ]; then
  if [ -n "\${GIT_WORKTREE_FAIL:-}" ]; then
    # git refusing to answer at all. An empty list would read as "every device
    # is an orphan", which is the one wrong answer -G -f acts on.
    echo "fatal: not a git repository (or any of the parent directories): .git" >&2
    exit 128
  fi
  if [ -n "\${GIT_WORKTREES:-}" ]; then
    if [ -f "\${GIT_WORKTREES}" ]; then cat "\${GIT_WORKTREES}"; fi
    exit 0
  fi
fi
exec "$REAL_GIT" "\$@"
EOF
chmod +x "$SHIM_DIR/xcodebuild" "$SHIM_DIR/xcrun" "$SHIM_DIR/git"

# --- Fixtures ----------------------------------------------------------------
# Env files now carry ONLY the destination; the backend URL is derived from the
# .env fixture's APP_DOMAIN/SERVER_PORT.
cat > "$ENV_DIR/simulator.env" <<'EOF'
UNICOACH_DESTINATION="platform=iOS Simulator,name=iPhone 17 Pro"
EOF

cat > "$ENV_DIR/device.env" <<'EOF'
UNICOACH_DESTINATION="generic/platform=iOS"
EOF

# A simulator target that names its device by UDID instead of by name — the
# standard `platform=iOS Simulator,id=<UDID>` form Xcode itself writes. simctl
# accepts a UDID, so this must resolve rather than dead-end in the
# cannot-resolve fatal.
cat > "$ENV_DIR/id-simulator.env" <<'EOF'
UNICOACH_DESTINATION="platform=iOS Simulator,id=AAAABBBB-CCCC-DDDD-EEEE-FFFF00001111"
EOF

# A destination carrying a decoy key that merely ENDS in `name=`, before the
# real one: the extraction must be anchored to a component boundary, not match
# `devicename=` (or the LAST name= regardless of where the component starts).
cat > "$ENV_DIR/decoy-name-simulator.env" <<'EOF'
UNICOACH_DESTINATION="platform=iOS Simulator,devicename=Bogus Lead,name=iPhone 99 Real,simdevicename=Bogus Tail"
EOF

# A simulator target naming a model that no installed device type matches — the
# expected human error ("that iPhone is not installed locally"), which must
# fatal with the actual list rather than creating something arbitrary.
cat > "$ENV_DIR/unknown-model-simulator.env" <<'EOF'
UNICOACH_DESTINATION="platform=iOS Simulator,name=iPhone Nonexistent 42"
EOF

# Target fixtures that set an EXPLICIT UNICOACH_BACKEND_URL (honor path). The
# canonical no-path HTTPS deploy URL on a simulator destination (no signing) and
# on a device destination (requires signing.env).
cat > "$ENV_DIR/explicit-simulator.env" <<'EOF'
UNICOACH_DESTINATION="generic/platform=iOS Simulator"
UNICOACH_BACKEND_URL="https://api.uni.coach"
EOF

cat > "$ENV_DIR/explicit-device.env" <<'EOF'
UNICOACH_DESTINATION="generic/platform=iOS"
UNICOACH_BACKEND_URL="https://api.uni.coach"
EOF

# A target whose explicit URL carries a trailing-slash path and no port, to
# prove byte-for-byte passthrough of an arbitrary URL shape.
cat > "$ENV_DIR/explicit-trailing-slash.env" <<'EOF'
UNICOACH_DESTINATION="generic/platform=iOS Simulator"
UNICOACH_BACKEND_URL="https://api.uni.coach/"
EOF

# A device target that ALSO sets UNICOACH_CONFIGURATION=Debug, to prove
# release-ios ignores it and forces Release.
cat > "$ENV_DIR/debug-config-device.env" <<'EOF'
UNICOACH_DESTINATION="generic/platform=iOS"
UNICOACH_CONFIGURATION="Debug"
UNICOACH_BACKEND_URL="https://api.uni.coach"
EOF

# Deploy targets: UNICOACH_DEPLOY=1 and NO explicit UNICOACH_BACKEND_URL, so
# bin/build-ios DERIVES https://api.$APP_DOMAIN from the dotenv (the committed
# prod / prod-simulator targets work this way). The dotenv is the per-test
# UNICOACH_DOTENV fixture, so write_dotenv "<apex>" drives the derivation.
cat > "$ENV_DIR/deploy-simulator.env" <<'EOF'
UNICOACH_DESTINATION="generic/platform=iOS Simulator"
UNICOACH_DEPLOY=1
EOF

cat > "$ENV_DIR/deploy-device.env" <<'EOF'
UNICOACH_DESTINATION="generic/platform=iOS"
UNICOACH_DEPLOY=1
EOF

# Write the repo-.env fixture that bin/build-ios sources (via UNICOACH_DOTENV).
# Args: APP_DOMAIN value (empty => omit the line), optional SERVER_PORT value.
write_dotenv() {
  : > "$DOTENV"
  if [ -n "${1:-}" ]; then
    echo "APP_DOMAIN=$1" >> "$DOTENV"
  fi
  if [ -n "${2:-}" ]; then
    echo "SERVER_PORT=$2" >> "$DOTENV"
  fi
}

FIXTURE_TEAM="TEAMFIXTURE9"
write_signing_env() {
  cat > "$ENV_DIR/signing.env" <<EOF
UNICOACH_DEVELOPMENT_TEAM=$FIXTURE_TEAM
EOF
}
write_signing_env_with_device() {
  cat > "$ENV_DIR/signing.env" <<EOF
UNICOACH_DEVELOPMENT_TEAM=$FIXTURE_TEAM
UNICOACH_DEVICE=$1
EOF
}
write_signing_env_with_profile() {
  # The value is quoted because real profile names contain spaces and signing.env
  # is sourced (set -a; source) — an unquoted space would break parsing.
  cat > "$ENV_DIR/signing.env" <<EOF
UNICOACH_DEVELOPMENT_TEAM=$FIXTURE_TEAM
UNICOACH_PROVISIONING_PROFILE="$1"
EOF
}

# Stage a Debug-iphoneos UnicoachiOS.app so install-ios finds a built app.
stage_built_app() {
  mkdir -p "$PRODUCTS_DIR/Debug-iphoneos/UnicoachiOS.app"
}

# Stage a Debug-iphonesimulator UnicoachiOS.app so screenshot-ios finds a built
# app. A separate helper because the two scripts look under DIFFERENT SDK
# subdirectories — staging one must never satisfy the other's check.
stage_built_simulator_app() {
  mkdir -p "$PRODUCTS_DIR/Debug-iphonesimulator/UnicoachiOS.app"
}

# App Store Connect API credentials fixture for release-ios upload tests, plus
# the .p8 key file release-ios checks for existence.
ASC_KEY_ID="KEYID123"
ASC_ISSUER_ID="11111111-2222-3333-4444-555555555555"
ASC_KEY_PATH="$ENV_DIR/AuthKey_$ASC_KEY_ID.p8"
write_appstore_env() {
  cat > "$ENV_DIR/appstore.env" <<EOF
UNICOACH_ASC_KEY_ID=$ASC_KEY_ID
UNICOACH_ASC_ISSUER_ID=$ASC_ISSUER_ID
UNICOACH_ASC_KEY_PATH=$ASC_KEY_PATH
EOF
  : > "$ASC_KEY_PATH"
}

# Where release-ios writes its archive/export artifacts in tests (redirected out
# of the real repo via UNICOACH_BUILD_DIR).
RELEASE_BUILD_DIR="$WORK/iosbuild"
EXPORT_OPTIONS_PLIST="$RELEASE_BUILD_DIR/export/ExportOptions.plist"

# Two-device devicectl output fixture for the ambiguous-device case.
TWO_DEVICES="$WORK/two-devices.txt"
cat > "$TWO_DEVICES" <<'EOF'
Devices:
iPhone A (model)  00000000-1111111111111111  available
iPhone B (model)  22222222-3333333333333333  available
EOF

# --- Per-checkout simulator fixtures (RFC 126) --------------------------------
# bin/ios-sim names this checkout's device "<model> (<repo>/<checkout>)" — the
# basename of the MAIN checkout (the first entry of
# `git worktree list --porcelain`) and the basename of PROJECT_ROOT — and looks
# THAT name up in `simctl list devices`. The <checkout> half must be built from
# the SAME basename this harness runs under, since a hardcoded one would pass in
# one worktree and fail in the next; the <repo> half comes from the worktree
# FIXTURE below rather than from this machine's real repo, so every assertion
# reads the same everywhere.
CHECKOUT="$(basename "$PROJECT_ROOT")"
FIXTURE_REPO="acme"
# A device tagged for a DIFFERENT repository: never this repo's to collect, and
# the reason the tag is a repo name rather than a bare marker.
FOREIGN_REPO="zeus"

# `git worktree list --porcelain` as the git shim serves it: the authority on
# which checkouts are ALIVE, and therefore on which tagged device is an orphan.
# The FIRST stanza is the main checkout, whose basename is the repo tag. THIS
# checkout is present (so the resolve cases see themselves as live), as is one
# `.claude/worktrees/` checkout — the case the repo tag exists for, its basename
# being indistinguishable on its own from a device someone made by hand.
LIVE_CLAUDE_CHECKOUT="live-clarke-1234"
# A checkout whose directory was deleted with a plain `rm -rf` rather than
# `git worktree remove`. git prunes lazily — gc.worktreePruneExpire is 3 months —
# so the stanza is STILL LISTED, annotated `prunable`. That annotation is git's
# own verdict that the directory is gone, and this is the commonest way to get an
# orphaned device (nobody runs -D before deleting a directory), so its device
# must be collectable.
PRUNABLE_CHECKOUT="$FIXTURE_REPO-rfc-125"
# A worktree that is LOCKED — an external drive that is not mounted, say. Locked
# is not prunable: the checkout is alive and its device is still someone's.
LOCKED_CHECKOUT="$FIXTURE_REPO-rfc-124"
# A live checkout whose basename CONTAINS an orphan's, and a live checkout whose
# basename IS CONTAINED IN an orphan's. The membership test is a whole-line
# match; a substring one would read the short orphan as live (uncollectable
# forever), and the pair pins that in both directions rather than in whichever
# one the fixture happened to spell.
SUBSTR_LIVE_LONG="$FIXTURE_REPO-rfc-3-wip"
SUBSTR_LIVE_SHORT="$FIXTURE_REPO-rfc-4"
WORKTREES_LIVE="$WORK/worktrees-live.txt"
cat > "$WORKTREES_LIVE" <<EOF
worktree /Users/fixture/$FIXTURE_REPO
HEAD 1111111111111111111111111111111111111111
branch refs/heads/main

worktree $PROJECT_ROOT
HEAD 2222222222222222222222222222222222222222
branch refs/heads/ship/fixture

worktree /Users/fixture/$FIXTURE_REPO/.claude/worktrees/$LIVE_CLAUDE_CHECKOUT
HEAD 3333333333333333333333333333333333333333
detached

worktree /Users/fixture/$PRUNABLE_CHECKOUT
HEAD 4444444444444444444444444444444444444444
branch refs/heads/ship/deleted-by-hand
prunable gitdir file points to non-existent location

worktree /Volumes/unmounted/$LOCKED_CHECKOUT
HEAD 5555555555555555555555555555555555555555
branch refs/heads/ship/locked
locked

worktree /Users/fixture/$SUBSTR_LIVE_LONG
HEAD 6666666666666666666666666666666666666666
branch refs/heads/ship/substr-long

worktree /Users/fixture/$SUBSTR_LIVE_SHORT
HEAD 7777777777777777777777777777777777777777
branch refs/heads/ship/substr-short
EOF

# A `git worktree list --porcelain` that EXITS 0 and names no worktree this
# script can use — the shape a future git, or a wrapper, could produce. The repo
# tag is derived from it and every device name is built from that, so the run has
# to stop AND quote what git actually printed; a fatal reporting only the empty
# parse leaves the operator re-running git by hand.
WORKTREES_UNPARSEABLE="$WORK/worktrees-unparseable.txt"
cat > "$WORKTREES_UNPARSEABLE" <<'EOF'
warning: this repository has no worktrees to report
EOF

SIM_DEVICE_NAME="iPhone 17 Pro ($FIXTURE_REPO/$CHECKOUT)"
DECOY_DEVICE_NAME="iPhone 99 Real ($FIXTURE_REPO/$CHECKOUT)"
# The machine-global device the checked-in destination used to resolve
# verbatim. It is present in BOTH device fixtures precisely so that returning it
# is a detectable failure: the whole point of RFC 126 is that this is not our
# device.
SHARED_UDID="AAAAAAAA-0000-0000-0000-000000000001"
CHECKOUT_UDID="BBBBBBBB-0000-0000-0000-000000000002"
DECOY_UDID="CCCCCCCC-0000-0000-0000-000000000003"
UNAVAILABLE_UDID="DDDDDDDD-0000-0000-0000-000000000004"
# A device carrying the ORIGINAL RFC 126 name — this checkout's basename with no
# repo tag. It IS this checkout's device, from before the repo tag existed, and
# only this checkout ever looked it up: resolution ADOPTS it (renaming it to the
# tagged name) rather than stranding it. -D and -G still leave it alone: they
# act on the tagged name, and adoption is the resolve path's job.
LEGACY_DEVICE_NAME="iPhone 17 Pro ($CHECKOUT)"
LEGACY_UDID="AAAAAAAA-0000-0000-0000-00000000000A"
# An untagged device that is NOT this checkout's legacy name — the device a
# human made by hand. Nothing in this script may touch it: not adoption, not -D,
# not -G.
HANDMADE_DEVICE_NAME="iPhone 17 Pro (someones-hand-made-device)"
HANDMADE_UDID="AAAAAAAA-0000-0000-0000-00000000000B"
# What the xcrun shim's `simctl create` prints, i.e. the UDID of a device that
# did not exist until this run.
CREATED_UDID="EEEEEEEE-0000-0000-0000-00000000000E"

# `simctl list devices` with this checkout's devices already present. Real
# simctl shape, including the trailing space after the state and an unavailable
# device (whose runtime is gone) that must never be handed back as usable —
# listed FIRST, so a lookup that ignores the "(unavailable" suffix returns it
# rather than the real device.
DEVICES_PRESENT="$WORK/devices-present.txt"
cat > "$DEVICES_PRESENT" <<EOF
== Devices ==
-- Unavailable: com.apple.CoreSimulator.SimRuntime.iOS-16-4 --
    $SIM_DEVICE_NAME ($UNAVAILABLE_UDID) (Shutdown) (unavailable, runtime profile not found using "System" match policy)
-- iOS 26.2 --
    iPhone 17 Pro ($SHARED_UDID) (Shutdown) 
    $LEGACY_DEVICE_NAME ($LEGACY_UDID) (Shutdown) 
    $HANDMADE_DEVICE_NAME ($HANDMADE_UDID) (Shutdown) 
    $SIM_DEVICE_NAME ($CHECKOUT_UDID) (Shutdown) 
    $DECOY_DEVICE_NAME ($DECOY_UDID) (Booted) 
EOF

# Two AVAILABLE devices carrying this checkout's name, plus the unavailable one.
# simctl does not enforce unique names, so two first-runs in one checkout
# (screenshot-ios and test-ios in the same iteration) can each list-then-create
# and land here. Resolution must refuse rather than pick one; -D must clear all
# THREE, the unavailable twin included.
DEVICES_DUPLICATE="$WORK/devices-duplicate.txt"
DUPLICATE_UDID="FFFFFFFF-0000-0000-0000-00000000000F"
cat > "$DEVICES_DUPLICATE" <<EOF
== Devices ==
-- Unavailable: com.apple.CoreSimulator.SimRuntime.iOS-16-4 --
    $SIM_DEVICE_NAME ($UNAVAILABLE_UDID) (Shutdown) (unavailable, runtime profile not found using "System" match policy)
-- iOS 26.2 --
    iPhone 17 Pro ($SHARED_UDID) (Shutdown) 
    $LEGACY_DEVICE_NAME ($LEGACY_UDID) (Shutdown) 
    $SIM_DEVICE_NAME ($CHECKOUT_UDID) (Shutdown) 
    $SIM_DEVICE_NAME ($DUPLICATE_UDID) (Shutdown) 
EOF

# The same listing WITHOUT this checkout's devices — the first-run state. The
# shared `iPhone 17 Pro` is still there, so a lookup that matched the MODEL
# rather than the per-checkout NAME would return $SHARED_UDID here instead of
# creating.
DEVICES_ABSENT="$WORK/devices-absent.txt"
cat > "$DEVICES_ABSENT" <<EOF
== Devices ==
-- iOS 26.2 --
    iPhone 17 Pro ($SHARED_UDID) (Shutdown) 
    iPhone 17 Pro Max (99999999-0000-0000-0000-000000000009) (Shutdown) 
EOF

# The migration state: this checkout's device exists ONLY under the pre-repo-tag
# name. It must be ADOPTED (renamed in place, keeping its installed app and
# data), not stranded while a second device is created beside it. The
# hand-made untagged device and the machine-global one are in the same listing,
# so an adoption keyed on anything looser than this checkout's exact legacy name
# is a detectable failure.
DEVICES_LEGACY="$WORK/devices-legacy.txt"
cat > "$DEVICES_LEGACY" <<EOF
== Devices ==
-- iOS 26.2 --
    iPhone 17 Pro ($SHARED_UDID) (Shutdown) 
    $HANDMADE_DEVICE_NAME ($HANDMADE_UDID) (Shutdown) 
    $LEGACY_DEVICE_NAME ($LEGACY_UDID) (Shutdown) 
EOF

# TWO devices under the legacy name and none under the tagged one. Which of them
# is this checkout's is exactly the ambiguity the tagged name refuses on the
# resolve path, so neither is adopted: a clean device is created instead.
DEVICES_LEGACY_TWINS="$WORK/devices-legacy-twins.txt"
LEGACY_TWIN_UDID="AAAAAAAA-0000-0000-0000-00000000000C"
cat > "$DEVICES_LEGACY_TWINS" <<EOF
== Devices ==
-- iOS 26.2 --
    iPhone 17 Pro ($SHARED_UDID) (Shutdown) 
    $LEGACY_DEVICE_NAME ($LEGACY_UDID) (Shutdown) 
    $LEGACY_DEVICE_NAME ($LEGACY_TWIN_UDID) (Shutdown) 
EOF

# No device of this checkout's at all, tagged or legacy — only a hand-made
# untagged device and the machine-global one. Nothing here is ours, so the run
# CREATES and renames nothing.
DEVICES_HANDMADE_ONLY="$WORK/devices-handmade-only.txt"
cat > "$DEVICES_HANDMADE_ONLY" <<EOF
== Devices ==
-- iOS 26.2 --
    iPhone 17 Pro ($SHARED_UDID) (Shutdown) 
    $HANDMADE_DEVICE_NAME ($HANDMADE_UDID) (Shutdown) 
EOF

# --- Orphan-collection fixtures (bin/ios-sim -G) ------------------------------
# A worktree can be deleted without anyone running -D, and the device outlives
# the directory. The listing below mixes the two orphans with every kind of
# device that must SURVIVE, because -G -f is destructive and unattended: this
# checkout's own device, a live sibling's, an untagged one, one tagged for
# another repo, and the machine-global model-named device.
ORPHAN_CHECKOUT="$FIXTURE_REPO-rfc-122"
ORPHAN_UDID="11111111-0000-0000-0000-000000000011"
# A second orphan whose MODEL carries its own parentheses, so the tag is proven
# to be found as the LAST parenthesised group of the name rather than the only
# one — and whose checkout is a `.claude/worktrees/` basename, the shape that is
# unidentifiable without the repo tag.
ORPHAN_PAREN_CHECKOUT="dead-clarke-9999"
ORPHAN_PAREN_UDID="22222222-0000-0000-0000-000000000022"
# An orphan whose runtime is gone. Availability is a RESOLVE concern (an
# unavailable device cannot be booted); for collection it is irrelevant, and
# skipping it would leave the orphan behind forever.
ORPHAN_UNAVAILABLE_CHECKOUT="$FIXTURE_REPO-rfc-120"
ORPHAN_UNAVAILABLE_UDID="33333333-0000-0000-0000-000000000033"
# Tagged for a live `.claude/worktrees/` checkout: the collector's hardest
# not-an-orphan, since its basename looks like nothing in particular.
LIVE_CLAUDE_UDID="44444444-0000-0000-0000-000000000044"
# Tagged for ANOTHER repository, whose checkout is not in this repo's worktree
# list at all — an orphan by every test except the one that matters.
FOREIGN_UDID="55555555-0000-0000-0000-000000000055"
# The device of the checkout someone deleted with `rm -rf`: its stanza is still
# in the worktree listing, marked `prunable`. This is the case -G is sold as the
# answer to, so it must be COLLECTED — a parse that kept only the `worktree`
# line would call it live and never collect it.
PRUNABLE_UDID="66666666-0000-0000-0000-000000000066"
# The LOCKED worktree's device. Locked is not gone: it must SURVIVE.
LOCKED_UDID="77777777-0000-0000-0000-000000000077"
# The substring pair's four devices: two orphans and two live ones whose
# basenames overlap them.
SUBSTR_ORPHAN_SHORT="$FIXTURE_REPO-rfc-3"
SUBSTR_ORPHAN_SHORT_UDID="88888888-0000-0000-0000-000000000088"
SUBSTR_ORPHAN_LONG="$SUBSTR_LIVE_SHORT-wip"
SUBSTR_ORPHAN_LONG_UDID="99999999-0000-0000-0000-000000000099"
SUBSTR_LIVE_LONG_UDID="AAAAAAAA-0000-0000-0000-0000000000AA"
SUBSTR_LIVE_SHORT_UDID="BBBBBBBB-0000-0000-0000-0000000000BB"

DEVICES_GC="$WORK/devices-gc.txt"
cat > "$DEVICES_GC" <<EOF
== Devices ==
-- Unavailable: com.apple.CoreSimulator.SimRuntime.iOS-16-4 --
    iPhone 17 Pro ($FIXTURE_REPO/$ORPHAN_UNAVAILABLE_CHECKOUT) ($ORPHAN_UNAVAILABLE_UDID) (Shutdown) (unavailable, runtime profile not found using "System" match policy)
-- iOS 26.2 --
    iPhone 17 Pro ($SHARED_UDID) (Shutdown) 
    $LEGACY_DEVICE_NAME ($LEGACY_UDID) (Shutdown) 
    $HANDMADE_DEVICE_NAME ($HANDMADE_UDID) (Shutdown) 
    $SIM_DEVICE_NAME ($CHECKOUT_UDID) (Shutdown) 
    iPhone 17 Pro ($FIXTURE_REPO/$LIVE_CLAUDE_CHECKOUT) ($LIVE_CLAUDE_UDID) (Shutdown) 
    iPhone 17 Pro ($FOREIGN_REPO/$FOREIGN_REPO-rfc-1) ($FOREIGN_UDID) (Shutdown) 
    iPhone 17 Pro ($FIXTURE_REPO/$ORPHAN_CHECKOUT) ($ORPHAN_UDID) (Booted) 
    iPad Pro 13-inch (M5) ($FIXTURE_REPO/$ORPHAN_PAREN_CHECKOUT) ($ORPHAN_PAREN_UDID) (Shutdown) 
    iPhone 17 Pro ($FIXTURE_REPO/$PRUNABLE_CHECKOUT) ($PRUNABLE_UDID) (Shutdown) 
    iPhone 17 Pro ($FIXTURE_REPO/$LOCKED_CHECKOUT) ($LOCKED_UDID) (Shutdown) 
    iPhone 17 Pro ($FIXTURE_REPO/$SUBSTR_ORPHAN_SHORT) ($SUBSTR_ORPHAN_SHORT_UDID) (Shutdown) 
    iPhone 17 Pro ($FIXTURE_REPO/$SUBSTR_ORPHAN_LONG) ($SUBSTR_ORPHAN_LONG_UDID) (Shutdown) 
    iPhone 17 Pro ($FIXTURE_REPO/$SUBSTR_LIVE_LONG) ($SUBSTR_LIVE_LONG_UDID) (Shutdown) 
    iPhone 17 Pro ($FIXTURE_REPO/$SUBSTR_LIVE_SHORT) ($SUBSTR_LIVE_SHORT_UDID) (Shutdown) 
EOF

# The same listing with the two collectable orphans removed: every tagged device
# left belongs to a live checkout, which is the steady state -G must report as
# empty rather than as "nothing matched, delete the rest".
DEVICES_GC_CLEAN="$WORK/devices-gc-clean.txt"
cat > "$DEVICES_GC_CLEAN" <<EOF
== Devices ==
-- iOS 26.2 --
    iPhone 17 Pro ($SHARED_UDID) (Shutdown) 
    $LEGACY_DEVICE_NAME ($LEGACY_UDID) (Shutdown) 
    $HANDMADE_DEVICE_NAME ($HANDMADE_UDID) (Shutdown) 
    $SIM_DEVICE_NAME ($CHECKOUT_UDID) (Shutdown) 
    iPhone 17 Pro ($FIXTURE_REPO/$LIVE_CLAUDE_CHECKOUT) ($LIVE_CLAUDE_UDID) (Shutdown) 
    iPhone 17 Pro ($FOREIGN_REPO/$FOREIGN_REPO-rfc-1) ($FOREIGN_UDID) (Shutdown) 
    iPhone 17 Pro ($FIXTURE_REPO/$LOCKED_CHECKOUT) ($LOCKED_UDID) (Shutdown) 
    iPhone 17 Pro ($FIXTURE_REPO/$SUBSTR_LIVE_LONG) ($SUBSTR_LIVE_LONG_UDID) (Shutdown) 
    iPhone 17 Pro ($FIXTURE_REPO/$SUBSTR_LIVE_SHORT) ($SUBSTR_LIVE_SHORT_UDID) (Shutdown) 
EOF


# `simctl list devicetypes`. `iPhone 17 Pro` and `iPhone 17 Pro Max` are both
# present so the match is proven EXACT rather than prefix-based.
DEVICETYPES="$WORK/devicetypes.txt"
cat > "$DEVICETYPES" <<'EOF'
== Device Types ==
iPhone 17 (com.apple.CoreSimulator.SimDeviceType.iPhone-17)
iPhone 17 Pro Max (com.apple.CoreSimulator.SimDeviceType.iPhone-17-Pro-Max)
iPhone 17 Pro (com.apple.CoreSimulator.SimDeviceType.iPhone-17-Pro)
iPhone 99 Real (com.apple.CoreSimulator.SimDeviceType.iPhone-99-Real)
iPad Pro 13-inch (M5) (com.apple.CoreSimulator.SimDeviceType.iPad-Pro-13-inch-M5-8GB)
EOF
NEWEST_RUNTIME="com.apple.CoreSimulator.SimRuntime.iOS-26-10"
OLDER_RUNTIME="com.apple.CoreSimulator.SimRuntime.iOS-26-2"
UNAVAILABLE_RUNTIME="com.apple.CoreSimulator.SimRuntime.iOS-27-0"
# `simctl list runtimes`. bin/ios-sim does NOT rank these: it omits the runtime
# argument from `simctl create` so that CoreSimulator picks the newest runtime
# COMPATIBLE WITH THE DEVICE TYPE, which needs a compatibility table this script
# cannot see. The fixture is kept because the create fatal quotes the runtime
# list as its diagnosis of "no iOS runtime installed", and because a version of
# ios-sim that went back to choosing a runtime itself would have to name one of
# these ids in the argv log — which the create case asserts it does not.
RUNTIMES="$WORK/runtimes.txt"
cat > "$RUNTIMES" <<EOF
== Runtimes ==
iOS 17.5 (17.5 - 21F79) - com.apple.CoreSimulator.SimRuntime.iOS-17-5
iOS 26.10 (26.10 - 23D99) - $NEWEST_RUNTIME
iOS 26.2 (26.2 - 23C54) - $OLDER_RUNTIME
watchOS 26.4 (26.4 - 23S54) - com.apple.CoreSimulator.SimRuntime.watchOS-26-4
iOS 27.0 (27.0 - 24A100) - $UNAVAILABLE_RUNTIME (unavailable, runtime profile not found using "System" match policy)
EOF


reset_log() { : > "$ARGV_LOG"; }

# Run a bin script with the shims first on PATH and env/products overrides set.
# DEV_SHELL_MARKER is honoured to simulate the dev shell for the guard cases:
# when set, it is exported into the child as UNICOACH_DEV_SHELL (the marker
# bin/is-nix keys on) ONLY for that invocation. The expansion below emits the
# `env`-style argument `UNICOACH_DEV_SHELL=<DEV_SHELL_MARKER>` when
# DEV_SHELL_MARKER is set, nothing otherwise.
# `env -u` cannot be used unconditionally because the harness already unset the
# var; the empty expansion simply contributes no argument.
run_build() {
  reset_log
  env PATH="$SHIM_DIR:$PATH" \
    UNICOACH_ENV_DIR="$ENV_DIR" \
    UNICOACH_DOTENV="$DOTENV" \
    ${DEV_SHELL_MARKER:+UNICOACH_DEV_SHELL="$DEV_SHELL_MARKER"} \
    "$PROJECT_ROOT/bin/build-ios" "$@"
}
run_install() {
  reset_log
  env PATH="$SHIM_DIR:$PATH" \
    UNICOACH_ENV_DIR="$ENV_DIR" \
    UNICOACH_PRODUCTS_DIR="$PRODUCTS_DIR" \
    DEVICECTL_LIST_OUTPUT="${DEVICECTL_LIST_OUTPUT:-}" \
    ${DEV_SHELL_MARKER:+UNICOACH_DEV_SHELL="$DEV_SHELL_MARKER"} \
    "$PROJECT_ROOT/bin/install-ios" "$@"
}
# Run release-ios with the shims first on PATH, artifacts redirected into a temp
# build dir, and the build number pinned (so the assertion does not depend on
# the repo's real commit count). RELEASE_BUILD_NUMBER may be set to the empty
# string by a caller to exercise the git-derived path instead.
run_release() {
  reset_log
  env PATH="$SHIM_DIR:$PATH" \
    UNICOACH_ENV_DIR="$ENV_DIR" \
    UNICOACH_DOTENV="$DOTENV" \
    UNICOACH_BUILD_DIR="$RELEASE_BUILD_DIR" \
    UNICOACH_BUILD_NUMBER="${RELEASE_BUILD_NUMBER-7}" \
    ${DEV_SHELL_MARKER:+UNICOACH_DEV_SHELL="$DEV_SHELL_MARKER"} \
    "$PROJECT_ROOT/bin/release-ios" "$@"
}

# Run screenshot-ios with the shims first on PATH, the env fixtures and staged
# products in play, and the default screenshot destination redirected into the
# temp work dir so no test ever writes into the real repo. SIMCTL_BOOT_BOOTED
# (empty unless a case sets it) drives the xcrun shim's already-booted failure,
# and SIMULATOR_OVERRIDE, when set, becomes UNICOACH_SIMULATOR for that one
# invocation — mirroring the ${DEV_SHELL_MARKER:+...} form so an unset override
# contributes no argument at all (rather than an empty one that would read as
# "explicitly set to nothing").
run_screenshot() {
  reset_log
  env PATH="$SHIM_DIR:$PATH" \
    UNICOACH_ENV_DIR="$ENV_DIR" \
    UNICOACH_PRODUCTS_DIR="$PRODUCTS_DIR" \
    UNICOACH_SCREENSHOT_DIR="$SCREENSHOT_DIR" \
    SIMCTL_BOOT_BOOTED="${SIMCTL_BOOT_BOOTED:-}" \
    SIMCTL_BOOT_FAIL="${SIMCTL_BOOT_FAIL:-}" \
    SIMCTL_NO_WRITE="${SIMCTL_NO_WRITE:-}" \
    SIMCTL_INSTALL_FAIL="${SIMCTL_INSTALL_FAIL:-}" \
    SIMCTL_DEVICES="${SIMCTL_DEVICES:-$DEVICES_PRESENT}" \
    SIMCTL_DEVICETYPES="${SIMCTL_DEVICETYPES:-$DEVICETYPES}" \
    SIMCTL_RUNTIMES="${SIMCTL_RUNTIMES:-$RUNTIMES}" \
    SIMCTL_CREATE_UDID="${SIMCTL_CREATE_UDID:-$CREATED_UDID}" \
    GIT_WORKTREES="${GIT_WORKTREES:-$WORKTREES_LIVE}" \
    ${SIMULATOR_OVERRIDE:+UNICOACH_SIMULATOR="$SIMULATOR_OVERRIDE"} \
    ${DEV_SHELL_MARKER:+UNICOACH_DEV_SHELL="$DEV_SHELL_MARKER"} \
    "$PROJECT_ROOT/bin/screenshot-ios" "$@"
}

# Run screenshot-ios against the REAL ios-app/env directory (no UNICOACH_ENV_DIR
# override), so the checked-in targets themselves are under test. Everything
# else is still redirected: the .app is the staged fixture and the PNG lands in
# the temp screenshot dir, so this needs no build and writes nothing into the
# repo. UNICOACH_SIMULATOR is explicitly cleared — an inherited one would
# resolve the device and hide a broken checked-in destination.
run_screenshot_real_env() {
  reset_log
  env -u UNICOACH_ENV_DIR -u UNICOACH_SIMULATOR \
    PATH="$SHIM_DIR:$PATH" \
    UNICOACH_PRODUCTS_DIR="$PRODUCTS_DIR" \
    UNICOACH_SCREENSHOT_DIR="$SCREENSHOT_DIR" \
    SIMCTL_DEVICES="${SIMCTL_DEVICES:-$DEVICES_PRESENT}" \
    SIMCTL_DEVICETYPES="${SIMCTL_DEVICETYPES:-$DEVICETYPES}" \
    SIMCTL_RUNTIMES="${SIMCTL_RUNTIMES:-$RUNTIMES}" \
    SIMCTL_CREATE_UDID="${SIMCTL_CREATE_UDID:-$CREATED_UDID}" \
    GIT_WORKTREES="${GIT_WORKTREES:-$WORKTREES_LIVE}" \
    "$PROJECT_ROOT/bin/screenshot-ios" "$@"
}

# Run one of the two per-checkout simulator scripts (bin/$1) with the shims
# first on PATH and the three `simctl list` fixtures in play. SIMCTL_DEVICES
# defaults to the listing where this checkout's device ALREADY EXISTS (the
# steady state); a case drives the first-run path by prefixing
# SIMCTL_DEVICES="$DEVICES_ABSENT". test-ios shells out to ios-sim, which needs
# the same fixtures and inherits them through the environment — which is why the
# two share one wrapper rather than carrying their own env blocks.
#
# GIT_WORKTREES points the git shim at the live-worktree fixture: it is what the
# repo tag in every device name is derived from, so without it these cases would
# read this machine's real checkouts. SIM_ENV_DIR overrides the env-fixture
# directory for the one case that must prove -G reads NO env file at all.
run_sim_script() {
  local script="$1"
  shift
  reset_log
  env PATH="$SHIM_DIR:$PATH" \
    UNICOACH_ENV_DIR="${SIM_ENV_DIR:-$ENV_DIR}" \
    SIMCTL_DEVICES="${SIMCTL_DEVICES:-$DEVICES_PRESENT}" \
    SIMCTL_DEVICETYPES="${SIMCTL_DEVICETYPES:-$DEVICETYPES}" \
    SIMCTL_RUNTIMES="${SIMCTL_RUNTIMES:-$RUNTIMES}" \
    SIMCTL_CREATE_UDID="${SIMCTL_CREATE_UDID:-$CREATED_UDID}" \
    SIMCTL_CREATE_FAIL="${SIMCTL_CREATE_FAIL:-}" \
    SIMCTL_LIST_FAIL="${SIMCTL_LIST_FAIL:-}" \
    SIMCTL_RENAME_FAIL="${SIMCTL_RENAME_FAIL:-}" \
    SIMCTL_SHUTDOWN_FAIL="${SIMCTL_SHUTDOWN_FAIL:-}" \
    SIMCTL_DELETE_FAIL_UDID="${SIMCTL_DELETE_FAIL_UDID:-}" \
    GIT_WORKTREES="${GIT_WORKTREES:-$WORKTREES_LIVE}" \
    GIT_WORKTREE_FAIL="${GIT_WORKTREE_FAIL:-}" \
    ${DEV_SHELL_MARKER:+UNICOACH_DEV_SHELL="$DEV_SHELL_MARKER"} \
    "$PROJECT_ROOT/bin/$script" "$@"
}

run_ios_sim() { run_sim_script ios-sim "$@"; }
run_test_ios() { run_sim_script test-ios "$@"; }

# Run snapshot-ios with the shims first on PATH, the env fixtures in play, and
# the corpus directory redirected into the temp work dir so no test ever writes
# into the real repo. SNAPSHOT_NO_WRITE / SNAPSHOT_TEST_FAIL drive the
# xcodebuild shim's two failure models (a run that wrote nothing, and a run that
# failed), each contributing no argument at all when unset — the same
# `${VAR:+...}` form the other wrappers use.
#
# The three `simctl list` fixtures are here because snapshot-ios no longer calls
# xcodebuild itself: it delegates to bin/test-ios, which resolves this checkout's
# device through bin/ios-sim (RFC 126). Both inherit them through the
# environment, exactly as run_sim_script's two callers do. Without them ios-sim
# would query the REAL simulator list and the cases below would depend on the
# machine.
run_snapshot() {
  reset_log
  env PATH="$SHIM_DIR:$PATH" \
    UNICOACH_ENV_DIR="$ENV_DIR" \
    UNICOACH_SNAPSHOT_DIR="$SNAPSHOT_DIR" \
    SIMCTL_DEVICES="${SIMCTL_DEVICES:-$DEVICES_PRESENT}" \
    SIMCTL_DEVICETYPES="${SIMCTL_DEVICETYPES:-$DEVICETYPES}" \
    SIMCTL_RUNTIMES="${SIMCTL_RUNTIMES:-$RUNTIMES}" \
    SIMCTL_CREATE_UDID="${SIMCTL_CREATE_UDID:-$CREATED_UDID}" \
    GIT_WORKTREES="${GIT_WORKTREES:-$WORKTREES_LIVE}" \
    SNAPSHOT_NO_WRITE="${SNAPSHOT_NO_WRITE:-}" \
    SNAPSHOT_TEST_FAIL="${SNAPSHOT_TEST_FAIL:-}" \
    ${DEV_SHELL_MARKER:+UNICOACH_DEV_SHELL="$DEV_SHELL_MARKER"} \
    "$PROJECT_ROOT/bin/snapshot-ios" "$@"
}

# Run bin/is-nix directly, honouring DEV_SHELL_MARKER as the simulated marker.
# IN_NIX_SHELL is unset here so the marker is the ONLY variable in play: this
# harness inherits IN_NIX_SHELL when launched via `nix develop -c`, which would
# otherwise silently route the marker-absent cases through is-nix's foreign-shell
# branch and make them assert a different message than they name. The other two
# states have their own wrappers below, which set IN_NIX_SHELL back.
run_is_nix() {
  env -u IN_NIX_SHELL ${DEV_SHELL_MARKER:+UNICOACH_DEV_SHELL="$DEV_SHELL_MARKER"} "$PROJECT_ROOT/bin/is-nix" "$@"
}

# Run bin/is-nix in a FOREIGN Nix shell: IN_NIX_SHELL set, unicoach's marker
# absent — the false positive RFC 114 exists to kill. A named helper so all
# three environment states this suite drives (unicoach shell, no shell, foreign
# shell) are CONSTRUCTED by a wrapper rather than assembled inline per case,
# where an omitted `env -u` silently reclassifies the case under test.
run_is_nix_foreign_shell() {
  env -u UNICOACH_DEV_SHELL IN_NIX_SHELL=impure "$PROJECT_ROOT/bin/is-nix" "$@"
}

# Run bin/is-nix in the REAL dev-shell environment: both the marker and
# IN_NIX_SHELL set, exactly as `nix develop` leaves it. run_is_nix deliberately
# unsets IN_NIX_SHELL to isolate the marker, so without this helper the state
# every developer is actually in would be the one state never exercised.
run_is_nix_unicoach_shell() {
  env UNICOACH_DEV_SHELL=1 IN_NIX_SHELL=impure "$PROJECT_ROOT/bin/is-nix" "$@"
}

# Assert a literal line is present in the recorded argv log. `--` guards patterns
# that begin with a dash (e.g. -allowProvisioningUpdates) from being parsed as
# grep flags.
log_has() { grep -Fxq -e "$1" "$ARGV_LOG"; }
# Assert a literal line is ABSENT from the recorded argv log.
log_lacks() { ! grep -Fxq -e "$1" "$ARGV_LOG"; }
# Assert the argv log records NO invocation of the named tool (its prefix line).
log_no_tool() { ! grep -Fxq -e "$1" "$ARGV_LOG"; }

# Assert a literal substring is present in the generated ExportOptions.plist
# (release-ios writes it to a known path under the temp build dir).
export_option_has() { grep -Fq -e "$1" "$EXPORT_OPTIONS_PLIST"; }

# ============================== is-nix tests =================================

test_isnix_quiet_inside() {
  local out
  out="$(DEV_SHELL_MARKER=1 run_is_nix -q 2>&1)" && local rc=0 || local rc=$?
  [ "$rc" -eq 0 ] || return 1
  [ -z "$out" ] || return 1
  return 0
}

test_isnix_quiet_outside() {
  local out rc
  out="$(run_is_nix -q 2>&1)" && rc=0 || rc=$?
  [ "$rc" -eq 1 ] || return 1
  [ -z "$out" ] || return 1
  return 0
}

test_isnix_default_inside() {
  local out rc
  out="$(DEV_SHELL_MARKER=1 run_is_nix 2>&1)" && rc=0 || rc=$?
  [ "$rc" -eq 0 ] || return 1
  echo "$out" | grep -q "unicoach dev shell active"
}

test_isnix_default_outside() {
  local out rc
  out="$(run_is_nix 2>&1)" && rc=0 || rc=$?
  [ "$rc" -eq 1 ] || return 1
  # -x (whole line): is-nix's three status lines are disjoint, so a substring
  # match would also be correct here — the whole-line form additionally pins the
  # `(no Nix shell)` qualifier that KEEPS them disjoint, so deleting it as
  # redundant fails this case rather than silently loosening two others.
  echo "$out" | grep -qx "unicoach dev shell NOT active (no Nix shell)"
}

# Precedence: in a real `nix develop` shell BOTH variables are set. The marker
# must take precedence — if the IN_NIX_SHELL branch were tested first, every developer
# in the actual dev shell would be told a foreign shell was active.
test_isnix_marker_takes_precedence_over_in_nix_shell() {
  local out rc
  out="$(run_is_nix_unicoach_shell 2>&1)" && rc=0 || rc=$?
  [ "$rc" -eq 0 ] || return 1
  echo "$out" | grep -qx "unicoach dev shell active"
}

# The regression pin for RFC 114: a foreign flake's shell sets IN_NIX_SHELL but
# not unicoach's marker, and must NOT read as the dev shell. Under the old
# IN_NIX_SHELL-keyed predicate this exited 0.
test_isnix_foreign_shell_quiet() {
  local out rc
  out="$(run_is_nix_foreign_shell -q 2>&1)" && rc=0 || rc=$?
  [ "$rc" -eq 1 ] || return 1
  [ -z "$out" ] || return 1
  return 0
}

# Same environment, non-quiet: the status line names the foreign shell and does
# not claim the unicoach shell is active.
test_isnix_foreign_shell_message() {
  local out rc
  out="$(run_is_nix_foreign_shell 2>&1)" && rc=0 || rc=$?
  [ "$rc" -eq 1 ] || return 1
  echo "$out" | grep -qx "unicoach dev shell NOT active (a different Nix shell is active)" || return 1
  ! echo "$out" | grep -q "unicoach dev shell active"
}

test_isnix_verbose_lists_packages() {
  local out rc
  # Built inline rather than via run_is_nix_unicoach_shell: this case also has to
  # inject a FIXTURE nativeBuildInputs, and the real dev shell exports a real one
  # that would otherwise leak in and add packages to the listing.
  out="$(env -u IN_NIX_SHELL UNICOACH_DEV_SHELL=1 \
    nativeBuildInputs="/nix/store/abc123-foo-1.0 /nix/store/def456-bar-2.0" \
    "$PROJECT_ROOT/bin/is-nix" -v 2>&1)" && rc=0 || rc=$?
  [ "$rc" -eq 0 ] || return 1
  echo "$out" | grep -qx "foo-1.0" || return 1
  echo "$out" | grep -qx "bar-2.0" || return 1
  return 0
}

test_isnix_bogus_option() {
  local out rc
  out="$("$PROJECT_ROOT/bin/is-nix" --bogus 2>&1)" && rc=0 || rc=$?
  [ "$rc" -ne 0 ] || return 1
  echo "$out" | grep -qi "unknown option"
}

# ========================== dev-shell guard tests ============================

test_build_guard_simulator() {
  write_dotenv ""   # localhost default
  local out rc
  out="$(DEV_SHELL_MARKER=1 run_build simulator 2>&1)" && rc=0 || rc=$?
  [ "$rc" -ne 0 ] || return 1
  echo "$out" | grep -q "build-ios" || return 1
  echo "$out" | grep -qi "system Xcode" || return 1
  # Guard fires before any tool: no xcodebuild line recorded.
  log_no_tool "xcodebuild"
}

test_build_guard_precedence_over_missing_env() {
  # Even with a nonexistent env (which would normally be the failure), the guard
  # message must win because it precedes env resolution.
  local out rc
  out="$(DEV_SHELL_MARKER=1 run_build nonexistent-env 2>&1)" && rc=0 || rc=$?
  [ "$rc" -ne 0 ] || return 1
  echo "$out" | grep -qi "system Xcode" || return 1
  # Must NOT be the missing-env message.
  if echo "$out" | grep -q "nonexistent-env.env"; then return 1; fi
  log_no_tool "xcodebuild"
}

test_install_guard_device() {
  write_signing_env
  stage_built_app
