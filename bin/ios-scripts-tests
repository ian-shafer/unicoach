assert_success "snapshot-ios: pins the test runner to en/US and UTC" test_snapshot_pins_locale_and_timezone
assert_success "snapshot-ios: -o writes and prints that exact directory" test_snapshot_explicit_output_dir
assert_success "snapshot-ios: there is no -d device option" test_snapshot_has_no_device_option
assert_success "snapshot-ios: -b forwards the baseline dir to the test runner" test_snapshot_baseline_forwarded
assert_success "snapshot-ios: a nonexistent -b directory fails before any build" test_snapshot_missing_baseline_dir_is_fatal
assert_success "snapshot-ios: xcodebuild exiting 0 with an empty corpus is fatal" test_snapshot_empty_corpus_is_fatal
assert_success "snapshot-ios: a failing bin/test-ios is this script's fatal" test_snapshot_test_failure_is_fatal
assert_success "snapshot-ios: unknown option fails with the usage-band code" test_snapshot_unknown_option
assert_success "snapshot-ios: option missing its value fails with the usage-band code" test_snapshot_option_requires_value
assert_success "snapshot-ios: stray positional fails with the usage-band code" test_snapshot_stray_positional
assert_success "snapshot-ios: an option after the target says to reorder" test_snapshot_option_after_target
assert_success "snapshot-ios: empty -o / -b values are rejected, not read as absent" test_snapshot_empty_option_values_rejected
assert_success "snapshot-ios: stdout is EXACTLY the corpus directory" test_snapshot_stdout_is_only_the_corpus_dir
