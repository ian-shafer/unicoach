# Happy path: the full simctl sequence is recorded, and the path printed on
# stdout names a file that exists under the screenshot dir.
test_screenshot_happy_path() {
  stage_built_simulator_app
  local out
  out="$(run_screenshot -w 0 simulator 2>/dev/null)" || return 1
  log_has "simctl" || return 1
  log_has "boot" || return 1
  log_has "bootstatus" || return 1
  log_has "-b" || return 1
  log_has "install" || return 1
  log_has "launch" || return 1
  log_has "coach.uni.UnicoachiOS" || return 1
  log_has "$PRODUCTS_DIR/Debug-iphonesimulator/UnicoachiOS.app" || return 1
  log_has "io" || return 1
  log_has "screenshot" || return 1
  log_has "$out" || return 1
  [ -f "$out" ] || return 1
  case "$out" in "$SCREENSHOT_DIR"/*) ;; *) return 1 ;; esac
  return 0
}

# -o wins: that exact path is what simctl is told to write and what is printed.
test_screenshot_explicit_output_path() {
  stage_built_simulator_app
  local target="$WORK/explicit-shot.png"
  rm -f "$target"
  local out
  out="$(run_screenshot -w 0 -o "$target" simulator 2>/dev/null)" || return 1
  [ "$out" = "$target" ] || return 1
  log_has "$target" || return 1
  [ -f "$target" ] || return 1
  return 0
}

# Default naming: no -o puts the PNG under UNICOACH_SCREENSHOT_DIR, named for
# the target, with a .png extension.
test_screenshot_default_output_dir() {
  stage_built_simulator_app
  local out
  out="$(run_screenshot -w 0 simulator 2>/dev/null)" || return 1
  case "$out" in "$SCREENSHOT_DIR"/simulator-*.png) ;; *) return 1 ;; esac
  return 0
}

# Everything after `--` reaches the launch invocation verbatim: the seam for
# driving the app to a particular screen before the capture.
test_screenshot_forwards_launch_args() {
  stage_built_simulator_app
  run_screenshot -w 0 simulator -- -UnicoachUITestScreen profile >/dev/null 2>&1 || return 1
  log_has "launch" || return 1
  log_has "-UnicoachUITestScreen" || return 1
  log_has "profile" || return 1
  return 0
}

# A capture passes NOTHING about StoreKit: the app is disabled by default on a
# simulator Debug build, so there is no flag for this script -- or any future
# launcher -- to remember. Pinning the absence is what stops a well-meaning
# re-addition of a per-caller flag, which is the shape of the original defect.
test_screenshot_passes_no_storekit_argument() {
  stage_built_simulator_app
  run_screenshot -w 0 simulator >/dev/null 2>&1 || return 1
  log_has "launch" || return 1
  log_lacks "StoreKit" || return 1
  return 0
}

# ...but the `--` seam still carries an explicit opt-in, which is how an
# operator deliberately captures the live subscription surface.
test_screenshot_forwards_an_explicit_storekit_opt_in() {
  stage_built_simulator_app
  run_screenshot -w 0 simulator -- -UnicoachEnableStoreKit >/dev/null 2>&1 || return 1
  log_has "-UnicoachEnableStoreKit" || return 1
  return 0
}

# Device resolution defaults to THIS CHECKOUT's device (RFC 126): the
# destination's name= names a MODEL, and the device simctl is handed is the UDID
# of "<model> (<repo>/<checkout>)" — never the shared `iPhone 17 Pro` every other
# checkout would also resolve, and never the literal "booted" (a second
# simulator booted elsewhere must not be capturable by mistake).
test_screenshot_device_is_this_checkouts_udid() {
  stage_built_simulator_app
  run_screenshot -w 0 simulator >/dev/null 2>&1 || return 1
  log_has "$CHECKOUT_UDID" || return 1
  log_lacks "iPhone 17 Pro" || return 1
  log_lacks "$SHARED_UDID" || return 1
  log_lacks "booted" || return 1
  # The device already existed, so nothing was created.
  log_lacks "create" || return 1
  return 0
}

# First run in a fresh checkout: the device does not exist yet, so it is created
# on demand and the capture proceeds on the NEW UDID.
test_screenshot_creates_the_checkout_device_on_demand() {
  stage_built_simulator_app
  SIMCTL_DEVICES="$DEVICES_ABSENT" run_screenshot -w 0 simulator >/dev/null 2>&1 || return 1
  log_has "create" || return 1
  log_has "$SIM_DEVICE_NAME" || return 1
  log_has "$CREATED_UDID" || return 1
  # Not the shared device, even though the listing still offers it.
  log_lacks "$SHARED_UDID" || return 1
  # The boot/install/launch/io sequence ran against the created device.
  local device
  device="$(grep -A1 -Fx "boot" "$ARGV_LOG" | sed -n '2p')"
  [ "$device" = "$CREATED_UDID" ] || return 1
  return 0
}

# UNICOACH_SIMULATOR overrides the destination-derived device. It is the escape
# hatch for deliberately driving a shared device, so it must also skip the
# per-checkout resolution entirely — no device is created, and this checkout's
# own device is not even consulted.
test_screenshot_simulator_override() {
  stage_built_simulator_app
  SIMULATOR_OVERRIDE="ABCD1234-5678-90EF-1234-567890ABCDEF" \
    run_screenshot -w 0 simulator >/dev/null 2>&1 || return 1
  log_has "ABCD1234-5678-90EF-1234-567890ABCDEF" || return 1
  log_lacks "iPhone 17 Pro" || return 1
  log_lacks "$CHECKOUT_UDID" || return 1
  log_lacks "create" || return 1
  return 0
}

# Regression pin for the tolerate-booted rule: `simctl boot` on an
# already-booted device exits non-zero with "Unable to boot device in current
# state: Booted", which is the NORMAL state on every run after the first. The
# capture must still happen.
test_screenshot_tolerates_already_booted() {
  stage_built_simulator_app
  local out
  out="$(SIMCTL_BOOT_BOOTED=1 run_screenshot -w 0 simulator 2>/dev/null)" || return 1
  log_has "screenshot" || return 1
  [ -f "$out" ] || return 1
  return 0
}

# Usage errors carry the shared EXIT_* band codes, not a bare 1, so a caller can
# tell "you invoked it wrongly" from "the capture failed".
test_screenshot_unknown_option() {
  local rc=0
  run_screenshot -Z simulator >/dev/null 2>&1 || rc=$?
  [ "$rc" -eq "$EXIT_UNKNOWN_OPTION" ]
}

test_screenshot_option_requires_value() {
  local rc=0
  run_screenshot -o >/dev/null 2>&1 || rc=$?
  [ "$rc" -eq "$EXIT_OPTION_REQUIRES_VALUE" ]
}

test_screenshot_stray_positional() {
  stage_built_simulator_app
  local rc=0
  run_screenshot simulator stray >/dev/null 2>&1 || rc=$?
  [ "$rc" -eq "$EXIT_UNEXPECTED_ARG" ]
}

# The stdout contract: a caller does OUT="$(bin/screenshot-ios simulator)" and
# must get a usable path. simctl chatters on stdout (the shim reproduces that),
# so every sub-tool invocation is redirected to stderr; this pins the result.
test_screenshot_stdout_is_only_the_png_path() {
  stage_built_simulator_app
  local out err lines
  err="$WORK/stdout-contract.err"
  out="$(run_screenshot -w 0 simulator 2>"$err")" || return 1
  lines="$(printf '%s\n' "$out" | grep -c .)"
  [ "$lines" -eq 1 ] || return 1
  case "$out" in "$SCREENSHOT_DIR"/*.png) ;; *) return 1 ;; esac
  [ -f "$out" ] || return 1
  # The chatter is not lost, just moved: it is on stderr with the logging.
  grep -q "Wrote screenshot to:" "$err" || return 1
  grep -q "Monitoring boot status" "$err" || return 1
  return 0
}

# Warm-run staleness: simctl launch does not relaunch an already-running app (and
# install over a running app does not restart it), so the capture would show the
# OLD process and ignore the -- launch args. A terminate must precede the launch.
test_screenshot_terminates_before_launch() {
  stage_built_simulator_app
  run_screenshot -w 0 simulator >/dev/null 2>&1 || return 1
  local t l
  t="$(grep -nFx "terminate" "$ARGV_LOG" | head -n 1 | cut -d: -f1)"
  l="$(grep -nFx "launch" "$ARGV_LOG" | head -n 1 | cut -d: -f1)"
  [ -n "$t" ] || return 1
  [ -n "$l" ] || return 1
  [ "$t" -lt "$l" ] || return 1
  # simctl terminate <device> <bundle>: the bundle id is two lines on.
  [ "$(sed -n "$((t + 2))p" "$ARGV_LOG")" = "coach.uni.UnicoachiOS" ] || return 1
  return 0
}

# -d is the most explicit device selector and beats BOTH UNICOACH_SIMULATOR and
# the destination's name=.
test_screenshot_device_flag_beats_env_and_destination() {
  stage_built_simulator_app
  SIMULATOR_OVERRIDE="ENVVAR-1111-2222-3333-444444444444" \
    run_screenshot -w 0 -d "FLAG-5555-6666-7777-888888888888" simulator >/dev/null 2>&1 || return 1
  log_has "FLAG-5555-6666-7777-888888888888" || return 1
  log_lacks "ENVVAR-1111-2222-3333-444444444444" || return 1
  log_lacks "iPhone 17 Pro" || return 1
  log_lacks "$CHECKOUT_UDID" || return 1
  log_lacks "create" || return 1
  return 0
}

# An option written AFTER the target gets advice that can actually help
# (reorder), not the generic "pass launch arguments after --" dead end.
test_screenshot_option_after_target() {
  stage_built_simulator_app
  local out rc=0
  out="$(run_screenshot simulator -w 10 2>&1)" || rc=$?
  [ "$rc" -eq "$EXIT_UNEXPECTED_ARG" ] || return 1
  echo "$out" | grep -q "options must precede the target" || return 1
  echo "$out" | grep -q "screenshot-ios -w 10 simulator" || return 1
  return 0
}

# A boot failure that is NOT the already-booted state is FATAL: the tolerance is
# for one specific message, not for boot failures in general.
test_screenshot_boot_failure_is_fatal() {
  stage_built_simulator_app
  local out rc=0
  out="$(SIMCTL_BOOT_FAIL=1 run_screenshot -w 0 simulator 2>&1)" || rc=$?
  [ "$rc" -ne 0 ] || return 1
  echo "$out" | grep -q "$CHECKOUT_UDID" || return 1
  # Never reached the capture.
  log_lacks "screenshot" || return 1
  log_lacks "io" || return 1
  return 0
}

# simctl can exit 0 having written nothing; the guard must fire rather than
# print a path to a file that does not exist.
test_screenshot_no_file_written_is_fatal() {
  stage_built_simulator_app
  # An explicit -o to a path this case controls: the default name is only
  # timestamped to the second, so a PNG another case wrote in the same second
  # would satisfy the existence check and hide the missing guard.
  #
  # A STALE file is planted at that path deliberately — with a stable -o that is
  # exactly the real-world shape of the hole: simctl exits 0 writing nothing and
  # the previous run's capture is printed as this run's result. The script
  # removes the file itself immediately before the capture, so the guard proves
  # THIS run wrote it. (That is also why this case no longer needs its own
  # rm -f: deleting the script's rm -f fails this case.)
  local target="$WORK/never-written.png"
  echo "stale capture from a previous run" > "$target"
  local out rc=0
  out="$(SIMCTL_NO_WRITE=1 run_screenshot -w 0 -o "$target" simulator 2>&1)" || rc=$?
  [ "$rc" -ne 0 ] || return 1
  echo "$out" | grep -q "no screenshot was written" || return 1
  [ ! -f "$target" ] || return 1
  return 0
}

# The zero-config default against the REAL ios-app/env: `screenshot-ios` with no
# arguments beyond the target must resolve a device from the checked-in
# simulator.env. An edit dropping its name= component (as prod-simulator's
# destination already lacks) would dead-end in the cannot-resolve fatal — this
# case fails then, rather than the breakage being found by hand.
test_screenshot_real_simulator_target_resolves_device() {
  stage_built_simulator_app
  local out device
  out="$(run_screenshot_real_env -w 0 simulator 2>/dev/null)" || return 1
  [ -f "$out" ] || return 1
  case "$out" in "$SCREENSHOT_DIR"/*) ;; *) return 1 ;; esac
  # The device simctl was handed: the argv line after "boot".
  device="$(grep -A1 -Fx "boot" "$ARGV_LOG" | sed -n '2p')"
  [ -n "$device" ] || return 1
  [ "$device" != "booted" ] || return 1
  # ...and it is THIS CHECKOUT's device, resolved from the checked-in
  # destination's model through bin/ios-sim.
  [ "$device" = "$CHECKOUT_UDID" ] || return 1
  return 0
}

# An EMPTY -d is a mistake, not a selection: `screenshot-ios -d "$SIM" ...`
# with SIM unset would otherwise read as "no -d given" and quietly capture a
# different simulator.
test_screenshot_empty_device_value() {
  stage_built_simulator_app
  local out rc=0
  out="$(run_screenshot -w 0 -d "" simulator 2>&1)" || rc=$?
  [ "$rc" -eq "$EXIT_INVALID_ARG_VALUE" ] || return 1
  echo "$out" | grep -q -- "-d" || return 1
  log_no_tool "xcrun"
}

# Same for an empty -o, which would otherwise silently fall back to the default
# timestamped path instead of the file the caller meant to write.
test_screenshot_empty_output_value() {
  stage_built_simulator_app
  local out rc=0
  out="$(run_screenshot -w 0 -o "" simulator 2>&1)" || rc=$?
  [ "$rc" -eq "$EXIT_INVALID_ARG_VALUE" ] || return 1
  echo "$out" | grep -q -- "-o" || return 1
  log_no_tool "xcrun"
}

# A sub-tool failure must surface as THIS script's fatal with a sane exit
# status, not as simctl's bare stderr plus its raw exit code (164 here), which
# collides with the reserved 10-29 usage band a caller reads for "invoked
# wrongly".
test_screenshot_install_failure_is_fatal() {
  stage_built_simulator_app
  local out rc=0
  out="$(SIMCTL_INSTALL_FAIL=1 run_screenshot -w 0 simulator 2>&1)" || rc=$?
  [ "$rc" -ne 0 ] || return 1
  [ "$rc" -lt 10 ] || return 1
  echo "$out" | grep -q "\[FATAL\]" || return 1
  echo "$out" | grep -q "Failed to install" || return 1
  echo "$out" | grep -q "$CHECKOUT_UDID" || return 1
  # Never reached the capture.
  log_lacks "screenshot" || return 1
  return 0
}

# The standard `platform=iOS Simulator,id=<UDID>` destination names one exact
# simulator, which is explicit intent: it is used VERBATIM, ahead of the
# per-checkout device, and nothing is created.
test_screenshot_device_from_destination_id() {
  stage_built_simulator_app
  run_screenshot -w 0 id-simulator >/dev/null 2>&1 || return 1
  log_has "AAAABBBB-CCCC-DDDD-EEEE-FFFF00001111" || return 1
  log_lacks "booted" || return 1
  log_lacks "create" || return 1
  log_lacks "$CHECKOUT_UDID" || return 1
  return 0
}

# The end of the resolution chain: a destination carrying NEITHER a `name=` nor
# an `id=` component (prod-simulator's shape) is fatal, never an empty device
# handed on to `simctl boot ""`. Also the negative half of the `name=` probe —
# without this case the probe could match anything and the suite stay green.
test_screenshot_unresolvable_destination_is_fatal() {
  stage_built_simulator_app
  local out rc=0
  out="$(run_screenshot -w 0 explicit-simulator 2>&1)" || rc=$?
  [ "$rc" -ne 0 ] || return 1
  echo "$out" | grep -q "\[FATAL\]" || return 1
  echo "$out" | grep -q "Cannot resolve a simulator" || return 1
  echo "$out" | grep -q "neither a 'name=' nor an 'id=' component" || return 1
  # Nothing was booted, and no device was created for want of one.
  log_no_tool "xcrun"
}

# The extraction is anchored to a component boundary: a decoy key that merely
# ENDS in `name=` must not be mistaken for the real one — the decoys sit on both
# sides of it, so neither a key-unanchored match nor a greedy last-match wins.
test_screenshot_device_ignores_decoy_name_key() {
  stage_built_simulator_app
  run_screenshot -w 0 decoy-name-simulator >/dev/null 2>&1 || return 1
  # `iPhone 99 Real` is the model, so the device is this checkout's
  # "iPhone 99 Real (<repo>/<checkout>)" — in the device fixture as $DECOY_UDID.
  log_has "$DECOY_UDID" || return 1
  log_lacks "Bogus Lead" || return 1
  log_lacks "Bogus Tail" || return 1
  return 0
}

test_screenshot_help_exits_zero() {
  local out rc=0
  out="$(run_screenshot -h 2>&1)" || rc=$?
  [ "$rc" -eq 0 ] || return 1
  echo "$out" | grep -q "screenshot-ios"
}

# ============================== ios-sim tests ================================

# The per-checkout simulator device (RFC 126). Every case is fixture-driven: the
# xcrun shim answers `simctl list devices/devicetypes/runtimes` from files and
# records `simctl create`, so nothing here touches a real device.

# Steady state: the device named "<model> (<repo>/<checkout>)" already exists, so
# its UDID is printed and NOTHING is created. The shared `iPhone 17 Pro` is in the
# same listing, so returning it (a model-keyed rather than name-keyed lookup)
# fails here.
test_iossim_prints_existing_udid() {
  local out
  out="$(run_ios_sim simulator 2>/dev/null)" || return 1
  [ "$out" = "$CHECKOUT_UDID" ] || return 1
  log_lacks "create" || return 1
  # ...and nothing is adopted either: the pre-repo-tag device is in this listing
  # too, and renaming it on top of an existing tagged device would manufacture
  # the duplicate the resolve path refuses.
  log_lacks "rename" || return 1
  return 0
}

# First run: no such device, so one is created — with the EXACT device type for
# the model (not `iPhone 17 Pro Max`, also in the listing) and NO third
# argument, so CoreSimulator picks the newest runtime compatible with that
# device type — and the created UDID is printed.
#
# The argv is read positionally rather than with log_has, because "no runtime
# argument" is a statement about the shape of the invocation: a `create` that
# grew a third argument would still satisfy every membership assertion.
test_iossim_creates_when_absent() {
  local out create_at trailing
  out="$(SIMCTL_DEVICES="$DEVICES_ABSENT" run_ios_sim simulator 2>/dev/null)" || return 1
  [ "$out" = "$CREATED_UDID" ] || return 1
  # Not the shared device, which the listing still offers under the bare model.
  [ "$out" != "$SHARED_UDID" ] || return 1
  create_at="$(grep -n -Fx -- "create" "$ARGV_LOG" | head -n 1 | cut -d: -f1)"
  [ -n "$create_at" ] || return 1
  [ "$(sed -n "$((create_at + 1))p" "$ARGV_LOG")" = "$SIM_DEVICE_NAME" ] || return 1
  [ "$(sed -n "$((create_at + 2))p" "$ARGV_LOG")" = "com.apple.CoreSimulator.SimDeviceType.iPhone-17-Pro" ] || return 1
  # Exactly two arguments: the next logged line is either the start of another
  # recorded invocation or end-of-file.
  trailing="$(sed -n "$((create_at + 3))p" "$ARGV_LOG")"
  [ -z "$trailing" ] || [ "$trailing" = "xcrun" ] || return 1
  log_lacks "com.apple.CoreSimulator.SimDeviceType.iPhone-17-Pro-Max" || return 1
  # No runtime id anywhere in the argv: choosing one is simctl's job now.
  log_lacks "$NEWEST_RUNTIME" || return 1
  log_lacks "$OLDER_RUNTIME" || return 1
  log_lacks "$UNAVAILABLE_RUNTIME" || return 1
  # `create`, never `clone`: a clone would inherit the shared device's data.
  log_lacks "clone" || return 1
  return 0
}

# A `simctl create` that fails is this script's fatal, carrying simctl's own
# words — the shape of the real "no iOS runtime is installed" failure, which is
# simctl's to report now that the runtime choice is simctl's. The installed
# runtimes are printed too, so that case still diagnoses itself.
test_iossim_create_failure_is_fatal() {
  local out rc=0
  out="$(SIMCTL_DEVICES="$DEVICES_ABSENT" SIMCTL_CREATE_FAIL=1 run_ios_sim simulator 2>&1)" || rc=$?
  [ "$rc" -ne 0 ] || return 1
  echo "$out" | grep -q "\[FATAL\]" || return 1
  echo "$out" | grep -q "Unable to find a runtime for device type" || return 1
  echo "$out" | grep -q "$NEWEST_RUNTIME" || return 1
  return 0
}

# The stdout contract's last guard: whatever `simctl create` prints is checked
# for the UDID's SHAPE before it is relayed. 36 dashes are 36 characters from
# the UDID's own alphabet, so a length-and-charset check passes them straight
# through to a caller's `-destination ...,id=`.
test_iossim_create_output_must_be_udid_shaped() {
  local out rc=0
  out="$(SIMCTL_DEVICES="$DEVICES_ABSENT" \
    SIMCTL_CREATE_UDID="------------------------------------" \
    run_ios_sim simulator 2>&1)" || rc=$?
  [ "$rc" -ne 0 ] || return 1
  echo "$out" | grep -q "\[FATAL\]" || return 1
  echo "$out" | grep -q "printed no UDID" || return 1
  return 0
}

# `simctl list` is this script's only source of truth, so a simctl that cannot
# run at all must produce a [FATAL] naming the listing and carrying xcrun's own
# text. Without it the caller's command substitution dies under `set -e` with no
# message whatsoever — a bare non-zero exit out of bin/test-ios.
test_iossim_list_failure_is_fatal() {
  local out rc=0
  out="$(SIMCTL_LIST_FAIL=1 run_ios_sim simulator 2>&1)" || rc=$?
  [ "$rc" -ne 0 ] || return 1
  echo "$out" | grep -q "\[FATAL\]" || return 1
  echo "$out" | grep -q "list simulator \[devices\]" || return 1
  echo "$out" | grep -q "unable to find utility" || return 1
  log_lacks "create" || return 1
  return 0
}

# simctl does not enforce unique device names, so two same-checkout first-runs
# can each list-then-create. Two devices carrying this name is a broken state,
# not a choice to make quietly: fatal, naming both UDIDs and the command that
# clears them — and creating nothing.
test_iossim_duplicate_devices_are_fatal() {
  local out rc=0
  out="$(SIMCTL_DEVICES="$DEVICES_DUPLICATE" run_ios_sim simulator 2>&1)" || rc=$?
  [ "$rc" -ne 0 ] || return 1
  echo "$out" | grep -q "\[FATAL\]" || return 1
  echo "$out" | grep -q "$CHECKOUT_UDID" || return 1
  echo "$out" | grep -q "$DUPLICATE_UDID" || return 1
  echo "$out" | grep -q "bin/ios-sim -D simulator" || return 1
  log_lacks "create" || return 1
  return 0
}

# -D names a SET, and it is the one path that must cope with the broken state it
# exists to clear: every device carrying the name goes, the unavailable twin
# included (resolution skips those because they cannot be booted, but leaving
# one behind is exactly what makes the next resolve fatal). The decoy and the
# shared machine-global device are left alone.
test_iossim_delete_removes_every_match() {
  local out rc=0
  out="$(SIMCTL_DEVICES="$DEVICES_DUPLICATE" run_ios_sim -D simulator 2>/dev/null)" || rc=$?
  [ "$rc" -eq 0 ] || return 1
  [ -z "$out" ] || return 1
  log_has "$CHECKOUT_UDID" || return 1
  log_has "$DUPLICATE_UDID" || return 1
  log_has "$UNAVAILABLE_UDID" || return 1
  log_lacks "$SHARED_UDID" || return 1
  log_lacks "$DECOY_UDID" || return 1
  return 0
}

# An unavailable device (its runtime is gone) carries the right NAME in the
# listing but cannot be booted, so it must not be handed back as this
# checkout's device — the available one is.
test_iossim_ignores_an_unavailable_device() {
  local out
  out="$(run_ios_sim simulator 2>/dev/null)" || return 1
  [ "$out" != "$UNAVAILABLE_UDID" ] || return 1
  return 0
}

# The family's stdout contract: a caller does
# `-destination "platform=iOS Simulator,id=$(bin/ios-sim)"`, so stdout is EXACTLY
# the UDID and every log line — including the resolved device name, and simctl's
# own chatter — is on stderr. Driven through the CREATE path, where simctl
# itself prints a UDID that would otherwise leak straight through.
test_iossim_stdout_is_only_the_udid() {
  local out err lines
  err="$WORK/ios-sim-stdout.err"
  out="$(SIMCTL_DEVICES="$DEVICES_ABSENT" run_ios_sim simulator 2>"$err")" || return 1
  lines="$(printf '%s\n' "$out" | grep -c .)"
  [ "$lines" -eq 1 ] || return 1
  [ "$out" = "$CREATED_UDID" ] || return 1
  # The name it resolved is announced, but on stderr — two checkouts sharing a
  # basename would share a device, and this line is what stops that being silent.
  grep -qF "$SIM_DEVICE_NAME" "$err" || return 1
  return 0
}

# "That model is not installed locally" is the expected human error, so the
# fatal names the model AND prints the actual list to choose from — and nothing
# is created.
test_iossim_unknown_model_is_fatal() {
  local out rc=0
  out="$(SIMCTL_DEVICES="$DEVICES_ABSENT" run_ios_sim unknown-model-simulator 2>&1)" || rc=$?
  [ "$rc" -ne 0 ] || return 1
  echo "$out" | grep -q "\[FATAL\]" || return 1
  echo "$out" | grep -q "iPhone Nonexistent 42" || return 1
  echo "$out" | grep -q "com.apple.CoreSimulator.SimDeviceType.iPhone-17-Pro" || return 1
  log_lacks "create" || return 1
  return 0
}

# A destination with no `name=` component (prod-simulator's shape) names no
# model, so there is nothing to create: fatal, not an arbitrary device.
test_iossim_no_name_component_is_fatal() {
  local out rc=0
  out="$(run_ios_sim explicit-simulator 2>&1)" || rc=$?
  [ "$rc" -ne 0 ] || return 1
  echo "$out" | grep -q "name=" || return 1
  log_no_tool "xcrun"
}

# Same dev-shell guard as the rest of the -ios family, before any tool runs.
test_iossim_guard() {
  local out rc=0
  out="$(DEV_SHELL_MARKER=1 run_ios_sim simulator 2>&1)" || rc=$?
  [ "$rc" -ne 0 ] || return 1
  echo "$out" | grep -q "ios-sim" || return 1
  echo "$out" | grep -qi "system Xcode" || return 1
  log_no_tool "xcrun"
}

# -D deletes by UDID (the name is the lookup key, the UDID is what simctl acts
# on) and prints nothing on stdout.
test_iossim_delete_by_udid() {
  local out shutdown_at delete_at
  out="$(run_ios_sim -D simulator 2>/dev/null)" || return 1
  [ -z "$out" ] || return 1
  log_has "delete" || return 1
  log_has "$CHECKOUT_UDID" || return 1
  # ...and the device is SHUT DOWN first: `simctl delete` refuses a booted
  # device, which is exactly the state screenshot-ios/test-ios leave it in, so
  # the shutdown must precede the delete rather than being advice in a fatal.
  shutdown_at="$(grep -n -Fx -- "shutdown" "$ARGV_LOG" | head -n 1 | cut -d: -f1)"
  delete_at="$(grep -n -Fx -- "delete" "$ARGV_LOG" | head -n 1 | cut -d: -f1)"
  [ -n "$shutdown_at" ] || return 1
  [ -n "$delete_at" ] || return 1
  [ "$shutdown_at" -lt "$delete_at" ] || return 1
  return 0
}

# ...and deleting a device that is not there is a no-op, not a failure: nothing
# is cached on disk, so a hand-deleted device is the normal state.
test_iossim_delete_absent_is_a_noop() {
  local out rc=0
  out="$(SIMCTL_DEVICES="$DEVICES_ABSENT" run_ios_sim -D simulator 2>&1)" || rc=$?
  [ "$rc" -eq 0 ] || return 1
  echo "$out" | grep -q "nothing to delete" || return 1
  log_lacks "delete" || return 1
  return 0
}

# The name is now "<model> (<repo>/<checkout>)": the repo half is what makes a
# device provably ours, and so what makes -G safe. Pinned on the RESOLVE path,
# against a listing that also carries the ORIGINAL RFC 126 name for this same
# checkout — a lookup that dropped the repo tag would find that one and pass
# every other case in this file.
test_iossim_device_name_carries_the_repo_tag() {
  local out err
  err="$WORK/ios-sim-repo-tag.err"
  out="$(run_ios_sim simulator 2>"$err")" || return 1
  [ "$out" = "$CHECKOUT_UDID" ] || return 1
  [ "$out" != "$LEGACY_UDID" ] || return 1
  grep -qF "iPhone 17 Pro ($FIXTURE_REPO/$CHECKOUT)" "$err" || return 1
  return 0
}

# ...and -D deletes the tagged device only. Neither the pre-repo-tag device (the
# resolve path adopts that one, and -D is not the resolve path) nor a hand-made
# untagged device is this checkout's device by name.
test_iossim_delete_leaves_the_untagged_devices() {
  run_ios_sim -D simulator >/dev/null 2>&1 || return 1
  log_has "$CHECKOUT_UDID" || return 1
  log_lacks "$LEGACY_UDID" || return 1
  log_lacks "$HANDMADE_UDID" || return 1
  return 0
}

# The migration, and the reason the rename is not a silent orphan factory: a
# checkout whose only device still carries the pre-repo-tag name
# "<model> (<checkout>)" ADOPTS it — one `simctl rename` to the tagged name,
# that device's own UDID printed, and NOTHING created. A create here would strand
# the old device under a name no mode of this script can reach.
test_iossim_adopts_the_pre_tag_device() {
  local out rename_at
  out="$(SIMCTL_DEVICES="$DEVICES_LEGACY" run_ios_sim simulator 2>/dev/null)" || return 1
  # The SAME device, so its installed app and data survive.
  [ "$out" = "$LEGACY_UDID" ] || return 1
  [ "$out" != "$CREATED_UDID" ] || return 1
  log_lacks "create" || return 1
  # Renamed BY UDID to the tagged name, read positionally: the arguments are the
  # whole content of the migration.
  rename_at="$(grep -n -Fx -- "rename" "$ARGV_LOG" | head -n 1 | cut -d: -f1)"
  [ -n "$rename_at" ] || return 1
  [ "$(sed -n "$((rename_at + 1))p" "$ARGV_LOG")" = "$LEGACY_UDID" ] || return 1
  [ "$(sed -n "$((rename_at + 2))p" "$ARGV_LOG")" = "$SIM_DEVICE_NAME" ] || return 1
  return 0
}

# ...and it is announced on stderr, not silently: the operator's device changed
# its name under them.
test_iossim_adoption_is_announced() {
  local out
  out="$(SIMCTL_DEVICES="$DEVICES_LEGACY" run_ios_sim simulator 2>&1 >/dev/null)" || return 1
  echo "$out" | grep -q "Adopting" || return 1
  echo "$out" | grep -qF "$LEGACY_DEVICE_NAME" || return 1
  echo "$out" | grep -qF "$SIM_DEVICE_NAME" || return 1
  return 0
}

# Adoption is keyed on THIS CHECKOUT's exact legacy name, which is what makes it
# safe: a hand-made untagged device of the same model — and the machine-global
# `iPhone 17 Pro` — belong to someone else. A create, and not one rename.
test_iossim_does_not_adopt_a_foreign_untagged_device() {
  local out
  out="$(SIMCTL_DEVICES="$DEVICES_HANDMADE_ONLY" run_ios_sim simulator 2>/dev/null)" || return 1
  [ "$out" = "$CREATED_UDID" ] || return 1
  log_lacks "rename" || return 1
  log_lacks "$HANDMADE_UDID" || return 1
  log_lacks "$SHARED_UDID" || return 1
  return 0
}

# TWO devices under the legacy name is the same ambiguity the tagged name refuses
# on the resolve path — picking one renames a device that may not be the one with
# the data. Fall through and create a clean device; both legacy twins are left
# exactly where they are.
test_iossim_two_pre_tag_twins_are_not_adopted() {
  local out
  out="$(SIMCTL_DEVICES="$DEVICES_LEGACY_TWINS" run_ios_sim simulator 2>/dev/null)" || return 1
  [ "$out" = "$CREATED_UDID" ] || return 1
  log_lacks "rename" || return 1
  log_lacks "$LEGACY_UDID" || return 1
  log_lacks "$LEGACY_TWIN_UDID" || return 1
  return 0
}

# A rename that fails leaves the device neither adopted nor replaced, so it must
# be a [FATAL] carrying simctl's words and the one command that clears the state
# — not a wordless exit under `set -e`, and not the un-renamed UDID printed as if
# the migration had happened.
test_iossim_adoption_rename_failure_is_fatal() {
  local out rc=0
  out="$(SIMCTL_DEVICES="$DEVICES_LEGACY" SIMCTL_RENAME_FAIL=1 \
    run_ios_sim simulator 2>&1)" || rc=$?
  [ "$rc" -ne 0 ] || return 1
  echo "$out" | grep -q "\[FATAL\]" || return 1
  echo "$out" | grep -q "Failed to rename" || return 1
  echo "$out" | grep -q "xcrun simctl delete $LEGACY_UDID" || return 1
  log_lacks "create" || return 1
  return 0
}

# -G's steady state: every tagged device belongs to a live worktree, so there is
# nothing to collect. Stdout is EMPTY (the orphan list is the result, and there
# are no orphans) and nothing is deleted — the untagged, foreign-tagged and
# machine-global devices in the listing are not orphans just because they did
# not match.
test_iossim_gc_no_orphans_lists_nothing() {
  local out
  out="$(SIMCTL_DEVICES="$DEVICES_GC_CLEAN" run_ios_sim -G 2>/dev/null)" || return 1
  [ -z "$out" ] || return 1
  log_lacks "delete" || return 1
  log_lacks "shutdown" || return 1
  return 0
}

# ...and it says so, on stderr.
test_iossim_gc_no_orphans_says_so() {
  local out
  out="$(SIMCTL_DEVICES="$DEVICES_GC_CLEAN" run_ios_sim -G 2>&1)" || return 1
  echo "$out" | grep -q "No orphaned simulator devices" || return 1
  return 0
}

# The listing itself: every device tagged for THIS repo whose checkout is not a
# live worktree, one "<UDID>  <name>" line each on stdout — and, without -f,
# NOTHING is deleted. Both orphans are here, including the one whose model
# carries its own parentheses and the one whose runtime is gone.
test_iossim_gc_lists_orphans_without_deleting() {
  local out lines
  out="$(SIMCTL_DEVICES="$DEVICES_GC" run_ios_sim -G 2>/dev/null)" || return 1
  echo "$out" | grep -qx "$ORPHAN_UDID  iPhone 17 Pro ($FIXTURE_REPO/$ORPHAN_CHECKOUT)" || return 1
  echo "$out" | grep -qx "$ORPHAN_PAREN_UDID  iPad Pro 13-inch (M5) ($FIXTURE_REPO/$ORPHAN_PAREN_CHECKOUT)" || return 1
  echo "$out" | grep -qx "$ORPHAN_UNAVAILABLE_UDID  iPhone 17 Pro ($FIXTURE_REPO/$ORPHAN_UNAVAILABLE_CHECKOUT)" || return 1
  # EXACTLY the orphans: a listing that also printed the live devices would
  # satisfy every assertion above. Six — the three above plus the prunable
  # worktree's device and the two substring-pair orphans, each pinned by its own
  # case below.
  lines="$(printf '%s\n' "$out" | grep -c .)"
  [ "$lines" -eq 6 ] || return 1
  # Listing is all it does.
  log_lacks "delete" || return 1
  log_lacks "shutdown" || return 1
  return 0
}

# ...and the hint that turns the list into an action is on stderr, not mixed
# into the machine-readable list.
test_iossim_gc_stdout_is_only_the_orphan_list() {
  local out err
  err="$WORK/ios-sim-gc.err"
  out="$(SIMCTL_DEVICES="$DEVICES_GC" run_ios_sim -G 2>"$err")" || return 1
  echo "$out" | grep -q "Re-run" && return 1
  echo "$out" | grep -q "\[INFO\]" && return 1
  grep -q "bin/ios-sim -G -f" "$err" || return 1
  return 0
}

# -f is what deletes, and it deletes EXACTLY the orphans: shutdown-then-delete
# for each (a booted orphan is the normal case — the run that abandoned it left
# it booted), and not one command aimed at a device that is still someone's.
test_iossim_gc_force_deletes_exactly_the_orphans() {
  local out shutdown_at delete_at
  out="$(SIMCTL_DEVICES="$DEVICES_GC" run_ios_sim -G -f 2>/dev/null)" || return 1
  log_has "$ORPHAN_UDID" || return 1
  log_has "$ORPHAN_PAREN_UDID" || return 1
  log_has "$ORPHAN_UNAVAILABLE_UDID" || return 1
  # THIS checkout's device, a live sibling's, an untagged one, another repo's,
  # and the machine-global model-named device: all still there.
  log_lacks "$CHECKOUT_UDID" || return 1
  log_lacks "$LIVE_CLAUDE_UDID" || return 1
  log_lacks "$LEGACY_UDID" || return 1
  log_lacks "$HANDMADE_UDID" || return 1
  log_lacks "$FOREIGN_UDID" || return 1
  log_lacks "$SHARED_UDID" || return 1
  shutdown_at="$(grep -n -Fx -- "shutdown" "$ARGV_LOG" | head -n 1 | cut -d: -f1)"
  delete_at="$(grep -n -Fx -- "delete" "$ARGV_LOG" | head -n 1 | cut -d: -f1)"
  [ -n "$shutdown_at" ] || return 1
  [ -n "$delete_at" ] || return 1
  [ "$shutdown_at" -lt "$delete_at" ] || return 1
  # THE prunable worktree's device, and the substring pair's two orphans: each
  # has its own case below, but they are part of "exactly the orphans" here too.
  log_has "$PRUNABLE_UDID" || return 1
  log_has "$SUBSTR_ORPHAN_SHORT_UDID" || return 1
  log_has "$SUBSTR_ORPHAN_LONG_UDID" || return 1
  log_lacks "$LOCKED_UDID" || return 1
  log_lacks "$SUBSTR_LIVE_LONG_UDID" || return 1
  log_lacks "$SUBSTR_LIVE_SHORT_UDID" || return 1
  # Six orphans, six deletes — no seventh device was touched.
  [ "$(grep -c -Fx -- "delete" "$ARGV_LOG")" -eq 6 ] || return 1
  return 0
}

# -G is about DEVICES, not about a build: it reads no env file, so it works in a
# checkout with none at all. Driven by pointing the env directory at one that
# does not exist — the resolve path fatals on exactly that.
test_iossim_gc_needs_no_env_file() {
  local out rc=0
  out="$(SIM_ENV_DIR="$WORK/no-such-env-dir" SIMCTL_DEVICES="$DEVICES_GC" \
    run_ios_sim -G 2>&1)" || rc=$?
  [ "$rc" -eq 0 ] || return 1
  echo "$out" | grep -q "Environment file not found" && return 1
  echo "$out" | grep -q "$ORPHAN_UDID" || return 1
  return 0
}

# ...and a target is refused rather than ignored: accepting one would imply -G
# collects only that model's devices, which is the opposite of what it does.
test_iossim_gc_rejects_a_target() {
  local out rc=0
  out="$(SIMCTL_DEVICES="$DEVICES_GC" run_ios_sim -G simulator 2>&1)" || rc=$?
  [ "$rc" -eq "$EXIT_UNEXPECTED_ARG" ] || return 1
  echo "$out" | grep -q "takes no target" || return 1
  log_lacks "delete" || return 1
  return 0
}

# git is the authority on which checkouts are alive, so a git that cannot answer
# must be FATAL. The empty list it would otherwise degrade to reads as "every
# tagged device is an orphan" — and -G -f acts on that answer.
test_iossim_gc_git_failure_is_fatal() {
  local out rc=0
  out="$(GIT_WORKTREE_FAIL=1 SIMCTL_DEVICES="$DEVICES_GC" run_ios_sim -G -f 2>&1)" || rc=$?
  [ "$rc" -ne 0 ] || return 1
  echo "$out" | grep -q "\[FATAL\]" || return 1
  echo "$out" | grep -q "not a git repository" || return 1
  log_lacks "delete" || return 1
  return 0
}

# -D is this checkout's device, -G is every other checkout's: asking for both is
# a typo, and guessing which was meant is a delete either way.
test_iossim_gc_and_delete_are_exclusive() {
  local out rc=0
  out="$(run_ios_sim -D -G simulator 2>&1)" || rc=$?
  [ "$rc" -eq "$EXIT_EXCLUSIVE_OPTIONS" ] || return 1
  log_no_tool "xcrun" || return 1
  return 0
}

# -f on its own would silently mean nothing, and the obvious misreading —
# "force" applied to a resolve or to -D — is exactly what someone would type
# expecting devices to be deleted.
test_iossim_force_without_gc_is_refused() {
  local out rc=0
  out="$(run_ios_sim -f simulator 2>&1)" || rc=$?
  [ "$rc" -eq "$EXIT_UNEXPECTED_ARG" ] || return 1
  echo "$out" | grep -q "\-G" || return 1
  log_no_tool "xcrun" || return 1
  return 0
}

# THE case -G is sold as the answer to: a checkout deleted with `rm -rf` rather
# than `git worktree remove`. git prunes lazily, so the stanza is still listed —
# marked `prunable` — and a parse that kept only the `worktree` line would call
# that checkout live and never collect its device. `locked` is the opposite
# annotation (an unmounted volume, still live), so it is pinned in the same case:
# reading it as "gone" would delete a device that is someone's.
test_iossim_gc_collects_a_prunable_worktrees_device() {
  local out
  out="$(SIMCTL_DEVICES="$DEVICES_GC" run_ios_sim -G 2>/dev/null)" || return 1
  echo "$out" | grep -qx "$PRUNABLE_UDID  iPhone 17 Pro ($FIXTURE_REPO/$PRUNABLE_CHECKOUT)" || return 1
  echo "$out" | grep -qF "$LOCKED_UDID" && return 1
  return 0
}

# Live-checkout membership is a WHOLE-LINE match. A substring one would read the
# orphan `<repo>-rfc-3` as live because the live `<repo>-rfc-3-wip` contains it —
# an orphan nothing ever collects again. Both overlap directions are here, so the
# guarantee does not depend on which way round the fixture happened to be
# spelled, and the two live devices whose names overlap the orphans must survive.
test_iossim_gc_live_membership_is_a_whole_line_match() {
  local out
  out="$(SIMCTL_DEVICES="$DEVICES_GC" run_ios_sim -G 2>/dev/null)" || return 1
  echo "$out" | grep -qx "$SUBSTR_ORPHAN_SHORT_UDID  iPhone 17 Pro ($FIXTURE_REPO/$SUBSTR_ORPHAN_SHORT)" || return 1
  echo "$out" | grep -qx "$SUBSTR_ORPHAN_LONG_UDID  iPhone 17 Pro ($FIXTURE_REPO/$SUBSTR_ORPHAN_LONG)" || return 1
  echo "$out" | grep -qF "$SUBSTR_LIVE_LONG_UDID" && return 1
  echo "$out" | grep -qF "$SUBSTR_LIVE_SHORT_UDID" && return 1
  return 0
}

# simctl is the OTHER authority -G reads, and a listing it could not produce is
# not an empty machine. Degrading to "no orphans, exit 0" would tell an operator
# — or an unattended caller of -G -f — that the collection ran on a machine whose
# devices were never read.
test_iossim_gc_simctl_failure_is_fatal() {
  local out rc=0
  out="$(SIMCTL_LIST_FAIL=1 SIMCTL_DEVICES="$DEVICES_GC" run_ios_sim -G -f 2>&1)" || rc=$?
  [ "$rc" -ne 0 ] || return 1
  echo "$out" | grep -q "\[FATAL\]" || return 1
  echo "$out" | grep -q "No orphaned simulator devices" && return 1
  log_lacks "delete" || return 1
  return 0
}

# Deleting the orphans is a SET operation and -G -f is unattended: one device
# that refuses to go — another agent's, still booted — must not leave the rest
# unattempted. Every orphan is attempted, and the run still FAILS at the end,
# naming how many could not be deleted.
test_iossim_gc_force_is_best_effort_over_the_set() {
  local out rc=0
  out="$(SIMCTL_DEVICES="$DEVICES_GC" SIMCTL_DELETE_FAIL_UDID="$ORPHAN_UDID" \
    run_ios_sim -G -f 2>&1)" || rc=$?
  [ "$rc" -ne 0 ] || return 1
  echo "$out" | grep -q "\[FATAL\]" || return 1
  echo "$out" | grep -q "\[1\] of the orphaned devices" || return 1
  # The refusal is named where it happened, and every other orphan was still
  # attempted: six deletes, not one and a halt.
  echo "$out" | grep -q "\[ERROR\]" || return 1
  echo "$out" | grep -qF "$ORPHAN_UDID" || return 1
  [ "$(grep -c -Fx -- "delete" "$ARGV_LOG")" -eq 6 ] || return 1
  log_has "$PRUNABLE_UDID" || return 1
  log_has "$ORPHAN_PAREN_UDID" || return 1
  return 0
}

# Same for -D over a set of same-named twins: the surviving twin is exactly what
# makes the next resolve ambiguous, so every one is attempted — and the run fails
# anyway, because until all of them are gone the checkout is still broken.
test_iossim_delete_is_best_effort_over_the_set() {
  local out rc=0
  out="$(SIMCTL_DEVICES="$DEVICES_DUPLICATE" SIMCTL_DELETE_FAIL_UDID="$CHECKOUT_UDID" \
    run_ios_sim -D simulator 2>&1)" || rc=$?
  [ "$rc" -ne 0 ] || return 1
  echo "$out" | grep -q "\[FATAL\]" || return 1
  echo "$out" | grep -q "could not be deleted" || return 1
  [ "$(grep -c -Fx -- "delete" "$ARGV_LOG")" -eq 3 ] || return 1
  log_has "$DUPLICATE_UDID" || return 1
  log_has "$UNAVAILABLE_UDID" || return 1
  return 0
}

# The shutdown is what makes the delete possible, so when the delete refuses the
# device the shutdown's own words ARE the root cause — and this runs unattended
# under -G -f, where nobody is watching the device it stopped on. Carried into
# the failure message, and only there: a shutdown that merely found the device
# not booted adds no line to a successful delete.
test_iossim_delete_failure_carries_the_shutdown_output() {
  local out rc=0
  out="$(SIMCTL_DEVICES="$DEVICES_GC" SIMCTL_SHUTDOWN_FAIL=1 \
    SIMCTL_DELETE_FAIL_UDID="$ORPHAN_UDID" run_ios_sim -G -f 2>&1)" || rc=$?
  [ "$rc" -ne 0 ] || return 1
  echo "$out" | grep -q "Unable to shutdown device in current state" || return 1
  echo "$out" | grep -q "Unable to delete device in current state" || return 1
  return 0
}

# ...and the normal case stays quiet: a shutdown of a device that was not booted
# is not news, so a successful sweep says nothing about it.
test_iossim_gc_successful_delete_is_quiet_about_shutdown() {
  local out
  out="$(SIMCTL_DEVICES="$DEVICES_GC" SIMCTL_SHUTDOWN_FAIL=1 run_ios_sim -G -f 2>&1)" || return 1
  echo "$out" | grep -q "Unable to shutdown" && return 1
  echo "$out" | grep -q "\[ERROR\]" && return 1
  return 0
}

# A git that exits 0 but names no live worktree is unusable in the same way a
# failing one is — every device name is built from the repo tag derived from it.
# The fatal has to carry what git PRINTED: the parsed result is empty by
# definition here, so quoting only that says nothing at all.
test_iossim_worktree_list_without_a_worktree_is_fatal() {
  local out rc=0
  out="$(GIT_WORKTREES="$WORKTREES_UNPARSEABLE" run_ios_sim -G 2>&1)" || rc=$?
  [ "$rc" -ne 0 ] || return 1
  echo "$out" | grep -q "\[FATAL\]" || return 1
  echo "$out" | grep -qF "warning: this repository has no worktrees to report" || return 1
  log_lacks "delete" || return 1
  return 0
}

# A refused adoption used to be completely silent, while the same ambiguity under
# the TAGGED name fatals with its UDIDs listed. Nothing in this script reaches an
# untagged name again, so the devices it declined to adopt have to be named here
# or they are findable only with `xcrun simctl` by hand.
test_iossim_refused_adoption_names_the_devices() {
  local out
  out="$(SIMCTL_DEVICES="$DEVICES_LEGACY_TWINS" run_ios_sim simulator 2>&1 >/dev/null)" || return 1
  echo "$out" | grep -q "Not adopting" || return 1
  echo "$out" | grep -qF "$LEGACY_UDID" || return 1
  echo "$out" | grep -qF "$LEGACY_TWIN_UDID" || return 1
  echo "$out" | grep -qF "xcrun simctl delete" || return 1
  return 0
}

# ============================== test-ios tests ===============================

# The whole point: `xcodebuild test` is pinned to THIS CHECKOUT's device by
# UDID, not to the shared `name=iPhone 17 Pro` a hand-typed command would use,
# and it shares bin/build-ios's DerivedData tree.
test_testios_destination_is_the_checkout_device() {
  run_test_ios simulator >/dev/null 2>&1 || return 1
  log_has "xcodebuild" || return 1
  log_has "test" || return 1
  log_has "-destination" || return 1
  log_has "platform=iOS Simulator,id=$CHECKOUT_UDID" || return 1
  log_lacks "platform=iOS Simulator,name=iPhone 17 Pro" || return 1
  log_has "-derivedDataPath" || return 1
  log_has "$PROJECT_ROOT/ios-app/build/DerivedData" || return 1
  log_has "$PROJECT_ROOT/ios-app/UnicoachiOS.xcodeproj" || return 1
  log_has "UnicoachiOS" || return 1
  return 0
}

# bin/build-ios owns the DerivedData location and bin/test-ios repeats the
# literal, which is the only thing making the two share a build tree. Compare
# what each script ACTUALLY hands xcodebuild, read out of the argv log rather
# than from a third copy of the literal, so moving one and not the other fails
# here instead of silently costing a cold rebuild on every test run.
test_testios_shares_build_ios_derived_data() {
  local build_path test_path
  run_build simulator >/dev/null 2>&1 || return 1
  build_path="$(grep -A1 -Fx -- "-derivedDataPath" "$ARGV_LOG" | sed -n '2p')"
  [ -n "$build_path" ] || return 1
  run_test_ios simulator >/dev/null 2>&1 || return 1
  test_path="$(grep -A1 -Fx -- "-derivedDataPath" "$ARGV_LOG" | sed -n '2p')"
  [ -n "$test_path" ] || return 1
  [ "$test_path" = "$build_path" ] || return 1
  return 0
}

# A device target has no bootable simulator: rejected, and no build is started.
test_testios_device_target_rejected() {
  local out rc=0
  out="$(run_test_ios device 2>&1)" || rc=$?
  [ "$rc" -ne 0 ] || return 1
  # THIS script's guard, pinned by its own wording: a device destination also
  # has no `name=` component, so deleting the guard would still fail — inside
  # bin/ios-sim, with a message about models. A loose /simulator/i match would
  # accept that and the guard could be removed unnoticed.
  echo "$out" | grep -q "physical device" || return 1
  echo "$out" | grep -q "test-ios runs the suite in the simulator only" || return 1
  # Refused before any device is even resolved, let alone created.
  log_no_tool "xcrun" || return 1
  log_no_tool "xcodebuild"
}

test_testios_guard() {
  local out rc=0
  out="$(DEV_SHELL_MARKER=1 run_test_ios simulator 2>&1)" || rc=$?
  [ "$rc" -ne 0 ] || return 1
  echo "$out" | grep -q "test-ios" || return 1
  echo "$out" | grep -qi "system Xcode" || return 1
  log_no_tool "xcodebuild"
}

# Everything after `--` reaches xcodebuild verbatim: the -only-testing seam.
test_testios_forwards_args_after_dashdash() {
  run_test_ios simulator -- -only-testing:UnicoachiOSTests/PaywallTests -quiet >/dev/null 2>&1 || return 1
  log_has "-only-testing:UnicoachiOSTests/PaywallTests" || return 1
  log_has "-quiet" || return 1
  return 0
}

# ============================ snapshot-ios tests =============================

# The guard is FIRST in the script, before any env or tool logic: inside the dev
# shell xcodebuild is a stub, and the failure would otherwise read as a broken
# project rather than as the wrong shell.
test_snapshot_guard() {
  local out rc=0
  out="$(DEV_SHELL_MARKER=1 run_snapshot simulator 2>&1)" || rc=$?
  [ "$rc" -ne 0 ] || return 1
  echo "$out" | grep -q "must run under system Xcode" || return 1
  log_no_tool "xcodebuild" || return 1
  return 0
}

test_snapshot_guard_precedence_over_missing_env() {
  local out rc=0
  out="$(DEV_SHELL_MARKER=1 run_snapshot nonexistent-target 2>&1)" || rc=$?
  [ "$rc" -ne 0 ] || return 1
  echo "$out" | grep -q "must run under system Xcode" || return 1
  echo "$out" | grep -q "Environment file not found" && return 1
  return 0
}

test_snapshot_missing_env_file() {
  local out rc=0
  out="$(run_snapshot nonexistent-target 2>&1)" || rc=$?
  [ "$rc" -ne 0 ] || return 1
  echo "$out" | grep -q "nonexistent-target.env" || return 1
  log_no_tool "xcodebuild" || return 1
  return 0
}

# Hosting a UIWindow needs a simulator runtime; a device target would also drag
# in signing this run has no business asking for. snapshot-ios no longer carries
# that guard — bin/test-ios does — so what is pinned here is that the refusal
# still REACHES the operator through the delegation, in test-ios's own words. A
# bare /simulator only/ would also match a hypothetical guard back in
# snapshot-ios, which is the duplication RFC 126 removed.
test_snapshot_device_env_rejected() {
  local out rc=0
  out="$(run_snapshot device 2>&1)" || rc=$?
  [ "$rc" -ne 0 ] || return 1
  echo "$out" | grep -q "test-ios runs the suite in the simulator only" || return 1
  # And snapshot-ios says which of ITS steps died, rather than exiting wordlessly.
  echo "$out" | grep -q "bin/test-ios failed for the snapshot scenes" || return 1
  log_no_tool "xcodebuild" || return 1
  return 0
}

# The whole point of the script in one case: the scenes-only test invocation,
# with the corpus directory handed to the test runner through the prefixed
# environment variable xcodebuild forwards.
test_snapshot_happy_path() {
  local out
  out="$(run_snapshot simulator 2>/dev/null)" || return 1
  log_has "test" || return 1
  log_has "-only-testing:UnicoachiOSTests/SnapshotTests" || return 1
  log_has "env:TEST_RUNNER_UNICOACH_SNAPSHOT_DIR=$SNAPSHOT_DIR" || return 1
  [ "$out" = "$SNAPSHOT_DIR" ] || return 1
  [ -f "$SNAPSHOT_DIR/fixture-scene-light.png" ] || return 1
  return 0
}

# snapshot-ios does NOT call xcodebuild: it runs `bin/test-ios <target> --
# <its own args>`, so the destination, the project, the scheme and the
# DerivedData tree are test-ios's answers and cannot drift from bin/test-ios or
# bin/build-ios. bin/test-ios is invoked by absolute path, so it cannot be
# shimmed onto PATH — the delegation is pinned by the thing only test-ios and
# ios-sim can produce: a destination naming THIS CHECKOUT's device by UDID.
# Restoring a local `xcodebuild test -destination ...,name=iPhone 17 Pro` here,
# the collision RFC 126 exists to prevent, fails on both lines.
test_snapshot_delegates_to_test_ios() {
  run_snapshot simulator >/dev/null 2>&1 || return 1
  log_has "-destination" || return 1
  log_has "platform=iOS Simulator,id=$CHECKOUT_UDID" || return 1
  log_lacks "platform=iOS Simulator,name=iPhone 17 Pro" || return 1
  log_has "-derivedDataPath" || return 1
  log_has "$PROJECT_ROOT/ios-app/build/DerivedData" || return 1
  log_has "$PROJECT_ROOT/ios-app/UnicoachiOS.xcodeproj" || return 1
  log_has "-scheme" || return 1
  log_has "UnicoachiOS" || return 1
  return 0
}

# The target positional is FORWARDED, not consumed: it is the only thing that
# selects the simulator MODEL, and test-ios/ios-sim are what read it. A second
# fixture target names a different model, so it must land on a DIFFERENT device
# — which a hardcoded default target, or a target quietly dropped on the way to
# test-ios, could not do.
test_snapshot_forwards_the_target() {
  run_snapshot decoy-name-simulator >/dev/null 2>&1 || return 1
  log_has "platform=iOS Simulator,id=$DECOY_UDID" || return 1
  log_lacks "platform=iOS Simulator,id=$CHECKOUT_UDID" || return 1
  return 0
}

# Locale and time zone are pinned so a machine's settings cannot move the
# pixels — the reason a capture is comparable at all between two developers.
test_snapshot_pins_locale_and_timezone() {
  run_snapshot simulator >/dev/null 2>&1 || return 1
  log_has "-testLanguage" || return 1
  log_has "en" || return 1
  log_has "-testRegion" || return 1
  log_has "US" || return 1
  log_has "env:TEST_RUNNER_TZ=UTC" || return 1
  return 0
}

test_snapshot_explicit_output_dir() {
  local target="$WORK/explicit-corpus"
  rm -rf "$target"
  local out
  out="$(run_snapshot -o "$target" simulator 2>/dev/null)" || return 1
  [ "$out" = "$target" ] || return 1
  log_has "env:TEST_RUNNER_UNICOACH_SNAPSHOT_DIR=$target" || return 1
  [ -f "$target/fixture-scene-dark.png" ] || return 1
  return 0
}

# There is no -d: under RFC 126 the device is this checkout's and the model
# comes from the target's env file, so a device selector on this script would be
# a second, contradicting answer. It must be REJECTED as unknown rather than
# quietly ignored, which is what an operator carrying an old command line needs
# to see.
test_snapshot_has_no_device_option() {
  local rc=0
  run_snapshot -d "iPhone 99 Test" simulator >/dev/null 2>&1 || rc=$?
  [ "$rc" -eq "$EXIT_UNKNOWN_OPTION" ] || return 1
  log_no_tool "xcodebuild" || return 1
  return 0
}

test_snapshot_baseline_forwarded() {
  local baseline="$WORK/baseline-corpus"
  mkdir -p "$baseline"
  run_snapshot -b "$baseline" simulator >/dev/null 2>&1 || return 1
  log_has "env:TEST_RUNNER_UNICOACH_SNAPSHOT_BASELINE_DIR=$baseline" || return 1
  return 0
}

test_snapshot_missing_baseline_dir_is_fatal() {
  local out rc=0
  out="$(run_snapshot -b "$WORK/no-such-baseline" simulator 2>&1)" || rc=$?
  [ "$rc" -ne 0 ] || return 1
  echo "$out" | grep -q "Baseline directory not found" || return 1
  log_no_tool "xcodebuild" || return 1
  return 0
}

# The failure mode the corpus check exists for: `xcodebuild test` exits 0 when
# ZERO tests ran, which is exactly what an unregistered scene file looks like.
test_snapshot_empty_corpus_is_fatal() {
  local out rc=0
  rm -rf "$SNAPSHOT_DIR"
  out="$(SNAPSHOT_NO_WRITE=1 run_snapshot simulator 2>&1)" || rc=$?
  [ "$rc" -ne 0 ] || return 1
  echo "$out" | grep -q "no PNGs were written" || return 1
  echo "$out" | grep -q "project.pbxproj" || return 1
  return 0
}

test_snapshot_test_failure_is_fatal() {
  local out rc=0
  out="$(SNAPSHOT_TEST_FAIL=1 run_snapshot simulator 2>&1)" || rc=$?
  [ "$rc" -ne 0 ] || return 1
  echo "$out" | grep -q "bin/test-ios failed for the snapshot scenes" || return 1
  return 0
}

test_snapshot_unknown_option() {
  local rc=0
  run_snapshot -Z simulator >/dev/null 2>&1 || rc=$?
  [ "$rc" -eq "$EXIT_UNKNOWN_OPTION" ]
}

test_snapshot_option_requires_value() {
  local rc=0
  run_snapshot -o >/dev/null 2>&1 || rc=$?
  [ "$rc" -eq "$EXIT_OPTION_REQUIRES_VALUE" ]
}

test_snapshot_stray_positional() {
  local rc=0
  run_snapshot simulator stray >/dev/null 2>&1 || rc=$?
  [ "$rc" -eq "$EXIT_UNEXPECTED_ARG" ]
}

test_snapshot_option_after_target() {
  local out rc=0
  out="$(run_snapshot simulator -o "$WORK/late" 2>&1)" || rc=$?
  [ "$rc" -eq "$EXIT_UNEXPECTED_ARG" ] || return 1
  echo "$out" | grep -q "snapshot-ios -o $WORK/late simulator" || return 1
  return 0
}

# An EMPTY -o/-b is a mistake, not a selection: it is almost always an unset
# variable expanded into the command line.
test_snapshot_empty_option_values_rejected() {
  local rc=0
  run_snapshot -o "" simulator >/dev/null 2>&1 || rc=$?
  [ "$rc" -eq "$EXIT_INVALID_ARG_VALUE" ] || return 1
  rc=0
  run_snapshot -b "" simulator >/dev/null 2>&1 || rc=$?
  [ "$rc" -eq "$EXIT_INVALID_ARG_VALUE" ] || return 1
  return 0
}

# The stdout contract: a caller does DIR="$(bin/snapshot-ios)" and gets a usable
# path, never a line of build log.
test_snapshot_stdout_is_only_the_corpus_dir() {
  local err="$WORK/snapshot-stderr.txt"
  local out
  out="$(run_snapshot simulator 2>"$err")" || return 1
  [ "$(printf '%s\n' "$out" | wc -l | tr -d ' ')" -eq 1 ] || return 1
  [ "$out" = "$SNAPSHOT_DIR" ] || return 1
  grep -q "Capturing the snapshot corpus" "$err" || return 1
  return 0
}

test_snapshot_help_exits_zero() {
  local out rc=0
  out="$(run_snapshot -h 2>&1)" || rc=$?
  [ "$rc" -eq 0 ] || return 1
  echo "$out" | grep -q "snapshot-ios"
}

