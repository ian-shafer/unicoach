#!/usr/bin/env bash

TOTAL_TESTS=0

pass_test() {
  local msg="$1"
  TOTAL_TESTS=$(( TOTAL_TESTS + 1 ))
  echo -e " \033[0;32m✅ ${msg}\033[0m"
}

fail_test() {
  local msg="$1"
  echo -e " \033[0;31m❌ Fail: ${msg}\033[0m" >&2
  exit 1
}

# Exact membership of a NAME in a list, e.g. `list_contains "$script"
# "${ALLOWLIST[@]}"`. Every bin/* guard carries an exclusion or allowlist, and a
# hand-rolled loop per guard is one more loop per guard to get subtly wrong — the
# three verbatim copies this replaced were written that way (RFC 174).
list_contains() {
  local needle="$1" item
  shift
  for item in "$@"; do
    [ "$item" = "$needle" ] && return 0
  done
  return 1
}

# Echoes the literal PREFIX a dotenv key prepends to checkout_name -- e.g.
# `unicoach-test-` for .env.test's POSTGRES_DB, `owner-` for .env.dev's
# POSTGRES_USER -- and nothing when the line is absent or differently shaped.
#
# `<KEY>=<prefix>$(checkout_name "$PROJECT_ROOT")` is a FORMAT CONTRACT that
# several guards read as structured data (the byte budget, the literal-name
# sweep), yet nothing at the dotenv line says so. It is parsed in ONE place: two
# spellings of one format are two things to keep in step, and a line reformatted
# under a second parser makes its guard measure nothing while still passing
# (RFC 174).
checkout_derivation_prefix() {
  local file="$1" key="$2"
  sed -nE 's/^'"$key"'=(.*)\$\(checkout_name "\$PROJECT_ROOT"\)$/\1/p' "$file"
}

# Build "a release-ready repository" under <dir>: a bare origin at
# <dir>/origin.git and a clone of it at <dir>/repo on main, identity set, one
# commit, pushed — the state assert_release_ready requires — so a case starts
# from "ready" and moves it off itself. Quiet. Runs under strip_git_hook_env
# (bin/functions, which every caller sources before this file): a harness run
# by the pre-commit hook inherits an exported GIT_DIR that would otherwise make
# each `git -C <fixture>` answer for the repository being committed. The clone
# creates main itself (`checkout -b` on the unborn branch), so it does not
# depend on init.defaultBranch; a SECOND clone of origin.git does, and must
# pass `-b main`.
make_release_ready_repo() {
  local dir="$1"
  (
    strip_git_hook_env
    mkdir -p "$dir"
    git init -q --bare "$dir/origin.git"
    git clone -q "$dir/origin.git" "$dir/repo"
    git -C "$dir/repo" config user.email "tests@example.com"
    git -C "$dir/repo" config user.name "tests"
    git -C "$dir/repo" checkout -q -b main
    printf 'one\n' > "$dir/repo/file"
    git -C "$dir/repo" add -A
    git -C "$dir/repo" commit -qm one
    git -C "$dir/repo" push -q origin main
  ) >/dev/null 2>&1
}

assert_success() {
  local msg="$1"
  shift
  if ! "$@"; then
    fail_test "$msg"
  fi
  pass_test "$msg"
}

assert_failure() {
  local msg="$1"
  shift
  if "$@"; then
    fail_test "$msg (expected to fail)"
  fi
  pass_test "$msg"
}

assert_exit_code() {
  local expected="$1"
  local msg="$2"
  shift 2
  local actual=0
  "$@" >/dev/null 2>&1 || actual=$?
  if [ "$actual" -ne "$expected" ]; then
    fail_test "$msg (expected exit $expected, got $actual)"
  fi
  pass_test "$msg"
}

end_tests() {
  echo ""
  echo -e " 🎉 \033[0;32m${TOTAL_TESTS} tests passed successfully.\033[0m"
}
